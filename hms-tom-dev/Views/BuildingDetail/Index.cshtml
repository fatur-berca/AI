            success: function (respond) {
                if (respond.length == 0) {
                    //console.log('masuk if');
                    generateDropdownWarehouse();
                    $("#idnamelocaton").val("");
                    $("#addressh").val("");
                    $("#statusWarehouse").val("");
                    $("#btnEdit").attr('disabled', 'disabled');
                    $("#GenerateGeneral").html('');
                    $("#GenerateAsset").html('');
                    $("#GenerateEquipment").html('');
                    $("#GenerateHeadcount").html('');
                    $("#doubleStack").prop('checked', false);
                }
                else {
                    var createdDate = moment(Number(respond[0].CreatedDate.match(/\d+/)[0])).format('DD/MM/YYYY');
                    setBtnEdit(createdDate, respond[0].WarehouseID);
                    
                    statusPage = "EDIT";
                    masterDynamicField = new Array();
                    warehouseName = respond[0].WarehouseName;
                    //console.log(respond[0]);
                    //console.log(respond[0].WarehouseID);
                    //console.log(respond[0].WarehouseName);
                    //$("#idnamelocaton").attr('disabled', 'disabled');
                    $("#idnamelocaton").val(respond[0].WarehouseID);
                    generateDropdownWarehouse(respond[0].WarehouseID + '-' + respond[0].WarehouseName);
                    $("#statusWarehouse").val(respond[0].WarehouseStatus);
                    $("#addressh").val(respond[0].WarehouseAddress);
                    $("#longitude").val(respond[0].WarehouseLocationLog);
                    $("#latitude").val(respond[0].WarehouseLocationLat);
                    if (respond[0].DoubleStacking)
                        $("#doubleStack").prop('checked', true);
                    else
                        $("#doubleStack").prop('checked', false);
                    $("#btnSave").attr('disabled', 'disabled');
                    idBuildingFacility = respond[0].idBuildingFacility;
                    loadDynamicField(respond[0].idBuildingFacility);
                    disabledField();
                    
                    if ((respond[0].WarehousePic1 != " ") && (respond[0].WarehousePic1 != "")) {
                        $("#pic1s").addClass("bg-image");
                        $("#pic1s").attr("style", "background-image: url('assets/uploads/building/" + respond[0].WarehousePic1 + "')");
                    }

                    if ((respond[0].WarehousePic2 != " ") && (respond[0].WarehousePic2 != "")) {
                        $("#pic2s").addClass("bg-image");
                        $("#pic2s").attr("style", "background-image: url('assets/uploads/building/" + respond[0].WarehousePic2 + "')");
                    }

