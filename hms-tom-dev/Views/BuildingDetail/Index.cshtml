                        $("#pic3s").addClass("bg-image");
                        $("#pic3s").attr("style", "background-image: url('assets/uploads/building/" + respond[0].WarehousePic3 + "')");
                    }
                    
                }

                // Create a map object and specify the DOM element for display.
                map = new google.maps.Map(document.getElementById('map'), {
                    center: { lat: $("#latitude").val() * 1, lng: $("#longitude").val() * 1 },
                    scrollwheel: false,
                    zoom: 15
                });

                var markerPos = { lat: $("#latitude").val() * 1, lng: $("#longitude").val() * 1 };

                var iconBase = 'assets/images/';

                var marker = new google.maps.Marker({
                    map: map,
                    position: markerPos,
                    title: respond[0].WarehouseName,
                    icon: iconBase + 'marker-blue.png'
                });
            }
        });
    }


