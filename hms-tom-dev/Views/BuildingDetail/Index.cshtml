    function generateTextValue(option, value) {
        //console.log(option);
        var html = option.parentNode.nextSibling;
        //console.log(html);
        var split = value.split(',');
        var appendHtml = '';
        html.innerHTML = "";
        if (split[2] == "Number") {
            appendHtml = '<label>Value</label>' +
                '<input type="number" name="" class="form-control" onkeypress="return event.charCode >= 48 && event.charCode <= 57">';
        }
        else if (split[2] == "Date") {
            appendHtml = '<label>Value</label><input type="text" class="form-control datepicker">';
        }
        else if (split[2] == "TextInput") {
            appendHtml = '<label>Value</label><input type="text" class="form-control">';
        }
        else if (split[2] == "ComboBox") {
            appendHtml = '<label>Value</label><select class="form-control">' +
                         '<option>Yes</option>' +
                         '<option>No</option>' +
                         '</select>';
        }
        html.innerHTML = appendHtml;
        //console.log(value);
    }

