    function generateDropdownWarehouse(selected) {
        var select = $('#idnamelocaton');
        $.ajax({
            url: 'buildingdetail/GetDropDownWarehouse',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                select.html('');
                select.html('<option value="null"></option>').trigger('change');
                $.each(data, function (key, val) {
                    var value = val.IDLocation + '-' + val.LocationName;
                    if (value == selected)
                        select.append('<option value="' + val.IDLocation + '-' + val.LocationName + '" selected="selected">' + val.IDLocation + ' - ' + val.LocationName + '</option>');
                    else
                        select.append('<option value="' + val.IDLocation + '-' + val.LocationName + '">' + val.IDLocation + ' - ' + val.LocationName + '</option>');
                });
            },
            error: function () {
                select.html('<option value="null">none available</option>');
            }
        });
    }

    function loadDynamicField(idbuilding) {
        $.ajax({
            url: 'buildingdetail/GetBuildingFacilityDetail',
            dataType: 'JSON',
            data: { id: idbuilding },
            cache: false,
            success: function (data) {
                var tempHeadcount = "";
                var tempidDaily = "";
                var tempidMonthly = "";
                var tempidOutsource = "";
                var tempvalueDaily = "";
                var tempvalueMonthly = "";
                var tempvalueOutsource = "";
                var headcount = "";
                var count = 0;//digunakan untuk generate headcount
                for (var i = 0; i < data.length; i++) {
                    var detail = data[i];
                    var dynamic = detail["MasterDynamicField"];
                    if (dynamic["GroupCollapse"] == "General") {
                        htmlString = '';
                        generateDynamicFrontPage(dynamic["FieldName"], dynamic["IDDynamicField"], dynamic["FieldType"], detail["Value"],"General");
                        $("#GenerateGeneral").append(htmlString);
                        if((detail["Value"] > 0 && (dynamic["FieldType"] == "Number" || dynamic["FieldType"] == "TextInput")) || dynamic["FieldType"] == "Date" || dynamic["FieldType"] == "ComboBox")
                            listGeneratedGeneral.push(dynamic["IDDynamicField"]);
                    }
                    if (dynamic["GroupCollapse"] == "Asset") {
                        htmlString = '';
                        generateDynamicFrontPage(dynamic["FieldName"], dynamic["IDDynamicField"], dynamic["FieldType"], detail["Value"],"Asset");
                        $("#GenerateAsset").append(htmlString);
                        if((detail["Value"] > 0 && (dynamic["FieldType"] == "Number" || dynamic["FieldType"] == "TextInput")) || dynamic["FieldType"] == "Date" || dynamic["FieldType"] == "ComboBox")
                            listGeneratedAsset.push(dynamic["IDDynamicField"]);
                    }
                    if (dynamic["GroupCollapse"] == "Equipment") {
                        htmlString = '';
                        generateDynamicFrontPage(dynamic["FieldName"], dynamic["IDDynamicField"], dynamic["FieldType"], detail["Value"],"Equipment");
                        $("#GenerateEquipment").append(htmlString);
                        if((detail["Value"] > 0 && (dynamic["FieldType"] == "Number" || dynamic["FieldType"] == "TextInput")) || dynamic["FieldType"] == "Date" || dynamic["FieldType"] == "ComboBox")
                            listGeneratedEquipment.push(dynamic["IDDynamicField"]);
                    }
                    if (dynamic["GroupCollapse"] == "Headcount") {
                        if (dynamic["FieldName"].indexOf("MONTHLY") >= 0) {
                            tempHeadcount = dynamic["FieldName"].replace(/ MONTHLY/g, "");
                            tempidMonthly = dynamic["IDDynamicField"];
                            tempvalueMonthly = detail["Value"];
                        }
                        if (dynamic["FieldName"].indexOf("DAILY") >= 0) {
                            tempHeadcount = dynamic["FieldName"].replace(/ DAILY/g, "");
                            tempidDaily = dynamic["IDDynamicField"];
                            tempvalueDaily = detail["Value"];
                        }
                        if (dynamic["FieldName"].indexOf("OUTSOURCE") >= 0) {
                            tempHeadcount = dynamic["FieldName"].replace(/ OUTSOURCE/g, "");
                            tempidOutsource = dynamic["IDDynamicField"];
                            tempvalueOutsource = detail["Value"];
                        }
                        count++;
                        if (count > 0 && count % 3 == 0) {
                            htmlString = '';
                            headcount = tempHeadcount;
                            generateDynamicHeadcountFrontPage(headcount, tempidMonthly, tempidDaily, tempidOutsource, tempvalueMonthly, tempvalueDaily, tempvalueOutsource);
                            $("#GenerateHeadcount").append(htmlString);
                            if ((tempvalueMonthly > 0 || tempvalueMonthly != null) && (tempvalueDaily > 0 || tempvalueDaily != null) && (tempvalueOutsource > 0 || tempvalueDaily != null)) {
                                listGeneratedHeadcount.push(tempidMonthly);
                                listGeneratedHeadcount.push(tempidDaily);
                                listGeneratedHeadcount.push(tempidOutsource);
                            }
                            //if(tempvalueMonthly >= 0 || tempvalueMonthly == null)
                            //    listGeneratedHeadcount.push(tempidMonthly);
                            //if(tempvalueDaily >= 0 || tempvalueMonthly == null)
                            //    listGeneratedHeadcount.push(tempidDaily);
                            //if(tempvalueOutsource >= 0 || tempvalueMonthly == null)
                            //    listGeneratedHeadcount.push(tempidOutsource);
                        }
                    }
                }
            },
            complete: function () {
                disabledDynamicField();
            }
        });
    }

    function gup(name) {
        var url = window.location.href;
        if (!url) url = location.href;
        name = name.replace(/[\[]/, "\\\[").replace(/[\]]/, "\\\]");
        var regexS = "[\\?&]" + name + "=([^&#]*)";
        var regex = new RegExp(regexS);
        var results = regex.exec(url);
        return results == null ? null : results[1];
    }

