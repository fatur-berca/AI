    function getDynamicFieldDropDown(grp, list) {
        //console.log(list);
        $.ajax({
            url: 'buildingdetail/GetMasterDynamicFieldByGroupListFieldName',
            method: 'post',
            dataType: 'json',
            cache: false,
            data: {
                group: grp,
                fieldName: list
            },
            success: function (respond) {
                masterDynamicField = respond;
            },
            complete: function () {
                generateOption();
            }
        });
    }

    function generateOption() {
        //console.log('generateOption');
        htmlStringOption = '';
        if (tab == "Headcount") {
            var tempHeadcount = "";
            var headcount = "";
            var idMonthly = "";
            var idDaily = "";
            var idOutsource = "";
            var count = 1;
            for (var i = 0; i < masterDynamicField.length; i++) {
                if (masterDynamicField[i]["FieldName"].indexOf("MONTHLY") >= 0) {
                    tempHeadcount = masterDynamicField[i]["FieldName"].replace(/ MONTHLY/g, "");
                    idMonthly = masterDynamicField[i]["IDDynamicField"];
                }
                if (masterDynamicField[i]["FieldName"].indexOf("DAILY") >= 0) {
                    tempHeadcount = masterDynamicField[i]["FieldName"].replace(/ DAILY/g, "");
                    idDaily = masterDynamicField[i]["IDDynamicField"];
                }
                if (masterDynamicField[i]["FieldName"].indexOf("OUTSOURCE") >= 0) {
                    tempHeadcount = masterDynamicField[i]["FieldName"].replace(/ OUTSOURCE/g, "");
                    idOutsource = masterDynamicField[i]["IDDynamicField"];
                }
                //if (i > 2 && headcount != tempHeadcount) { //i > 2 supaya id daily, sama id  outsource masuk, kalau tidak ada, maka yang masuk cuma id monthly untuk data pertama
                if (count % 3 == 0) {
                    //console.log('idmonthly: ' + idMonthly);
                    //console.log('idDaily: ' + idDaily);
                    //console.log('idOutsource: ' + idOutsource);
                    headcount = tempHeadcount;
                    htmlStringOption = htmlStringOption + '<option value="' + idMonthly + ',' + idDaily + ',' + idOutsource + ',' + tempHeadcount + '">' + tempHeadcount + '</option>';
                }
                count++;
                //htmlStringOption = htmlStringOption + '<option value="' + masterDynamicField[i]["IDDynamicField"] + '-' + masterDynamicField[i]["FieldName"] + '-' + masterDynamicField[i]["FieldType"] + '">' + masterDynamicField[i]["FieldName"] + '</option>';
            }
        }
        else {
            htmlStringOption = htmlStringOption + '<option></option>';
            for (var j = 0; j < masterDynamicField.length; j++) {
                //console.log(masterDynamicField);
                htmlStringOption = htmlStringOption + '<option value="' + masterDynamicField[j]["IDDynamicField"] + ',' + masterDynamicField[j]["FieldName"] + ',' + masterDynamicField[j]["FieldType"] + '">' + masterDynamicField[j]["FieldName"] + '</option>';
            }
        }
        generateSelect();
    }

