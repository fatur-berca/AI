    function generateDynamicFrontPage(label, id, fieldType, value, Group) {
        if (fieldType == "TextInput") {
            if(value != 0){
                htmlString = htmlString +
            '<div class="col-md-6">' +
            '<div class="form-group">' +
            '<label>' + label + '</label>' +
            '<input type="text" id="' + id + ',' + label.split(' ').join('') + '" class="form-control" value="' + value + '">' +//tambah label supaya idnya unik
            '</div>' +
            '</div>';
            }
        }   
        else if (fieldType == "Number") {
            if(value !=0){
                htmlString = htmlString +
              '<div class="col-md-6">' +
              '<div class="form-group">' +
              '<label>' + label + '</label>' +
              '<input type="number" id="' + id + ',' + label.split(' ').join('') + '" class="form-control" onkeypress="return event.charCode >= 48 && event.charCode <= 57" value="' + value + '"/>' +
              '</div>' +
              '</div>';
            }
        }
        else if (fieldType == "Date") {
            htmlString = htmlString +
                '<div class="col-md-6">' +
                '<div class="form-group">' +
                '<label>' + label + '</label>' +
                '<input type="text" id="' + id + ',' + label.split(' ').join('') + '" class="form-control datepicker" value="' + value + '">' +
                '</div>' +
                '</div>';
            if (clearfixGeneral % 2 == 0)
                htmlString = htmlString + '<div class="clearfix"></div>';
            if (clearfixAsset % 2 == 0)
                htmlString = htmlString + '<div class="clearfix"></div>';
            if (clearfixEquipment % 2 == 0)
                htmlString = htmlString + '<div class="clearfix"></div>';
        }
        else if (fieldType == "ComboMultiple") {
            htmlString = htmlString +
                '<div class="col-md-6">' +
                '<div class="form-group">' +
                '<label>' + label + '</label>' +
                '<select class="combo-select" multiple="multiple" id = "' + id + ',' + label.split(' ').join('') + '"></select>' +
                '</div>' +
                '</div>';
            if (clearfixGeneral % 2 == 0)
                htmlString = htmlString + '<div class="clearfix"></div>';
            if (clearfixAsset % 2 == 0)
                htmlString = htmlString + '<div class="clearfix"></div>';
            if (clearfixEquipment % 2 == 0)
                htmlString = htmlString + '<div class="clearfix"></div>';
        }
        else if (fieldType == "ComboBox") {
            htmlString = htmlString +
                '<div class="col-md-6">' +
                '<div class="form-group">' +
                '<label>' + label + '</label>' +
                '<select class="form-control" id = "' + id + ',' + label.split(' ').join('') + '">' +
                '<option>Yes</option>' +
                '<option>No</option>' +
                '</select>' +
                '</div>' +
