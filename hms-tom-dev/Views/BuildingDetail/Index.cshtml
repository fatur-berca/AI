    function checkField(arrayField) {
        var invalid = false;
        for (var i = 0; i < arrayField.length; i++) {
            if ($('#' + arrayField[i] + '').val() == "" || $('#' + arrayField[i] + '').val() == "null") {
                invalid = true;
                $('#' + arrayField[i] + '').addClass("txt-invalid");
            }
            else
                $('#' + arrayField[i] + '').removeClass("txt-invalid");
        }
        return invalid;
    }

