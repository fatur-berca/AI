                htmlString = htmlString + '<div class="clearfix"></div>';
            if (clearfixAsset % 2 == 0)
                htmlString = htmlString + '<div class="clearfix"></div>';
            if (clearfixEquipment % 2 == 0)
                htmlString = htmlString + '<div class="clearfix"></div>';
        }
        //if (clearfix % 2 == 0)
        //    htmlString = htmlString + '<div class="clearfix"></div>';
        if(Group == "General")
            clearfixGeneral++;
        else if(Group == "Asset")
            clearfixAsset++;
        else if(Group == "Equipment")
            clearfixEquipment++;
    }

