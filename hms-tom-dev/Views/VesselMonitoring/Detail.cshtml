    function resetUpdate() {
        jQuery("select, input[type=text], input[type=number], textarea").prop("disabled", true);;
        jQuery("#SaveButton").prop("disabled", true);
        jQuery("#EditButton").prop("disabled", false);
    }

    function update(VesselMonitoringRecord, VesselMonitoringDetailRecords, massUpdate, massUpdateData, dialog) {
        return $.ajax({
            type: 'POST',
            url: '@Url.Action("CreateUpdate")',
            data: VesselMonitoringRecord,
            success: function (responseOne) {
                if (responseOne) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("DetailCreateUpdate")',
                        data: VesselMonitoringDetailRecords,
                        success: function (responseTwo) {
                            if (massUpdate) {
                                $.ajax({
                                    type: 'POST',
                                    url: '@Url.Action("MassUpdate")',
                                    data: massUpdateData,
                                    success: function (responseThree) {
                                        dialog.modal('hide');
                                        resetUpdate();
                                        alertSaveSuccess();
                                        SetShipLocation();
                                    },
                                    error: function (jqXHR, exception) {
                                        dialog.modal('hide');
                                    }
                                });
                            } else {
                                dialog.modal('hide');
                                resetUpdate();
                                alertSaveSuccess();
                                SetShipLocation();
                            }
                        },
                        error: function (jqXHR, exception) {
                            dialog.modal('hide');
                        }
                    });
                } else {
                    dialog.modal('hide');
                }
            },
            error: function (jqXHR, exception) {
                dialog.modal('hide');
            }
        });
    }

    function generateDropdownWarehouse() {
        return jQuery.ajax({
            url: '@Url.Action("GetMasterLocation")',
            dataType: 'JSON',
            data: { "Type": "Warehouse" },
            cache: false,
            success: function (response) {
                jQuery('.IDLocation').select2("destroy");
                var data = response.sort(function (a, b) { return a - b }),
                    options = '<option value="">-- Select --</option>';
                jQuery.each(data, function (key, val) {
                    options = options + '<option value="' + val.IDLocation + ":" + val.LocationName + '">' + val.IDLocation + ":" + val.LocationName + '</option>';
                });
                jQuery('.IDLocation').html(options).select2();
            },
            error: function () {
                jQuery('.IDLocation').select2("destroy");
                jQuery('.IDLocation').html('<option value="NULL">none available</option>').select2();
            }
        });
    }

    function SetShipLocation() {
        var extract_shipdata = $("#ShipName").val().split('-');

        var mmsi = extract_shipdata.length > 0 ? extract_shipdata[0] : '';
        if (mmsi != '') $("#mapwrap").html("<iframe src='https://www.marinetraffic.com/en/ais/details/ships/mmsi:" + mmsi + "' width='100%' height='475px'>Sorry your browser does not support inline frames.</iframe>");
    }

    function generateDropdownIDVendor() {
        return jQuery.ajax({
            url: '@Url.Action("GetMasterVendor")',
            dataType: 'JSON',
            data: { "IsActive": true },
            cache: false,
            success: function (response) {
                var data = response.sort(function (a, b) { return a - b }),
                    options = '<option value="">-- Select --</option>';
                jQuery.each(data, function (key, val) {
                    options = options + '<option value="' + val.IDVendor + '">' + val.VendorName + '</option>';
                });
                jQuery('#IDVendor').html(options);
            },
            error: function () {
                jQuery('#IDVendor').html('<option value="NULL">none available</option>');
            }
        });
    }

    function loadRecord(GPNumber, dialog) {
        jQuery("#SaveButton").prop("disabled", true);

        jQuery.ajax({
            url: '@Url.Action("DetailGetRecords")',
            dataType: 'JSON',
            cache: false,
            data: { 'GPNumber': GPNumber },
            success: function (response) {
                if (response.viewmodel.length > 0) {
                    var ETA1Number = (response.viewmodel[0].TransportVesselMonitoring.ETA1 == null) ? 0 : Number(response.viewmodel[0].TransportVesselMonitoring.ETA1.match(/\d+/)[0]),
                        ETA2Number = 0,
                        EDT1Number = (response.viewmodel[0].TransportVesselMonitoring.EDT1 == null) ? 0 : Number(response.viewmodel[0].TransportVesselMonitoring.EDT1.match(/\d+/)[0]);

                    $("#GPNumber").val(response.viewmodel[0].TransportVesselMonitoring.GPNumber);
                    $("#ContainerNumber").val(response.viewmodel[0].TransportVesselMonitoring.ContainerNumber);
                    $("#ContainerSeal").val(response.viewmodel[0].TransportVesselMonitoring.ContainerSeal);

                    $("#ShipName").val(response.viewmodel[0].TransportVesselMonitoring.ShipName);

                    SetShipLocation();

                    if (response.viewmodel[0].TransportVesselMonitoring.ShipName) {
                        var ShipName = response.viewmodel[0].TransportVesselMonitoring.ShipName.split(";");
                        if (ShipName.length) {
                            var isMmsi = "",
                                mmsi = "";
                            for (i = 0; i < ShipName.length; i++) {
                                isMmsi = ShipName[i].replace(/\s+/g, "");
                                if (Math.floor(isMmsi) == isMmsi && $.isNumeric(isMmsi)) {
                                    mmsi = isMmsi;
                                    break;
                                }
                            }
                            if (mmsi) {
                                //$("#mapwrap").html("<iframe src='https://www.marinetraffic.com/en/ais/details/ships/mmsi:" + mmsi + "' width='100%' height='475px'>Sorry your browser does not support inline frames.</iframe>");
                            }
                        }
                    }

                    $("#TypeOfContainer").val(response.viewmodel[0].TransportVesselMonitoring.TypeOfContainer);
                    $("#POWeekAgent").val(response.viewmodel[0].TransportVesselMonitoring.POWeekAgent);
                    $("#Distance").val(response.viewmodel[0].TransportVesselMonitoring.Distance);
                    $("textarea#Remarks").val(response.viewmodel[0].TransportVesselMonitoring.Remarks);

                    $("#SJNumber").val(response.viewmodel[0].SJNumber);
                    $("#STONumber").val(response.viewmodel[0].STONumber);
                    for (i = 1; i < response.viewmodel.length; i++) {
                        var j = i + 1;
                        $("#SJNumber" + j).val(response.viewmodel[i].SJNumber);
                        $("#STONumber" + j).val(response.viewmodel[i].STONumber);
                    }

                    if (response.viewmodel[0].TransportVesselMonitoring.DateOfStuffing) {
                        $("#DateOfStuffing").val(moment(Number(response.viewmodel[0].TransportVesselMonitoring.DateOfStuffing.match(/\d+/)[0])).format('DD/MM/YYYY'));
                    }
                    if (response.viewmodel[0].GPDate) {
                        $("#GPDate").val(moment(Number(response.viewmodel[0].GPDate.match(/\d+/)[0])).format('DD/MM/YYYY'));
                    }
                    if (response.viewmodel[0].SJDate) {
                        $("#SJDate").val(moment(Number(response.viewmodel[0].SJDate.match(/\d+/)[0])).format('DD/MM/YYYY'));
                    }

                    // prevent 1900-01-01 00:00:00.000
                    if (parseInt(EDT1Number) < 2209014000000) {
                        $("#EDT1").val(moment(EDT1Number).format('DD/MM/YYYY'));
                    }
                    if (parseInt(ETA1Number) < 2209014000000) {
                        $("#ETA1").val(moment(ETA1Number).format('DD/MM/YYYY'));
                    }

                    // if not empty And not 1900-01-01 00:00:00.000
                    if (response.viewmodel[0].TransportVesselMonitoring.ActualReceived && (parseInt(Number(response.viewmodel[0].TransportVesselMonitoring.ActualReceived.match(/\d+/)[0])) < 2209014000000)) {
                        $("#ActualReceived").val(moment(Number(response.viewmodel[0].TransportVesselMonitoring.ActualReceived.match(/\d+/)[0])).format('DD/MM/YYYY'));
                    }
                    if (response.viewmodel[0].TransportVesselMonitoring.EDT2 && (parseInt(Number(response.viewmodel[0].TransportVesselMonitoring.EDT2.match(/\d+/)[0])) < 2209014000000)) {
                        $("#EDT2").val(moment(Number(response.viewmodel[0].TransportVesselMonitoring.EDT2.match(/\d+/)[0])).format('DD/MM/YYYY'));
                    }
                    if (response.viewmodel[0].TransportVesselMonitoring.ATD && (parseInt(Number(response.viewmodel[0].TransportVesselMonitoring.ATD.match(/\d+/)[0])) < 2209014000000)) {
                        $("#ATD").val(moment(Number(response.viewmodel[0].TransportVesselMonitoring.ATD.match(/\d+/)[0])).format('DD/MM/YYYY'));
                    }
                    if (response.viewmodel[0].TransportVesselMonitoring.ATA && (parseInt(Number(response.viewmodel[0].TransportVesselMonitoring.ATA.match(/\d+/)[0])) < 2209014000000)) {
                        $("#ATA").val(moment(Number(response.viewmodel[0].TransportVesselMonitoring.ATA.match(/\d+/)[0])).format('DD/MM/YYYY'));
                    }

                    $("#IDVendor").val(response.viewmodel[0].TransportVesselMonitoring.IDVendor);//$("#IDVendor").select2('val', response.viewmodel[0].TransportVesselMonitoring.IDVendor);
                    $("#OriginWarehouse").val(response.viewmodel[0].OriginWarehouse);//$("#OriginWarehouse").select2('val', response.viewmodel[0].OriginWarehouse);
                    $("#DestinationWarehouse").val(response.viewmodel[0].DestinationWarehouse);//$("#DestinationWarehouse").select2('val', response.viewmodel[0].DestinationWarehouse);

                    // calculate ETA2 && EstimationReceived
                    if (parseInt(ETA1Number) < 2209014000000) {
                        if (response.viewmodel[0].TransportVesselMonitoring.EDT2 && (parseInt(Number(response.viewmodel[0].TransportVesselMonitoring.EDT2.match(/\d+/)[0])) < 2209014000000)) {
                            var ETA2Diff = ETA1Number - EDT1Number;

                            ETA2Number = ETA2Diff + Number(response.viewmodel[0].TransportVesselMonitoring.EDT2.match(/\d+/)[0]);

                            $("#ETA2").val(moment(ETA2Number).format('DD/MM/YYYY'));
                        }

                        // EstimationReceived
                        generateEstimationReceived(ETA1Number, ETA2Number);
                    }

                    // Replace calculation above if ETA2 & EstimationReceived exist in DB
                    // ETA2
                    // if not empty And not 1900-01-01 00:00:00.000
                    if (response.viewmodel[0].TransportVesselMonitoring.ETA2 && (parseInt(Number(response.viewmodel[0].TransportVesselMonitoring.ETA2.match(/\d+/)[0])) < 2209014000000)) {
                        $("#ETA2").val(moment(Number(response.viewmodel[0].TransportVesselMonitoring.ETA2.match(/\d+/)[0])).format('DD/MM/YYYY'));
                    }
                    // EstimationReceived
                    // if not empty And not 1900-01-01 00:00:00.000
                    if (response.viewmodel[0].TransportVesselMonitoring.EstimationReceived && (parseInt(Number(response.viewmodel[0].TransportVesselMonitoring.EstimationReceived.match(/\d+/)[0])) < 2209014000000)) {
                        $("#EstimationReceived").val(moment(Number(response.viewmodel[0].TransportVesselMonitoring.EstimationReceived.match(/\d+/)[0])).format('DD/MM/YYYY'));
                    }
                    //$("#EditButton").prop("disabled", response.viewbag);
                }

                dialog.modal('hide');
            },
            error: function (jqXHR, exception) {
                dialog.modal('hide');
                alertNoRecord("GP Number equal to " + GPNumber);
            }
        });
    }

    function generateEstimationReceived(ETA1Number, ETA2Number) {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetMstConfigurationRecords")',
            data: { "PageName": "VesselMonitoringDetail", "Description": "est. received" },
            success: function (response) {
                var additionalDays = (response.length > 0) ? parseInt(response[0].Value) : 3;

                var EstimationReceivedValue = moment(ETA1Number).add(additionalDays, 'days').format('DD/MM/YYYY');

                if (ETA2Number) {
                    EstimationReceivedValue = moment(ETA2Number).add(additionalDays, 'days').format('DD/MM/YYYY');
                }

                jQuery("#EstimationReceived").val(EstimationReceivedValue);
            }
        });
    }

