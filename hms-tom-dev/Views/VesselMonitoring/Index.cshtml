            GPNumbers = (jQuery("#GPNumbers").val()) ? jQuery("#GPNumbers").val().join(",") : "",
            POWeekAgents = (jQuery("#POWeekAgents").val()) ? jQuery("#POWeekAgents").val().join(",") : "",
            IDVendor = jQuery("#IDVendor :selected").val(),
            IDRegion = jQuery("#IDRegion :selected").val(),
            DelayShipment = (jQuery('#DelayShipment').is(':checked')) ? jQuery('#DelayShipment').val() : "";

        var columns = "Stuffing Date,Origin,Region,Destination,Vendor,Ship,GP Number,SJ Number,ETD 1,ETD 2,ATD,Est. Received,Remarks",
            dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

        jQuery.ajax({
            url: '@Url.Action("ExportToExcel")',
            method: 'post',
            dataType: 'json',
            data: {
                "Columns": columns,
                "OriginWarehouses": OriginWarehouses,
                "DestinationWarehouses": DestinationWarehouses,
                "DateOfStuffingFrom": DateOfStuffingFrom,
                "DateOfStuffingTo": DateOfStuffingTo,
                "GPNumbers": GPNumbers,
                "POWeekAgents": POWeekAgents,
                "IDVendor": IDVendor,
                "Region": IDRegion,
                "DelayShipment": DelayShipment
            },
            success: function (response) {
                window.location.assign("Assets/Download/" + response);
                dialog.modal('hide');
            }
        });
    }

