<script type="text/javascript">
    jQuery(function ($) {
        stuffingDateRange();

        generateList();//generateTable();

        generateDropdownWarehouse();

        generateDropdownDestinationWarehouse();

        generateDropdownGPNumbers();

        generateDropdownIDVendor();

        generateRegion();

        $(document).on('click', '.search-filter', function (e) {
            generateList();//generateTable();
            e.preventDefault();
        });

        $(document).on('click', '.reset-search-filter', function (e) {
            $('form#filter')[0].reset();
            $(".IDLocation, #GPNumbers, #POWeekAgents, #IDVendor, #IDRegion").select2("val", "");
            stuffingDateRange();
            generateList();//generateTable();
            e.preventDefault();
        });

        $(document).on('click', '#exportDefaultButton', function (e) {
            exportToExcel();
            e.preventDefault();
        });

        $('#fileInputVesselMapping').on('change', function () {
            $("#btnUpload").prop("disabled", false);
        });

        $(document).on('click', '#btnUpload', function (e) {
            var filename;

            if (window.FormData !== undefined) {
                var dialog = bootbox.dialog({
                    message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Uploading...</div>',
                    closeButton: false
                }),
                fileUpload = $("#fileInputVesselMapping").get(0),
                files = fileUpload.files;

                // Create FormData object
                var fileData = new FormData();

                // Looping over all files and add it to FormData object
                for (var i = 0; i < files.length; i++) {
                    fileData.append(files[i].name, files[i]);
                    filename = files[i].name;
                }

                $.ajax({
                    url: '@Url.Action("UploadMstMappingFile")',
                    type: "POST",
                    contentType: false, // Not to set any content header
                    processData: false, // Not to process data
                    data: fileData,
                    success: function (result) {
                        $.ajax({
                            type: 'POST',
                            url: '@Url.Action("ImportMstMapping")',
                            data: {
                                "FileName": document.getElementById("fileInputVesselMapping").files[0].name
                            },
                            cache: false,
                            success: function (data) {
                                dialog.modal('hide');
                                bootbox.alert({
                                    message: '<i class="fa fa-check-circle fa-2x" style="color:green"></i><font class="text-success">  Upload Successfully</font>',
                                    size: 'small',
                                    callback: function () {
                                        $("#uploadModal").modal('hide');
                                    }
                                });
                            }
                        });
                    },
                    error: function (err) {
                        alert(err.statusText);
                    }
                });
            } else {
                alert("FormData is not supported.");
            }
        });

    });

    function exportToExcel(exportType) {
        var DateOfStuffingFrom = jQuery("#DateOfStuffingFrom").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
