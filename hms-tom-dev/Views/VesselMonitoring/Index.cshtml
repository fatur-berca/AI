    function generateList() {
        var DateOfStuffingFrom = jQuery("#DateOfStuffingFrom").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
            DateOfStuffingTo = jQuery("#DateOfStuffingTo").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
            OriginWarehouses = (jQuery("#OriginWarehouses").val()) ? jQuery("#OriginWarehouses").val().join(",") : "",
            DestinationWarehouses = (jQuery("#DestinationWarehouses").val()) ? jQuery("#DestinationWarehouses").val().join(",") : "",
            GPNumbers = (jQuery("#GPNumbers").val()) ? jQuery("#GPNumbers").val().join(",") : "",
            POWeekAgents = (jQuery("#POWeekAgents").val()) ? jQuery("#POWeekAgents").val().join(",") : "",
            IDVendor = jQuery("#IDVendor :selected").val(),
            IDRegion = jQuery("#IDRegion :selected").val(),
            DelayShipment = (jQuery('#DelayShipment').is(':checked')) ? jQuery('#DelayShipment').val() : "";

        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        jQuery('#checkall').attr('checked', false);

        jQuery.ajax({
            url: '@Url.Action("GetData")',
            method: 'get',
            dataType: 'json',
            cache: false,
            data: {
                "OriginWarehouses": OriginWarehouses,
                "DestinationWarehouses": DestinationWarehouses,
                "DateOfStuffingFrom": DateOfStuffingFrom,
                "DateOfStuffingTo": DateOfStuffingTo,
                "GPNumbers": GPNumbers,
                "POWeekAgents": POWeekAgents,
                "IDVendor": IDVendor,
                "Region": IDRegion,
                "DelayShipment": DelayShipment
            },
            success: function (response) {
                dialog.modal('hide');

                var theData = [],
                    theGPNumber = "";
                for (i = j = 0; i < response.length; i++) {
                    if (theGPNumber === response[i].GPNumber) {
                        continue;
                    }
                    theGPNumber = response[i].GPNumber;
                    theData[j++] = response[i];
                }

                var table = $('#dtFilter').DataTable({
                    data: theData,
                    "cache": false,
                    "destroy": true,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "iDisplayLength": 25,
                    columns: [
                        {
                            "data": "GPNumber", "class": "text-center", "render": function (datum) {
                                return '<div class="checkbox-deck"><input name="isActiveRecord" type="checkbox" value="' + datum + '" id="' + datum + '"><label for="' + datum + '"></label></div>';
                            }
                        },
                        {
                            "data": "DateOfStuffing", 'searchable': true, "render": function (datum, type, row) {
                                return (datum && (parseInt(Number(datum.match(/\d+/)[0])) < 2209014000000)) ? '<a href="@Url.Action("Detail")?GPNumber=' + row.GPNumber + '">' + moment(datum).format("DD-MMM-YYYY") + '</a>' : "";
                            }
                        },
                        { 'data': 'OriginWarehouse', 'searchable': true },
                        { 'data': 'Region', 'searchable': true },
                        { 'data': 'DestinationWarehouse', 'searchable': true },
                        { 'data': 'VendorName', 'searchable': true },
                        { 'data': 'ShipName', 'searchable': true },
                        { 'data': 'GPNumber', 'searchable': true },
                        //{ 'data': 'SJNumber', 'searchable': true },
                        {
                            'data': 'EDT1', 'searchable': true, "render": function (datum) {
                                return (datum && (parseInt(Number(datum.match(/\d+/)[0])) < 2209014000000)) ? moment(datum).format("DD-MMM-YYYY") : "";
                            }
                        },
                        {
                            'data': 'EDT2', 'searchable': true, "render": function (datum) {
                                return (datum && (parseInt(Number(datum.match(/\d+/)[0])) < 2209014000000)) ? moment(datum).format("DD-MMM-YYYY") : "";
                            }
                        },
                        {
                            'data': 'ATD', 'searchable': true, "render": function (datum) {
                                return (datum && (parseInt(Number(datum.match(/\d+/)[0])) < 2209014000000)) ? moment(datum).format("DD-MMM-YYYY") : "";
                            }
                        },
                        {
                            'data': 'EstimationReceived', 'searchable': true, "render": function (datum) {
                                return (datum && (parseInt(Number(datum.match(/\d+/)[0])) < 2209014000000)) ? moment(datum).format("DD-MMM-YYYY") : "";
                            }
                        },
                        { 'data': 'MainRemarks', 'searchable': true }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");

                $('#dtFilter thead.filters th').each(function (index) {
                    if (index == 0) {
                        $(this).text('Filter');
                    } else {
                        var title = $('#dtFilter thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                table.columns().every(function (index) {
                    $('#dtFilter thead.filters th:eq(' + index + ') input').on('keyup change', function () {
                        table.column($(this).parent().index() + ':visible').search(this.value).draw();
                    });
                });
            }
        });
    }

    function generateDropdownWarehouse() {
        return jQuery.ajax({
            url: '@Url.Action("GetMasterLocation")',
            dataType: 'JSON',
            data: { "Type": "Warehouse" },
            cache: false,
            success: function (response) {
                jQuery('.IDLocation').select2("destroy");
                var data = response.sort(function (a, b) { return a - b }),
                    options = '';
                jQuery.each(data, function (key, val) {
                    options = options + '<option value="' + val.IDLocation + ":" + val.LocationName + '">' + val.IDLocation + ":" + val.LocationName + '</option>';
                });
                jQuery('.IDLocation').html(options).select2();
            },
            error: function () {
                jQuery('.IDLocation').select2("destroy");
                jQuery('.IDLocation').html('<option value="NULL">none available</option>').select2();
            }
        });
    }

    function generateDropdownDestinationWarehouse() {
        return jQuery.ajax({
            url: '@Url.Action("GetDestinationWarehouses")',
            dataType: 'JSON',
            cache: false,
            success: function (response) {
                jQuery('.IDLocationDestination').select2("destroy");
                var data = response.sort(function (a, b) { return a - b }),
                    options = '';
                jQuery.each(data, function (key, val) {
                    options = options + '<option value="' + val.DestinationWarehouse + '">' + val.DestinationWarehouse + '</option>';
                });
                jQuery('.IDLocationDestination').html(options).select2();
            },
            error: function () {
                jQuery('.IDLocationDestination').select2("destroy");
                jQuery('.IDLocationDestination').html('<option value="NULL">none available</option>').select2();
            }
        });
    }

    function generateDropdownGPNumbers() {
        return jQuery.ajax({
            url: '@Url.Action("GetRecords")',
