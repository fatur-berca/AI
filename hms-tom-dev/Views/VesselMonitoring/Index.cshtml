@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "Transport > Vessel Monitoring";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button class="btn btn-primary" id="exportDefaultButton">Export</button>
        <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#customReportModal" id="customReportButton">Custom Report</button>
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Upload)))
        {
            <button class="btn btn-primary" data-toggle="modal" data-target="#uploadModal" id="uploadButton">Upload Vessel Mapping</button>
        }
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck nmb">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel wmb wbt">
            <form id="filter">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Stuffing Date</label>
                        <div class="row">
                            <div class="col-md-5">
                                <input type="text" class="form-control datepickerFromHaveFuture" id="DateOfStuffingFrom">
                            </div>
                            <div class="col-md-2 to-bi">
                                <label>To</label>
                            </div>
                            <div class="col-md-5">
                                <input type="text" class="form-control datepickerToHaveFuture" id="DateOfStuffingTo">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group checkbox-padding">
                        <div class="checkbox-deck">
                            <input type="checkbox" id="DelayShipment" value="delay">
                            <label for="DelayShipment"></label>
                        </div>
                        <span class="checkbox-deck-span">Delay Shipment</span>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Origin</label>
                        <select class="select2 IDLocation" multiple="multiple" id="OriginWarehouses"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Destination</label>
                        <select class="select2 IDLocationDestination" multiple="multiple" id="DestinationWarehouses"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>GP Number</label>
                        <select class="select2" multiple="multiple" id="GPNumbers"></select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Agent</label>
                        <select class="select2" multiple="multiple" id="POWeekAgents"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Vendor</label>
                        <select class="select2" id="IDVendor"><option value="">-- Select --</option></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Regional AOT</label> <!-- master transfort region -->
                        <select class="select2" id="IDRegion"><option value="">-- Select --</option></select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12">
                    <button class="btn btn-primary search-filter">Search</button>
                    <button class="btn btn-purple reset-search-filter">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

<table id="dtFilter" class="display table dataTable">
    <thead>
        <tr>
            <th data-orderable="false" class="text-center">
                <div class="checkbox-deck">
                    <input type="checkbox" id="checkall">
                    <label for="checkall"></label>
                </div>
            </th>
            <th>Stuffing Date</th>
            <th>Origin</th>
            <th>Region</th>
            <th>Destination</th>
            <th>Vendor</th>
            <th>Ship</th>
            <th>GP Number</th>
            <!--th>SJ Number</th-->
            <th>ETD 1</th>
            <th>ETD 2</th>
            <th>ATD</th>
            <th>Est. Received</th>
            <th class="long-col">Remarks</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th class="text-center">Filter</th>
            <th>Stuffing Date</th>
            <th>Origin</th>
            <th>Region</th>
            <th>Destination</th>
            <th>Vendor</th>
            <th>Ship</th>
            <th>GP Number</th>
            <!--th>SJ Number</th-->
            <th>ETD 1</th>
            <th>ETD 2</th>
            <th>ATD</th>
            <th>Est. Received</th>
            <th>Remarks</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Upload File</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form id="formUpload">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">Upload Vessel Mapping</label>
                                <input type="file" class="filestyle" id="fileInputVesselMapping" accept=".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel">
                                <a href="Assets/Download/TemplateExcel/VesselMappingTemplate.xlsx" id="downloadTemplate">Download Template</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnUpload" disabled>Upload</button>
            </div>
        </div>
    </div>
</div>

