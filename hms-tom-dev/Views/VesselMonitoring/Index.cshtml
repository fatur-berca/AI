    function generateRegion() {
        jQuery.ajax({
            url: '@Url.Action("GetRegion")',
            dataType: 'JSON',
            success: function (response) {
                jQuery('#IDRegion').select2("destroy");
                var data = response.sort(function (a, b) { return a - b }),
                    options = '<option value="">-- Select --</option>',
                    theTransReg = "";
                jQuery.each(data, function (key, val) {
                    if (theTransReg !== val.TransportRegion) {
                        options = options + '<option value="' + val.TransportRegion + '">' + val.TransportRegion + '</option>';
                        theTransReg = val.TransportRegion;
                    }
                });
                jQuery('#IDRegion').html(options).select2();
            },
            error: function () {
                jQuery('#IDRegion').select2("destroy");
                jQuery('#IDRegion').html('<option value="NULL">none available</option>').select2();
            }
        });
    }

    function stuffingDateRange() {
        var twoMonthsAgo = moment().subtract(2, 'weeks').format('DD/MM/YYYY'),
            today = moment().format('DD/MM/YYYY');

        jQuery('#DateOfStuffingFrom').val(twoMonthsAgo);
        jQuery('#DateOfStuffingTo').val(today);
    }
</script>
