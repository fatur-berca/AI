<script type="text/javascript">
    jQuery(function ($) {
        var stringCode = '';
        $('#btnPrint').on('click', function () {
            var urlDownloadPdf = '@Url.Action("downloadETransportCardPdf")' + "?codes=" + stringCode;
            window.location.href = urlDownloadPdf;
        });

        $('#btnGenerate').on("click", function () {
            var codes = [];
            var is_not_empty = false;
            stringCode = '';

            for (var i = 1; i <= @MAX_INPUT_TRANSPORT_CARD; i++)
            {
                var code = $('#barcode_format_1_' + i).val() + ' ' + $('#barcode_format_2_' + i).val() + ' ' + $('#barcode_format_3_' + i).val();
                if ($.trim(code) != '' && !is_not_empty) is_not_empty = true;
                codes.push(code);
                stringCode += '|' + code;
            }
            stringCode = stringCode.substr(1, stringCode.length);

            if (!is_not_empty)
            {
                bootbox.alert("Please fill transport card number (min. 1).");
                return;
            }

            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

            $.ajax({
                beforeSend: function () {
                    
                },
                complete: function () {
                    
                },
                type: "POST",
                url: '@Url.Action("GenerateBarcode")',
                datatype: "json",
                traditional: true,
                data: { 'codes': codes },
                success: function (res) {
                    if (res.length > 0)
                    {
                        $('.preview_barcode').css('display', 'none');
                        var is_has_data = false;
                        for (var i = 0; i < res.length; i++)
                        {
                            var base64String = "data:image/png;base64," + res[i];
                            if (res[i] != '')
                            {
                                $('#preview_barcode_' + (i + 1)).css('display', 'inline');
                                is_has_data = true;
                            }
                            $('#preview_barcode_' + (i+1)).attr('src', base64String);
                        }

                        if (is_has_data) $('#btnPrint').show();
                    }
                    dialog.modal("hide");
                }
            });
        });
    });
</script>
