@using System.Web.Mvc.Html
@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "Transport > e-Transport Barcode Generator";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
    const byte MAX_INPUT_TRANSPORT_CARD = 9;
}
<style>
    .col-sm-1
    {
        width: 1%;
    }

    .input-barcode
    {
        text-transform: uppercase;
        text-align: center;
    }

    .separator
    {
        width: 2px;
        padding-left: 0px;
        padding-right: 0px; 
        margin-top: 8px; 
    }
</style>

<div class="title-deck wmb">
    <button class="btn btn-primary" type="button" id="btnGenerate">Generate</button>
    <button class="btn btn-primary" type="button" id="btnPrint" style="display:none">Print</button>
</div>

<div class="col-md-12">
    @for (var i = 1; i <= MAX_INPUT_TRANSPORT_CARD; i++)
    {
        <div class="row" style="margin-bottom: 5px;">
            <div class="col-sm-1">
                <label>@i</label>
            </div>
            <div class="col-md-1">
                <input type="input" style="width:60px;" class="form-control input-barcode" id="barcode_format_1_@i" maxlength="2" placeholder="L">
            </div>
            <div class="col-md-1 separator" style="">
                -
            </div>
            <div class="col-md-2">
                <input type="input" style="" class="form-control input-barcode" id="barcode_format_2_@i" min="0" maxlength="4" placeholder="7789">
            </div>
            <div class="col-md-1 separator" style="">
                -
            </div>
            <div class="col-md-1">
                <input type="input" style="width:60px;" class="form-control input-barcode" id="barcode_format_3_@i" maxlength="3" placeholder="US">
            </div>
            <div class="col-md-4">
                <img src="" id="preview_barcode_@i" class="preview_barcode" style="width: 200px; height: 35px; display:none">
            </div>
        </div>
    }
</div>

