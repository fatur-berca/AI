@using EnumHelper = DFIS.Utils.EnumHelper
@{
	var listUserRole = ViewBag.ListUserRole;
}

<!-- Custom Report Modal Dialog -->
<div class="modal fade" id="customReportModal" tabindex="-1" role="dialog">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
				<h4 class="modal-title" id="myModalLabel">Custom Report</h4>
			</div>
			<div class="modal-body custom-report">
				<div class="row label-top">
					<div class="col-md-6">
						<label>Column Set</label>
					</div>
					<div class="col-md-6">
						<label class="dis">Displayed Columns</label>
						<select id="layoutSelect" class="form-control">
							<option value="">Loading...</option>
						</select>
					</div>
				</div>
				<div class="clearfix"></div>
				<div id="fieldChooser" tabindex="1" class="field-chooser form-group">
					<div id="sourceFields" class="source">
						<div data-field="Location">Location</div>
						<div data-field="January">January</div>
						<div data-field="February">February</div>
						<div data-field="March">March</div>
						<div data-field="April">April</div>
						<div data-field="May">May</div>
						<div data-field="June">June</div>
						<div data-field="July">July</div>
						<div data-field="August">August</div>
						<div data-field="September">September</div>
						<div data-field="October">October</div>
						<div data-field="November">November</div>
						<div data-field="December">December</div>
					</div>
					<div class="button-column">
						<div>
							<input class="btn btn-info mini" type="button" id="left" value="<">
							<input class="btn btn-info mini" type="button" id="right" value=">">
						</div>
					</div>
					<div id="destinationFields" class="destination"></div>
				</div>
				<div class="opt-bot">
					<div class="row">
						<div class="col-md-6">
							<input class="btn btn-info amr" type="button" id="rightall" value=">>">
							<input class="btn btn-info" type="button" id="leftall" value="<<">
						</div>
						<div class="col-md-6">
							<input class="btn btn-info" type="button" id="saveLayoutButton" value="Save Layout">
							<input type="text" class="form-control" id="layoutName">
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				@foreach (var x in listUserRole)
				{
					if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
					{
						<div class="form-group pull-left">
							<div class="checkbox-deck">
								<input type="checkbox" id="chkGlobalCustomReport">
								<label for="chkGlobalCustomReport"></label>
							</div>
							<span class="checkbox-deck-span">Global Custom Report</span>
						</div>
					}
				}
				<button class="btn btn-primary" id="exportCustomReport">Export</button>
				<button class="btn btn-purple" data-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

<style>
	.fc-selected {
		background-color: #f39814 !important;
	}
</style>

<script type="text/javascript">
    jQuery(function ($) {
        $("#fieldChooser").fieldChooser($("#sourceFields"), $("#destinationFields"));

        $(document).on('click', '#saveLayoutButton', function (e) {
            saveLayout();
            e.preventDefault();
        });

        $(document).on('click', '#left', function (e) {
            moveItems('#destinationFields', '#sourceFields');
            e.preventDefault();
        });

        $(document).on('click', '#right', function (e) {
            moveItems('#sourceFields', '#destinationFields');
            e.preventDefault();
        });

        $(document).on('click', '#leftall', function (e) {
            moveAllItems('#destinationFields', '#sourceFields');
            e.preventDefault();
        });

        $(document).on('click', '#rightall', function (e) {
            moveAllItems('#sourceFields', '#destinationFields');
            e.preventDefault();
        });

        $(document).on('click', '#customReportButton', function (e) {
            $("#layoutName").val('');
            generateLayoutSelect();
            e.preventDefault();
        });

        $('#layoutSelect').on('change', function () {
            for (var j = 1; j < layoutIsGlobal.length; j++) {
                if ($('#layoutSelect option:selected').text() == layoutIsGlobal[j].LayoutName) {
                    $('#chkGlobalCustomReport').prop('checked', layoutIsGlobal[j].isGlobal);
                }
            }
            var sourceFieldNames = [
                    { 'field': 'Location', 'label': 'Location' },
                    { 'field': 'January', 'label': 'January' },
                    { 'field': 'February', 'label': 'February' },
                    { 'field': 'March', 'label': 'March' },
                    { 'field': 'April', 'label': 'April' },
                    { 'field': 'May', 'label': 'May' },
                    { 'field': 'June', 'label': 'June' },
                    { 'field': 'July', 'label': 'July' },
                    { 'field': 'August', 'label': 'August' },
                    { 'field': 'September', 'label': 'September' },
                    { 'field': 'October', 'label': 'October' },
                    { 'field': 'November', 'label': 'November' },
                    { 'field': 'December', 'label': 'December' }
                ],
            sourceFields = '',
            destinationFieldNames = this.value.split(','),
            destinationFields = '',
            destinationfieldLabels = [];

            for (i = 0; i < sourceFieldNames.length; ++i) {
                if (jQuery.inArray(sourceFieldNames[i]['field'], destinationFieldNames) == -1) {
                    // the element is not in the array
                    sourceFields = sourceFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + sourceFieldNames[i]['field'] + "'>" + sourceFieldNames[i]['label'] + "</div>";
                } else {
                    destinationfieldLabels[sourceFieldNames[i]['field']] = sourceFieldNames[i]['label'];
                }
            }

            $("#fieldChooser #sourceFields").html(sourceFields);

            for (i = 0; i < destinationFieldNames.length; ++i) {
                destinationFields = destinationFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + destinationFieldNames[i] + "'>" + destinationfieldLabels[destinationFieldNames[i]] + "</div>";
            }
            $("#fieldChooser #destinationFields").html(destinationFields);
        });

        $(document).on('click', '#exportCustomReport', function (e) {
            exportCustomToExcel();
            e.preventDefault();
        });
    });

    var layoutIsGlobal = [];

    function moveItems(origin, dest) {
        jQuery(origin).find('.fc-selected').appendTo(dest);
    }

    function moveAllItems(origin, dest) {
        jQuery(origin).children().appendTo(dest);
    }

    function generateLayoutSelect() {
        var firstLayout = "",
            thenLayout = "",
            k = 0;

        jQuery.ajax({
            url: '@Url.Action("GetLayouts", "CustomReportState")',
            method: 'post',
            dataType: 'json',
            data: { "PageName": "ViewAnnualWarehouseUtilization" },
            success: function (response) {
                var layoutName = '',
                    options = '';

                if (parseInt(response.length) > 0) {
                    options = '';
                    for (var i = 0; i < response.length; ++i) {
                        if (layoutName != response[i].LayoutName) {
                            if (firstLayout == "") {
                                firstLayout = response[i].LayoutName;
                                ++k;
                                layoutIsGlobal[k] = { "isGlobal": response[i].IsGlobal, "LayoutName": response[i].LayoutName };
                            }

                            if (firstLayout != response[i].LayoutName) {
                                thenLayout = response[i].LayoutName;
                                ++k;
                                layoutIsGlobal[k] = { "isGlobal": response[i].IsGlobal, "LayoutName": response[i].LayoutName };
                            }

                            options = options + "'>" + layoutName + "</option><option value='" + response[i].FieldName;
                            layoutName = response[i].LayoutName;
                        } else {

                            options = options + "," + response[i].FieldName;
                        }
                    }
                    options = options + "'>" + layoutName + "</option>";
                    jQuery("#layoutSelect").html(options.slice(11)).ready(function () {
                        // Load selected layout
                        jQuery.ajax({
                            url: '@Url.Action("GetSelectedLayout", "CustomReportState")',
                            method: 'post',
                            dataType: 'json',
                            data: { "PageName": "ViewAnnualWarehouseUtilization" },
                            success: function (json) {
                                $('#layoutSelect').val(json[0].FieldName);
                                for (var j = 1; j < layoutIsGlobal.length; j++) {
                                	if ($('#layoutSelect option:selected').text() == layoutIsGlobal[j].LayoutName) {
                                		$('#chkGlobalCustomReport').prop('checked', layoutIsGlobal[j].isGlobal);
                                	}
                                }
                            	var sourceFieldNames = [
									{ 'field': 'Location', 'label': 'Location' },
									{ 'field': 'January', 'label': 'January' },
									{ 'field': 'February', 'label': 'February' },
									{ 'field': 'March', 'label': 'March' },
									{ 'field': 'April', 'label': 'April' },
									{ 'field': 'May', 'label': 'May' },
									{ 'field': 'June', 'label': 'June' },
									{ 'field': 'July', 'label': 'July' },
									{ 'field': 'August', 'label': 'August' },
									{ 'field': 'September', 'label': 'September' },
									{ 'field': 'October', 'label': 'October' },
									{ 'field': 'November', 'label': 'November' },
									{ 'field': 'December', 'label': 'December' }
                                    ],
                                sourceFields = '',
                                destinationFieldNames = json[0].FieldName.split(','),
                                destinationFields = '',
                                destinationfieldLabels = [];

                                for (i = 0; i < sourceFieldNames.length; ++i) {
                                    if (jQuery.inArray(sourceFieldNames[i]['field'], destinationFieldNames) == -1) {
                                        // the element is not in the array
                                        sourceFields = sourceFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + sourceFieldNames[i]['field'] + "'>" + sourceFieldNames[i]['label'] + "</div>";
                                    } else {
                                        destinationfieldLabels[sourceFieldNames[i]['field']] = sourceFieldNames[i]['label'];
                                    }
                                }
                                $("#fieldChooser #sourceFields").html(sourceFields);

                                for (i = 0; i < destinationFieldNames.length; ++i) {
                                    destinationFields = destinationFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + destinationFieldNames[i] + "'>" + destinationfieldLabels[destinationFieldNames[i]] + "</div>";
                                }

                                $("#fieldChooser #destinationFields").html(destinationFields);
                            }
                        });
                    });
                } else {
                    jQuery("#layoutSelect").html(options);
                }
            }
        });
    }

    function saveLayout() {
        var nonvalid = false;

        if ($("#layoutName").val() == "") { //layout name
            $("#layoutName").css('border-color', 'orange');
            nonvalid = true;
        } else {
            $("#layoutName").css('border-color', '#ccc');
        }

        if (nonvalid == true) {
            alertCrPleaseFill();

            return false;
        } else {
            var fieldNames = '',
                layoutName = $("#layoutName").val(),
                isGlobal = ($("#chkGlobalCustomReport").prop('checked')) ? true : false;

            $('#destinationFields .fc-field').each(function () {
                fieldNames = fieldNames + $(this).data('field') + ',';
            });
            fieldNames = fieldNames.slice(0, -1);

            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

            jQuery.ajax({
                url: '@Url.Action("InsertRecords", "CustomReportState")',
                method: 'post',
                dataType: 'json',
                data: { "layoutName": layoutName, "fieldNames": fieldNames, "pageName": "BeetleTrapMonitoring", "isGlobal": isGlobal },
                success: function (response) {
                    if (response == "Success") {
                        if (isGlobal) {
                            SaveChangesButton(dialog);
                        } else {
                            alertCrSaveSuccess();
                            dialog.modal('hide');
                            $("#chkGlobalCustomReport").prop('checked', false);
                        }
                    } else if (response == "NoLayoutName") {
                        alertCrPleaseFill();
                        dialog.modal('hide');
                    }

                    if ($("#layoutName").val() != $("#layoutSelect option:selected").text()) {
                        $("#layoutSelect").append('<option value="' + fieldNames + '">' + layoutName + '</option>').val(fieldNames);
                    }
                }
            });
            return true;
        }
    }

    function SaveChangesButton(dialog) {
        var selectedLayoutName = $("#layoutName").val(),
            destinationFields = '',
            isGlobal = ($("#chkGlobalCustomReport").prop('checked')) ? true : false;

        $('#destinationFields .fc-field').each(function () {
            destinationFields = destinationFields + $(this).data("field") + ',';
        });
        destinationFields = destinationFields.slice(0, -1);

        $.ajax({
            url: '@Url.Action("SaveSelectedLayout", "CustomReportState")',
            method: 'post',
            dataType: 'json',
            data: { "layoutName": selectedLayoutName, "fieldNames": destinationFields, "pageName": "BeetleTrapMonitoring", "isGlobal": isGlobal },
            success: function (response) {
                dialog.modal('hide');
                if (response == "Success") {
                    alertCrSaveSuccess();
                } else {
                    alertCrSaveFail();
                }
            }
        });
    }

    function exportCustomToExcel() {
        var columns = "",
            dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        jQuery('#destinationFields .fc-field').each(function () {
            columns = columns + $(this).text() + ',';
        });
        columns = columns.slice(0, -1);
        var year = $(".yearpicker").val();
        console.log(year);
        if (year == undefined || year == null) {
        	year = new Date().getFullYear();
        } else {
        	if (year.length > 4)
        		year = new Date().getFullYear();
        }
        if (typeof year == "string") {
        	year = new Date().getFullYear();
        }
        jQuery.ajax({
            url: '@Url.Action("FetchData", "ViewAnnualWarehouseUtilization")',
            method: 'get',
            dataType: 'json',
            data: {
                "flag": "custom",
            	"Columns": columns,
            	"year": year
            },
            cache: false,
            success: function (response) {
                window.location.assign("Assets/Download/" + response);
                dialog.modal('hide');
            }
        });

    }
</script>


