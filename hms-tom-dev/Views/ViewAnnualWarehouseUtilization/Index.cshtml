@using System.Web.Mvc.Html
@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "KPI > Annual Warehouse Utilization";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
        {
            <button class="btn btn-primary" id="buttonExport">Export</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
        {
            <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#customReportModal" id="customReportButton">Custom Report</button>
        }
    </div>
    <a href="#filter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
</div>
<textarea id="simpanData" hidden></textarea>
<div class="filter-deck nmb">
    <div id="filter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="year">Year</label>
                    <input type="text" id="year" name="year" class="form-control yearpicker" placeholder="Enter year" value="@DateTime.Now.Year" />
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="col-md-12">
                <button type="button" class="btn btn-primary" onclick="callFilterByYear()">Search</button>
            </div>
        </div>
    </div>
</div>

<div id="tableList"></div>

@Html.Action("PartialViewCustomReport")

