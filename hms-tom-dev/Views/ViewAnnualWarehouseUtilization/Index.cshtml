    Number.prototype.decimalPlaces = function (n) {
        var n = (typeof n === 'undefined') ? 2 : n,
            numberOfDecimal = (Math.floor(this.valueOf()) === this.valueOf()) ? 0 : (this.toString().split(".")[1].length || 0);

        return (numberOfDecimal > 0) ? this.valueOf().toFixed(parseInt(n)) : this.valueOf();
    }


