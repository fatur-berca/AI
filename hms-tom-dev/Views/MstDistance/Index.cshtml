                                        </div>
                                        <div class="col-md-3" style="padding-left: 5px; padding-top:10px">
                                            <span class="">KM</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6" id="divBuffer">
                                <div class="form-group">
                                    <label>Buffer</label>
                                    <div class="col-md-9" style="padding-right: 0px; padding-left: 0px; padding-bottom: 10px;">
                                        <input type="number" id="Buffer" class="form-control">
                                    </div>
                                    <div class="col-md-3" style="padding-left: 5px; padding-top:10px">
                                        <span class="">%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>Effective Date</label>
                                    <input type="text" id="StartDate" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                                </div>
                            </div>
                            <div class="col-md-1">
                                <div class="form-group">
                                    <label class="hidden-sm hidden-xs">&nbsp;</label>
                                    <label>To</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="hidden-sm hidden-xs">&nbsp;</label>
                                    <input type="text" id="EndDate" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                                </div>
                            </div>
                            <div class="col-md-3" hidden>
                                <div class="form-group">
                                    <label>Active</label>
                                    <select class="form-control" id="Status">
                                        <option value="1">YES</option>
                                        <option value="0">NO</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveNew">Save</button>
            </div>
        </div>
    </div>
</div>
