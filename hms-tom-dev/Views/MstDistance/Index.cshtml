@{
    ViewBag.Title = " Master Data > Distance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#addnew">Add New</button>
        <button id="uploadDistance" class="btn btn-primary" type="button" data-toggle="modal" onclick="
        $('.jfilestyle').find('input').val('');
        $('#fileInput').val('');
    " data-target="#uploadDistanceModal">
            Upload
        </button>
        @*Nicco added*@
        <a href="#" id="exportLink">
            <button id="btnExport" class="btn btn-primary">Export</button>
        </a>

    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter" id="advSrc"><b>Advanced Search </b><i class="fa fa-angle-down"></i></a>
</div>
<div class="filter-deck nmb">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel wmb wbt">
            <form id="filter">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Effective Date</label>
                        <input type="text" name="" id="FilterFrom" class="form-control datepicker">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Sender</label>
                        <select id="FilterSenderLocation" class="select2" multiple></select>
                    </div>
                </div>
                <div class="col-md-12">
                    <button class="btn btn-primary search-filter">Search</button>
                    <button class="btn btn-purple reset-search-filter">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>
<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr>
            <th width=5% nowrap class="text-center">Active</th>
            <th>Data Type</th>
            <!--
            <th style="min-width: 130px">Transportation Mode</th>
                -->
            <th>Sender</th>
            <th>Through</th>
            <th>Receiver</th>
            <th>Via</th>
            <th>Distance</th>
            <th>Buffer</th>
            <th>Total</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center">Action</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th width=5% nowrap class="text-center">Filter</th>
            <th>Data Type</th>
            <!--
            <th>Transportation Mode</th>
                -->
            <th>Sender</th>
            <th>Through</th>
            <th>Receiver</th>
            <th>Via</th>
            <th>Distance</th>
            <th>Buffer</th>
            <th>Total</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center"></th>
        </tr>
    </thead>
</table>

<!-- Modal -->
<div class="modal fade" id="addnew" tabindex="-1" role="dialog">
