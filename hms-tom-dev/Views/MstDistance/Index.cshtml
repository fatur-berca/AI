<script type="text/javascript">
    ez.Form.AddFieldDef(
        "id: DistanceType; class: req doe dd; label: Distance Type",
        "id: TransportMode; class: dd; label: Transportation Mode; json:TransportationMode",
        "id: idSender; class: req doe dd; label: Sender; json:IDSender",
        "id: idReceiver; class: req doe dd; label: Receiver; json:IDReceiver",
        "id: Distance; class: req num; label: Distance; json:Distance",
        "id: Buffer; class: req num; label: Buffer; json:Buffer",
        "id: StartDate; class: req; label: Effective Date (Start); json:EffectiveStartDate; dataType: date; displayFormat: DD/MM/YYYY; default: " + moment(new Date()).format("DD/MM/YYYY"),
        "id: EndDate; class: req; label: Effective Date (End); json:EffectiveEndDate; dataType: date; displayFormat: DD/MM/YYYY; default: 31/12/2999",
        "id: idThrough; class:doe dd; label: Through; json:Through",
        "id: Via; class:doe dd; label: Via; json:Via",
        "id: divThrough; class: container trip",
        "id: divVia; class: container trip"
    );
    ez.Form.debugMode = true;
    $(document).ready(function () {
        getUserWarehouse();
        //ez.Form.RegisterDropDown("FilterSenderLocation", "@Url.Action("GetUserWarehouse")", "IDLocation", "LocationName", "FieldValue");
        ez.Form.RegisterDropDown("DistanceType", "@Url.Action("GetDropDownType")", "FieldValue", "FieldValue");
        ez.Form.RegisterDropDown("idSender", "@Url.Action("GetUserWarehouse")", "IDLocation", "LocationName", "FieldValue");
        ez.Form.RegisterDropDown("idReceiver", "@Url.Action("GetUserWarehouse")", "IDLocation", "LocationName", "FieldValue");
        ez.Form.RegisterDropDown("idThrough", "@Url.Action("GetUserWarehouse")", "IDLocation", "LocationName");
        ez.Form.RegisterDropDown("Via", "@Url.Action("GetDropDownVia")", "FieldValue", "FieldValue");
        ez.Form.RegisterDropDown("TransportMode", "@Url.Action("GetDropDownTm")", "FieldValue", "FieldValue");

        $("#FilterFrom").val(moment(new Date()).format("DD/MM/YYYY"));

        $('#addNew').click(function () {
            ez.Form.Enable("doe");
            ez.Form.Hide("trip");

            ez.Form.RemoveProp("Via", "req");
            ez.Form.RemoveProp("idThrough", "req");

            $('#InsertOrUpdate').val("INSERT");

            $('#newData')[0].reset();
            ez.Form.Clear();
            $("#idSender").val(null).trigger("change");
            $("#idReceiver").val(null).trigger("change");
        });

        ez.Form.NumberOnly('Buffer');


        //generateTable();
    });

    $("#Distance").change(function () {
        this.value = parseFloat(this.value).toFixed(2);
    });

    $(document).on('click', '#delConfirm', function () {
        $('#modalconfirm').modal('hide');
        del();
    });
    //generate table
    function generateTable() {
        var filterdate = $('#filter').find('input[id="FilterFrom"]').val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
        $.ajax({
            url: '@Url.Action("GetMasterDistance")',
            method: 'post',
            dataType: 'json',
            cache: false,
            data: {
                "filterDate": filterdate,
                "filterSenderLocation": $('#FilterSenderLocation').val()
            },
            success: function (data) {
                console.log(data);
                var table = $('#dtFilterMaster').DataTable({
                    "destroy": true,
                    data: data,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "iDisplayLength": 25,
                    aaSorting: [[2, 'asc'], [4, 'asc'], [3, 'asc'], [5, 'asc'], [9, 'desc']],
                    columns: [
                       {
                            "data": "IsActive", 'sortable': false, "class": "text-center", "render": function (data) {

                               if (data == true) {

                                   return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                               } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }

                           }
                       },
                        { 'data': 'DistanceType', 'searchable': true },
                        //{ 'data': 'TransportationMode', 'searchable': true },
                        {
                            'data': 'SenderName', 'searchable': true, "render": function (data, type, row) {
                                if (row['IDSender'])
                                    return row['SenderName'];
                            }
                        },
                        {
                            'data': 'ThroughName', 'searchable': true, "render": function (data, type, row) {
                                if (row['Through'])
                                    return row['ThroughName'];
                                return "";
                            }
                        },
                        {
                            'data': 'ReceiverName', 'searchable': true, "render": function (data, type, row) {
                                if (row['IDReceiver'])
                                    return row['ReceiverName'];
                            }
                        },
                        { 'data': 'Via', 'searchable': true },
                        { 'data': 'Distance', 'searchable': true },
                        { 'data': 'Buffer', 'searchable': true },
                        { 'data': 'Total', 'searchable': true, "render": function (data) { return Math.round(data); } },
                        {
                           'data': 'EffectiveStartDate', 'searchable': true, "render": function (data, type, row) {
                               return moment(row['EffectiveStartDate']).format("DD-MMM-YYYY");
                           }
                       },
                       {
                           'data': 'EffectiveEndDate', 'searchable': true, "render": function (data, type, row) {
                               return moment(row['EffectiveEndDate']).format("DD-MMM-YYYY");
                           }
                       },
                       {
                           'data': 'UpdatedDate', 'searchable': true, "render": function (data, type, row) {
                               var jamtanggal = moment(row['UpdatedDate']).format("DD-MMM-YYYY HH:mm");
                               return '<label hidden>' + row['UpdatedDate'] + '</label>by ' + row['UpdatedBy'] + ' on ' + jamtanggal;
                           }
                       },
                       { 'data': 'UpdatedDate', 'class': 'hidden' },
                            {
                                "data": "IDDistance", 'sortable': false, "render": function (data) {
                                    return '<div align="center"><a href="#" id="editForm" onclick="return editTable(' + data + ')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a>' + '<a href="#" style="margin-left:5px" onclick="confirm(' + data + ');" title="Delete"><i data-toggle="modal" class="fa fa-trash"></i></a></div>';
                                }
                            }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 1) && (index <= 11)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                //searching with column on datatable
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });
            }
        });
    }

    function confirm(ID) {
        $('#modalconfirm').modal('show');
        $('#keyID').val(ID);
    }

    $("#DistanceType").change(function () {
        var valType = $("#DistanceType").val();
        if (valType == "Sea" || valType == "Rail" || valType == "KM Based" || valType == "Box Based") {
            ez.Form.Hide("trip");

            ez.Form.RemoveProp("Via", "req");
            ez.Form.RemoveProp("idThrough", "req");
        }
        if (valType == "Trip Based") {
            ez.Form.Show("trip");
            ez.Form.RefreshDropDown("Via");
            ez.Form.RefreshDropDown("idThrough");

            //ez.Form.AddProp("Via", "req");
            //ez.Form.AddProp("idThrough", "req");
            console.log(ez.Form._fields);
        }
    });

    function getUserWarehouse() {
        return jQuery.ajax({
            url: '@Url.Action("GetUserWarehouse")',
            dataType: 'JSON',
            cache: false,
            success: function (response) {
                $('#idSender,#idReceiver,#idThrough,#FilterSenderLocation').select2("destroy");
                var data = response.sort(function (a, b) { return a - b }),
                    options = '<option value="">&nbsp;</option>';
                $.each(data, function (key, val) {
                    options = options + '<option value="' + val.IDLocation + '">' + val.LocationName + '</option>';
                });
                $('#idSender,#idReceiver,#idThrough,#FilterSenderLocation').html(options).select2();

                $('#FilterSenderLocation').select2('val', data[0].IDLocation);
                generateTable();
            },
            error: function () {
                $('#idSender,#idReceiver,#idThrough,#FilterSenderLocation').select2("destroy");
                $('#idSender,#idReceiver,#idThrough,#FilterSenderLocation').html('<option value="NULL">none available</option>').select2();
            }
        });
    }

    // BEGIN : Insert New Data
    $('#btnSaveYes').click(function () {
        edit(false);
        $('#setinactive').modal('hide');
    });

    $('#btnSaveNew').click(function () {
        if ($('#InsertOrUpdate').val() == "UPDATE") {
            if (Validate())
                $('#setinactive').modal('show');
        } else {
            edit(true);
            $('#setinactive').modal('hide');
        }
    });

    $("#EndDate").blur(function () {
        if ($("#EndDate").val() === "") {
            $("#EndDate").val("31/12/2999");
        }
    });

    function Validate() {
        if (ez.Form.Validate()) {
            return true;
        }
        $("#textModalError").html("");
        $("#textModalError").append(ez.Form.error);
        $('#modalerror').modal('show');
        return false;
    }

    //update edited data
    function edit(statusSave) {
        //$('#Loading').modal('show');
        var id = $('#IDDistance').val();
        var pulled = ez.Form.GetData();
        if (Validate()) {
            // fill hidden data
            pulled['CreatedBy'] = $("#crBy").val() || "Me";
            pulled['CreatedDate'] = $("#CreatedDate").val();
            pulled['IsActive'] = true;
            pulled['TransportationMode'] = "-";
            pulled['Via'] = $("#Via").val();
            pulled['Through'] = $("#idThrough").val();
            if (!statusSave)
                pulled['IDDistance'] = id;
            pulled["Distance"] = ez_trunc((Number(pulled["Distance"]) || Number(pulled["Distance"].replace(",", "."))) * 100);
            var data =  {
                "new": statusSave ? [pulled] : [{}],
                "edit": !statusSave ? [pulled] : [{}]
            }
            console.log("Data: ", data);
            $.ajax({
                type: 'POST',
                url: '@Url.Action("InsertDistance")',
                data: data,
                success: function (result) {
                    if (result.IsSuccess) {
                        generateTable();
                        $('#labelsuccess').html('Your data has been successfully saved');
                        $('#modalsuccess').modal('show');
                        $('#inputModal').modal('hide');
                        $('#addnew').modal('hide');
                    }
                    else {
                        $("#textModalError").html('<strong style="font- size:larger">Failed to save data!</strong><br/>' + result.ErrorMessage);
                        $('#modalerror').modal('show');
                    }
                },
                error: function (msg) {
                    $("#textModalError").html("Failed to save data.");
                    $('#modalerror').modal('show');
                }
            });
        }
    }

    function del(id) {
        jQuery.ajax({
            type: 'POST',
            url: '@Url.Action("Delete")',
            data: { keyID: $("#keyID").val() },
            success: function (result) {
                if (result.IsSuccess == false) {
                    $("#textModalError").html("Failed to delete data!");
                    $('#modalerror').modal('show');
                }
                else
                {
                    $('#labelsuccess').html('Your data has been successfully deleted');
                    $('#modalsuccess').modal('show');
                }
                generateTable();
            }
        });
    }

    ez.debugMode = true;
    function editTable(id) {
        ez.Form.Disable("doe");
        $('#InsertOrUpdate').val("UPDATE");
        $.ajax({
            url: 'MstDistance/GetDataById',
            type: "GET",
            contentType: "application/json;charset=UTF-8",
            dataType: "json",
            cache: false,
            data: { "IDDistance": id },
            success: function (json) {
                json.Buffer = json.Buffer == 0 ? "0" : json.Buffer;
                ez.Form.SetData(json);
                $("#StartDate").val(moment(json.EffectiveStartDate).format("DD/MM/YYYY")).trigger("change");
                $("#EndDate").val(moment(json.EffectiveEndDate).format("DD/MM/YYYY")).trigger("change");
                $("#IDDistance").val(json.IDDistance);
                $("#CreatedDate").val(dateParse(json.CreatedDate, "DD MMM YYYY"));
                $('#addnew').modal('show');
            }
        });
    }
