                <span id="textModalWarning"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal" id="ConfirmationSave">Save</button>
                <button class="btn btn-purple" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
