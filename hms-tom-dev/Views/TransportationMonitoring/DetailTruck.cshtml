@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.Transport.TransportExecutionViewModel
@{
    ViewBag.Title = "Transportation Monitoring > Detail " + Model.TransportMode;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
}

<style>
    .main {
        overflow: scroll;
        position:absolute;
        top: 0px;
        bottom: 0px;
        left: 0px;
        right: 0px;
    }

    .bootstrap-datetimepicker-widget{
          z-index:99999;    
    }
    .col-md-12.bar {
        padding: 0px;
    }
    .col-md-12.bar label {
        font-size: 11px;
        width: 100%;
    }
    .col-md-12.bar input[type=text] {
        font-size: 11px;
        padding: 0px 5px !important;
        margin: 0px !important;
        height: 22px;
        width: 100%;
        border-radius: 0px;
    }
    .col-md-12.bar select {
        font-size: 11px;
        padding: 0px 5px !important;
        margin: 0px !important;
        height: 22px;
        width: 100%;
        border-radius: 0px;
    }    
    .col-md-2.col-mini {
        height: 50px;
        padding-right: 0px;
        width: 11%;
    }
    .glyphicon {
        cursor: pointer;
        overflow-x: scroll; 
    }

    .header-label {
        text-transform: uppercase;
        font-weight: normal;
        font-size: 12px;
        width: 100%;
    }
    .Order {
        padding-bottom: 5px;
        padding-top: 5px;
    }
    /*.Order:nth-child(even) {
        background: #E1F4F7;
    }*/

    .datecontainer {
        overflow: visible;
        position: relative;
    }

    /*
    .bootstrap-datetimepicker-widget { 
        z-index: 999999 !important; 
        position: relative; 
    }
    */

    .route-scroll-container {
        height: auto; 
        overflow-x: hidden; 
        overflow-y: visible; 
        position: relative;
    }

    .route-main-container {
        min-width: 1680px;
        overflow-y: visible; 
    }

    .glyphicon {
        overflow: hidden !important;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="title-deck wmb">
            <div class="button-wrap pull-left">
                <button class="btn btn-purple" onclick="window.location.href = '@Url.Action("Index", "TransportationMonitoring")'">Back</button>
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Save)))
                {
                    <button type="button" class="btn btn-primary" id="btnSave" disabled>Save</button>
                }
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Edit)))
                {
                    if (string.IsNullOrEmpty(Model.UserRole))
                    {
                        <button type="button" class="btn btn-primary" id="btnEdit" @{ if (Model.TransportStatus == "Close") { @("disabled") ; } }>
                            Edit
                        </button>
                    }
                }
                <input hidden id="IDTransportOrder" value="">
                <input hidden id="addPosition" value="">
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-2">
        <div class="form-group">
            <label>Transportation Status</label>
            <input hidden id="IDTransportExecution" value="@(Model.IDTransportExecution)">
            <input type="text" id="TransportationStatus" class="form-control" value="@(Model.TransportStatus)" disabled>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Transportation Number</label>
            <input type="text" id="" class="form-control" value="@(Model.TransportNo)" disabled>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Transportation Date</label>
            @if (Model.TransportNo == null) { <input type="text" id="" class="form-control" value="" disabled> }
            else { <input type="text" id="" class="form-control" value="@Model.TransportDate.ToString("dd-MMM-yyyy")" disabled> }
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Vehicle Type</label>
            <input type="text" id="" class="form-control" value="@(Model.VehicleType)" disabled>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label>Vendor Name</label>
            <input type="text" id="" class="form-control" value="@(Model.VendorName)" disabled>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-2">
        <div class="form-group">
            <label>Start Location</label>
            <input type="text" id="" class="form-control" value="@(Model.StartLocation)" disabled>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Finish Location</label>
            <input type="text" id="" class="form-control" value="@(Model.FinishLocation)" disabled>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Police Registration Number</label>
            <input type="text" id="" class="form-control" value="@(Model.PoliceRegNo)" disabled>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Driver 1</label>
            <input type="text" id="" class="form-control" value="@(Model.IDDriver1)" disabled>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Driver 2</label>
            <input type="text" id="" class="form-control" value="@(Model.IDDriver2)" disabled>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Co-Driver</label>
            <input type="text" id="" class="form-control" value="@(Model.IDCoDriver)" disabled>
        </div>
    </div>
</div>

<!-- ******* Routes Block - BEGIN  -->
<div class="">
    <div class="route-main-container">
        <div class="row">
            @*<div class="col-md-1"><label class="header-label">Cargo Received</label></div>*@
            <div class="col-md-1"><label class="header-label">Order Number</label></div>
            <div class="col-md-2"><label class="header-label">Order Status</label></div>
            <div class="col-md-2"><label class="header-label">Sender</label></div>
            <div class="col-md-2"><label class="header-label">Receiver</label></div>
            <div class="col-md-1"><label class="header-label">Lead Time</label></div>
            <div class="col-md-1"><label class="header-label">Estimate Arrival</label></div>
            <div class="col-md-1"><label class="header-label">GI</label></div>
            <div class="col-md-1"><label class="header-label">GR</label></div>
        </div>
        <div class="row" id="rowPosition">
            @{ for (int i = 0; i < Model.TransportOrders.Count; i++)
                {
                    var to = Model.TransportOrders[i];
                    var statuses = new string[] { "In Process", "On Delivery", "Arrive At Destination and Waiting For Confirmation", "Complete", "Close" };
                    <div class="row Order">
                        <!--<div class="col-md-1 checkbox-deck">
                            @*@if (to.IsMaterialReceived != null)
                            {
                                if ((bool)to.IsMaterialReceived)
                                {
                                    <input type="checkbox" class="CargoReceived" id="cxOrder_@i" checked disabled />
                                }
                                else
                                {
                                    <input type="checkbox" class="CargoReceived" id="cxOrder_@i" disabled />
                                }
                            }
                            else
                            {
                                <input type="checkbox" class="CargoReceived" id="cxOrder_@i" disabled />
                            }*@
                            @*<label for="cxOrder_@i" style="margin: 0 auto; margin-top: 10px; display: block"></label>*@

                        </div>-->
                        <input type="hidden" class="IDTO" value="@to.IDTransportOrder" />
                        <input type="hidden" class="OrderType" value="@to.OrderType" />
                        <div class="col-md-1" style="margin-left:10px">
                            <input type="text" class="form-control OrderNumber" value="@to.STONo" disabled />
                        </div>
                        <div class="col-md-2">
                            <select class="select2 OrderStatus" id="orderStatus-@to.STONo" data-order-type="@to.OrderType" style="width: 100%; height: 26px" disabled>
                                @{ 
                                    foreach (var s in statuses)
                                    {
                                        if (s == to.OrderStatus)
                                        {
                                            <option value="@s" selected>@s</option>
                                        }
                                        else
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    }
                                }
                             </select>
                        </div>
                        <div class="col-md-2">
                            <input type="text" class="form-control Sender" value="@to.SenderLocationName" disabled />
                        </div>
                        <div class="col-md-2">
                            <input type="text" class="form-control Receiver" value="@to.ReceiverLocationName" disabled />
                        </div>
                        <div class="col-md-1">
                            <input type="text" class="form-control LeadTime" value="@to.LeadTime" disabled />
                        </div>
                        <div class="col-md-1">
                            <input type="text" class="form-control EstimateArrival" value="@{
                                if (to.EstArrivalDate.HasValue) { @to.EstArrivalDate.Value.ToString("dd-MMM-yyyy") }
                                    }" disabled />
                        </div>
                        <div class="col-md-1 datecontainer">
                            <input type="text" class="form-control DateDummy" data-date-format="DD-MMM-YYYY HH:mm:ss" value="@{ if (to.GIDate.HasValue) { @to.GIDate.Value.ToString("dd-MMM-yyyy HH:mm:ss").Replace(".",":") } }" disabled />
                            <input type="text" class="form-control GI datepicker" id="GI-@to.STONo" data-date-format="DD/MM/YYYY HH:mm:ss" value="@{ if (to.GIDate.HasValue) { @to.GIDate.Value.ToString("dd/MM/yyyy HH:mm:ss").Replace(".",":") } }" disabled style="display:none" />
                        </div>
                        <div class="col-md-1 datecontainer">
                            <input type="text" class="form-control DateDummy" data-date-format="DD-MMM-YYYY HH:mm:ss" value="@{ if (to.GRDate.HasValue) { @to.GRDate.Value.ToString("dd-MMM-yyyy HH:mm:ss").Replace(".",":") } }" disabled />
                            <input type="text" class="form-control GR datepicker" id="GR-@to.STONo" data-date-format="DD/MM/YYYY HH:mm:ss" value="@{ if (to.GRDate.HasValue) { @to.GRDate.Value.ToString("dd/MM/yyyy HH:mm:ss").Replace(".",":") } }" disabled style="display:none" />
                        </div>
                    </div>
                } }
        </div>
    </div>
</div>
<!-- ******* Routes Block - END  -->

<div class="row" style="margin-top: 20px;">
    <div class="col-md-2">
        <div class="form-group">
            <label><b><u>Update Position</u></b></label>
        </div>
    </div>
</div>

