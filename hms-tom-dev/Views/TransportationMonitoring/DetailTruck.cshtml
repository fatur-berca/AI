@Html.Partial("~/Views/Shared/_NotificationModals.cshtml")
<script src="@Url.Content("~/Scripts/ez.js")"></script>

<script>
    var dialog = bootbox.dialog({
        message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
        closeButton: false
    });

    $(document).ready(function() {
        GeneratePUData();
    });

    /*
    $(window).on("load", function () {
        GeneratePUData();
    });
    */

    if ($("#TransportationStatus").val() == "Close") {
        $("#btnEdit").prop("disabled", true);
        $("#txLogDateTime").prop("disabled", true);
        $("#txLogLocation").prop("disabled", true);
        $("#btnSavePosition").prop("disabled", true);
    } else {
        $("#btnEdit").prop("disabled", false);
        $("#txLogDateTime").prop("disabled", false);
        $("#txLogLocation").prop("disabled", false);
        $("#btnSavePosition").prop("disabled", false);
    }

    function RouteEnable(val) {
        if (!val)
        {
            $(".DateDummy").show();
            $(".GR").hide();
            $(".GI").hide();
        }
        else{
            $(".GR").show();
            $(".GI").show();
            $(".DateDummy").hide();
        }

        $("#rowPosition").find(".Order").each(function (k, ele) {
            $(ele).find(".CargoReceived").prop("disabled", !val);
            $(ele).find(".CargoReceived").trigger("changed");

            //$(ele).find(".GI").prop("disabled", !val);
            var v = $(ele).find(".GI").val();
            if (v != null && v != "")
            {
                if (!val)
                {
                    // $(ele).find(".GI").attr("data-date-format", "DD-MMM-YYYY HH:mm:ss");
                    //  $(ele).find(".GI").val(moment(v, "DD/MM/YYYY HH:mm:ss").format("DD-MMM-YgzYYY HH:mm:ss"));
                }
                else
                {
                    //  $(ele).find(".GI").attr("data-date-format", "DD/MM/YYYY HH:mm:ss");
                    // $(ele).find(".GI").val(moment(v, "DD-MMM-YYYY HH:mm:ss").format("DD/MM/YYYY HH:mm:ss"));
                }
            }
            else
                $(ele).find(".GI").val("");

            //$(ele).find(".GR").prop("disabled", !val);
            var v = $(ele).find(".GR").val();
            if (v != null && v != "")
            {
                /*
                if (!val)
                    $(ele).find(".GR").val(moment(v, "DD/MM/YYYY HH:mm:ss").format("DD-MMM-YYYY HH:mm:ss"));
                else
                    $(ele).find(".GR").val(moment(v, "DD-MMM-YYYY HH:mm:ss").format("DD/MM/YYYY HH:mm:ss"));
                */
            }
            else
                $(ele).find(".GR").val("");

            $(ele).find(".OrderStatus").prop("disabled", !val);
            $(ele).find(".OrderStatus").trigger("change");
            $(".GI").prop("disabled", !val);
            $(".GR").prop("disabled", !val);
            //var OrderType = $(ele).find(".OrderType").val();
            //if (OrderType == "Finished Good") {
            //    $(ele).find(".GI").prop("disabled", true);
            //    $(ele).find(".GR").prop("disabled", true);
            //}
        });
    };

    $("#btnEdit").on("click", function () {
        $("#btnSave").prop("disabled", false);
        $("#btnEdit").prop("disabled", true);
        RouteEnable(true);

        @foreach (var to in Model.TransportOrders)
        {
            <text>var gi=document.getElementById("GI-"+"@to.STONo");</text>
            <text>var gr=document.getElementById("GR-"+"@to.STONo");</text>
            <text>gi.setAttribute("disabled", "");</text>
            <text>gr.setAttribute("disabled", "");</text>
            if (to.OrderStatus == "On Delivery") {
                <text>gi.removeAttribute("disabled");</text>
            }
            else if (to.OrderStatus == "Arrive At Destination and Waiting For Confirmation") {
                <text>gr.removeAttribute("disabled");</text>
                <text>gi.removeAttribute("disabled");</text>
            }
            else if (to.OrderStatus == "Complete") {
                <text>gr.removeAttribute("disabled");</text>
                <text>gi.removeAttribute("disabled");</text>
            }
        }
    });
    $("#btnSave").on("click", function () {
        var ord = GetOrderData();
        if (!Validate(ord)) return;
        SaveData();
    });
    $("#btnSavePosition").on("click", function () { SavePUData(); });

    $(".OrderStatus").change(function() {
        if ($(this).prop("disabled") === false)
        {
            //pakai jquery ada bug kalau ordernumbernya ada tanda garis miring (/)
            var orderStatus = document.getElementById($(this).attr('id'));
            var gi=document.getElementById("GI-"+$(this).attr('id').split('-')[1]);
            var gr=document.getElementById("GR-"+$(this).attr('id').split('-')[1]);
            if(orderStatus.value.includes("Delivery")){
                gi.removeAttribute("disabled");
                gr.setAttribute("disabled", "");
            }
            else if (orderStatus.value.includes("Arrive") || orderStatus.value.includes("Complete"))
            {
                gi.removeAttribute("disabled");
                gr.removeAttribute("disabled");
            }
            else{
                gi.setAttribute("disabled", "");
                gr.setAttribute("disabled", "");
            }

            /*
            var OrderType = $(this).attr("data-order-type");
            if (OrderType == "Finished Good") {
                $(this).parent().parent().find(".GI").prop("disabled", true);
                $(this).parent().parent().find(".GR").prop("disabled", true);
            }
            */
        }
    });

    function DeletePU(id) {
        ez.Modals.Confirm.on("yes-clicked", (function () {
            ez.Modals.BeginLoading();

            $.ajax({
                url: "@Url.Action("DeleteTransportPosition")",
                data: { TPID: id },
                method: "POST",
                success: function (res) {
                    ez.Modals.EndLoading();
                    if (res.IsSuccess)
                    {
                        ez.Modals.notification("Your data has successfully deleted!");
                        GeneratePUData();
                    }
                    else
                        ez.Modals.error("Failed to delete data!");
                },
                error: function () {
                    ez.Modals.EndLoading();
                    ez.Modals.error("Failed to delete data!");
                }
            });

        }).bind(this));
        ez.Modals.Confirm.show("Are you sure to delete this data?");
    }

    function GeneratePUData() {
        var id = $("#IDTransportExecution").val();
        $.ajax({
            url: "@Url.Action("GetTransportPosition")",
            data: { TEID: id },
            method: "POST",
            success: function (res) {
                dialog.modal('hide');

                var today = moment(new Date()).format("DD/MM/YYYY");
                $("#loContainer").html('');

                console.log("Position Data", res);

                linq(res).do(function (d) {
                    var tr = $("<tr></tr>");
                    var dt = moment(d.PositionDate).format("DD/MM/YYYY");
                    var tme = moment(d.PositionDate).format("DD-MMM-YYYY HH:mm:ss");

                    var td = $("<td></td>").html(tme);
                    tr.append(td);

                    td = $("<td></td>").html(d.PositionName);
                    tr.append(td);

                    if (dt == today)
                    {
                        var canedit = @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Save)))
                        {
                            @("true")
                        } else { @("false") } ;
                        var idpu = d.IDTransportPositionDetail;
                        td = $("<td></td>");
                        if (canedit)
                            td.html('<a href="javascript:void(0)" style="margin-left:5px" onclick="DeletePU(' + idpu + ');" title="Delete"><i data-toggle="modal" class="fa fa-trash"></i></a></div>');
                        tr.append(td);
                    }
                    else {
                        td = $("<td></td>");
                        tr.append(td);
                    }

                    $("#loContainer").append(tr);
                });
            }
        });
    }

    function SavePUData() {
        var err = "";

        var loc = $("#txLogLocation").val();
        //var dte = $("#txLogDateTime").val();
        var dte = moment($('#txLogDateTime').val(), "DD/MM/YYYY HH:mm:ss").format("DD-MMM-YYYY HH:mm:ss");
        var id = $("#IDTransportExecution").val();

        if (!loc) err += "&bull; Location is required!<br />";
        if (!dte || dte == "Invalid date") err += "&bull; Date is required!";

        if (err != "") {
            ez.Modals.error("<b style='font-size: larger'>Invalid inputs!</b><br />" + err);
            return false;
        }

        ez.Modals.BeginLoading();

        var topu = { Location: loc, Date: dte, ID: id };
        $.ajax({
            url: "@Url.Action("AddTransportPosition")",
            data : topu,
            method: "POST",
            success: function (res) {
                if (res.IsSuccess) {
                    ez.Modals.notification("Your data has successfully saved!");

                    $("#txLogLocation").val("");
                    $("#txLogDateTime").val("");
                    ez.Modals.EndLoading();

                    GeneratePUData();
                }
                else
                    ez.Modals.error("Failed to save data!");
            },
            error: function () {
                ez.Modals.error("Failed to save data!");
                ez.Modals.EndLoading();
            }
        });
    }

    function SaveData() {
        ez.Modals.BeginLoading();

        var id = $("#IDTransportExecution").val();
        $.ajax({
            url: "@Url.Action("UpdateTransportOrder")",
            data : {TO: GetOrderData(), TEID: id},
            method: "POST",
            success: function (res) {
                ez.Modals.EndLoading();

                if (res.IsSuccess) {
                    location.reload();
                    $("#btnSave").prop("disabled", true);
                    $("#btnEdit").prop("disabled", false);
                    RouteEnable(false);
                    ez.Modals.notification("Your data has successfully saved!");
                }
                else {
                    ez.Modals.error("Failed to save data!");
                }
            },
            error: function () {
                ez.Modals.EndLoading();
                ez.Modals.error("Failed to save data!");
            }
        });
    }

    function GetOrderData() {
        var res = [];
        $("#rowPosition").find(".Order").each(function (k, ele) {
            var o = {};
            o.CargoReceived = $(ele).find(".CargoReceived").is(':checked');
            o.OrderStatus = $(ele).find(".OrderStatus").select2("val");
            o.GI = $(ele).find(".GI").val();
            if (o.GI != "" && o.GI != null)
            {
                o.GI = moment(o.GI, "DD/MM/YYYY HH:mm:ss").format("YYYY-MM-DD HH:mm:ss");
            }
            o.GR = $(ele).find(".GR").val();
            if (o.GR != "" && o.GR != null)
            {
                o.GR = moment(o.GR, "DD/MM/YYYY HH:mm:ss").format("YYYY-MM-DD HH:mm:ss");
            }
            o.OrderType = $(ele).find(".OrderType").val();
            o.OrderNumber = $(ele).find(".OrderNumber").val();
            o.ID = $(ele).find(".IDTO").val();
            res.push(o);

            console.log(o);
        });
        return res;
    }

    function Validate(data) {
        data = data || GetOrderData();
        var err = "";
        linq(data).do(function (d) {
            console.log(d.OrderNumber, d);
            if (d.OrderStatus == "On Delivery" || d.OrderStatus.includes("Arrive") || d.OrderStatus == "Complete") {
                if (!d.GI) // && d.OrderType != "Finished Good")
                    err += "&bull; " + d.OrderNumber + " - GI is required<br />";
            }
            if (d.OrderStatus == "Complete") {
                if (!d.GR) // && d.OrderType != "Finished Good")
                    err += "&bull; " + d.OrderNumber + " - GR is required<br />";
            }
        });

        if (err != "")
        {
            ez.Modals.error("<b style='font-size: larger'>Invalid inputs!</b><br />"+ err);
            return false;
        }

        return true;
    }
</script>
