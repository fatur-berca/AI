@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.Transport.TransportMonitoringViewModel
@{
    var listUserRole = ViewBag.ListUserRole;
    bool isSuperUser = false;
}

<style>
    .fc-selected {
        background-color: #f39814 !important;
    }

    .dataTables_processing {
        top: 64px !important;
        z-index: 99000 !important;
        height: 100%;
    }
</style>

<div class="title-deck wmb" hidden>
    <div class="col-panel">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>ON DELIVERY</label>
                    <h4 class="sub-text" id="state1"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
            <div class="col-md-5">
                <div class="form-group">
                    <label>ARRIVED AT DESTINATION AND WAITING FOR CONFIRMATION</label>
                    <h4 class="sub-text" id="state2"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>COMPLETE</label>
                    <h4 class="sub-text" id="state3"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
        {
            <button class="btn btn-primary" id="exportDefaultButton">Export</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
        {
            <button class="btn btn-primary" id="btnCustomReportShip">Custom Report</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Upload)))
        {
            <button class="btn btn-primary" data-toggle="modal" data-target="#uploadModal" id="uploadButton">Upload</button>
        }
    </div>
    <a href="#searchfilterShip" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilterShip"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck nmb">
    <div id="searchfilterShip" class="collapse" role="tabpanel" aria-labelledby="searchfilterShip">
        <div class="col-panel">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Vendor</label>
                        @*<select id="ddvendor" class="select2" multiple="multiple"></select>*@
                        @Html.DropDownListFor(model => Model.VendorName, Model.vendorNames, new { @multiple = "multiple", @id = "ddvendor", @placeholder = " " })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Transportation Number</label>
                        @*<select class="select2" id="ddtransportationnumber"><option value=""> </option></select>*@
                        <input type="hidden" style="width: 100%" id="ddtransportationnumber" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Order Number</label>
                        @*<select class="select2" id="ddordernumber"></select>*@
                        <input type="hidden" style="width:100%" id="ddordernumber" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Start Location</label>
                        @*<select class="select2" multiple id="ddstartlocation"></select>*@
                        @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "ddstartlocation", @placeholder = " " })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Transportation Status</label>
                        @*<select class="select2" multiple id="ddtransportationstatus"></select>*@
                        @Html.DropDownListFor(model => Model.TransportStatus, Model.transStatus, new { @multiple = "multiple", @id = "ddtransportationstatus", @placeholder = " " })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Stuffing Date</label>
                        <div class="row">
                            <div class="col-md-5">
                                @*<input type="text" class="form-control datepicker FromHaveFuture" id="DateOfStuffingFrom">*@
                                <input type="text" class="form-control datepicker" id="DateOfStuffingFrom" data-date-format="DD/MM/YYYY" value="@DateTime.Now.ToString("dd/MM/yyyy")">
                            </div>
                            <div class="col-md-2 to-bi">
                                <label>To</label>
                            </div>
                            <div class="col-md-5">
                                @*<input type="text" class="form-control datepicker ToHaveFuture" id="DateOfStuffingTo">*@
                                <input type="text" class="form-control datepicker" id="DateOfStuffingTo" data-date-format="DD/MM/YYYY" value="@DateTime.Now.ToString("dd/MM/yyyy")">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group checkbox-padding">
                        <div class="checkbox-deck">
                            <input type="checkbox" id="DelayShipment" value="delay">
                            <label for="DelayShipment"></label>
                        </div>
                        <span class="checkbox-deck-span">Delay Shipment</span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Sender</label>
                        @*<select class="select2" multiple id="ddsender"></select>*@
                        @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "ddsender", @placeholder = " " })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Receiver</label>
                        @*<select class="select2" multiple id="ddreceiver"></select>*@
                        @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "ddreceiver", @placeholder = " " })
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            @if (isSuperUser)
            {
                <div class="clearfix"></div>
                <div class="col-sm-4">
                    <div class="form-group">

                        <label for="input-type">Status</label>
                        <div id="input-type" class="row">
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" id="all" value="1" type="radio" />All
                                </label>
                            </div>
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" id="deleted" value="0" type="radio" /> Deleted
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="col-md-12">
                <button class="btn btn-primary" onclick="GenerateSearch()">Search</button>
                <button class="btn btn-purple" onclick="resetSearch()">Reset</button>
            </div>
            @*</form>*@
        </div>
    </div>
</div>

