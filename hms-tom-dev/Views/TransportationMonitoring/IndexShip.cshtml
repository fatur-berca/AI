    function exportDataShi() {
        dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        if (moment($('#DateOfStuffingFrom').val(), "DD/MM/YYYY").isAfter(moment($('#DateOfStuffingTo').val(), "DD/MM/YYYY")))
        {
            dialog.modal("hide");
            $("#labelErrorTru").html("");
            $("#labelErrorTru").html("Stuffing Date To must be greater than Stuffing Date From!");
            $('#modalerrorTru').modal('show');
            return;
        }

        filter.transportNo = $("#ddtransportationnumber").val().split(',');
        filter.transportStatus = $("#ddtransportationstatus").val();
        filter.vendor = $("#ddvendor").val();
        filter.orderNo = $("#ddordernumber").val().split(',');
        filter.sender = $("#ddsender").val();
        filter.receiver = $("#ddreceiver").val();
        filter.startLocation = $("#ddstartlocation").val();
        filter.dateFrom = moment($('#DateOfStuffingFrom').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.dateTo = moment($('#DateOfStuffingTo').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.mode = "Ship";
        filter.delayShipment = ($('#DelayShipment').is(':checked')) ? true : false;
        filter.includeInactive = ($('#deleted').length > 0) ? (($('#all').prop("checked") == true ? 1 : 0)) : null;

        $.ajax({
            url: 'TransportationMonitoring/ExportMonitoringXlsShip',
            method: 'POST',
            dataType: 'json',
            cache: false,
            data: { criteria: filter },
            success: function (result) {
                window.location.assign('@Url.Content("~/Assets/Download/")' + result);
                dialog.modal('hide');
            }
        });
    }

    function customReportShi() {
        dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        if (moment($('#DateOfStuffingFrom').val(), "DD/MM/YYYY").isAfter(moment($('#DateOfStuffingTo').val(), "DD/MM/YYYY")))
        {
            dialog.modal("hide");
            $("#labelErrorTru").html("");
            $("#labelErrorTru").html("Stuffing Date To must be greater than Stuffing Date From!");
            $('#modalerrorTru').modal('show');
            return;
        }

        filter.transportNo = $("#ddtransportationnumber").val().split(',');
        filter.transportStatus = $("#ddtransportationstatus").val();
        filter.vendor = $("#ddvendor").val();
        filter.orderNo = $("#ddordernumber").val().split(',');
        filter.sender = $("#ddsender").val();
        filter.receiver = $("#ddreceiver").val();
        filter.startLocation = $("#ddstartlocation").val();
        filter.dateFrom = moment($('#DateOfStuffingFrom').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.dateTo = moment($('#DateOfStuffingTo').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.mode = "Ship";
        filter.delayShipment = ($('#DelayShipment').is(':checked')) ? true : false;
        filter.includeInactive = ($('#deleted').length > 0) ? (($('#all').prop("checked") == true ? 1 : 0)) : null;
        var columns = ''
        var indexs = ''
        var cols = [];
        $('#destinationFieldsShip .fc-field').each(function () {
            columns = columns + $(this).text() + ',';
            indexs = indexs + $(this).attr('index') + ',';
            cols.push($(this).html().trim());
        });
        columns = columns.slice(0, -1);
        indexs = indexs.slice(0, -1);

        $.ajax({
            url: 'TransportationMonitoring/CustomMonitoringXlsShip',
            method: 'POST',
            dataType: 'json',
            cache: false,
            data: { criteria: filter, colCaption: columns, colIndex: indexs, colExport: cols },
            success: function (result) {
                window.location.assign('@Url.Content("~/Assets/Download/")' + result);
                dialog.modal('hide');
            }
        });
    }

    function importDataShi() {
        $('#modalloadingShi').modal('show');

        var form = new FormData();
        var field = document.getElementById('uploadMonitoringList');
        var value = field.files[0].name;
        form.append(value, field.files[0]);
        var url = 'TransportationMonitoring/ImportMonitoringXlsShipGR';
        //if (value == "TransportMonitoringGRTemplate.xlsx") {
        //    url = 'TransportationMonitoring/ImportMonitoringXlsShipGR';
        //}
        $.ajax({
            url: url,
            method: 'POST',
            cache: false,
            contentType: false,
            processData: false,
            data: form,
            success: function (result) {
                //console.log(result);
                $('#uploadModal').modal('hide');
                $('#modalloadingShi').modal('hide');
                if (result.IsSuccess == true) {
                    $("#modaltext").html("");
                    $("#modaltext").html("Data has been successfully uploaded!");
                    $('#modalsuccess').modal('show');
                } else {
                    $("#labelError").html("");
                    if (result.err == 1) {
                        $("#labelError").html("Failed to upload data!");
                    }
                    else if (result.err == 2) {
                        $("#labelError").html("Data error at row " + result.rec + " (Sheet " + result.sht + ")");
                    }
                    else if (result.err == 3) {
                        $("#labelError").html("Data not found at row " + result.rec + " (Sheet " + result.sht + ")");
                    } else {
                        $("#labelError").html("Upload data is not success or nothing record");
                    }
                    $('#modalerror').modal('show');
                }
            }
        });
    }

