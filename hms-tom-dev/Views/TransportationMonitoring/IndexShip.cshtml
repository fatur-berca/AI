    function saveLayoutShip() {
        var nonvalid = false;

        if ($("#layoutNameShip").val() == "") { //layout name
            $("#layoutNameShip").css('border-color', 'orange');
            nonvalid = true;
        } else {
            $("#layoutNameShip").css('border-color', '#ccc');
        }

        if (nonvalid == true) {
            alertCrPleaseFill();

            return false;
        } else {
            var fieldNames = '',
                layoutName = $("#layoutNameShip").val(),
                isGlobal = ($("#chkGlobalCustomReportShip").prop('checked')) ? true : false;

            if ($('#destinationFieldsShip .fc-field').length > 0) {
                $('#destinationFieldsShip .fc-field').each(function () {
                    fieldNames = fieldNames + $(this).data('field') + ',';
                });
                fieldNames = fieldNames.slice(0, -1);

                var dialog = bootbox.dialog({
                    message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                    closeButton: false
                });

                jQuery.ajax({
                    url: '@Url.Action("InsertRecords", "CustomReportState")',
                    method: 'post',
                    dataType: 'json',
                    data: { "layoutName": layoutName, "fieldNames": fieldNames, "pageName": "TransportMonitoringShip", "isGlobal": isGlobal },
                    success: function (response) {
                        if (response == "Success") {
                            if (isGlobal) {
                                SaveChangesButton(dialog);
                            } else {
                                alertCrSaveSuccess();
                                dialog.modal('hide');
                                $("#chkGlobalCustomReportShip").prop('checked', false);
                            }
                        } else if (response == "NoLayoutName") {
                            alertCrPleaseFill();
                            dialog.modal('hide');
                        }

                        if ($("#layoutNameShip").val() != $("#layoutSelectShip option:selected").text()) {
                            $("#layoutSelectShip").append('<option value="' + fieldNames + '">' + layoutName + '</option>').val(fieldNames);
                        }
                    }
                });
                return true;
            }
            else {
                $("#modalerror #textModalError").html(" Please select at least one field to export! ");
                $('#modalerror').modal('show');
                return false;
            }
        }
    }

