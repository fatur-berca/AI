@*@Html.Action("PartialViewCustomReport")*@
<script type="text/javascript">
    var myParam = "firstload";
    var filter = {};

    $(function () {
        $("#ddtransportationstatus").select2({ width: '100%' });
        $("#ddvendor").select2({ width: '100%' });
        $("#ddsender").select2({ width: '100%' });
        $("#ddreceiver").select2({ width: '100%' });
        $("#ddstartlocation").select2({ width: '100%' });

        resetSearch();
    });

    $("#ddtransportationnumber").select2({
        ajax: {
            url: '@Url.Action("GetTransportNoDtos", "TransportationMonitoring")',
            dataType: 'json',
            data: function (params) {
                return {
                    TransportNo: params,
                    TransportMode: 'Ship'
                };
            },
            results: function (data) {
                var myResults1 = [];
                $.each(data, function (index, item) {
                    myResults1.push({
                        'id': item.TransportNo,
                        'text': item.TransportNo
                    });
                });
                return {
                    results: myResults1
                };
            },
            cache: true
        },
        placeholder: 'Type Transportation Number',
        delay: 250,
        multiple: true,
        minimumInputLength: 1
    });

    $("#ddordernumber").select2({
        ajax: {
            url: '@Url.Action("GetOrderNoDtos", "TransportationMonitoring")',
            dataType: 'json',
            data: function (params) {
                return {
                    STONo: params
                };
            },
            results: function (data) {
                var myResults = [];
                $.each(data, function (index, item) {
                    myResults.push({
                        'id': item.STONo,
                        'text': item.STONo
                    });
                });
                return {
                    results: myResults
                };
            },
            cache: true
        },
        placeholder: 'Type Order Number',
        delay: 250,
        multiple: true,
        minimumInputLength: 1
    });

    // ------------------------------------------------------------------------------  advancedsearch functions----------------------------------------------------------------------------

    function createFilter(param) {

        var idvendor = (param == "firstload") ? jQuery("#ddvendor").val() : (jQuery("#ddvendor").val() == null ? jQuery("#ddvendor").val() : jQuery("#ddvendor").val().toString()),
            tnNo = (param == "firstload") ? $("#ddtransportationnumber").val() : ($("#ddtransportationnumber").val() == null ? $("#ddtransportationnumber").val() : $("#ddtransportationnumber").val().toString()),
            stoNo = (param == "firstload") ? $("#ddordernumber").val() : ($("#ddordernumber").val() == null ? $("#ddordernumber").val() : $("#ddordernumber").val().toString()),
            startLocation = (param == "firstload") ? $("#ddstartlocation").val() : ($("#ddstartlocation").val() == null ? $("#ddstartlocation").val() : $("#ddstartlocation").val().toString()),
            tnstatus = (param == "firstload") ? $("#ddtransportationstatus").val() : ($("#ddtransportationstatus").val() == null ? $("#ddtransportationstatus").val() : $("#ddtransportationstatus").val().toString()),
            DateOfStuffingFrom = jQuery("#DateOfStuffingFrom").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
            DateOfStuffingTo = jQuery("#DateOfStuffingTo").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
            DelayShipment = ($('#DelayShipment').is(':checked')) ? true : false,
            sender = (param == "firstload") ? $("#ddsender").val() : ($("#ddsender").val() == null ? $("#ddsender").val() : $("#ddsender").val().toString()),
            receiver = (param == "firstload") ? $("#ddreceiver").val() : ($("#ddreceiver").val() == null ? $("#ddreceiver").val() : $("#ddreceiver").val().toString()),
            includeInActive = ($('#deleted').length > 0) ? (($('#all').prop("checked") == true ? 1 : 0)) : null;

        var isExportOrSearch;
        if (param == "firstload") {
            isExportOrSearch = false;
        } else if (param == "advSearch") {
            isExportOrSearch = true;
        }
        var input = {
            "VendorID": idvendor,
            "TransportNo": tnNo,
            "STONo": stoNo,
            "StartLocation": startLocation,
            "TransportStatus": tnstatus,
            "DateOfStuffingFrom": DateOfStuffingFrom,
            "DateOfStuffingTo": DateOfStuffingTo,
            "DelayShipment": DelayShipment,
            "SenderIDLocation": sender,
            "ReceiverIDLocation": receiver,
            "IncludeInActive": includeInActive,
            "IsExportOrSearch": isExportOrSearch
        };

        return input;
    }

    function generateTable() {
        dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        if (moment($('#DateOfStuffingFrom').val(), "DD/MM/YYYY").isAfter(moment($('#DateOfStuffingTo').val(), "DD/MM/YYYY")))
        {
            dialog.modal("hide");
            $("#labelErrorTru").html("");
            $("#labelErrorTru").html("Stuffing Date To must be greater than Stuffing Date From!");
            $('#modalerrorTru').modal('show');
            return;
        }

        filter.transportNo = $("#ddtransportationnumber").val().split(',');
        filter.transportStatus = $("#ddtransportationstatus").val();
        filter.vendor = $("#ddvendor").val();
        filter.orderNo = $("#ddordernumber").val().split(',');
        filter.sender = $("#ddsender").val();
        filter.receiver = $("#ddreceiver").val();
        filter.startLocation = $("#ddstartlocation").val();
        filter.dateFrom = moment($('#DateOfStuffingFrom').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.dateTo = moment($('#DateOfStuffingTo').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.mode = "Ship";
        filter.delayShipment = ($('#DelayShipment').is(':checked')) ? true : false;
        filter.includeInactive = ($('#deleted').length > 0) ? (($('#all').prop("checked") == true ? 1 : 0)) : null;

        var table = $('#dtFilterShip').DataTable({
            "paging": true,
            "ordering": false,
            "filter": true,
            "destroy": true,
            "orderMulti": false,
            "serverSide": true,
            "processing": true,
            "pageLength": 10,
            "ajax": {
                dataType: 'JSON',
                type: 'POST',
                url: '@Url.Action("GetListViewTruckShipTrainServerSide", "TransportationMonitoring")',
                data: function (data) {
                    data.filter = filter;
                    return data
                },
                "complete": function (res) {
                    console.log("result", res);
                    dialog.modal('hide');
                },
                "error": function (res) {
                    console.log("error", res);
                    dialog.modal('hide');
                }
            },
            "columns": [
                {
                    "data": "IsActive", "class": "text-center", "render": function (data) {
                        if (data === true) {
                            return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
