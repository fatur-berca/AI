@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.Transport.TransportMonitoringViewModel
@{
    var listUserRole = ViewBag.ListUserRole;
}

<style>
    .fc-selected {
        background-color: #f39814 !important;
    }
    .dataTables_processing {
        top: 64px !important;
        z-index: 99000 !important;
        height: 100%;
    }
</style>

<div class="title-deck wmb" hidden>
    <div class="col-panel">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>ON DELIVERY</label>
                    <h4 class="sub-text" id="state1Tra"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
            <div class="col-md-5">
                <div class="form-group">
                    <label>ARRIVED AT DESTINATION AND WAITING FOR CONFIRMATION</label>
                    <h4 class="sub-text" id="state2Tra"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>COMPLETE</label>
                    <h4 class="sub-text" id="state3Tra"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
        {
            <button class="btn btn-primary" id="exportDefaultButtonTra">Export</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
        {
            <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#customReportModalTra" id="customReportButtonTra">Custom Report</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Upload)))
        {
            <button class="btn btn-primary" data-toggle="modal" data-target="#uploadModalTra" id="uploadButtonTra">Upload</button>
        }
    </div>
    <a href="#searchfilterTrain" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck nmb">
    <div id="searchfilterTrain" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel wmb wbt">
            <div class="col-md-3">
                <div class="form-group">
                    <label>Transportation Number</label>
                    <input type="hidden" style="width:100%" id="FilterTransportationNumberTra" />
                    @*@Html.DropDownListFor(model => Model.TransportNo, Model.transNumbers, new { @multiple = "multiple", @id = "FilterTransportationNumberTra", @placeholder = " ", @style = "width: 100%" })*@
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Transportation Date</label>
                    <div class="row">
                        <div class="col-md-5">
                            <input type="text" class="form-control datepicker" id="FilterDateFromTra" data-date-format="DD/MM/YYYY" value="@{var a = (DateTime.Now - new TimeSpan(0, 0, 0, 0)).ToString("dd/MM/yyyy"); @a}">
                        </div>
                        <div class="col-md-2 to-bi">
                            <label>To</label>
                        </div>
                        <div class="col-md-5">
                            <input type="text" class="form-control datepicker" id="FilterDateToTra" data-date-format="DD/MM/YYYY" value="@DateTime.Now.ToString("dd/MM/yyyy")">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Transportation Status</label>
                    @Html.DropDownListFor(model => Model.TransportStatus, Model.transStatus, new { @multiple = "multiple", @id = "FilterTransportationStatusTra", @placeholder = " " })
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Vendor</label>
                    @Html.DropDownListFor(model => Model.VendorName, Model.vendorNames, new { @multiple = "multiple", @id = "FilterVendorTra", @placeholder = " " })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Order Number</label>
                    @*@Html.DropDownListFor(model => Model.STONo, Model.orderNumbers, new { @multiple = "multiple", @id = "FilterOrderNumberTra", @placeholder = " " })*@
                    <input type="hidden" style="width:100%" id="FilterOrderNumberTra" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Sender</label>
                    @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "FilterSenderTra", @placeholder = " " })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Receiver</label>
                    @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "FilterReceiverTra", @placeholder = " " })
                </div>
            </div>
            <div class="clearfix"></div>

            <div class="col-md-3">
                <div class="form-group">
                    <label>Start Location</label>
                    @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "FilterStartLocationTra", @placeholder = " " })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Finish Location</label>
                    @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "FilterFinishLocationTra", @placeholder = " " })
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="col-md-12">
                <button class="btn btn-primary search-filter" id="btnSearchFilterTra">Search</button>
                <button class="btn btn-purple reset-search-filter" id="btnResetFilterTra">Reset</button>
            </div>
        </div>
    </div>
</div>

