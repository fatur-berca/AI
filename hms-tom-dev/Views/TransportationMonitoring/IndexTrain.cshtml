    function importDataTra() {
        $('#modalloadingTra').modal('show');

        var form = new FormData();
        var field = document.getElementById('uploadMonitoringListTra');
        var value = field.files[0].name;
        form.append(value, field.files[0]);

        $.ajax({
            url: 'TransportationMonitoring/ImportMonitoringXlsTruckTrain',
            method: 'POST',
            cache: false,
            contentType: false,
            processData: false,
            data: form,
            success: function (result) {
                $('#modalloadingTra').modal('hide');
                if (result.IsSuccess == true) {
                    $('#uploadModalTra').modal('hide')
                    $("#modaltextTra").html("");
                    $("#modaltextTra").html("Upload data successfully!");
                    $('#modalsuccessTra').modal('show');
                    generateTableTra();
                }
                else {
                    $("#labelErrorTra").html("");
                    $("#labelErrorTra").html("Upload data is not success or nothing record");
                    $('#modalerrorTra').modal('show');
                }
            }
        });
    }

