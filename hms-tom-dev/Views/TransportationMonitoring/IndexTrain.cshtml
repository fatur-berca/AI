<script src="@Url.Content("~/Scripts/ez.js")"></script>
<script>
    var filter = {};

    $(function () {
        $("#FilterTransportationStatusTra").select2({ width: '100%' });
        $("#FilterVendorTra").select2({ width: '100%' });
        $("#FilterSenderTra").select2({ width: '100%' });
        $("#FilterReceiverTra").select2({ width: '100%' });
        $("#FilterStartLocationTra").select2({ width: '100%' });
        $("#FilterFinishLocationTra").select2({ width: '100%' });
        generateTableTra();
    });

    $("#FilterTransportationNumberTra").select2({
        ajax: {
            url: '@Url.Action("GetTransportNoDtos", "TransportationMonitoring")',
            dataType: 'json',
            data: function (params) {
                return {
                    TransportNo: params,
                    TransportMode: 'Train'
                };
            },
            results: function (data) {
                var myResults1 = [];
                $.each(data, function (index, item) {
                    myResults1.push({
                        'id': item.TransportNo,
                        'text': item.TransportNo
                    });
                });
                return {
                    results: myResults1
                };
            },
            cache: true
        },
        placeholder: 'Type Transportation Number',
        delay: 250,
        multiple: true,
        minimumInputLength: 1
    });

    $("#FilterOrderNumberTra").select2({
        ajax: {
            url: '@Url.Action("GetOrderNoDtos", "TransportationMonitoring")',
            dataType: 'json',
            data: function (params) {
                return {
                    STONo: params
                };
            },
            results: function (data) {
                var myResults1 = [];
                $.each(data, function (index, item) {
                    myResults1.push({
                        'id': item.STONo,
                        'text': item.STONo
                    });
                });
                return {
                    results: myResults1
                };
            },
            cache: true
        },
        placeholder: 'Type Order Number',
        delay: 250,
        multiple: true,
        minimumInputLength: 1
    });

    //$('.nav-pills a[href="#tabtrain"]').click(function () {
    //    generateTableTra()
    //    // alert('train');
    //});

    $(document).on('click', '#exportDefaultButtonTra', function () {
        exportDataTra();
    });

    $(document).on('click', '#btnExportCustomReportTra', function () {
        if ($('#destinationFieldsTra .fc-field').text().length == 0) {
            $("#labelCheck").html("");
            $("#labelCheck").html("Please select of the existing fields");
            $('#modalwarningTra').modal('show');
        }
        else {
            customReportTra();
        }
    });

    $(document).on('click', '#uploadButtonTra', function () {
        $('#uploadMonitoringListTra').val("");
        $("#uploadMonitoringListTra").jfilestyle('clear');
        if ($("#tabtrain .focus-jfilestyle label span").text() != "Browse") {
            $("#tabtrain .jfilestyle input").appendTo('#tabtrain .jfilestyle');
            $(".focus-jfilestyle label span").text("Browse")
        }
        $("#btnUploadMonitoringListTra").prop("disabled", true);
    });

    $('#uploadMonitoringListTra').on('change', function (e) {
        $("#btnUploadMonitoringListTra").prop("disabled", false);
    });

    $(document).on('click', '#btnSearchFilterTra', function () {
        $("#checkdataTrain").prop('checked', false);
        generateTableTra();
    });

    $(document).on('click', '#btnResetFilterTra', function () {
        resetFilterTra();
    });

    $(document).on('click', '#btnUploadMonitoringListTra', function () {
        importDataTra();
    });

    $(document).on('click', '#checkdataTrain', function () {
        if ($("#dtFilterTrain > tbody > tr > td").length > 1) {
            if ($("#checkdataTrain").prop('checked') == true) {
                $('#dtFilterTrain > tbody > tr').each(function () {
                    var id = $(this).find("td").eq(0).html();
                    $("#checkrow" + id + "").prop('checked', true);
                });
            }
            else {
                $('#dtFilterTrain > tbody > tr').each(function () {
                    var id = $(this).find("td").eq(0).html();
                    $("#checkrow" + id + "").prop('checked', false);
                });
            }
        }
    });

    $("#dtFilterTrain > tbody > tr > td").on('click', '.editdataTra', function () {
        alert('Row index: ' + $(this).closest('tr').index());
    });

    $("#fieldChooserTra .ui-draggable").attr("draggable", "true");

    $("#fieldChooserTra").fieldChooser($("#sourceFieldsTra"), $("#destinationFieldsTra"));

    $(document).on('click', '#leftTra', function (e) {
        moveItemsTra('#destinationFieldsTra', '#sourceFieldsTra');
        e.preventDefault();
    });

    $(document).on('click', '#rightTra', function (e) {
        moveItemsTra('#sourceFieldsTra', '#destinationFieldsTra');
        e.preventDefault();
    });

    $(document).on('click', '#leftallTra', function (e) {
        moveAllItemsTra('#destinationFieldsTra', '#sourceFieldsTra');
        e.preventDefault();
    });

    $(document).on('click', '#rightallTra', function (e) {
        moveAllItemsTra('#sourceFieldsTra', '#destinationFieldsTra');
        e.preventDefault();
    });

    $("#fieldChooserTra .ui-draggable").on("dragstart", function (ev) {
        $(this).addClass("fc-selected");
        ev.originalEvent.dataTransfer.setData("text", "COPY");
    });

    $("#sourceFieldsTra,#destinationFieldsTra").on("dragover", function (ev) {
        ev.originalEvent.preventDefault();
    });

    $("#sourceFieldsTra,#destinationFieldsTra").on("drop", function (ev) {
        var data = ev.originalEvent.dataTransfer.getData("text");
        if (data == "COPY")
            moveItems("#" + $(ev.originalEvent.srcElement).parent().attr("id"), "#" + $(this).attr("id"));
        $("#fieldChooserTra .ui-draggable").removeClass("fc-selected");
    });

    function moveItemsTra(origin, dest) {
        jQuery(origin).find('.fc-selected').appendTo(dest);
    }

    function moveAllItemsTra(origin, dest) {
        jQuery(origin).children().appendTo(dest);
    }

    function selectRowTra(r) {
        if ($("#checkrow" + r + "").prop('checked') == false) {
            $("#checkdataTrain").prop('checked', false);
        }
    }

    function resetFilterTra() {
        $("#FilterTransportationNumberTra").select2("val", null);
        $('#FilterDateFromTra').val(moment().subtract(7, "days").format("DD/MM/YYYY"));
        $('#FilterDateToTra').val(moment().format("DD/MM/YYYY"));
        $("#FilterTransportationStatusTra").select2("val", null);
        $("#FilterOrderNumberTra").select2("val", null);
        $("#FilterVendorTra").select2("val", null);
        $("#FilterSenderTra").select2("val", null);
        $("#FilterReceiverTra").select2("val", null);
        $("#FilterStartLocationTra").select2("val", null);
        $("#FilterFinishLocationTra").select2("val", null);
    }

    var explist = [];

    function generateTableTra() {
        dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        if (moment($('#FilterDateFromTra').val(), "DD/MM/YYYY").isAfter(moment($('#FilterDateToTra').val(), "DD/MM/YYYY")))
        {
            dialog.modal("hide");
            $("#labelErrorTru").html("");
            $("#labelErrorTru").html("Stuffing Date To must be greater than Stuffing Date From!");
            $('#modalerrorTru').modal('show');
            return;
        }
        filter.transportNo = $("#FilterTransportationNumberTra").val().split(',');
        filter.transportStatus = $("#FilterTransportationStatusTra").val();
        filter.vendor = $("#FilterVendorTra").val();
        filter.orderNo = $("#FilterOrderNumberTra").val().split(',');
        filter.sender = $("#FilterSenderTra").val();
        filter.receiver = $("#FilterReceiverTra").val();
        filter.startLocation = $("#FilterStartLocationTra").val();
        filter.finishLocation = $("#FilterFinishLocationTra").val();
        filter.dateFrom = moment($('#FilterDateFromTra').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.dateTo = moment($('#FilterDateToTra').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.mode = "Train";
        var table = $('#dtFilterTrain').DataTable({
            "paging": true,  
            "ordering": false,  
            "filter": true,  
            "destroy": true,  
            "orderMulti": false,  
            "serverSide": true,  
            "processing": true, 
            "pageLength": 10,
            //"language": {
            //    processing: '<i class="fa fa-spinner fa-spin fa-2x fa-fw"></i>'
            //},
            "ajax": {
                dataType: 'JSON',
                type: 'POST',
                url: '@Url.Action("GetListViewTruckShipTrainServerSide", "TransportationMonitoring")',
                data: function (data) {
                    data.filter = filter;
                    return data
                },
                "complete": function (res) {
                    console.log("result", res);
                    dialog.modal('hide');
                },
                "error": function (res) {
                    console.log("error", res);
                    dialog.modal('hide');
                },
            },
            "columns": [
                {
                    'data': 'IsActive', 'class': 'text-center', 'render': function (data, disp, row) {
                        var id = row.IDTransportExecution;
                        if (data == true) {
                            return '<div data-id="'+id+'"><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                        }
                        else {
                            return '<div data-id="' + id + '"><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>';
                        }
                    }, 'sortable': false
                },
                {
                    // Must find how to show modal spinner before move to another page
                    'data': 'TransportNo', 'render': function (data, type, row, meta) {
                        return '<a href="@Url.Action("DetailTruck")?id=' + row["IDTransportExecution"] + '">' + row["TransportNo"] + '</a>';
                    }, 'searchable': true, 'sortable': true
                },
                {
                    'data': 'TransportDate', 'render': function (data) {
                        return moment(data).format("DD-MMM-YYYY");
                    }, 'searchable': true, 'sortable': true
                },
                { 'data': 'ActualVehicleType', 'searchable': true, 'sortable': true },
                { 'data': 'VendorName', 'searchable': true, 'sortable': true },
                { 'data': 'TransportStatus', 'searchable': true, 'sortable': true },
                { 'data': 'StartLocation', 'searchable': true, 'sortable': true },
                { 'data': 'FinishLocation', 'searchable': true, 'sortable': true },
                { 'data': 'ContainerNo', 'searchable': true, 'sortable': true },
                { 'data': 'Via', 'searchable': true, 'sortable': true },
                { 'data': 'PoliceRegistrationNumber', 'searchable': true, 'sortable': true },
                { 'data': 'Driver1', 'searchable': true, 'sortable': true },
                { 'data': 'Driver2', 'searchable': true, 'sortable': true },
                { 'data': 'CoDriver', 'searchable': true, 'sortable': true },
                { 'data': 'CurrentLocation', 'searchable': true, 'sortable': true },
                {
                    'data': 'CurrentLocationUpdateTime', 'render': function (data) {
                        if (data != null && moment(data).format("DDMMYYYY") != "01010001") { return moment(data).format("DD-MMM-YYYY HH:mm:ss"); }
                        else { return ""; }
                    }, 'searchable': true, 'sortable': true
                }
            ],
            //"dom": 'lf<"table-overflow"t>ip',
        });
        $('.dataTables_filter input').attr("placeholder", "Search Here");
        $('#dtFilterTrain thead.filters th').each(function (index) {
            if (index > 0) {
                var title = $('#dtFilterTrain thead.filters th').eq($(this).index()).text();
                $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
            }
        });

        table.columns().every(function (index) {
            if (index > 0) {
                $('#dtFilterTrain thead.filters th:eq(' + index + ') input').on('input', function () {
                    table.settings()[0].jqXHR.abort();
                    table.column($(this).parent().index() + ':visible')
                        .search(this.value)
                        .draw();
                });
            }
        });
    }

    function exportDataTra() {
        dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        if (moment($('#FilterDateFromTra').val(), "DD/MM/YYYY").isAfter(moment($('#FilterDateToTra').val(), "DD/MM/YYYY")))
        {
            dialog.modal("hide");
            $("#labelErrorTru").html("");
            $("#labelErrorTru").html("Stuffing Date To must be greater than Stuffing Date From!");
            $('#modalerrorTru').modal('show');
            return;
        }

        filter.transportNo = $("#FilterTransportationNumberTra").val().split(',');
        filter.transportStatus = $("#FilterTransportationStatusTra").val();
        filter.vendor = $("#FilterVendorTra").val();
        filter.orderNo = $("#FilterOrderNumberTra").val().split(',');
        filter.sender = $("#FilterSenderTra").val();
        filter.receiver = $("#FilterReceiverTra").val();
        filter.startLocation = $("#FilterStartLocationTra").val();
        filter.finishLocation = $("#FilterFinishLocationTra").val();
        filter.dateFrom = moment($('#FilterDateFromTra').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.dateTo = moment($('#FilterDateToTra').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.mode = "Train";

        $.ajax({
            url: 'TransportationMonitoring/ExportMonitoringXlsTruckTrain',
            method: 'POST',
            dataType: 'json',
            cache: false,
            data: { filter : filter },
            success: function (result) {
                window.location.assign('@Url.Content("~/Assets/Download/")' + result);
                dialog.modal('hide');
            }
        });
    }

