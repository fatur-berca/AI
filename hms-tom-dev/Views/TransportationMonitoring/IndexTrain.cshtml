    /* CUSTOM REPORT STATES */

    function moveItems(origin, dest) {
        jQuery(origin).find('.fc-selected').appendTo(dest);
    }

    function moveAllItems(origin, dest) {
        jQuery(origin).children().appendTo(dest);
    }

    $("#layoutSelectTra").on("change", function () {
        var sel = $("#layoutSelectTra").val();
        if (sel) {
            linq($dataLayout).do(function (d) {
                if (d.LayoutName == sel) {
                    $("#sourceFieldsTra").find(".fc-selected").removeClass("fc-selected");
                    moveAllItems('#destinationFieldsTra', '#sourceFieldsTra');

                    $("#sourceFieldsTra").find("div").each(function (idx, ele) {
                        var fi = $(ele).attr("data-field");
                        if (d.FieldName.includes(fi))
                            $(ele).addClass("fc-selected");
                    });

                    moveItems('#sourceFieldsTra', '#destinationFieldsTra');
                    $("#destinationFieldsTra").find(".fc-selected").removeClass("fc-selected");
                }
            });
        }
        else {
            $("#sourceFieldsTra").find(".fc-selected").removeClass("fc-selected");
            moveAllItems('#destinationFieldsTra', '#sourceFieldsTra');
        }
    });

    function LoadCustomReportTra(loadDefault, notclear) {
        // load custom
        if (!notclear)
            moveAllItems('#destinationFields', '#sourceFields');
        $("#sourceFieldsTra").find(".fc-selected").removeClass("fc-selected");
        var lastSelected = $("#layoutSelectTra").val();
        $("#layoutSelectTra").html('<option value="" selected>Loading...</option>');
        $.ajax({
            url: "@Url.Action("LoadCustomReportTra")",
            success: function (data) {
                console.log(data);
                if (data)
                {
                    $("#layoutSelectTra").html('');
                    $("#layoutSelectTra").append('<option selected>&nbsp;</option>');
                    linq(data).do(function (d) {
                        $("#layoutSelectTra").append('<option>' + d.LayoutName + '</option>');
                    });
                    $dataLayout = data;
                    if (loadDefault)
                    {
                        // load default
                        linq($dataLayout).do(function (d) {
                            if (d.IsActive)
                            {
                                $("#layoutSelectTra").val(d.LayoutName);
                            }
                        });
                    }
                    else
                        $("#layoutSelectTra").val(lastSelected);
                }
            }
    });
    }

    function CompileCustomReportHeadersTra() {
        var hdr = [];
        $("#destinationFieldsTra div").each(function (idx, ele) {
            hdr.push($(ele).attr("data-field"));
        });
        return hdr;
    }

    $("#customReportButtonTra").on("click", function () {
        LoadCustomReportTra(true);
    });

    $("#btnSaveLayoutTra").on("click", function () {
        var lname = $("#layoutName").val();
        if (lname == "" || lname == null)
        {
            ez.Modals.error("Please enter a name!");
            return;
        };
        var hdr = CompileCustomReportHeadersTra();
        if (hdr.length == 0) {
            ez.Modals.error("Please select at least one field to export!");
            return;
        };
        console.log(hdr);

        $.ajax({
            url: "@Url.Action("SaveCustomReportTra")",
            method: "POST",
        data: {
            name: lname,
            layout: hdr
        },
        success: function (data) {
            if (data) {
                console.log(data);
                $("#modaltextTra").html("");
                $("#modaltextTra").html("Custom report saved!");
                $('#modalsuccessTra').modal('show');
                LoadCustomReportTru(undefined, true);
            }
            else
            {
                $("#labelErrorTra").html("");
                $("#labelErrorTra").html("Failed to save custom report!");
                $('#modalerrorTra').modal('show');
            }
        }
    });
    });
</script>
