    /* CUSTOM REPORT STATES */

    function moveItems(origin, dest) {
        jQuery(origin).find('.fc-selected').appendTo(dest);
    }

    function moveAllItems(origin, dest) {
        jQuery(origin).children().appendTo(dest);
    }

    $("#layoutSelectTru").on("change", function () {
        var sel = $("#layoutSelectTru").val();
        if (sel) {
            linq($dataLayout).do(function (d) {
                if (d.LayoutName == sel) {
                    $("#sourceFieldsTru").find(".fc-selected").removeClass("fc-selected");
                    moveAllItems('#destinationFieldsTru', '#sourceFieldsTru');

                    $("#sourceFieldsTru").find("div").each(function (idx, ele) {
                        var fi = $(ele).attr("data-field");
                        if (d.FieldName.includes(fi))
                            $(ele).addClass("fc-selected");
                    });

                    moveItems('#sourceFieldsTru', '#destinationFieldsTru');
                    $("#destinationFieldsTru").find(".fc-selected").removeClass("fc-selected");
                }
            });
        }
        else {
            $("#sourceFieldsTru").find(".fc-selected").removeClass("fc-selected");
            moveAllItems('#destinationFieldsTru', '#sourceFieldsTru');
        }
    });

    function LoadCustomReportTru(loadDefault, notclear) {
        // load custom
        if (!notclear)
            moveAllItems('#destinationFields', '#sourceFields');
        $("#sourceFieldsTru").find(".fc-selected").removeClass("fc-selected");
        var lastSelected = $("#layoutSelectTru").val();
        $("#layoutSelectTru").html('<option value="" selected>Loading...</option>');
        $.ajax({
            url: "@Url.Action("LoadCustomReportTru")",
            success: function (data) {
                console.log(data);
                if (data)
                {
                    $("#layoutSelectTru").html('');
                    $("#layoutSelectTru").append('<option selected>&nbsp;</option>');
                    linq(data).do(function (d) {
                        $("#layoutSelectTru").append('<option>' + d.LayoutName + '</option>');
                    });
                    $dataLayout = data;
                    if (loadDefault)
                    {
                        // load default
                        linq($dataLayout).do(function (d) {
                            if (d.IsActive)
                            {
                                $("#layoutSelectTru").val(d.LayoutName);
                            }
                        });
                    }
                    else
                        $("#layoutSelectTru").val(lastSelected);
                }
            }
    });
    }

    function CompileCustomReportHeadersTru() {
        var hdr = [];
        $("#destinationFieldsTru div").each(function (idx, ele) {
            hdr.push($(ele).attr("data-field"));
        });
        return hdr;
    }

    $("#customReportButtonTru").on("click", function () {
        LoadCustomReportTru(true);
    });

    $("#btnSaveLayout").on("click", function () {
        var lname = $("#layoutNameTru").val();
        if (lname == "" || lname == null)
        {
            ez.Modals.error("Please enter a name!");
            return;
        };
        var hdr = CompileCustomReportHeadersTru();
        if (hdr.length == 0) {
            ez.Modals.error("Please select at least one field to export!");
            return;
        };
        console.log(hdr);

        $.ajax({
            url: "@Url.Action("SaveCustomReportTru")",
            method: "POST",
        data: {
            name: lname,
            layout: hdr
        },
        success: function (data) {
            if (data) {
                console.log(data);
                ez.Modals.notification("Custom export saved!");
                LoadCustomReportTru(undefined, true);
            }
            else
                ez.Modals.error("Failed to save custom report!");
        }
    });
