@Html.Partial("~/Views/Shared/_NotificationModals.cshtml")
<script src="@Url.Content("~/Scripts/ez.js")"></script>
<script>
    var filter = {};

    $(function () {
        $("#FilterTransportationStatusTru").select2({ width: '100%' });
        $("#FilterVendorTru").select2({ width: '100%' });
        $("#FilterSenderTru").select2({ width: '100%' });
        $("#FilterReceiverTru").select2({ width: '100%' });
        $("#FilterStartLocationTru").select2({ width: '100%' });
        $("#FilterFinishLocationTru").select2({ width: '100%' });
        resetFilterTru();
        generateTableTru();
    });

    function restrictDate() {
        var val = $("#FilterDateToTru").val();
        var valf = $("#FilterDateFromTru").val();
        
        if (valf != "" && valf != null && val != "" && val != null) {
            var tto = moment(val, "DD/MM/YYYY").format("YYMMDD");
            var tfr = moment(valf, "DD/MM/YYYY").format("YYMMDD");
            if (tto < tfr) {
                $("#FilterDateToTru").val(valf);
            }
        }
    }

    $("#FilterTransportationNumberTru").select2({
        ajax: {
            url: '@Url.Action("GetTransportNoDtos", "TransportationMonitoring")',
            dataType: 'json',
            data: function (params) {
                return {
                    TransportNo: params,
                    TransportMode: 'Truck'
                };
            },
            results: function (data) {
                var myResults1 = [];
                $.each(data, function (index, item) {
                    myResults1.push({
                        'id': item.TransportNo,
                        'text': item.TransportNo
                    });
                });
                return {
                    results: myResults1
                };
            },
            cache: true
        },
        placeholder: 'Type Transportation Number',
        delay: 250,
        multiple: true,
        minimumInputLength: 1
    });

    $("#FilterOrderNumberTru").select2({
        ajax: {
            url: '@Url.Action("GetOrderNoDtos", "TransportationMonitoring")',
            dataType: 'json',
            data: function (params) {
                return {
                    STONo: params
                };
            },
            results: function (data) {
                var myResults1 = [];
                $.each(data, function (index, item) {
                    myResults1.push({
                        'id': item.STONo,
                        'text': item.STONo
                    });
                });
                return {
                    results: myResults1
                };
            },
            cache: true
        },
        placeholder: 'Type Order Number',
        delay: 250,
        multiple: true,
        minimumInputLength: 1
    });

    $("#FilterDateToTru").change(restrictDate).on("changeDate", restrictDate);
    $("#FilterDateFromTru").change(restrictDate).on("changeDate", restrictDate);

    function resetFilterTru() {
        $("#FilterTransportationNumberTru").select2("val", null);
        $('#FilterDateFromTru').val(moment().subtract(7, "days").format("DD/MM/YYYY"));
        $('#FilterDateToTru').val(moment().format("DD/MM/YYYY"));
        $("#FilterTransportationStatusTru").select2("val", null);
        $("#FilterOrderNumberTru").select2("val", null);
        $("#FilterVendorTru").select2("val", null);
        $("#FilterSenderTru").select2("val", null);
        $("#FilterReceiverTru").select2("val", null);
        $("#FilterStartLocationTru").select2("val", null);
        $("#FilterFinishLocationTru").select2("val", null);
    }

    function generateTableTru() {
        dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        if (moment($('#FilterDateFromTru').val(), "DD/MM/YYYY").isAfter(moment($('#FilterDateToTru').val(), "DD/MM/YYYY")))
        {
            dialog.modal("hide");
            $("#labelErrorTru").html("");
            $("#labelErrorTru").html("Transportation Date To must be greater than Transportation Date From!");
            $('#modalerrorTru').modal('show');
            return;
        }

        filter.transportNo = $("#FilterTransportationNumberTru").val().split(',');
        filter.transportStatus = $("#FilterTransportationStatusTru").val();
        filter.vendor = $("#FilterVendorTru").val();
        filter.orderNo = $("#FilterOrderNumberTru").val().split(',');
        filter.sender = $("#FilterSenderTru").val();
        filter.receiver = $("#FilterReceiverTru").val();
        filter.startLocation = $("#FilterStartLocationTru").val();
        filter.finishLocation = $("#FilterFinishLocationTru").val();
        filter.dateFrom = moment($('#FilterDateFromTru').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.dateTo = moment($('#FilterDateToTru').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.mode = "Truck";
        
        var table = $('#dtFilterTruck').DataTable({
            "paging": true,  
            "ordering": false,  
            "filter": true,  
            "destroy": true,  
            "orderMulti": false,  
            "serverSide": true,  
            "processing": true, 
            "pageLength": 10,
            "ajax": {
                dataType: 'JSON',
                type: 'POST',
                url: '@Url.Action("GetListViewTruckShipTrainServerSide", "TransportationMonitoring")',
                data: function (data) {
                    data.filter = filter;
                    return data
                },
                "complete": function (res) {
                    //console.log("result", res);
                    dialog.modal('hide');
                },
                "error": function (res) {
                    console.log("error", res);
                    dialog.modal('hide');
                }
            },
            "columns": [
                {
                    'data': 'IsActive', 'class': 'text-center', 'render': function (data, disp, row) {
                        var id = row.IDTransportExecution;
                        if (data == true) {
                            return '<div data-id="'+id+'"><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                        }
                        else {
                            return '<div data-id="' + id + '"><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>';
                        }
                    }, 'sortable': false
                },
                {
                    // Must find how to show modal spinner before move to another page
                    'data': 'TransportNo', 'render': function (data, type, row, meta) {
                        return '<a href="@Url.Action("DetailTruck")?id=' + row["IDTransportExecution"] + '">' + row["TransportNo"] + '</a>';
                    }, 'searchable': true, 'sortable': true
                },
                {
                    'data': 'TransportDate', 'render': function (data) {
                        return moment(data).format("DD-MMM-YYYY");
                    }, 'searchable': true, 'sortable': true
                },
                { 'data': 'ActualVehicleType', 'searchable': true, 'sortable': true },
                { 'data': 'VendorName', 'searchable': true, 'sortable': true },
                { 'data': 'TransportStatus', 'searchable': true, 'sortable': true },
                { 'data': 'StartLocation', 'searchable': true, 'sortable': true },
                { 'data': 'FinishLocation', 'searchable': true, 'sortable': true },
                { 'data': 'PoliceRegistrationNumber', 'searchable': true, 'sortable': true },
                { 'data': 'Driver1', 'searchable': true, 'sortable': true },
                { 'data': 'Driver2', 'searchable': true, 'sortable': true },
                { 'data': 'CoDriver', 'searchable': true, 'sortable': true },
                { 'data': 'CurrentLocation', 'searchable': true, 'sortable': true },
                {
                    'data': 'CurrentLocationUpdateTime', 'render': function (data) {
                        if (data != null && moment(data).format("DDMMYYYY") != "01010001") { return moment(data).format("DD-MMM-YYYY HH:mm:ss"); }
                        else { return ""; }
                    }, 'searchable': true, 'sortable': true
                }
            ],
            //"dom": 'lf<"table-overflow"t>ip',

        });
        $('.dataTables_filter input').attr("placeholder", "Search Here");
        $('#dtFilterTruck thead.filters th').each(function (index) {
            if (index > 0) {
                var title = $('#dtFilterTruck thead.filters th').eq($(this).index()).text();
                $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
            }
        });

        table.columns().every(function (index) {
            if (index > 0) {
                $('#dtFilterTruck thead.filters th:eq(' + index + ') input').on('input', function () {
                    table.settings()[0].jqXHR.abort();
                    table.column($(this).parent().index() + ':visible')
                        .search(this.value)
                        .draw();
                });
            }
        });
    }

    //$('.nav-pills a[href="#tabtruck"]').click(function () {
    //    generateTableTru();
    //    // alert('truck');
    //});

    $(document).on('click', '#exportDefaultButtonTru', function () {
        exportDataTru();
    });

    $(document).on('click', '#btnExportCustomReportTru', function () {
        if ($('#destinationFieldsTru .fc-field').text().length == 0) {
            $("#labelCheck").html("");
            $("#labelCheck").html("Please select of the existing fields");
            $('#modalwarningTru').modal('show');
        }
        else {
            customReportTru();
        }
    });

    $(document).on('click', '#uploadButtonTru', function () {
        $('#uploadMonitoringListTru').val("");
        $("#uploadMonitoringListTru").jfilestyle('clear');
