            fon = ($("#FilterOrderNumberTru").val() == null ? "" : $("#FilterOrderNumberTru").val().toString()),
            fvn = ($("#FilterVendorTru").val() == null ? "" : $("#FilterVendorTru").val().toString()),
            fse = ($("#FilterSenderTru").val() == null ? "" : $("#FilterSenderTru").val().toString()),
            fre = ($("#FilterReceiverTru").val() == null ? "" : $("#FilterReceiverTru").val().toString()),
            fsl = ($("#FilterStartLocationTru").val() == null ? "" : $("#FilterStartLocationTru").val().toString()),
            ffl = ($("#FilterFinishLocationTru").val() == null ? "" : $("#FilterFinishLocationTru").val().toString());

        if (fdf != "" && fdf != null)
        {
            fdf = moment(fdf, "DD/MM/YYYY").format("YYYY-MM-DD");
        }
        if (fdt != "" && fdt != null) {
            fdt = moment(fdt, "DD/MM/YYYY").format("YYYY-MM-DD");
        }

        $.ajax({
            url: '@Url.Action("GetListViewTruckTrain")',
            method: 'POST',
            dataType: 'json',
            cache: false,
            data: { mode: 'Truck', fltrtn: ftn, fltrdf: fdf, fltrdt: fdt, fltrts: fts, fltron: fon, fltrvn: fvn, fltrse: fse, fltrre: fre, fltrsl: fsl, fltrfl: ffl },
            error: function() {
                dialog.modal("hide");
            },
            success: function (result) {
                //$("#modalloadingTru").modal("hide");
                dialog.modal('hide');
                explist = [];
                $.each(result, function (key, val) {
                    if (val.TransportStatus == 'On Delivery') { state1Tru = state1Tru + 1; }
                    if (val.TransportStatus == 'Arrive At Destination and Waiting For Confirmation') { state2Tru = state2Tru + 1; }
                    if (val.TransportStatus == 'Complete') { state3Tru = state3Tru + 1; }

                    explist.push(val.IDTransportExecution);
                });

                $('#state1Tru').html(state1Tru);
                $('#state2Tru').html(state2Tru);
                $('#state3Tru').html(state3Tru);

                var table = $('#dtFilterTruck').DataTable({
                    'destroy': true,
                    'data': result,
                    'paging': true,
                    'searching': true,
                    'iDisplayLength': 25,
                    //aaSorting: [[2, 'asc']],
                    columns: [
                        {
                            'data': 'IsActive', 'class': 'text-center', 'render': function (data, disp, row) {
                                var id = row.IDTransportExecution;
                                if (data == true) {
                                    return '<div data-id="'+id+'"><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                }
