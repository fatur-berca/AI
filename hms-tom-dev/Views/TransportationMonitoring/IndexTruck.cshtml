                                .draw();
                        });
                    }
                });
            }
        });
    }

    function exportDataTru() {
        dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        if (moment($('#FilterDateFromTru').val(), "DD/MM/YYYY").isAfter(moment($('#FilterDateToTru').val(), "DD/MM/YYYY")))
        {
            dialog.modal("hide");
            $("#labelErrorTru").html("");
            $("#labelErrorTru").html("Transportation Date To must be greater than Transportation Date From!");
            $('#modalerrorTru').modal('show');
            return;
        }

        filter.transportNo = $("#FilterTransportationNumberTru").val().split(',');
        filter.transportStatus = $("#FilterTransportationStatusTru").val();
        filter.vendor = $("#FilterVendorTru").val();
        filter.orderNo = $("#FilterOrderNumberTru").val().split(',');
        filter.sender = $("#FilterSenderTru").val();
        filter.receiver = $("#FilterReceiverTru").val();
        filter.startLocation = $("#FilterStartLocationTru").val();
        filter.finishLocation = $("#FilterFinishLocationTru").val();
        filter.dateFrom = moment($('#FilterDateFromTru').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.dateTo = moment($('#FilterDateToTru').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.mode = "Truck";

        $.ajax({
            url: 'TransportationMonitoring/ExportMonitoringXlsTruckTrain',
            method: 'POST',
            dataType: 'json',
            cache: false,
            data: { filter : filter },
            success: function (result) {
                window.location.assign('@Url.Content("~/Assets/Download/")' + result);
                dialog.modal('hide');
            }
        });
    }

