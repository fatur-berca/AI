@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.Transport.TransportMonitoringViewModel
@{
    var listUserRole = ViewBag.ListUserRole;
}

<style>
    .fc-selected {
        background-color: #f39814 !important;
    }

    .dataTables_processing {
        top: 64px !important;
        z-index: 99000 !important;
        height: 100%;
    }
</style>

<div class="title-deck wmb" hidden>
    <div class="col-panel">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>ON DELIVERY</label>
                    <h4 class="sub-text" id="state1Tru"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
            <div class="col-md-5">
                <div class="form-group">
                    <label>ARRIVED AT DESTINATION AND WAITING FOR CONFIRMATION</label>
                    <h4 class="sub-text" id="state2Tru"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>COMPLETE</label>
                    <h4 class="sub-text" id="state3Tru"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
@if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
{
        <button class="btn btn-primary" id="exportDefaultButtonTru">Export</button>
}
@if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
{
        <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#customReportModalTru" id="customReportButtonTru">Custom Report</button>
}
@if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Upload)))
{
        <button class="btn btn-primary" data-toggle="modal" data-target="#uploadModalTru" id="uploadButtonTru">Upload</button>        
}
    </div>
    <a href="#searchfilterTruck" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck nmb">
    <div id="searchfilterTruck" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Transportation Number</label>
                        <input type="hidden" style="width: 100%" id="FilterTransportationNumberTru" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group">
                                <label>Transportation Date</label>
                                <input type="text" class="form-control datepicker" id="FilterDateFromTru" data-date-format="DD/MM/YYYY" value="@{var a = (DateTime.Now - new TimeSpan(0, 0, 0, 0)).ToString("dd/MM/yyyy"); @a}">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <label class="text-center">TO</label>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <input type="text" class="form-control datepicker" id="FilterDateToTru" data-date-format="DD/MM/YYYY" value="@DateTime.Now.ToString("dd/MM/yyyy")">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Transportation Status</label>
                        @Html.DropDownListFor(model => Model.TransportStatus, Model.transStatus, new { @multiple = "multiple", @id = "FilterTransportationStatusTru", @placeholder = " " })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Vendor</label>
                        @Html.DropDownListFor(model => Model.VendorName, Model.vendorNames, new { @multiple = "multiple", @id = "FilterVendorTru", @placeholder = " " })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Order Number</label>
                        <input type="hidden" style="width:100%" id="FilterOrderNumberTru" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Sender</label>
                        @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "FilterSenderTru", @placeholder = " " })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Receiver</label>
                        @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "FilterReceiverTru", @placeholder = " " })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Start Location</label>
                        @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "FilterStartLocationTru", @placeholder = " " })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Finish Location</label>
                        @Html.DropDownListFor(model => Model.LocationName, Model.locationNames, new { @multiple = "multiple", @id = "FilterFinishLocationTru", @placeholder = " " })
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="col-md-12">
                <button class="btn btn-primary search-filter" id="btnSearchFilterTru">Search</button>
                <button class="btn btn-purple reset-search-filter" id="btnResetFilterTru">Reset</button>
            </div>
        </div>
    </div>
</div>

<table id="dtFilterTruck" class="display table dataTable">
    <thead>
        <tr>
            <th>Active</th>
            <th>Transportation Number</th>
            <th>Transportation Date</th>
            <th>Vehicle Type</th>
            <th>Vendor Name</th>
            <th>Transportation Status</th>
            <th>Start Location</th>
            <th>Finish Location</th>
            <th>Police Registration Number</th>
            <th>Driver 1</th>
            <th>Driver 2</th>
            <th>Co-Driver</th>
            <th>Location</th>
            <th>Date &amp; Time</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th>Filter</th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

