    function importDataTru() {
        $('#modalloadingTru').modal('show');

        var form = new FormData();
        var field = document.getElementById('uploadMonitoringListTru');
        var value = field.files[0].name;
        form.append(value, field.files[0]);

        $.ajax({
            url: 'TransportationMonitoring/ImportMonitoringXlsTruckTrain',
            method: 'POST',
            cache: false,
            contentType: false,
            processData: false,
            data: form,
            success: function (result) {

                if (result.IsSuccess)
                {
                    $('#uploadModalTru').modal('hide')
                    $("#modaltextTru").html("");
                    $("#modaltextTru").html("Data uploaded successfully!");
                    $('#modalsuccessTru').modal('show');
                    generateTableTru();
                }
                else
                {
                    $("#labelErrorTru").html("");
                    $("#labelErrorTru").html(result.ErrorMessage);
                    $('#modalerrorTru').modal('show');
                }
                $('#modalloadingTru').modal('hide');
            }
        });
    }

