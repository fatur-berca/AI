        {
            dialog.modal("hide");
            $("#labelErrorTru").html("");
            $("#labelErrorTru").html("Transportation Date To must be greater than Transportation Date From!");
            $('#modalerrorTru').modal('show');
            return;
        }
        //$("#modalloadingTru").modal("show");

        var ftn = ($("#FilterTransportationNumberTru").val() == null ? "" : $("#FilterTransportationNumberTru").val().toString()),
            fdf = $('#FilterDateFromTru').val(),
