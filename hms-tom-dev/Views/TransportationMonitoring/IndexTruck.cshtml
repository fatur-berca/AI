    function getCountTru(stOrder, idStOrder) {

        var state1Tra = 0, state2Tra = 0, state3Tra = 0;

        if (moment($('#FilterDateFromTra').val(), "DD/MM/YYYY").isAfter(moment($('#FilterDateToTra').val(), "DD/MM/YYYY"))) {
            $("#labelErrorTra").html("");
            $("#labelErrorTra").html("Transportation Date To must be greater than Transportation Date From!");
            $('#modalerrorTra').modal('show');
            return;
        }

        var ftn = ($("#FilterTransportationNumberTru").val() == null ? "" : $("#FilterTransportationNumberTru").val().toString()),
            fdf = $('#FilterDateFromTru').val(),
            fdt = $('#FilterDateToTru').val(),
            fts = ($("#FilterTransportationStatusTru").val() == null ? "" : $("#FilterTransportationStatusTru").val().toString()),
            fon = ($("#FilterOrderNumberTru").val() == null ? "" : $("#FilterOrderNumberTru").val().toString()),
            fvn = ($("#FilterVendorTru").val() == null ? "" : $("#FilterVendorTru").val().toString()),
            fse = ($("#FilterSenderTru").val() == null ? "" : $("#FilterSenderTru").val().toString()),
            fre = ($("#FilterReceiverTru").val() == null ? "" : $("#FilterReceiverTru").val().toString()),
            fsl = ($("#FilterStartLocationTru").val() == null ? "" : $("#FilterStartLocationTru").val().toString()),
            ffl = ($("#FilterFinishLocationTru").val() == null ? "" : $("#FilterFinishLocationTru").val().toString());

        if (fdf != "" && fdf != null) {
            fdf = moment(fdf, "DD/MM/YYYY").format("YYYY-MM-DD");
        }
        if (fdt != "" && fdt != null) {
            fdt = moment(fdt, "DD/MM/YYYY").format("YYYY-MM-DD");
        }
        $.ajax({
            url: '@Url.Action("GetCountTruckTrain")',
            method: 'POST',
            dataType: 'json',
            cache: false,
            data: { modeS: 'Truck', fltrtn: ftn, fltrdf: fdf, fltrdt: fdt, fltrts: fts, fltron: fon, fltrvn: fvn, fltrse: fse, fltrre: fre, fltrsl: fsl, fltrfl: ffl, stOrder: stOrder },
            error: function () {
                $('#' + idStOrder).html(0);
            },
            success: function (result) {
                $('#' + idStOrder).html(result.resultCount);
            }
        });
    }

    function generateTableTruBackUp() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
