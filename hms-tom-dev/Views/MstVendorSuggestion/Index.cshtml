                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Start Location</label>
                                            <select class="select2" id="StartLoc"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Receiver</label>
                                            <select class="select2" id="Receiver"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Order Type</label>
                                            <select class="form-control" id="OrderType"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Transportation Category</label>
                                            <select class="form-control" id="TransCat"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Transportation Mode</label>
                                            <select class="form-control" id="TransMode"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Vehicle Type</label>
                                            <select class="select2" id="VechType"></select>
                                        </div>
                                    </div>
