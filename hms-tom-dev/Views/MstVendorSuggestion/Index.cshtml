@{
    ViewBag.Title = "Master Data > Master Vendor Suggestion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#inputModal">Add New</button>
        <button id="btnPopUpUpload" class="btn btn-primary" type="button" data-toggle="modal" data-target="#modalUpload">Upload</button>
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter" id="advSrc"><b>Advanced Search </b><i class="fa fa-angle-down"></i></a>
</div>
<div class="filter-deck nmb">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel wmb wbt">
            <form id="filter">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Start Location</label>
                        <select id="FilterSenderLocation" class="select2" multiple></select>
                    </div>
                </div>
                <div class="col-md-12">
                    <button class="btn btn-primary search-filter">Search</button>
                    <button class="btn btn-purple reset-search-filter">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>
<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr>
            <th width=5% nowrap class="text-center">Active</th>
            <th>Start Location</th>
            <th>Receiver</th>
            <th style="min-width: 90px;">Order Type</th>
            <th style="min-width: 150px;">Transportation Category</th>
            <th style="min-width: 150px;">Transportation Mode</th>
            <th>Vehicle Type</th>
            <th style="min-width: 150px;">Suggested Vendor</th>
            <th style="min-width: 90px;">Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center">Action</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th width=5% nowrap class="text-center">Filter</th>
            <th>Start Location</th>
            <th>Receiver</th>
            <th>Order Type</th>
            <th>Transportation Category</th>
            <th>Transportation Mode</th>
            <th>Vehicle Type</th>
            <th>Suggested Vendor</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center"></th>
        </tr>
    </thead>
</table>

<!-- Modal -->
