@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "Warehouse > Seal Management > Seal Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="title-deck wborder wmb">
        </div>
    </div>
    <div class="col-md-12">
        <div class="title-deck wmb">
            <div class="button-wrap pull-left">
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Back)))
                {
                    <button class="btn btn-purple" onclick="BackUrl()">Back</button>
                }
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Edit)))
                {
                    <button class="btn btn-primary" id="EditBtnSeal">Edit</button>
                }
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Save)))
                {
                    <button class="btn btn-primary" id="SaveBtnSeal" onclick="SaveNew(true)">Save</button>
                }
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="box">
            <form>
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-4" hidden>
                            <div class="form-group">
                                <label>id</label>
                                <input type="text" id="IDSealStock" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Date</label>
                                <input type="text" id="SealStockDate" class="form-control datepicker">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Warehouse Name</label>
                                <select class="select2" id="DDWarehouse"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Condition</label>
                                <select class="form-control" id="DDCondition"></select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Seal Number</label>
                                <div class="row">
                                    <div class="col-md-5">
                                        <input type="text" name="" class="form-control" id="SealNumberFrom" onkeypress="return IsAngka(event)">
                                    </div>
                                    <div class="col-md-2 to-bi">
                                        <label>To</label>
                                    </div>
                                    <div class="col-md-5">
                                        <input type="text" name="" class="form-control" id="SealNumberTo"  onkeypress="return IsAngka(event)">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Remarks</label>
                                <textarea class="form-control" id="Remarks"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="../assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="../assets/images/cancel.png" alt="">
                <span>Sorry, the inputted data exists or your connection is lost</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade ml-warning" id="modalwarning" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="../assets/images/danger.png" alt="">
                <span>Please input Yellow field</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

