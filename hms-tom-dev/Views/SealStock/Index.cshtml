@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "Warehouse > Seal Stock > List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
    bool isSuperUser = false;
}

@foreach (var x in listUserRole)
{
    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
    {
        isSuperUser = true;
        break;
    }
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.AddNew)))
        {
            <button class="btn btn-primary" onclick="ForwardUrl()">Add New</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Delete)))
        {
            <button class="btn btn-primary" id="btnSetInactive" type="button" onclick="SetIsActive('Delete')">Delete</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
        {
            <button class="btn btn-primary" id="exportButton">Export</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
        {
            <button class="btn btn-primary" data-toggle="modal" data-target="#customReportModal" id="customReportButton">Custom Report</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Recovery)))
        {
            <button class="btn btn-primary" id="btnSetActive" type="button" onclick="SetIsActive('Recovery')">Recovery</button>
        }
        <button class="btn btn-primary" data-toggle="modal" data-target="#reportAvailableSealModal" id="reportAvailableSealBtn">Report Used & Available Seal</button>
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Date Range</label>
                    <div class="row">
                        <div class="col-md-5">
                            <input type="text" class="form-control datepicker" id="DateFrom">
                        </div>
                        <div class="col-md-2 to-bi">
                            <label>to</label>
                        </div>
                        <div class="col-md-5">
                            <input type="text" class="form-control datepicker" id="DateTo">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Warehouse Name</label>
                    <select class="select2" multiple="multiple" id="DDWarehouse">
                    </select>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Condition</label>
                    <select class="select2" multiple="multiple" id="DDCondition"></select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Seal Number</label>
                    <select class="select2" multiple="multiple" id="SealNumber">
                    </select>
                </div>
            </div>
            @*<div class="clearfix"></div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="checkbox-deck">
                        <input type="checkbox" id="chkInactive">
                        <label for="chkInactive"></label>
                    </div>
                    <span class="checkbox-deck-span">Include deleted data</span>
                </div>
            </div>*@
            @if (isSuperUser)
            {
                <div class="clearfix"></div>
                <div class="col-sm-4">
                    <div class="form-group">

                        <label for="input-type">Status</label>
                        <div id="input-type" class="row">
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" id="all" value="1" type="radio" />All
                                </label>
                            </div>
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" id="deleted" value="0" type="radio" /> Deleted
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="col-md-12">
                <button class="btn btn-primary" onclick="GenerateTable('Search',null)" id="btnSearch">Search</button>
                <button class="btn btn-purple" onclick="ResetData()">Reset</button>
            </div>
        </div>
    </div>
</div>

<table id="dtFilterSealStock" class="display table dataTable">
    <thead>
        <tr>
            <th data-orderable="false" class="text-center">
                <div class="checkbox-deck">
                    <input type="checkbox" name="" id="checkall">
                    <label for="checkall"></label>
                </div>
            </th>
            <th>Status</th>
            <th>Date</th>
            <th>Warehouse ID</th>
            <th>Warehouse Name</th>
            <th>Condition</th>
            <th>Seal Number</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th class="text-center">Filter</th>
            <th></th>
            <th>Date</th>
            <th>Warehouse ID</th>
            <th>Warehouse Name</th>
            <th>Condition</th>
            <th>Seal Number</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div class="modal fade" id="customReportModal" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Custom Report</h4>
            </div>
            <div class="modal-body custom-report">
                <div class="row label-top">
                    <div class="col-md-6">
                        <label>Column Set</label>
                    </div>
                    <div class="col-md-6">
                        <label class="dis">Displayed Columns</label>
                        <select id="layoutSelect" class="form-control">
                            <option value="">Loading...</option>
                        </select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div id="fieldChooser" tabindex="1" class="field-chooser form-group">
                    <div id="sourceFields" class="source">
                        <div data-field="IsActive">Status</div>
                        <div data-field="SealStockDate">Date</div>
                        <div data-field="IDLocation">Warehouse ID</div>
                        <div data-field="LocationName">Warehouse Name</div>
                        <div data-field="Condition">Condition</div>
                        <div data-field="SealNumberTo">Seal Number</div>
                    </div>
                    <div class="button-column">
                        <div>
                            <input class="btn btn-info mini" type="button" id="left" value="<">
                            <input class="btn btn-info mini" type="button" id="right" value=">">
                        </div>
                    </div>
                    <div id="destinationFields" class="destination"></div>
                </div>
                <div class="opt-bot">
                    <div class="row">
                        <div class="col-md-6">
                            <input class="btn btn-info amr" type="button" id="rightall" value=">>">
                            <input class="btn btn-info" type="button" id="leftall" value="<<">
                        </div>
                        <div class="col-md-6">
                            <input class="btn btn-info" type="button" id="saveLayoutButton" value="Save Layout">
                            <input type="text" class="form-control" id="layoutName">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @foreach (var x in listUserRole)
                {
                    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
                    {
                        <div class="form-group pull-left">
                            <div class="checkbox-deck">
                                <input type="checkbox" id="chkGlobalCustomReport">
                                <label for="chkGlobalCustomReport"></label>
                            </div>
                            <span class="checkbox-deck-span">Global Custom Report</span>
                        </div>
                    }
                }

                <button class="btn btn-primary" id="exportCustomReport">Export</button>
                <button class="btn btn-purple" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="reportAvailableSealModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="modadUploadLabel">Report Used & Available Seal Stock</h4>
            </div>
            <div class="modal-body">
                <form id="frmUploadZone">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Warehouse Name</label>
                                <select class="select2" multiple="multiple" id="DDWarehouseReport">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Seal Number</label>
                                <select class="select2" multiple="multiple" id="DDSealNumberReport"></select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Status</label>
                                <select class="select2" id="DDStatusReport"></select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button id="btnExportReportAvailableSeal" class="btn btn-primary">Export</button>
                <button class="btn btn-purple" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-warning" id="warningModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="warningUpload">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/danger.png" alt="">
                <span id="textModalWarning"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<style>
    .fc-selected {
        background-color: #f39814 !important;
    }
</style>

<script type="text/javascript">
    jQuery(function ($) {
        $("#all").prop("checked", true);
        $("#DateFrom").val(moment(new Date()).format("DD/MM/YYYY"));
        $("#DateTo").val(moment(new Date()).format("DD/MM/YYYY"));
        GenerateTable("firstload", '');
        paramex = 'firstload';
        GenerateDropDownWarehouse();
    });

    dialogloading = bootbox.dialog({
        message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
        closeButton: false
    });
    //begin : custom report
    $("#fieldChooser").fieldChooser($("#sourceFields"), $("#destinationFields"));

    $(document).on('click', '#saveLayoutButton', function (e) {
        saveLayout();
        e.preventDefault();
    });

    $(document).on('click', '#exportButton', function (e) {
        exportToExcelDefault(paramex);
        e.preventDefault();
    });
    $(document).on('click', '#exportCustomReport', function (e) {
        exportToExcelDefault(paramex);
        e.preventDefault();
    });

    $(document).on('click', '#btnSearch', function (e) {
        paramex = 'Search';
        e.preventDefault();
    });

    $(document).on('click', '#left', function (e) {
        moveItems('#destinationFields', '#sourceFields');
        e.preventDefault();
    });

    $(document).on('click', '#right', function (e) {
        moveItems('#sourceFields', '#destinationFields');
        e.preventDefault();
    });

    $(document).on('click', '#leftall', function (e) {
        moveAllItems('#destinationFields', '#sourceFields');
        e.preventDefault();
    });

    $(document).on('click', '#rightall', function (e) {
        moveAllItems('#sourceFields', '#destinationFields');
        e.preventDefault();
    });

    $(document).on('click', '#customReportButton', function (e) {
        $('#chkGlobalCustomReport').prop('checked', false);
        $("#layoutName").val('');
        generateLayoutSelect();
        e.preventDefault();
    });

    $('#layoutSelect').on('change', function () {
        for (var j = 1; j < layoutIsGlobal.length; j++) {
            if ($('#layoutSelect option:selected').text() == layoutIsGlobal[j].LayoutName) {
                $('#chkGlobalCustomReport').prop('checked', layoutIsGlobal[j].isGlobal);
            }

        }
        var sourceFieldNames = [
            { 'field': 'IsActive', 'label': 'Status' },
            { 'field': 'SealStockDate', 'label': 'Date' },
            { 'field': 'IDLocation', 'label': 'Warehouse ID' },
            { 'field': 'LocationName', 'label': 'Warehouse Name' },
            { 'field': 'Condition', 'label': 'Condition' },
            { 'field': 'SealNumberTo', 'label': 'Seal Number' },
        ],
            sourceFields = '',
            destinationFieldNames = this.value.split(','),
            destinationFields = '',
            destinationfieldLabels = [];
        var i;
        for (i = 0; i < sourceFieldNames.length; ++i) {
            if (jQuery.inArray(sourceFieldNames[i]['field'], destinationFieldNames) == -1) {
                // the element is not in the array
                sourceFields = sourceFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + sourceFieldNames[i]['field'] + "'>" + sourceFieldNames[i]['label'] + "</div>";
            } else {
                destinationfieldLabels[sourceFieldNames[i]['field']] = sourceFieldNames[i]['label'];
            }
        }
        $("#fieldChooser #sourceFields").html(sourceFields);

        for (i = 0; i < destinationFieldNames.length; ++i) {
            destinationFields = destinationFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + destinationFieldNames[i] + "'>" + destinationfieldLabels[destinationFieldNames[i]] + "</div>";
        }
        $("#fieldChooser #destinationFields").html(destinationFields);
    });
    var paramex;
    function exportToExcelDefault(param) {

        dialogloading = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        var dateFrom = $("#DateFrom").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
            dateTo = $("#DateTo").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
            warehouse = (param == "firstload") ? $("#DDWarehouse").val() : ($("#DDWarehouse").val() == null ? $("#DDWarehouse").val() : $("#DDWarehouse").val().toString()),
            condition = (param == "firstload") ? $("#DDCondition").val() : ($("#DDCondition").val() == null ? $("#DDCondition").val() : $("#DDCondition").val().toString()),
            sealNumber = (param == "firstload") ? $("#SealNumber").val() : ($("#SealNumber").val() == null ? $("#SealNumber").val() : $("#SealNumber").val().toString()),
            includeInActive = ($('#deleted').length > 0) ? (($('#all').prop("checked") == true ? 1 : 0)) : null;

        var input = {
            "IDSealStock": 0,
            "SealStockDateFrom": dateFrom,
            "SealStockDateTo": dateTo,
            "IDLocation": warehouse,
            "Condition": condition,
            "SealNumberInput": sealNumber,
            "Type": paramex,
            "IncludeInActive": includeInActive
        };
        console.log(input);

        var columns = '';
        $('#destinationFields .fc-field').each(function () {
            columns = columns + $(this).text() + ',';
        });
        columns = columns.slice(0, -1);

        jQuery.ajax({
            url: '@Url.Action("ExportToExcelDefault")',
            method: 'post',
            data: {
                "IDSealStock": 0,
                "SealStockDateFrom": dateFrom,
                "SealStockDateTo": dateTo,
                "IDLocation": warehouse,
                "Condition": condition,
                "SealNumberInput": sealNumber,
                "Type": paramex,
                "IncludeInActive": includeInActive,
                "Columns": columns
            },
            dataType: 'json',

            // data: { "Columns": columns },
            success: function (response) {
                dialogloading.modal('hide');
                console.log(response);
                window.location.assign("Assets/Download/" + response);
            },
            error: function () {
                dialogloading.modal('hide');
            }
        });
    }

    function exportToExcel() {

        dialogloading = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        var columns = '';
        $('#destinationFields .fc-field').each(function () {
            columns = columns + $(this).text() + ',';
        });
        columns = columns.slice(0, -1);

        jQuery.ajax({
            url: '@Url.Action("ExportToExcel")',
            method: 'post',
            dataType: 'json',
            data: {
                "Columns": columns
            },
            success: function (response) {
                dialogloading.modal('hide');
                window.location.assign("Assets/Download/" + response);
            },
            error: function () {
                dialogloading.modal('hide');
            }
        });
    }
    //end : custom report


    //==========================================================================================================
    // PART A: BEGIN
    // Global Variable, instantiate objects, and prepare array
    // DO NOT MODIFY THIS
    //==========================================================================================================
    function moveItems(origin, dest) {
        jQuery(origin).find('.fc-selected').appendTo(dest);
    }

    function moveAllItems(origin, dest) {
        jQuery(origin).children().appendTo(dest);
    }
    //==========================================================================================================
    // PART A: END
    // Global Variable, instantiate objects, and prepare array
    // DO NOT MODIFY THIS
    //==========================================================================================================
    //==========================================================================================================
    // PART B: BEGIN
    // This part is to validate all entries, and reset all entries, define standard function
    // DO NOT MODIFY THIS
    //==========================================================================================================
    var layoutIsGlobal = [];
    function generateLayoutSelect() {
        var firstLayout = "", thenLayout = "";
        var k = 0;
        jQuery.ajax({
            url: '@Url.Action("../CustomReportState/GetLayouts")',
            method: 'post',
            dataType: 'json',
            cache: false,
            data: { "PageName": "SealStock" },
            success: function (response) {
                var layoutName = '',
                    options = '';

                if (parseInt(response.length) > 0) {
                    options = '';
                    for (var i = 0; i < response.length; ++i) {
                        if (layoutName != response[i].LayoutName) {
                            if (firstLayout == "") {
                                firstLayout = response[i].LayoutName;
                                ++k;
                                layoutIsGlobal[k] = { "isGlobal": response[i].IsGlobal, "LayoutName": response[i].LayoutName };
                            }

                            if (firstLayout != response[i].LayoutName) {
                                thenLayout = response[i].LayoutName;
                                ++k;
                                layoutIsGlobal[k] = { "isGlobal": response[i].IsGlobal, "LayoutName": response[i].LayoutName };
                            }

                            options = options + "'>" + layoutName + "</option><option value='" + response[i].FieldName;
                            layoutName = response[i].LayoutName;
                        } else {

                            options = options + "," + response[i].FieldName;
                        }
                    }
                    options = options + "'>" + layoutName + "</option>";
                    jQuery("#layoutSelect").html(options.slice(11)).ready(function () {
                        // Load selected layout
                        jQuery.ajax({
                            url: '@Url.Action("../CustomReportState/GetSelectedLayout")',
                            method: 'post',
                            dataType: 'json',
                            data: { "PageName": "SealStock" },
                            success: function (json) {
                                $('#layoutSelect').val(json[0].FieldName);
                                for (var j = 1; j < layoutIsGlobal.length; j++) {
                                    if ($('#layoutSelect option:selected').text() == layoutIsGlobal[j].LayoutName) {
                                        $('#chkGlobalCustomReport').prop('checked', layoutIsGlobal[j].isGlobal);
                                    }
                                }
                                var sourceFieldNames = [
                                    { 'field': 'IsActive', 'label': 'Status' },
                                    { 'field': 'SealStockDate', 'label': 'Date' },
                                    { 'field': 'IDLocation', 'label': 'Warehouse ID' },
                                    { 'field': 'LocationName', 'label': 'Warehouse Name' },
                                    { 'field': 'Condition', 'label': 'Condition' },
                                    { 'field': 'SealNumberTo', 'label': 'Seal Number To' },
									{ 'field': 'SealNumberFrom', 'label': 'Seal Number From' },
									{ 'field': 'CreatedBy', 'label': 'Created By' },
									{ 'field': 'CreatedDate', 'label': 'Created Date' },
									{ 'field': 'UpdatedBy', 'label': 'Updated By' },
									{ 'field': 'UpdatedDate', 'label': 'Updated Date' }
                                ];

                                sourceFields = '',
                                destinationFieldNames = json[0].FieldName.split(','),
                                destinationFields = '',
                                destinationfieldLabels = [];

                                for (i = 0; i < sourceFieldNames.length; ++i) {
                                    if (jQuery.inArray(sourceFieldNames[i]['field'], destinationFieldNames) == -1) {
                                        // the element is not in the array
                                        sourceFields = sourceFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + sourceFieldNames[i]['field'] + "'>" + sourceFieldNames[i]['label'] + "</div>";
                                    } else {
                                        destinationfieldLabels[sourceFieldNames[i]['field']] = sourceFieldNames[i]['label'];
                                    }
                                }
                                $("#fieldChooser #sourceFields").html(sourceFields);

                                for (i = 0; i < destinationFieldNames.length; ++i) {
                                    destinationFields = destinationFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + destinationFieldNames[i] + "'>" + destinationfieldLabels[destinationFieldNames[i]] + "</div>";
                                }

                                $("#fieldChooser #destinationFields").html(destinationFields);
                            }
                        });
                    });
                } else {
                    jQuery("#layoutSelect").html(options);
                }
            }
        });
    }

    function saveLayout() {
        var nonvalid = false;
        if ($("#layoutName").val() == "") { //layout name
            $("#layoutName").css('border-color', 'orange');
            nonvalid = true;
        } else {
            $("#layoutName").css('border-color', '#ccc');
        }

        if (nonvalid == true) {
            alertPleaseFill();
            return false;
        } else {

            var fieldNames = '',
                layoutName = $("#layoutName").val();
            var isGlobal;
            if ($("#chkGlobalCustomReport").prop('checked'))
                isGlobal = true;
            else
                isGlobal = false;

            $('#destinationFields .fc-field').each(function () {
                fieldNames = fieldNames + $(this).data('field') + ',';
            });
            fieldNames = fieldNames.slice(0, -1);

            dialogloading = bootbox.dialog({//hakim
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

            jQuery.ajax({
                url: '@Url.Action("../CustomReportState/InsertRecords")',
                method: 'post',
                dataType: 'json',
                data: { "layoutName": layoutName, "fieldNames": fieldNames, "pageName": "SealStock", "isGlobal": isGlobal },
                success: function (response) {
                    if (response == "Success") {
                        if (isGlobal) {
                            SaveChangesButton();
                        } else {
                            dialogloading.modal('hide');
                            alertSaveSuccess();
                            $("#chkGlobalCustomReport").prop('checked', false);
                        }
                    } else if (response == "NoLayoutName") {
                        alertPleaseFill();
                    }

                    if ($("#layoutName").val() != $("#layoutSelect option:selected").text()) {
                        $("#layoutSelect").append('<option value="' + fieldNames + '">' + layoutName + '</option>').val(fieldNames);
                    }
                }
            });
            return true;
        }
    }

    function SaveChangesButton() {
        var selectedLayoutName = $("#layoutName").val(),
            destinationFields = '',
            isGlobal = ($("#chkGlobalCustomReport").prop('checked')) ? true : false;

        $('#destinationFields .fc-field').each(function () {
            destinationFields = destinationFields + $(this).data("field") + ',';
        });
        destinationFields = destinationFields.slice(0, -1);

        $.ajax({
            url: '@Url.Action("../CustomReportState/SaveSelectedLayout")',
            method: 'post',
            dataType: 'json',
            data: { "layoutName": selectedLayoutName, "fieldNames": destinationFields, "pageName": "SealStock", "isGlobal": isGlobal },
            success: function (response) {
                dialogloading.modal('hide');
                if (response == "Success") {
                    alertSaveSuccess();
                } else {
                    alertSaveFail();
                }
            }
        });
    }


    //==========================================================================================================
    // PART A: BEGIN
    // Global Variable, instantiate objects, and prepare array
    // DO NOT MODIFY THIS
    //==========================================================================================================
    function moveItems(origin, dest) {
        jQuery(origin).find('.fc-selected').appendTo(dest);
    }

    function moveAllItems(origin, dest) {
        jQuery(origin).children().appendTo(dest);
    }
    //==========================================================================================================
    // PART A: END
    // Global Variable, instantiate objects, and prepare array
    // DO NOT MODIFY THIS
