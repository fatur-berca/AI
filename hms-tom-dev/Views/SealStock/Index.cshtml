    // BEGIN : SET INACTIVE OR ACTIVE RELATED TO CHECKBOX FUNCTION
    var tempid = [];
    var filter = new Object();
    var stat = false;
    function SetIsActive(param) {
        if (tempid.length > 0) {
            bootbox.confirm({
                title: "DFIS Notification Center",
                message: "Are you sure to " + param + " this data?",
                buttons: {
                    confirm: {
                        label: 'Yes',
                        className: 'btn btn-primary'
                    },
                    cancel: {
                        label: 'Cancel',
                        className: 'btn btn-purple'
                    }
                },
                callback: function (result) {
                    if (result) { ChangeIsActive(); }
                }
            });
            stat = (param == "Delete") ? false : true;
        } else if (tempid.length == 0) {
            alertPleaseSelect();
        }
    }

    function ChangeIsActive() {
        filter.ListIsActiveId = tempid;
        filter.Isactive = stat;
        filter.Page = "SealStock";
        $.ajax({
            url: "SealStock/SetStatusResult",
            method: 'post',
            dataType: 'json',
            data: filter,
            cache: false,
            success: function (response) {
                var msg = stat ? "Recovered" : "Deleted";
                if (response == "Success") {
                    bootbox.alert({
                        title: "DFIS Notification Center",
                        message: "<img src='assets/images/checked.png' alt=''> Data has been successfully " + msg + " from the database.",
                        callback: function () {
                            GenerateTable("firstload", null);
                            paramex = 'firstload';
                            filter.ListIsActiveId = null;
                            tempid = [];
                        }
                    });
                } else {
                    var splitCheck = response[0].split('-');
                    if (splitCheck == "Error") {
                        bootbox.alert({
                            title: "DFIS Notification Center",
                            message: "<img src='assets/images/cancel.png' alt=''>Error your data cannot be " + msg + " !",
                            callback: function () {
                                GenerateTable("firstload", null);
                                paramex = 'firstload';
                                filter.ListIsActiveId = null;
                                tempid = [];
                            }
                        });
                    }
                    else{
                        var txtError = "";
                        for (var i = 0; i < response.length; i++) {
                            var split = response[i].split('-');
                            txtError = txtError + "Seal Number " + split[1] + ' - ' + split[2] + " from " + split[0] + " already used</br>";
                        }
                        $("#textModalWarning").html("");
                        $("#textModalWarning").append(txtError);
                        $('#warningModal').modal('show');
                    }
                }
            }
        });
    }
