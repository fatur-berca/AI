</main>
    <script type="text/javascript">
        var options = {
            valueNames: ['guide-link']
        };

        var assetGuidelineBaseUrl = '@Url.Content("~/assets/Guideline/")';
        //var userList = new List('guideline-list', options);
        function loadData(keyword)
        {
            //var keyword = txtSearch.val();
            $('.guideline_content').html('');
            $('#guideline_list').html('');
            //$('.div_container').hide();

            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

            $.ajax({
                //beforeSend: function () { $('#notificationModal').modal('show'); },
                complete: function () { dialog.modal('hide'); },
                type: "POST",
                url: '@Url.Action("GetListForGuidelinesByDescAndKeyword")',
                datatype: "json",
                data: { 'keyword': keyword },
                success: function (res) {
                    $('#guideline_list').html('');
                    if (Object.keys(res).length > 0) {
                        for (var idx in res) {
                            var r = res[idx];
                            var GuidelineUrl = assetGuidelineBaseUrl + r.Url;
                            var keywords = r.Keywords.split(',');
                            var contentId = '';
                            if (keywords.length > 0) {
                                contentId = keywords[0].toLowerCase().replace(/\s/g, '');
                            }
                            //console.log(contentId);
                            $('#' + contentId).append('<li><a href="' + GuidelineUrl + '" target="_blank">' + (r.PageName) + '</a></li>')
                        }
                        /*
                        $('.div_container ul').each(function () {
                            var obj = $(this).find('li');
                            if (obj.length > 0) {
                                obj.closest('.div_container').show();
                            }
                        });
                        */
                    } else {
                        $('#guideline_list').append('<p>No result found</p>')
                    }
                }
            });
        }

        $(document).ready(function () {
            loadData('');

            $('#txtSearch').on('keyup', function (e) {
                if (e.keyCode == 13) {
                    if ($.trim($(this).val()).length < 2) {
                        $('#notificationModal2').modal('show');
                        return;
                    }
                    loadData($(this).val());
                }
            });
        });
    </script>
</body>
