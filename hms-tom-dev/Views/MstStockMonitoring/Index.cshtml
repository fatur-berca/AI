<script type="text/javascript">
    $(document).ready(function() {
        generateTabelLeadTime();
        generateTabelMappingLocationPercentage();
        generateTabelZoneLocation();
        generateTabelSupportWarehouse();
    });

    //START : BAGIAN LEAD TIME
    var fileleadtime;
    function generateTabelLeadTime() {
        $.ajax({
            url: 'MstStockMonitoring/GetDataLeadTime',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (json) {
                var table = $('#dtMasterLeadTime').DataTable({
                    'destroy': true,
                    data: json,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "autoWidth": false,
                    "iDisplayLength": 25,
                    //aaSorting: [[2, 'desc']],
                    columns: [
                        {
                            "data": "IsActive", "class": "text-center", "render": function (data) {
                                if (data == true)
                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                else
                                    return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>';
                            }
                        },
                        { 'data': 'LocationFrom', 'searchable': true },
                        { 'data': 'LocationTo', 'searchable': true },
                        { 'data': 'VehicleType', 'searchable': true },
                        { 'data': 'LeadTime', 'searchable': true }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                $('#dtMasterLeadTime thead.filters th').each(function (index) {
                    if (index > 0) {
                        var title = $('#dtMasterLeadTime thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });
                table.columns().every(function (index) {
                    $('#dtMasterLeadTime thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible').search(this.value).draw();
                    });
                });
            }
        });
    }

    $("#uploadLeadTime").click(function () {
        $("#btnUploadLead").prop("disabled", true);
        $("#uploadlead").val("");
        $("#uploadlead").jfilestyle('clear');
        fileleadtime = "";
    });
 
    $('#uploadlead').on('change', function (e) {
        $("#btnUploadLead").prop("disabled", false);
        fileleadtime = e.target.files;
    });

    $("#btnUploadLead").click(function () {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...Uploading Data</div>',
            closeButton: false
        });
        var data = new FormData();
        for (var x = 0; x < fileleadtime.length; x++) {
            data.append("fileleadtime", fileleadtime[x]);
        }
        $.ajax({
            type: "POST",
            url: 'MstStockMonitoring/UploadFileLeadTime',
            contentType: false,
            processData: false,
            cache: false,
            data: data,
            success: function (data) {
                dialog.modal('hide');
                if (data.length == 0) {
                    $('#modalsuccess').modal('show'); 
                }
                else {
                    var txtLeadError = "";
                    for (var i = 0; i < data.length; i++) {
                        var split = data[i].toString().split("-");
                        if (split[0] == "LocationFrom") {
                            txtLeadError = txtLeadError + "There is no Location From " + split[1] + " row " + split[2] + " in table master location<br/>";
                        }
                        if (split[0] == "LocationTo") {
                            txtLeadError = txtLeadError + "There is no Location To " + split[1] + " row " + split[2] + " in table master location<br/>";
                        }
                        if (split[0] == "Type") {
                            txtLeadError = txtLeadError + "Vehicle Type empty or null on row " + split[1] + " <br/>";
                        }
                        if (split[0] == "DataExist") {
                            txtLeadError = txtLeadError + "Location From " + split[1] + " To " + split[2] + " Vehicle Type " + split[3] + " row " + split[4] + " already exist<br/>";
                        }
                    }
                    $("#textModalError").html("");
                    $("#textModalError").append(txtLeadError);
                    $('#modalerror').modal('show');
                }
                generateTabelLeadTime();
            },
            error: function (xhr, status, p3, p4) {
                var err = "Error " + " " + status + " " + p3 + " " + p4;
                if (xhr.responseText && xhr.responseText[0] == "{")
                    err = JSON.parse(xhr.responseText).Message;
            }
        });
    });
    //END : BAGIAN LEAD TIME

