                table4.columns().every(function (index) {
                    $('#dtMasterSupportWarehouse thead.filters th:eq(' + index + ') input').on('input', function () {
                        table4.column($(this).parent().index() + ':visible').search(this.value).draw();
                    });
                });
            }
        });
    }

    $("#uploadSupportWare").click(function () {
        $("#btnUploadSupport").prop("disabled", true);
        $("#uploadsupport").val("");
        $("#uploadsupport").jfilestyle('clear');
        filesupportwarehouse = "";
    });

    $('#uploadsupport').on('change', function (e) {
        $("#btnUploadSupport").prop("disabled", false);
        filesupportwarehouse = e.target.files;
    });

    $("#btnUploadSupport").click(function () {
        var data = new FormData();
        for (var x = 0; x < filesupportwarehouse.length; x++) {
            data.append("filesupportware", filesupportwarehouse[x]);
        }
        $.ajax({
            type: "POST",
            url: 'MstStockMonitoring/UploadFileSupportWarehouse',
            contentType: false,
            processData: false,
            cache: false,
            data: data,
            success: function (data) {
                if (data.length == 0) {
                    $('#modalsuccess').modal('show');
                }
                else {
                    var txtSupportError = "";
                    for (var i = 0; i < data.length; i++) {
                        var split = data[i].toString().split("-");
                        if (split[0] == "LocationSource") {
                            txtSupportError = txtSupportError + "There is no Location Source " + split[1] + " row " + split[2] + " in table master location<br/>";
                        }
                        if (split[0] == "LocationSupport") {
                            txtSupportError = txtSupportError + "There is no Location Support " + split[1] + " row " + split[2] + " in table master location<br/>";
                        }
                        if (split[0] == "DataExist") {
                            txtSupportError = txtSupportError + "Location Source " + split[1] + " Location Support " + split[2] + " row " + split[3] + " already exist<br/>";
                        }
                    }
                    $("#textModalError").html("");
                    $("#textModalError").append(txtSupportError);
                    $('#modalerror').modal('show');
                }
                generateTabelSupportWarehouse();
            },
            error: function (xhr, status, p3, p4) {
                var err = "Error " + " " + status + " " + p3 + " " + p4;
                if (xhr.responseText && xhr.responseText[0] == "{")
                    err = JSON.parse(xhr.responseText).Message;
            }
        });
    });
    //END : BAGIAN SUPPORT WAREHOUSE
</script>