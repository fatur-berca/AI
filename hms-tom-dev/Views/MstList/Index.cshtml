
@{
    ViewBag.Title = " Master Data > Dropdown List";
   
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}

@*<div class="title-deck wborder">
    <h4 class="title-page pull-left"> Drop Down List</h4>
</div>*@
<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#inputModal">Add New</button>
    </div>

</div>
<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr>
            
            @*<th hidden>IDField</th>*@
            
            <th width=5% nowrap class="text-center">Active</th>
            <th>List Name</th>
            <th>List Value</th>            
            <th >Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center">Action</th>
           
            
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
           
            @*<th hidden>IDField</th>*@
          
            <th width=5% nowrap class="text-center">Filter</th>
            <th>List Name</th>
            <th>List Value</th>            
            <th >Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center"></th>
          
        </tr>
    </thead>
    @*<tbody class="tbody">*@
</table>

<!-- BEGIN : MODAL INSERTORUPDATE -->
<div class="modal fade" id="inputModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Dropdown List</h4>
            </div>
            <div class="modal-body">
                <div id="fieldChooser" tabindex="1" class="field-chooser">
                    <div class="col-md-12">
                        <form id="newData">
                                <div class="col-md-6" hidden>
                                    <div class="form-group">
                                        <label>InsertOrUpdate</label>
                                        <input type="text" id="InsertOrUpdate" class="form-control">
                                    </div>
                                </div>
                                <div class="col-md-6" hidden>
                                    <div class="form-group">
                                        <label>IDList</label>
                                        <input type="text" id="IDList" class="form-control">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                <div class="form-group">                               
                                    <div class="col-md-24">
                                        <div class="form-group">
                                            <label>List Name</label>
                                            <select class="select2" id="ListName"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-24">
                                        <div class="form-group">
                                            <label>New Value</label>
                                            <input type="text" id="ListValue" class="form-control">
                                        </div>
                                    </div>
                                    <div class="col-md-24">
                                        <div class="form-group">
                                            <label>Active</label>
                                            <select class="form-control" id="Status">
                                                <option value="1">YES</option>
                                                <option value="0">NO</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                </div>
                                <div class="col-md-6" >
                                    <div class="form-group">                               
                                        <label>Existing Value</label>
                                        <ul id="ExistingList" class="list-group-item" style=" height: 200px; overflow-y: scroll"></ul>
                                    </div>
                                </div>
                        </form>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="btnSaveNew">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="setinactive" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Edit Data Confirmation</h4>
            </div>
            <div class="modal-body">
                Are you sure want to Edit Data?
               
            </div>
            <div class="modal-footer">               
                <button type="button" class="btn btn-purple" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" id="btnSaveYes">Yes</button>
                
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/cancel.png" alt="">
                <span>Sorry, the inputted data exists or your connection is lost</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div id="Loading" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">TOM Notification Center</h4>
            </div>
            <div class="modal-body"><img src="assets/images/loading.gif" alt=""><span> Please wait...</span></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>
<!-- END : MODAL INSERTORUPDATE-->

<script type="text/javascript">
    // page   : MasterList
    // author : hakim
    // ticket :
    // date   : 2017-08-11
    $(document).ready(function () {
        //$(function () {
        // BEGIN : GENERAL Logic
        // clear field when click add new btn
        $('#addNew').click(function () {
            resetData();
            generateList();
            generateDropDown();
            $('#InsertOrUpdate').val("INSERT");
        });
        // END : GENERAL Logic
        generateDropDown();
        generateList();
        generateTable();

    });

    $('#inputModal').on('hidden.bs.modal', function () {
        $('#ListName').select2("close");
    });
    
    //global variable
    function resetData() {
        $('#newData')[0].reset();
    }
    
    // BEGIN : JQUERY SELECT TO DataTable
    //call generate table

    $("#ListName").click(function () {
        generateList();
    });
    function generateDropDown() {
        //get a reference to the select element
        $select = $('#ListName');
        //request the JSON data and parse into the select element
        $.ajax({
            url: 'MstList/GetMasterListDrop',
            dataType: 'JSON',
            success: function (data) {
                //clear the current content of the select
                $select.html('');
                //iterate over the data and append a select option
                $select.html('<option value="NULL"></option>').trigger('change');
              
                $.each(data, function (key, val) {
                    $select.append('<option value="' + val.FieldName + '">' + val.FieldName + '</option>');
                })
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select.html('<option value="NULL">none available</option>');
            }
        });
       
    }

    function generateList() {
        //get a reference to the select element
        $ul = $('#ExistingList');
        var active;
        var name = $('#ListName :selected').val();
        //request the JSON data and parse into the select element
        $.ajax({
            url: 'MstList/GetMasterListValue',
            cache: false,
            dataType: 'JSON',
            data: { "FieldName": name },
            success: function (data) {
                //clear the current content of the select
                $ul.html('');
                //iterate over the data and append a select option
               

                $.each(data, function (key, val) {
                    if (val.IsActive == true) {

                        active = "Active";
                    } else {
                        active = "Inactive";
                    }
                    $ul.append('<li value="' + val.FieldValue + '">'  + val.FieldValue +  ' - ' + active  + '</li>');
                });
            },
            error: function () {
                //if there is an error append a 'none available' option
                $ul.html('<li value="NULL">none available</li>');
            }
        });
    }


    //generate table
    function generateTable() {
        $.ajax({
            url: 'MstList/GetMasterList',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (json) {
                var table = $('#dtFilterMaster').DataTable({
                    data: json,
                    "destroy": true,
                    'paging': true,
                    'sort': true,
                    "iDisplayLength": 25,
                    aaSorting: [[4, 'desc']],
                    'searching': true,
                    columns: [
                        
                       {
                           "data": "IsActive", "class": "text-center", "render": function (data) {

                               if (data == true) {

                                   return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                               } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }

                           }
                       },
                        { 'data': 'FieldName', 'searchable': true },
                        { 'data': 'FieldValue', 'searchable': true },                       

                        {
                            render: function ( data, type, row ){
                                // var tes = { data: 'UpdatedDate', } + { data: 'UpdatedBy' };  
                                var date = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                var formatted = date.getFullYear() + "-" +
                                      ("0" + (date.getMonth() + 1)).slice(-2) + "-" +
                                      ("0" + date.getDate()).slice(-2) + " " + date.getHours() + ":" +
                                      date.getMinutes();
                                //var dt = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                //var dtStr = dt.toString();
                                //var date = dtStr.substr(8, 2) + " " + (dtStr.substr(4, 3)) + " " + dtStr.substr(11, 4) + " " + dt.getHours() + ":" +
                                //      dt.getMinutes();
                                var jamtanggal = moment(row['UpdatedDate']).format("DD-MMM-YYYY HH:mm");
                                return '<label hidden>' + row['UpdatedDate'] + '</label>by ' + row['UpdatedBy'] + ' on ' + jamtanggal;
                            }
                        },
                       { 'data': 'UpdatedDate', 'class': 'hidden' },
                         {
                             "data": "IDList", "class": "text-center", "render": function (data) {
                                 return '<div ><a href="#" id="editForm" onclick="return editTable(' + data + ')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a></div>';
                             }
                         }
                        
                        
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 1) && (index <= 4)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                //searching with column on datatable
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });

               
            }

        });
       
    }
    // END : JQUERY SELECT TO DataTable
    
    
    
    // BEGIN : Insert New Data
    $('#btnSaveYes').click(function () {
        edit();
        $('#setinactive').modal('hide');
        $('#inputModal').modal('hide');
    });

    $('#btnSaveNew').click(function () {
        //alert($('#newData').find('input[id="InsertOrUpdate"]').val());
        if ($('#newData').find('input[id="InsertOrUpdate"]').val() == "UPDATE") {
            $('#setinactive').modal('show');
        } else {
            save();          
        }
    });


    function save() {
        //var data = $('#newData').serialize();
        $('#Loading').modal('show');
        var name = $('#ListName :selected').val();
        var value = $('#newData').find('input[id="ListValue"]').val();
        var status = $('#Status :selected').val() == 1 ? true : false;
        var data = {
            "new": [{ "FieldName": name, "FieldValue": value, "IsActive": status }],
            "edit": [{}]
        };

        $.ajax({
            type: 'POST',
            url: 'MstList/InsertList',
            data: data,
            success: function (data) {

                if (data.New) {
                    $.each(data.New, function (k, value) {
                        if (value.ResponseType == "Success") {
                            //DFIS.Helper.ResponseNotification(k.ResponseNotification, "Insert Master List", value.FieldName + " - " + value.FieldValue);
                            //alert(value.ResponseType);
                            //generateTable();
                           
                            generateTable();
                            generateList();
                            $('#ListValue').val("");
                            $('#modalsuccess').modal('show');
                            $('#Loading').modal('hide');
                            
                        } else {
                            $('#modalerror').modal('show');
                            $('#Loading').modal('hide');

                        }

                    });
                }
                //generateTable();
                //$('#modalsuccess').modal('show');
                ////resetData();
                //generateList();
                //// generateDropDown();
                //$('#ListValue').val("");
               
            }
        });
    }

    // END : Insert New Data
    
    // BEGIN : Edit Data
    // get edit data and assign to modal
    function editTable(id) {       
        resetData();      
        $('#InsertOrUpdate').val("UPDATE");
        $('#UserID').attr('disabled', 'disabled');
        $.ajax({
            url: 'MstList/GetDataById',
            type: "GET",
            contentType: "application/json;charset=UTF-8",
            dataType: "json",
            cache: false,
            data: { "IDList": id },
            success: function (json) {             
                $("#ListName").val(json.FieldName).trigger('change');
                $('#IDList').val(json.IDList);         
                $('#ListValue').val(json.FieldValue);
                if (json.IsActive) {
                    $('#Status').val("1");
                } else {
                    $('#Status').val("0");
                }

                $('#inputModal').modal('show');
                generateList();
            }
        });
    }
    
    //update edited data
    function edit() {
        //var data = $('#newData').serialize();
        $('#Loading').modal('show');

        var id = $('#newData').find('input[id="IDList"]').val();
        var name = $('#ListName :selected').val();
        var value = $('#newData').find('input[id="ListValue"]').val();
        var status = $('#Status :selected').val() == 1 ? true : false;
        var data = {
            "new": [{}],
            "edit": [{"IDList" : id, "FieldName": name, "FieldValue": value, "IsActive": status }],
        };

        $.ajax({
            type: 'POST',
            url: 'MstList/InsertList',
            data: data,
            success: function (data) {
                $.each(data.Edit, function (k, value) {
                    if (value.ResponseType == "Success") {
                        //DFIS.Helper.ResponseNotification(k.ResponseNotification, "Insert Master List", value.FieldName + " - " + value.FieldValue);
                        //alert(value.ResponseType);
                        //generateTable();

                        generateTable();

                        $('#modalsuccess').modal('show');
                        resetData();
                        $('#Loading').modal('hide');


                    } else {
                        $('#modalerror').modal('show');
                        $('#Loading').modal('hide');

                    }

                });
             
             
                
            }
        });
    }
    
    // END : Edit Data
</script>
    


