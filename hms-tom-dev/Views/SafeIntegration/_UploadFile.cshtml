<!-- Modal -->
<div class="modal fade" id="uploadfile" tabindex="-1" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Upload File</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Month</label>
                            <select class="form-control" id="listMonthsUpload" name="listMonthsUpload">
                                <option value="1">Jan</option>
                                <option value="2">Feb</option>
                                <option value="3">Mar</option>
                                <option value="4">Apr</option>
                                <option value="5">May</option>
                                <option value="6">Jun</option>
                                <option value="7">Jul</option>
                                <option value="8">Aug</option>
                                <option value="9">Sep</option>
                                <option value="10">Oct</option>
                                <option value="11">Nov</option>
                                <option value="12">Dec</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Year</label>
                            <select class="form-control" id="listYearsUpload" name="listYearsUpload"></select>
                        </div>
                    </div>
                    <form id="formUpload">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Upload File</label>
                                <input id="fileInput" type="file" class="filestyle" data-buttonname="btn-primary" data-icon="false" data-buttontext="Browse" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel">
                                <a href="Assets/Download/TemplateExcel/SAFEIntegrationTemplate.xlsx">Download Template</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnUpload" disabled>Upload</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal" id="btnClose">Close</button>               
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    jQuery(function ($) {
        // Generate Dropdown Year
        var currentYear = new Date().getFullYear();

        for (var i = currentYear; i >= currentYear - 5; i--) {
            $("#listYearsUpload").append('<option value="' + i + '">' + i + '</option>');
        }

        $(document).on('change', '#fileInput', function (e) {
            $("#btnUpload").prop("disabled", false);
        });

        $(document).on('click', '#btnUpload', function (e) {
            bootbox.confirm({
                size: "small",
                message: "All data will be replaced by the new files. Are You Sure?",
                buttons: {
                    confirm: {
                        label: 'Upload',
                        className: 'btn-danger'
                    },
                    cancel: {
                        label: 'Cancel',
                        className: 'btn-primary'
                    }
                },
                callback: function (result) {
                    if (result) {
                        Upload();
                    }
                }
            });
        });

    });

    function Upload() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Uploading...</div>',
            closeButton: false
        });

        var uploadfile = $('#fileInput').val();

        var fileInput = document.getElementById('fileInput');

        var fileNameSafe = "";

        var fileSafe = "";

        if (uploadfile) {
            fileNameSafe = fileInput.files[0].name;
            fileSafe = fileInput.files[0];
        }

        var formData = new FormData();
        //Appending each file to FormData object
        formData.append(fileNameSafe, fileSafe);

        var month = $('#listMonthsUpload :selected').val();
        var year = $("#listYearsUpload :selected").val();

        //Creating an XMLHttpRequest and sending
        var xhr = new XMLHttpRequest();

        xhr.open('POST', 'SafeIntegration/Upload');

        xhr.setRequestHeader('X-Year', year);
        xhr.setRequestHeader('X-Month', month);
        xhr.setRequestHeader('X-File-Name', fileNameSafe);

        xhr.send(formData);

        xhr.onreadystatechange = function () {
            if (xhr.readyState == 4) {
                if (xhr.status == 200) {
                    dialog.modal('hide');
                    bootbox.alert({
                        message: '<i class="fa fa-check-circle fa-2x" style="color:green"></i><font class="text-success">  Upload Successfully</font>',
                        size: 'small',
                        callback: function () {
                            generateTable();
                            resetAfterUploaded();
                        }
                    });
                } else {
                    dialog.modal('hide');
                    if (xhr.statusText == "An unknown error occured") {
                        bootbox.alert({
                            message: '<i class="fa fa-times-circle-o fa-2x" style="color:red"></i><font class="text-danger">' + '  ' + 'Upload Failed, Employee in period selected is not found in overtime data </font>',
                            size: 'small'
                        });
                    } else {
                        bootbox.alert({
                            message: '<i class="fa fa-times-circle-o fa-2x" style="color:red"></i><font class="text-danger">' + '  ' + 'Upload Failed ' + xhr.statusText + '</font>',
                            size: 'small'
                        });
                    }
                  
                }
            }
        }
    }

    function resetAfterUploaded() {
        $('#fileInput').val("");
        $('#fileInput').jfilestyle('clear');
        $("#uploadfile").modal("hide");
    }
</script>