@using System.Web.Mvc.Html
@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.General.SafeIntegrationViewModel
@{
    ViewBag.Title = "General Safe Integration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="tab-content">
    <div class="title-deck wmb">
        <div class="button-wrap pull-left">
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Upload)))
            {
                <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#uploadfile" id="btnUploadFile">Upload</button>
            }
            <button class="btn btn-primary" id="btnExport">Export</button>
            <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#customReportModal" id="customReportButton">Custom Report</button>
        </div>
        <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search </b><i class="fa fa-angle-down"></i></a>
    </div>
    <div class="filter-deck nmb">
        <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
            <div class="col-panel wmb wbt">
                <form id="formFilter">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Regional</label>
                            <select class="form-control" id="Regional" onchange="generateDropDown()"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Warehouse Name</label>
                            <select class="form-control" id="WarehouseName"><option>Please select region first</option></select>
                        </div>
                    </div>
                  
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Month</label>
                            @*@Html.DropDownListFor(model => Model.ListMonths,
                        new SelectList(Enumerable.Range(1, 12)
                    .Select(r => new
                    {
                        Text = new DateTime(2000, r, 1).ToString("MMM"),
                        Value = r.ToString()
                    }),
                    "Value", "Text", Model.ListMonths),
                        new { @class = "form-control", @id = "Month" })*@
                            <select class="form-control" id="Month">
                                <option></option>
                                <option value="1">Jan</option>
                                <option value="2">Feb</option>
                                <option value="3">Mar</option>
                                <option value="4">Apr</option>
                                <option value="5">May</option>
                                <option value="6">Jun</option>
                                <option value="7">Jul</option>
                                <option value="8">Aug</option>
                                <option value="9">Sep</option>
                                <option value="10">Oct</option>
                                <option value="11">Nov</option>
                                <option value="12">Dec</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Year</label>
                            @*@Html.DropDownListFor(model => Model.ListYears,
                            new SelectList(Enumerable.Range(0, 5)
                        .Select(r => new
                        {
                            Text = (DateTime.Now.Year + r).ToString(),
                            Value = (DateTime.Now.Year + r).ToString()
                        }),
                        "Value", "Text", Model.ListYears),
                            new { @class = "form-control", @id = "Year" })*@
                            <select class="form-control" id="Year">
                          
                            </select>
                        </div>
                    </div>
                </form>
                <div class="col-md-12">
                    <hr />
                    <button class="btn btn-primary" id="btnSearch">Search</button>
                    <button class="btn btn-purple" id="resetButton">Reset</button>
                </div>
            </div>
        </div>
    </div>
    <table id="dtFilterMaster" class="display table dataTable table-condensed">
        <thead>
            <tr>
                <th>Warehouse ID</th>
                <th>Warehouse Name</th>
                <th>Region</th>
                <th>Observation Date</th>
                <th>Total Safe Behaviour</th>
                <th>Total Unsafe Behaviour</th>
                <th>Total Unseen Behaviour</th>
                <th>Total Entry</th>
                <th>Name</th>
            </tr>
        </thead>
        <thead class="filters">
            <tr class="filter-row">              
                <th>Filter</th>
                <th>Warehouse Name</th>
                <th>Region</th>
                <th>Observation Date</th>
                <th>Total Safe Behaviour</th>
                <th>Total Unsafe Behaviour</th>
                <th>Total Unseen Behaviour</th>
