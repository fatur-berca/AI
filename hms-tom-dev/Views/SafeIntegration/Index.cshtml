                <th>Name</th>
            </tr>
        </thead>
    </table>
</div>

@*Partial View*@
@Html.Action("PartialViewUploadFile")
@Html.Action("PartialViewCustomReport")

<script type="text/javascript">
    // page   : MasterList
    // author : hakim
    // ticket :
    // date   : 2017-08-11

    jQuery(function ($) {
        // BEGIN : GENERAL Logic
        // clear field when click add new btn
        generateTable();
        //generateDropDown();
        generateDropDownRegional();
        GenerateYear();
        $('#Year').prepend('<option></option>').val(null);
        $('#btnSearch').click(function () {
            generateTable();
        });

        $('#btnExport').click(function () {
            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });
            var month = $('#Month :selected').val(),
          year = $('#Year :selected').val(),
          warehousename = $('#WarehouseName :selected').val(),
          regional = $('#Regional :selected').val();
            $.ajax({
                url: '@Url.Action("ExportSafeIntegration")',
                method: 'post',
                dataType: 'json',
                data: { "Month": month, "Year": year, "IDLocation": warehousename, "LocationRegion": regional },
                success: function (data) {
                    console.log(data);
                    window.location.assign("Assets/Download/" + data);
                    dialog.modal('hide');

                }
            });
        });
        $('#resetButton').click(function () {
            $('#Year').val(null);
            $('#Month').val(null);
            $('#WarehouseName').val(null);
            $('#Regional').val(null);
            $('#formFilter')[0].reset();
            generateTable();
        });

      

    });

    function GenerateYear()
    {
     
        var year = (new Date()).getFullYear() - 3;
        var getYear;
        for (i = 1; i < 7 ; i++) {
            getYear = year + i;
            $('#Year').append('<option value="' + getYear + '">' + getYear + '</option>')
        }
       // $select1.val((new Date()).getFullYear());
    }
    function generateDropDown() {
        //get a reference to the select element
        regional = $('#Regional :selected').val();
        $select = $('#WarehouseName');
        //request the JSON data and parse into the select element
        //  $select.html('<option>Please select region first</option>');
        $select.html('<option>Loading...</option>');
        $.ajax({
            type: 'POST',
            url: '@Url.Action("GenerateDropDownForSafeIntegration")',
            dataType: 'JSON',
            cache: false,
            data: { "id": regional } ,
            success: function (data) {
                //clear the current content of the select
                $select.html('');
                //iterate over the data and append a select option
                $select.append('<option></option>');
                $.each(data, function (key, val) {
                    $select.append('<option value="' + val.IDLocation + '">' + val.IDLocation + " - " + val.LocationName + '</option>');
                })
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select.html('<option value="NULL">none available</option>');
            }
        });
    }

    function generateDropDownRegional() {
        //get a reference to the select element
        $select1 = $('#Regional');
        //request the JSON data and parse into the select element
        $.ajax({
            type: 'POST',
            url: '@Url.Action("GenerateRegionDrop")',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                //clear the current content of the select
                $select1.html('');
                //iterate over the data and append a select option
                $select1.append('<option></option>');
                $.each(data, function (key, val) {
                    $select1.append('<option value="' + val.LocationName + '">' + val.IDLocation + " - " + val.LocationName + '</option>');
                })
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select1.html('<option value="NULL">none available</option>');
            }
        });
    }

    function generateTable() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        var month = $('#Month :selected').val(),
            year = $('#Year :selected').val(),
            warehousename = $('#WarehouseName :selected').val(),
            regional = $('#Regional :selected').val();
        $.ajax({
            url: '@Url.Action("GetSafeIntegration")',
            method: 'get',
            dataType: 'json',
            cache : false,
            data: { "Month": month, "Year": year, "IDLocation": warehousename, "LocationRegion": regional },
            success: function (json) {
                dialog.modal('hide');
                var table = $('#dtFilterMaster').DataTable({
                    data: json,
                    "destroy": true,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "lengthMenu": [[25, 50, 100, -1], [25, 50, 100, 'All']],
                    columns: [
                        { 'data': 'IDLocation', 'searchable': true },
                        { 'data': 'LocationName', 'searchable': true },
                        { 'data': 'LocationRegion', 'searchable': true },
                        {
                            render: function (data, type, row) {
                                // var tes = { data: 'UpdatedDate', } + { data: 'UpdatedBy' };  
                                var date = new Date(parseInt(row['EntryDate'].substr(6)));
                                var formatted = date.getFullYear() + "-" +
                                    ("0" + (date.getMonth() + 1)).slice(-2) + "-" +
                                    ("0" + date.getDate()).slice(-2) + " " + date.getHours() + ":" +
                                    date.getMinutes();
                                //var dt = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                //var dtStr = dt.toString();
                                //var date = dtStr.substr(8, 2) + " " + (dtStr.substr(4, 3)) + " " + dtStr.substr(11, 4) + " " + dt.getHours() + ":" +
                                //      dt.getMinutes();
                                var jamtanggal = moment(row['EntryDate']).format("DD-MMM-YYYY HH:mm");
                                return  jamtanggal;
                            }
                        },
                        { 'data': 'TotalSafeEntry', 'searchable': true },
                        { 'data': 'TotalUnsafeEntry', 'searchable': true },
                        { 'data': 'TotalUnseenEntry', 'searchable': true },
                        { 'data': 'TotalEntry', 'searchable': true },
                        { 'data': 'FormalName', 'searchable': true }                     
                       
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 0) && (index <= 11)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                //searching with column on datatable
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('keyup change', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });
            }
        });
    }
</script>
