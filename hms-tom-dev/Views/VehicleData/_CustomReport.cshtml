@using EnumHelper = DFIS.Utils.EnumHelper
@{
    var listUserRole = ViewBag.ListUserRole;
}

<!-- Custom Report Modal Dialog -->
<div class="modal fade" id="customReportModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Custom Report</h4>
            </div>
            <div class="modal-body custom-report">
                <div class="row label-top">
                    <div class="col-md-6">
                        <label>Column Set</label>
                    </div>
                    <div class="col-md-6">
                        <label class="dis">Displayed Columns</label>
                        <select id="layoutSelect" class="form-control">
                            <option value="">Loading...</option>
                        </select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div id="fieldChooser" tabindex="1" class="field-chooser form-group">
                    <div id="sourceFields" class="source">
                        <div class="ui-draggable" data-field="VendorName">Vendor Name</div>
                        <div class="ui-draggable" data-field="IDPoliceRegNumber">Police Registration Number</div>
                        <div class="ui-draggable" data-field="ManufacturingYear">Manufacturing Year</div>
                        <div class="ui-draggable" data-field="Karoseri">Karoseri</div>
                        <div class="ui-draggable" data-field="Merk">Unit Brand</div>
                        <div class="ui-draggable" data-field="Type">Unit Type</div>
                        <!--div data-field="Model">Model</div-->
                        <div class="ui-draggable" data-field="Cargo">Cargo</div>
                        <div class="ui-draggable" data-field="VehicleIdentityNumber">Vehicle Identity Number</div>
                        <!--div data-field="EngineNumber">Engine Number</div-->
                        <div class="ui-draggable" data-field="BaseTown">BaseTown</div>
                        <div class="ui-draggable" data-field="STNKValidityPeriod">STNK Expired Date</div>
                        <div class="ui-draggable" data-field="GPS">GPS</div>
                        <div class="ui-draggable" data-field="AttachmentSTNK">Attachment STNK</div>
                        <div class="ui-draggable" data-field="AttachmentFrontView">Attachment Front View</div>
                        @*<div data-field="AttachmentPhotoTwo">Attachment Photo Two</div>*@
                        <div class="ui-draggable" data-field="AttachmentSideView">Attachment Side View</div>
                        <div class="ui-draggable" data-field="IsActive">Is Active</div>
                        @*<div data-field="Status">Status</div>*@
                        <div class="ui-draggable" data-field="CreatedBy">Created By</div>
                        <div class="ui-draggable" data-field="CreatedDate">Created Date</div>
                        <div class="ui-draggable" data-field="UpdatedBy">Updated By</div>
                        <div class="ui-draggable" data-field="UpdatedDate">Updated Date</div>
                        @*<div data-field="Remarks">Remarks</div>*@
                    </div>
                    <div class="button-column">
                        <div>
                            <input class="btn btn-info mini" type="button" id="left" value="<">
                            <input class="btn btn-info mini" type="button" id="right" value=">">
                        </div>
                    </div>
                    <div id="destinationFields" class="destination"></div>
                </div>
                <div class="opt-bot">
                    <div class="row">
                        <div class="col-md-6">
                            <input class="btn btn-info amr" type="button" id="rightall" value=">>">
                            <input class="btn btn-info" type="button" id="leftall" value="<<">
                        </div>
                        <div class="col-md-6">
                            <input class="btn btn-info" type="button" id="saveLayoutButton" value="Save Layout">
                            <input type="text" class="form-control" id="layoutName">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @foreach (var x in listUserRole)
                {
                    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
                    {
                        <div class="form-group pull-left">
                            <div class="checkbox-deck">
                                <input type="checkbox" id="chkGlobalCustomReport">
                                <label for="chkGlobalCustomReport"></label>
                            </div>
                            <span class="checkbox-deck-span">Global Custom Report</span>
                        </div>
                    }
                }
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
                {
                    <button class="btn btn-primary" id="exportCustomReport">Export</button>
                }
                <button class="btn btn-purple" data-dismiss="modal">Close</button>                
            </div>
        </div>
    </div>
</div>

<style>
    .fc-selected {
        background-color: #f39814 !important;
    }
</style>

<script type="text/javascript">
    $("#fieldChooser .ui-draggable").prop("draggable", true);
    $("#fieldChooser").fieldChooser($("#sourceFields"), $("#destinationFields"));

    $("#fieldChooser .ui-draggable").on("dragstart", function (ev) {
        $(this).addClass("fc-selected");
        ev.originalEvent.dataTransfer.setData("text", "COPY");
    });
    $("#sourceFields,#destinationFields").on("dragover", function (ev) {
        ev.originalEvent.preventDefault();
    });
    $("#sourceFields,#destinationFields").on("drop", function (ev) {
        var data = ev.originalEvent.dataTransfer.getData("text");
        if (data == "COPY")
            moveItems("#" + $(ev.originalEvent.srcElement).parent().attr("id"), "#" + $(this).attr("id"));
        $("#fieldChooser .ui-draggable").removeClass("fc-selected");
    });
    $("#destinationFields, #sourceFields").on("dragover", function (ev) {
        ev.originalEvent.preventDefault();
    });
    $("#destinationFields, #sourceFields").on("drop", function (ev) {
        var data = ev.originalEvent.dataTransfer.getData("text");
        if (data == "COPY")
            moveItems("#" + $(ev.originalEvent.srcElement).parent().attr("id"), "#" + $(this).attr("id"));
        $("#fieldChooser .ui-draggable").removeClass("fc-selected");
    });

    jQuery(function ($) {
        $(document).on('click', '#saveLayoutButton', function (e) {
            saveLayout();
            e.preventDefault();
        });

        $(document).on('click', '#left', function (e) {
            moveItems('#destinationFields', '#sourceFields');
            e.preventDefault();
        });

        $(document).on('click', '#right', function (e) {
            moveItems('#sourceFields', '#destinationFields');
            e.preventDefault();
        });

        $(document).on('click', '#leftall', function (e) {
            moveAllItems('#destinationFields', '#sourceFields');
            e.preventDefault();
        });

        $(document).on('click', '#rightall', function (e) {
            moveAllItems('#sourceFields', '#destinationFields');
            e.preventDefault();
        });

        $(document).on('click', '#customReportButton', function (e) {
            $("#layoutName").val('');
            $('#chkGlobalCustomReport').prop('checked', false);
            generateLayoutSelect();
            moveAllItems('#destinationFields', '#sourceFields');
            e.preventDefault();
        });

        $('#layoutSelect').on('change', function () {
            for (var j = 1; j < layoutIsGlobal.length; j++) {
                if ($('#layoutSelect option:selected').text() == layoutIsGlobal[j].LayoutName) {
                    $('#chkGlobalCustomReport').prop('checked', layoutIsGlobal[j].isGlobal);
                }
            }
            var sourceFieldNames = [
                { 'field': 'VendorName', 'label': 'Vendor Name' },
                { 'field': 'IDPoliceRegNumber', 'label': 'Police Registration Number' },
                { 'field': 'ManufacturingYear', 'label': 'Manufacturing Year' },
                { 'field': 'Karoseri', 'label': 'Karoseri' },
                { 'field': 'Merk', 'label': 'Unit Brand' },
                { 'field': 'Type', 'label': 'Unit Type' },
                /*{'field': 'Model', 'label': 'Model'},*/
                { 'field': 'Cargo', 'label': 'Cargo' },
                { 'field': 'VehicleIdentityNumber', 'label': 'Vehicle Identity Number' },
                /*{'field': 'EngineNumber', 'label': 'Engine Number'},*/
                { 'field': 'BaseTown', 'label': 'BaseTown' },
                { 'field': 'STNKValidityPeriod', 'label': 'STNK Expired Date' },
                { 'field': 'GPS', 'label': 'GPS' },
                //{ 'field': 'Status', 'label': 'Status' },
                {'field': 'AttachmentSTNK', 'label': 'Attachment STNK'},
                {'field': 'AttachmentFrontView', 'label': 'Attachment Front View'},
                { 'field': 'AttachmentSideView', 'label': 'Attachment Side View' },
                //{'field': 'AttachmentPhotoThree', 'label': 'Attachment Photo Three'},
                { 'field': 'IsActive', 'label': 'Is Active' },
                { 'field': 'CreatedBy', 'label': 'Created By' },
                { 'field': 'CreatedDate', 'label': 'Created Date' },
                { 'field': 'UpdatedBy', 'label': 'Updated By' },
                { 'field': 'UpdatedDate', 'label': 'Updated Date' },
                //{ 'field': 'Remarks', 'label': 'Remarks' }
            ],
            sourceFields = '',
            destinationFieldNames = this.value != "" ? this.value.split(',') : "",
            destinationFields = '',
            destinationfieldLabels = [];

            for (i = 0; i < sourceFieldNames.length; ++i) {
                if (jQuery.inArray(sourceFieldNames[i]['field'], destinationFieldNames) == -1) {
                    // the element is not in the array
                    sourceFields = sourceFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + sourceFieldNames[i]['field'] + "'>" + sourceFieldNames[i]['label'] + "</div>";
                } else {
                    destinationfieldLabels[sourceFieldNames[i]['field']] = sourceFieldNames[i]['label'];
                }
            }
            $("#fieldChooser #sourceFields").html(sourceFields);

            for (i = 0; i < destinationFieldNames.length; ++i) {
                destinationFields = destinationFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + destinationFieldNames[i] + "'>" + destinationfieldLabels[destinationFieldNames[i]] + "</div>";
            }
            $("#fieldChooser #destinationFields").html(destinationFields);
        });

        $(document).on('click', '#exportCustomReport', function (e) {
            exportCustomToExcel();
            e.preventDefault();
        });
    });

    var layoutIsGlobal = [];

    function moveItems(origin, dest) {
        jQuery(origin).find('.fc-selected').appendTo(dest);
    }

    function moveAllItems(origin, dest) {
        jQuery(origin).children().appendTo(dest);
    }

    function generateLayoutSelect() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        var firstLayout = "",
            thenLayout = "",
            k = 0;

        jQuery.ajax({
            url: '@Url.Action("GetLayouts", "CustomReportState")',
            method: 'post',
            dataType: 'json',
            data: { "PageName": "VehicleData" },
            success: function (response) {
                dialog.modal("hide");

                var layoutName = '',
                    options = '';

                if (parseInt(response.length) > 0) {
                    options = "<option value='";
                    
                    for (var i = 0; i < response.length; ++i) {
                        if (layoutName != response[i].LayoutName) {
                            thenLayout = response[i].LayoutName;
                            ++k;
                            layoutIsGlobal[k] = { "isGlobal": response[i].IsGlobal, "LayoutName": response[i].LayoutName };
                            
                            options = options + "'>" + layoutName + "</option><option value='" + response[i].FieldName;
                            layoutName = response[i].LayoutName;
                        } else {

                            options = options + "," + response[i].FieldName;
                        }
                    }
                    options = options + "'>" + layoutName + "</option>";
                    $("#layoutSelect").html(options);
                } else {
                    options = options + "'<option></option>";
                    jQuery("#layoutSelect").html(options);
                }
            }
        });
    }

    function saveLayout() {
        var nonvalid = false;

        if ($("#layoutName").val() == "") { //layout name
            $("#layoutName").css('border-color', 'orange');
            nonvalid = true;
        } else {
            $("#layoutName").css('border-color', '#ccc');
        }

        if (nonvalid == true) {
            alertCrPleaseFill();

            return false;
        } else {
            var fieldNames = '',
                layoutName = $("#layoutName").val(),
                isGlobal = ($("#chkGlobalCustomReport").prop('checked')) ? true : false;

            $('#destinationFields .fc-field').each(function () {
                fieldNames = fieldNames + $(this).data('field') + ',';
            });
            fieldNames = fieldNames.slice(0, -1);

            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

            jQuery.ajax({
                url: '@Url.Action("InsertRecords", "CustomReportState")',
                method: 'post',
                dataType: 'json',
                data: { "layoutName": layoutName, "fieldNames": fieldNames, "pageName": "VehicleData", "isGlobal": isGlobal },
                success: function (response) {
                    if (response == "Success") {
                        if (isGlobal) {
                            SaveChangesButton(dialog);
                        } else {
                            alertCrSaveSuccess();
                            dialog.modal('hide');
                            $("#chkGlobalCustomReport").prop('checked', false);
                        }
                    } else if (response == "NoLayoutName") {
                        alertCrPleaseFill();
                    }

                    if ($("#layoutName").val() != $("#layoutSelect option:selected").text()) {
                        $("#layoutSelect").append('<option value="' + fieldNames + '">' + layoutName + '</option>').val(fieldNames);
                    }
                }
            });
            return true;
        }
    }

    function SaveChangesButton(dialog) {
        var selectedLayoutName = $("#layoutName").val(),
            destinationFields = '',
            isGlobal = ($("#chkGlobalCustomReport").prop('checked')) ? true : false;

        $('#destinationFields .fc-field').each(function () {
            destinationFields = destinationFields + $(this).data("field") + ',';
        });
        destinationFields = destinationFields.slice(0, -1);

        $.ajax({
            url: '@Url.Action("SaveSelectedLayout", "CustomReportState")',
            method: 'post',
            dataType: 'json',
            data: { "layoutName": selectedLayoutName, "fieldNames": destinationFields, "pageName": "VehicleData", "isGlobal": isGlobal },
            success: function (response) {
                dialog.modal('hide');
                if (response == "Success") {
                    alertCrSaveSuccess();
                } else {
                    alertCrSaveFail();
                }
            }
        });
    }

    function exportCustomToExcel() {
        var UnitBrand = jQuery('#UnitBrand :selected').val(),
            ManufacturingYears = ($("#ManufacturingYear").val()) ? $("#ManufacturingYear").val().join(",") : "",
            Basetown = jQuery('#Basetown :selected').val(),
            PoliceRegNumbers = ($("#PoliceRegNumber").val()) ? $("#PoliceRegNumber").val().join(",") : "",
            includeInActive = ($('#deleted').length > 0) ? (($('#all').prop("checked") == true ? 1 : 0)) : null,
            columns = "",
            dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

        $('#destinationFields .fc-field').each(function () {
            columns = columns + $(this).text() + ',';
        });
        columns = columns.slice(0, -1);

        jQuery.ajax({
            url: '@Url.Action("ExportToExcel")',
            method: 'post',
            dataType: 'json',
            data: {
                "Columns": columns,
                "Merk": UnitBrand,
                "ManufacturingYears": ManufacturingYears,
                "Basetown": Basetown,
                "IDPoliceRegNumbers": PoliceRegNumbers,
                "IncludeInActive": includeInActive
            },
            success: function (response) {
                window.location.assign("Assets/Download/" + response);
                dialog.modal('hide');
            }
        });
    }
</script>
