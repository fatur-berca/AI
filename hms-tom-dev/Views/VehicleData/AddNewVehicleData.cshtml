                            <label for="STNKValidityPeriod">STNK Expired Date</label>
                            <input type="text" class="form-control datepicker" id="STNKValidityPeriod">
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="GPS">GPS</label>
                            <select class="form-control" id="GPS">
                                <option value=""></option>
                                <option value="Yes">Yes</option>
                                <option value="No">No</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="VehicleIdentityNumber">Vehicle Identity Number</label>
