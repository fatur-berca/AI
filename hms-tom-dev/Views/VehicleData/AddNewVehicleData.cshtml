    function checkRegNo() {
        var temp = $('#IDPoliceRegNumber').val();
        temp = temp.toUpperCase();
        $('#IDPoliceRegNumber').val(temp);

        if (temp.match(/^([a-zA-Z]{1,2}-[0-9]{4}-[a-zA-Z]{1,3})$/) === null) {
            bootbox.alert({
                title: "TOM Notification Center",
                message: "<div class='text-left'><img src='../assets/images/danger.png' alt=''> Police Registration Number Format is Incorrect.<br/> <b>Example</b>: L-XXXX-EF</div>",
                closeButton: false
            });
            return false;
        }
        return true;
    }

    function Save() {

        if (!checkRegNo()) return;

        var IDPoliceRegNumber = $('#IDPoliceRegNumber').val(),
            ManufacturingYear = $('#ManufacturingYear').val(),
            Karoseri = $('#Karoseri').val(),
            Merk = $('#Merk :selected').val(),
            Type = $('#Type').val(),
            Cargo = $('#Cargo :selected').val(),
            BaseTown = $('#BaseTown :selected').val(),
            STNKValidityPeriod = $('#STNKValidityPeriod').val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
            GPS = $('#GPS :selected').val(),
            Vendor = $('#Vendor :selected').val(),
            Status = $('#Status :selected').val(),
            VehicleIdentityNumber = $('#VehicleIdentityNumber').val(),
            AttachmentPhoto = $('#AttachmentPhoto').val(),
            AttachmentPhotoTwo = $('#AttachmentPhotoTwo').val(),
            AttachmentPhotoThree = $('#AttachmentPhotoThree').val(),
            AttachmentSTNK = $('#AttachmentSTNK').val(),
            notvalid = false;

        // validation
        if (IDPoliceRegNumber == "") {
            $('#IDPoliceRegNumber').css('border-color', 'orange');
            notvalid = true;
        } else {
            $('#IDPoliceRegNumber').css('border-color', '#ccc');
        }
        if (Type == "") {
            $('#Type').css('border-color', 'orange');
            notvalid = true;
        } else {
            $('#Type').css('border-color', '#ccc');
        }
        if (BaseTown == "") {
            $('#BaseTown').css('border-color', 'orange');
            notvalid = true;
        } else {
            $('#BaseTown').css('border-color', '#ccc');
        }
        if (STNKValidityPeriod == "") {
            $('#STNKValidityPeriod').css('border-color', 'orange');
            notvalid = true;
        } else {
            $('#STNKValidityPeriod').css('border-color', '#ccc');
        }
        if (Vendor == "") {
            $('#Vendor').prev().children().css('border-color', 'orange');
            notvalid = true;
        } else {
            $('#Vendor').prev().children().css('border-color', '#ccc');
        }

        if (notvalid == true) {
            bootbox.alert({
                title: "TOM Notification Center",
                message: '<div><img src="../assets/images/danger.png" alt=""> Please fill the yellow field(s)! </div>',
                backdrop: true
            });
            return false;
        } else {
            var msg = "Changes have been made to this record, Do you want to Save these changes?";
            if (typeof getUrlParameter('IDPoliceRegNumber') === "undefined") {
                msg = "Do you want to save the data? </br> Press Ok to continue, or Cancel to stay on the current page";
            }

            bootbox.confirm({
                title: "TOM Notification Center",
                message: msg,
                buttons: {
                    confirm: {
                        label: 'Ok',
                        className: 'btn btn-primary'
                    },
                    cancel: {
                        label: 'Cancel',
                        className: 'btn btn-purple'
                    }
                },
                callback: function (result) {
                    if (result) {
                        var dialog = bootbox.dialog({
                            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                            closeButton: false
                        });

                        // check record
                        $.ajax({
                            url: '@Url.Action("GetTransportVehicleDatas")',
                            method: 'get',
                            dataType: 'json',
                            data: {
                                "IDPoliceRegNumber": IDPoliceRegNumber,
                                "IDVendor": Vendor
                            },
                            success: function (reponse) {
                                if ( reponse.length && ($("#state").val() == "create") ) {
                                    $('#IDPoliceRegNumber').css('border-color', 'red');
                                    $('#Vendor').prev().children().css('border-color', 'red');
                                    dialog.modal('hide');
                                    alertSaveErrorDuplicate();
                                } else {
                                    $('#IDPoliceRegNumber').css('border-color', '#ccc');
                                    $('#Vendor').prev().children().css('border-color', '#ccc');
                                    // create and or update
                                    $.when(uploadPhoto(), uploadPhotoTwo(), uploadPhotoThree(), uploadSTNK()).done(function (a1, a2, a3, a4) {
                                        var newRecord = {
                                            "IDPoliceRegNumber": IDPoliceRegNumber,
                                            "ManufacturingYear": ManufacturingYear,
                                            "Karoseri": Karoseri,
                                            "Merk": Merk,
                                            "Type": Type,
                                            "Cargo": Cargo,
                                            "BaseTown": BaseTown,
                                            "STNKValidityPeriod": STNKValidityPeriod,
                                            "GPS": GPS,
                                            "IDVendor": Vendor,
                                            "Status": Status,
                                            "VehicleIdentityNumber": VehicleIdentityNumber,
                                            "IsActive": true
                                        };
                                        newRecord["AttachmentPhoto"] = $("#AttachmentPhotoPath").val();
                                        newRecord["AttachmentPhotoTwo"] = $("#AttachmentPhotoTwoPath").val();
                                        newRecord["AttachmentPhotoThree"] = $("#AttachmentPhotoThreePath").val();
                                        newRecord["AttachmentSTNK"] = $("#AttachmentSTNKPath").val();

                                        insert(newRecord, dialog);
                                    });
                                }
                            }
                        });
                    }
                }
            });
        }
    }

    function insert(record, dialog) {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("UpdateRecord")',
            data: record,
            success: function (response) {
                dialog.modal("hide");
                jQuery('#cancel1, #cancel2, #cancel3').hide();

                bootbox.alert({
                    title: "TOM Notification Center",
                    message: '<div><img src="../assets/images/checked.png" alt=""> Data has been successfully saved to the database! </div>',
                });

                if (typeof getUrlParameter('IDPoliceRegNumber') === "undefined") { // create
                    //jQuery('#newData')[0].reset();
                    //jQuery("#AttachmentPhotoPath").val('');
                    //jQuery("#AttachmentPhotoTwoPath").val('');
                    //jQuery("#AttachmentPhotoThreePath").val('');
                    //jQuery("#AttachmentSTNKPath").val('');
                    //jQuery("#AttachmentPhotoThumb, #AttachmentPhotoTwoThumb, #AttachmentPhotoThreeThumb, #AttachmentSTNKThumb").attr("style", "background: url('../assets/images/no-image-available.png') no-repeat center center; background-size: contain; width: 282px; height: 282px;");
                    //jQuery(".AttachmentPhotoThumb, .AttachmentPhotoTwoThumb, .AttachmentPhotoThreeThumb, .AttachmentSTNKThumb").attr("href", "../assets/images/no-image-available.png");
                    //jQuery('#EditButton').prop("disabled", true);
                    //jQuery('#SaveButton').prop("disabled", false);

                    @*window.location.replace('@Url.Action("../VehicleData")');*@
                    window.location.href = "@Url.Action("AddNewVehicleData")?IDPoliceRegNumber=" + $('#IDPoliceRegNumber').val() + "&IDVendor=" + $('#Vendor :selected').val() + "";
                } else { // update
                    jQuery('#EditButton').prop("disabled", false);
                    jQuery('#SaveButton').prop("disabled", true);
                    jQuery('#newData input, #newData select').prop("disabled", true);
                }
            },
            error: function (jqXHR, exception) {
                dialog.modal('hide');
                jQuery('#cancel1, #cancel2, #cancel3').hide();
                jQuery('#EditButton').prop("disabled", true);
                jQuery('#SaveButton').prop("disabled", false);
                alertSaveFail();
            }
        });
    }

    function generateDropDown(FieldName, IDSelector) {
        return jQuery.ajax({
            url: '@Url.Action("GetMasterListByFieldName")',
            dataType: 'JSON',
            cache: false,
            data: { 'FieldName': FieldName },
            success: function (response) {
                var data = response.sort(function (a, b) { return a - b }),
                    options = '<option value=""></option>';
                jQuery.each(data, function (key, val) {
                    options = options + '<option value="' + val.FieldValue + '">' + val.FieldValue + '</option>';
                });
                jQuery('#' + IDSelector).html(options);
            },
            error: function () {
                jQuery('#' + IDSelector).html('<option value="NULL">none available</option>');
            }
        });
    }

    function generateDropDownVendor() {
        return jQuery.ajax({
            url: '@Url.Action("GetVendor")',
            dataType: 'JSON',
            cache: false,
            success: function (response) {
                var data = response.sort(function (a, b) { return a - b }),
                    options = '<option value=""></option>';
                jQuery.each(data, function (key, val) {
                    options = options + '<option value="' + val.IDVendor + '">' + val.VendorName + '</option>';
                });

                jQuery('#Vendor').html(options);
            },
            error: function () {
                jQuery('#' + IDSelector).html('<option value="NULL">none available</option>');
            }
        });
    }

    function generateDropdownKaroseri() {
        return generateDropDown("Karoseri", "Karoseri");
    }

