                    </div>
                    <div class="clearfix"></div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="Karoseri">Karoseri</label>
                            <select class="form-control" id="Karoseri"><option>Loading...</option></select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="Merk">Unit Brand</label>
                            <select class="form-control" id="Merk"><option>Loading...</option></select>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-md-6">
                        <div class="form-group">
