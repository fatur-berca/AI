@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "Vehicle Data Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="title-deck wmb">
            <div class="button-wrap pull-left">
                <button class="btn btn-purple" onclick="window.location.href = '@Url.Action("../VehicleData")'">Back</button>
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Edit)))
                {
                    <button class="btn btn-primary" id="EditButton">Edit</button>
                }
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Save)))
                {
                    <button class="btn btn-primary" id="SaveButton">Save</button>
                }
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <form id="newData">
            <div class="box">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="IDPoliceRegNumber" id="IDPoliceRegNumberLabel">Police Registration Number</label>
                            <input type="text" class="form-control" id="IDPoliceRegNumber" maxlength="13">
                            <input type="hidden" id="state" value="create">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
