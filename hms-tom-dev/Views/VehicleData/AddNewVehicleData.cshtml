    }

    function generateDropDownBaseTown() {
        return generateDropDown("BaseTown", "BaseTown");
    }

    function loadRecord(IDPoliceRegNumber, IDVendor, dialog) {
        jQuery('#EditButton').prop("disabled", false);
        jQuery('#SaveButton').prop("disabled", true);

        jQuery.ajax({
            url: '@Url.Action("GetDataById")',
            dataType: 'JSON',
            cache: false,
            data: {
                'IDPoliceRegNumber': IDPoliceRegNumber,
                'IDVendor': IDVendor
            },
            success: function (response) {
                //var createdDate = moment(Number(response.CreatedDate.match(/\d+/)[0])).format('DD/MM/YYYY');
                //setBtnEdit(createdDate, null);

                $("#IDPoliceRegNumber").val(response.IDPoliceRegNumber);
                $("#IDPoliceRegNumberLabel").html("Police Registration Number (Read Only)");
                $("#ManufacturingYear").val(response.ManufacturingYear);
                $("#Karoseri").val(response.Karoseri);
                $("#Type").val(response.Type);
                $('#STNKValidityPeriod').val(moment(Number(response.STNKValidityPeriod.match(/\d+/)[0])).format('DD/MM/YYYY'));
                $("#VehicleIdentityNumber").val(response.VehicleIdentityNumber);
                $("#GPS").val(response.GPS);
                $("#Vendor").select2('val',response.IDVendor);
                $("#Status").val(response.Status);
                $("#Merk").val(response.Merk);
                $("#Cargo").val(response.Cargo);
                $("#BaseTown").val(response.BaseTown);

                if (response.AttachmentPhoto) {
                    $("#AttachmentPhotoThumb").attr("style", "background: url('" + response.AttachmentPhoto.replace("~", "..") + "') no-repeat center center; background-size: contain; width: 100%; height: 282px;");
                    $(".AttachmentPhotoThumb").attr("href", response.AttachmentPhoto.replace("~", ".."));
                }
                if (response.AttachmentPhotoTwo) {
                    $("#AttachmentPhotoTwoThumb").attr("style", "background: url('" + response.AttachmentPhotoTwo.replace("~", "..") + "') no-repeat center center; background-size: contain; width: 100%; height: 282px;");
                    $(".AttachmentPhotoTwoThumb").attr("href", response.AttachmentPhotoTwo.replace("~", ".."));
                }
                if (response.AttachmentPhotoThree) {
                    $("#AttachmentPhotoThreeThumb").attr("style", "background: url('" + response.AttachmentPhotoThree.replace("~", "..") + "') no-repeat center center; background-size: contain; width: 100%; height: 282px;");
                    $(".AttachmentPhotoThreeThumb").attr("href", response.AttachmentPhotoThree.replace("~", ".."));
                }
                if (response.AttachmentSTNK) {
                    $("#AttachmentSTNKThumb").attr("style", "background: url('" + response.AttachmentSTNK.replace("~", "..") + "') no-repeat center center; background-size: contain; width: 100%; height: 282px;");
                    $(".AttachmentSTNKThumb").attr("href", response.AttachmentSTNK.replace("~", ".."));
                }

                $("#AttachmentPhotoPath").val(response.AttachmentPhoto);
                $("#AttachmentPhotoTwoPath").val(response.AttachmentPhotoTwo);
                $("#AttachmentPhotoThreePath").val(response.AttachmentPhotoThree);
                $("#AttachmentSTNKPath").val(response.AttachmentSTNK);

                $('#newData input, #newData select').prop("disabled", true);
                dialog.modal('hide');
            },
            error: function (jqXHR, exception) {
                dialog.modal('hide');
                alertNoRecord("Police Registration Number equal to " + IDPoliceRegNumber);
            }
        });
    }

    function uploadPhoto() {
        if (window.FormData !== undefined) {
            var filePhoto = $('#AttachmentPhoto').val(),
                attachmentPhoto = document.getElementById('AttachmentPhoto');
            if (filePhoto) {
                var dataAttachmentPhoto = new FormData();
                dataAttachmentPhoto.append("imageFile", attachmentPhoto.files[0]);
                return jQuery.ajax({
                    type: "POST",
                    url: '@Url.Action("UploadPhoto")',
                    contentType: false,
                    processData: false,
                    data: dataAttachmentPhoto,
                    cache: false,
                    success: function (response) {
                        jQuery("#AttachmentPhotoPath").val(response);
                    },
                    error: function () {
                    }
                });
            } else {
                return true;
            }
        }
    }

