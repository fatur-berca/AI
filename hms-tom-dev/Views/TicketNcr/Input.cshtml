    function save() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        var filename;
        if (window.FormData !== undefined) {
  
            var fileUpload = $("#Attachment").get(0);  
            var files = fileUpload.files;  
              
            // Create FormData object  
            var fileData = new FormData();  
  
            // Looping over all files and add it to FormData object  
            for (var i = 0; i < files.length; i++) {  
                fileData.append(files[i].name, files[i]);
                filename = files[i].name;
            }  
              
            // Adding one more key to FormData object  
           fileData.append('username', 'Manas');  
           var ticketnumber;
           if(document.getElementById('NonTicket').checked) {
               ticketnumber = "NONTIK";
           } else {
               ticketnumber = "TIK";
           }
                      
           var ticketcategory = $('#TicketCategory  :selected').val();
           var ticketqty = document.getElementById('TicketQty').value;
           var location = document.getElementById('Location').value;
           var vendorname = $('#VendorName  :selected').val();
           var vehicleplatenumber = document.getElementById('VehiclePlateNumber').value;
           var offendername = document.getElementById('OffenderName').value;
           var offenderrole = $('#OffenderRole :selected').val();
           var offenderage = document.getElementById('OffenderAge').value;
           var remarkticket = document.getElementById('RemarkTicket').value;
           var attachment = filename;
           var CorrectiveDate = moment(document.getElementById('CorrectiveDate').value).format("YYYY-MM-DD HH:mm");
           var data = {
               "new": [{
                   "TicketNumber": ticketnumber, "TicketCategory": ticketcategory, "TicketQuantity": ticketqty, "Location": location, "IDVendor": vendorname,
                   "PoliceRegNumber": vehicleplatenumber, "OffenderName": offendername, "OffenderRole": offenderrole, "OffenderAge": offenderage, "RemarksTicket": remarkticket,
           
                   "strCorrectiveActionDate": CorrectiveDate,"Attachment": attachment, "IsActive": true
               }],
               "edit": [{}]
           };
          

           if (  ticketcategory == null ||  location == null || vendorname == null  || CorrectiveDate ==  null ||  offenderrole == null) {
               $('#modalerror1').modal('show');

               dialog.modal('hide');
           } else if (ticketcategory == '' || location == '' || vendorname == '' || CorrectiveDate == '' || offenderrole == '') {
               $('#modalerror1').modal('show');

               dialog.modal('hide');
           } else {
               $.ajax({
                   url: '@Url.Action("Upload", "TicketNcr")',
                   type: "POST",
                   contentType: false, // Not to set any content header  
                   processData: false, // Not to process data  
                   data: fileData,
                   success: function (result) {
                       // dialog.modal('hide');
                   },
                   error: function (err) {
                       //alert(err.statusText);
                       alert("No File Uploaded");

                       //dialog.modal('hide');
                   }
               });
               //generateticketnumber();
               $.ajax({
                   type: 'POST',
                   url: '@Url.Action("InsertTransTicketNcr", "TicketNcr")',
                   data: data,
                   success: function (data) {
                       if (data.New) {
                           $.each(data.New, function (k, value) {
                               if (value.ResponseType == "Success") {

                                   $('#modalsuccess').modal('show');
                                   dialog.modal('hide');
                                   //-------Afer Save Complete CIRF Enable------
                                   document.getElementById("fCIRF").disabled = false;
                          
                                   document.getElementById("ValueOfLoss").disabled = false;
                                   document.getElementById("CorrectiveAction").disabled = false;                         
                                   document.getElementById("SIRSNumber").disabled = false;
                                   document.getElementById("NCRNumber").disabled = false;
                                   document.getElementById("CIRFAttachment").disabled = false;
                                   document.getElementById("OffenderYOS").disabled = false;
                                   document.getElementById("ManufacturingYear").disabled = false;
                                   document.getElementById("btnSaveCIRF").disabled = false;
                  
                                   document.getElementById("ProblemIssue1").disabled = false;
                                   document.getElementById("ProblemIssue2").disabled = false;
                                   document.getElementById("ProblemIssue3").disabled = false;
                                   document.getElementById("MainFactor").disabled = false;

                                   document.getElementById("VehicleType").disabled = false;
                                   document.getElementById("LocationCategory").disabled = false;
                                   document.getElementById("RoadCondition").disabled = false;
                                   document.getElementById("Preventability").disabled = false;
                                   document.getElementById("WeatherCondition").disabled = false;
                                   document.getElementById("AccidentCategory").disabled = false;
                                   document.getElementById("TicketStatus").disabled = false;
                                   document.getElementById("TypeLocation").disabled = false;

                                   //-------Afer Save Complete Ticket Form Dsable------
                                   document.getElementById("btnEditCRIF").disabled = true;
                                   document.getElementById("btnSaveTicketForm").disabled = true;
                                   document.getElementById("btnEditTicketForm").disabled = false;
                                   document.getElementById("CorrectiveDate").disabled = true;
                                   document.getElementById("TicketCategory").disabled = true;
                                   document.getElementById("TicketQty").disabled = true;
                                   document.getElementById("Location").disabled = true;
                                   document.getElementById("VendorName").disabled = true;
                                   document.getElementById("VehiclePlateNumber").disabled = true;
                                   document.getElementById("OffenderName").disabled = true;
                                   document.getElementById("OffenderRole").disabled = true;
                                   document.getElementById("OffenderAge").disabled = true;
                                   document.getElementById("RemarkTicket").disabled = true;
                                   document.getElementById("Attachment").disabled = true;

                                   document.getElementById("GeneratePDF").disabled = false;
                                   //document.getElementById("VehicleType").disabled = true;
                                   //document.getElementById("LocationCategory").disabled = true;
                                   //document.getElementById("RoadCondition").disabled = true;
                                   //document.getElementById("Preventability").disabled = true;
                                   //document.getElementById("WeatherCondition").disabled = true;
                                   //document.getElementById("AccidentCategory").disabled = true;
                                   //document.getElementById("TicketStatus").disabled = true;
                                   //document.getElementById("TypeLocation").disabled = true;

                                   $('#TiketNumber').val(value.TicketNumber);
                                   document.getElementById("NonTicket").disabled = true;
                                   window.location = "TransportTicketNcrEdit?TicketNumber=" + value.TicketNumber;
                                   dialog.modal('hide');
                               } else {
                                   $('#modalerror').modal('show');

                                   dialog.modal('hide');
                               }

                           });
                       }

                   }
               });
           }
        } else {  
            alert("FormData is not supported.");  
        }
    }

