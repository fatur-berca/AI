    var ticketsave;
    function numberWithCommas(x) {
        return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    
    $('#ValueOfLoss').on('change', function () {
        var val = parseInt($('#ValueOfLoss').val());
        //Use the code in the answer above to replace the commas.
        val = numberWithCommas(val);
        $('#ValueOfLoss').val(val);
        // alert(val);

        document.getElementById("ValueOfLoss").onblur = function () {
            this.value = parseFloat(this.value.replace(/,/g, ""))
                            .toFixed(0)
                            .toString()
                            .replace(/\B(?=(\d{3})+(?!\d))/g, ",");
          
            $('#Value').val(this.value.replace(/,/g, ""));
        }
    });
