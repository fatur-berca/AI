    function editCIRF() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        var filename;
        if (window.FormData !== undefined) {

            var fileUpload = $("#CIRFAttachment").get(0);
            var files = fileUpload.files;

            // Create FormData object  
            var fileData = new FormData();

            // Looping over all files and add it to FormData object  
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);
                filename = files[i].name;
            }

            // Adding one more key to FormData object  
            fileData.append('username', 'Manas');
           /// alert(fileData.toString);
            $.ajax({
                url: '@Url.Action("Upload", "TicketNcr")',
                type: "POST",
                contentType: false, // Not to set any content header  
                processData: false, // Not to process data  
                data: fileData,
                success: function (result) {

                    // dialog.modal('hide');
                },
                error: function (err) {
                    alert(err.statusText);
                    //dialog.modal('hide');
                }
            });
        } else {
            alert("FormData is not supported.");
        }
        var ticketnumber = document.getElementById('TiketNumber').value;
        var VehicleType = $('#VehicleType :selected').val();
        var ManufacturingYear = document.getElementById('ManufacturingYear').value;
        //var ManufacturingYear = $('#ManufacturingYear :selected').val();
        //var OffenderYOS = document.getElementById('OffenderYOS').value;
        var OffenderYOS = $('#OffenderYOS :selected').val();
        var LocationCategory = $('#LocationCategory :selected').val();
        var TypeLocation = $('#TypeLocation :selected').val();
        var RoadCondition = $('#RoadCondition :selected').val();
        var Preventability = $('#Preventability :selected').val();
        var WeatherCondition = $('#WeatherCondition :selected').val();
        var AccidentCategory = $('#AccidentCategory :selected').val();    
        // var ValueOfLoss = document.getElementById('ValueOfLoss').value;
        var ValueOfLoss = document.getElementById('Value').value;
        var CorrectiveAction = document.getElementById('CorrectiveAction').value;
        var CorrectiveDate = document.getElementById('CorrectiveDate').value;
       

        var TicketStatus = $('#TicketStatus :selected').val();
        var SIRSNumber = document.getElementById('SIRSNumber').value;
        var NCRNumber = document.getElementById('NCRNumber').value;
        var AttachmentNRC = filename;
        var ProblemIssue1 = $('#ProblemIssue1 :selected').val();    
        var ProblemIssue2 = $('#ProblemIssue2 :selected').val();    
        var ProblemIssue3 = $('#ProblemIssue3 :selected').val();    
        var MainFactor = $('#MainFactor :selected').val();    

        if (TicketStatus == "1") {
            TicketStatus = true;
        } else {
            TicketStatus = false;
        }


        var data = {
            "new": [{}],
            "edit": [{
                "TicketNumber": ticketnumber, "VehicleType": VehicleType, "ManufacturingYear": ManufacturingYear, "OffenderYearOfService": OffenderYOS,
                "LocationCategory": LocationCategory, "TypeOfLocation": TypeLocation, "RoadCondition": RoadCondition, "Preventablility": Preventability,
                "WeatherCondition": WeatherCondition, "AccidentCategory": AccidentCategory, "ValueOfLoss": ValueOfLoss,
                "IsActive": TicketStatus, "TicketStatus": TicketStatus, "SIRSNumber": SIRSNumber, "NCRNumber": NCRNumber, "AttachmentNRC": AttachmentNRC,
                "ProblemIssue1": ProblemIssue1, "ProblemIssue2": ProblemIssue2, "ProblemIssue3": ProblemIssue3, "MainFactor": MainFactor, "CorrectiveAction": CorrectiveAction
            }]
        };
        $.ajax({
            type: 'POST',
            url: '@Url.Action("InsertCirf", "TicketNcr")',
            data: data,
            success: function (data) {

                if (data.Edit) {
                    $.each(data.Edit, function (k, value) {
                        if (value.ResponseType == "Success") {

                            $('#modalsuccess').modal('show');
                            dialog.modal('hide');
                           
                            document.getElementById("fCIRF").disabled = true;
                          
                            document.getElementById("ValueOfLoss").disabled = true;
                            document.getElementById("CorrectiveAction").disabled = true;                         
                            document.getElementById("SIRSNumber").disabled = true;
                            document.getElementById("NCRNumber").disabled = true;
                            document.getElementById("CIRFAttachment").disabled = true;
                            document.getElementById("OffenderYOS").disabled = true;
                            document.getElementById("ManufacturingYear").disabled = true;
                            document.getElementById("btnSaveCIRF").disabled = true;
                  
                            document.getElementById("ProblemIssue1").disabled = true;
                            document.getElementById("ProblemIssue2").disabled = true;
                            document.getElementById("ProblemIssue3").disabled = true;
                            document.getElementById("MainFactor").disabled = true;

                            document.getElementById("VehicleType").disabled = true;
                            document.getElementById("LocationCategory").disabled = true;
                            document.getElementById("RoadCondition").disabled = true;
                            document.getElementById("Preventability").disabled = true;
                            document.getElementById("WeatherCondition").disabled = true;
                            document.getElementById("AccidentCategory").disabled = true;
                            document.getElementById("TicketStatus").disabled = true;
                            document.getElementById("TypeLocation").disabled = true;
                 
                            //generateticketnumber();
                        } else {
                            $('#modalerror').modal('show');

                            dialog.modal('hide');
                        }

                    });
                }

            }
        });
    }

    function edit() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        var filename;
        if (window.FormData !== undefined) {

            var fileUpload = $("#Attachment").get(0);
            var files = fileUpload.files;

            // Create FormData object  
            var fileData = new FormData();

            // Looping over all files and add it to FormData object  
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);
                filename = files[i].name;
            }

            // Adding one more key to FormData object  
            fileData.append('username', 'Manas');
            //alert(fileData);
            $.ajax({
                url: '@Url.Action("Upload", "TicketNcr")',
                type: "POST",
                contentType: false, // Not to set any content header  
                processData: false, // Not to process data  
                data: fileData,
                success: function (result) {

                    // dialog.modal('hide');
                },
                error: function (err) {
                    alert(err.statusText);
                    //dialog.modal('hide');
                }
            });
        } else {
            alert("FormData is not supported.");
        }

        var ticketnumber = document.getElementById('TiketNumber').value;
        var ticketcategory = $('#TicketCategory  :selected').val();
        var ticketqty = document.getElementById('TicketQty').value;
        var location = document.getElementById('Location').value;
        var vendorname = $('#VendorName  :selected').val();
        var vehicleplatenumber = document.getElementById('VehiclePlateNumber').value;
        var offendername = document.getElementById('OffenderName').value;
        var offenderrole = $('#OffenderRole :selected').val();
        var offenderage = document.getElementById('OffenderAge').value;
        var remarkticket = document.getElementById('RemarkTicket').value;
        var attachment = filename;
        var CorrectiveDate = moment(document.getElementById('CorrectiveDate').value).format("YYYY-MM-DD HH:mm");

        var data = {
            "new": [{ }],
            "edit": [{
                "TicketNumber": ticketnumber, "TicketCategory": ticketcategory, "TicketQuantity": ticketqty, "Location": location, "IDVendor": vendorname,
                "PoliceRegNumber": vehicleplatenumber, "OffenderName": offendername, "OffenderRole": offenderrole, "OffenderAge": offenderage, "RemarksTicket": remarkticket,          
                "strCorrectiveActionDate": CorrectiveDate, "Attachment": attachment, "IsActive": true
            }]
        };
        $.ajax({
            type: 'POST',
            url: '@Url.Action("InsertTransTicketNcr", "TicketNcr")',
            data: data,
            success: function (data) {
                if (data.Edit) {
                    $.each(data.Edit, function (k, value) {
                        if (value.ResponseType == "Success") {
                            $('#modalsuccess').modal('show');
                            dialog.modal('hide');

                            document.getElementById("TicketCategory").disabled = true;
                            document.getElementById("TicketQty").disabled = true;
                            document.getElementById("Location").disabled = true;
                            document.getElementById("VendorName").disabled = true;
                            document.getElementById("VehiclePlateNumber").disabled = true;
                            document.getElementById("OffenderName").disabled = true;
                            document.getElementById("OffenderRole").disabled = true;
                            document.getElementById("OffenderAge").disabled = true;
                            document.getElementById("RemarkTicket").disabled = true;
                            document.getElementById("Attachment").disabled = true;
                            document.getElementById("btnSaveTicketForm").disabled = true;
                            document.getElementById("CorrectiveDate").disabled = true;
                            //generateticketnumber();
                        } else {
                            $('#modalerror').modal('show');
                            dialog.modal('hide');
                        }
                    });
                }
            }
        });
    }

