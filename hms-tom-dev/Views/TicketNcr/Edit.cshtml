@{
    ViewBag.Title = "Transport > Safety & Security Data > Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model hms_tom_dev.Models.Transport.TransportTicketNCRViewModel

<div class="row">
    <div class="col-md-12">
        <a role="button" class="toggle-collapse in-box collapse" data-toggle="collapse" href="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
            Ticket Form
            <i class="fa fa-angle-up pull-right"></i>
        </a>
        <div id="collapseOne" role="tabpanel" aria-labelledby="collapseOne">
            <div class="col-panel">
                <div class="col-md-12">
                    <div class="title-deck wmb">
                        <div class="button-wrap pull-left">
                            <button class="btn btn-purple" onclick="window.location.href = '@Url.Action("Index","TicketNcr")'">Back</button>
                            <button class="btn btn-primary" id="btnSaveTicketForm">Save</button>
                            <button class="btn btn-primary" id="btnEditTicketForm">Edit</button>
                            <button class="btn btn-primary" id="GeneratePDF">Print Document</button>
                            <div class="form-group checkbox-padding"></div>
                            <div class="checkbox-deck">
                                <input type="checkbox" name="" id="NonTicket" disabled>
                                <label for="NonTicket"></label>
                            </div>
                            <span class="checkbox-deck-span">Is Non Ticket</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Ticket Number</label>
                        <input type="text" id="TiketNumber" class="form-control" disabled>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Category</label>
                        @*<select class="form-control" id="TicketCategory"></select>*@
                        @Html.DropDownList("TicketCategory", (SelectList)ViewBag.ListTicketCategory, string.Empty, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Ticket Quantity</label>
                        <input type="text" id="TicketQty" class="form-control">
                        @*@Html.TextBoxFor(model => model.Location , new { @class = "form-control", @id = "tes"})*@
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Location</label>
                        <input type="text" class="form-control" id="Location">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Vendor Name</label>
                        @*<select class="select2" id="VendorName"></select>*@
                        @Html.DropDownList("VendorName", (SelectList)ViewBag.ListVendor, string.Empty, new { @class = "select2" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Police Registration Number</label>
                        <input type="text" id="VehiclePlateNumber" class="form-control">
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Offender Name</label>
                        <input type="text" id="OffenderName" class="form-control">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Offender Role</label>
                        @*<select class="form-control" id="OffenderRole"></select>*@
                        @Html.DropDownList("OffenderRole", (SelectList)ViewBag.ListOffenderRole, string.Empty, new { @class = "form-control" })

                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Offender Age</label>
                        <input type="text" id="OffenderAge" class="form-control">
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Incident Date and Time</label>
                        <input type="text" id="CorrectiveDate" class="form-control datetimepicker">
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="form-group">
                        <label>Attachment</label>
                        <input type="file" id="Attachment" class="filestyle" accept=".pdf">
                        <a href="#" id="linkdownload">Download</a>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Remarks</label>
                        <textarea id="RemarkTicket" class="form-control" style="height:200px"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <a role="button" class="toggle-collapse in-box collapsed" data-toggle="collapse" href="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
            CIRF
            <i class="fa fa-angle-up pull-right"></i>
        </a>
        <div id="collapseTwo" role="tabpanel" aria-labelledby="collapseTwo">
            <div class="col-panel">
                <div class="col-md-12">
                    <div class="title-deck wmb">
                        <div class="button-wrap pull-left">
                            <button class="btn btn-purple" onclick="window.location.href = '@Url.Action("Index","TicketNcr")'">Back</button>
                            <button class="btn btn-primary" id="btnSaveCIRF">Save</button>
                            <button class="btn btn-primary" id="btnEditCRIF">Edit</button> 
                        </div>
                    </div>
                </div>
                <form id="fCIRF">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Vehicle Type</label>
                            @*<select class="form-control" id="VehicleType"></select>*@
                            @Html.DropDownList("VehicleType", (SelectList)ViewBag.ListVehicleType, string.Empty, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Manufacturing Year</label>
                            @*<select class="form-control" id="ManufacturingYear"></select>*@
                            <input type="text" id="ManufacturingYear" class="form-control" >
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Offender Year of Service</label>
                            @*<input type="text" id="OffenderYOS" class="datetimepicker form-control" >*@
                            @*<input type="text" id="OffenderYOS" class="form-control">*@
                            @*<select class="form-control" id="OffenderYOS"></select>*@
                            @Html.DropDownList("OffenderYOS", (SelectList)ViewBag.ListOffenderYOS, string.Empty, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Location Category</label>
                            @*<select class="form-control" id="LocationCategory"></select>*@
                            @Html.DropDownList("LocationCategory", (SelectList)ViewBag.ListLocationCategory, string.Empty, new { @class = "form-control" })

                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Type of Location</label>
                            @*<select class="form-control" id="TypeLocation"></select>*@
                            @Html.DropDownList("TypeLocation", (SelectList)ViewBag.ListLocationType, string.Empty, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Road Condition</label>
                            @Html.DropDownList("RoadCondition", (SelectList)ViewBag.ListRoadCondition, string.Empty, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Preventability</label>
                            <select class="form-control" id="Preventability">
                                <option value="1">YES</option>
                                <option value="0">NO</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Weather Condition</label>
                            @*<select class="form-control" id="WeatherCondition"></select>*@
                            @Html.DropDownList("WeatherCondition", (SelectList)ViewBag.ListWeatherCondition, string.Empty, new { @class = "form-control" })


                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Accident Category</label>
                            @*<select class="form-control" id="AccidentCategory"></select>*@
                            @Html.DropDownList("AccidentCategory", (SelectList)ViewBag.ListAccidentCategory, string.Empty, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Value of Loss (IDR)</label>
                            <input type="text" id="ValueOfLoss" class="form-control">                    
                            <div hidden><input type="text" id="Value" class="form-control"></div>                  
                    
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="form-group">
                            <label>Corrective Action</label>
                            <input type="text" id="CorrectiveAction" class="form-control">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Ticket Status</label>
                            <select class="form-control" id="TicketStatus">
                            <option value="1">Active</option>
                            <option value="0">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>SIRS Number</label>
                            <input type="text" id="SIRSNumber" class="form-control">
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>NCR Number</label>
                            <input type="text" id="NCRNumber" class="form-control">
                        </div>
                    </div>        
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Root Cause Analysis 1</label>
                            @*<select class="form-control" id="ProblemIssue1"></select>*@
                            @Html.DropDownList("ProblemIssue1", (SelectList)ViewBag.ListRoot, string.Empty, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Root Cause Analysis 2</label>
                            @*<select class="form-control" id="ProblemIssue2"></select>*@
                            @Html.DropDownList("ProblemIssue2", (SelectList)ViewBag.ListRoot, string.Empty, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Root Cause Analysis 3</label>
                            @*<select class="form-control" id="ProblemIssue3"></select>*@
                            @Html.DropDownList("ProblemIssue3", (SelectList)ViewBag.ListRoot, string.Empty, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Main Root Cause</label>
                            @*<select class="form-control" id="MainFactor"></select>*@
                            @Html.DropDownList("MainFactor", (SelectList)ViewBag.ListMainProblem, string.Empty, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Attachment</label>
                            <input type="file" id="CIRFAttachment" class="filestyle" accept=".xls, .xlsx">
                            <a href="#" id="CIRFdownload">Download</a>
                        </div>
                    </div>
                </form>
            </div>   
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="../assets/images/cancel.png" alt="">
                <span>Whoopss... something(s) wrong with your input, please check your data</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerror1" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="../assets/images/cancel.png" alt="">
                <span>Please complete data on ticket form</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="../assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal" id="modalOK">OK</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    jQuery(function ($) {
        var getUrlParameter = function getUrlParameter(sParam) {
            var sPageURL = decodeURIComponent(window.location.search.substring(1)),
                sURLVariables = sPageURL.split('&'),
                sParameterName,
                i;

            for (i = 0; i < sURLVariables.length; i++) {
                sParameterName = sURLVariables[i].split('=');

                if (sParameterName[0] === sParam) {
                    return sParameterName[1] === undefined ? true : sParameterName[1];
                }
            }
        };

        // generateDropDownVendor();
        // generateManufacturingyear();
        // generateTicketCategory();

        document.getElementById("fCIRF").disabled = true;
     
        document.getElementById("ValueOfLoss").disabled = true;
        document.getElementById("CorrectiveAction").disabled = true;
        document.getElementById("CorrectiveDate").disabled = true;
        document.getElementById("SIRSNumber").disabled = true;
        document.getElementById("NCRNumber").disabled = true;
        document.getElementById("CIRFAttachment").disabled = true;
        document.getElementById("OffenderYOS").disabled = true;
        document.getElementById("ManufacturingYear").disabled = true;
        document.getElementById("btnSaveCIRF").disabled = true;
        document.getElementById("TicketCategory").disabled = true;
        document.getElementById("TicketQty").disabled = true;
        document.getElementById("Location").disabled = true;
        $('#VendorName').prop("disabled", true);

        // document.getElementById("VendorName").disabled = true;
        document.getElementById("VehiclePlateNumber").disabled = true;
        document.getElementById("OffenderName").disabled = true;
        document.getElementById("OffenderRole").disabled = true;
        document.getElementById("OffenderAge").disabled = true;
        document.getElementById("RemarkTicket").disabled = true;
        document.getElementById("Attachment").disabled = true;
        document.getElementById("btnSaveTicketForm").disabled = true;
        document.getElementById("ProblemIssue1").disabled = true;
        document.getElementById("ProblemIssue2").disabled = true;
        document.getElementById("ProblemIssue3").disabled = true;
        document.getElementById("MainFactor").disabled = true;

        document.getElementById("VehicleType").disabled = true;
        document.getElementById("LocationCategory").disabled = true;
        document.getElementById("RoadCondition").disabled = true;
        document.getElementById("Preventability").disabled = true;
        document.getElementById("WeatherCondition").disabled = true;
        document.getElementById("AccidentCategory").disabled = true;
        document.getElementById("TicketStatus").disabled = true;
        document.getElementById("TypeLocation").disabled = true;
        
        document.getElementById('TiketNumber').value =  getUrlParameter('TicketNumber');
        
        GetDataByID(getUrlParameter('TicketNumber'));

        $('#btnEditTicketForm').click(function () {
            $(this).prop("disabled", true);
            document.getElementById("TicketCategory").disabled = false;
            document.getElementById("TicketQty").disabled = false;
            document.getElementById("Location").disabled = false;
            $('#VendorName').attr("disabled", false);
            //document.getElementById("VendorName").disabled = false;
            document.getElementById("VehiclePlateNumber").disabled = false;
            document.getElementById("OffenderName").disabled = false;
            document.getElementById("OffenderRole").disabled = false;
            document.getElementById("OffenderAge").disabled = false;
            document.getElementById("RemarkTicket").disabled = false;
            document.getElementById("Attachment").disabled = false;
            document.getElementById("btnSaveTicketForm").disabled = false;
            document.getElementById("CorrectiveDate").disabled = false;
        });

        $('#btnSaveCIRF').click(function () {
            editCIRF();
            //GetDataByID(getUrlParameter('TicketNumber'));
        });

        $('#modalOK').click(function () {
            GetDataByID(getUrlParameter('TicketNumber'));
        });

        $('#ValueOfLoss').on('change', function () {
            var val = parseInt($('#ValueOfLoss').val());
            //Use the code in the answer above to replace the commas.
            val = numberWithCommas(val);
            $('#ValueOfLoss').val(val);
            // alert(val);

            document.getElementById("ValueOfLoss").onblur = function () {
                this.value = parseFloat(this.value.replace(/,/g, ""))
                                .toFixed(0)
                                .toString()
                                .replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                $('#Value').val(this.value.replace(/,/g, ""));
            }
        });

        $('#GeneratePDF').click(function () {
            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

            $.ajax({
                url: '@Url.Action("GeneratePDF", "TicketNcr")',
                type: "POST",
                cache : false,
                data: { "id": document.getElementById('TiketNumber').value },
                // contentType: "application/pdf; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    // window.location.assign("../Assets/Download/" + data);
                    window.open("../Assets/Download/" + data);
                    dialog.modal('hide');
                },
                error: function (err) {
                    //alert("Somethings Wrong");
                    dialog.modal('hide');
                }
            });
        });
    
        $('#btnEditCRIF').click(function () {
            $(this).prop("disabled", true);
            document.getElementById("fCIRF").disabled = false;
            document.getElementById("ValueOfLoss").disabled = false;
            document.getElementById("CorrectiveAction").disabled = false;       
            document.getElementById("SIRSNumber").disabled = false;
            document.getElementById("NCRNumber").disabled = false;
            document.getElementById("CIRFAttachment").disabled = false;
            document.getElementById("OffenderYOS").disabled = false;
            document.getElementById("ManufacturingYear").disabled = false;
            document.getElementById("btnSaveCIRF").disabled = false;
            document.getElementById("ProblemIssue1").disabled = false;
            document.getElementById("ProblemIssue2").disabled = false;
            document.getElementById("ProblemIssue3").disabled = false;
            document.getElementById("MainFactor").disabled = false;
            document.getElementById("VehicleType").disabled = false;
            document.getElementById("LocationCategory").disabled = false;
            document.getElementById("RoadCondition").disabled = false;
            document.getElementById("Preventability").disabled = false;
            document.getElementById("WeatherCondition").disabled = false;
            document.getElementById("AccidentCategory").disabled = false;
            document.getElementById("TicketStatus").disabled = false;
            document.getElementById("TypeLocation").disabled = false;
        });

        $('#btnSaveTicketForm').click(function () {
            edit();
        });
    });

    function GetDataByID(id) {
        //generateDropDownAccidentCategory();
        //generateDropDownLocationCategory();
        //generateDropDownLocationType();
        //generateDropDownRoadCondition();
        //generateDropDownVehicleType();
        //generateDropDownWeatherCondition();
        //generateGetOffenderRole();
        //generateOffenderYOS();
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        $.ajax({
            url: '@Url.Action("GetDataByID", "TicketNcr")',
            type: "GET",
            contentType: "application/json;charset=UTF-8",
            dataType: "json",
            cache: false,
            data: { "id": id },
            success: function (data) {
                if (data) {
                    $.each(data, function (key, val) {
                        var nonticket =  val.TicketNumber.substr(0, 3);
                        if (nonticket == "NON") {
                            $('#NonTicket').prop('checked', true);
                            document.getElementById("GeneratePDF").disabled = true;
                        } else {
                            $('#NonTicket').prop('checked', false);
                            document.getElementById("GeneratePDF").disabled = false;
                        }

                        document.getElementById('TiketNumber').value = val.TicketNumber;
                        $('#VehicleType').val(val.VehicleType);
                        $('#ManufacturingYear').val(val.ManufacturingYear);
                        $('#OffenderYOS').val(val.OffenderYearOfService);
                        $('#LocationCategory').val(val.LocationCategory);
                        $('#TypeLocation').val(val.TypeOfLocation);
                        $('#RoadCondition').val(val.RoadCondition);
                        $('#Preventability').val((val.Preventablility == true) ? "1" : "0");
                        $('#WeatherCondition').val(val.WeatherCondition);
                        $('#AccidentCategory').val(val.AccidentCategory);
                        
                        var tamvung = parseInt(val.ValueOfLoss);
                        //Use the code in the answer above to replace the commas.
                        tamvung = numberWithCommas(tamvung);
                        $('#ValueOfLoss').val(tamvung);

                        $('#Value').val(val.ValueOfLoss);
                        $('#VehiclePlateNumber').val(val.PoliceRegNumber);
                        $('#CorrectiveAction').val(val.CorrectiveAction);
                        $('#CorrectiveDate').val(moment(moment(val.CorrectiveActionDate)).format("MM/DD/YYYY h:mm A"));
                     
                        $('#TicketCategory').val(val.TicketCategory);
                        $('#TicketStatus').val((val.IsActive == true) ? "1" : "0");
                        $('#SIRSNumber').val(val.SIRSNumber);
                        $('#NCRNumber').val(val.NCRNumber);

                        $('#TicketQty').val(val.TicketQuantity);
                        document.getElementById('Location').value = val.Location;
                        $("#VendorName").select2('data', { id: val.IDVendor, text: val.VendorName });
                        $('#OffenderAge').val(val.OffenderAge);
                        $('#OffenderName').val(val.OffenderName);
                        $('#OffenderRole').val(val.OffenderRole);
                        $('#ProblemIssue1').val(val.ProblemIssue1);
                        $('#ProblemIssue2').val(val.ProblemIssue2);
                        $('#ProblemIssue3').val(val.ProblemIssue3);
                        $('#MainFactor').val(val.MainFactor);

                        //var createdDate = moment(Number(val.CreatedDate.match(/\d+/)[0])).format('DD/MM/YYYY');
                        //setBtnEdit(createdDate, null);
                        document.getElementById('RemarkTicket').value = val.RemarksTicket == null? "":val.RemarksTicket;
                        
                        if (val.Attachment) {
                            document.getElementById('Attachment').value = "../assets/Uploads/TransportTicketNCR/" + val.Attachment;
                            document.getElementById('linkdownload').href = "../assets/Uploads/TransportTicketNCR/" + val.Attachment;
                        }

                        if (val.AttachmentNRC) {
                            document.getElementById('CIRFdownload').href = "../assets/Uploads/TransportTicketNCR/" + val.AttachmentNRC;
                            document.getElementById('CIRFAttachment').value = "../assets/Uploads/TransportTicketNCR/" + val.AttachmentNRC;
                        }

                        return false; // break loop
                    });
                    dialog.modal('hide');
                } else {
                    alert("Error");
                    dialog.modal('hide');
                }
            }
        });
    }

    function numberWithCommas(x) {
        return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }
    
    function editCIRF() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        var filename;
        if (window.FormData !== undefined) {

            var fileUpload = $("#CIRFAttachment").get(0);
            var files = fileUpload.files;

            // Create FormData object  
            var fileData = new FormData();

            // Looping over all files and add it to FormData object  
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);
                filename = files[i].name;
            }

            // Adding one more key to FormData object  
            fileData.append('username', 'Manas');
           /// alert(fileData.toString);
            $.ajax({
                url: '@Url.Action("Upload", "TicketNcr")',
                type: "POST",
                contentType: false, // Not to set any content header  
                processData: false, // Not to process data  
                data: fileData,
                success: function (result) {
                    // dialog.modal('hide');
                },
                error: function (err) {
