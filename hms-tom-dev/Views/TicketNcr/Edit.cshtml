    // BEGIN : SSO closing page, listlocation by usermapping, listrole by user mapping
    var closingPageDate = '@ViewBag.ClosingPageDate';
    //var listLocation = @Html.Raw(Json.Encode(ViewBag.ListLocation));
    var listUserRole = @Html.Raw(Json.Encode(ViewBag.ListUserRole));
    // END : SSO closing page, listlocation by usermapping, listrole by user mapping
    // validasi tombol edit (SSO)
    function setBtnEdit(param1, param2) {
        var disabled = true;
        for (var j = 0; j < listUserRole.length; j++) {
            if (listUserRole[j] == "SUPER ADMIN") { // untuk test gunakan "!=", untuk produksi gunakan "=="
                if (listUserRole[j] != "SUPER ADMIN") continue;
                disabled = false;
            } else {
                var closingDateArr = moment(closingPageDate, "DD/MM/YYYY").format("DD MM YYYY").split(" ");
                var closingDate = new Date(''+closingDateArr[2]+'-'+closingDateArr[1]+'-'+(closingDateArr[0]-1));
                var createdDateArr = moment(param1, "DD/MM/YYYY").format("DD MM YYYY").split(" ");
                var createdDate = new Date(''+createdDateArr[2]+'-'+createdDateArr[1]+'-'+(createdDateArr[0]-1));
                if (param2 != null) { //begin : untuk page yg memiliki lokasi
                    for (var i = 0; i < listLocation.length; i++) {
                        if (listLocation[i] != param2) continue;
                        if (closingDate < createdDate) {
                            disabled = false;
                        } else if(closingDate > createdDate) {
                            disabled = true;
                        }
                    }
                    //end : untuk page yg memiliki lokasi
                } else {
                    if (closingDate < createdDate) {
                        disabled = false;
                    } else if(closingDate > createdDate) {
                        disabled = true;
                    }
                }
            }
        }
        console.log(disabled);
        $("#btnEditTicketForm").prop("disabled", disabled);
    }
