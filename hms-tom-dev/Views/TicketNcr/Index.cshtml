                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible').search(this.value).draw();
                    });
                });
            }
        });
    }

    function generateTable() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        })


        var table = $('#dtFilterMaster').DataTable({
            "paging": true,
            "ordering": false,
            "filter": true,
            "destroy": true,
            "orderMulti": false,
            "serverSide": true,
            "processing": true,
            "pageLength": 10,
            "ajax": {
                dataType: 'JSON',
                type: 'POST',
                url: '@Url.Action("GetTicketNCRTableList", "TicketNcr")',
                data: function (data) {
                    data.IDVendor = $('#VendorName :selected').val();
                    data.TicketStatus = $('#TicketStatus :selected').val();
                    data.AccidentCategory = $('#AccidentCategory :selected').val();
                    data.TicketCategory = $('#TicketCategory :selected').val();
                    data.DateTo = document.getElementById('DateTo').value.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
                    data.DateFrom = document.getElementById('DateFrom').value.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
                    data.NCRNumber = document.getElementById('NCRNumber').value;
                    data.IncludeDeleted = $("#chkInactive").prop('checked');
                    return data
                },
                "complete": function (res) {
                    jQuery('#checkall').attr('checked', false);
                    dialog.modal('hide');
                },
                "error": function (res) {
                    dialog.modal('hide');
                }
            },
            "columns": [
                {
                    'data': 'TicketNumber', "render": function (data, type, row, meta) {
                        return '<td text-center><div class="checkbox-deck"><input type="checkbox" id="' + data + '" class="chkList"><label for="' + data + '"></label></div></td>';
                    }
                },
                {
                    "data": "IsActive", "class": "text-center", "render": function (data) {
                        if (data == true) {
                            return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                        } else {
                            return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>';
                        }
                    }
                },
                //{ 'data': 'TicketNumber', 'searchable': true },
                {
                    "data": "TicketNumber", "class": "text-center", "render": function (datum) {
                        return '<a href="@Url.Action("TransportTicketNcrEdit", "TicketNcr")?TicketNumber=' + datum + '">' + datum + '</a>';
                    }
                },
                //{ 'data': 'CorrectiveActionDate', 'searchable': true },
                {
                    "data": "CorrectiveActionDate", "render": function (data, type, row) {
                        if (row['CorrectiveActionDate'] == null) {
                            jamtanggal = null;
                        } else {
                            var jamtanggal = moment(row['CorrectiveActionDate']).format("DD-MMM-YYYY HH:mm");
                        }

                        return jamtanggal;
                    }
                },
                { 'data': 'VendorName', 'orderable': false },
                { 'data': 'PoliceRegNumber', 'orderable': false },
                { 'data': 'TicketCategory', 'orderable': false },
                { 'data': 'AccidentCategory', 'orderable': false },
                { 'data': 'OffenderName', 'orderable': false },
                { 'data': 'OffenderRole', 'orderable': false },
                { 'data': 'OffenderAge', 'orderable': false },
                { 'data': 'OffenderYearOfService', 'orderable': false },
                { 'data': 'Location', 'orderable': false },
                { 'data': 'SIRSNumber', 'orderable': false },
            ],
            orderCellsTop: true
        });
        $('.dataTables_filter input').attr("placeholder", "Search Here");
        $("#dtFilterMaster thead.filters th").each(function (index) {
            if (index == 0) {
                $(this).text('Filter');
            } else if (index == 1) {
                $(this).empty();
            } else {
                var title = $('.dataTable thead.filters th').eq($(this).index()).text();
                $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
            }
        });

        table.columns().every(function (index) {
            if (index > 1) {
                $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                    table.column($(this).parent().index() + ':visible')
                        .search(this.value)
                        .draw();
                });
            }
        });
    }

    $("#btnExportReport").click(function () {
        @*location.href = '@Url.Action("ExportReport", "TicketNcr")';*@

        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        $.ajax({
            url: '@Url.Action("ExportTicketNCR", "TicketNcr")',
            method: 'post',
            data: {
                "IDVendor": $('#VendorName :selected').val(),
                "TicketStatus": $('#TicketStatus :selected').val(),
                "AccidentCategory": $('#AccidentCategory :selected').val(),
                "TicketCategory": $('#TicketCategory :selected').val(),
                "DateTo": document.getElementById('DateTo').value.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                "DateFrom": document.getElementById('DateFrom').value.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                "NCRNumber": document.getElementById('NCRNumber').value,
                "IncludeDeleted": $("#chkInactive").prop('checked')
            },
            dataType: 'json',
            cache: false,
            success: function (data) {
                window.location.assign("Assets/Download/" + data);
                dialog.modal('hide');
            }
        });
    });

    function GetFieldTransportTicketNCR() {
        $('#sourceFields').empty().append('');
        $('#destinationFields').empty().append('');
        $.ajax({
            url: '@Url.Action("GetFieldTransportTicketNCR", "TicketNcr")',
            method: 'get',
            dataType: 'json',
            success: function (json) {
                for (var i = 0; i < json.length; i++) {
                    var temp = json[i];
                    $("#sourceFields").append('<div id="' + temp + '" class="generatedCustomReport">' + temp + '</div>');
                }
            }
        });
    }

    function dateRange() {
        jQuery('#DateFrom').val(moment().subtract(1, 'months').format('DD/MM/YYYY'));
        jQuery('#DateTo').val(moment().format('DD/MM/YYYY'));
    }
</script>
