<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.AddNew)))
        {
            <button class="btn btn-primary" onclick="window.location.href = '@Url.Action("TransportTicketNcrInput", "TicketNcr")' ">Add New</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Delete)))
        {
        <button class="btn btn-primary" id="btnSetInactive" type="button" onclick="SetIsActive('Delete')">Delete</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
        {
        <button class="btn btn-primary" id="btnExportReport">Export</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
        {
        <button class="btn btn-primary" data-toggle="modal" data-target="#customReportModal" id="customReportButton">Custom Report</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Recovery)))
        {
            <button class="btn btn-primary" id="btnSetActive" type="button" onclick="SetIsActive('Recovery')">Recovery</button>
        }
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b><i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck nmb">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel">
            <form id="frmFilter">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Date of History</label>
                        <div class="row">
                            <div class="col-md-5">
                                <input type="text" name="" id="DateFrom" class="datepicker form-control">
                            </div>
                            <div class="col-md-2 to-bi">
                                <label>To</label>
                            </div>
                            <div class="col-md-5">
                                <input type="text" name="" id="DateTo" class="datepicker form-control">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Vendor Name</label>
                        @*<select class="form-control" id="VendorName"></select>*@
                        @Html.DropDownList("VendorName", (SelectList)ViewBag.ListVendor, string.Empty, new { @class = "form-control" })
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Ticket Status</label>
                        <select class="form-control" id="TicketStatus">
                            <option value=true>Active</option>
                            <option value=false>Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Ticket Category</label>
                        @*<select class="form-control" id="TicketCategory"></select>*@
                        @Html.DropDownList("TicketCategory", (SelectList)ViewBag.ListTicketCategory, string.Empty, new { @class = "form-control" })                    
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Accident Category</label>
                        @*<select class="form-control" id="AccidentCategory"></select>*@
                        @Html.DropDownList("AccidentCategory", (SelectList)ViewBag.ListAccidentCategory, string.Empty, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>NCR Number</label>
                        <input type="text" class="form-control" id="NCRNumber">
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-3">
                    <div class="form-group">
                        <div class="checkbox-deck">
                            <input type="checkbox" id="chkInactive">
                            <label for="chkInactive"></label>
                        </div>
                        <span class="checkbox-deck-span">Include deleted data</span>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12">
                    <button id="btnSearch" class="btn btn-primary">Search</button>
                    <button id="btnReset" class="btn btn-purple">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="data-table">
    <table id="dtFilterMaster" class="dataTable display table">
        <thead>
            <tr>
                <th data-orderable="false" class="text-center">
                    <div class="checkbox-deck">
                        <input type="checkbox" id="checkall">
                        <label for="checkall"></label>
                    </div>
                </th>
                <th data-orderable="false">Status</th>
                <th>Ticket Title</th>
                <th>Incident Date & Time</th>
                <th>Vendor Name</th>
                <th>Police Registration Number</th>
                <th>Category</th>
                <th>Accident Category</th>
                <th>Offender Name</th>
                <th>Offender Role</th>
                <th>Offender Age</th>
                <th>Offender Year of Service</th>
                <th>Location</th>
                <th>SIRS Number</th>
            </tr>
        </thead>
        <thead class="filters">
            <tr class="filter-row">
                <th class="text-center">Filter</th>
                <th class="text-center"></th>
                <th>Ticket Title</th>
                <th>Incident Date & Time</th>
                <th>Vendor Name</th>
                <th>No. Plate</th>
                <th>Vehicle Type</th>
                <th>Vehicle Year</th>
                <th>Offender Name</th>
                <th>Offender Role</th>
                <th>Offender Age</th>
                <th>Offender Year of Service</th>
                <th>Location</th>
                <th>SIRS Number</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

