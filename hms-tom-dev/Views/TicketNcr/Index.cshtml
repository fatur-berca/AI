    function generateTicketCategory() {
        var select = $('#TicketCategory');
        $.ajax({
            url: '@Url.Action("GetDropTicketCatergory", "TicketNcr")',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                select.html('');
                select.html('<option ></option>').trigger('change');
                $.each(data,
                    function (key, val) {
                        select.append('<option value="' + val.FieldValue + '">' + val.FieldValue + '</option>');
                    }); generateDropDownAccidentCategory();
            },
            error: function () {
                select.html('<option >none available</option>');
            }
        });
    }

    function generateDropDownAccidentCategory() {
        var select = $('#AccidentCategory');
        $.ajax({
            url: '@Url.Action("GetAccidentCategory", "TicketNcr")',
            dataType: 'JSON',
            success: function (data) {
                select.html('');
                select.html('<option ></option>').trigger('change');
                $.each(data,
                    function (key, val) {
                        select.append('<option value="' + val.FieldValue + '">' + val.FieldValue + '</option>');
                    }); generateDropDownVendor();
            },
            error: function () {
                select.html('<option value="NULL">none available</option>');
            }
        });
    }

    function generateDropDownVendor() {
        var select = $('#VendorName');

        $.ajax({
            url: '@Url.Action("GetMasterVendor", "TicketNcr")',
            dataType: 'JSON',
            success: function (data) {
                select.html('<option ></option>').trigger('change');
                $.each(data, function (key, val) {
                    select.append('<option value="' + val.IDVendor + '">' + val.VendorName + '</option>');
                });
            },
            error: function () {
                select.html('<option value="NULL">none available</option>');
            }
        });
    }

    // BEGIN : SET INACTIVE OR ACTIVE RELATED TO CHECKBOX FUNCTION
    function SetIsActive(status) {
        var ids = [];
        jQuery('.chkList').each(function () {
            if (jQuery(this).is(':checked')) {
                ids.push(jQuery(this).attr('id'));
            }
        });

        if (ids.length > 0) {
            bootbox.confirm({
                title: "DFIS Notification Center",
                message: "<div class='text-left'><img src='assets/images/danger.png' alt=''> Are you sure that you want to " + status + " the selected item(s)?</div>",
                closeButton: false,
                buttons: {
                    confirm: {
                        label: 'OK',
                        className: 'btn-primary'
                    },
                    cancel: {
                        label: 'Cancel',
                        className: 'btn-purple'
                    }
                },
                callback: function (result){
                    if (result) {
                        ChangeIsActive(ids, status);
                    }
                }
            });
        } else {
            alertPleaseSelect();
        }
    }

    function ChangeIsActive(ids, status) {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        return $.ajax({
            url: '@Url.Action("SetStatusResult")',
            method: 'post',
            dataType: 'json',
            data: {
                "ListIsActiveIdString": ids,
                "Isactive": (status.toLowerCase() == "recovery") ? true : false
            },
            cache: false,
            success: function (response) {
                dialog.modal("hide");
                var msg = (status.toLowerCase() == "recovery") ? "Recovered" : "Deleted",
                    signal = "Error, your data can't be " + msg + " !";

                if (response == "Success") {
                    signal = "Data has been successfully " + msg + " from the database.";
                }
                bootbox.alert({
                    title: "DFIS Notification Center",
                    message: signal,
                    callback: function () {
                        generateTable();
                    }
                });
            },
            error: function () {
                dialog.modal("hide");
            }
        });
    }
