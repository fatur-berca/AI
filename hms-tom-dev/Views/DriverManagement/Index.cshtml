    var tempid = [];
    var filter = new Object();
    var stat = false;
    function SetIsActive(param) {
        if (tempid.length > 0) {
            bootbox.confirm({
                title: "TOM Notification Center",
                message: "Are you sure to " + param + " this data?",
                buttons: {
                    confirm: {
                        label: 'Yes',
                        className: 'btn btn-primary'
                    },
                    cancel: {
                        label: 'Cancel',
                        className: 'btn btn-purple'
                    }
                },
                callback: function (result) {
                    if (result) { ChangeIsActive(); }
                }
            });
            stat = (param == "Delete") ? false : true;
        } else if (tempid.length == 0) {
            alertPleaseSelect();
        }
    }

    function ChangeIsActive() {
        filter.ListIsActiveIdString = tempid;
        filter.Isactive = stat;
        $.ajax({
            url: '@Url.Action("SetStatusResult")',
            method: 'post',
            dataType: 'json',
            data: filter,
            cache: false,
            success: function (response) {
                var msg = stat ? "Recovered" : "Deleted";
                if (response == "Success") {
                    bootbox.alert({
                        title: "TOM Notification Center",
                        message: '<div><img src="../assets/images/checked.png" alt=""> Data has been successfully ' + msg + ' to the database! </div>',
                        callback: function() {
                            generateTable("firstload");
                            filter.ListIsActiveId = null;
                            tempid = [];
                        }
                    });
                } else {
                    bootbox.alert({
                        title: "TOM Notification Center",
                        message: '<div><img src="../assets/images/cancel.png" alt=""> Error your data cannot be ' + msg + ' ! </div>',
                        callback: function () {
                            generateTable("firstload");
                            filter.ListIsActiveId = null;
                            tempid = [];
                        }
                    });
                }
            }
        });
    }
    // END : SET INACTIVE OR ACTIVE RELATED TO CHECKBOX FUNCTION

    //CHECK BOX DAN CHECK BOX ALL
    function InsertTempArray() {
        var table = $('#dtFilterDriverManagement').DataTable();
        $('#dtFilterDriverManagement tbody').one('change', 'tr', function () {
            var data = table.row(this).data();
            var id = data["ID"] + "&" + data["IDVendor"];
           // var idvendor = data["IDVendor"];
            var result = $.grep(tempid, function (e) { return e == id; });
            if (result.length == 0) {
                tempid.push(id);
            } else if (result.length == 1) {
                tempid = tempid.filter(function (obj) {
                    return obj !== id;
                });
            }
        });
    }

    $("#checkall").change(function () {
        $(".chkList").prop('checked', $("#checkall").prop('checked'));
        if ($("#checkall").prop('checked')) {
            var table = $('#dtFilterDriverManagement').DataTable();
            table.column(1).nodes().each(function (cell, i) {
                tempid.push(table.cell(i, 1).data());
            });
            tempid = tempid.filter(onlyUnique);
        } else {
            tempid = [];
        }
    });

    //filter supaya array javascript hanya ada unique value
    function onlyUnique(value, index, self) {
        return self.indexOf(value) === index;
    }
    //CHECK BOX DAN CHECK BOX ALL END
