                    }
                }
                $('#RoleDriver').html(options);
            }
        });
    };

    var generateName = function(response) {
        var options = '<option value=""></option>';
        var optionsKTP = '<option value=""></option>';
        if (response.length) {
            for (i = 0; i < response.length; i++) {
                options = options + '<option value="' + response[i].Name + '">' + response[i].Name + '</option>';
                optionsKTP = optionsKTP + '<option value="' + response[i].ID + '">' + response[i].ID + '</option>';
            }
        }
        $('#Name').html(options);
        $('#IDCardNumberOrDrivingLicenseNumber').html(optionsKTP);
    };

    function IsAngka(evt) {
        var charCode = (evt.which); //? evt.which : event.keyCode
        //alert(evt.which);
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }

    function gup(name) {
        name = name.replace(/[\[]/, "\\\[").replace(/[\]]/, "\\\]");
        var regexS = "[\\?&]" + name + "=([^&]*)";
        var regex = new RegExp(regexS);
        var results = regex.exec(window.location.href);
        if (results == null)
            return "";
        else {
            for (i = 0; i < results[1].length; i++) {
                results[1] = results[1].replace("%20", " ");
                results[1] = results[1].replace("%27", "'");
            }
            return results[1];
        }
    }

    function resetSearch() {
        $("#IDCardNumberOrDrivingLicenseNumber").select2("val", "");
        $("#RoleDriver").val("");
        $("#Name").select2("val", "");
        $("#IDVendor").select2("val", "");
        $("#all").prop("checked", true);
        generateTable("firstload");
        excelParam = "firstload";
    }

    function getAge(dob, todate) {
        if (todate) todate = new Date(todate);
        else todate = new Date();

        var age = [], fromdate = new Date(dob),
        y = [todate.getFullYear(), fromdate.getFullYear()],
        ydiff = y[0] - y[1],
        m = [todate.getMonth(), fromdate.getMonth()],
        mdiff = m[0] - m[1],
        d = [todate.getDate(), fromdate.getDate()],
        ddiff = d[0] - d[1];

        if (mdiff < 0 || (mdiff === 0 && ddiff < 0))--ydiff;
        if (mdiff < 0) mdiff += 12;
        if (ddiff < 0) {
            fromdate.setMonth(m[1] + 1, 0);
            ddiff = fromdate.getDate() - d[1] + d[0];
            --mdiff;
        }
        if (ydiff > 0) age.push(ydiff + ' y');
        if (mdiff > 0) age.push(mdiff + ' m');
        //if (ddiff > 0) age.push(ddiff + ' day' + (ddiff > 1 ? 's' : ''));
        if ((ddiff > 0) && (mdiff <= 0) && (ydiff <= 0)) age.push('0 m');
        if (age.length > 1) age.splice(age.length - 1, 0, ' and ');
        return age.join('');

        //getAge("1/25/1974")>> 37 years 8 months and 26 days

        //getAge("9/15/1984")>> 27 years 1 month and 5 days

        //getAge("12/20/1984","10,20,2011")>>26 years  and 9 months

        //getAge(new Date(),"12/25/2011")+' till Christmas'>>
        //2 months and 5 days till Christmas

        //getAge("6/25/2011")>> 3 months and 25 days
    }

