    function setInactive(param) {
        $('#notificationModal .modal-body').html('<img src="assets/images/loading.gif" alt=""><span> Please wait, updating status.</span>');
        $('#notificationModal .modal-footer').empty();
        $('#notificationModal').modal('show');
        jQuery.ajax({
            type: 'POST',
            url: '@Url.Action("SetInactive")',
            data: { "ID": param.toString() },
            cache: false,
            success: function (res) {
                if (res == "Success") {
                    generateTable('firstload');
                    $('#modalsuccess').modal('show');
                    $('#notificationModal').modal('hide');
                } else {
                    $('#modalerror').modal('show');
                }
            }
        });
    }

    function generateTable(param) {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        var id = (param == "firstload") ? $("#IDCardNumberOrDrivingLicenseNumber").val() : ($("#IDCardNumberOrDrivingLicenseNumber").val() == null ? $("#IDCardNumberOrDrivingLicenseNumber").val() : $("#IDCardNumberOrDrivingLicenseNumber").val().toString()),
            idvendor = jQuery("#IDVendor").val() == null ? null : jQuery("#IDVendor").val().toString(),
            name = (param == "firstload") ? $("#Name").val() : ($("#Name").val() == null ? $("#Name").val() : $("#Name").val().toString()),
            roleDriver = $("#RoleDriver").val(),
            includeInActive = ($('#deleted').length > 0) ? (($('#all').prop("checked") == true ? 1 : 0)) : null;
        var isExportOrSearch;
        if (param == "firstload") {
            isExportOrSearch = false;
        } else if(param == "advSearch") {
            isExportOrSearch = true;
        }
        var filter = {
            "ID": id,
            "IDVendor": idvendor,
            "Name": name,
            "RoleDriver": roleDriver,
            "IncludeInActive": includeInActive,
            "IsExportOrSearch": isExportOrSearch
        };
        var table = $('#dtFilterDriverManagement').DataTable({
            "paging": true,
            "ordering": false,
            "filter": true,
            "destroy": true,
            "orderMulti": false,
            "serverSide": true,
            "processing": true,
            "pageLength": 10,
            "ajax": {
                    dataType: 'JSON',
                    type: 'POST',
                    url: '@Url.Action("GetTransportDriverManagementsTable", "DriverManagement")',
                    data: function (data) {
                        data.filter = filter;
                        return data
                    },
                    "complete": function (res) {
                        if (res.responseJSON.data.length == 0) {
                            alertSearchNoResult();
                        }
                        if (param != "advSearch") {
                            generateName(res.responseJSON.data);
                        }
                        dialog.modal('hide');
                    },
                    "error": function (res) {
                        dialog.modal('hide');
                    }
                },
                "columns": [
                    {
                        "data": "ID", "class": "text-center", "render": function (data, type, row, meta) {

                            return '<td><div class="checkbox-deck"><input type="checkbox" id="check[' + row["ID"] + ']&idvendor=check[' + row["IDVendor"] + ']" class="chkList" onchange="InsertTempArray()"><label for="check[' + row["ID"] + ']&idvendor=check[' + row["IDVendor"] + ']"></label></div></td>';
                        }
                    },
                    {
                        'data': 'Name', 'searchable': true, "render": function (data, type, row, meta) {
                            return (type == "display") ? '<a href="@Url.Action("AddNew")?id=' + row.ID + '&idvendor=' + row.IDVendor + '">' + data + '</a>' :
                            data;
                        }
                    },

                    { "data": 'IDVendor', 'searchable': true,
                        "render": function (data, type, row, meta) {
                            return '<p>' + row.MasterVendor.VendorName + '</p>';
                        }
                    },
                    {
                        'data': 'DrivingLicensePeriod', 'searchable': true, "render": function (datum, type, row, meta) {
                            var output = '';
                            if (datum != null) {
                                var datumNumber = Number(datum.match(/\d+/)[0]);
                                output = (parseInt(datumNumber) < 2209014000000) ? '<label style="font-weight: 200;">' + moment(datum).format("DD-MMM-YYYY") + '</label>' : '';
                                return output;
                            } else {
                                return '<label style="font-weight: 200;"></label>';
                            }

                        }
                    },
                    {
                        "data": "IsActive", "render": function (data) {
                            if (data != null) {
                                return (data) ? '<div>Active</div>' : '<div>In Active</div>';
                            } else {
                                return '<div></div>';
                            }

                        }
                    },
                    { 'data': 'RoleDriver', 'searchable': true },
                ],
                //"dom": 'lf<"table-overflow"t>ip',
                orderCellsTop: true
            });
            $('.dataTables_filter input').attr("placeholder", "Search Here");
            $('#dtFilterDriverManagement thead.filters th').each(function (index) {
                if (index > 0) {
                    var title = $('#dtFilterDriverManagement thead.filters th').eq($(this).index()).text();
                    $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                }
            });

            table.columns().every(function (index) {
                if (index > 0) {
                    $('#dtFilterDriverManagement thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.settings()[0].jqXHR.abort();
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                }
            });
    }
    var excelParam;

    function exportToExcelDefault() {
        bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        var id = $("#IDCardNumberOrDrivingLicenseNumber").val(),
            idvendor = jQuery("#IDVendor").val() == null ? null : jQuery("#IDVendor").val().toString(),
            name = $("#Name").val() == null ? "" : $("#Name").val(),
            roleDriver = $("#RoleDriver").val(),
            includeInActive = ($('#deleted').length > 0) ? (($('#all').prop("checked") == true ? 1 : 0)) : null;
        if (name != null) {
            if (name.length > 1) {
                name = name.join(",")
            }
        }
        var input = {
            "ID": id,
            "IDVendor": idvendor,
            "Name": name,
            "RoleDriver": roleDriver,
            "IncludeInActive": includeInActive
        };

        jQuery.ajax({
            url: '@Url.Action("ExportToExcelDefault")',
            method: 'post',
            dataType: 'json',
            data: input,
            success: function (response) {
                window.location.assign("Assets/Download/" + response);
                bootbox.hideAll();
            }
        });
    }
