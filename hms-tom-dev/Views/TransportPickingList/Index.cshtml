@using System.Web.Mvc.Html
@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.Transport.TransportOrderViewModel

@{
    ViewBag.Title = "Transport > Picking List > List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
}

<style>
    .tabDayPickingList {
        font-size: 20px;
        cursor: pointer;
        margin-right: 50px;
    }

    a.disabled {
        color: gray;
        pointer-events: none;
        cursor: default;
    }

    .labelGenerateSap {
        margin-top: 13px;
    }

    /*thead tr th {
        text-align: center;
    }*/

    .summaryTitle {
        width: 20%;
        padding-left: 6px;
    }

    .summaryNumber {
        text-align: right;
        width: 50px;
    }

    .fc-selected {
        background-color: #f39814 !important;
    }
    .modal-body {
        position: relative;
        padding: 15px;
        max-height: 450px;
        overflow-y: auto;
    }
    .datepicker {
        z-index: 999 !important;
    }
    #modalGenerateSAPFile .modal-dialog {
        min-width: 70%;
    }
    #modalGenerateSAPFile .modal-dialog .modal-body {
        min-height: 335px;
    }
</style>


