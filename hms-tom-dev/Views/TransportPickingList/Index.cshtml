        var b = moment(b).format("YYYY, MM, DD HH:mm").toString();
        //console.log("date = "+b);
        var u = $("#DrpDownLogBatch").val().split("-")[1];

        $.ajax({
            url: '@Url.Action("DeleteBatchData", "TransportPickingList")',
            method: 'POST',
