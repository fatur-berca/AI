    function searchData() {
        $('#modalloading').modal('show');
        var f = $("#LogDateFrom").val();
        var f = new Date(f.split("/")[1] + '/' + f.split("/")[0] + '/' + f.split("/")[2]);
        var f = moment(f).format("YYYY, MM, DD").toString();

        var t = $("#LogDateTo").val();
        var t = new Date(t.split("/")[1] + '/' + t.split("/")[0] + '/' + t.split("/")[2]);
        var t = moment(t).format("YYYY, MM, DD").toString();
        //console.log("batch " + $("#DrpDownLogBatch").val());
        if ($("#DrpDownLogBatch").val() != undefined && $("#DrpDownLogBatch").val() != null) {
            var b = $("#DrpDownLogBatch").val().split("-")[0];
            //console.log(b.split("/"));
            var b = new Date(b.split("/")[1] + '/' + b.split("/")[0] + '/' + b.split("/")[2]);
            //console.log("2"+b);
            var b = moment(b).format("YYYY, MM, DD HH:mm:ss").toString();
            //console.log("3"+b);
            var u = $("#DrpDownLogBatch").val().split("-")[1];
        } else {
            var b = new Date();
            var b = moment(b).format("YYYY, MM, DD HH:mm:ss").toString();
            var u = "";
        }

        //console.log(b);

        $.ajax({
            url: '@Url.Action("SearchBatchData", "TransportPickingList")',
            method: 'GET',
            dataType: 'json',
            cache: false,
            data: { tbtc: b, usr: u, tfrom: f, tto: t },
            success: function (data) {
                var table = $('#dtLogPickingList').DataTable({
                    'destroy': true,
                    'data': data,
                    'paging': true,
                    'searching': true,
                    'iDisplayLength': 25,
                    aaSorting: [[1, 'asc']],
                    columns: [
                        { 'data': 'IDTransportOrder', 'class': 'hidden' },
                        {
                            'data': 'IsActive', 'class': 'text-center', 'render': function (data) {
                                if (data == true) {
                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                }
                                else {
                                    return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>';
                                }
                            }, 'sortable': false
                        },
                        //{ 'data': 'STONo', 'searchable': true, 'sortable': false },
                        {
                            'data': 'STONo', 'render': function (data) {
                                if (data == null) {
                                    return '';
                                }
                                else {
                                    return data;
                                }
                            }, 'searchable': true, 'sortable': false
                        },
                        {
                            render: function (data, type, row) {
                                var date = new Date(parseInt(row['ShipmentDate'].substr(6)));
                                var formatted = date.getFullYear() + "-" +
                                    ("0" + (date.getMonth() + 1)).slice(-2) + "-" +
                                    ("0" + date.getDate()).slice(-2) + " " + date.getHours() + ":" +
                                    date.getMinutes();
                                var jamtanggal = moment(row['ShipmentDate']).format("DD MMM YYYY");

                                return jamtanggal;
                            }, 'sortable': false
                        },
                        { 'data': 'SenderIDLocation', 'searchable': true, 'sortable': false },
                        { 'data': 'ReceiverIDLocation', 'searchable': true, 'sortable': false },
                        { 'data': 'ZoneBased', 'searchable': true, 'sortable': false },
                        {
                            'data': 'SeqNo', "render": function (data, type, row, meta) {
                                return row["SeqNo"] == null ? row["DefaultSeqNo"] : row["SeqNo"];
                            }, 'sortable': false
                        }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");

                // Setup - add a text input to each footer cell
                $('#dtLogPickingList thead.filters th').each(function (index) {
                    if (index >= 2 && index <= 7) {
                        if (index == 2) { mx = '10'; } else { mx = ''; }
                        var title = $('#dtLogPickingList thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" maxlength="' + mx + '" placeholder="Search ' + title + '" />');
                    }
                });

                //searching with column on datatable
                table.columns().every(function (index) {
                    if (index >= 2 && index <= 7) {
                        $('#dtLogPickingList thead.filters th:eq(' + index + ') input').on('input', function () {
                            table.column($(this).parent().index() + ':visible')
                                .search(this.value)
                                .draw();
                        });
                    }
                });

                $('#modalloading').modal('hide');
            }
        });
    }

    function deleteData() {
