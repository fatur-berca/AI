                        <div class="col-md-5">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <br />
                                <input type="text" class="form-control datepicker" id="LogDateTo" data-date-format="DD/MM/YYYY">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="col-md-5">
                            <div class="form-group">
                                <label>Batch</label>
                                <select class="form-control" id="DrpDownLogBatch" width="100%"></select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <br />
                                <button id="btnLogSearch" class="btn btn-primary">Search</button>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <br />
                                <button id="btnLogDelete" class="btn btn-primary">Delete</button>
