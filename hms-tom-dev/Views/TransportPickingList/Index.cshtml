                "DateTo": DateTo,
                "DocDate": moment(new Date()).format("DD/MM/YYYY").replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                "uploadedBy": StruploadedBy
            },
            dataType: 'json',
