    -->
    <div class="title-deck wmb">
        <div class="button-wrap pull-left">
@if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
{
            <button class="btn btn-primary" type="button" id="btnExportReport" data-toggle="modal" data-target="#modalExport">Export</button>
}
@if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
{
            <button class="btn btn-primary" type="button" id="btnCustomReport">Custom Report</button>
}
@if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Upload)))
{
            <button class="btn btn-primary" type="button" id="btnPopUpUpload" data-toggle="modal" data-target="#modalUploadPickingList">Upload</button>
}
@if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Email)))
{
            <button class="btn btn-primary" id="btnEmail">Email</button>
}
@if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.GenerateSAP)))
{
            <button class="btn btn-primary" type="button" id="btnGenerateSAP" data-toggle="modal" data-target="#modalGenerateSAPFile">Generate SAP File</button>
}
@if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Log)))
{
            <button class="btn btn-primary" type="button" id="btnLog" data-toggle="modal" data-target="#modalLog">Log</button>
}
        </div>
        <a href="#filter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter" id="advSearch"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
    </div>
    <div class="filter-deck nmb">
        <div id="filter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
            <div class="col-panel">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>STO Number</label>
                            @*<select class="select2" multiple="multiple" id="FilterSTONumber"></select>*@
                            <input class="filterAdvance" type="hidden" style="width:250px" id="FilterSTONumber" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Zone</label>
                            @*<select class="form-control" id="FilterZone"></select>*@
                            @Html.DropDownListFor(model => Model.Zone, Model.zoneList, new { @class = "filterAdvance form-control", id = "FilterZone" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Week</label>
                            @*<select class="form-control" id="FilterWeek"></select>*@
                            @Html.DropDownListFor(model => Model.weekNow,
                                new SelectList(Enumerable.Range(1, 53).Select(r => new { Text = r.ToString(), Value = r }), "Value", "Text", Model.ListWeeks), new { @class = "filterAdvance form-control", id = "FilterWeek" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Year</label>
                            @*<select class="form-control" id="FilterYear"></select>*@
                            @Html.DropDownListFor(model => Model.yearNow,
                                new SelectList(Enumerable.Range(-2, 5).Select(r => new { Text = (DateTime.Now.Year + r).ToString(), Value = DateTime.Now.Year + r }), "Value", "Text", Model.ListYears), new { @class = "filterAdvance form-control", id = "FilteYear" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Sender</label>
                            @*<select class="select2" multiple="multiple" class="form-control" id="FilterSender"></select>*@
                            @Html.DropDownListFor(model => Model.SenderIDLocation, Model.senderList, new { @multiple = "multiple", @id = "FilterSender", @class = "filterAdvance" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Receiver</label>
                            @*<select class="select2" multiple="multiple" class="form-control" id="FilterReceiver"></select>*@
                            @Html.DropDownListFor(model => Model.ReceiverIDLocation, Model.receiveList, new { @multiple = "multiple", @id = "FilterReceiver", @class = "filterAdvance" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Uploaded By</label>
                            <select id="FilterUploadedBy" class="form-control"></select>
                            @*@Html.DropDownListFor(model => Model.UploadedBy.Select(x => x.Value), Model.UploadedBy.Select(x => x.Text), new { @id = "FilterUploadedBy", @class = "form-control" })*@
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12">
                    <button type="button" class="btn btn-primary" id="btnSearch">Search</button>
                    <button type="button" class="btn btn-purple" id="btnReset">Reset</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalUploadPickingList" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">Upload</h4>
            </div>
            <div class="modal-body">
                <form id="frmUploadPickingList">
                    <div class="row">
                        <div class="col-md-9">
                            <div class="form-group">
                                <label>Upload Picking List</label>
                                <input id="uploadPickingList" type="file" name="" class="filestyle" accept=".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel">
                                <label style="color:red">*Uploaded data PO will replace existing data</label>
                                <a href="Assets/Download/TemplateExcel/UploadTransportPickingListTemplate.xlsx">Download Template</a>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label>&nbsp;</label>
                            <br />
                            <button type="button" id="btnUploadPickingList" class="btn btn-primary" disabled>Upload</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalGenerateSAPFile" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">Generate SAP File</h4>
            </div>
            <div class="modal-body">
                <form id="frmGenerateSAPFile">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="labelGenerateSap">Shipment Date</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <input type="text" class="form-control datepicker" id="GenerateSAPDateFrom" data-date-format="DD/MM/YYYY">
                            </div>
                        </div>
                        <div class="col-md-1">
                            <div class="form-group">
                                <label class="labelGenerateSap">To</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <input type="text" class="form-control datepicker" id="GenerateSAPDateTo" data-date-format="DD/MM/YYYY">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="labelGenerateSap">Uploaded By</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <select class="form-control" id="GenerateSAPUploadedBy">
                                    <option value="">All</option>
                                    <option value="PMI\DWardhan">Wardhani Dwi Puspita</option>
                                    <option value="pmi\mkurnia2">Muhammad Ikhsan Kurniawan</option>
                                    <option value="PMI\faurino1">Fendy Aurino</option>
                                    <option value="PMI\NMelisa">Nydia Melisa</option>
                                    <option value="PMI\JJo2">Joanna Jo</option>
                                    <option value="PMI\DPratama3">Denny Pratama</option>
                                    <option value="PMI\AJanardo">Aditya Janardono</option>
                                    <option value="pmi\maudrey">Audrey, Marcella</option>
                                    @*<option value="pmi\ksiswoad">Kristian Praba Raditya Siswoadji</option>*@
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnGenerateSAPFile" class="btn btn-primary">Generate</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalExport" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">Export</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>
                                <input type="radio" id="chkExportPickingListRawData" name="exportType">
                                <span class="checkbox-deck-span">Raw Data</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>
                                <input type="radio" id="chkExportPickingListForm" name="exportType">
                                <span class="checkbox-deck-span">Picking List Form</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="#" id="exportLink">
                    <button disabled="disabled" id="btnExport" class="btn btn-primary">Export</button>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalLog" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">Log</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="col-md-5">
                            <div class="form-group">
                                <label>Shipment Date</label>
                                <input type="text" class="form-control datepicker" id="LogDateFrom" data-date-format="DD/MM/YYYY">
                            </div>
                        </div>
                        <div class="col-md-1">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <br />
