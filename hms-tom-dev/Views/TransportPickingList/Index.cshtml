                                    <th hidden>sorting</th>
                                    <th class="text-center">Filter</th>
                                    <th >STO Number</th>
                                    <th>Shipment Date</th>
                                    <th>Sender</th>
                                    <th>Receiver</th>
                                    <th>Zone</th>
                                    <th>Sequence</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="customReport" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Custom Report</h4>
            </div>
            <div class="modal-body custom-report">
                <div class="row label-top">
                    <div class="col-md-6">
                        <label>Column Set</label>
                    </div>
                    <div class="col-md-6">
                        <label class="dis">Displayed Columns</label>
                        <select id="layoutSelect" class="form-control">
                            <option value="">Loading...</option>
                        </select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div id="fieldChooser" tabindex="1" class="field-chooser form-group">
                    <div id="sourceFields" class="source">
                        <div data-field="STONumber" class="ui-draggable">STO Number</div>
                        <div data-field="Supplier" class="ui-draggable">Supplier</div>
                        <div data-field="Item" class="ui-draggable">Item</div>
                        <div data-field="Brand" class="ui-draggable">Brand</div>
                        <div data-field="Qty" class="ui-draggable">Qty</div>
                        <div data-field="UoM" class="ui-draggable">UoM</div>
                        <div data-field="ShipmentDate" class="ui-draggable">Shipment Date</div>
                        <div data-field="Sender" class="ui-draggable">Sender</div>
                        <div data-field="Receiver" class="ui-draggable">Receiver</div>
                        <div data-field="Sequence" class="ui-draggable">Sequence</div>
                        <div data-field="VehicleType" class="ui-draggable">Vehicle Type</div>
                        <div data-field="Remarks" class="ui-draggable">Remarks</div>
                        <div data-field="CreatedBy" class="ui-draggable">Created By</div>
                        <div data-field="UpdatedBy" class="ui-draggable">Updated By</div>
                        @*<div data-field="STONumber" class="ui-draggable" index="1" width="20">STO Number</div>
                        <div data-field="ShipmentDate" class="ui-draggable" index="2" width="18">Shipment Date</div>
                        <div data-field="Sender" class="ui-draggable" index="3" width="15">Sender</div>
                        <div data-field="Receiver" class="ui-draggable" index="4" width="15">Receiver</div>
                        <div data-field="Zone" class="ui-draggable" index="5" width="12">Zone</div>
                        <div data-field="Sequence" class="ui-draggable" index="6" width="10">Sequence</div>*@
                    </div>
                    <div class="button-column">
                        <div>
                            <input class="btn btn-info mini" type="button" id="left" value="<">
                            <input class="btn btn-info mini" type="button" id="right" value=">">
                        </div>
                    </div>
                    <div id="destinationFields" class="destination"></div>
                </div>
                <div class="opt-bot">
                    <div class="row">
                        <div class="col-md-6">
                            <input class="btn btn-info amr" type="button" id="rightall" value=">>">
                            <input class="btn btn-info" type="button" id="leftall" value="<<">
                        </div>
                        <div class="col-md-6">
                            <input class="btn btn-info" type="button" id="btnSaveLayout" value="Save Layout">
                            <input type="text" class="form-control" id="layoutName">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @foreach (var x in listUserRole)
                {
                    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
                    {
                        <div class="form-group pull-left">
                            <div class="checkbox-deck">
                                <input type="checkbox" id="chkGlobalCustomReport">
                                <label for="chkGlobalCustomReport"></label>
                            </div>
                            <span class="checkbox-deck-span">Global Custom Report</span>
                        </div>
                    }
                }
                <button class="btn btn-primary" id="btnExportCustomReport">Export</button>
                <button class="btn btn-purple" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>



