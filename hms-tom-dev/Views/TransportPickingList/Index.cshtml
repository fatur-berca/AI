    $('#LogDateFrom').on('dp.change', function (e) {
        var s = moment();
        var d = new Date(s);
        var d = parseInt(moment(d).format("YYYYMMDD").toString());

        var f = $(this).val();
        var f = new Date(f.split("/")[1] + '/' + f.split("/")[0] + '/' + f.split("/")[2]);
        var f = parseInt(moment(f).format("YYYYMMDD").toString());

        var t = $("#LogDateTo").val();
        var t = new Date(t.split("/")[1] + '/' + t.split("/")[0] + '/' + t.split("/")[2]);
        var t = parseInt(moment(t).format("YYYYMMDD").toString());

        if (f > d) {
            if(f > t){
                $("#LogDateTo").val($(this).val());
            }
        }
        else {
            $(this).val(moment(s).format("DD/MM/YYYY").toString());
        }

        generateListBatch();
    });

    $('#LogDateTo').on('dp.change', function (e) {
        var s = moment();

        var d = new Date(s);
        var d = parseInt(moment(d).format("YYYYMMDD").toString());

        var t = $("#LogDateTo").val();
        var t = new Date(t.split("/")[1] + '/' + t.split("/")[0] + '/' + t.split("/")[2]);
        var t = parseInt(moment(t).format("YYYYMMDD").toString());

        var f = $("#LogDateFrom").val();
        var f = new Date(f.split("/")[1] + '/' + f.split("/")[0] + '/' + f.split("/")[2]);
        var f = parseInt(moment(f).format("YYYYMMDD").toString());

        if (f > t) {
            $("#labelCheck").html("");
            $("#labelCheck").html("Shipment Date To Must be Greater than Shipment Date From");
            $('#modalwarning').modal('show');
            $("#LogDateTo").val($("#LogDateFrom").val());
        }
        else {
            if (t >= d) {
                generateListBatch();
            }
            if (t < d) {
                $("#LogDateTo").val(moment(s).format("DD/MM/YYYY").toString());
            }
        }
    });

