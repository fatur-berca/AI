            {
                <input type="text" id="Supplier" class="form-control" value="@(Model.Supplier ?? "")" disabled>
            }
            else
            {
                <input type="text" id="Supplier" class="form-control differentYellow" value="@(Model.Supplier ?? "")" disabled>
            }
        </div>
    </div>*@
    <div class="col-md-2">
        <div class="form-group">
            <label>Shipment Date</label>
            <input type="hidden" id="OrderStatus" value="@Model.OrderStatus" />
            @if (Model.ShipmentDateColor == null)
            {
                <input type="text" id="ShipmentDate" class="form-control" value="@Model.ShipmentDate.ToString("dd-MMM-yyyy")" disabled>
            }
            else
            {
                <input type="text" id="ShipmentDate" class="form-control differentYellow" value="@Model.ShipmentDate.ToString("dd-MMM-yyyy")" disabled>
            }
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Vehicle Type</label>
            @Html.DropDownListFor(model => Model.VehicleType, Model.VehicleTypeList, new { @class = "form-control", @disabled = "disabled" })
            @*<select class="form-control" id="VehicleType"></select>*@
        </div>
    </div>
    <div class="col-md-1">
        <div class="form-group">
            <label>Zone</label>
            @*@if (Model.IDTransportOrder == 0)
            {*@
                <input type="text" id="Zone" class="form-control" value="@(Model.ZoneBased ?? "")" disabled>
            @*}
            else
            {
                <input type="text" id="Zone" class="form-control differentYellow" value="@(Model.ZoneBased ?? "")" disabled>
            }*@
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Sequence</label>
            @if (string.IsNullOrEmpty(Model.SeqNo))
            {
                <input type="text" id="Sequence" class="form-control" value="" disabled>
            }
            else
            {
                <input type="text" id="Sequence" class="form-control" value="@(Model.SeqNo)" disabled>
            }
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label>Sender</label>
            @if (Model.SenderLocationColor == null)
            {
                <input type=text id="Sender" class="form-control" value="@(Model.MasterLocation2 == null ? "" : Model.MasterLocation2.LocationName)" disabled>
            }
            else
            {
                <input type=text id="Sender" class="form-control differentYellow" value="@(Model.MasterLocation2 == null ? "" : Model.MasterLocation2.LocationName)" disabled>
            }
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label>Receiver</label>
            @if (Model.ReceiverLocationColor == null)
            {
                <input type=text id="Receiver" class="form-control" value="@(Model.MasterLocation3 == null ? "" : Model.MasterLocation3.LocationName)" disabled>
            }
            else
            {
                <input type=text id="Receiver" class="form-control differentYellow" value="@(Model.MasterLocation3 == null ? "" : Model.MasterLocation3.LocationName)" disabled>
            } 
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label>Remarks</label>
            <textarea id="Remarks" class="form-control" style="height: 70px;" disabled>@(Model.Remarks ?? "")</textarea>
        </div>
    </div>
</div>
<h3><b><u>Cargo Information</u></b></h3>
<div class="row">
    <div class="col-md-2">
        <div class="form-group">
            <Label>Material Type</Label>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <Label>Supplier</Label>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Code</label>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Description</label>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label>Quantity</label>
        </div>
    </div>
    <div class="col-md-1" style="padding-right:10px">
        <div class="form-group">
            <label>Uom</label>
        </div>
    </div>
    <div class="col-md-1" style="padding-right:10px">
        <div class="form-group">
            <label>Action</label>
        </div>
    </div>
</div>

<div id="templateitem" hidden>
    <div class="row row-generate-detail orderDetail" data-is-active="true">
        <div class="col-md-2">
            <div class="form-group">
                <input type="hidden" class="hidden orderIdDetail" value="" />
                <input type="text" class="form-control MaterialType" value="" disabled>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                    @Html.DropDownListFor(model => Model.TransportOrderDetails.First().Supplier, Model.SupplierList, new { @class = "Supplier form-control editable", @disabled = "disabled" })
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <input type="text" class="form-control editable Code" value="" disabled>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <input type="text" class="form-control editable Description" value="" disabled>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <input type="text" class="form-control editable Qty" value="" disabled>
                </div>
            </div>
            <div class="col-md-1" style="padding-left:10px">
                <div class="form-group">
                    <input type="text" class="form-control viewable" value="" disabled>
                    @Html.DropDownListFor(model => Model.TransportOrderDetails.First().UoM, Model.UoMList, new { @class = "form-control editable UoM", @disabled = "disabled", @style = "display:none" })
                </div>
            </div>
            <div class="col-md-1">
                <button type="button" class="btn-default btn-s btnAddMat copyDetailRoute editable" title="Add Detail" disabled><i class="fa fa-plus"></i></button>
                <button type="button" class="btn-default btn-s btnDeleteMat copyDetailRoute editable" title="Delete Detail" disabled><i class="fa fa-trash"></i></button>
            </div>
        </div>
</div>


<div id="GenerateDetail" class="generateDetail">
    @{
        foreach (var item in Model.TransportOrderDetails)
        {
            int i = 0;
            if (item != null) 
            { 
                <div class="row row-generate-detail orderDetail" data-is-active="true">
                    <div class="col-md-2">
                        <div class="form-group">
                            <input type="hidden" class="hidden orderIdDetail" value="@item.IDTransportOrderDetail" />
                            <input type="hidden" class="hidden IDTO" value="@item.IDTransportOrder" />
                            @if (item.MaterialTypeColor == null)
                            {
                                <input type="text" class="form-control MaterialType" value="@item.MaterialType" disabled>
                            }
                            else
                            {
                                <input type="text" class="form-control differentYellow MaterialType" value="@item.MaterialType" disabled>
                            }
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @if (item.SupplierColor == null)
                            {
                                @Html.DropDownListFor(model => item.Supplier, new SelectList(Model.SupplierList, "Value", "Text", item.Supplier), new { @class = "Supplier form-control editable", @disabled = "disabled" })
                            }
                            else
                            {
                                @Html.DropDownListFor(model => item.Supplier, new SelectList(Model.SupplierList, "Value", "Text", item.Supplier), new { @class = "Supplier form-control editable differentYellow", @disabled = "disabled" })
                            }
                        </div>
                        <!-- input type="text" class="form-control editable" value="@item.Supplier" disabled -->
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @if (item.CodeColor == null)
                            {
                                <input type="text" class="form-control editable Code" value="@item.Code" disabled>
                            }
                            else
                            {
                                <input type="text" class="form-control differentYellow editable Code" value="@item.Code" disabled>
                            }
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @if (item.DescriptionColor == null)
                            {
                                <input type="text" class="form-control editable Description" value="@item.Description" disabled>
                            }
                            else
                            {
                                <input type="text" class="form-control differentYellow editable Description" value="@item.Description" disabled>
                            }
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @{
                                var qty = item.Qty.HasValue ? item.Qty.Value.ToString("#") : "0";
                            }
                            @if (item.QtyColor == null)
                            {
                                <input type="text" class="form-control editable Qty" value="@qty" disabled>
                            }
                            else
                            {
                                <input type="text" class="form-control editable Qty differentYellow" value="@qty" disabled>

                            }
                        </div>
                    </div>
                    <div class="col-md-1" style ="padding-left:10px">
                        <div class="form-group">
                            @if (item.UoMColor == null)
                            {
                                <input type="text" class="form-control viewable" value="@item.UoM" disabled>
                                @Html.DropDownListFor(model => model.TransportOrderDetails[i].UoM, new SelectList(Model.UoMList, "Value", "Text", item.UoM)@*Model.UoMList*@, new { @class = "form-control editable UoM", @disabled = "disabled", @style = "display:none" })
                            }
                            else
                            {
                                <input type="text" class="form-control viewable differentYellow" value="@item.UoM" disabled>
                                @Html.DropDownListFor(model => model.TransportOrderDetails[i].UoM, new SelectList(Model.UoMList, "Value", "Text", item.UoM)@*Model.UoMList*@, new { @class = "form-control editable UoM differentYellow", @disabled = "disabled", @style = "display:none" })
                            }
                        </div>
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn-default btn-s btnAddMat copyDetailRoute editable" title="Add Detail" disabled><i class="fa fa-plus"></i></button>
                        <button type="button" class="btn-default btn-s btnDeleteMat copyDetailRoute editable" title="Delete Detail" disabled><i class="fa fa-trash"></i></button>
                    </div>
                </div>
                i++;
            }
        }
    }




