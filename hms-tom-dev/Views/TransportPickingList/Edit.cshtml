<div class="modal fade ml-warning" id="warningModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="warningUpload">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="../assets/images/danger.png" alt="">
                <span id="textModalWarning"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
 
<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="../assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="location.reload()" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        @foreach (var changes in TOchangeLog)
        {
            if(changes.ModifiedField.ToString().ToUpper() == "VEHICLE TYPE")
            {
                <text>$("#VehicleType").addClass("differentYellow");</text>
            }
            if(changes.ModifiedField.ToString().ToUpper() == "REMARKS")
            {
                <text>$("#Remarks").addClass("differentYellow");</text>
            }
            if(changes.ModifiedField.ToString().ToUpper() == "SEQUENCE")
            {
                <text>$("#Sequence").addClass("differentYellow");</text>
            }
        }

        if ($("#OrderStatus").val() == 'Close') {
            $('#btnEdit').attr('disabled', 'disabled');
        }
    });
    var idFieldMandatory = ["VehicleType", "Sequence"];
    $("#btnEdit").click(function () {
        if ($("#OrderStatus").val() == "Submit" || $("#OrderStatus").val() == "Draft")
            enabledFormNoSeq();
        else
            enabledFormNoSeq();


        if ($("#Sequence").val() === null || $("#Sequence").val() === undefined || $("#Sequence").val() === "") {
            //enabledFormNoSeq();
            idFieldMandatory = ["VehicleType"];
        }
        else {
            //enabledForm();
            idFieldMandatory = ["VehicleType", "Sequence"];
        }
    });

    $(".btnDeleteMat").click(function () {
        var tod = $(this).parent().parent();
        tod.attr("data-is-active", "false");
        tod.hide();
    });

    $(".btnAddMat").click(function () {
        var mt = $(this).parent().parent().find(".MaterialType").first().val();
        var cln = $("#templateitem").children().first().clone(true, true);
        cln.find(".MaterialType").val(mt);
        console.log(mt);
        $("#GenerateDetail").first().append(cln);
    });

    $(".Code").on("change", function () {
        var val = $(this).val();
        var local = this;
        if (val)
            $.ajax({
                url: '@Url.Action("GetSpeakingCode", "TransportationOrder")',
                data: { code: val },
                success: function (data) {
                    console.log(data);
                    if (data != null && data != "")
                        $(local).parent().parent().parent().find(".Description").val(data);
                }
            });
    });

    function disabledForm() {
        $("#btnEdit").removeAttr('disabled', 'disabled');
        $("#btnSave").attr('disabled', 'disabled');
        $("#VehicleType").attr('disabled', 'disabled');
        $("#Sequence").attr('disabled', 'disabled');
        $("#Remarks").attr('disabled', 'disabled');
        $("#Qty").attr('disabled', 'disabled');
        $("#UoM").attr('disabled', 'disabled');
        $(".editable").attr('disabled', 'disabled');
        $(".viewable").attr('style', 'display:block');
        $(".UoM").attr('style', 'display:none');
    }

    function enabledForm() {
        $("#btnEdit").attr('disabled', 'disabled');
        $("#btnSave").removeAttr('disabled', 'disabled');
        $("#VehicleType").removeAttr('disabled', 'disabled');
        $("#Sequence").removeAttr('disabled', 'disabled');
        $("#Remarks").removeAttr('disabled', 'disabled');
    }

    function enabledFormNoSeq() {
        $("#btnEdit").attr('disabled', 'disabled');
        $("#btnSave").removeAttr('disabled', 'disabled');
        $("#VehicleType").removeAttr('disabled', 'disabled');
        $("#Sequence").removeAttr('disabled', 'disabled');
        $("#Remarks").removeAttr('disabled', 'disabled');
        $("#Qty").removeAttr('disabled', 'disabled');
        $("#UoM").removeAttr('disabled', 'disabled');
        $(".editable").removeAttr('disabled', 'disabled');
        $(".viewable").attr('style', 'display:none');
        $(".UoM").attr('style', 'display:block');
    }

    function checkField(arrayField) {
        var invalid = false;
        for (var i = 0; i < arrayField.length; i++) {
            var elemen = document.getElementById(arrayField[i]);
            if (elemen.value == "" || elemen.value == "null") {
                invalid = true;
                elemen.className += " txt-invalid";
            } else
                elemen.classList.remove("txt-invalid");
        }
        return invalid;
    }

    function checkMaterial() {
        var valid = true;
        var check = ["Qty", "UoM", "Code", "Description", "Supplier"];
        $("#GenerateDetail").find(".orderDetail").each(function (e) {
            if (!($(this).attr("data-is-active") == "true" || $(this).attr("data-is-active") === true))
                return;

            for (var i = 0; i < check.length; i++) {
                var c = check[i];
                var val = $(this).find("." + c).val() || "";
                console.log(val, val == "" || (c == "Qty" && !Number(val)));
                if (val == "" || (c == "Qty" && !Number(val))) {
                    $(this).find("." + c).first().addClass("txt-invalid");
                    valid = false;
                }
                else
                    $(this).find("." + c).first().removeClass("txt-invalid");
            }
        });
        return valid;
    }
    
    $("#btnSave").click(function () {
        var arr = idFieldMandatory;
        if (!checkField(arr) && checkMaterial()) {
            saveData();
        } else {
            $("#textModalWarning").html("");
            $("#textModalWarning").append("Please fill field with red mark");
            $('#warningModal').modal('show');
        }
    });

    function saveData() {
        var objectSave = new Object();
        if ($("#Sequence").val() === null || $("#Sequence").val() === undefined || $("#Sequence")) {
            var index = 0;
            objectSave.TransportOrderDetails = [];
            $(".orderDetail").each(function (e) {
                var objectDetail = new Object();
                objectDetail.Qty = $(this).find(".Qty").val();
                objectDetail.UoM = $(this).find(".UoM").val();
                objectDetail.Code = $(this).find(".Code").val();
                objectDetail.Description = $(this).find(".Description").val();
                objectDetail.Supplier = $(this).find(".Supplier").val();
                objectDetail.IDTransportOrderDetail = $(this).find(".orderIdDetail").val();
                objectDetail.IDTransportOrder = $(".IDTO").first().val();
                objectDetail.IsActive = $(this).attr("data-is-active") == "true" || $(this).attr("data-is-active") === true;
                objectSave.TransportOrderDetails.push(objectDetail);
                index++;
            });
            objectSave.TransportOrderDetails.Qty = $("#Qty").val();
            objectSave.TransportOrderDetails.UoM = $("#UoM").val();
        }
        objectSave.STONo = $("#STONumber").val();
        objectSave.VehicleType = $("#VehicleType").val();
        objectSave.SeqNo = $("#Sequence").val();
        objectSave.Remarks = $("#Remarks").val();
        //console.log(objectSave);
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        $.ajax({
            type: 'POST',
            url: 'InsertList',
            cache: false,
            data: { insertData: objectSave },
            async: false,
            success: function () {
                dialog.modal("hide");
                disabledForm();
                $('#modalsuccess').modal('show');
            },
            error: function () {
                dialog.modal("hide");
            }
        });
    }
</script>