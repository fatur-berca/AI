@model hms_tom_dev.Models.Transport.TransportOrderViewModel
@using EnumHelper = DFIS.Utils.EnumHelper

@{
    ViewBag.Title = "Transport > Picking List > Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var TOchangeLog = Model.TransportOrderChangeLogs.ToList();
}

<style>
    .generateDetail {
        overflow-y: auto;
        min-height: 250px;
    }

    .row-generate-detail {
        margin-right: 0;
    }

    .differentYellow {
        border: 1px solid yellow !important;
        border-width: medium !important;
    }

    .txt-invalid {
        border: 1px solid red !important;
    }
    .btn-s {
        background: none;
        border: none;
        margin-top: 10px;
    }
</style>

<div class="row">
<div class="col-md-12">
    <div class="title-deck wmb">
        <div class="button-wrap pull-left">
            <button class="btn btn-purple" onclick="window.location.href = '@Url.Action("Index", "TransportPickingList")'">Back</button>
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Edit)))
            {
                <button type="button" class="btn btn-primary" id="btnEdit">Edit</button>
            }
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Save)))
            {
                <button type="button" class="btn btn-primary" id="btnSave" disabled>Save</button>
            }
        </div>
    </div>
</div>
<div class="col-md-12">
<div class="box">
<form>
<div class="row">
    <div class="col-md-2">
        <div class="form-group">
            <label>STO Number</label>
            <input type="text" id="STONumber" class="form-control" value="@(Model.STONo ?? "")" disabled>
        </div>
    </div>
    @*<div class="col-md-3">
        <div class="form-group">
            <label>Supplier</label>
