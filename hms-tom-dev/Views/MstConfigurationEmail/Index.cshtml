<script type="text/javascript">
    $(document).ready(function () {
        // BEGIN : GENERAL Logic
       
        $('#addNew').click(function () {
            resetData();
            $('#PageName').removeAttr('disabled');
            $('#InsertOrUpdate').val("INSERT");
            generateDropDown();
            generateDropDownEmail();
        });
