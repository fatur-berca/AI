    $('#btnSaveNew').click(function ()
     {
        if ($('#BodyEmail').val()== "" ) {

            $('#modalwarning').modal('show');
        } else {
            if ($('#InsertOrUpdate').val() == "UPDATE") {
                $('#setinactive').modal('show');
            } else {
                save(true);
            }
        }

    });

    function save(statusSave) {
        $('#Loading').modal('show');
        var x = document.getElementById("SelectReceiver");
        var valueselect = "";
        for (var i = 0; i < x.options.length; i++) {
            if (x.options[i].selected == true) {
                if (i < 1) {
                    valueselect = x.options[i].value;
                } else {
                    valueselect = valueselect +','+ x.options[i].value;
                }
            }
        }
        console.log(valueselect);
        var idconfigmail = $('#IDConfigMail').val();
        var pagename = $('#PageName').val();
        //var receiver = $('#Receiver').val();
        var receiver = valueselect;
        var bodyemail = $('#BodyEmail').val();
        var status = $('#Status :selected').val() == 1 ? true : false;
        var createddate = $('#CreatedDate').val();
        var createdby = $('#CreatedBy').val();
        var data;
        if (statusSave) {
            data = {
                "new": [{ "PageName": pagename, "Receiver": receiver, "BodyEmail": bodyemail, "IsActive": status }],
                "edit": [{}]
            };
        } else {
            data = {
                "new": [{}],
                "edit": [{ "IDConfigMail": idconfigmail, "PageName": pagename, "Receiver": receiver, "BodyEmail": bodyemail, "IsActive": status, "CreatedDate": createddate, "CreatedBy": createdby }]
            };
        }
        $.ajax({
            type: 'POST',
            url: 'MstConfigurationEmail/InsertList',
            data: data,
            success: function (result) {
                if (result == "Success"){
                    generateTable();
                    generateDropDown();
                    $('#modalsuccess').modal('show');
                    $('#Loading').modal('hide');
                    resetData();
                }
                else
                    $('#modalerror').modal('show');
                $('#Loading').modal('hide');
            }
        });
    }
    // END : Insert New Data
      
    //BEGIN : Edit Data
    function editTable(id) {
        $('#newData')[0].reset();
        $('#InsertOrUpdate').val("UPDATE");
        $('#PageName').attr('disabled', 'disabled');
        //generateDropDown();
        var table = $('#dtFilterMaster').DataTable();
        $('#dtFilterMaster tbody').one('click', 'tr', function () {
            var data = table.row(this).data();
            $('#IDConfigMail').val(data["IDConfigMail"]);
            // generateDropDownPageName(data["PageName"].trim());
            $("#PageName").val(data["PageName"]).trigger('change');
            $('#PageName').val(data["PageName"].trim());
          //  $('#SelectReceiver').val(data["Receiver"]);
           // $("#SelectReceiver").val(data["Receiver"]).trigger('change');

            var hasil;
            hasil = data["Receiver"].split(",");
            console.log(hasil);
            $('#SelectReceiver').val(hasil);
            $("#SelectReceiver").val(hasil).trigger('change');
            //var valArr = hasil;
            //i = 0, size = valArr.length;
            //for (i; i < size; i++) {
            //    //$("#SelectReceiver").multiselect("widget").find(":checkbox[value='" + valArr[i] + "']").attr("checked", "checked");
            //    //$("#SelectReceiver option[value='" + valArr[i] + "']").attr("selected", 1);
            //    //$("#SelectReceiver").multiselect("refresh");
            //    $('#SelectReceiver').val(valArr[i]);
            //    $("#SelectReceiver").val(valArr[i]).trigger('change');
            //}

            $('#BodyEmail').val(data["BodyEmail"]);
            if (data["IsActive"])
                $('#Status').val("1");
            else
                $('#Status').val("0");
            $('#CreatedDate').val(ToJavaScriptDate(data["CreatedDate"]));
            $('#CreatedBy').val(data["CreatedBy"]);
        });
        $('#inputModal').modal('show');
    }
    // END : Edit Data
    function ToJavaScriptDate(value) {
        var pattern = /Date\(([^)]+)\)/;
        var results = pattern.exec(value);
        var dt = new Date(parseFloat(results[1])).toISOString();
        return dt;
    }
</script>