@using EnumHelper = DFIS.Utils.EnumHelper
@{
    var listUserRole = ViewBag.ListUserRole;
}
@*<script src="~/Assets/Js/fieldChooser.min.js"></script>*@
<!-- Custom Report Modal Dialog -->
<style>
   
</style>
<div class="modal fade" id="customReportModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Custom Report</h4>
            </div>
            <div class="modal-body custom-report">
                <div class="row label-top">
                    <div class="col-md-6">
                        <label>Column Set</label>
                    </div>
                    <div class="col-md-6">
                        <label class="dis">Displayed Columns</label>
                        <select id="layoutSelect" class="form-control">
                            <option value="">Loading...</option>
                        </select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div id="fieldChooser" tabindex="1" class="field-chooser form-group">
                    <ul id="sourceFields" class="source">
                        <li><div data-field="TransportNo" class="custom-report-field" onclick="setHighlightCustomReport(this)">Transport No</div></li>
                        <li><div data-field="STONo" class="custom-report-field" onclick="setHighlightCustomReport(this)">Order No</div></li>
                        <li><div data-field="TransportDate" class="custom-report-field" onclick="setHighlightCustomReport(this)">Transport Date</div></li>
                        <li><div data-field="SenderIDLocation" class="custom-report-field" onclick="setHighlightCustomReport(this)">Sender</div></li>
                        <li><div data-field="ReceiverIDLocation" class="custom-report-field" onclick="setHighlightCustomReport(this)">Receiver</div></li>
                        <li><div data-field="Code" class="custom-report-field" onclick="setHighlightCustomReport(this)">Code</div></li>
                        <li><div data-field="Description" class="custom-report-field" onclick="setHighlightCustomReport(this)">Description</div></li>
                        <li><div data-field="Qty" class="custom-report-field" onclick="setHighlightCustomReport(this)">Qty</div></li>
                        <li><div data-field="UoM" class="custom-report-field" onclick="setHighlightCustomReport(this)">UoM</div></li>
                        <li><div data-field="LoadStartTime" class="custom-report-field" onclick="setHighlightCustomReport(this)">Load Start Time</div></li>
                        <li><div data-field="LoadFinishTime" class="custom-report-field" onclick="setHighlightCustomReport(this)">Load Finish Time</div></li>
                        <li><div data-field="UnloadStartTime" class="custom-report-field" onclick="setHighlightCustomReport(this)">Unload Start Time</div></li>
                        <li><div data-field="UnloadFinishTime" class="custom-report-field" onclick="setHighlightCustomReport(this)">Unload Finish Time</div></li>
                        <li><div data-field="LoadBoxperWorkingTime" class="custom-report-field" onclick="setHighlightCustomReport(this)">Load Box/Working Time</div></li>
                        <li><div data-field="UnloadBoxperWorkingTime" class="custom-report-field" onclick="setHighlightCustomReport(this)">Unload Box/Working Time</div></li>
                    </ul>
                    <div class="button-column">
                        <div>
                            <input class="btn btn-info mini" type="button" id="left" value="<">
                            <input class="btn btn-info mini" type="button" id="right" value=">">
                        </div>
                    </div>
                    <ul id="destinationFields" class="destination"></ul>
                </div>
                <div class="opt-bot">
                    <div class="row">
                        <div class="col-md-6">
                            <input class="btn btn-info amr" type="button" id="rightall" value=">>">
                            <input class="btn btn-info" type="button" id="leftall" value="<<">
                        </div>
                        <div class="col-md-6">
                            <input class="btn btn-info" type="button" id="saveLayoutButton" value="Save Layout">
                            <input type="text" class="form-control" id="layoutName">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @foreach (var x in listUserRole)
                {
                    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
                    {
                        <div class="form-group pull-left">
                            <div class="checkbox-deck">
                                <input type="checkbox" id="chkGlobalCustomReport">
                                <label for="chkGlobalCustomReport"></label>
                            </div>
                            <span class="checkbox-deck-span">Global Custom Report</span>
                        </div>
                    }
                }
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
                {
                    <button class="btn btn-primary" id="btnExportCustomReport">Export</button>
                }
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Close)))
                {
                    <button class="btn btn-purple" data-dismiss="modal">Close</button>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .fc-selected {
        background-color: #f39814 !important;
    }

    /*SORTABLE STYLE*/
    body.dragging, body.dragging * {
        cursor: move !important;
    }

    .dragged {
        position: absolute;
        opacity: 0.5;
        z-index: 2000;
    }

    ul {
        list-style-type: none;
    }

        ul.RouteMainSortable li.placeholder, ul.RouteAdditionalSortable li.placeholder, ul.RouteStartLocation li.placeholder, ul.RouteSortable li.placeholder, ul.RouteFinishLocation li.placeholder {
            position: relative;
            /** More li styles **/
        }

            ul.RouteMainSortable li.placeholder:before, ul.RouteAdditionalSortable li.placeholder:before, ul.RouteStartLocation li.placeholder:before, ul.RouteSortable li.placeholder:before, ul.RouteFinishLocation li.placeholder:before {
                position: absolute;
                /** Define arrowhead **/
            }

    .RouteMainSortable, .RouteMainSortable ul, .RouteMainSortable li, .RouteAdditionalSortable, .RouteAdditionalSortable ul, .RouteAdditionalSortable li {
        display: inline;
    }
    /*SORTABLE STYLE*/
</style>

<script type="text/javascript">
    jQuery(function ($) {
        $("#fieldChooser").fieldChooser($("#sourceFields"), $("#destinationFields"));

        $(document).on('click', '#saveLayoutButton', function (e) {
            saveLayout();
            e.preventDefault();
        });

        $(document).on('click', '#left', function (e) {
            moveItems('#destinationFields', '#sourceFields');
            e.preventDefault();
        });

        $(document).on('click', '#right', function (e) {
            moveItems('#sourceFields', '#destinationFields');
            e.preventDefault();
        });

        $(document).on('click', '#leftall', function (e) {
            moveAllItems('#destinationFields', '#sourceFields');
            e.preventDefault();
        });

        $(document).on('click', '#rightall', function (e) {
            moveAllItems('#sourceFields', '#destinationFields');
            e.preventDefault();
        });

        $(document).on('click', '#customReportButton', function (e) {
            $("#layoutName").val('');
            $('#chkGlobalCustomReport').prop('checked', false);
            generateLayoutSelect();
            e.preventDefault();
        });

        $(document).on('click', '#btnExportCustomReport', function () {
            if ($('#destinationFields .custom-report-field').text().length == 0) {
                $("#labelCheck").html("");
                $("#labelCheck").html("Please select of the existing fields");
                $('#modalwarning').modal('show');
            } else {
                //customReport();
                exportCustomToExcel();
            }
        });
        $('#layoutSelect').on('change', function () {
            for (var j = 1; j < layoutIsGlobal.length; j++) {
                if ($('#layoutSelect option:selected').text() == layoutIsGlobal[j].LayoutName) {
                    $('#chkGlobalCustomReport').prop('checked', layoutIsGlobal[j].isGlobal);
                }
            }
            var sourceFieldNames = [
                { 'field': 'TransportNo', 'label': 'Transport No' },
                { 'field': 'STONo', 'label': 'Order No' },
                { 'field': 'TransportDate', 'label': 'Transport Date' },
                { 'field': 'SenderIDLocation', 'label': 'Sender Location' },
                { 'field': 'ReceiverIDLocation', 'label': 'Receiver Location' },
                { 'field': 'Code', 'label': 'Code' },
                { 'field': 'Description', 'label': 'Description' },
                { 'field': 'Qty', 'label': 'Qty' },
                { 'field': 'UoM', 'label': 'UoM' },
                { 'field': 'LoadStartTime', 'label': 'Load Start Time' },
                { 'field': 'LoadFinishTime', 'label': 'Load Finish Time' },
                { 'field': 'UnloadStartTime', 'label': 'Unload Start Time' },
                { 'field': 'UnloadFinishTime', 'label': 'Unload Finish Time' },
                { 'field': 'LoadBoxperWorkingTime', 'label': 'Load Working TIme' },
                { 'field': 'UnloadBoxperWorkingTime', 'label': 'Unload Working Time' }
            ],
                sourceFields = '',
                destinationFieldNames = this.value.split(','),
                destinationFields = '',
                destinationfieldLabels = [];
            //console.log(destinationFieldNames);
            for (i = 0; i < sourceFieldNames.length; ++i) {
                if (jQuery.inArray(sourceFieldNames[i]['field'], destinationFieldNames) == -1) {
                    // the element is not in the array
                    sourceFields = sourceFields + "<li><div data-field='" + sourceFieldNames[i]['field'] + "' class='custom-report-field' onclick='setHighlightCustomReport(this)'>" + sourceFieldNames[i]['label'] + "</div></li>";
                } else {
                    destinationfieldLabels[sourceFieldNames[i]['field']] = sourceFieldNames[i]['label'];
                }
            }
            $("#fieldChooser #sourceFields").html(sourceFields);
            //console.log(destinationFieldNames);
            if (destinationFieldNames[0] != "") {
                for (i = 0; i < destinationFieldNames.length; ++i) {
                    destinationFields = destinationFields + "<li><div data-field='" + destinationFieldNames[i] + "' class='custom-report-field' onclick='setHighlightCustomReport(this)'>" + destinationfieldLabels[destinationFieldNames[i]] + "</div></li>";
                }
            }
            $("#fieldChooser #destinationFields").html(destinationFields);
        });





        function moveItems(origin, dest) {
            jQuery(origin).find('.fc-selected').appendTo(dest);
        }

        function moveAllItems(origin, dest) {
            jQuery(origin).children().appendTo(dest);
        }
    });
    function setHighlightCustomReport(obj) {
        //console.log(obj);
        if (obj.className.indexOf("fc-selected") !== -1) {
            obj.classList.remove("fc-selected");
        } else {
            obj.classList.add("fc-selected");
        }
    }
    var layoutIsGlobal = [];

    $("#sourceFields").sortable({
        group: 'CustomReport'
    });

    $("#destinationFields").sortable({
        group: 'CustomReport'
    });

    function generateLayoutSelect() {
        var firstLayout = "",
            thenLayout = "",
            k = 0;

        jQuery.ajax({
            url: '@Url.Action("GetLayouts", "CustomReportState")',
            method: 'post',
            dataType: 'json',
            data: { "PageName": "LoadingUnloadingHistory" },
            success: function (response) {
                var layoutName = '',
                    options = '';

                if (parseInt(response.length) > 0) {
                    options = '';
                    options = options + "'></option><option value=''></option>";
                    for (var i = 0; i < response.length; ++i) {
                        if (layoutName != response[i].LayoutName) {
                            if (firstLayout == "") {
                                firstLayout = response[i].LayoutName;
                                ++k;
                                layoutIsGlobal[k] = { "isGlobal": response[i].IsGlobal, "LayoutName": response[i].LayoutName };
                            }

                            if (firstLayout != response[i].LayoutName) {
                                thenLayout = response[i].LayoutName;
                                ++k;
                                layoutIsGlobal[k] = { "isGlobal": response[i].IsGlobal, "LayoutName": response[i].LayoutName };
                            }

                            options = options + "'>" + layoutName + "</option><option value='" + response[i].FieldName;
                            layoutName = response[i].LayoutName;
                        } else {

                            options = options + "," + response[i].FieldName;
                        }
                    }
                    options = options + "'>" + layoutName + "</option>";
                    //console.log(options);
                    jQuery("#layoutSelect").html(options.slice(11)).ready(function () {
                        // Load selected layout
                        if ($('#layoutSelect option:selected').text() != "") {
                            jQuery.ajax({
                                url: '@Url.Action("GetSelectedLayout", "CustomReportState")',
                                method: 'post',
                                dataType: 'json',
                                data: { "PageName": "LoadingUnloadingHistory" },
                                success: function (json) {
                                    //console.log('get selected layout');
                                    //console.log(json);
                                    //$('#layoutSelect').val(json[0].FieldName);
                                    for (var j = 1; j < layoutIsGlobal.length; j++) {
                                        if ($('#layoutSelect option:selected').text() == layoutIsGlobal[j].LayoutName) {
                                            $('#chkGlobalCustomReport').prop('checked', layoutIsGlobal[j].isGlobal);
                                        }
                                    }
                                    var sourceFieldNames = [
                                            { 'field': 'TransportNo', 'label': 'Transport No' },
                                            { 'field': 'STONo', 'label': 'Order No' },
                                            { 'field': 'TransportDate', 'label': 'Transport Date' },
                                            { 'field': 'SenderIDLocation', 'label': 'Sender Location' },
                                            { 'field': 'ReceiverIDLocation', 'label': 'Receiver Location' },
                                            { 'field': 'Code', 'label': 'Code' },
                                            { 'field': 'Description', 'label': 'Description' },
                                            { 'field': 'Qty', 'label': 'Qty' },
                                            { 'field': 'UoM', 'label': 'UoM' },
                                            { 'field': 'LoadStartTime', 'label': 'Load Start Time' },
                                            { 'field': 'LoadFinishTime', 'label': 'Load Finish Time' },
                                            { 'field': 'UnloadStartTime', 'label': 'Unload Start Time' },
                                            { 'field': 'UnloadFinishTime', 'label': 'Unload Finish Time' },
                                            { 'field': 'LoadBoxperWorkingTime', 'label': 'Load Working TIme' },
                                            { 'field': 'UnloadBoxperWorkingTime', 'label': 'Unload Working Time' }
                                    ],
                                        sourceFields = '',
                                        destinationFieldNames = [],
                                        destinationFields = '',
                                        destinationfieldLabels = [];
                                    for (var j = 0; j < json.length; j++) {
                                        destinationFieldNames.push(json[j].FieldName);
                                    }
                                    for (var k = 0; k < sourceFieldNames.length; ++k) {
                                        if (jQuery.inArray(sourceFieldNames[k]['field'], destinationFieldNames) == -1) {
                                            // the element is not in the array
                                            sourceFields = sourceFields + "<li><div data-field='" + sourceFieldNames[k]['field'] + "' class='custom-report-field' onclick='setHighlightCustomReport(this)'>" + sourceFieldNames[k]['label'] + "</div></li>";
                                        } else {
                                            destinationfieldLabels[sourceFieldNames[k]['field']] = sourceFieldNames[k]['label'];
                                        }
                                    }
                                    $("#fieldChooser #sourceFields").html(sourceFields);

                                    for (i = 0; i < json.length; ++i) {
                                        destinationFields = destinationFields + "<li><div data-field='" + json[i].FieldName + "' class='custom-report-field' onclick='setHighlightCustomReport(this)'>" + destinationfieldLabels[json[i].FieldName] + "</div></li>";
                                    }

                                    $("#fieldChooser #destinationFields").html(destinationFields);
                                }
                            });
                        }
                    });
                } else {
                    jQuery("#layoutSelect").html(options);
                }
            }
        });
    }

    function saveLayout() {
        var nonvalid = false;

        if ($("#layoutName").val() == "") { //layout name
            $("#layoutName").css('border-color', 'orange');
            nonvalid = true;
        } else {
            $("#layoutName").css('border-color', '#ccc');
        }

        if (nonvalid == true) {
            alertCrPleaseFill();

            return false;
        } else {
            var fieldNames = '',
                layoutName = $("#layoutName").val(),
                isGlobal = ($("#chkGlobalCustomReport").prop('checked')) ? true : false;

            $('#destinationFields .custom-report-field').each(function () {
                fieldNames = fieldNames + $(this).data('field') + ',';
            });
            fieldNames = fieldNames.slice(0, -1);

            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

            jQuery.ajax({
                url: '@Url.Action("InsertRecords", "CustomReportState")',
                method: 'post',
                dataType: 'json',
                data: { "layoutName": layoutName, "fieldNames": fieldNames, "pageName": "LoadingUnloadingHistory", "isGlobal": isGlobal },
                success: function (response) {
                    if (response == "Success") {
                        if (isGlobal) {
                            SaveChangesButton(dialog);
                        } else {
                            alertCrSaveSuccess();
                            dialog.modal('hide');
                            $("#chkGlobalCustomReport").prop('checked', false);
                        }
                    } else if (response == "NoLayoutName") {
                        alertCrPleaseFill();
                    }

                    if ($("#layoutName").val() != $("#layoutSelect option:selected").text()) {
                        $("#layoutSelect").append('<option value="' + fieldNames + '">' + layoutName + '</option>').val(fieldNames);
                    }
                }
            });
            return true;
        }
    }

    function SaveChangesButton(dialog) {
        var selectedLayoutName = $("#layoutName").val(),
            destinationFields = '',
            isGlobal = ($("#chkGlobalCustomReport").prop('checked')) ? true : false;

        $('#destinationFields .custom-report-field').each(function () {
            destinationFields = destinationFields + $(this).data("field") + ',';
        });
        destinationFields = destinationFields.slice(0, -1);

        $.ajax({
            url: '@Url.Action("SaveSelectedLayout", "CustomReportState")',
            method: 'post',
            dataType: 'json',
            data: { "layoutName": selectedLayoutName, "fieldNames": destinationFields, "pageName": "LoadingUnloadingHistory", "isGlobal": isGlobal },
            success: function (response) {
                dialog.modal('hide');
                if (response == "Success") {
                    alertCrSaveSuccess();
                } else {
                    alertCrSaveFail();
                }
            }
        });
    }

    function exportCustomToExcel() {
        //var id = $("#IDCardNumberOrDrivingLicenseNumber").val(),
        //    idvendor = $("#IDVendor :selected").val(),
        //    basetown = $("#BaseTown").val(),
        //    name = $("#Name").val(),
        //    performancelevel = $("#PerformanceLevel").val(),
        //    incompleterequirement = $("#IncompleteRequirement").val(),
        //    includeInActive = ($('#deleted').length > 0) ? (($('#all').prop("checked") === true ? 1 : 0)) : null;
        console.log($('#scTransportNo').val());
        var tn = $('#scTransportNo').val();
        var sender = $('#scSenderLocation').val();
        var receiver = $('#scReceiverLocation').val();
        var date = $('#scStartDate').val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
        var datee = $('#scEndDate').val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
        var isExportOrSearch;
        if (myParam === "firstload") {
            isExportOrSearch = false;
        } else if (myParam === "advSearch") {
            isExportOrSearch = true;
        }

        var columns = "",
        columns = [];
        $('#destinationFields .custom-report-field').each(function () {
            columns.push($(this).text());
        });

        if (columns.length == 0) {
            bootbox.alert({
                title: "TOM Notification Center",
                message: "<div class='text-left'><img src='assets/images/danger.png' alt=''> Please select at least 1 field</div>",
                size: "small",
                closeButton: false
            });
            return;
        }
        
        ez.Modals.BeginLoading();
        jQuery.ajax({
            url: '@Url.Action("ExportToExcel")',
            method: 'post',
            dataType: 'json',
            data: {
                "Columns": columns,
                "param1": tn,
                "param2": sender,
                "param3": receiver,
                "param4": date,
                "param5": datee,
                //"PerformanceLevel": performancelevel,
                //"DrivingLicenseNumber": id,
                //"IncludeInActive": includeInActive,
                "IsExportOrSearch": isExportOrSearch
            },
            error: function () {
                ez.Modals.EndLoading();
                ez.Modals.error("Failed to Export data!");
            },
            success: function (response) {
                ez.Modals.EndLoading();
                window.location.assign('@Url.Content("~/Assets/Download/")' + response);
            }
        });
    }
</script>
