    function Save() {
        var dialogloading = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        var listarr = [];
        console.log(totalInputData);
        for (var i = 0; i < totalInputData; i++) {
            listarr.push({
                IDTransportOrder: document.getElementById("idTransportOrder[" + i + "]").innerHTML,
                LoadStartTime: document.getElementById("loadStartTime[" + i + "]").value.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                LoadFinishTime: document.getElementById("loadFinishTime[" + i + "]").value.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                UnloadStartTime: document.getElementById("unloadStartTime[" + i + "]").value.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                UnloadFinishTime: document.getElementById("unloadFinishTime[" + i + "]").value.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                IsActive: true
            });
        }

        var data = {
            "New": [{}],
            "Edit": listarr
        };
        console.log(data);
        $.ajax({
            type: 'POST',
            url: '@Url.Action("EditList", "LoadingUnloadingHistory")',
            data: data,
            success: function (result) {
                dialogloading.modal("hide");
                if ((result.Edit[0].ResponseType === "Invalid") || (result.Edit[0].ResponseType === "Error")) {
                    bootbox.alert({
                        title: "TOM Notification Center",
                        message: "<div class='text-left'><img src='@Url.Content("~/assets/images/danger.png")' alt='' /> " + result.Edit[0].Message + "</div>",
                        size: "small",
                        closeButton: false
                    });
                } else if (result.Edit[0].ResponseType === "Success") {
                    bootbox.alert({
                        title: "TOM Notification Center",
                        message: "<div class='text-left'><img src='@Url.Content("~/assets/images/checked.png")' alt='' /> " + result.Edit[0].Message + "</div>",
                        size: "small",
                        closeButton: false,
                        callback: function () {
                            generateTable1();
                            $('#saveButton').prop('disabled', true);
                            $('#editButton').prop('disabled', false);
                        }
                    });
                    
                    //generateTable();
                    //resetDataTn();
                }
            }
        });
    }
