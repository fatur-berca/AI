                        }
                        if (json[i].LoadBoxperWorkingTime == null)
                            datalist += "<td><div id='loadBoxperWorkingTime[" + i + "]'>0 box/minute</div></td>";
                        else
                            datalist += "<td><div id='loadBoxperWorkingTime[" + i + "]'>" + json[i].LoadBoxperWorkingTime + " box/minute</div></td>";
                        datalist += "<td hidden><div id='receiverIDlocation[" + i + "]'>" + json[i].ReceiverIDLocation + "</div></td>";
                        datalist += "<td><div id='receiverLocationName[" + i + "]'>" + json[i].ReceiverLocationName + "</div></td>";
                        if (json[i].UnloadStartTime == null) {
                            //datalist += "<td><input class='form-control datepicker' id='unloadStartTime[" + i + "]' value=''  disabled/></td>";
                            datalist += "<td><input class='form-control datepicker' id='unloadStartTime[" + i + "]' value=''  disabled/></td>";
                        } else {
                            datalist += "<td><input class='form-control datepicker' id='unloadStartTime[" + i + "]' value='" + moment(json[i].UnloadStartTime).format("DD-MMM-YYYY HH:mm") + "'  disabled/></td>";
                        }
                        if (json[i].UnloadFinishTime == null) {
                            //datalist += "<td><input class='form-control datepicker' id='unloadFinishTime[" + i + "]' value=''  disabled/></td>";
                            datalist += "<td><input class='form-control datepicker' id='unloadFinishTime[" + i + "]' value=''  disabled/></td>";
                        } else {
                            datalist += "<td><input class='form-control datepicker' id='unloadFinishTime[" + i + "]' value='" + moment(json[i].UnloadFinishTime).format("DD-MMM-YYYY HH:mm") + "'  disabled/></td>";
                        }
                        if (json[i].UnloadBoxperWorkingTime == null)
                            datalist += "<td><div id='unloadBoxperWorkingTime[" + i + "]'>0 box/minute</div></td>";
                        else
                            datalist += "<td><div id='unloadBoxperWorkingTime[" + i + "]'>" + json[i].UnloadBoxperWorkingTime + " box/minute</div></td>";
                        datalist += "</tr>";
                    }
                    datalist += '</tbody></table>';
                    $('#tableList').html(datalist);
                    //total = 0;
                    $('#IDTransportExecution').val(json[0].IDTransportExecution);
                    //generateInputData();
                } else {
                    bootbox.alert({
