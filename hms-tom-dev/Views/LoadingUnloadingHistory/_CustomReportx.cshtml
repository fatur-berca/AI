@using EnumHelper = DFIS.Utils.EnumHelper
@{
    var listUserRole = ViewBag.ListUserRole;
}

<!-- Custom Report Modal Dialog -->
<div class="modal fade" id="customReportModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Custom Report</h4>
            </div>
            <div class="modal-body custom-report">
                <div class="row label-top">
                    <div class="col-md-6">
                        <label>Column Set</label>
                    </div>
                    <div class="col-md-6">
                        <label class="dis">Displayed Columns</label>
                        <select id="layoutSelect" class="form-control">
                            <option value="">Loading...</option>
                        </select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div id="fieldChooser" tabindex="1" class="field-chooser form-group">
                    <ul id="sourceFields" class="source">
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="TransportNo">Transportation Number</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="TransportDate">Transportation Date</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="STONo">Order Number</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="DefaultSeqNo">DefaultSeqNo</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="SeqNo">SeqNo</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="ShipmentDate">ShipmentDate</div></li>
                        @*<li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="KM">KM</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="SenderIDLocation">SenderIDLocation</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="ActualSenderIDLocation">ActualSenderIDLocation</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="ReceiverIDLocation">ReceiverIDLocation</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="ActualReceiverIDLocation">ActualReceiverIDLocation</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="LeadTime">LeadTime</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="VehicleType">VehicleType</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="OrderType">OrderType</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="CostCenter">CostCenter</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="OrderStatus">OrderStatus</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="MaterialReceivedTime">MaterialReceivedTime</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="IsMaterialReceived">IsMaterialReceived</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="EstArrivalDate">EstArrivalDate</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="GRDate">GRDate</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="LoadStartTime">LoadStartTime</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="LoadFinishTime">LoadFinishTime</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="UnloadStartTime">UnloadStartTime</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="UnloadFinishTime">UnloadFinishTime</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="Remarks">Remarks</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="FlagEmail">FlagEmail</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="IDLeadTime">IDLeadTime</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="IDCostCenter">IDCostCenter</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="IsActive">IsActive</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="CreatedBy">CreatedBy</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="CreatedDate">CreatedDate</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="UpdatedBy">UpdatedBy</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="UpdatedDate">UpdatedDate</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="ZoneBased">ZoneBased</div></li>
                        <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="ChangeLogFields">ChangeLogFields</div></li>*@
                    </ul>
                    <div class="button-column">
                        <div>
                            <input class="btn btn-info mini" type="button" id="left" value="<">
                            <input class="btn btn-info mini" type="button" id="right" value=">">
                        </div>
                    </div>
                    <div id="destinationFields" class="destination"></div>
                </div>
                <div class="opt-bot">
                    <div class="row">
                        <div class="col-md-6">
                            <input class="btn btn-info amr" type="button" id="rightall" value=">>">
                            <input class="btn btn-info" type="button" id="leftall" value="<<">
                        </div>
                        <div class="col-md-6">
                            <input class="btn btn-info" type="button" id="saveLayoutButton" value="Save Layout">
                            <input type="text" class="form-control" id="layoutName">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @foreach (var x in listUserRole)
                {
                    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
                    {
                        <div class="form-group pull-left">
                            <div class="checkbox-deck">
                                <input type="checkbox" id="chkGlobalCustomReport">
                                <label for="chkGlobalCustomReport"></label>
                            </div>
                            <span class="checkbox-deck-span">Global Custom Report</span>
                        </div>
                    }
                }
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
                {
                    <button class="btn btn-primary" id="exportCustomReport">Export</button>
                }                
                    <button class="btn btn-purple" data-dismiss="modal">Close</button>                
            </div>
        </div>
    </div>
</div>

<style>
    .fc-selected {
        background-color: #f39814 !important;
