@using System.Web.Mvc.Html
@using EnumHelper = DFIS.Utils.EnumHelper

@{
    ViewBag.Title = "Transport > Loading & Unloading History > List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title-deck wmb">
    <div class="col-panel" style="padding-bottom: 0">
        <div class="col-md-4">
            <div class="form-group">
                <label>Transportation Number</label>
                <input id="transportationNumber" type="text" class="form-control" autofocus />
                <input id="IDTransportExecution" type="hidden"/>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group" id="divSelect">
                <label>Location</label>
                <select id="userLocation" class="select2"></select>
                <input id="userLocationValue" type="hidden" />
            </div>
        </div>
        <div class="col-sm-4">
            <div class="form-group">
                <label for="input-type"></label>
                <div id="input-type" class="row" style="padding-top:8px">
                    <div class="col-sm-2">
                        <label class="radio-inline">
                            <input name="loadstatus" id="rbload" value="1" type="radio" />Load
                        </label>
                    </div>
                    <div class="col-sm-2">
                        <label class="radio-inline">
                            <input name="loadstatus" id="rbunload" value="0" type="radio" /> Unload
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <div class="col-md-4">
            <div class="form-group">
                <label>Date and Time</label>
                <input id="dateandtime" type="text" class="form-control" />
            </div>
        </div>

        <div class="clearfix"></div>
        
        <div class="col-md-12">
            <div class="form-group">
                <div id="tableList"></div>
            </div>
        </div>

        <div class="clearfix"></div>
    </div>
</div>

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
    @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
    {
            <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#exportFile" id="exportButton">Export</button>
    }
    @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
    {
            <button class="btn btn-primary" data-toggle="modal" data-target="#customReportModal" id="customReportButton">Custom Report</button>
    }
    @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Upload)))
    {
            <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#uploadfile" id="uploadButton">Upload</button>
    }
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter" id="btnAdvancedSearch"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="scTransportNo">Transportation Number</label>
                        <input type="hidden" id="scTransportNo" style="width:250px" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="scSenderLocation">Sender</label>
                        <select id="scSenderLocation" class="select2 select2-selection--multiple" multiple="multiple"></select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="scReceiverLocation">Receiver</label>
                        <select class="select2 select2-selection--multiple"  multiple="multiple" id="scReceiverLocation" ></select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2" style="width: 20.8%">
                    <div class="form-group">
                        <label>Transportation Date</label>
                        <input class="form-control datepicker" type="text" data-date-format="DD/MM/YYYY" id="scStartDate" />
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <label class="text-center">TO</label>
                    </div>
                </div>
                <div class="col-md-2" style="width: 20.8%">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <input class="form-control datepicker" type="text" data-date-format="DD/MM/YYYY" id="scEndDate" />
                    </div>
                </div>
            </div>
            @*@if (isSuperUser)
            {*@
            @*<div class="clearfix"></div>
            <div class="col-sm-4">
                <div class="form-group">

                    <label for="input-type">Status</label>
                    <div id="input-type" class="row">
                        <div class="col-sm-2">
                            <label class="radio-inline">
                                <input name="isIncludeActive" id="all" value="1" type="radio" />All
                            </label>
                        </div>
                        <div class="col-sm-2">
                            <label class="radio-inline">
                                <input name="isIncludeActive" id="deleted" value="0" type="radio" /> Deleted
                            </label>
                        </div>
                    </div>
                </div>
            </div>*@
            @* } *@
            <div class="col-md-12">
                <button class="btn btn-primary " onclick="GenerateSearch()">Search</button>
                <button class="btn btn-purple" onclick="resetSearch()">Reset</button>
            </div>
        </div>
    </div>
</div>

<table id="dtTable" class="display table dataTable">
    <thead>
        <tr>
            <th data-orderable="false" class="text-center">
                @*<div class="checkbox-deck">
                    <input type="checkbox" name="select_all" id="checkall">
                    <label for="checkall"></label>
                </div>*@
            </th>
            <th>Transportation Number</th>
            <th>Transportation Date</th>
            <th>Order Number/STO</th>
            <th>Sender</th>
            <th>Receiver</th>
            <th>Load box/working time</th>
            <th>Unload box/working time</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th class="text-center">Filter</th>
            <th>Transportation number</th>
            <th>Transportation Date</th>
            <th>Order Number/STO</th>
            <th>Sender</th>
            <th>Receiver</th>
            <th>Load box/working time</th>
            <th>Unload box/working time</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="uploadfile" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Upload File</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form id="formUpload">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Upload Template</label>
                                <input id="UploadTemplate" type="file" class="filestyle" data-buttonname="btn-primary" data-icon="false" data-buttontext="Browse" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel">
                                <a href="Assets/Download/TemplateExcel/TransportationLoadingTemplate.xlsx" id="downloadTemplate">Download Template Loading</a>
                                <br />
                                <a href="Assets/Download/TemplateExcel/TransportationUnloadingTemplate.xlsx" id="downloadTemplate">Download Template Unloading</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" id="btnCloseUpload" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnUpload" disabled>Upload</button>
            </div>
        </div>
    </div>
</div>

