            $('#UploadTemplate').val('');
            $('#btnUpload').attr('disabled', 'disabled');
        });

        $('#UploadTemplate').on('change', function (e) {
            $('#btnUpload').removeAttr('disabled');
        });

        $('#btnUpload').on('click', function (e) {
            var fileUpload = $('#uploadFile');
            var fileData = new FormData();
            fileData.append('file', $('#UploadTemplate').get(0).files[0]);

            $.ajax({
                url: '@Url.Action("../LoadingUnloadingHistory/UploadTemplate")',
                type: 'POST',
                dataType: 'JSON',
                data: fileData,
                cache: false,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res.status == "Success") {
                        $('#UploadTemplate').val('');
                        $('.jfilestyle').find('input').val('');
                        $('#btnUpload').attr('disabled', 'disabled');
                        $("#btnCloseUpload").click();
                        bootbox.alert({
                            title: "TOM Notification Center",
                            message: '<div><img src="assets/images/checked.png" alt=""> Data has been succesfully saved to database. </div>',
                            closeButton: false
                        });
                        // testpoint
                        //generateTable1();

                        ReloadTopTable(false);
                    }
                    else {
                        bootbox.alert({
                            title: "TOM Notification Center",
                            message: '<div><img src="assets/images/cancel.png" alt=""> ' + res.message + '  </div>',
                            closeButton: false
                        });
                    }
                },
                error: function () {
                }
            });
        });
        generateTable(myParam);
    });

    $(document).on('click', '#exportButton', function (e) {
        exportToExcelDefault();
        e.preventDefault();
    });

    var resetDataTn = function () {
        $('#transportationNumber').val("");
        $('#IDTransportExecution').val("");
        $('#userLocation').val("").trigger("change");
        $('#dateandtime').val("");
        //document.getElementById("dateandtime").focus();
        $('#rbload').prop("checked", false);
        $('#rbunload').prop("checked", false);
    };

    function ReloadTopTable(showNotif)
    {
        showNotif = showNotif == undefined ? true : false;
        $('#dateandtime').prop("disabled", false);
