        var tNnumber = $("#transportationNumber").val();
        if (tNnumber === "") {
            $("#transportationNumber").css('border-color', 'orange');
            bootbox.alert({
                title: "TOM Notification Center",
                message: "<div class='text-left'><img src='assets/images/danger.png' alt=''> Please scan or input Transaction Number</div>",
                size: "small",
                closeButton: false
            });
        } else {
            $('#rbload').prop("checked", false);
