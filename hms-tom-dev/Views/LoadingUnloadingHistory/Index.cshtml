        keypress: function (e) {
            $("#transportationNumber").css('border-color', '#ccc');
            if (e.which === 13) {
                e.preventDefault();
                ReloadTopTable();
            }
        }
    });

    $("#btnAdvancedSearch").click(function() {
        $("#scTransportNo").select2("val", "");
    });

    $('#rbload').on({
        click: function (e) {
            for (var i = 0; i < totalInputData; i++) {
                if ($('#dateandtime').val() !== "") {
                    if (generatedtable1data[i].UnloadStartTime == "") {
                        document.getElementById("unloadStartTime[" + i + "]").innerHTML = "";
                    }
                    document.getElementById("loadStartTime[" + i + "]").innerHTML = moment().format('DD-MMM-YYYY HH:mm');
                }
            }
        }
    });

    $('#rbunload').on({
        click: function(e) {
            for (var i = 0; i < totalInputData; i++) {
                if ($('#dateandtime').val() !== "") {
                    if (generatedtable1data[i].LoadStartTime == "") {
                        document.getElementById("loadStartTime[" + i + "]").innerHTML = "";
                    }
                    document.getElementById("unloadStartTime[" + i + "]").innerHTML = moment().format('DD-MMM-YYYY HH:mm');
                }
            }
        }
    });

    $('#dateandtime').on({
        keypress: function (e) {
            $("#transportationNumber").css('border-color', '#ccc');
            if (e.which === 13) {
                if ($('#transportationNumber').val() !== "") {
                    Save();
                } else {
                    bootbox.alert({
                        title: "TOM Notification Center",
                        message: "<div class='text-left'><img src='assets/images/danger.png' alt=''> Please Input Transaction Number </div>",
                        size: "small",
                        closeButton: false
                    });
                    $('#dateandtime').val("");
                }
            }
        }
    });

    var totalLocation = 0;
    var generateUserLocation = function (param1, showNotif, callback) {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetWarehouseLocation", "LoadingUnloadingHistory")',
            data: { "TransportNo": $("#transportationNumber").val() },
            success: function (result) {
                //if (result.length > 0) {
                var options = '<option value="-"></option>';
                totalLocation = result.length;
                //if (result.length > 1) {
                /*
                $('#userLocation').html('');
                removeElement("userLocation");
                createElement();
                for (var i = 0; i < result.length; i++) {
                    options = options + '<option value="' + result[i].IdLocation + '">' + result[i].LocationName + '</option>';
                }
                $('#userLocation selected').val("-");
                $('#userLocation').html(options);
                */


                $("#userLocation").html('');
                $("#userLocation").append('<option value="">&nbsp;</option>');
                for (var i = 0; i < result.length; i++)
                {
                    $("#userLocation").append('<option value="' + result[i].IdLocation + '">' + result[i].LocationName + '</option>');
                }
                $("#userLocation").select2();

                if (callback !== undefined)
                    callback();

                //} else {
                //    $('#userLocation').val(result[0].LocationName);
                //    $('#userLocationValue').val(result[0].IDLocation);
                //    $('#userLocation').prop('disabled', true);

                //}
                total = 0;
                if (param1 !== "save") {
                    generateTable1(param1, showNotif);
                }
                totalInputData = 0;
                //} else {
                //    bootbox.alert({
                //        title: "TOM Notification Center",
                //        message: "<div class='text-left'><img src='assets/images/danger.png' alt=''> Data not exist</div>",
                //        size: "small",
                //        closeButton: false,
                //        callback: function () {
                //            $('#dateandtime').focus();
                //        }
                //    });
                //}
            }
        });
    };

    var firstLoadUL = false;
    $('#userLocation').on({
        change: function() {
            //generateInputData();
            generateTable1(undefined, firstLoadUL);
            firstLoadUL = true;
        }
    });

    function Save() {
        var selectedLocation = $('#userLocation').select2("val");
        var inpTN = $('#dateandtime').val();
        var bseTN = $('#transportationNumber').val();
        var radioBtn = $('input[name=loadstatus]:checked').val();
        var nonvalid = false;

        if (selectedLocation == "-" || selectedLocation == "" || selectedLocation == null) {//nama
            bootbox.alert({
                title: "TOM Notification Center",
                message: "<div class='text-left'><img src='assets/images/danger.png' alt=''> Please select location </div>",
                size: "small",
                closeButton: false,
                callback: function () {
                    $('#dateandtime').val("");
                    $('#dateandtime').focus();
                }
            });
            nonvalid = true;
            return false;
        }
        
        if (inpTN != bseTN) {//nama
            bootbox.alert({
                title: "TOM Notification Center",
                message: "<div class='text-left'><img src='assets/images/cancel.png' alt=''> Input failed </div>",
                size: "small",
                closeButton: false,
                callback: function () {
                    $('#dateandtime').val("");
                    $('#dateandtime').focus();
                }
            });
            nonvalid = true;
            return false;
        }
        
        if (radioBtn === undefined) {
            bootbox.alert({
                title: "TOM Notification Center",
                message: "<div class='text-left'><img src='assets/images/danger.png' alt=''> Please select loading or unloading </div>",
                size: "small",
                closeButton: false,
                callback: function () {
                    $('#dateandtime').val("");
                    $('#dateandtime').focus();
                }
            });
            nonvalid = true;
            return false;
        } 

        $('#dateandtime').val(moment().format('DD-MMM-YYYY HH:mm'));

        var rbload = $('#rbload').prop("checked");
        var rbunload = $('#rbunload').prop("checked");
        var selectedLocation = $('#userLocation').select2("val");

        if (rbload) {
            for (var i = 0; i < totalInputData; i++) {
                if (selectedLocation === generatedtable1data[i].SenderIDLocation) {
                    if (generatedtable1data[i].LoadStartTime == null) {
                        document.getElementById("loadStartTime[" + i + "]").innerHTML = moment().format('DD-MMM-YYYY HH:mm');
                    } else {
                        document.getElementById("loadFinishTime[" + i + "]").innerHTML = moment().format('DD-MMM-YYYY HH:mm');
                    }
                }
            }
        }
        if (rbunload) {
            for (var j = 0; j < totalInputData; j++) {
                if (selectedLocation === generatedtable1data[j].ReceiverIDLocation) {
                    if (generatedtable1data[j].UnloadStartTime == null) {
                        document.getElementById("unloadStartTime[" + j + "]").innerHTML = moment().format('DD-MMM-YYYY HH:mm');
                    } else {
                        document.getElementById("unloadFinishTime[" + j + "]").innerHTML = moment().format('DD-MMM-YYYY HH:mm');
                    }
                }
            }
        }

        if (nonvalid == true) {
            return false;
        } else {
            var dialogloading = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });
            var listarr = [];
            for (var i = 0; i < totalInputData; i++) {
                listarr.push({
                    IDTransportOrder: document.getElementById("idTransportOrder[" + i + "]").innerHTML,
                    LoadStartTime: document.getElementById("loadStartTime[" + i + "]").innerHTML.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                    LoadFinishTime: document.getElementById("loadFinishTime[" + i + "]").innerHTML.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                    UnloadStartTime: document.getElementById("unloadStartTime[" + i + "]").innerHTML.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                    UnloadFinishTime: document.getElementById("unloadFinishTime[" + i + "]").innerHTML.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                    IsActive: true
                });
            }

            var data = {
                "New": [{}],
                "Edit": listarr
            };

            $.ajax({
                type: 'POST',
                url: '@Url.Action("EditList", "LoadingUnloadingHistory")',
                data: data,
                success: function (result) {
                    dialogloading.modal("hide");
                    if ((result.Edit[0].ResponseType === "Invalid") || (result.Edit[0].ResponseType === "Error")) {
                        bootbox.alert({
                            title: "TOM Notification Center",
                            message: "<div class='text-left'><img src='assets/images/danger.png' alt=''> " + result.Edit[0].Message + "</div>",
                            size: "small",
                            closeButton: false,
                            callback: function () {
                                $('#dateandtime').focus();
                            }
                        });
                    } else if (result.Edit[0].ResponseType === "Success") {
                        var arrvalidate = new Array();
                        var arrvalidate2 = new Array();
                        var count = 0;
                    
                        //arrLocation = array lokasi
                        //hitung jumlah lokasi yg sama dengan yang terpilih
                        // cek untuk lokasi yg terpilih 
                        for (var y = 0; y < result.Edit.length; y++) {
                            if (selectedLocation === result.Edit[y].SenderIDLocation) {
                                count = count + 1;
                            }
                            if (selectedLocation === result.Edit[y].ReceiverIDLocation) {
                                count = count + 1;
                            }
                        


                            if (result.Edit[y].LoadStartTime != null && result.Edit[y].LoadFinishTime != null && result.Edit[y].UnloadStartTime != null && result.Edit[y].UnloadFinishTime != null) {
                                arrvalidate.push(true);
                            } else {
                                arrvalidate.push(false);
                            }
                            if($('#rbload').prop("checked")) {
                                if (result.Edit[y].LoadStartTime != null && result.Edit[y].LoadFinishTime != null) {
                                    arrvalidate2.push(true);
                                } else {
                                    arrvalidate2.push(false);
                                }
                            }
                            if ($('#rbunload').prop("checked")) {
                                if (result.Edit[y].UnloadStartTime != null && result.Edit[y].UnloadFinishTime != null) {
                                    arrvalidate2.push(true);
                                } else {
                                    arrvalidate2.push(false);
                                }
                            }
                        
                        
                        }
                    
                        var message;
                        if (arrvalidate.includes(false)) {
                            message = result.Edit[0].Message;
                        } else {
                            message = result.Edit[0].Message + " And in " + $('#transportationNumber').val() + " already completed";
                        }
                        console.log(arrvalidate2);
                        bootbox.alert({
                            title: "TOM Notification Center",
                            message: "<div class='text-left'><img src='assets/images/checked.png' alt=''> " + message + "</div>",
                            size: "small",
                            closeButton: false,
                            callback: function () {
                                $('#dateandtime').focus();
                                //generateTable();
                                //console.log(arrvalidate2);
                                //if (!arrvalidate2.includes(false)) {
                                var lastLoc = selectedLocation;
                                generateUserLocation('save', undefined, function () {
                                    $('#userLocation').select2("val", lastLoc);
                                });
                                //}
                                //if ($('#rbload').val()) {
                                //    if()
                                //}
                                generateTable1('save');
                            }
                        });
                    }
                    $('#dateandtime').val("");
                    $('#dateandtime').focus();
                }
            });
        }
    }

    //TN/0618/00001
    var counter;
    var counterSender;
    var counterReceiver;
    var total = 0;
    var totalInputData = 0;
    var generatedtable1data;
    //var arrLocation = new Array();
