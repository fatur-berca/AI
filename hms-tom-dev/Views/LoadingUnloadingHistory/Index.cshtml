        showNotif = showNotif === undefined ? true : showNotif;
        var input = {
            "TransportNo": $("#transportationNumber").val(),"State":"new"
        };
        var selectedLocation = $('#userLocation').select2("val");
        $.ajax({
            url: '@Url.Action("GetTransportOrderByNo", "LoadingUnloadingHistory")',
            method: 'get',
            dataType: 'json',
            cache: false,
            data: input,
            success: function (json) {
                console.log(json);
                counterSender = 0;
                counterReceiver = 0;
                generatedtable1data = json;
                totalInputData = json.length;
                var datalist = "<table class='display table dataTable' style='width: 100%' id='tbHeader'><thead><tr><th>Order Number</th><th>Sender</th><th hidden>Senderid</th><th>Load Start</th><th>Load Finish</th><th>Receiver</th><th hidden>Receiverid</th><th>Unload Start</th><th>Unload Finish</th></tr></thead><tbody id='datalist'>";
                if (totalInputData > 0) {
                    if (json[0].ExistingState === 1) {
                        for (var i = 0; i < totalInputData; i++) {
                            //arrLocation.push(json[i].SenderIDLocation);
                            //arrLocation.push(json[i].ReceiverIDLocation);
                            if (selectedLocation === json[i].SenderIDLocation) {
                                if (json[i].LoadStartTime == null || json[i].LoadFinishTime == null)
                                    counterSender = counterSender + 1;
                            }

                            if (selectedLocation === json[i].ReceiverIDLocation) {
                                if (json[i].UnloadStartTime == null || json[i].UnloadFinishTime == null)
                                    counterReceiver = counterReceiver + 1;
                            }

                            datalist += "<tr>";
                            datalist += "<td hidden><div id='idTransportOrder[" + i + "]'>" + json[i].IDTransportOrder + "</div></td>";
                            datalist += "<td><div id='OrderNumber[" + i + "]'>" + json[i].STONo + "</div></td>";
                            datalist += "<td hidden><div id='senderIDLocation[" + i + "]' >" + json[i].SenderIDLocation + "</div></td>";
                            datalist += "<td><div id='senderLocationName[" + i + "]' >" + json[i].SenderLocationName + "</div></td>";
                            if (json[i].LoadStartTime == null) {
                                datalist += "<td><div id='loadStartTime[" + i + "]'></div></td>";
                            } else {
                                datalist += "<td><div id='loadStartTime[" + i + "]'>" + moment(json[i].LoadStartTime).format("DD-MMM-YYYY HH:mm") + "</div></td>";
                            }
                            if (json[i].LoadFinishTime == null) {
                                datalist += "<td><div id='loadFinishTime[" + i + "]'></div></td>";
                            } else {
                                datalist += "<td><div id='loadFinishTime[" + i + "]'>" + moment(json[i].LoadFinishTime).format("DD-MMM-YYYY HH:mm") + "</div></td>";
                            }
                            datalist += "<td hidden><div id='receiverIDlocation[" + i + "]'>" + json[i].ReceiverIDLocation + "</div></td>";
                            datalist += "<td><div id='receiverLocationName[" + i + "]'>" + json[i].ReceiverLocationName + "</div></td>";
                            if (json[i].UnloadStartTime == null) {
                                datalist += "<td><div id='unloadStartTime[" + i + "]'></div></td>";
                            } else {
                                datalist += "<td><div id='unloadStartTime[" + i + "]'>" + moment(json[i].UnloadStartTime).format("DD-MMM-YYYY HH:mm") + "</div></td>";
                            }
                            if (json[i].UnloadFinishTime == null) {
                                datalist += "<td><div id='unloadFinishTime[" + i + "]'></div></td>";
                            } else {
                                datalist += "<td><div id='unloadFinishTime[" + i + "]'>" + moment(json[i].UnloadFinishTime).format("DD-MMM-YYYY HH:mm") + "</div></td>";
                            }
                            datalist += "</tr>";
                        }
                        datalist += '</tbody></table>';
                        $('#tableList').html(datalist);
                        total = 0;
                        $('#IDTransportExecution').val(json[0].IDTransportExecution);

                        if (counterSender > 0 && counterReceiver == 0) {
                            $('#rbload').prop("checked", true);
                            $('#rbunload').prop("disabled", true);
                            $('#rbload').prop("disabled", true);
                        }
                        else if (counterReceiver > 0 && counterSender == 0) {
                            $('#rbunload').prop("checked", true);
                            $('#rbunload').prop("disabled", true);
                            $('#rbload').prop("disabled", true);
                        }
                        else if (counterReceiver > 0 && counterSender > 0) {
                            $('#rbload').prop("checked", false);
                            $('#rbunload').prop("checked", false);
                            $('#rbload').prop("disabled", false);
                            $('#rbunload').prop("disabled", false);
                        }
                        else if (counterReceiver == 0 && counterSender == 0) {
                            $('#rbload').prop("checked", false);
                            $('#rbunload').prop("checked", false);
                            $('#rbload').prop("disabled", true);
                            $('#rbunload').prop("disabled", true);
                        }
                        
                        $('#dateandtime').focus();
                    } else if (json[0].ExistingState === 2) {
                        $('#dateandtime').prop("disabled",true);
                        $('#tableList').html('');
                        if (param1 !== "save") {
                            if (showNotif) {
                                bootbox.alert({
                                    title: "TOM Notification Center",
                                    message: "<div class='text-left'><img src='assets/images/danger.png' alt=''> Data in " + $('#transportationNumber').val() + " Already complete</div>",
                                    size: "small",
                                    closeButton: false
                                });
                            }
                        }
                    }
                    else if (json[0].ExistingState === 3) {
                        $('#dateandtime').prop("disabled", true);
                        if (showNotif) {
                            bootbox.alert({
                                title: "TOM Notification Center",
                                message: "<div class='text-left'><img src='assets/images/danger.png' alt=''> Transportation number not found</div>",
                                size: "small",
                                closeButton: false
                            });
                        }
                    }
                }
                $('#dateandtime').focus();
                $('#IDTransportExecution').val("0");
            }
        });

    };

