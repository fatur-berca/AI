    function generateTable(param) {
        ez.Modals.BeginLoading();
        $.ajax({
            url: '@Url.Action("GetData", "LoadingUnloadingHistory")',
            method: 'POST',
            data: {
                transportNo: param == "advSearch" ? $('#scTransportNo').val():null,
                senderLocation: param == "advSearch" ? $('#scSenderLocation').val(): null,
                receiverLocation: param == "advSearch" ? $('#scReceiverLocation').val():null,
                transportStartDate: param == "advSearch" ? $('#scStartDate').val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1") : null,
                transportEndDate: param == "advSearch" ? $('#scEndDate').val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1") : null,
                state: param
            },
            cache: false,
            error: function () {
                ez.Modals.EndLoading();
                ez.Modals.error("Failed to load data!");
            },
            success: function (json) {
                ez.Modals.EndLoading();
                var table = $('#dtTable').DataTable({
                    "destroy": true,
                    data: json,
                    'paging': true,
                    'sort': true,
                    "iDisplayLength": 25,
                    'searching': true,
                    "columnDefs": [{
                        "targets": [0, 1],
                        "orderable": false
                    }],
                    columns: [
                        {
                            "data": "IsActive", "class": "text-center", "render": function (data) {
                                if (data === true) {
                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }
                            }
                        },
                        {
                            'data': 'TransportNo', 'searchable': true, "render": function (data, type, row, meta) {
                                return '<a href="@Url.Action("EditIndex")?sn=' + data + '">' + data + '</a>';
                            }
                        },
                        {
                            'data': 'TransportDate', 'searchable': true, "render": function (data) {
                                return '<div>' + moment(data).format("DD-MMM-YYYY") + '</div>';
                            }
                        },
                        { 'data': 'STONo', 'searchable': true },
                        { 'data': 'SenderLocationName', 'searchable': true },
                        { 'data': 'ReceiverLocationName', 'searchable': true },
                        { 'data': 'LoadBoxperWorkingTime', 'searchable': true },
                        { 'data': 'UnloadBoxperWorkingTime', 'searchable': true }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtTable thead.filters th').each(function (index) {
                    if ((index >= 1) && (index <= 7)) {
                        var title = $('#dtTable thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                //searching with column on datatable
                table.columns().every(function (index) {
                    $('#dtTable thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });
            }
        });
    }

    function exportToExcelDefault() {
        ez.Modals.BeginLoading();
        var tn = $('#scTransportNo').val();
        var sender = $('#scSenderLocation').val();
        var receiver = $('#scReceiverLocation').val();
        var date = $('#scStartDate').val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
        var datee = $('#scEndDate').val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
        jQuery.ajax({
            url: '@Url.Action("ExportToExcel")',
            method: 'post',
            dataType: 'json',
            data: {
                "param1": tn,
                "param2": sender,
                "param3": receiver,
                "param4": date,
                "param5": datee
            },
            error: function () {
                ez.Modals.EndLoading();
                ez.Modals.error("Failed to Export data!");
            },
            success: function (response) {
                ez.Modals.EndLoading();
                window.location.assign('@Url.Content("~/Assets/Download/")' + response);
            }
        });
    }

