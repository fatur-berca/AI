    var Save = function () {
        var inlocation = "";

        if (totalLocation > 1) {
            inlocation = $("#userLocation :selected").val();
        } else if (totalLocation === 1) {
            inlocation = $("#userLocationValue").val();
        }
        var data = {
            IDTransportExecution: $('#IDTransportExecution').val() > 0 ? $('#IDTransportExecution').val() : 0,
            SealNumber : $('#snsealnumber').val(),
            SealActivity : $('#snsealactivity').val(),
            IDLocation : inlocation,
            SealTime: moment($('#sndateandtime').val(), 'DD-MMM-YYYY HH:mm:ss').format('YYYY-MMM-DD HH:mm:ss')
        }

        $.ajax({
            type: 'POST',
            url: 'TransportationSeal/SaveData',
            data: data,
            success: function (result) {
                dialogloading.modal("hide");

                if ((result.ResponseType === "Invalid") || (result.ResponseType === "Error")) {
                    bootbox.alert({
                        title: "TOM Notification Center",
                        message: "<div class='text-left'><img src='assets/images/cancel.png' alt=''> <strong><u>Input Failed!</u></strong></br>"+result.Message+"</div>",
                        backdrop: true
                    });
                    resetDataSeal();
                } else if (result.ResponseType === "Success") {
                    //resetDataSeal();
                    $('#insealnumber').val('');
                    generateTable();
                    //bootbox.confirm({
                    //    title: "TOM Notification Center",
                    //    message: "<div class='text-left'><img src='assets/images/checked.png' alt=''> " + result.Message + "</div>",
                    //    closeButton: false,
                    //    buttons: {
                    //        confirm: {
                    //            label: 'OK',
                    //            className: 'btn-primary'
                    //        }
                    //    },
                    //    callback: function (result) {
                    //        //resetDataTn();
                    //        resetDataSeal();
                    //        generateTable();
                    //    }
                    //});
                }
            }
        });
    }

