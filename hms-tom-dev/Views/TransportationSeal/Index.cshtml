                                "<div class='text-left'><img src='assets/images/danger.png' alt=''> Please scan or input Transaction Number first!</div>",
                            backdrop: true
                        });
                        resetDataSeal();
                        valid = false;
                    } else {
                        // 1. seal number
                        $("#snsealnumber").val(sealNumber);
                        var sealActivity = ($('#rbunseal').length > 0) ? (($('#rbseal').prop("checked") === true ? "Seal" : "Unseal")) : null;
                        // 2. seal activity
                        $("#snsealactivity").val(sealActivity);
                        // 3. Seal Location
                        var selectedLocation;
                        if (totalLocation > 1) {
                            selectedLocation = $('#userLocation option:selected').val();

                            if (selectedLocation === "-") {
