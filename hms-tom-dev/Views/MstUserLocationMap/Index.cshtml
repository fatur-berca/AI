            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (data) {
                $("#Loading").modal('hide');
                var table = $('#dtFilterMaster').DataTable({
                    "destroy": true,
                    data: data,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "iDisplayLength": 25,
                    columns: [
                        //{
                        //    "data": "IsActive", "class": "text-center", "render": function (data) {
                        //        if (data == true) {
                        //            return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                        //        } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }
                        //    }
                        //},
                        { 'data': 'IDUser', 'searchable': true },
                        { 'data': 'fullName', 'searchable': true },
                        { 'data': 'MasterRole', 'searchable': true },
                        //{
                        //    'data': 'IDLocation', "render": function (data, type, row, meta) {
                        //         var res = row["IDUser"].split("\\");
                        //        return '<div id=""><a href="#" id="" onclick="generateListLocation(\''+ res[0] +'\\\\'+ res[1]+'\');" data-toggle="modal" data-target="#listLocationModal">List Location</a></div>';
                        //    }
                        //}
                        {
                            'data': 'IDLocation', "render": function (data, type, row, meta) {
                                var res = row["IDUser"].split("\\");
                                //var id = row["IDUser"].split("\\");
                                return '<div id=""><a href="#" id="" onclick="generateListLocation(\'' + res[0] + '\\\\' + res[1] + '\');" data-toggle="modal" data-target="#listLocationModal">Module List</a></div>';
                            }
                        },
                        //,
                        {
                            "data": "IDUser", "class": "text-center", "render": function (data) {
                                return '<div ><a href="#" id="editForm" onclick="editTable(' + "'" + data + "'" + ')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a>';
                            }
                        }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 0) && (index < 3)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });
            }
        });  
    }
    // END : JQUERY SELECT TO DataTable

    function generateTreeListLocation(roleId) {
        $.ajax({
            url: "MstUserLocationMap/GetTreeListLocation",
            type: 'GET',
            cache : false,
            dataType: 'json',
            success: function (data) {
                tempListALLLocation = [];
                var zone = "";
                var region = "";
                var warehouse = "";
                $("#locationtree").empty();
                for (var i = 0; i < data.length; i++) {
                    //if (zone != data[i]["NameZone"]) {
                    //    zone = data[i]["NameZone"];
                    //    $("#locationtree").append("<li id='li-" + data[i]["IDZone"].split(' ').join('_') + "'></li>");
                    //    $('#li-' + data[i]["IDZone"].split(' ').join('_')).append("<i class='fa fa-plus'></i> <label><input id='xnode-" + data[i]["IDZone"].split(' ').join('_') + "' data-id='custom-" + data[i]["IDZone"].split(' ').join('_') + "' name='disabledNode' type='checkbox'/>" + data[i]["NameZone"].split(' ').join('_') + "</label> <ul id='ul-" + data[i]["IDZone"].split(' ').join('_') + "' style='display: none;'></ul>");
                    //    tempListALLLocation.push(data[i]["IDZone"]);
                    //}
                    if (region != data[i]["NameRegion"]) {
                        region = data[i]["NameRegion"];
                        //$('#ul-' + data[i]["IDZone"].split(' ').join('_')).append("<li id='li-" + data[i]["IDRegion"].split(' ').join('_') + "'></li>");
                        $("#locationtree").append("<li id='li-" + data[i]["IDRegion"].split(' ').join('_') + "'></li>");
                        $('#li-' + data[i]["IDRegion"].split(' ').join('_')).append("<i class='fa fa-plus'></i> <label><input id='xnode-" + data[i]["IDRegion"].split(' ').join('_') + "' data-id='custom-" + data[i]["IDRegion"].split(' ').join('_') + "' name='disabledNode' type='checkbox'/>" + data[i]["NameRegion"] + "</label> <ul id='ul-" + data[i]["IDRegion"].split(' ').join('_') + "' style='display: none;'></ul>");
                        tempListALLLocation.push(data[i]["IDRegion"]);
                    }
                    if (warehouse != data[i]["NameWarehouse"]) {
                        warehouse = data[i]["NameWarehouse"];
                        $('#ul-' + data[i]["IDRegion"].split(' ').join('_')).append("<li id='li-" + data[i]["IDWarehouse"].split(' ').join('_') + "'></li>");
                        $('#li-' + data[i]["IDWarehouse"].split(' ').join('_')).append("<label><input class='hummingbirdNoParent' id='xnode-" + data[i]["IDWarehouse"].split(' ').join('_') + "' data-id='custom-" + data[i]["IDRegion"].split(' ').join('_') + "-" + data[i]["IDWarehouse"].split(' ').join('_') + "' name='disabledNode' type='checkbox'/>" + data[i]["NameWarehouse"] + "</label>");
                        tempListALLLocation.push(data[i]["IDWarehouse"]);
                    }
                }
                $("#locationtree").hummingbird('collapseAll');
                $("#locationtree").hummingbird();
                treeListChecked(roleId);
            }
        });
    }

    function generateListLocation(id) {
        var ul1 = $('#treeview');
        $.ajax({
            url: "MstUserLocationMap/GetWarehouseNameById",
            type: 'GET',
            cache: false,
            dataType: 'json',
            data: {"id": id},
            success: function (data) { 
                ul1.html('');
                $.each(data, function (key, val) {
                    var split = val.split(" - ");
                    var active = "Active";
                    if (split[1] == "False")
                        active = "Inactive";
                    ul1.append('<li value="' + split[0] + '">' + split[0] + ' - ' + active + '</li>');
                });
            }
        });
        generateListFunction(id);
    }

    function generateListFunction(id) {
        var ul2 = $('#treeview2');
        var tempRoleName = "";
        $.ajax({
            url: "MstUserLocationMap/GetMasterFunctionByIdUser",
            type: 'GET',
            cache: false,
            dataType: 'json',
            data: { "id": id },
            success: function (data) {
                ul2.html('');
                $.each(data, function (key, val) {
                    if (tempRoleName != val["roleName"]) {
                        tempRoleName = val["roleName"];
                        ul2.append(val["roleName"]);
                    }
                    ul2.append('<li value="' + val["functionName"] + '">' + val["functionName"] + '</li>');
                });
            }
        });
    }

    function treeListChecked(id) {
        if (id == undefined) {
            generateLocation = true;
            if (generateUser)
                $("#btnSaveNew").prop("disabled", false);
        }
        $.ajax({
            url: "MstUserLocationMap/GetIDLocationList?roleid=" + id,
            type: 'GET',
            dataType: 'json',
            cache: false,
            success: function (data) {
                tempListChecked = [];
                for (var x = 0; x < data.length; x++) {
                    tempListChecked.push(data[x]);
                    $("#locationtree").hummingbird("checkNode", { attr: "id", name: "xnode-" + data[x].split(' ').join('_'), expandParents: false });
                    var index = tempListALLLocation.indexOf(data[x]);
                    if (index > -1) {
                        tempListALLLocation.splice(index, 1);
                    }
                }
                //console.log(tempListALLLocation);
                //uncheck function baru yang diinsert langsung ke database
                for (var y = 0; y < tempListALLLocation.length; y++) {
                    $("#locationtree").hummingbird("uncheckNode", { attr: "id", name: "xnode-" + tempListALLLocation[y].split(' ').join('_'), expandParents: false });
                }

                $("#btnSaveNew").prop("disabled", false);
                generateLocation = true;
                if(generateUser)
                    $("#btnSaveNew").prop("disabled", false);
            }
        });
    }

    //function checkTreeFunction(checkbox) {
    //    var result = $.grep(tempArrayLocation, function (e) { return e == checkbox.value; });
    //    if (result.length == 0)
    //        tempArrayLocation.push(checkbox.value);
    //    else {
    //        tempArrayLocation = tempArrayLocation.filter(function (obj) {
    //            return obj !== checkbox.value;
    //        });
    //    }
