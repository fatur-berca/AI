<script type="text/javascript">
    var tempListChecked = [];
    var tempListUnchecked = [];//array untuk menampung location yang teruncheked dan yang akan di save ke database
    var tempArrayLocation = [];
    var tempListALLLocation = [];
    var defaultIsActive = true;

    var generateUser = false;
    var generateLocation = false;

    $(document).ready(function () {
        // BEGIN : GENERAL Logic
        // clear field when click add new btn
        $('#addNew').click(function () {
            generateUser = false;
            generateLocation = false;
            resetData();
            $('#InsertOrUpdate').val("INSERT");
            //generateTreeLocation(0);
            generateDropDown();
            generateTreeListLocation();
            $("#UserID").prop("disabled", false);
            $("#btnSaveNew").prop("disabled", true);
            tempArrayLocation = [];
            defaultIsActive = "";
        });
    });

    function resetData() {
        $('#newData')[0].reset();
    }
    // END : GENERAL Logic

    // BEGIN : JQUERY SELECT TO DataTable
    //call generate table
    generateTable();

    function generateDropDown(iduser) {
        var select = $('#UserID');
        $.ajax({
            url: 'MstUserLocationMap/GetMasterUser',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                select.html('');
                $.each(data,
                    function(key, val) {
                        select.append('<option value="' + val.IDUser + '">' + val.IDUser + ' - ' + val.FullName + '</option>');
                    });
                $('#UserID').select2('val', iduser);
                generateUser = true;
                if(generateLocation)
                    $("#btnSaveNew").prop("disabled", false);
            },
            error: function () {
                select.html('<option value="NULL">none available</option>');
            }
        });
    }

    //generate table
    function generateTable() {
        $("#Loading").modal('show');
        $.ajax({
