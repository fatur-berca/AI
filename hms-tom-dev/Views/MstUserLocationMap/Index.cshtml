    //MENGECEK TREE LIST 2 SEBELUM SAVE START
    function CheckTreeListBeforeSave() {
        tempListUnchecked = [];
        var ListChecked = [];
        var ListUnchecked = [];
        //console.log(tempListChecked);
        $("#locationtree").hummingbird("getChecked", { attr: "id", list: ListChecked });//mengambil semua id yang tercheck
        $("#locationtree").hummingbird("getUnchecked", { attr: "id", list: ListUnchecked });//mengambil semua id yang uncheck
        for (var i = 0; i < ListChecked.length; i++) {
            var id = ListChecked[i].split("-");
            var result = $.grep(tempListChecked, function (e) { return e == id[1].split('_').join(' '); });//mencari apakah id function yang tercheck ada didatabase
            if (result.length == 0) {
                var result2 = $.grep(tempArrayLocation, function (e) { return e == id[1].split('_').join(' '); });//kalau tidak dapat, mencari di array yang akan disave database, apakah sudah ada id functionnya
                if (result2.length == 0)
                    tempArrayLocation.push(id[1].split('_').join(' '));//kalau tidak ada id function di masukkan ke dalam array
            }
            else {
                tempArrayLocation = tempArrayLocation.filter(function (obj) {//kalau dapat, maka id functionnya dikeluarkan
                    return obj !== id[1].split('_').join(' ');
                });
            }
        }
        for (var j = 0; j < ListUnchecked.length; j++) {
            var iduncheck = ListUnchecked[j].split("-");
            var resultuncheck = $.grep(tempListChecked, function (e) { return e == iduncheck[1]; });//mencari apakah id function yang teruncheck ada didatabase
            if (resultuncheck[0] != undefined) {
                tempArrayLocation.push(resultuncheck[0].split('_').join(' '));//kalau dapat, artinya id function yang ada didatabase, di uncheck/mau dihilangkan dari mapping. id function di masukkan ke dalam array
                tempListUnchecked.push(resultuncheck[0].split('_').join(' '));//kalau datanya disimpan, maka akan menghilangkan lokasi yang ada di array tempListUnchecked dan ada di array tempListChecked
            } else {
                var result2uncheck = $.grep(tempArrayLocation, function (e) { return e == iduncheck[1].split('_').join(' '); });//kalau tidak dapat, mencari di array yang akan disave database, apakah sudah ada id functionnya
                if (result2uncheck.length != 0) {
                    tempArrayLocation = tempArrayLocation.filter(function (obj) {//kalau dapat, id functionnya di hilangkan dari array yang akan di simpan di database(defaultnya teruncheck, setelah itu di check, kemudian diuncheck lagi)
                        return obj !== result2uncheck[0].split('_').join(' ');
                    });
                    tempListUnchecked = tempListUnchecked.filter(function (obj) {//fungsinya sama seperti diatas tapi digunakan di array tempListUnchecked
                        return obj !== result2uncheck[0].split('_').join(' ');
                    });
                }
            }
        }
    }
    //MENGECEK TREE LIST 2 SEBELUM SAVE END

    // BEGIN : Insert New Data
    $('#btnSaveNew').click(function () {
        $("#Loading").modal('show');
        if ($('#newData').find('input[id="InsertOrUpdate"]').val() == "UPDATE") {
            //var status = $('#Status :selected').val() == 1 ? true : false;
            //if (defaultIsActive != status) {
            //    var userid = $('#UserID :selected').val();
            //    $.ajax({
            //        type: 'POST',
            //        url: 'MstUserLocationMap/UpdateIsActive?iduser=' + userid + '&status=' + status,
            //        success: function () {
            //            generateTable();
            //            resetData();
            //            //$('#inputModal').modal('hide');
            //            generateTable();
            //            $('#modalsuccess').modal('show');
            //            $("#Loading").modal('hide');
            //        }
            //    });
            //}
            //else
                edit();
        } else {
            save();
        }
    });

    function save() {
        CheckTreeListBeforeSave();
        var id = $('#newData').find('input[id="IDUserLocationMapping"]').val();        
        var userid = $('#UserID :selected').val();
        var idlocation = tempArrayLocation;        
        //var status = $('#Status :selected').val() == 1 ? true : false;
        var data = {
            "new": [{ "IDLocation": id, "IDUser": userid, "ListIDLocation": idlocation, "IsActive": true }],
            "edit": [{}]
        };
        $.ajax({
            type: 'POST',
            url: 'MstUserLocationMap/InsertUserLocationMapping',
            data: data,
            success: function (data) {
                for (var i = 0; i < tempArrayLocation.length; i++) {
                    tempListChecked.push(tempArrayLocation[i]);
                }
                generateTable();
                removeLocationFromtempListChecked();
                //$('#inputModal').modal('hide');
                $("#locationtree").hummingbird('collapseAll');                
                $('#modalsuccess').modal('show');
                $("#Loading").modal('hide');
            }
        });
    }
    // END : Insert New Data

    // BEGIN : Edit Data
    // get edit data and assign to modal

    function editTable(id) {
        generateUser = false;
        generateLocation = false;
        $('#newData')[0].reset();
        tempArrayLocation = [];
        $('#InsertOrUpdate').val("UPDATE");
        $("#UserID").prop("disabled", true);
        $("#btnSaveNew").prop("disabled", true);
        var table = $('#dtFilterMaster').DataTable();
        $('#dtFilterMaster tbody').one('click', 'tr', function() {
            var data = table.row(this).data();
            $('#UserID').append('<option value=' + data['IDUser'] + '>' + data['IDUser'] + '</option>');
            $('#UserID').select2("val", data["IDUser"]);
            //$('#UserID').select2("val", data["IDUser"]);
            //generateDropDown(data["IDUser"]);
            generateTreeListLocation(data["IDUser"]);
            //defaultIsActive = data["IsActive"];
            //if (data["IsActive"])
                $('#Status').val("1");
            //else
            //    $('#Status').val("0");
        });
        $('#inputModal').modal('show');
    }

    //update edited data
    function edit() {
        //console.log(tempArrayLocation);
        CheckTreeListBeforeSave();
        var id = $('#newData').find('input[id="IDUserLocationMapping"]').val();
        var userid = $('#UserID').val();
        var idlocation = tempArrayLocation;
        //console.log(tempArrayLocation);
        var status = $('#Status :selected').val() == 1 ? true : false;
        var data = {
            "new": [{}],
            "edit": [{ "IDUserLocationMapping": id, "IDLocation": id, "IDUser": userid, "ListIDLocation": idlocation, "IsActive": status }]
        };
        $.ajax({
            type: 'POST',
            url: 'MstUserLocationMap/InsertUserLocationMapping',
            data: data,
            success: function (data) {
                for (var i = 0; i < tempArrayLocation.length; i++) {
                    tempListChecked.push(tempArrayLocation[i]);
                }
                generateTable();
                removeLocationFromtempListChecked();
                $("#locationtree").hummingbird('collapseAll');
                //close modal
                //$('#inputModal').modal('hide');
                $('#modalsuccess').modal('show');
                $("#Loading").modal('hide');
            }
        });
    }

    function removeLocationFromtempListChecked() {
        for (var i = 0; i < tempListUnchecked.length; i++) {
            var result = $.grep(tempListChecked, function (e) { return e == tempListUnchecked[i]; });//kalau tidak dapat, mencari di array yang akan disave database, apakah sudah ada id functionnya
            if (result.length != 0) {
                tempListChecked = tempListChecked.filter(function (obj) {//kalau dapat, id functionnya di hilangkan dari array yang akan di simpan di database(defaultnya teruncheck, setelah itu di check, kemudian diuncheck lagi)
                    return obj !== tempListUnchecked[i];
                });
            }
        }
    }
</script>



