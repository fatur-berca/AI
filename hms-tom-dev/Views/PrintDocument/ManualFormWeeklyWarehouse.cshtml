@using OfficeOpenXml.FormulaParsing.Excel.Functions.Math
@model hms_tom_dev.Models.WarehouseStockCountViewModel
@{
    //ViewBag.Title = "Warehouse > Seal Management > PrintDocument";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime PrintedDate = Model.CreatedDate;
    const int MAX_ROW_PER_PAGE = 40;
    hms_tom_dev.Models.WarehouseStockCountListViewModel tool = new hms_tom_dev.Models.WarehouseStockCountListViewModel();
}


@*<link rel="stylesheet" href="@Server.MapPath("~/Assets/Css/app.css")" media="screen">*@
@*<link rel="stylesheet" href="~/Assets/Css/app.css" media="screen">*@
@*<link rel="stylesheet" href="../Assets/Css/app-new.css" media="screen">*@

<link rel="stylesheet" href="@Url.Content("~/assets/css/select2.min.css")" media="screen">
<link rel="stylesheet" href="@Url.Content("~/assets/css/jquery.dataTables.min.css")" media="screen">
<link rel="stylesheet" href="@Url.Content("~/assets/css/bootstrap-datetimepicker.min.css")" media="screen">
<link rel="stylesheet" href="@Url.Content("~/assets/css/lightbox.min.css")" media="screen">
<link rel="stylesheet" href="@Url.Content("~/assets/css/jquery-ui.css")" media="screen">
<link rel="stylesheet" href="@Url.Content("~/assets/css/flaticon.css")" media="screen">
<link rel="stylesheet" href="@Url.Content("~/assets/css/app.css")" media="screen">
<link rel="stylesheet" href="@Url.Content("~/assets/css/ReportStockCount.css")" media="screen">

<script src="@Url.Content("~/assets/js/jquery-1.12.4.min.js")"></script>


<style>
    .imgPdf {
        width: 240px !important;
        height: 190px !important;
    }

    .widthTableHeader {
        width: 280px !important;
    }

    .widthTable {
        width: 368px !important;
    }

    .widthTableValue {
        width: 144px !important;
    }

    .widthTableHeadcount {
        width: 170px !important;
    }

    .images-wrap {
        width: 740px !important;
    }

    table {
        width: 100% !important;
    }

    .fixedheight .topbottom {
        height: 75px;
    }

    .fixedheight .middle {
        height: 96px;
    }

   .numberAlign {
        text-align: right;
    }

   .contentAlign {
        text-align : center;
    }

    table tr th {
        text-align: center;
    }

    .batchWidth {
        width:60px;
    }

    .page_break { 
      page-break-after: always; 
    }

    th[rowspan] {
        position: relative;
    }

    th[rowspan]:before {
        position: absolute;
        content: "";
        top: 0px;
        left: -1px;
        background-color: transparent;
        border-left: solid #444 1px;
        width: 100%;
        height: 100%;
    }
</style>

<body class="report-page watermarks" style="">
    <main style="width:100%">
        @{
            var r = Model;
            var idx_head = 0;
            var start = 0;
            int recordno = 0;
            bool IsRenderNumbering = false;
            foreach (string SLoc in Model.WEEKLY_STORE_LOCATION)
            {
                start = 0;
                int no = 0;
                int TotalDetail = r.WarehouseStockCountDetails.Where(f => f.SLoc == SLoc).ToList().Count;
                if (TotalDetail == 0) { continue; }
                while (true)
                {
                    IsRenderNumbering = false;
                    var StockCountDetails = r.WarehouseStockCountDetails.Where(f => f.SLoc == SLoc).Skip(start).Take(MAX_ROW_PER_PAGE).ToList();
                    if (StockCountDetails.Count == 0) { break; }
                    idx_head++;
                    <div style="float:right; @(recordno > 0 ? "padding-top:15px;" : "")" class="numbering"></div>
                    <h3 class="title noline" style="@(recordno > 0 ? "padding-top:30px;" : "")"> <b> FORM MANUAL STOCK COUNT </b></h3>

                    <ul class="col-data" style="width:45%;">
                        <li><label>Warehouse</label><span>: <b> @r.WarehouseName </b></span></li>
                        <li><label>Week</label><span>: <b> @r.Week </b></span></li>
                    </ul>

                    <ul class="col-data" style="width:45%;">
                        <li><label>Date</label><span>: <b> @r.TransDate.ToString("dd-MMM-yyyy") </b> </span></li>
                        <!--<li><label>Time</label><span>: <b> @Model.CreatedDate.ToString("HH:mm") WIB </b> </span></li>-->
                    </ul>

                    <div style="" class="div_small_box">
                        <div style="" class="slocinfo"><b>SLoc</b></div>
                        <div style="padding: 4px 1px 1px 4px;"><b>@SLoc</b></div>
                    </div>

                    <table class="table">
                        <thead>
                            <tr>
                                <th rowspan="2" style="width:5%">No</th>
                                <th rowspan="2" style="width:20%;">Brand</th>                               
                                <th colspan="4">Quantity (Recehan)</th>
                                <th colspan="1" rowspan="2" style="width:70px">Grand Total (Pack)</th>
                            </tr>
                            <tr style="">
                                <th class="batchWidth">Box</th>
                                <th class="batchWidth">Bal</th>
                                <th class="batchWidth">Slof</th>
                                <th class="batchWidth">Pack</th>
                                <!--<th></th>-->
                            </tr>
                        </thead>
                    <tbody>
                        @for (int i = 0; i < StockCountDetails.Count; i++)
                        {
                            recordno++;
                            var row = StockCountDetails[i];
                            no += 1;
                            <tr>
                                <td class="contentAlign">@(Html.Raw(String.IsNullOrEmpty(row.Brand) ? "&nbsp" : "" + no))</td>
                                <td class="contentAlign">@row.Brand</td>
                                <td></td>                                
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                        }
                    </tbody>
                </table>
                    if (recordno < Model.WarehouseStockCountDetails.Count && StockCountDetails.Count > (MAX_ROW_PER_PAGE - 10))
                    {
                        <div class="page_break"></div>
                        IsRenderNumbering = true;
                    }
                    /*untuk kasih numbering jika signature berada pada page berikutnya (count detail harus sama dengan pengecekan di atas)*/
                    if (no >= TotalDetail && StockCountDetails.Count > (MAX_ROW_PER_PAGE - 7))
                    {
                        <div style="float:right; padding-top:5px;" class="numbering"></div>
                    }
                    
                    start += MAX_ROW_PER_PAGE;
                }
                <div class="signature">
                    <p>
                        Remarks: <br />
                    </p>
                    <div class="sign text-center">
                        <p>&nbsp</p>
                        <p class="name">(______________)</p>
                        <p>Helper / Admin Area</p>
                    </div>
                    <div class="sign text-center">
                        <p>&nbsp</p>
                        <p class="name">(______________)</p>
                        <p>DA / Admin Area</p>
                    </div>
                    <div class="sign text-center">
                        <p>&nbsp</p>
                        <p class="name">(______________)</p>
                        <p>Regional Team</p>
                    </div>

                    <div class="sign text-center" style="float:right">
                        <p>Mengetahui,</p>
                        <p class="name">(______________)</p>
                        <p>SAD / DC</p>
                    </div>
                </div>
                <hr class="bold" />
                <p class="printed printedby page_break">Printed by : @Model.UserName on @PrintedDate.ToString("dd-MMM-yyyy HH:mm")</p>
            }
        }
       @if (Model.WarehouseStockCountDetails.Count == 0)
       {
           <h1>No Data Found</h1>
       }
       else
       {

       }
    </main>
</body>

<script type="text/javascript">
    $(function () {
        var total_page = $('.numbering').length;
        var no = 1;
        $('.numbering').each(function (e) {
            $(this).html(no + ' of ' + total_page);
            no++;
        });
    });

</script>
