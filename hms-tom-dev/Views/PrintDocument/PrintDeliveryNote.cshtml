                    <div class="row" style="border:1px solid black;margin:10px 5px 10px 0;padding:10px 5px;">
                        @Model.ListTOGroup[i].WarehouseAddressReceiver
                    </div>
                </div>
                <div class="clearfix" style="height:20px;"></div>
                @*<div class="col-md-12">
                    <div class="row" style="margin:10px 5px 10px 0;">
                        Order Remarks
                    </div>
                    <div class="row" style="border:1px solid black;margin:10px 5px 10px 0;padding:10px 5px;">
                        @Model.ListTOGroup[i].Remarks
                    </div>
                </div>*@
            </div>
            <div class="clearfix" style="height:40px;"></div>
            <div class="col-md-12" style="left:15px;padding-left:0px !important;">
                <table border="0" style="width: 98%;" class="detail-data">
                    <thead class="toppad">
                        <tr>
                            <th style="width: 10%" class="data">Order Number/STO</th>
                            <th style="width: 10%" class="data">Type</th>
                            <th style="width: 7%" class="data">Qty</th>
                            <th style="width: 9%" class="data">UoM</th>
                            <th style="width: 12%" class="data">FA Code</th>
                            <th style="width: 12%" class="data">Description</th>
                            <th style="width: 2%" class="data">KPS</th>
                            <th class="data">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ 
                            var page = 0;
                            double row = 1;
                            var firstPageLimit = 25;
                            var pageLimit = 40;
                        }
                        @for (var j = 0; j < OrderDetails.Count; j++)
                        {
                        <tr>
                            <td class="data">@OrderDetails[j].STONo</td>
                            <td class="data">@OrderDetails[j].MaterialType</td>
                            <td class="data">
                                @if (OrderDetails[j].Qty.HasValue)
                                {@Math.Round(OrderDetails[j].Qty.Value, 2).ToString("N0")}
                            </td>
                            <td class="data">@OrderDetails[j].UoM</td>
                            <td class="data">@OrderDetails[j].Code</td>
                            <td class="data">@OrderDetails[j].Description</td>
                            <td class="data"></td>
                            <td class="data">@OrderDetails[j].Remarks</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if(((page == 0 && row > (firstPageLimit - 4)) || (page > 0 && row > (pageLimit - 4))) && false)
            {
                <div style="page-break-before:always;" class="numbering"></div>
            }
            <div class="clearfix" style="margin-bottom: 20px;"></div>
            <div class="nobreak toppad">
                <div class="clearfix" style="height:20px;"></div>
                <div class="col-md-3 sign text-center">
                    <p>Sampoerna PIC</p>
                    <div class="clearfix" style="height:60px;"></div>
                    <p class="name">(@Model.SampoernaPIC)</p>
                    <p style="text-align:left;padding-left:40px;">Date: @DateTime.Now.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="col-md-3 sign text-center">
                    <p>Driver</p>
                    <div class="clearfix" style="height:60px;"></div>
                    <p class="name">(______________)</p>
                    <p style="text-align:left;padding-left:40px;">Date: </p>
                </div>
                <div class="col-md-3 sign text-center">
                    <p>Receiver</p>
                    <div class="clearfix" style="height:60px;"></div>
                    <p class="name">(______________)</p>
                    <p style="text-align:left;padding-left:40px;">Date: </p>
                </div>
                <div class="col-md-3 sign text-center">
                    <p>Sender</p>
                    <div class="clearfix" style="height:60px;"></div>
                    <p class="name">(______________)</p>
                    <p style="text-align:left;padding-left:40px;">Date: </p>
                </div>
            </div>
        </div>
    </main>
    <div style="page-break-before:always;" class="numbering"></div>
    }

    <!-- BEGIN GATE PASS -->
