                    </div>
                        <div class="col-md-3">
                            <strong>Vessel Name</strong>
                        </div>
                        @if (!String.IsNullOrEmpty(Model.ListTOGroup[i].VesselName))
                        {
                            <div class="col-md-3">
                                : @Model.ListTOGroup[i].VesselName
                            </div>
                        }
                        else 
                        {
                            <div class="col-md-3">
                                : ...................
                            </div>
                        }
                    </div>
                <div class="row">
                    <div class="col-md-3">
                        <strong>Vehicle Type</strong>
                    </div>
                    <div class="col-md-3">
                        : @Model.ListTOGroup[i].ActualVehicleType
                    </div>
                    <div class="col-md-3">
                        <strong>Container Number</strong>
                    </div>
                    @if (!String.IsNullOrEmpty(Model.ListTOGroup[i].ContainerNo))
                    {
                        <div class="col-md-3">
                            : @Model.ListTOGroup[i].ContainerNo
                        </div>
                    }
                    else
                    {
                        <div class="col-md-3">
                            : ...................
                        </div>
                    }
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <strong>Police Registration Number</strong>
                    </div>
                    <div class="col-md-3">
                        : @Model.ListTOGroup[i].PoliceRegNo
                    </div>
                    <div class="col-md-3">
                        <strong>Container Seal</strong>
                    </div>
                    @if (!String.IsNullOrEmpty(Model.ListTOGroup[i].ContainerSeal))
                    {
                        <div class="col-md-3">
                            : @Model.ListTOGroup[i].ContainerSeal
                        </div>
                    }
                    else
                    {
                        <div class="col-md-3">
                            : ...................
                        </div>
                    }

                </div>
                <div class="row">
                    <div class="col-md-3">
                        <strong>Vendor</strong>
                    </div>
                    <div class="col-md-9">
                        : @Model.ListTOGroup[i].VendorName
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-3">
                        <strong>No DN</strong>
                    </div>
                    <div class="col-md-3">
                        : ...................
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-3">
                        <strong>No Segel</strong>
                    </div>
                    <div class="col-md-3">
                        : ...................
                    </div>
                </div>
                <div class="clearfix" style="height:10px;"></div>
                <div class="row">
                    <div class="col-md-3">
                        <strong>Driver 1 ID/Name</strong>
                    </div>
                    @if (!String.IsNullOrEmpty(Model.ListTOGroup[i].DriverName1))
                    {
                        <div class="col-md-3">
                            : @Model.ListTOGroup[i].DriverName1
                        </div>
                    }
                    else
                    {
                        <div class="col-md-3">
                            : ...................
                        </div>
                    }
                    <div class="col-md-3">
                        <strong>Start Address</strong>
                    </div>
                    <div class="col-md-3">
                        : @Model.ListTOGroup[i].StartLocation
                    </div>
                </div>
                  
                    <div class="row">
                        <div class="col-md-3">
                            <strong>Driver 2 ID/Name</strong>
                        </div>
                        @if (!String.IsNullOrEmpty(Model.ListTOGroup[i].DriverName2))
                        {
                            <div class="col-md-3">
                                : @Model.ListTOGroup[i].DriverName2
                            </div>
                        }
                        else
                        {
                            <div class="col-md-3">
                                : ...................
                            </div>
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <strong>Co-Driver ID/Name</strong>
                        </div>
                        @if (!String.IsNullOrEmpty(Model.ListTOGroup[i].CoDriverName))
                        {
                            <div class="col-md-3">
                                : @Model.ListTOGroup[i].CoDriverName
                            </div>
                        }
                        else
                        {
