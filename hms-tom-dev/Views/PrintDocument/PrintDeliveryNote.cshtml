@model hms_tom_dev.Models.Transport.TransportExecutionPrintViewModel
<link rel="stylesheet" href="../Assets/Css/app-new.css" media="screen">
<style>
    /*.report-page.watermarks main {
        background-image: url("../../Assets/images/watermarks.jpg");
    }*/
    .watermarks {
        background-image: url("../../Assets/images/watermarks.jpg");
        background-size: 100% auto;
        background-repeat: repeat;
        background-position-y: 20px;
        background-position: center top;         
    }
    .report-data {
        padding: 50px;
        padding-top: 20px;
    }
    body {
        background-color: #ffffff;
        color: black!important;
        font-family: sans-serif;
        font-size: 15px;
        font-weight: normal;
    }
    table.detail-data {
        color: black;
        font-size: 13px;
        border-collapse: collapse
    }
    table.detail-data td, table.detail-data th {
        padding: 8px 12px;
        border: none
    }
    table.detail-data tr {
        border: none;
    }
    table.detail-data td.separator, table.detail-data th.separator {
        border: none;
    }
    table.detail-data td.data, table.detail-data th.data {
        border: 1px solid black;
    }

    table.pass-data {
        color: black;
        font-size: 13px;
        border-collapse: collapse;
    }
    table.pass-data td, table.pass-data th {
        padding: 8px 12px;
        border: 1px solid black;
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-row-group
    }

    tr {
        page-break-inside: avoid
    }

    .nobreak {
        page-break-inside: avoid;
        position: relative;
    }

    .nobreak * {
        page-break-inside: avoid;
    }

    .toppad {
        margin-top: 20px !important;
    }
</style>
<body class="report-page">
    
@for (var i = 0; i < @Model.TotalPage; i++)
{
    //var OrderDetails = @item.OrderDetails;
    //var idto = @Model.ListTOGroup[i].IDTransportOrder;
    //var OrderDetails = @Model.ListTOD.Where(x => x.IDTransportOrder == idto).ToList();
    var idte = @Model.ListTOGroup[i].IDTransportExecution;
    var sender = @Model.ListTOGroup[i].SenderIDLocation;
    var receiver = @Model.ListTOGroup[i].ReceiverIDLocation;
    var OrderDetails = @Model.ListTOD.Where(x => x.IDTransportExecution == idte && x.SenderIDLocation == sender && x.ReceiverIDLocation == receiver).OrderBy(f => f.IDTransportOrder).ThenBy(_ => _.STONo).ToList();
    int TotalPage = (int)OrderDetails.Count / (int)@Model.MAX_ROW_PER_PAGE;
    int take = @Model.MAX_ROW_PER_PAGE;
    var base64String = "data:image/png;base64," + @Model.ListTOGroup[i].TNBarcode;
    <main class="watermarks">
        <div class="row report-data">
            <div class="col-md-12">
                <div class="col-md-9">
                    <h2 class="title">Transportation Delivery Note</h2>
                </div>
                <div class="col-md-3">
                    <img src="@base64String" class="preview_barcode" style="width: 200px; height: 35px;"><br />
                    <h4 style="font-weight:bold;">@Model.ListTOGroup[i].TransportNo </h4>
                </div>
            </div>
            <br />
            <div>
                <div class="row">
                    <div class="col-md-3">
                        <strong>Transportation Date</strong>
                    </div>
                    <div class="col-md-3">
