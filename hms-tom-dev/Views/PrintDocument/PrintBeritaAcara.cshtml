@using OfficeOpenXml.FormulaParsing.Excel.Functions.Math
@model hms_tom_dev.Models.Warehouse.WarehouseStockCountPrintBeritaAcaraViewModel
@{
    //ViewBag.Title = "Warehouse > Seal Management > PrintDocument";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    string userName = Model.UserName;
    string IDStockCount = Model.IDStockCount;
    string IDLocation = Model.IDLocation;
    string LocationName = Model.LocationName;
    string Address = Model.Address;
    string PrintedDate = Model.PrintedDate;
    int lenOwner = Model.LenOwner;
    int lenStock = Model.LenStock;
    string status = Model.Status;

    string state = "";
    if (status == "Balance")
    {
        state = "tidak ditemukan selisih";
    }
    else
    {
        state = "ditemukan selisih (" + status + ")";
    }

    List<string> namaOwner = new List<string>();
    List<string> jabatanOwner = new List<string>();
    List<string> namaStock = new List<string>();
    List<string> jabatanStock = new List<string>();

    for (var i = 0; i < lenOwner; i++)
    {
        namaOwner.Add(Model.NamaOwner[i].ToString());
        jabatanOwner.Add(Model.JabatanOwner[i].ToString());
    }

    for (var i = 0; i < lenStock; i++)
    {
        namaStock.Add(Model.NamaStock[i].ToString());
        jabatanStock.Add(Model.JabatanStock[i].ToString());
    }

    if (lenOwner != 3)
    {
        for (var i=lenOwner-1; i<3; i++)
        {
            namaOwner.Add(" ".ToString());
            jabatanOwner.Add(" ".ToString());
        }
    }
    if (lenStock != 3)
    {
        for (var i=lenStock-1; i<3; i++)
        {
            namaStock.Add(" ".ToString());
            jabatanStock.Add(" ".ToString());
        }
    }
}


