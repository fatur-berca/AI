        </table>

        <div class="signature">
            <div class="sign">
                <p>Driver/Transporter</p>
                <p class="name">AJI/BAYU</p>
            </div>
            <div class="sign text-center">
                <p>Receiver</p>
                <p class="name">Warehouse Staff-1</p>
            </div>
            <div class="sign text-center">
                <p>Witness</p>
                <p class="name">Warehouse Staff-2</p>
