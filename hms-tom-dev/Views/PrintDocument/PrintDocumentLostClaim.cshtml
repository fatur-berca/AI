@model hms_tom_dev.Models.Transport.TransportLostClaimDamageViewModel

@*<link rel="stylesheet" href="@Server.MapPath("~/Assets/Css/app.css")" media="screen">*@
<link rel="stylesheet" href="../Assets/Css/app-new.css"  media=" screen">


<style>
    .imgPdf {
        width:200px !important;
        height:200px !important;
    }
</style>

<body class="report-page" >
    <main>

        <h3 class="title">BERITA ACARA (BA) ROKOK RUSAK/HILANG DALAM PENGIRIMAN</h3>
        @*<h5 class="renumber">No: @Model.renumber</h5>*@

        <ul class="col-data">
            <li><label>Sender</label><span>: @Model.OriginWarehouse</span></li>
            <li><label>Receiver</label><span>: @Model.DestinationWarehouse</span></li>
            <li><label>Order Number/STO</label><span>: @Model.SJNumber</span></li>
            <li><label>DN Number</label><span>: @Model.DeliveryNumberNote</span></li>
            <li><label>Date of Delivery</label><span>: @Model.DateOfDelivery</span></li>
            <li><label>Date of Receipt</label><span>: @Model.DateOfIncident</span></li>
        </ul>

        <ul class="col-data">
            <li><label>Transportation Vendor</label><span>: @Model.TransportationVendorName</span></li>
            <li><label>Police Reg. Number</label><span>: @Model.PoliceRegNumber</span></li>
            <li><label>Driver 1 & Driver 2</label><span>: @Model.Driver & @Model.Driver2</span></li>
            <li><label>Co-Driver</label><span>: @Model.CoDriver</span></li>
            <li><label>Transportation Number</label><span>: @Model.GPNumber</span></li>
        </ul>

        <style>
            th[rowspan]:nth-child(4), th[rowspan]:nth-child(5) {
                position: relative;
            }
            th[rowspan]:nth-child(4):before, th[rowspan]:nth-child(5):before {
                position: absolute;
                content: "";
                top: 0px;
                left: -1px;
                background-color: transparent;
                border-left: solid #BBBBBB 1px;
                width: 100%;
                height: 100%;
            }
        </style>

        <table class="table">
            <thead>
                <tr>
                    <th rowspan="2" align="center" valign="middle" style="text-align: center; vertical-align: middle; font-family: 'Karla-Bold';">No</th>
                    <th colspan="2" align="center" valign="middle" style="text-align: center; vertical-align: middle; font-family: 'Karla-Bold';">Item Detail</th>
                    <th rowspan="2" align="center" valign="middle" style="text-align: center; vertical-align: middle; font-family: 'Karla-Bold';">Category</th>
                    <th rowspan="2" align="center" valign="middle" style="text-align: center; vertical-align: middle; font-family: 'Karla-Bold';">Total Packs</th>
                    <th rowspan="2" align="center" valign="middle" style="text-align: center; vertical-align: middle; font-family: 'Karla-Bold';">Remarks</th>
                </tr>
                <tr>
                    <th align="center" valign="middle" style="text-align: center; vertical-align: middle; font-family: 'Karla-Bold';">FA Code</th>
                    <th align="center" valign="middle" style="text-align: center; vertical-align: middle; font-family: 'Karla-Bold';">Speaking Code</th>
                </tr>
            </thead>
            <tbody>
                @{var no = 1;}
                @for (var i = 0; i < Model.ListFACode.Count(); i++)
                {
                <tr>
                    <td align="center" valign="middle" style="text-align: center; vertical-align: middle;">@no</td>
                    <td align="center" valign="middle" style="text-align: center; vertical-align: middle;">@Model.ListFACode[i].FACode</td>
                    <td align="center" valign="middle" style="text-align: center; vertical-align: middle;">@Model.ListFACode[i].SpeakingCode</td>
                    <td align="center" valign="middle" style="text-align: center; vertical-align: middle;">@Model.ListFACode[i].LostOrDamage</td>
                    <td align="center" valign="middle" style="text-align: center; vertical-align: middle;">@Model.ListFACode[i].Pack</td>
                    <td>@Model.ListFACode[i].Description</td>
                </tr>
                    { no++; }
                }
               
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" align="center" valign="middle" style="text-align: center; vertical-align: middle;">Total</td>
                    <td>&nbsp;</td>
                    <td align="center" valign="middle" style="text-align: center; vertical-align: middle;">@Model.ListFACode.Where(c => c.Pack != null || c.Pack != "").Sum(c => Convert.ToInt32(c.Pack))</td>
                    <td>&nbsp;</td>
                </tr>
            </tfoot>
        </table>
        <h4 class="section-title">Additional Notes (Pictures)</h4>
        <em>Position on Truck</em>
        <div class="images-wrap" style="min-height:200px">
            @if (!String.IsNullOrEmpty(Model.ImageUploadPositionTruckPath1))
            {
                <img src="@Model.ImageUploadPositionTruckPath1_Img64Base" alt="" class="imgPdf">
            }
            @if (!String.IsNullOrEmpty(Model.ImageUploadPositionTruckPath2))
            {
                <img src="@Model.ImageUploadPositionTruckPath2_Img64Base" alt="" class="imgPdf">
            }
            @if (!String.IsNullOrEmpty(Model.ImageUploadPositionTruckPath3))
            {
                <img src="@Model.ImageUploadPositionTruckPath3_Img64Base" alt="" class="imgPdf">
            }
        </div>
        <em>Boxes Condition</em>
        <div class="images-wrap" style="min-height:200px">
            @if (!String.IsNullOrEmpty(Model.ImageUploadConditionBoxPath1))
            {<img src="@Model.ImageUploadConditionBoxPath1_Img64Base" alt="" class="imgPdf">}
            @if (!String.IsNullOrEmpty(Model.ImageUploadConditionBoxPath2))
            {<img src="@Model.ImageUploadConditionBoxPath2_Img64Base" alt="" class="imgPdf">}
            @if (!String.IsNullOrEmpty(Model.ImageUploadConditionBoxPath3))
            {<img src="@Model.ImageUploadConditionBoxPath3_Img64Base" alt="" class="imgPdf">}
        </div>

        <em>Final Result</em>
        <div class="images-wrap" style="min-height:200px">
            @if (!String.IsNullOrEmpty(Model.ImageUploadFinalResultPath1))
                {<img src="@Model.ImageUploadFinalResultPath1_Img64Base" alt="" class="imgPdf">}
            else
            { <img src="" alt="" class="imgPdf" style="display:none">}
            @if (!String.IsNullOrEmpty(Model.ImageUploadFinalResultPath2))                             
                {<img src="@Model.ImageUploadFinalResultPath2_Img64Base" alt="" class="imgPdf">}
            else
            { <img src="" alt="" class="imgPdf" style="display:none">}
            @if (!String.IsNullOrEmpty(Model.ImageUploadFinalResultPath3))                             
                {<img src="@Model.ImageUploadFinalResultPath3_Img64Base" alt="" class="imgPdf">}
            else
            { <img src="" alt="" class="imgPdf" style="display:none">}
        </div>

        <div class="signature">
            <div class="sign">
                <p>Driver 1/Driver 2/Co-Driver</p>
                <p class="name">@Model.Driver/@Model.Driver2/@Model.CoDriver</p>
            </div>
            <div class="sign text-center">
                <p>Receiver</p>
                <p class="name">@Model.Receiver</p>
            </div>
            <div class="sign text-center">
                <p>Witness</p>
                <p class="name">@Model.Witness</p>
            </div>
            <div class="sign text-center">
                <p>Supervisor Area</p>
                <p class="name">@Model.Supervisor</p>
            </div>
        </div>

        <em>*created by @Model.CreatedByName</em><br />
        <em>*printed by @Model.PrintedBy on @DateTime.Now.ToShortDateString() @DateTime.Now.ToShortTimeString()</em>
        @*<div style="page-break-after: always;"></div>

        <h3 class="title nu">No: @Model.renumber</h3>

        <h3 class="title bmb">SERAH TERIMA ROKOK RUSAK</h3>

        <p>Telah dikirimkan @Model.ListFACode.Where(c => c.Pack != null || c.Pack != "").Sum(c => Convert.ToInt32(c.Pack)) pack rokok dari @Model.originWarehouseName kepada pihak Reversal Logistics pada tanggal @Model.DateOfIncident dengan no DN tujuan Reversal Logistics: @Model.DNtoReverseLogistics</p>

        <h4 class="section-title">KELENGKAPAN DATA BACR</h4>

        <ul class="col-data">
            <li><label>Sender</label><span>: @Model.OriginWarehouse</span></li>
            <li><label>Receiver</label><span>: @Model.DestinationWarehouse</span></li>
            <li><label>Order Number/STO</label><span>: @Model.SJNumber</span></li>
            <li><label>DN Number</label><span>: @Model.DeliveryNumberNote</span></li>
            <li><label>Date of Delivery</label><span>: @Model.DateOfDelivery</span></li>
            <li><label>Date of Receipt</label><span>: @Model.DateOfIncident</span></li>
            
        </ul>

        <ul class="col-data">
            <li><label>Transportation Vendor</label><span>: @Model.TransportationVendorName</span></li>
            <li><label>Police Reg. Number</label><span>: @Model.PoliceRegNumber</span></li>
            <li><label>Driver 1 & Driver 2</label><span>: @Model.Driver & @Model.Driver2</span></li>
            <li><label>Co-Driver</label><span>: @Model.CoDriver</span></li>
            <li><label>Transportation Number</label><span>: @Model.GPNumber</span></li>
        </ul>

        <div class="signature col3">
            <div class="sign text-center">
                <p>Driver 1/Driver 2/Co-Driver</p>
                <p class="name">@Model.Driver/@Model.Driver2/@Model.CoDriver</p>
            </div>
            <div class="sign text-center">
                <p>
                    Pengirim<br />
                    Area Warehouse/Depo
                </p>
                <p class="name">(&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;)</p>
            </div>
            <div class="sign text-center">
                <p>
                    Receiver<br />
                    Reversal Logistics
                </p>
                <p class="name">(&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;)</p>
            </div>
        </div>

        <p>
            Note: <br />
            Dokumen ini dibuat rangkap 3 (Distribusi: 1. Pengirim 2. Transporter 3.Penerima (Reversal Logistics))
        </p>
        <div style="page-break-after: always;"></div>
        <h4 class="section-title">Checklist kelengkapan Dokumen Claim Rokok</h4>

        <ul class="cb-list">
            <li><span class="boxed"></span> <span>Berita Acara Rokok (Asli)</span></li>
            <li><span class="boxed"></span> <span>Surat Jalan TOM Pengiriman FG (Copy)</span></li>
            <li><span class="boxed"></span> <span>DN to Reversal Logistics (Asli)</span></li>
            <li><span class="boxed"></span> <span>DN to Area Warehouse Penerima FG (Copy)</span></li>
            <li><span class="boxed"></span> <span>GR/GI Slip (Copy)</span></li>
            <li><span class="boxed"></span> <span>Serah Terima Rokok Claim (Asli)</span></li>
        </ul>*@
    </main>
</body>
