<!-- Modal -->
<div class="modal fade" id="uploadfile" tabindex="-1" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Upload File</h4>
            </div>
            <div class="modal-body">
                <div class="row">                                     
                    <form id="formUpload">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Upload File</label>
                                <input id="fileInput" type="file" class="filestyle" data-buttonname="btn-primary" data-icon="false" data-buttontext="Browse" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel">
                                <a href="Assets/Download/TemplateExcel/MasterLoadFactorCFP.xlsx">Download Template Master Load Factor CFP</a><br />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnUpload">Upload</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    jQuery(function ($) {
        $(document).on('change', '#fileInput', function (e) {
            $("#btnUpload").prop("disabled", false);
        });
    });

    $(document).on('click', '#btnUpload', function (e) {
        if ($("#fileInput").val() == '' || $("#fileInput").val() == null) {
            $('#textModalError').html("Please select File First !");
            $('#modalerror').modal('show');
        }
        else {
            Upload();
        }      
    });

    function Upload() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Uploading...</div>',
            closeButton: true
        });
        var fileData = new FormData();
        var fileUpload = $('#fileInput').get(0).files;

        if (fileUpload.length > 0) {
            fileData.append('FileUpload', fileUpload[0]);           
            $('#fileInput').jfilestyle('clear');
            $("#uploadfile").modal("hide");
           
        }
        else {        
            $('#fileInput').jfilestyle('clear');
            $("#uploadfile").modal("hide");           
        }

        var uploadfile = $('#fileInput').val();
        var fileInput = document.getElementById('fileInput');
        var fileNameSafe = "";
        var fileSafe = "";

        if (uploadfile) {
            fileNameSafe = fileInput.files[0].name;
            fileSafe = fileInput.files[0];
        }

        var formData = new FormData();
        //Appending each file to FormData object
        formData.append(fileNameSafe, fileSafe);

        $.ajax({
            url: '@Url.Action("UploadFileManual")',
            type: 'POST',
            dataType: 'JSON',
            data: fileData,
            cache: false,
            contentType: false,
            processData: false,
            success: function (res) {
                resetAfterUploaded();
                if (res == "") {
                    $("#uploadfile").modal("hide");
                    $('#labelsuccess').html('Your data has been successfully uploaded');
                    $("#modalsuccess").modal("show");
                    dialog.modal('hide');
                    generateTable();
                } else {
                    $('#notificationModal').modal('show');
                    $('#notificationModal .modal-body').html('<img src="assets/images/cancel.png" style="max-height: 50px; max-width:50px" alt="" /><strong style="font-size: x-large">Upload failed!</strong><br />' + res);
                    $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                    dialog.modal('hide');
                }
            },
            error: function () {
                $('#notificationModal').modal('show');
                $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span>Upload failed!</span>');
                $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                dialog.modal('hide');
            }
        });
    }
  
    function resetAfterUploaded() {
        $('#fileInput').val("");
        $('#fileInput').siblings('.jfilestyle').find('input').val('');
        $('#fileInput').jfilestyle('clear');
        $("#uploadfile").modal("hide");
    }

    $("#btnUploadFile").click(function() {
        $("#btnUpload").prop("disabled", true);
    });
</script>