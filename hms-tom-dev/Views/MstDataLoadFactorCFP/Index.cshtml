@*Partial View*@
@Html.Action("PartialViewUploadFile")
<script type="text/javascript">
    // page   : MasterList
    // author : hakim
    // ticket :
    // date   : 2017-08-11
    $("#FilterFrom").val(moment(new Date()).format("DD/MM/YYYY"));
    generateDropDownVehicleTypeFilter("Light");
    generateTable("Light");

    $(document).ready(function () {
        //$(function () {
        // BEGIN : GENERAL Logic
        
        // clear field when click add new btn
        $('#addNew').click(function () {
            resetData();
            $('#InsertOrUpdate').val("INSERT");
            generateDropDownVehicleType();
            generateDropDownBrandCategory();
           // generateDropDownMode();            
           
        });
        // END : GENERAL Logic
    });
    
    $('#btnSaveYes').click(function () {
        edit();
        $('#setinactive').modal('hide');
        $('#addnew').modal('hide');
    });

    $('#btnSaveNew').click(function () {
        if (!validation()) {
            //alert($('#newData').find('input[id="InsertOrUpdate"]').val());
            if ($('#newData').find('input[id="InsertOrUpdate"]').val() == "UPDATE") {
                $('#setinactive').modal('show');
            } else {
                save();
            }
        }
    });

    $("#effecStartDate").on("dp.change", function () {
        if ($("#effecEndDate").val() == "" || $("#effecEndDate").val() === null || $("#effecEndDate").val() === undefined)
            $("#effecEndDate").val(moment('2999/12/31').format("DD/MM/YYYY"));
    });


    $("#effecEndDate").on("dp.change", function () {
        if ($("#effecEndDate").val() == "" || $("#effecEndDate").val() === null || $("#effecEndDate").val() === undefined)
            $("#effecEndDate").val(moment('2999/12/31').format("DD/MM/YYYY"));
    });

    function validation() {
        var VehicleType = $('#VehicleType').val();
        var Mode = $('#Mode').val();
        var BrandCategory = $('#BrandCategory').val();
        var KMperLiter = $('#KMperLiter').val();
        var Weight_perstick = $('#Weight_perstick').val();
        var KgCO2perLiter = $('#KgCO2perLiter').val();
        var MaxQty = $('#MaxQty').val();
        var containError = false;
        var error = "";
        //var regexValidator = /^\d+[\,]{0,1}\d+$/gi
        var regexValidator = /^\d+\,?\d*$/gi
        //console.log("VehicleType value: " + VehicleType);
        //console.log("BrandCategory value: " + BrandCategory);
        //console.log("Mode value: " + Mode);
        //console.log("Fuel consumption: " + KgCO2perLiter);
        if (VehicleType == null || VehicleType == "NULL" || VehicleType == undefined || VehicleType == "") {
            containError = true;
            error += "Vehicle Type must be selected</br>";
            
        }
        if (BrandCategory == null || BrandCategory == "NULL"|| BrandCategory == undefined || BrandCategory == "") {
            containError = true;            
            error += "Brand Category must be selected</br>";
            
        }
       
        if (Mode == null || Mode == "NULL" || Mode == undefined || Mode == "") {
            containError = true;
            error += "Mode must be selected</br>";

        }
        if (KMperLiter == null || KMperLiter == undefined || KMperLiter == "") {
            containError = true;
            error += "KM/Liter is null</br>";

        }
        if (MaxQty == null || MaxQty == undefined || MaxQty == "") {
            containError = true;
            error += "MaxQty is null</br>";

        }
        if (Weight_perstick == null || Weight_perstick == undefined || Weight_perstick == "") {
            containError = true;
            error += "Weight/stick is null</br>";

        }

        if (KMperLiter != null && KMperLiter != undefined && KMperLiter != "") {
            if (KMperLiter.match(regexValidator) != null) {
                if (KMperLiter.match(regexValidator).length == 1) {
                    if (KMperLiter.includes(",")) {
                        var digit = KMperLiter.split(",")[1].length;
                        if (digit > 2) {
                            containError = true;
                            error += "KM/Liter Digit precision must be less than or equal to 4 digits</br>";
                        }
                    }
                    else {
                        KMperLiter += ",0";
                    }
                }
            } else {
                containError = true;
                error += "KM/Liter Format should be a number</br>";
            }
        }
        if (KgCO2perLiter != null && KgCO2perLiter != undefined && KgCO2perLiter != "") {
            if (KgCO2perLiter.match(regexValidator) != null) {
                if (KgCO2perLiter.match(regexValidator).length == 1) {
                    if (KgCO2perLiter.includes(",")) {
                        var digit = KgCO2perLiter.split(",")[1].length;
                        if (digit > 4) {
                            containError = true;
                            error += "Fuel Consumption Digit precision must be less than or equal to 4 digits</br>";
                        }
                    }
                    else {
                        KgCO2perLiter += ",0";
                    }
                }
            } else {
                containError = true;
                error += "Fuel Consumption Format should be a number</br>";
            }
        }
       
        if (Weight_perstick != null && Weight_perstick != undefined && Weight_perstick != "") {
            if (Weight_perstick.match(regexValidator) != null) {
                if (Weight_perstick.match(regexValidator).length == 1) {
                    if (Weight_perstick.includes(",")) {
                        var digit = Weight_perstick.split(",")[1].length;
                        if (digit > 20) {
                            containError = true;
                            error += "Weight/Stick Digit precision must be less than or equal to 4 digits</br>";
                        }
                    }
                    else {
                        Weight_perstick += ",0";
                    }
                }
            } else {
                containError = true;
                error += "Weight/Stick Format should be a number</br>";
            }
        }
        if (containError)
        {
            $("#errorMessage").html(error);
            $("#modalError").modal();
        }
        return containError;

    }

    function resetData() {
        $('#newData')[0].reset();
    }


    // END : GENERAL Logic

    // BEGIN : JQUERY SELECT TO DataTable
    //call generate table
    //generateTable();    
    //generateDropDownVehicleType();    

    function generateDropDownVehicleTypeFilter(defaultValue) {
        $select2 = $("#FilterVehicleType");
        //request the JSON data and parse into the select element
        $.ajax({
            url: 'MstDataLoadFactorCFP/GetListForCPF',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                $select2.html('');
                $.each(data,
                    function(key, val) {
                        $select2.append('<option value="' + val.FieldValue + '">' + val.FieldValue + '</option>');
                    });
            },
            complete: function() {
                if (defaultValue != "" || defaultValue !== null || defaultValue !== undefined) {
                    $("#FilterVehicleType").select2('val', defaultValue);
                }
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select.html('<option value="NULL">none available</option>');
            }
        });
    }

    function generateDropDownVehicleType() {
        //get a reference to the select element
        $select = $('#VehicleType');
        
        //request the JSON data and parse into the select element
        $.ajax({
            url: 'MstDataLoadFactorCFP/GetListForCPF',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                //clear the current content of the select
                $select.html('');
                $select2.html('');
                //iterate over the data and append a select option
                $select.html('<option value="NULL"></option>').trigger('change');
                $select2.html('<option value="NULL"></option>').trigger('change');
                $.each(data,
                    function(key, val) {
                        $select.append('<option value="' + val.FieldValue + '">' + val.FieldValue + '</option>');
                        $select2.append('<option value="' + val.FieldValue + '">' + val.FieldValue + '</option>');
                    });
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select.html('<option value="NULL">none available</option>');
            }
        });
    }

    function generateDropDownBrandCategory() { // ini yg diapnggil
        //get a reference to the select element
        $select1 = $('#BrandCategory');
       
        //request the JSON data and parse into the select element
        $.ajax({
            //url: 'MstList/GetListForBrandCategory',
            url: '@Url.Action("GetFABrands")',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                //clear the current content of the select
                $select1.html('');
                //iterate over the data and append a select option
                $select1.html('<option value="NULL"></option>').trigger('change');
                $.each(data,
                    function(kunci, tampung) {
                        $select1.append('<option value="' + tampung + '">' + tampung + '</option>');
                    });
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select1.html('<option value="NULL">none available</option>');
            }
        });
    }

    function generateDropDownMode() {
        //get a reference to the select element
        $select3 = $('#Mode');

        //request the JSON data and parse into the select element
        $.ajax({
            url: 'MstDataLoadFactorCFP/GetListForModel',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                //clear the current content of the select
                $select3.html('');
                //iterate over the data and append a select option
                $select3.html('<option value="NULL"></option>').trigger('change');
                $.each(data,
                    function(key, val) {
                        $select3.append('<option value="' + val.FieldValue + '">' + val.FieldValue + '</option>');
                    });
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select3.html('<option value="NULL">none available</option>');
            }
        });
    }
    //generate table

    $("#btnSearchFilter").click(function() {
        generateTable();
    });

    $("#btnResetFilter").click(function() {
        $("#FilterFrom").val("");
        $("#FilterVehicleType").select2('val', "Light");
        generateTable();
    });

    function generateTable(vecType) {
        var filterDateFrom = $("#FilterFrom").val();
        var filterVehicleType = $("#FilterVehicleType").val();
        var filterDateParam = null;
        var filterVehicleTypeParam = null;
        console.log(filterDateFrom);
        if (filterDateFrom != "" && filterDateFrom !== null && filterDateFrom !== undefined) {
            var splitStartDate = $('#FilterFrom').val().split("/");
            var strStartDate = splitStartDate[2] + "-" + splitStartDate[1] + "-" + splitStartDate[0];
            var dStart = moment(strStartDate.toString());
            filterDateParam = dStart.toISOString();
        }

        if (filterVehicleType != "" && filterVehicleType !== null && filterVehicleType !== undefined) {
            filterVehicleTypeParam = filterVehicleType;
        }

        if (vecType != "" && vecType !== null && vecType !== undefined) {
            filterVehicleTypeParam = vecType;
        }

        $.ajax({
            url: 'MstDataLoadFactorCFP/GetMasterLoadFactorCFP',
            method: 'post',
            cache : false,
            dataType: 'json',
            data: {
                "StartDate": filterDateParam,
                "VehicleTypeListFilter": filterVehicleTypeParam
            },
            success: function (data) {
                //console.log(data);
                var table = $('#dtFilterMaster').DataTable({
                    "destroy": true,
                    data: data,
                    'paging': true,
                    'sort': true,
                    "iDisplayLength": 25,
                    aaSorting: [[11, 'desc']],
                    'searching': true,
                    columns: [
                        {
                            "data": "IsActive", "class": "text-center", "render": function (data) {
                                if (data == true) {
                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }
                            }
                        },
                        { 'data': 'VehicleType', 'searchable': true },
                        { 'data': 'Mode', 'searchable': true },
                        { 'data': '_KMperLiter', 'searchable': true },
                        { 'data': '_WeightperStick', 'searchable': true },
                        { 'data': '_KgCO2perLiter', 'searchable': true },
                        { 'data': 'BrandCategory', 'searchable': true },
                        { 'data': 'MaxQty', 'searchable': true },
                        {
                            'data': 'StartDate', "render": function (data, type, row) {
                                var tanggal = moment(row['StartDate']).format("DD-MMM-YYYY");
                                return tanggal;
                            }
                        },
                        {
                            'data': 'EndDate', "render": function (data, type, row) {
                                var tanggal = moment(row['EndDate']).format("DD-MMM-YYYY");
                                return tanggal;
                            }
                        },
                        {
                            render: function (data, type, row) {
                                // var tes = { data: 'UpdatedDate', } + { data: 'UpdatedBy' };  
                                var date = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                var formatted = date.getFullYear() + "-" +
                                    ("0" + (date.getMonth() + 1)).slice(-2) + "-" +
                                    ("0" + date.getDate()).slice(-2) + " " + date.getHours() + ":" +
                                    date.getMinutes();
                                //var dt = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                //var dtStr = dt.toString();
                                //var date = dtStr.substr(8, 2) + " " + (dtStr.substr(4, 3)) + " " + dtStr.substr(11, 4) + " " + dt.getHours() + ":" +
                                //      dt.getMinutes();
                                var jamtanggal = moment(row['UpdatedDate']).format("DD-MMM-YYYY HH:mm");
                                return '<label hidden>' + row['UpdatedDate'] + '</label>by ' + row['UpdatedBy'] + ' on ' + jamtanggal;
                            }
                        },
                        { 'data': 'UpdatedDate', 'class': 'hidden' },
                        {
                            "data": "IDLoadFactorCFP", "render": function (data) {
                                return '<div  align="center"><a href="#" id="editForm" onclick="return editTable(' + "'" + data + "'" + ')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a></div>';
                            }
                        }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 1) && (index < 11)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                //searching with column on datatable
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });
            }
        });
