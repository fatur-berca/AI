        var kgco2perliter = $('#newData').find('input[id="KgCO2perLiter"]').val().replace(",", ".");
        var maxqty = $('#newData').find('input[id="MaxQty"]').val().replace(",", ".");
       
        var splitStartDate = $('#effecStartDate').val().split("/");
        var strStartDate = splitStartDate[2] + "-" + splitStartDate[1] + "-" + splitStartDate[0];
        var dStart = moment(strStartDate.toString());
        var effectiveStartDate = dStart.toISOString();
        var effectiveEndDate;
        if ($('#effecEndDate').val() != "") {
            var splitEndDate = $('#effecEndDate').val().split("/");
            var strEndDate = splitEndDate[2] + "-" + splitEndDate[1] + "-" + splitEndDate[0];
            var dEnd = moment(strEndDate.toString());
            effectiveEndDate = dEnd.toISOString();
        }

        if (dStart > dEnd) {

            $("#textModalError").html("Start Date cannot be Greater than End Date");
            $('#modalerror').modal('show');
            dialog.modal('hide');
            return;
        };

        var status = $('#Status :selected').val() == 1 ? true : false;       
        var data = {
            "new": [{
                "IDLoadFactorCFP": id, "VehicleType": vehicletype, "BrandCategory": brandcategory, "KMperLiter": parseFloat(kmperliter).toFixed(2), "KgCO2perLiter": parseFloat(kgco2perliter), "MaxQty": maxqty, "IsActive": status,
                "mode": mode, "WeightperStick": parseFloat(weightperstick).toFixed(9), "StartDate": effectiveStartDate, "EndDate": effectiveEndDate
            }],
            "edit": [{}]
        };
        //console.log(data);
        $.ajax({
            type: 'POST',
            url: 'MstDataLoadFactorCFP/InsertLoadFactorCFP',
            data: data,
            success: function (data) {
              
                if (data.New) {
                    $.each(data.New, function (k, value) {
                        if (value.ResponseType == "Success") {
                            //DFIS.Helper.ResponseNotification(k.ResponseNotification, "Insert Master List", value.FieldName + " - " + value.FieldValue);
                            //alert(value.ResponseType);
                            //generateTable();
                            generateTable();
                            $('#modalsuccess').modal('show');
                            $('#labelsuccess').html('Your data has been successfully saved');
                            $('#Loading').modal('hide');
                            resetData();
                        } else {
                            $("#textModalError").html("Sorry, the inputted data exists or your connection is lost");
                            $('#modalerror').modal('show');
                            $('#Loading').modal('hide');
                        }

                    });
                }
          
            }
        });
    }
