    // BEGIN : Edit Data
    // get edit data and assign to modal
    function editTable(id) {
        resetData();
        $('#InsertOrUpdate').val("UPDATE");
        //generateDropDownVehicleType();
        //generateDropDownBrandCategory();
        
        $.ajax({
            url: 'MstDataLoadFactorCFP/GetDataById',
            type: "GET",
            cache : false,
            contentType: "application/json;charset=UTF-8",
            dataType: "json",
            data: { "IDLoadFactorCFP": id },
            success: function (json) {
                //alert(json.Mode);
                $('#IDLoadFactorCFP').val(json.IDLoadFactorCFP);
               
                var mode = json.Mode; //utk nmpung properti data dari table
                $("#Mode option").each(function (index, value) {     //iterasi
                    if (value.value != "" && value.value!=null) {    //pilih yg gak kosong atau null
                        if (mode.toLowerCase() == value.value.toLowerCase()){  //klo mode == value.value (value dari dropdownlist)
                            mode = value.value;
                        }
                    }
                });
                $('#Mode').val(mode).trigger('change');

                var vehicleType = json.VehicleType;
                //console.log(VehicleType);
                $("#VehicleType option").each(function (index, value) {   
                    if (value.value != "" && value.value != null) {    
                        if (vehicleType.toLowerCase() == value.value.toLowerCase()) {  
                            vehicleType = value.value;
                        }
                    }
                });
                $('#VehicleType').val(vehicleType).trigger('change');

                var brandCategory = json.BrandCategory;
                $("#BrandCategory option").each(function (index, value) {
                    if (value.value != "" && value.value != null) {   
                        if (brandCategory.toLowerCase() == value.value.toLowerCase()) {
                            brandCategory = value.value;
                        }
                    }
                });
                $('#BrandCategory').val(brandCategory).trigger('change');

                var tes = json._WeightperStick;
               
                $('#Weight_perstick').val(json._WeightperStick);
                $('#KMperLiter').val(json._KMperLiter);
                $('#KgCO2perLiter').val(json._KgCO2perLiter);
                $('#MaxQty').val(json.MaxQty);
              
                $('#effecStartDate').val(moment(json.StartDate).format("DD/MM/YYYY"));
                $('#effecEndDate').val(moment(json.EndDate).format("DD/MM/YYYY"));
                if (json.IsActive) {
                    $('#Status').val("1");
                } else {
                    $('#Status').val("0");
                }

                ////close modal
                $('#addnew').modal('show');

            }
        });
    }

