
@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = " Master Data > Master Trans >Load Factor & CFP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew"  class="btn btn-primary" data-toggle="modal" data-target="#addnew">Add New</button>
        <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#uploadfile" id="btnUploadFile">Upload</button>
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter" id="advSrc"><b>Advanced Search </b><i class="fa fa-angle-down"></i></a>
</div>
<div class="filter-deck nmb">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel wmb wbt">
            <form id="filter">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Effective Date</label>
                        <input type="text" name="" id="FilterFrom" class="form-control datepicker">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Vehicle Type</label>
                        <select id="FilterVehicleType" class="select2" multiple></select>
                    </div>
                </div>
                <div class="col-md-12">
                    <button type="button" id="btnSearchFilter" class="btn btn-primary search-filter">Search</button>
                    <button type="button" id="btnResetFilter" class="btn btn-purple reset-search-filter">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr>
            <th width=5% nowrap><div align="center">Active</div></th>            
            <th>Vehicle Type</th>
            <th>Mode</th>
            <th>Km/Liter</th>
            <th>Weight/Stick</th>
            <th>Fuel Consumption</th>
            <th>Brand Category</th>
            <th>Max Qty</th>
            <th>Start Date</th>
            <th>End Date</th>        
            <th>Last Update</th>
            <th hidden>Last Update</th>          
            <th width=5% nowrap ><div align="center">Action</div></th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">      
            <th width=5% nowrap><div align="center"></div></th>                 
            <th>Vehicle Type</th>
            <th>Mode</th>
            <th>Km/Liter</th>
            <th>Weight/Stick</th>
            <th>Fuel Consumption</th>
            <th>Brand Category</th>
            <th>Max Qty</th>  
            <th>Start Date</th>
            <th>End Date</th>         
            <th>Last Update</th>
            <th hidden>Last Update</th>         
            <th width=5% nowrap ><div align="center"></div></th>
        </tr>
    </thead>    
</table>

<!-- Modal -->
<div class="modal fade" id="addnew" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Data Load Factor & CFP</h4>
            </div>
            <div class="modal-body">
                <div class="col-md-24">
                    <form id="newData">
                        <div class="row" hidden>
                            <div class="col-md-24">
                                <div class="form-group">
                                    <label>InsertOrUpdate</label>
                                    <input type="text" id="InsertOrUpdate" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="row" hidden>
                            <div class="col-md-24">
                                <div class="form-group">
                                    <label>IDLoadFactorCFP</label>
                                    <input type="text" id="IDLoadFactorCFP" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Vehicle Type</label>
                                    @*<select class="form-control" id="VehicleType"></select>*@
                                    @Html.DropDownList("VehicleType", (SelectList)ViewBag.ListVehicle, string.Empty, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Brand</label>
                                    @*<select class="form-control" id="BrandCategory"></select>*@
                                    @Html.DropDownList("BrandCategory", (SelectList) ViewBag.ListBrandCategory, string.Empty, new {@class = "form-control"})
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Mode</label>
                                    @*<select class="form-control" id="Mode"></select>*@
                                    @Html.DropDownList("Mode", (SelectList)ViewBag.ListModel, string.Empty, new { @class = "form-control"})
                                </div>
                            </div>                        
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Km/Liter</label>
                                    <input id="KMperLiter" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Fuel Consumption</label>
                                    <input id="KgCO2perLiter" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Maximum QTY</label>
                                    <input type="number" id="MaxQty" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Weight/Stick</label>
                                    <input id="Weight_perstick" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Active</label>
                                    <select class="form-control" id="Status">
                                        <option value="1">YES</option>
                                        <option value="0">NO</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div id="disESD" class="col-md-5">
                                <div class="form-group">
                                    <label>Effective Date</label>
                                    <input type="text" id="effecStartDate" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                                </div>
                            </div>
                            <div id="disTO" class="col-md-1">
                                <div class="form-group">
                                    <label>&nbsp;</label>
                                    <div style="padding-top: 10px">TO</div>
                                </div>
                            </div>
                            <div id="disEED" class="col-md-6">
                                <div class="form-group">
                                    <label>&nbsp;</label>
                                    <input type="text" id="effecEndDate" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal" id="btnClose">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveNew">Save Changes</button>
            </div>
        </div>
    </div>
</div>

