@{
    ViewBag.Title = "Master Data > Truck Seal Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#addnew">Add New</button>
    </div>
</div>

<table id="dtFilterMaster" class="display table dataTable table-condensed" style="width: 100%;">
    <thead>
        <tr>
            <th hidden>sorting</th>
            <th>Active</th>
            <th></th>
            <th>Seal Number</th>
            <th></th>
            <th>Last Update</th>
            <th>Action</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th hidden>sorting</th>
            <th style="text-align: center">Filter</th>
            <th></th>
            <th style="text-align: center"><b>To</b></th>
            <th></th>
            <th width=50%>Last Update</th>
            <th></th>
        </tr>
    </thead>
</table>

<!-- Modal -->
<div class="modal fade" id="addnew" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Truck Seal Stock</h4>
            </div>
            <div class="modal-body">
                <div class="col-md-24">
                    <form id="newData">
                        <div class="col-md-5">
                            <label>Seal Number</label>
                            <input type="text" id="SealNumberFrom" class="form-control" maxlength="8" style="text-align: center" onkeypress='return event.charCode >= 48 && event.charCode <= 57' />
                        </div>
                        <div class="col-md-2">
                            <label>&nbsp;</label>
                            <input type="text" readonly="readonly" class="form-control" value="To" tabindex="-1" style="text-align: center; background: white; border: 0px;" />
                        </div>
                        <div class="col-md-5">
                            <label>&nbsp;</label>
                            <input type="text" id="SealNumberTo" class="form-control" maxlength="8" style="text-align: center" onkeypress='return event.charCode >= 48 && event.charCode <= 57' />
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnSaveNew">Save</button>
            </div>
        </div>
    </div>
</div>
<!-- BEGIN MODAL DEL SUCCESS -->
<div class="modal fade ml-sucess" id="delmodalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="delModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/checked.png" alt="">
                <span id="delmodaltext">Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL DEL SUCCESS -->
<!-- BEGIN MODAL SUCCESS -->
<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL SUCCESS -->
<!-- BEGIN MODAL ERROR -->
<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/cancel.png" alt="">
                <span id="labelError"></span>
            </div>
            <div class="modal-footer">
                <button id="okError" type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL ERROR -->
<!-- BEGIN MODAL LOADING -->
<div id="modalloading" class="modal fade" role="dialog" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">TOM Notification Center</h4>
            </div>
            <div class="modal-body"><img src="assets/images/loading.gif" alt=""><span>Please wait...</span></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>
<!-- END MODAL LOADING -->
<!-- BEGIN MODAL FORM -->
<div class="modal fade ml-warning" id="modalwarning" role="dialog" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/danger.png" alt="">
                <span>Please fill the empty field(s) before saving</span>
            </div>
            <div class="modal-footer">
                <button id="okWarning" type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL FORM -->
<!-- BEGIN MODAL CONFIRM -->
<div class="modal fade ml-warning" id="modalconfirm" role="dialog" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <input hidden id="keyID" value="">
                <img src="assets/images/danger.png" alt="">
                <span>Are you sure to delete ?</span>
            </div>
            <div class="modal-footer">
                <button id="okConfirm" type="button" class="btn btn-primary" data-dismiss="modal">Yes</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal">No</button>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL CONFIRM -->

<script>
    jQuery(function ($) {
        generateTable();
        $(document).on('click', '#addNew', function () {
            resetData();
        });
        $(document).on('click', '#btnSaveNew', function () {
            if (($('#SealNumberFrom').val() == '' && $('#SealNumberTo').val() == '')) {
                $("#labelError").html("Please enter seal number from and seal number to");
                $('#modalerror').modal('show');
            }
            else if ($('#SealNumberFrom').val() == '') {
                $("#labelError").html("Seal number from must not be empty");
                $('#modalerror').modal('show');
                $('#SealNumberFrom').focus();
            }
            else if ($('#SealNumberTo').val() == '') {
                $("#labelError").html("Seal number to must not be empty");
                $('#modalerror').modal('show');
                $('#SealNumberTo').focus();
            }
            else if (parseInt($('#SealNumberFrom').val()) > parseInt($('#SealNumberTo').val())) {
                $("#labelError").html("Seal number to must be greater than seal number from or equal");
                $('#modalerror').modal('show');
            }
            else {
                save();
            }
        });
        $(document).on('click', '#okConfirm', function () {
            $('#modalconfirm').modal('hide');
            del();
        });
        $(document).on('click', '#okWarning', function () {
            if (($('#SealNumberFrom').val() == '' && $('#SealNumberTo').val() == '')) {
                $('#SealNumberFrom').focus();
            }
        });
        $(document).on('click', '#okError', function () {
            $('#SealNumberFrom').focus();
        });
    });

    function resetData() {
        jQuery('#newData')[0].reset();
        //$('#SealNumberFrom').prop("disabled", true);
        $.ajax({
            url: '@Url.Action("GetLastNumber")',
            dataType: "json",
            success: function (json) {
                console.log(json);
                if (json == 0)
                {
                    $('#SealNumberFrom').val("");
                    $('#SealNumberFrom').prop("disabled", false);
                    $('#SealNumberFrom').focus();
                }
                else
                {
                   // $('#SealNumberFrom').val(json + 1);
                }
            }
        });
    }

    function confirm(ID) {
        $('#modalconfirm').modal('show');
        $('#keyID').val(ID);
    }

    function generateTable() {
        $.ajax({
            url: 'MstTruckSeal/GetAllTruckSeals',
            method: 'GET',
            dataType: 'json',
            cache: false,
            success: function (data) {
                var table = $('#dtFilterMaster').DataTable({
                    'destroy': true,
                    'data': data,
                    'paging': true,
                    'searching': true,
                    'iDisplayLength': 25,
                    aaSorting: [[0, 'asc']],
                    columns: [
                        { 'data': 'SealNumberFrom', 'class': 'hidden', 'sortable': false },
                        {
                            'data': 'IsActive', 'class': 'text-center', 'render': function (data) {
                                if (data == true) {
                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                }
                                else {
                                    return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>';
                                }
                            }, 'sortable': false
                        },
                        { 'data': 'SealNumberFrom', 'class': 'text-center', 'searchable': true, 'sortable': false },
                        { 'data': null, 'defaultContent': '', 'searchable': false, 'sortable': false },
                        { 'data': 'SealNumberTo', 'class': 'text-center', 'searchable': true, 'sortable': false },
                        {
                            render: function (data, type, row) {
                                var date = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                var formatted = date.getFullYear() + "-" +
                                    ("0" + (date.getMonth() + 1)).slice(-2) + "-" +
                                    ("0" + date.getDate()).slice(-2) + " " + date.getHours() + ":" +
                                    date.getMinutes();
                                var jamtanggal = moment(row['UpdatedDate']).format("DD-MMM-YYYY HH:mm");

                                return 'By ' + row['UpdatedBy'] + ' on ' + jamtanggal;
                            }, 'class': 'text-center', 'sortable': false
                        },
                        {
                            'data': 'IDTruckSealStock', 'class': 'text-center', 'render': function (data) {
                                return "<div><a href='#' onclick='return confirm(" + data + ");' title='Delete'><i data-toggle='modal' class='fa fa-trash'></i></a></div>";
                            }, 'sortable': false
                        }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");

                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if (index == 2 || index == 4 || index == 5) {
                        if (index == 2 || index == 4) { mx = '8'; } else { mx = ''; }
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" maxlength="' + mx + '" placeholder="Search ' + title + '" />');
                    }
                });

                //searching with column on datatable
                table.columns().every(function (index) {
                    if (index == 2 || index == 4 || index == 5) {
                        $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                            table.column($(this).parent().index() + ':visible')
                                .search(this.value)
                                .draw();
                        });
                    }
                });
            }
        });
    }

    function save() {
        var sn_from = $('#SealNumberFrom').val(),
            sn_to = $('#SealNumberTo').val(),
            is_active = true,
            data = {
                "new": [{ "SealNumberFrom": sn_from, "SealNumberTo": sn_to, "IsActive": is_active }],
            };

        jQuery.ajax({
            type: 'POST',
            url: 'MstTruckSeal/InsertTruckSeals',
            data: data,
            success: function (result) {
                if (result == true) {
                    $('#addnew').modal('hide');
                    $('#modalsuccess').modal('show');
                    resetData();
                }
                else {
                    $("#labelError").html("");
                    $("#labelError").html("Sorry, inputted data is already exists");
                    $('#modalerror').modal('show');
                }
                generateTable();
            }
        });
    }

    function del() {
        jQuery.ajax({
            type: 'POST',
            url: 'MstTruckSeal/DeleteTruckSeal',
            data: { keyID: $('#keyID').val() },
            success: function (result) {
                if (result == false) {
                    $("#labelError").html("");
                    $("#labelError").html("Sorry data is nothing or your connection is lost");
                    $('#modalerror').modal('show');
                }
                else
                {
                    $("#delmodaltext").html("");
                    $("#delmodaltext").html("Your data has been successfully deleted");
                    $('#delmodalsuccess').modal('show');
                }
                generateTable();
            }
        });
    }
</script>
