    function dropdownSubDepartmentFilter() {
        $.ajax({
            url: 'ContinuousImprovementSugestionSystem/GetMasterList',
            method: 'post',
            dataType: 'json',
            cache: false,
            async: false,
            data: { "fieldName": "SuggestionSystemSub-Department" },
            success: function (data) {
                var select = document.getElementById("filterSubDepartment");
                var len = document.getElementById("filterSubDepartment").length;
                var option;
                if (len > 0)
                    select.empty().append('');
                option = document.createElement('option');
                option.value = "ALL";
                option.text = "ALL";
                select.add(option);
                for (var i = 0; i < data.length; i++) {
                    option = document.createElement('option');
                    option.value = data[i]["FieldValue"];
                    option.text = data[i]["FieldValue"];
                    select.add(option);
                }
            }
        });
    }

