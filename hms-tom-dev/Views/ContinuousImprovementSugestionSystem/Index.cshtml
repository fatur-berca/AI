    $("#btnSetInactive").click(function () {
        
        if (tempid.length > 0) {
            $("#textModalWarningYesNoDelete").html("");
            $("#textModalWarningYesNoDelete").append("Are you sure to delete this data?");
            $('#warningModalYesNoDelete').modal('show');
        } else if (tempid.length == 0) {
            $('#notificationModal').modal('show');
            $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span> Please select your data!</span>');
            $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
        }
    });

    function checkBtn() {
        $(".chkList").prop('checked', $("#checkAllData").prop('checked'));
        if ($("#checkAllData").prop('checked')) {
            var table = $('#dtFilterMaster').DataTable();
            //table.column(1).nodes().each(function (cell, i) {
            //    tempid.push(table.cell(i, 1).data());
            //});
            //tempid = tempid.filter(onlyUnique);
            $(table.$('input[type="checkbox"]').map(function () {
                var tempor = $(this).prop("checked")? $(this).closest('tr').context.id : "";
                tempor = tempor.match(/[^[\]]+(?=])/g);
                //console.log(tempor);
                tempid.push(tempor);
            }));
            tempid = tempid.filter(onlyUnique);
            //console.log("tempid = "+ tempid);
            
        } else {
            tempid = [];
        }
    }

    //filter supaya array javascript hanya ada unique value
    function onlyUnique(value, index, self) {
        return self.indexOf(value) === index;
    }
