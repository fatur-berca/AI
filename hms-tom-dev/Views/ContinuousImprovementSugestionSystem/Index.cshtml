<style>
    .fc-selected {
        background-color: #f39814 !important;
    }
</style>
<script>
    var tgl = (new Date()).getDate();
    var bln = (new Date()).getMonth()+1;
    var thn = (new Date()).getFullYear();
    var dateFrom = tgl+"/"+bln+"/"+(thn-1);
    var dateTo = tgl + "/" + bln + "/" + thn;
    //console.log(dateFrom);
    //console.log(dateTo);
    var subDep = "ALL";
    var statusFilter = -1;
    $("#Month").val(1);
    $("#ListYears").val((new Date()).getFullYear());
    $("#filterStatus").val(-1);
    var $sourceFields = $("#sourceFields");
    var $destinationFields = $("#destinationFields");
    $(function () {
        function moveItems(origin, dest) {
            $(origin).find('.fc-selected').appendTo(dest);
        }

        function moveAllItems(origin, dest) {
            $(origin).children().appendTo(dest);
        }
        
        $("#fieldChooser").fieldChooser($("#sourceFields"), $("#destinationFields"));
        
        $('#left').click(function () {
            moveItems('#destinationFields', '#sourceFields');
        });

        $('#right').on('click', function () {
            moveItems('#sourceFields', '#destinationFields');
        });

        $('#leftall').on('click', function () {
            moveAllItems('#destinationFields', '#sourceFields');
        });

        $('#rightall').on('click', function () {
            moveAllItems('#sourceFields', '#destinationFields');
        });
        
        $('#layoutSelect').on('change', function () {
            for (var j = 1; j < layoutIsGlobal.length; j++) {
                if ($('#layoutSelect option:selected').text() == layoutIsGlobal[j].LayoutName) {
                    $('#chkGlobalCustomReport').prop('checked', layoutIsGlobal[j].isGlobal);
                    //console.log(layoutIsGlobal[j].isGlobal);
                }

            }
            var sourceFieldNames = [
                    { 'field': 'SubmitMonth', 'label': 'Submit Month' },
                    { 'field': 'SubmitYear', 'label': 'Submit Year' },
                    { 'field': 'Department', 'label': 'Department' },
                    { 'field': 'Sub_Department', 'label': 'Sub Department' },
                    { 'field': 'Title', 'label': 'Title' },
                    { 'field': 'Category1', 'label': 'Category1' },
                    { 'field': 'Category2', 'label': 'Category2' },
                    { 'field': 'ProposedDate', 'label': 'Proposed Date' },
                    { 'field': 'ImplementationDate', 'label': 'Implementation Date' },
                    { 'field': 'CostSaving_IDR', 'label': 'CostSaving - IDR' },
                    { 'field': 'CostSaving_USD', 'label': 'CostSaving - USD' },
                    { 'field': 'EmployeeID', 'label': 'Employee ID' },
                    { 'field': 'EmployeeName', 'label': 'Employee Name' },
                    { 'field': 'Facilitator', 'label': 'Facilitator' },
                    { 'field': 'Supervisor', 'label': 'Supervisor' },
                    { 'field': 'FirstLineAssessor', 'label': 'First Line Assessor' },
                    { 'field': 'SecondLineAssessor', 'label': 'Second Line Assessor' },
                    { 'field': 'ProductivityScore', 'label': 'Productivity Score' },
                    { 'field': 'QualityScore', 'label': 'Quality Score' },
                    { 'field': 'WorkingHourScore', 'label': 'Working Hour Score' },
                    { 'field': 'SafetyScore', 'label': 'Safety Score' },
                    { 'field': 'EnvironmentScore', 'label': 'Environment Score' },
                    { 'field': 'Ergonomic_HygieneScore', 'label': 'Ergonomic Hygiene Score' },
                    { 'field': 'UsabilityScore', 'label': 'Usability Score' },
                    { 'field': 'EffortScore', 'label': 'Effort Score' },
                    { 'field': 'ProActivenessScore', 'label': 'ProActiveness Score' },
                    { 'field': 'CreativityScore', 'label': 'Creativity Score' },
                    { 'field': 'FinalScore', 'label': 'Final Score' },
                    { 'field': 'Voucher_IDR', 'label': 'Voucher - IDR' },
                    { 'field': 'ABCDAwards', 'label': 'ABCDAwards' },
                    { 'field': 'VoucherNo', 'label': 'Voucher No' },
                    { 'field': 'Usability', 'label': 'Usability' },
                    { 'field': 'IdeaSource', 'label': 'Idea Source' },
                    { 'field': 'ModifiedFrom', 'label': 'Modified From' },
                    { 'field': 'CopyBy', 'label': 'Copy By' },
                    { 'field': 'Keywords', 'label': 'Keywords' },
                    { 'field': 'Status', 'label': 'Status' },
                    { 'field': 'CreatedBy', 'label': 'CreatedBy' },
                    { 'field': 'CreatedDate', 'label': 'CreatedDate' },
                    { 'field': 'UpdatedBy', 'label': 'UpdatedBy' },
                    { 'field': 'UpdatedDate', 'label': 'UpdatedDate' },
                    { 'field': 'Remarks', 'label': 'Remarks' }
                ],
                sourceFields = '',
                destinationFieldNames = this.value.split(','),
                destinationFields = '',
                destinationfieldLabels = [];
            var i;
            for (i = 0; i < sourceFieldNames.length; ++i) {
                if (jQuery.inArray(sourceFieldNames[i]['field'], destinationFieldNames) == -1) {
                    // the element is not in the array
                    sourceFields = sourceFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + sourceFieldNames[i]['field'] + "'>" + sourceFieldNames[i]['label'] + "</div>";
                } else {
                    destinationfieldLabels[sourceFieldNames[i]['field']] = sourceFieldNames[i]['label'];
                }
                ;
            }
            $("#fieldChooser #sourceFields").html(sourceFields);

            for (i = 0; i < destinationFieldNames.length; ++i) {
                destinationFields = destinationFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + destinationFieldNames[i] + "'>" + destinationfieldLabels[destinationFieldNames[i]] + "</div>";
            }
            $("#fieldChooser #destinationFields").html(destinationFields);
        });
    });
    var kolom = new Array();
    generateTable();
    dropdownSubDepartmentFilter();
    function generateTable() {
        //console.log('generate table');
        $.ajax({
            url: 'ContinuousImprovementSugestionSystem/GetFieldContinuousImprovementSS',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (data) {
                if(kolom.length == 0 ){
                    $("#dtFilterMaster").html('');
                    var htmlStringHeader = "<thead><tr>";
                    var htmlStringFilter = "<thead class='filters'><tr class='filter-row'>";
                    kolom.push({ data: "chkDelete" });
                    kolom.push({ data: "Status" });
                    htmlStringHeader = htmlStringHeader + "<th data-orderable='false' class='text-center'><div class='checkbox-deck'><input type='checkbox' id='checkAllData' onClick=checkBtn()><label for='checkAllData'></label></div></th>";
                    htmlStringHeader = htmlStringHeader + "<th>Status</th>";
                    htmlStringFilter = htmlStringFilter + "<th>Filter</th>";
                    htmlStringFilter = htmlStringFilter + "<th></th>";
                    for (var i = 0; i < data.length; i++) {
                        if (data[i] == "SubmitMonth") {
                            htmlStringHeader = htmlStringHeader + "<th>Submit Month</th>";
                            htmlStringFilter = htmlStringFilter + "<th>Submit Month</th>";
                            kolom.push({ data: "DisplaySubmitMonth" });
                        }
                        else if (data[i] != "IsActive" && data[i] != "Status") {
                            var str = data[i].replace("-"," "); //untuk tampilan di header
                            str = str.replace(/([a-z])([A-Z])/g, '$1 $2');
                            str = str.replace(/([A-Z])([A-Z][a-z])/g, '$1 $2');
                            if (str == "ID Cont Improv SS") str = "ID";
                            if (str == "Category1") str = "Category 1";
                            if (str == "Category2") str = "Category 2";
                            if (str == "Cost Saving IDR") str = "Cost Saving(IDR)";
                            if (str == "Cost Saving USD") str = "Cost Saving(USD)";
                            if (str == "Voucher IDR") str = "Voucher(IDR)";
                            if (str == "Attachment2") str = "Attachment 2";
                            if (str == "Attachment3") str = "Attachment 3";
                            if (str == "Attachment4") str = "Attachment 4";
                            htmlStringHeader = htmlStringHeader + "<th>" + str + "</th>";
                            htmlStringFilter = htmlStringFilter + "<th>" + str + "</th>";
                            var input = data[i].replace("-", "_"); // untuk ngisi data di datatable
                            kolom.push({ data:input });
                        }
                    }
                    htmlStringHeader = htmlStringHeader + "</tr></thead>";
                    htmlStringFilter = htmlStringFilter + "</tr></thead>";
                    //console.log('generate header');
                    $("#dtFilterMaster").append(htmlStringHeader + htmlStringFilter);
                }
            },
            complete: function () {
                //console.log('complete');
                $.ajax({
                    url: '@Url.Action("GetGeneralContinuousImprovementSugestionSystemBySubmitMonthYearStatus", "ContinuousImprovementSugestionSystem")',
                    method: 'get',
                    data: { dtfr: dateFrom, dtto: dateTo, subdep: subDep, status: statusFilter },
                    cache: false,
                    success: function (json) {
                        var listBaru = new Array();
                        for (var i = 0; i < json.length; i++) {
                            var newObject = json[i];
                            newObject.chkDelete = "statusCheckDelete";
                            listBaru.push(newObject);
                        }
                        //console.log('buat tabel');
                        var indexSort = $.map(kolom,
                            function(obj, index) {
                                if (obj.data == "UpdatedDate") {
                                    return index;
                                }
                            });
