@using System.Web.Mvc.Html
@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.General.ContinuousImprovementSugestionSystemViewModel
@{
    ViewBag.Title = "General > Continuous Improvement > Suggestion System > List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.AddNew)))
        {
            <button class="btn btn-primary" onclick="window.location.href ='@Url.Action("ContinuousImprovementSugestionSystemInput", "ContinuousImprovementSugestionSystem")'">Add New</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Delete)))
        {
            <button class="btn btn-primary" id="btnSetInactive" type="button">Delete</button>
        }
        <button class="btn btn-primary" id="btnExportReport">Export</button>
        <button class="btn btn-primary" type="button" id="btnCustomReport" data-toggle="modal" data-target="#customReport">Custom Report</button>
        <!--<button class="btn btn-primary" id="btnSetActive" type="button" onclick="SetIsActive('Recovery')">Recovery</button>-->
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.UploadFile)))
        {
            <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#modalUpload" id="uploadFileButton">Upload File</button>
        }
        
    </div>
    <a href="#searchfilter" id="advSearch" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b><i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck nmb">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel wmb wbt">
            <form id="frmFilter">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Date Range</label>
                        <div class="row">
                            <div class="col-md-4">
                                <input type="text" id="dtFilterFrom" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                            </div>
                            <div class="col-md-2 to-bi">
                                <label>To</label>
                            </div>
                            <div class="col-md-4">
                                <input type="text" id="dtFilterTo" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Status</label>
                        <select id="filterStatus" class="form-control" style="width: 120px">
                            <option value="-1">ALL</option>
                            <option value="2">Approved</option>
                            <option value="1">Waiting</option>
                            <option value="0">Rejected</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Sub-Department</label>
                        <select id="filterSubDepartment" class="form-control" style="width: 120px">
                        </select>
                    </div>
                </div>
                <div class="col-md-12">
                    <button id="btnSearch" class="btn btn-primary">Search</button>
                    <button id="btnReset" class="btn btn-purple">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

<table id="dtFilterMaster" class="display table dataTable table-condensed">
</table>

