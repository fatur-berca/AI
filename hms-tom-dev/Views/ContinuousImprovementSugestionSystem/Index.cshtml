    function Comma(input) { //function to add commas to textboxes
        var num = input;
        num += '';
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        var x = num.split('.');
        var x1 = x[0];
        var x2 = x.length > 1 ? '.' + x[1] : '';
        var rgx = /(\d+)(\d{3})/;
        while (rgx.test(x1))
            x1 = x1.replace(rgx, '$1' + ',' + '$2');
        return x1 + x2;
    }
    
