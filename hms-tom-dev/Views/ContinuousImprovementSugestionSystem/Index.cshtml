            cache: false,
            success: function (data) {
                //console.log(data);
                if (data == null) {
                    $('#modalerror').modal('show');
                }
                else{
                    if (data.length > 0) {
                        if (data[0] == "Success" && data.length == 1) {
                            $('#modalUpload').modal('hide');
                            generateTable();
                            $('#modalsuccess').modal('show');
                        }
                        else if (data[0] == "Success" && data.length > 1) {
                            $("#textModalWarning").html('');
                            $("#textModalWarning").append("Theres already data in database<br />");
                            for (var t = 1; t < data.length; t++) {
                                $("#textModalWarning").append("Title: " + data[t] + "<br />");
                            }
                            $('#warningModal').modal('show');
                        }
                        else
                        {
                            $("#textModalWarning").html('');
                            $("#textModalWarning").append("There is no Column in database<br />");
                            console.log(data.length, data[0]);
                            for (var s = 0; s < data.length; s++) {
                                if (data.length == 13) {
                                    $("#textModalWarning").append(data[s]);
                                } else {
                                    $("#textModalWarning").append(data[s] + "<br />");
                                }
                            }
                            $('#warningModal').modal('show');
                        }
                    }
                }
            },
            error: function (xhr, status, p3, p4) {
                var err = "Error " + " " + status + " " + p3 + " " + p4;
                if (xhr.responseText && xhr.responseText[0] == "{")
