    function saveData() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        var submitYear;
        var submitMonth;
        var subDepartment;
        var namaEployee;
        $("#form :input").each(function() {
            var input = $(this);
            var idInput = input[0].id;
            if (idInput == "CostSaving-IDR/Month" || idInput == "CostSaving-USD/Month"
            ) { //karena nama di tabel dynamic field dan tabelnya beda
                var splitCostSaving = idInput.split("/");
                idInput = splitCostSaving[0];
            }
            var field = listCompare[idInput];
            if (field != undefined) {
                if (field == "ProposedDate" || field == "ImplementationDate") {
                    var split = input[0].value.split("/");
                    var strDate = split[2] + "-" + split[1] + "-" + split[0];
                    var d = moment(strDate.toString());
                    listField[field] = d.toISOString();
                } else if (field == "EmployeeID") {
                    var splitNama = input[0].value.split("-");
                    listField[field] = splitNama[0];
                } else if (input[0].getAttribute("multiple") == "multiple") {
                    var id = input[0].getAttribute("id");
                    var array = $('#' + id + '').val();
                    if (array != null) {
                        var valueSelect = array[0];
                        for (var j = 1; j < array.length; j++) {
                            valueSelect = valueSelect + "," + array[j];
                        }
                        listField[field] = valueSelect;
                    }
                } else if (field == "CostSaving_IDR") {
                    var inputIDR = input[0].value.replace(/,/g, "");
                    listField[field] = parseFloat(inputIDR);
                }
                else {
                    if (field == "SubmitMonth")
                        submitMonth = input[0].value;
                    if (field == "SubmitYear")
                        submitYear = input[0].value;
                    if (field == "Sub_Department")
                        subDepartment = input[0].value;
                    if (field == "EmployeeName")
                        namaEployee = input[0].value;
                    listField[field] = input[0].value;
                }
            }
        });
        listField["IDContImprovSS"] = IDContImprovSS;
        listField["CreatedBy"] = createdBy;
        var splitCD = createdDate.split("/");
        var strCreatedDate = splitCD[2] + "-" + splitCD[1] + "-" + splitCD[0];
        var cd = moment(strCreatedDate.toString());
        listField["CreatedDate"] = cd.toISOString();
        listField["Attachment"] = attachment;
        listField["Attachment2"] = attachment2;
        listField["Attachment3"] = attachment3;
        listField["Attachment4"] = attachment4;

        //START : BAGIAN UPLOAD ATTACHMENT
        var uploadAtta = new FormData();
        if (window.FormData !== undefined) {
            if (fileA != undefined) {
                if (fileA.length > 0) {
                    for (var x = 0; x < fileA.length; x++) {
                        uploadAtta.append("fileA", fileA[x]);
                    }
                }
            }
            if (fileB != undefined) {
                if (fileB.length > 0) {
                    for (var y = 0; y < fileB.length; y++) {
                        uploadAtta.append("fileB", fileB[y]);
                    }
                }
            }
            if (fileC != undefined) {
                if (fileC.length > 0) {
                    for (var z = 0; z < fileC.length; z++) {
                        uploadAtta.append("fileC", fileC[z]);
                    }
                }
            }
            if (fileD != undefined) {
                if (fileD.length > 0) {
                    for (var a = 0; a < fileD.length; a++) {
                        uploadAtta.append("fileD", fileD[a]);
                    }
                }
            }
        }

        $.when(UploadAttachment(uploadAtta, submitYear, submitMonth, subDepartment, namaEployee)).done(function (a1) { //END : BAGIAN UPLOAD ATTACHMENT
            $.ajax({
                type: 'POST',
                url: 'InsertList',
                cache: false,
                data: listField,
                async: false,
                success: function (status) {
                    dialog.modal("hide");
                    if (status == "Success") {
                        $('#modalsuccess').modal('show');
                        KosongInput();
                    } else if (status == "Overwrite") {
                        $("#textModalWarning").html("");
                        $("#textModalWarning").append("There is already data in database");
                        $('#warningModal').modal('show');
                    } else {
                        $('#modalerror').modal('show');
                    }
                }
            });
        });
    }

