    $("#btnEdit").click(function() {
        EnableInput();
        $("#btnEdit").attr('disabled', true);
        $("#btnSaveNew").attr('disabled', false);
    });

    function SetTabActive(tab) {
        tabActive = tab;
    }

    function GetUserRole() {
        $.ajax({
            url: 'GetUserListRole',
            method: 'get',
            dataType: 'json',
            cache: false,
            async: false,
            success: function (data) {
                for (var i = 0; i < data.length; i++) {
                    //if (data[i].RoleName == "SUPER ADMIN" || data[i].RoleName == "ADMINISTRATOR REGIONAL") {
                        if (data[i].RoleName == "SUPER ADMIN"){
                            isSuperAdmin = true;
                        }
                    //} else {
                    //    $("#tab2").addClass("tab-disabled");
                    //}
                }
            }
        });
    }

    function GetMasterConfigurationByPageNameDescription(descrip) {
        $.ajax({
            url: 'GetMasterConfigurationByPageNameDescription',
            method: 'post',
            data: { description: descrip },
            dataType: 'json',
            cache: false,
            async: false,
            success: function (data) {
                for (var i = 0; i < data.length; i++) {
                    if (data[i]["Description"] == "Second Line Assessor"){
                        secondLineAssessorScore = data[i]["Value"];
                    }
                    else if (data[i]["Description"] == "ABCD Award") {
                        abcdAwardScore = data[i]["Value"];
                    }
                    else if (data[i]["Description"] == "Cost Saving"){
                        costSaving = data[i]["Value"];
                    }
                }
                GetMasterConversionPointSS();
            }
        });
    }

    function GetMasterConversionPointSS() {
        $.ajax({
            url: 'GetMasterConvertionPointSSByVal',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (data) {
                listConversionPoint = data;
            }
        });
    }

    function loadData() {
        if (gup('id') != "") {
            DisableInput();
            getDataByID(gup('id'));
            statusInput = "EDIT";
            $("#btnSaveNew").attr('disabled', true);
        }
    }

    function getDataByID(param) {
        $.ajax({
            url: '@Url.Action("GetContinuousImprovementSSByID")',
            method: 'get',
            dataType: 'json',
            cache: false,
            async: false,
            data: { id: param },
            success: function (json) {
                if (json != "") {
                    $("#form input[type=text]").each(function() {
                        var input = $(this);
                        var split = input[0].id.split('/');//split ini digunakan untuk cost saving
                        var field = listCompare[split[0]];
                        if (field != undefined) {
                            var pattern = /Date\(([^)]+)\)/;
                            var results = pattern.exec(json[field]);
                            if (results != null && results != 'undefined')
                                input.val(moment(json[field]).format("DD/MM/YYYY"));
                            else {
                                input.val(json[field]);
                            }
                        }
                    });

                    $("select").each(function() {
                        var input = $(this);
                        var field = listCompare[input[0].id];
                        if (field != undefined) {
                            var str = json[field];
                            if (str != null) {
                                var array = str.toString().split(",");

                                if (array.length > 1) {
                                    input.select2('val', array);
                                } else {
                                    if (input.find('option').length > 0) {
                                        input.select2('val', json[field]);
                                        if (field == "EmployeeID") {
                                            setTimeout(
                                              function () {
                                                  input.select2('val', json[field] + "-" + json["EmployeeName"]);
                                              }, 2000);
                                        }
                                    } else {
                                        var theText = json[field],
                                            theValue = theText;
                                        if (field == "EmployeeID") {
                                            theText = json[field] + " - " + json["EmployeeName"];
                                            theValue = json[field] + "-" + json["EmployeeName"];
                                        }
                                        var newOption = new Option(theText, theValue, true, true);
                                        input.append(newOption).trigger('change');
                                    }
                                }
                            }
                        }
                    });

                    $('#form input[type="number"]').each(function() {
                        var input = $(this);
                        var idInput = input[0].id;
                        if (idInput == "CostSaving-IDR/Month" || idInput == "CostSaving-USD/Month") {
                            var split = idInput.split("/");
                            idInput = split[0];
                        }
                        var field = listCompare[idInput];
                        if (field != undefined) {
                            input.val(json[field]);
                        }
                    });

                    $("#btnEdit").attr('disabled', true);
                    var status = $("#status :selected").val();
                    if (isSuperAdmin == false) {
                        if (json["Status"] != 1) {
                            if ($('#IsRoleCanEdit').val() == 1) {
                                $("#btnEdit").attr('disabled', false);
                            }
                            else{
                                $("#btnEdit").attr('disabled', true);
                            }
                        } else if (json["Status"] == 1) {
                            if ($('#IsRoleCanEdit').val() == 1 || $('#IDUser').val() == json["CreatedBy"].toLowerCase()) {
                                $("#btnEdit").attr('disabled', false);
                            }
                        }
                    } else {
                        $("#btnEdit").attr('disabled', false);
                    }

                    var l = window.location;
                    var base_url = l.protocol + "//" + l.host + "/DFIS/";

                    //START : BAGIAN ATTACHMENT
                    //1
                    if (json["Attachment"] != null)
                    {
                        $("#labelAttachment").html('');
                        var splitNamaFileExt = json["Attachment"].split("/");
                        var splitNamaFile = splitNamaFileExt[splitNamaFileExt.length - 1].split(".");
                        var href = (parseInt(json["Attachment"].indexOf("~/")) > -1 && parseInt(json["Attachment"].indexOf("~/")) < 1) ? base_url + json["Attachment"].substr(2) : json["Attachment"];
                        var displayAtta = '<a href="' + href + '" target="_blank">' + splitNamaFile[0] + '</a><br />';

                        $("#labelAttachment").html(displayAtta);
                        attachment = json["Attachment"];
                    }
                    //2
                    if (json["Attachment2"] != null)
                    {
                        $("#labelAttachment2").html('');
                        var splitNamaFileExt2 = json["Attachment2"].split("/");
                        var splitNamaFile2 = splitNamaFileExt2[splitNamaFileExt2.length - 1].split(".");
                        var href = (parseInt(json["Attachment2"].indexOf("~/")) > -1 && parseInt(json["Attachment2"].indexOf("~/")) < 1) ? base_url + json["Attachment2"].substr(2) : json["Attachment2"];
                        var displayAtta2 = '<a href="' + href + '" target="_blank">' + splitNamaFile2[0] + '</a><br />';

                        $("#labelAttachment2").html(displayAtta2);
                        attachment2 = json["Attachment2"];
                    }
                    //3
                    if (json["Attachment3"] != null)
                    {
                        $("#labelAttachment3").html('');
                        var splitNamaFileExt3 = json["Attachment3"].split("/");
                        var splitNamaFile3 = splitNamaFileExt3[splitNamaFileExt3.length - 1].split(".");
                        var href = (parseInt(json["Attachment3"].indexOf("~/")) > -1 && parseInt(json["Attachment3"].indexOf("~/")) < 1) ? base_url + json["Attachment3"].substr(2) : json["Attachment3"];
                        var displayAtta3 = '<a href="' + href + '" target="_blank">' + splitNamaFile3[0] + '</a><br />';

                        $("#labelAttachment3").html(displayAtta3);
                        attachment3 = json["Attachment3"];
                    }
                    //4
                    if (json["Attachment4"] != null)
                    {
                        $("#labelAttachment4").html('');
                        var splitNamaFileExt4 = json["Attachment4"].split("/");
                        var splitNamaFile4 = splitNamaFileExt4[splitNamaFileExt4.length - 1].split(".");
                        var href = (parseInt(json["Attachment4"].indexOf("~/")) > -1 && parseInt(json["Attachment4"].indexOf("~/")) < 1) ? base_url + json["Attachment4"].substr(2) : json["Attachment4"];
                        var displayAtta4 = '<a href="' + href + '" target="_blank">' + splitNamaFile4[0] + '</a><br />';

                        $("#labelAttachment4").html(displayAtta4);
                        attachment4 = json["Attachment4"];
                    }
                    //END : BAGIAN ATTACHMENT

                    IDContImprovSS = json["IDContImprovSS"];
                    createdBy = json["CreatedBy"];
                    createdDate = moment(json["createdDate"]).format("DD/MM/YYYY");
                }
            }
        });
    }

    function gup(name) {
        name = name.replace(/[\[]/, "\\\[").replace(/[\]]/, "\\\]");
        var regexS = "[\\?&]" + name + "=([^&]*)";
        var regex = new RegExp(regexS);
        var results = regex.exec(window.location.href);
        if (results == null)
            return "";
        else {
            for (var i = 0; i < results[1].length; i++) {
                results[1] = results[1].replace("%20", " ");
                results[1] = results[1].replace("%27", "'");
            }
            return results[1];
        }
    }

    function generateDynamicFieldGeneral(callback) {
        listDropDownId = new Array();
        mandatoryTabGeneral = new Array();
        mandatoryTabScore = new Array();
        $.ajax({
            url: 'GetMasterDynamicFieldList',
            method: 'get',
            data: { group: '1' },
            dataType: 'json',
            cache: false,
            success: function(data) {
                generateHtmlString("generateField", data);
                callback();
            }
        });
    }

    function generateDynamicFieldScore(callback) {
        $.ajax({
            url: 'GetMasterDynamicFieldList',
            method: 'get',
            data: { group: '2' },
            dataType: 'json',
            cache: false,
            success: function(data) {
                generateHtmlString("generateField2", data);
                callback();
            }
        });
    }

    function generateHtmlString(idgeneratefield, data) {
        var htmlString = "";
        var clearfix = 1; //tiap combo/date yang ada di paling kanan nanti akan ditambahin clearfix

        for (var i = 0; i < data.length; i++) {
            var dynamicField = data[i];
            var fieldType = dynamicField.FieldType;
            var label = dynamicField.FieldName;
            var id = label.split(' ').join('');

            if (fieldType == "TextInput") {
                if (id == "CostSaving-USD/Month") {
                    htmlString = htmlString +
                        '<div class="col-md-4">' +
                        '<div class="form-group">' +
                        '<label>' +
                        label +
                        '</label>' +
                        '<input type="text" id="' +
                        id +
                        '" class="form-control" disabled>' +
                        '</div>' +
                        '</div>';
                }
                else{
                    htmlString = htmlString +
                        '<div class="col-md-4">' +
                        '<div class="form-group">' +
                        '<label>' +
                        label +
                        '</label>' +
                        '<input type="text" id="' +
                        id +
                        '" class="form-control">' +
                        '</div>' +
                        '</div>';
                }
                if (clearfix % 3 == 0) {
                    htmlString = htmlString + '<div class="clearfix"></div>';
                }
            } else if (fieldType == "Number") {
                if (id == "FinalScore") {
                    htmlString = htmlString +
                        '<div class="col-md-4">' +
                        '<div class="form-group">' +
                        '<label>' +
                        label +
                        '</label>' +
                        '<input type="text" id="' +
                        id +
                        '" oninput=finalScoreChange() class="form-control" readonly />' +
                        '</div>' +
                        '</div>';
                }
                else if (id == "CostSaving-IDR/Month") {
                    htmlString = htmlString +
                        '<div class="col-md-4">' +
                        '<div class="form-group">' +
                        '<label>' +
                        label +
                        '</label>' +
                        '<input type="text" id="' +
                        id +
                        '" oninput=calculateCostSaving() class="form-control" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />' +
                        '</div>' +
                        '</div>';
                }
                else if (id == "Voucher-IDR") {
                    htmlString = htmlString +
                        '<div class="col-md-4">' +
                        '<div class="form-group">' +
                        '<label>' +
                        label +
                        '</label>' +
                        '<input type="number" id="' +
                        id +
                        '" oninput=calculateFinalScore() class="form-control" onkeypress="return event.charCode >= 48 && event.charCode <= 57" disabled/>' +
                        '</div>' +
                        '</div>';
                }
                else {
                    htmlString = htmlString +
                        '<div class="col-md-4">' +
                        '<div class="form-group">' +
                        '<label>' +
                        label +
                        '</label>' +
                        '<input type="number" id="' +
                        id +
                        '" oninput=calculateFinalScore() class="form-control" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />' +
                        '</div>' +
                        '</div>';
                }
                if (clearfix % 3 == 0) {
                    htmlString = htmlString + '<div class="clearfix"></div>';
                }
            } else if (fieldType == "Date") {
                htmlString = htmlString +
                    '<div class="col-md-4">' +
                    '<div class="form-group">' +
                    '<label>' +
                    label +
                    '</label>' +
                    '<input type="text" id="' +
                    id +
                    '" class="form-control datepicker">' +
                    '</div>' +
                    '</div>';
                if (clearfix % 3 == 0) {
                    htmlString = htmlString + '<div class="clearfix"></div>';
                }
            } else if (fieldType == "ComboMultiple") {
                htmlString = htmlString +
                    '<div class="col-md-4">' +
                    '<div class="form-group">' +
                    '<label>' +
                    label +
