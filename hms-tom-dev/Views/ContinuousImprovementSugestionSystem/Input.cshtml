        $(document).on('change', '#EmployeeID', function () {
            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

            var IDUser = $('#EmployeeID').val().split('-')[0];
            $.ajax({
                url: 'GetDropDownEmployeeName',
                method: 'get',
                dataType: 'json',
                data: { IDUser: IDUser, ParentLocation: $('#Sub-Department').val() },
                async: false,
                cache: false,
                success: function (data) {
                    var select_spv = $('#Supervisor');
                    var select_fac = $('#Facilitator');

                    select_spv.select2('val', '');
                    select_fac.select2('val', '');

                    var options = '<option class="ddcenter" value="">----- Select an Item -----</option>';

                    for (var i = 0; i < data.length; i++) {
