            });

            var select_spv = $('#Supervisor');
            var select_fac = $('#Facilitator');

            select_spv.select2('val', '');
            select_fac.select2('val', '');

            select_spv.html('');
            select_fac.html('');

            $.ajax({
                url: 'GetDropDownEmployeeName',
                method: 'get',
                dataType: 'json',
                data: { ParentLocation: $(this).val() },
                async: false,
                cache: false,
                success: function (data) {
                    var select = $('#EmployeeID');
                    select.select2('val', '');
                    //var len = document.getElementById(fieldName[z]).length;
                    var options = '<option class="ddcenter" value="">----- Select an Item -----</option>';

                    /*
                    option = document.createElement('option');
                    option.addClass = "ddcenter";
                    option.value = "";
                    option.text = "----- Select an Item -----";
                    select.add(option);
                    */
                    for (var i = 0; i < data.length; i++) {
                        options = options + '<option value="' + data[i]["IDUser"] + '-' + data[i]["FULL_NAME"] + '">' + data[i]["ID"] + ' - ' + data[i]["FULL_NAME"] + '</option>';
                        //option.value = data[i]["IDUser"] + '-' + data[i]["FULL_NAME"];
                        //option.text = data[i]["ID"] + ' - ' + data[i]["FULL_NAME"];
