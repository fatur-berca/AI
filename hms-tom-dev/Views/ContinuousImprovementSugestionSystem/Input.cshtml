    function calculateCostSaving() {
        var costSavingIDR = document.getElementById("CostSaving-IDR/Month");
        var costSavingUSD = document.getElementById("CostSaving-USD/Month");
        if (costSaving > 0) {
            var calculateIDR = costSavingIDR.value.replace(/,/g, "");
            costSavingUSD.value = parseFloat(parseFloat(calculateIDR) / parseFloat(costSaving)).toFixed(2);
            Comma(costSavingUSD);
        } else
            costSavingUSD.value = 0;
        Comma(costSavingIDR);
    }

    function calculateFinalScore() {
        finalscore = 0;
        $('#form input[type="number"]').each(function() {
            var element = $(this);
            var id = element[0].id;
            if (id.indexOf("Score") !== -1 && id != "FinalScore") {
                var value = element[0].value;
                if (value == "" || value == undefined)
                    value = 0;
                finalscore = finalscore + parseInt(value);
            }
            if (id == "UsabilityScore") {
                var value2 = element[0].value;
                if (value2 == "" || value2 == undefined)
                    value2 = 0;
                if (parseInt(value2) > 0)
                    $("#Usability").select2('val', "Yes");
                else
                    $("#Usability").select2('val', "No");
            }
        });
        if (finalscore > 157) {
            $("#SecondLineAssessor").attr('disabled', false);
        } else if (finalscore <= 157) {
            $("#SecondLineAssessor").select2("val", "");
            $("#SecondLineAssessor").attr('disabled', true);
        }
        if (finalscore > abcdAwardScore) {
            $("#ABCDAwards").select2('val', "Yes");
        } else if (finalscore < abcdAwardScore) {
            $("#ABCDAwards").select2('val', "No");
        }
        $.each(listConversionPoint, function (k, v) {
            if (finalscore >= v.ValueFrom && finalscore <= v.ValueTo) {
                $("#Voucher-IDR").val(v.Value);
            }
        });
        $("#FinalScore").val(finalscore);
    }

    function defaultDate() {
        var tgl = new Date().getDate();
        var bln = (new Date()).getMonth() + 1;
        var thn = (new Date()).getFullYear();
        $("#SubmitMonth").select2('val', bln);
        $("#SubmitYear").select2('val', thn);
        $('#ProposedDate').val(tgl + "/" + bln + "/" + thn);
        $('#ImplementationDate').val(tgl + "/" + bln + "/" + thn);
    }

    $('body').on('focus', ".datepicker", function() {
            $(this).datetimepicker({
                format: 'DD/MM/YYYY'
            });
    });

    function inputFileStyle() {
        $(".filestyle").jfilestyle({
            buttonBefore: true,
            buttonText: "Browse"
        });
    }

    function checkField(arrayField) {
        var invalid = false;
        for (var i = 0; i < arrayField.length; i++) {
            var elemen = document.getElementById(arrayField[i]);
            if (arrayField[i] == "UploadA") {
                if (elemen.value == "" || elemen.value == "null") {
                    if (elemen.nextSibling.nextSibling.innerHTML != "-") {
                        elemen.nextSibling.classList.remove("txt-invalid");
                    } else {
                        invalid = true;
                        elemen.nextSibling.className += " txt-invalid";
                    }
                }
                else
                {
                    elemen.nextSibling.classList.remove("txt-invalid");
                }
            }
            else {
                if (elemen.value == "" || elemen.value == "null") {
                    invalid = true;
                    elemen.className += " txt-invalid";
                } else
                    elemen.classList.remove("txt-invalid");
            }
        }
        return invalid;
    }

    //filter supaya array javascript hanya ada unique value
    function onlyUnique(value, index, self) {
        return self.indexOf(value) === index;
    }

    function Comma(input) { //function to add commas to textboxes
        var num = input["value"];
        num += '';
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        var x = num.split('.');
        var x1 = x[0];
        var x2 = x.length > 1 ? '.' + x[1] : '';
        var rgx = /(\d+)(\d{3})/;
        while (rgx.test(x1))
            x1 = x1.replace(rgx, '$1' + ',' + '$2');
        document.getElementById(input["id"]).value = x1 + x2;
    }
</script>
