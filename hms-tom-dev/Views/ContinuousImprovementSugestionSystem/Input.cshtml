@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "General > Continuous Improvement > Suggestion System Input";
    Layout = "~/Views/Shared/_Layout.cshtml";    
}

<style>
    .txt-invalid {
        border: 1px solid red !important;
    }
    .tab-disabled {
        pointer-events: none;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="title-deck wmb">
            <div class="button-wrap pull-left">
                <input type="hidden" id="IsRoleCanEdit" value="@ViewBag.IsRoleCanEdit"/>
                <input type="hidden" id="IDUser" value="@ViewBag.IDUser" />
                <button class="btn btn-purple" onclick="window.location.href ='@Url.Action("Index", "ContinuousImprovementSugestionSystem")'">Back</button>
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Edit)))
                {
                    <button type="button" class="btn btn-primary" id="btnEdit">Edit</button>
                }
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Save)))
                {
                    <button type="button" class="btn btn-primary" id="btnSaveNew">Save</button>
                }
                <button type="button" class="btn btn-primary" id="btnLocationList" data-toggle="modal" data-target="#modallocationlist">Copy This Idea</button>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <ul class="nav nav-pills title">
            <li class="active"><a data-toggle="pill" href="#summary" onclick="SetTabActive('General')">General</a></li>
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.ScoreApproval)))
            {
                <li><a id="tab2" data-toggle="pill" href="#detail" onclick="SetTabActive('Score')">Score & Approval</a></li>
            }
            else
            {
                <li><a id="tab2" data-toggle="pill" href="#detail" onclick="SetTabActive('Score')" class="tab-disabled">Score & Approval</a></li>
            } 
        </ul>
        <div id="form" class="tab-content">
            <div id="summary" class="tab-pane fade in active">
                <div id="generateField" class="row"></div>
            </div>
            <div id="detail" class="tab-pane fade">
                <div id="generateField2" class="row"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-warning" id="warningModalYesNo" tabindex="-1" role="dialog">
