<script>
    var statusInput = "NEW";
    var tabActive = "General";
    var filter = new Object();
    var listDropDownId = new Array();//dipakai untuk generate drop down
    var mandatoryTabGeneral = new Array();
    var mandatoryTabScore = new Array();

    var finalscore = 0;
    var voucherValueFrom = 0;
    var voucherValueTo = 0;
    var secondLineAssessorScore = 0;
    var abcdAwardScore = 0;
    var costSaving = 0;
    var listConversionPoint;

    var listField = {};
    var listCompare = {};

    var IDContImprovSS = 0;
    var createdBy = "";
    var createdDate = "";
    var attachment = "";
    var attachment2 = "";
    var attachment3 = "";
    var attachment4 = "";

    var isSuperAdmin = false;//dipakai untuk pengecekan mandatory
    filter.TahunDetail = (new Date()).getFullYear();
    filter.BulanDetail = ((new Date()).getMonth()) + 1;
    $("#btnEdit").attr('disabled', true);
    $("#btnSaveNew").attr('disabled', false);

    $(document).ready(function () {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        GetUserRole();
        generateDynamicFieldGeneral(function() {
             generateDynamicFieldScore(function() {
                 generateDropDown(function () {
                     loadFieldTabel(function () { loadData(); });
                 });
                 //HARDCODE EMPLOYEE ID
                 $("#EmployeeID").on('select2-selecting', function (e) {
                     var value = e.val;
                     var split = value.split('-');
                     $("#EmployeeName").val(split[1]);
                 });
                 //HARDCODE EMPLOYEE ID
                 $("#Category2").select2('val', "None");
                 $("#Department").select2('val', "Logistic & Distribution");
                 $("#Usability").select2('val', "No");
                 $("#ABCDAwards").select2('val', "No");
                 $("#ModifiedFrom").select2('disable');
                 $("#Status").select2('val', 1);
                 $("#SecondLineAssessor").attr('disabled', true);
                 $("#ABCDAwards").attr('disabled', true);
                 $("#Usability").attr('disabled', true);

                 $("#IdeaSource").on('select2-selecting', function (e) {
                     var value = e.val;
                     if (value == "Modified Idea")
                         $("#ModifiedFrom").select2('enable');
                     else {
                         $("#ModifiedFrom").select2('val', "");
                         $("#ModifiedFrom").select2('disable');
