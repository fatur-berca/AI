        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Facility Icon</h4>
            </div>
            <div class="modal-body">
                <form id="newData">
                    <div id="fieldChooser" tabindex="1" class="field-chooser">
                        <div class="col-md-12">
                            <div class="box sameHeight">
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>CreatedDate</label>
                                            <input type="text" id="CreatedDate" class="form-control datepicker">
                                        </div>
                                    </div>
                                </div>
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>CreatedBy</label>
                                            <input type="text" id="CreatedBy" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>InsertOrUpdate</label>
                                            <input type="text" id="InsertOrUpdate" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>IDIconFacility</label>
                                            <input type="text" id="IDIconFacility" class="form-control">                                                                                 
                                        </div>
                                    </div>
                                </div>
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>IconPath</label>
                                            <input type="text" id="IconPath" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                @*<div class="form-group">
                                <label class="control-label">Upload Icon</label>
                                <input type="file" id="UploadI" class="filestyle" accept="image/png,image/jpg,image/jpeg">
                            </div>*@
                                <div class="col-md-12" id="divimg">
                                    <div class="form-group">
                                        
                                        <a data-toggle="modal" href="#modalimage"><input type="image" alt="" height="100" id="previmageicon"></a>                                          
                                        @*<button id="viewimage" class="btn btn-primary" type="button" data-toggle="modal" data-target="#modalimage">Preview</button>*@
                                    </div>
                                </div>  
                            
                                    <div class="col-md-12">                                      
                                        <div class="form-group">
                                            <label class="control-label">Upload Icon</label>
                                            <input type="file" class="filestyle" name="" id="UploadI" accept="image/png,image/jpg,image/jpeg">
                                            @*<a data-toggle="modal" href="#modalimage">Preview</a>*@
                                            @*<button id="viewimage" class="btn btn-primary" type="button" data-toggle="modal" data-target="#modalimage">Preview</button>*@
                                        </div>                             
                                    </div>                                       
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Field Name</label>
                                        @*<select class="form-control" id="FieldName"></select>*@
                                        <input type="text" id="FieldName" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label>URL</label>
                                        <textarea id="Url" class="form-control" readonly></textarea>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Is Application</label>
                                        <select class="form-control" id="Application">
                                            <option value="1">YES</option>
                                            <option value="0">NO</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>Active</label>
                                        <select class="form-control" id="Status">
                                            <option value="1">YES</option>
                                            <option value="0">NO</option>
                                        </select>
                                    </div>
                                </div>                            
                            </div>
                        </div>                    
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveNew">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="setinactive" tabindex="-1" role="dialog">
