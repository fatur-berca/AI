<script>
    generateTable();
    generateDropDown();
    generateYear();

    function generateYear() {
        var day = new Date();
        var now = parseInt(day.getFullYear());
        var options = '<option value=""></option>';
        for (i = 0; i < 7; i++) {
            var jahr = parseInt(now) + parseInt(i-1);
            options = options + '<option value="' + jahr + '">' + jahr + '</option>';
        }
        $('#txtYear').html(options);
    }
        

    function generateDropDown() {
        //get a reference to the select element
        $select = $('#Department');
        //request the JSON data and parse into the select element
        $.ajax({
            url: 'MstLocation/GetDepartementForKPISS',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                //clear the current content of the select
                $select.html('');
                //iterate over the data and append a select option
                $select.html('<option value=null></option>').trigger('change');

                $.each(data, function (key, val) {
                    $select.append('<option value="' + val.LocationName + '">' + val.LocationName + '</option>');
                })
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select.html('<option value="NULL">none available</option>');
            }
        });

    }

    function ExportKPISS() {
        
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        $.ajax({
            url: '@Url.Action("ExportKPISS")',
            method: 'post',
            dataType: 'json',
            data: {
                "Department": $("#Department option:selected").text(),
                "Year": $("#txtYear").val()
            },
            success: function (data) {
                console.log(data);
                window.location.assign("Assets/Download/" + data);
                dialog.modal('hide');
            }
        });
    }

    $('#btnExport').click(function () {
        ExportKPISS();
    });

    $('#btnCustomReport').click(function () {
        $('#inputModal').modal('show');
    });

