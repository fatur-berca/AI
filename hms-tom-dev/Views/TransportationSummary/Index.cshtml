    //CHECK BOX DAN CHECK BOX ALL

    function InsertTempArray(obj) {
        var table = $('#dtOpenCLose').DataTable();
        $('#dtOpenCLose tbody').one('change', 'tr', function () {
            var data = table.row(this).data();
            var idTransportExecution = data["IDTransportExecution"];
            var transportExecutionStatus = data["TransportStatus"];
            if (transportExecutionStatus == "Complete") {
                if (obj.checked)
                    closeTransactionCount++;
                else
                    closeTransactionCount--;
            } else if (transportExecutionStatus == "Close") {
                if (obj.checked)
                    openTransactionCount++;
                else
                    openTransactionCount--;
            } else {
                if (obj.checked) {
                    var tempObj = new Object();
                    tempObj.IDTransportExecution = data["IDTransportExecution"];
                    tempObj.TransportNo = data["TransportNo"];
                    tempObj.TransportStatus = data["TransportStatus"];
                    transactionStatusNotCompleteList.push(tempObj);
                } else {
                    transactionStatusNotCompleteList = $.grep(transactionStatusNotCompleteList, function (e) {
                        return e.IDTransportExecution != data["IDTransportExecution"];
                    });
                }
            }
            var result = $.grep(tempIDTransExecution, function (e) { return e == idTransportExecution; });
            if (result.length == 0) {
                tempIDTransExecution.push(idTransportExecution);
            } else if (result.length == 1) {
                tempIDTransExecution = tempIDTransExecution.filter(function (obj) {
                    return obj !== idTransportExecution;
                });
            }
        });
    }

