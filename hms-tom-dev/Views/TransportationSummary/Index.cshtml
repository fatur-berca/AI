                    <div class="form-group">
                        <label>Transportation Category</label>
                        @Html.DropDownListFor(model => Model.TransportCategory, Model.transCategorys, new { @multiple = "multiple", @id = "FilterTransportationCategory" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Transportation Mode</label>
                        @Html.DropDownListFor(model => Model.TransportMode, Model.transModes, new { @multiple = "multiple", @id = "FilterTransportationMode" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Vendor</label>
                        @Html.DropDownListFor(model => Model.VendorName, Model.vendorNames, new { @multiple = "multiple", @id = "FilterVendor" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Vehicle Type</label>
                        @Html.DropDownListFor(model => Model.VehicleType, Model.vehicleTypes, new { @multiple = "multiple", @id = "FilterVehicleType" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Order Category</label>
                        @Html.DropDownListFor(model => Model.OrderCategory, Model.orderCategorys, new { @multiple = "multiple", @id = "FilterOrderCategory" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Zone</label>
                        @Html.DropDownListFor(model => Model.ZoneName, Model.zoneNames, new { @multiple = "multiple", @id = "FilterZone" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Start Location</label>
                        @Html.DropDownListFor(model => Model.StartLocation, Model.startLocations, new { @multiple = "multiple", @id = "FilterStartLocation" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Sender</label>
                        @Html.DropDownListFor(model => Model.SenderName, Model.senderNames, new { @multiple = "multiple", @id = "FilterSender" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Receiver</label>
                        @Html.DropDownListFor(model => Model.ReceiverName, Model.receiverNames, new { @multiple = "multiple", @id = "FilterReceiver" })
                    </div>
                </div>
                @*<div class="col-md-3">
                    <div class="form-group">
                        <label>Year</label>
                        <select id="FilterYear" class="form-control" onchange="LoadCurrentTab()"></select>
                    </div>
                </div>*@
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Role</label>
                        <select id="FilterRole" class="form-control" onchange="LoadCurrentTab()">></select>
                    </div>
                </div>
            </div>
            @if (isSuperUser)
            {
                <div class="clearfix"></div>
                <div class="col-sm-4">
                    <div class="form-group">

                        <label for="input-type">Status</label>
                        <div id="input-type" class="row">
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" id="all" value="1" type="radio" />All
                                </label>
                            </div>
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" id="deleted" value="0" type="radio" /> Deleted
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="col-md-12">
                <div class="form-group">
                    <button class="btn btn-primary search-filter" id="btnSearchFilter">Search</button>
                    <button class="btn btn-purple reset-search-filter" id="btnResetFilter">Reset</button>
                </div>
            </div>  
        </div>
    </div>
</div>

