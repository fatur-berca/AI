@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.Transport.TransportSummaryViewModel
@{
    ViewBag.Title = "Transportation Summary";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
    bool isSuperUser = false;
}
@foreach (var x in listUserRole)
{
    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.RoleUserList.SA)))
    {
        isSuperUser = true;
        break;
    }
}
<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
        {
            <button class="btn btn-primary" type="button" id="btnExport" tabindex="-1" data-toggle="modal" data-target="#modalExport">Export</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
        {
            <button class="btn btn-primary" type="button" id="btnCustomReport" tabindex="-1" data-toggle="modal" data-target="#customReport">Custom Report</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.UpdateStatus)))
        {
            <button class="btn btn-primary" type="button" id="btnUpdateStatus" tabindex="-1" data-toggle="modal" data-target="#modalStatus">Update Status</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Validation)))
        {
            <button class="btn btn-primary" type="button" id="btnValidation" tabindex="-1" data-toggle="modal" data-target="#modalValidation">Validation</button>
        }
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter" id="advSearch"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
</div>

<style>
    .row {
        width: 100%;
    }
    .aitem label {
        font-weight: bold;
        text-align: center;
        color: #aaa;
        font-size: 14px;
        cursor: pointer;
        padding: 0 2%;
    }
    .aitem label:hover {
        color: #000;
    }

    .fc-selected {
        background-color: #f39814 !important;
    }

    .tabelOpenClose {
        overflow-x: auto;
    }

    .modal-body {
        max-height: calc(100vh - 110px);
        overflow-y: auto;
    }

    .nav-pills.title > li a {
        border-radius: 0;
        padding: 0px 5px 8px 5px;
        font-size: 14px;
        color: #808EA7;
        /*width: 80%;*/
    }

    .boldrow {
        font-weight: bold;
    }

    /*SORTABLE STYLE*/
    body.dragging, body.dragging * {
        cursor: move !important;
    }

    .dragged {
        position: absolute;
        opacity: 0.5;
        z-index: 2000;
    }

    ul
    {
        list-style-type: none;
    }

    ul.RouteMainSortable li.placeholder, ul.RouteAdditionalSortable li.placeholder, ul.RouteStartLocation li.placeholder, ul.RouteSortable li.placeholder , ul.RouteFinishLocation li.placeholder {
        position: relative;
        /** More li styles **/
    }
    ul.RouteMainSortable li.placeholder:before, ul.RouteAdditionalSortable li.placeholder:before, ul.RouteStartLocation li.placeholder:before, ul.RouteSortable li.placeholder:before, ul.RouteFinishLocation li.placeholder:before {
        position: absolute;
        /** Define arrowhead **/
    }

    .RouteMainSortable, .RouteMainSortable ul, .RouteMainSortable li, .RouteAdditionalSortable, .RouteAdditionalSortable ul, .RouteAdditionalSortable li { display: inline; }
    /*SORTABLE STYLE*/
</style>

<div class="filter-deck">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel">
            <div class="row">
