                                <input type="text" id="FilterTransportationDateTo" class="form-control datepicker" style="width:200px;" value="@((DateTime.Now).ToString("dd/MM/yyyy"))">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Transportation Number</label>
                        @*@Html.DropDownListFor(model => Model.TransportNo, Model.transNumbers, new { @multiple = "multiple", @id = "FilterTransportationNumber", @placeholder = "Type Transportation Number" })*@
                        <input type="hidden" style="width:100%" id="FilterTransportationNumber" />
