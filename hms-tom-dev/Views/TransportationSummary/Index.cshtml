<script>
    var openTransactionCount = 0;//digunakan untuk popup error open/close transaction execution
    var closeTransactionCount = 0;//digunakan untuk popup error open/close transaction execution
    var transactionStatusNotCompleteList = [];//digunakan untuk pop up error open/close transaction execution
    var tempIDTransExecution = [];//digunakan untuk pop up error open/close transaction execution
    //getlistYear();
    getlistRole();

    var today = new Date();
    var yearNow = today.getFullYear();

    var tabLoadCounter = 0;

    $(function () {
        $("#FilterYear2").select2("val", yearNow);
        window.ldDialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        generateTable();

        var c = $("#advSearch2").attr("aria-controls");
        $("#" + c).hide();

        $("#advSearch2").on("click", function () {
            var exp = $(this).attr("aria-expanded");
            exp = exp == true || exp == "true";
            var ctl = $(this).attr("aria-controls");
            console.log(ctl);
            if (exp) {
                $("#" + ctl).slideUp(100);
                $(this).attr("aria-expanded", "false");
            }
            else {
                $("#" + ctl).slideDown(100);
                $(this).attr("aria-expanded", "true");
            }
        });

        $("#btnSearchFilter2").on("click", function () {
            console.log("Refreshing report");
            LoadCurrentTab();
        });

        $("#btnResetFilter2").on("click", function () {
            $("#FilterYear2").select2("val", "@DateTime.Now.Year");
            $("#btnResetFilter2").trigger("change")
        });
    });
    function beginLoading() {
        console.log(ldDialog);
        ldDialog.modal("show");
    }
    function endLoading() {
        ldDialog.modal("hide");
    }

    $("#FilterTransportationNumber").select2({
        ajax: {
            url: '@Url.Action("GetTransportationNumberFilter", "TransportationExecution")',
            dataType: 'json',
            data: function (params) {
                return {
                    term: params
                };
            },
            results: function (data) {
                var myResults = [];
                $.each(data, function (index, item) {
                    myResults.push({
                        'id': item.TransportNo,
                        'text': item.TransportNo
                    });
                });
                return {
                    results: myResults
                };
            },
            cache: true
        },
        placeholder: 'Type Transportation Number',
        delay: 250,
        multiple: true,
        minimumInputLength: 1
    });

    $("#FilterOrderNumber").select2({
        ajax: {
            url: '@Url.Action("GetStoNoFilter", "TransportationExecution")',
            dataType: 'json',
            data: function (params) {
                return {
                    term: params
                };
            },
            results: function (data) {
                var myResults = [];
                $.each(data, function (index, item) {
                    myResults.push({
                        'id': item.STONo,
                        'text': item.STONo
                    });
                });
                return {
                    results: myResults
                };
            },
            cache: true
        },
        placeholder: 'Type Order Number',
        delay: 250,
        multiple: true,
        minimumInputLength: 1
    });

    //$("#FilterTransportationNumber").select2({ width: '100%' });
    //$("#FilterOrderNumber").select2({ width: '100%' });
    $("#FilterTransportationCategory").select2({ width: '100%' });
    $("#FilterTransportationMode").select2({ width: '100%' });
    $("#FilterVendor").select2({ width: '100%' });
    $("#FilterVehicleType").select2({ width: '100%' });
    $("#FilterOrderCategory").select2({ width: '100%' });
    $("#FilterZone").select2({ width: '100%' });
    $("#FilterStartLocation").select2({ width: '100%' });
    $("#FilterSender").select2({ width: '100%' });
    $("#FilterReceiver").select2({ width: '100%' });

    $(document).on('click', '#tabitem', function () {
        for (var n = 0; n < 10; n++) {
            $("#tabunit a label").eq(n).css("color", "#aaa");
        }

        $("#tabunit a label").eq($(this).index()).css("color", "#000");
    });

    $(document).on('click', '#btnExport', function () {
        resetradExport();
    });

    $(document).on('click', '#radExportDetailData', function () {
        resetradExport();
        $("#radExportDetailData").prop('checked', true);
    });

    $(document).on('click', '#radExportCompactData', function () {
        resetradExport();
        $("#radExportCompactData").prop('checked', true);
    });

    $(document).on('click', '#radExportValidationFormat', function () {
        resetradExport();
        $("#radExportValidationFormat").prop('checked', true);
    });

    $(document).on('click', '#radExportReClassFormat', function () {
        resetradExport();
        $("#radExportReClassFormat").prop('checked', true);
    });

    $(document).on('click', '#btnValidation', function () {
        $('#uploadValidationXls').val("");
        $('#uploadValidationXls').jfilestyle('clear');
        $("#btnUploadValidationXls").prop("disabled", true);
    });

    $('#uploadValidationXls').on('change', function (e) {
        $("#btnUploadValidationXls").prop("disabled", false);
    });

    $(document).on('click', '#btnUploadValidationXls', function () {
        importValidate();
        $('#uploadValidationXls').val("");
        $('#uploadValidationXls').jfilestyle('clear');
        $("#btnUploadValidationXls").prop("disabled", true);
    });

    $(document).on('click', '#btnExportTransportSummary', function () {
        if ($("#radExportDetailData").prop('checked') == false && $("#radExportCompactData").prop('checked') == false && $("#radExportValidationFormat").prop('checked') == false && $("#radExportReClassFormat").prop('checked') == false) {
            $("#labelCheck").html("");
            $("#labelCheck").html("Please select of the existing options");
            $('#modalwarning').modal('show');
        }
        else {
            exportXls();
        }
    });

    $(document).on('click', '#btnExportCustomReport', function () {
        if ($('#destinationFields .custom-report-field').text().length == 0) {
            $("#labelCheck").html("");
            $("#labelCheck").html("Please select of the existing fields");
            $('#modalwarning').modal('show');
        }
        else {
            customXls();
        }
    });

    $(document).on('click', '#checkdata', function () {
        if ($("#dtFilter > tbody > tr > td").length > 1) {
            if ($("#checkdata").prop('checked') == true) {
                $('#dtFilter > tbody > tr').each(function () {
                    var id = $(this).find("td").eq(0).html();
                    $("#checkrow" + id + "").prop('checked', true);
                });
            }
            else {
                $('#dtFilter > tbody > tr').each(function () {
                    var id = $(this).find("td").eq(0).html();
                    $("#checkrow" + id + "").prop('checked', false);
                });
            }
        }
    });

    $(document).on('click', '#btnSearchFilter', function () {
        $("#checkdata").prop('checked', false);
        generateTable();
        LoadCurrentTab();
    });

    $(document).on('click', '#btnResetFilter', function () {
        resetFilter();
        generateTable();
        LoadCurrentTab();
    });

    function resetcheckAll() {
        $("#checkdata").prop('checked', false);
    }

    $("#btnUpdateStatus").click(function () {
        var dateNow = moment(Date.now());
        var month = dateNow.format('M');
        var year = dateNow.format('YYYY');
        $("#MonthOpenClose").val(month);
        $("#YearOpenClose").val(year);
        $("#SelectAllChkOpenClose").prop('checked', false);
        openTransactionCount = 0;
        closeTransactionCount = 0;
        transactionStatusNotCompleteList = [];
        tempIDTransExecution = [];
        LoadOpenCloseDataTable();
    });

    function resetFilter() {
        $('#FilterTransportationDateFrom').val("");
        $('#FilterTransportationDateTo').val("");
        $("#FilterTransportationNumber").select2("val", "");
        $("#FilterOrderNumber").select2("val", "");
        $("#FilterTransportationCategory").select2("val", "-- Select --");
        $("#FilterTransportationMode").select2("val", "-- Select --");
        $("#FilterVendor").select2("val", "-- Select --");
        $("#FilterVehicleType").select2("val", "-- Select --");
        $("#FilterOrderCategory").select2("val", "-- Select --");
        $("#FilterZone").select2("val", "-- Select --");
        $("#FilterStartLocation").select2("val", "-- Select --");
        $("#FilterSender").select2("val", "-- Select --");
        $("#FilterReceiver").select2("val", "-- Select --");
    }

    function resetradExport() {
        $("#radExportDetailData").prop('checked', false);
        $("#radExportCompactData").prop('checked', false);
        $("#radExportValidationFormat").prop('checked', false);
        $("#radExportReClassFormat").prop('checked', false);
    }

    //function getlistYear() {
    //    var thn1 = new Date().getFullYear();
    //    var thn2 = new Date().getFullYear() - 1;

    //    $('#FilterYear').append('<option value="' + thn1 + '">' + thn1 + '</option>');
    //    $('#FilterYear').append('<option value="' + thn2 + '">' + thn2 + '</option>');
    //}

    function getlistRole() {
        $.ajax({
            url: 'TransportationSummary/GetListRole',
            dataType: 'json',
            cache: false,
            success: function (data) {
                if (data != null) {
                    $.each(data, function (key, val) {
                        $('#FilterRole').append('<option value="' + val.RoleName + '">' + val.RoleName + '</option>');
                    });
                }
                GenerateTab('TRIP');
            }
        });
    }

    function generateTable() {
        beginLoading()

        var fdf = $('#FilterTransportationDateFrom').val(),
            fdt = $('#FilterTransportationDateTo').val(),
            ftn = ($("#FilterTransportationNumber").val() == null ? $("#FilterTransportationNumber").val() : $("#FilterTransportationNumber").val().toString()),
            fon = ($("#FilterOrderNumber").val() == null ? $("#FilterOrderNumber").val() : $("#FilterOrderNumber").val().toString()),
            ftc = ($("#FilterTransportationCategory").val() == null ? $("#FilterTransportationCategory").val() : $("#FilterTransportationCategory").val().toString()),
            ftm = ($("#FilterTransportationMode").val() == null ? $("#FilterTransportationMode").val() : $("#FilterTransportationMode").val().toString()),
            fvn = ($("#FilterVendor").val() == null ? $("#FilterVendor").val() : $("#FilterVendor").val().toString()),
            fvt = ($("#FilterVehicleType").val() == null ? $("#FilterVehicleType").val() : $("#FilterVehicleType").val().toString()),
            foc = ($("#FilterOrderCategory").val() == null ? $("#FilterOrderCategory").val() : $("#FilterOrderCategory").val().toString()),
            fzo = ($("#FilterZone").val() == null ? $("#FilterZone").val() : $("#FilterZone").val().toString()),
            fsl = ($("#FilterStartLocation").val() == null ? $("#FilterStartLocation").val() : $("#FilterStartLocation").val().toString()),
            fse = ($("#FilterSender").val() == null ? $("#FilterSender").val() : $("#FilterSender").val().toString()),
            fre = ($("#FilterReceiver").val() == null ? $("#FilterReceiver").val() : $("#FilterReceiver").val().toString()),
            fth = "",
            fro = $("#FilterRole").val();

        $.ajax({
            url: 'TransportationSummary/GetListView',
            method: 'POST',
            dataType: 'json',
            cache: false,
            data: { fltrdf: fdf, fltrdt: fdt, fltrtn: ftn, fltron: fon, fltrtc: ftc, fltrtm: ftm, fltrvn: fvn, fltrvt: fvt, fltroc: foc, fltrzo: fzo, fltrsl: fsl, fltrse: fse, fltrre: fre, fltrth: fth, fltrro: fro },
            success: function (data) {
                console.log(data);
                var n = 0;
                var table = $('#dtFilter').DataTable({
                    'destroy': true,
                    'data': data,
                    'paging': true,
                    'searching': true,
                    'iDisplayLength': 25,
                    columns: [
                        {
                            'class': 'hidden', 'render': function (data, type, row, meta) {
                                return row["IDTransportExecution"];
                            }
                        },
                        {
                            'data': 'IsActive', 'class': 'text-center', 'style': 'width:40px', 'render': function (data) {
                                if (data == true) {
                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
