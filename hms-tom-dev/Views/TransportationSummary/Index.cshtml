    function setHighlightCustomReport(obj) {
        if (obj.className.indexOf("fc-selected") !== -1) {
            obj.classList.remove("fc-selected");
        } else {
            obj.classList.add("fc-selected");
        }
    }

    $(document).on('click', '#left', function (e) {
        moveItems('#destinationFields', '#sourceFields');
        e.preventDefault();
    });

    $(document).on('click', '#right', function (e) {
        moveItems('#sourceFields', '#destinationFields');
        e.preventDefault();
    });

    $(document).on('click', '#leftall', function (e) {
        moveAllItems('#destinationFields', '#sourceFields');
        e.preventDefault();
    });

    $(document).on('click', '#rightall', function (e) {
        moveAllItems('#sourceFields', '#destinationFields');
        e.preventDefault();
    });

    function moveItems(origin, dest) {
        jQuery(origin).find('.fc-selected').appendTo(dest);
    }

    function moveAllItems(origin, dest) {
        jQuery(origin).children().appendTo(dest);
    }

    $('#layoutSelect').on('change', function () {
        for (var j = 1; j < layoutIsGlobal.length; j++) {
            if ($('#layoutSelect option:selected').text() == layoutIsGlobal[j].LayoutName) {
                $('#chkGlobalCustomReport').prop('checked', layoutIsGlobal[j].isGlobal);
            }
        }
        var sourceFieldNames = [
                { 'field': 'TransportationNumber', 'label': 'Transportation Number' },
                { 'field': 'TransportationStatus', 'label': 'Transportation Status' },
                { 'field': 'TransportationDate', 'label': 'Transportation Date' },
                { 'field': 'Vendor', 'label': 'Vendor' },
                { 'field': 'ActualVehicleType', 'label': 'Actual Vehicle Type' },
                { 'field': 'BasedKM', 'label': 'Based KM' },
                { 'field': 'BasedCost', 'label': 'Based Cost' }
        ],
            sourceFields = '',
            destinationFieldNames = this.value.split(','),
            destinationFields = '',
            destinationfieldLabels = [];
        //console.log(destinationFieldNames);
        for (var i = 0; i < sourceFieldNames.length; ++i) {
            if (jQuery.inArray(sourceFieldNames[i]['field'], destinationFieldNames) == -1) {
                // the element is not in the array
                sourceFields = sourceFields + "<li><div data-field='" + sourceFieldNames[i]['field'] + "' class='custom-report-field' onclick='setHighlightCustomReport(this)'>" + sourceFieldNames[i]['label'] + "</div></li>";
            } else {
                destinationfieldLabels[sourceFieldNames[i]['field']] = sourceFieldNames[i]['label'];
            }
        }
        $("#fieldChooser #sourceFields").html(sourceFields);
        //console.log(destinationFieldNames);
        if (destinationFieldNames[0] != "") {
            for (var i = 0; i < destinationFieldNames.length; ++i) {
                destinationFields = destinationFields + "<li><div data-field='" + destinationFieldNames[i] + "' class='custom-report-field' onclick='setHighlightCustomReport(this)'>" + destinationfieldLabels[destinationFieldNames[i]] + "</div></li>";
            }
        }
        $("#fieldChooser #destinationFields").html(destinationFields);
    });

