<div class="clearfix"></div>
<p>Crash Quantity</p>
<div class="table-overflow-outer" id="dtCQ"></div>
<div class="clearfix"></div>
<p>Total KM</p>
<div class="table-overflow-outer" id="dttotalkm"></div>

<script type="text/javascript">
    jQuery(function ($) {
        generateCQ();
        generateTotalKM();

    });
    function generateCQ() {
        $.ajax({
            criteria: {
                SortExpression: "Sorting",
                SortOrder: "ASC",
            },
            url: '@Url.Action("GetDatasResult")',
            data: {
                "filterTab": "CRASHEACHVENDOR",
                "filterRole": '@(ViewBag.FilterRole)', //$("#FilterVendor option:selected").val(),
                "filterSort": "CQ",
                "filterYear": '@(ViewBag.FilterYear)'
            },
            method: 'GET',
            dataType: 'json',
            cache:false,
            success: function (json) {
                var result = JSON.parse(json);
                var generatedData = {
                    dataid: "An optional sourcetable identifier",
                    columns: [
                        { colvalue: "p2 ", coltext: "p2 ", header: "Transportation Mode ", sortbycol: "p1 ", dataid: "An optional id.", groupbyrank: 1, pivot: false, result: false },
                        { colvalue: "p4 ", coltext: "p4 ", header: "Vendor Name ", sortbycol: "p4 ", groupbyrank: 2, pivot: false, result: false },
                        { colvalue: "val ", coltext: "val ", header: "val ", sortbycol: "val ", groupbyrank: null, pivot: false, result: true },
                        { colvalue: "res ", coltext: "res ", header: "res ", sortbycol: "res ", groupbyrank: null, pivot: true, result: false }
                    ],
                    rows: result, // json data
                };
                $('#dtCQ').pivot({
                    source: generatedData,
                    formatFunc: function (n) {
                        return jQuery.fn.pivot.formatUK(n, 0);
                    },
                    parseNumFunc: function (n) {
                        return +((typeof n === "string") ? +n.replace('.', '').replace(',', '.') : n);
                    },
                    onResultCellClicked: function (data) {

                    },
                    sortPivotColumnHeaders: false, //we want months non sorted to get them in the right order.

                });
            }
        });
    }

    function generateTotalKM() {
        $.ajax({
            criteria: {
                SortExpression: "Sorting",
                SortOrder: "ASC",
            },
            url: '@Url.Action("GetDatasResult")',
            data: {
                "filterTab": "CRASHEACHVENDOR",
                "filterRole": '@(ViewBag.FilterRole)', //$("#FilterVendor option:selected").val(),
                "filterSort": "TOTALKMCRASH",
                "filterYear": '@(ViewBag.FilterYear)'
            },
            method: 'GET',
            dataType: 'json',
            cache: false,
            success: function (json) {
                var result = JSON.parse(json);
                var generatedData = {
                    dataid: "An optional sourcetable identifier",
                    columns: [
                        { colvalue: "p2 ", coltext: "p2 ", header: "Transportation Mode ", sortbycol: "p1 ", dataid: "An optional id.", groupbyrank: 1, pivot: false, result: false },
                        { colvalue: "p4 ", coltext: "p4 ", header: "Start Location ", sortbycol: "p4 ", groupbyrank: 2, pivot: false, result: false },
                        { colvalue: "val ", coltext: "val ", header: "val ", sortbycol: "val ", groupbyrank: null, pivot: false, result: true },
                        { colvalue: "res ", coltext: "res ", header: "res ", sortbycol: "res ", groupbyrank: null, pivot: true, result: false }
                    ],
                    rows: result, // json data
                };
                $('#dttotalkm').pivot({
                    source: generatedData,
                    formatFunc: function (n) {
                        return jQuery.fn.pivot.formatUK(n, 0);
                    },
                    parseNumFunc: function (n) {
                        return +((typeof n === "string") ? +n.replace('.', '').replace(',', '.') : n);
                    },
                    onResultCellClicked: function (data) {

                    },
                    sortPivotColumnHeaders: false, //we want months non sorted to get them in the right order.

                });
            }
        });
    }
</script>

