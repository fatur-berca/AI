    function save(statusSave) {
        CheckTreeListBeforeSave();
        var idrolefunc = $('#IDRolesFunctionMapping').val();
        var roleid = $('#RoleID :selected').val();
        var idfunction = tempArrayFunction;
        //var status = $('#Status :selected').val() == 1 ? true : false;
        var status = true;
        var createddate = $('#CreatedDate').val();
        var createdby = $('#CreatedBy').val();
        var data;
        if (statusSave) {
            data = {
                "new": [{ "IDRole": roleid, "ListIDFunction": idfunction, "IsActive": status }],
                "edit": [{}]
            };
        } else {
            data = {
                "new": [{}],
                "edit": [{ "IDRolesFunctionMapping": idrolefunc, "IDRole": roleid, "listIDFunction": idfunction, "IsActive": status, "CreatedDate": createddate, "CreatedBy": createdby }]
            };
        }
        $.ajax({
            type: 'POST',
            url: 'MstRoleFunction/InsertList',
            data: data,
            success: function () {
                generateTable();
                //resetData();
                //$('#inputModal').modal('hide');
                $("#treeview2").hummingbird('collapseAll');
                generateTable();
                $('#modalsuccess').modal('show');
                $('#Loading').modal('hide');
            }
        });
    }
