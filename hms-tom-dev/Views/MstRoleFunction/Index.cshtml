    //check semua function yang ada di database/is activenya true
    function treeListChecked(id) {
        $.ajax({
            url: "MstRoleFunction/GetIDFunctionList?roleid=" + id,
            type: 'GET',
            dataType: 'json',
            cache: false,
            success: function (data) {
                for (var x = 0; x < data.length; x++) {
                    $("#treeview").hummingbird("checkNode", { attr: "id", name: "xnode-" + data[x], expandParents: false });
                    var index = tempListALLFunction.indexOf(data[x]);
                    if (index > -1) {
                        tempListALLFunction.splice(index, 1);
                    }
                }
                //uncheck function baru yang diinsert langsung ke database
                for (var y = 0; y < tempListALLFunction.length; y++) {
                    $("#treeview").hummingbird("uncheckNode", { attr: "id", name: "xnode-" + tempListALLFunction[y], expandParents: false });
                }
            }
        });
    }
