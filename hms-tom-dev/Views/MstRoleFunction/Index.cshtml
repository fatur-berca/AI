            type: 'GET',
            dataType: 'json',
            cache: false,
            success: function (data) {
                tempListALLFunction = [];
                var module = "";
                var form = "";
                var button = "";
                $("#treeview").empty();
                for (var i = 0; i < data.length; i++) {                   
                    if (module != data[i]["NameModule"]) {
                        module = data[i]["NameModule"];
                        $("#treeview").append("<li id='li-" + data[i]["IDModule"] + "'></li>");
                        $('#li-' + data[i]["IDModule"]).append("<i class='fa fa-plus'></i> <label><input id='xnode-" + data[i]["IDModule"] + "' data-id='custom-" + data[i]["IDModule"] + "' name='disabledNode' type='checkbox'/>" + data[i]["NameModule"] + "</label> <ul id='ul-" + data[i]["IDModule"] + "' style='display: none;'></ul>");
                        tempListALLFunction.push(data[i]["IDModule"]);
                    }
                    if (form != data[i]["NameForm"]) {
                        form = data[i]["NameForm"];
                        $('#ul-' + data[i]["IDModule"]).append("<li id='li-" + data[i]["IDForm"] + "'></li>");
                        $('#li-' + data[i]["IDForm"]).append("<i class='fa fa-plus'></i> <label><input id='xnode-" + data[i]["IDForm"] + "' data-id='custom-" + data[i]["IDModule"] + "-" + data[i]["IDForm"] + "' name='disabledNode' type='checkbox'/>" + data[i]["NameForm"] + "</label> <ul id='ul-" + data[i]["IDForm"] + "' style='display: none;'></ul>");
                        tempListALLFunction.push(data[i]["IDForm"]);
                    }
                    if (data[i]["NameButton"] != null) {
                        if (button != data[i]["NameButton"]) {
                            button = data[i]["NameButton"];
                            $('#ul-' + data[i]["IDForm"]).append("<li id='li-" + data[i]["IDButton"] + "'></li>");
                            $('#li-' + data[i]["IDButton"]).append("<label><input class='hummingbirdNoParent' id='xnode-" + data[i]["IDButton"] + "' data-id='custom-" + data[i]["IDModule"] + "-" + data[i]["IDForm"] + "-" + data[i]["IDButton"] + "' name='disabledNode' type='checkbox'/>" + data[i]["NameButton"] + "</label>");
                            tempListALLFunction.push(data[i]["IDButton"]);
                        }
                    }
                }
                $("#treeview").hummingbird('collapseAll');
                $("#treeview").hummingbird();
                treeListChecked(roleId);
            }
        });
