    //MENGECEK TREE LIST 2 SEBELUM SAVE START
    function CheckTreeListBeforeSave() {
        var ListChecked = [];
        var ListUnchecked = [];
        $("#treeview2").hummingbird("getChecked", { attr: "id", list: ListChecked });//mengambil semua id yang tercheck
        $("#treeview2").hummingbird("getUnchecked", { attr: "id", list: ListUnchecked });//mengambil semua id yang uncheck
        for (var i = 0; i < ListChecked.length; i++) {
            var id = ListChecked[i].split("-");
            var result = $.grep(tempListChecked, function (e) { return e == parseInt(id[1]); });//mencari apakah id function yang tercheck ada didatabase
            if (result.length == 0) {
                var result2 = $.grep(tempArrayFunction, function (e) { return e == parseInt(id[1]); });//kalau tidak dapat, mencari di array yang akan disave database, apakah sudah ada id functionnya
                if (result2.length == 0)
                    tempArrayFunction.push(parseInt(id[1]));//kalau tidak ada id function di masukkan ke dalam array
            }
            else {
                tempArrayFunction = tempArrayFunction.filter(function (obj) {//kalau dapat, maka id functionnya dikeluarkan
                    return obj !== parseInt(id[1]);
                });
            }
        }
        for (var j = 0; j < ListUnchecked.length; j++) {
            var iduncheck = ListUnchecked[j].split("-");
            var resultuncheck = $.grep(tempListChecked, function (e) { return e == parseInt(iduncheck[1]); });//mencari apakah id function yang teruncheck ada didatabase
            if (resultuncheck[0] != undefined) {
                //if (resultuncheck.length != 0) {
                tempArrayFunction.push(resultuncheck[0]);//kalau dapat, artinya id function yang ada didatabase, di uncheck/mau dihilangkan dari mapping. id function di masukkan ke dalam array
                //} else {
                //    tempArrayFunction = tempArrayFunction.filter(function(obj) {
                //        return obj !== resultuncheck[0];
                //    });
                //}
            } else {
                var result2uncheck = $.grep(tempArrayFunction, function (e) { return e == parseInt(iduncheck[1]); });//kalau tidak dapat, mencari di array yang akan disave database, apakah sudah ada id functionnya
                if (result2uncheck.length != 0) {
                    tempArrayFunction = tempArrayFunction.filter(function (obj) {//kalau dapat, id functionnya di hilangkan dari array yang akan di simpan di database(defaultnya teruncheck, setelah itu di check, kemudian diuncheck lagi)
                        return obj !== result2uncheck[0];
                    });
                }
            }
        }
    }
    //MENGECEK TREE LIST 2 SEBELUM SAVE END

