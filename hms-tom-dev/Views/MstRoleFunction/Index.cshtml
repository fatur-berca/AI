    // BEGIN :JQUERY INSERT DROPDOWN ROLE
    function generateDropDownRole(selectedValue) {
        $.ajax({
            url: 'MstRoleFunction/GetDropDownRole',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (data) {
                var select = document.getElementById('RoleID');
                var len = document.getElementById('RoleID').length;
                var option;
                if (len > 0)
                    $('#RoleID').empty().append('');
                for (var i = 0; i < data.length; i++) {
                    option = document.createElement('option');
                    option.value = data[i]["IDRole"];
                    option.text = data[i]["RoleName"];
                    if (option.value == selectedValue)
                        option.setAttribute("selected", "selected");
                    select.add(option);
                }
            }
        });
    }
