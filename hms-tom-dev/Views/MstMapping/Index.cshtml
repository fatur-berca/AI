@{
    ViewBag.Title = "Master Data > Master Configuration > Mapping";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#inputModal">Add New</button>
    </div>
</div>

<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr>
            <th width=5% nowrap class="text-center">Active</th>
            <th>Map From</th>
            <th>Map To</th>            
            <th>Last Update</th>
            <th hidden>Last Update</th>           
            <th width=5% nowrap class="text-center">Action</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th width=5% nowrap class="text-center">Filter</th>
            <th>Map From</th>
            <th>Map To</th>  
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center"></th>
        </tr>
    </thead>
</table>

<!-- BEGIN : MODAL INSERTORUPDATE -->
<div class="modal fade" id="inputModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Mapping</h4>
            </div>
            <div class="modal-body">
                <div id="fieldChooser" tabindex="1" class="field-chooser">
                    <div class="col-md-12">
                            <form id="newData">
                                <div class="row" hidden>
                                    <div class="col-md-24">
                                        <div class="form-group">
                                            <label>InsertOrUpdate</label>
                                            <input type="text" id="InsertOrUpdate" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6" hidden>
                                    <div class="form-group">
                                        <label>IDList</label>
                                        <input type="text" id="IDMasterMapping" class="form-control">
                                    </div>
                                </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label id="label-id">Map From</label>
                                            <input type="text" id="MapFrom" class="form-control">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Map To</label>
                                            <input type="text" id="MapTo" class="form-control">
                                        </div>
                                    </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Active</label>
                                        <select class="form-control" id="Status">
                                            <option value="1">YES</option>
                                            <option value="0">NO</option>
                                        </select>
                                    </div>
                                </div>
                            </form>
                       
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveNew">Save Changes</button>
            </div>
        </div>
    </div>
</div>
<!-- END : MODAL INSERTORUPDATE-->

<div class="modal fade" id="setinactive" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Edit Data Confirmation</h4>
            </div>
            <div class="modal-body">
                Are you sure want to Edit Data?

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" id="btnSaveYes">Yes</button>

            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/cancel.png" alt="">
                <span>Sorry, the inputted data exists or your connection is lost</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-warning" id="modalwarning" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/danger.png" alt="">
                <span>Please fill the empty field(s) before saving</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div id="Loading" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">DFIS Notification Center</h4>
            </div>
            <div class="modal-body"><img src="assets/images/loading.gif" alt=""><span> Please wait...</span></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>


<script type="text/javascript">
    jQuery(function ($) {
        $(document).on('click', '#addNew', function (e) {
            resetData();
            $('#InsertOrUpdate').val("INSERT");
            //$('#label-id').html('Vendor ID');
            //$('#IDVendor').prop("readonly", false);
            document.getElementById("MapFrom").disabled = false;
            e.preventDefault();
        });

        generateTable();

        $('#btnSaveYes').click(function () {
            edit();
            $('#setinactive').modal('hide');
            $('#inputModal').modal('hide');
        });
        $(document).on('click', '#btnSaveNew', function (e) {
            if ($('#newData').find('input[id="MapFrom"]').val() == "" || $('#newData').find('input[id="MapTo"]').val() == "") {
                $('#modalwarning').modal('show');
            } else {
                if ($('#newData').find('input[id="InsertOrUpdate"]').val() === "UPDATE") {
                    $('#setinactive').modal('show');

                } else {
                    save();
                }
            }
            e.preventDefault();
        });
    });
    
    function resetData() {
        jQuery('#newData')[0].reset();
    }

    //generate table
    function generateTable() {
        jQuery.ajax({
            url: 'MstMapping/GetMasterMapping',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (json) {
                var table = $('#dtFilterMaster').DataTable({
                    data: json,
                    "destroy": true,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "iDisplayLength": 25,
                    aaSorting: [[4, 'desc']],
                    columns: [
                        {
                            "data": "IsActive", "class": "text-center", "render": function (data) {

                                if (data == true) {

                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }

                            }
                        },
                           { 'data': 'MapFrom', 'searchable': true },
                        { 'data': 'MapTo', 'searchable': true },
                         {
                             render: function (data, type, row) {
                                 // var tes = { data: 'UpdatedDate', } + { data: 'UpdatedBy' };  
                                 var date = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                 var formatted = date.getFullYear() + "-" +
                                       ("0" + (date.getMonth() + 1)).slice(-2) + "-" +
                                       ("0" + date.getDate()).slice(-2) + " " + date.getHours() + ":" +
                                       date.getMinutes();
                                 //var dt = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                 //var dtStr = dt.toString();
                                 //var date = dtStr.substr(8, 2) + " " + (dtStr.substr(4, 3)) + " " + dtStr.substr(11, 4) + " " + dt.getHours() + ":" +
                                 //      dt.getMinutes();
                                 var jamtanggal = moment(row['UpdatedDate']).format("DD-MMM-YYYY HH:mm");
                                 return '<label hidden>' + row['UpdatedDate'] + '</label>by ' + row['UpdatedBy'] + ' on ' + jamtanggal;
                             }
                         },
                          { 'data': 'UpdatedDate', 'class': 'hidden' },
                       
                        { "data": "IDMasterMapping", "class": "text-center", "render": function (data) {
                                return '<div><a href="#" id="editForm" onclick="return editTable(\'' + data + '\')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a></div>';
                            }
                        }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                jQuery('.dataTables_filter input').attr("placeholder", "Search Here");

                // Setup - add a text input to each footer cell
                jQuery('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 1) && (index < 4)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                // Search with column on datatable
                table.columns().every(function (index) {
                    jQuery('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible').search(this.value).draw();
                    });
                });
            }
        });
    }
    // END : JQUERY SELECT TO DataTable

    // BEGIN : Insert New Data
    function save() {
        $('#Loading').modal('show');
        var vendor_id = jQuery('#newData').find('input[id="MapFrom"]').val(),
            vendor_name = jQuery('#newData').find('input[id="MapTo"]').val(),
            is_active = jQuery('#Status :selected').val() == 1 ? true : false,
            data = {
                "new": [{ "MapFrom": vendor_id, "MapTo": vendor_name, "IsActive": is_active }],
                "edit": [{}]
            };

        jQuery.ajax({
            type: 'POST',
            url: 'MstMapping/InsertMapping',
            data: data,
            success: function (data) {            

                if (data.New) {
                    $.each(data.New, function (k, value) {
                        if (value.ResponseType == "Success") {
                            generateTable();
                            $('#modalsuccess').modal('show');
                            $('#Loading').modal('hide');
                            resetData();
                        } else {
                            $('#modalerror').modal('show');
                            $('#Loading').modal('hide');
                        }

                    });
                }
            }
        });
    }
    // END : Insert New Data
    
    // BEGIN : Edit Data
    // get edit data and assign to modal
    function editTable(id) {
        $('#newData')[0].reset();
        $('#InsertOrUpdate').val("UPDATE");
        document.getElementById("MapFrom").disabled = true;
        $.ajax({
            url: 'MstMapping/GetDataById',
            typr: "GET",
            cache: false,
            contentType: "application/json;charset=UTF-8",
            dataType: "json",
            data: { "IDMasterMapping": id },
            success: function (json) {
                $('#IDMasterMapping').val(json.IDMasterMapping);
                $('#MapFrom').val(json.MapFrom);
                $('#MapTo').val(json.MapTo);
              
                if (json.IsActive) {
                    $('#Status').val("1");
                } else {
                    $('#Status').val("0");
                }

                ////close modal
                $('#inputModal').modal('show');

            }
        });
    }
    
    //update edited data
    function edit() {
        //var data = $('#newData').serialize();
        $('#Loading').modal('show');
        var id = $('#newData').find('input[id="IDMasterMapping"]').val();
        var name = $('#newData').find('input[id="MapFrom"]').val();
        var value = $('#newData').find('input[id="MapTo"]').val();
      
        var status = $('#Status :selected').val() == 1 ? true : false;

        var data = {
            "new": [{}],
            "edit": [{ "IDMasterMapping": id, "MapFrom": name, "MapTo": value, "IsActive": status }],
        };

        $.ajax({
            type: 'POST',
            url: 'MstMapping/InsertMapping',
            data: data,
            success: function (data) {               
                if (data.Edit) {
                    $.each(data.Edit, function (k, value) {
                        if (value.ResponseType == "Success") {
                            generateTable();
                            $('#modalsuccess').modal('show');
                            $('#Loading').modal('hide');
                            resetData();
                        } else {
                            $('#modalerror').modal('show');
                            $('#Loading').modal('hide');
                        }
                    });
                }
            }
        });
    }
    // END : Edit Data
</script>
