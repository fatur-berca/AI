                    //    'data': 'IDEquipmentType', 'searchable': true, "render": function (data, type, row, meta) {
                    //        return '<label style="font-weight: 200;">' + row.MasterEquipmentType.Name + '</label>';
                    //    }
                    //},
                    //{ 'data': 'SealNumber', 'searchable': true },
                    //{ 'data': 'WarehouseStaff1', 'searchable': true },
                    //{ 'data': 'WarehouseStaff2', 'searchable': true },
                    //{ 'data': 'WarehouseStaff3', 'searchable': true }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true,
                    'rowCallback': function (row, data, dataIndex) {
                        // Get row ID
                        var rowId = data.IDCardNumber;

                        // If row ID is in the list of selected row IDs
                        if ($.inArray(rowId, rowsSelected) !== -1) {
                            $(row).find('input[type="checkbox"]').prop('checked', true);
                            $(row).addClass('selected');
                        }
                    }
                    
                });
                
                //start : handle column search

                $('.dataTables_filter input').attr("placeholder", "Search Here");

                $('#dtFilter thead.filters th').each(function (index) {
                    if (index < 3 && index > 0) {
                        jQuery(this).empty();
                    }
                });

                table.columns().every(function (index) {
                    $('#dtFilter thead.filters th:eq(' + index + ') input').on('keyup change', function () {
                        table.column($(this).parent().index() + ':visible').search(this.value).draw();
                    });
                });
                // end : handle column search
            }
        });
    }

    function exportToExcelDefault() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        var param = jQuery("input[name='param']").val();

        var dateFrom = $("#DateFrom").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
            dateTo = $("#DateTo").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
            status = (param == "firstload") ? $("#DDStatus").val() : ($("#DDStatus").val() == null ? $("#DDStatus").val() : $("#DDStatus").val().toString()),
            warehouse = (param == "firstload") ? $("#DDWarehouse").val() : ($("#DDWarehouse").val() == null ? $("#DDWarehouse").val() : $("#DDWarehouse").val().toString()),
            staff = (param == "firstload") ? $("#DDStaff").val() : ($("#DDStaff").val() == null ? $("#DDStaff").val() : $("#DDStaff").val().toString()),
            location = (param == "firstload") ? $("#DDLocation").val() : ($("#DDLocation").val() == null ? $("#DDLocation").val() : $("#DDLocation").val().toString()),
            includeInActive = ($('#deleted').length > 0) ? (($('#all').prop("checked") == true ? 1 : 0)) : null;

        var fileInput = new Object();

        fileInput.status = status;
        fileInput.StatusDateTimeFrom = dateFrom;
        fileInput.StatusDateTimeTo = dateTo;
        fileInput.IDLocation = warehouse;
        fileInput.WarehouseStaff1 = staff;
        fileInput.IDEquipmentTypeArray = location;
        fileInput.Type = param == "firstload" ? "index" : param;
        fileInput.IncludeInActive = includeInActive;
        fileInput.Columns = "Status,Date,Warehouse ID,Warehouse Name,Seal Number,Warehouse Staff-1,Warehouse Staff-2,Warehouse Staff Other";

        jQuery.ajax({
            url: '@Url.Action("ExportToExcel")',
            method: 'post',
            dataType: 'json',
            data: fileInput,
            success: function (response) {
                dialog.modal('hide');
                window.location.assign("Assets/Download/" + response);
            }
        });
    }

    
    $("#UnlockSealNumber").on('keyup', function (e) {
        if (e.keyCode == 13) {
            // Do something
            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });
            $.ajax({
                url: '@Url.Action("checkSealNumber")',
                method: 'post',
                dataType: 'json',
                data: { "id": $("#UnlockSealNumber").val(), location: $("#Warehouse").val() },
                success: function (response) {
                    dialog.modal('hide');
               
                    if (response >= 1) {
                       
                        document.location = "@Url.Action("SetOpen")" + "?id=" + $("#UnlockSealNumber").val() + "&location=" + $("#Warehouse").val();
                        //$("#textModalWarningYesNo").html("Data already unlocked");
                        //$('#warningModalYesNo').modal('show');
                 
                    } else {
                        $("#textModalWarningYesNo").html("Data not found or already unlocked");
                        $('#warningModalYesNo').modal('show');
                    }
                    //window.location.assign("/dfis/Assets/Download/" + response);
                },
                error: function () {
                    //if there is an error append a 'none available' option
                    dialog.modal('hide');
                    $("#textModalWarningYesNo").html("Data not found or already unlocked");
                    $('#warningModalYesNo').modal('show');
                }
            });
        }
    });
    

