    function IsAngka(evt) {
        var charCode = (evt.which); //? evt.which : event.keyCode
        //alert(evt.which);
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }

    function gup(name) {
        name = name.replace(/[\[]/, "\\\[").replace(/[\]]/, "\\\]");
        var regexS = "[\\?&]" + name + "=([^&]*)";
        var regex = new RegExp(regexS);
        var results = regex.exec(window.location.href);
        if (results == null)
            return "";
        else {
            for (i = 0; i < results[1].length; i++) {
                results[1] = results[1].replace("%20", " ");
                results[1] = results[1].replace("%27", "'");
            }
            return results[1];
        }
    }

    function ResetData() {
        $("#all").prop("checked", true);
        $("#DDStatus").val('');
        $("#DateFrom").val(moment(new Date()).format("DD/MM/YYYY"));
        $("#DateTo").val(moment(new Date()).format("DD/MM/YYYY"));
        $("#DDWarehouse").select2("val", "");
        $("#DDStaff").select2("val", "");
        $("#DDSealNumber").select2("val", "");
        $("#DDLocation").select2("val", "");
        GenerateTable("firstload");
    }
    
    var GenerateDropDownWarehouse = function () {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("../SealManagement/GetUserWarehouse")',
            success: function (listLocation) {
                var options = '<option value="-"></option>';
                if (listLocation.length) {
                    for (i = 0; i < listLocation.length; i++) {
                        options = options + '<option value="' + listLocation[i].IDLocation + '">' + listLocation[i].IDLocation + ' - ' + listLocation[i].LocationName + '</option>';
                    }
                }
                $('#DDWarehouse').html(options);
                GenerateDropDownStatus();
            }
        });
    };

    var GenerateDropDownStatus = function () {
        $.ajax({
            type: 'POST',
            data: {
                FieldName: "SealStatus"
            },
            url: '@Url.Action("../SealManagement/GetMasterList")',
            success: function (response) {
                var options = '<option value="-"></option>';
                if (response.length) {
                    for (i = 0; i < response.length; i++) {
                        options = options + '<option value="' + response[i].FieldValue + '">' + response[i].FieldValue + '</option>';
                    }
                }
                $('#DDStatus').html(options);
                GenerateDropDownStaff();
            }
        });
    };

    var GenerateDropDownStaff = function () {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("../SealManagement/GetDataStaffView")',
            data: {
                "id": (gup('id') == "") ? ($("#DDWarehouse").val() == '-' ? null : $("#DDWarehouse").val()) : gup('id')
            },
            success: function (response) {
                var options = '<option value="-"></option>';
                if (response.length) {
                    var fullName = "";
                    for (i = 0; i < response.length; i++) {
                        if (fullName !== response[i].FULL_NAME) {
                            fullName = response[i].FULL_NAME;
                            options = options + '<option value="' + response[i].FULL_NAME + '">' + response[i].NAME + '</option>';
                        }
                    }
                }
                $('#DDStaff').html(options);
                GenerateDropDownSealNumb();
            }
        });
    };

    var GenerateDropDownSealNumb = function () {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("../SealManagement/GetSealNumber")',
            success: function (response) {
                var options = '<option value="-"></option>';
                if (response.length) {
                    for (i = 0; i < response.length; i++) {
                        options = options + '<option value="' + response[i].SealNumber + '">' + response[i].SealNumber + '</option>';
                    }
                }
                $('#DDSealNumber').html(options);
                GenerateDropDownLocationArea();
            }
        });
    };
    
    var GenerateDropDownLocationArea = function () {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("../SealManagement/GetMasterEquipmentTypeListByIdLocType")',
            data: {
                idloc : '',
                type : 'seal'
            },
            success: function (respond) {
                var options = '<option value="-"></option>';
                if (respond.length) {
                    for (i = 0; i < respond.length; i++) {
                        options = options + '<option value="' + respond[i].IDEquipmentType + '">' + respond[i].MasterLocation.LocationName + ' - ' + respond[i].Name + '</option>';
                    }
                }
                $('#DDLocation').html(options);
            }
        });
    };
    //==========================================================================================================
