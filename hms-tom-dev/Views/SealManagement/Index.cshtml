@using System.Web.Mvc.Html
@using EnumHelper = DFIS.Utils.EnumHelper

@{
    ViewBag.Title = "Warehouse > Seal Management > List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
    bool isSuperUser = false;
}

@foreach (var x in listUserRole)
{
    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
    {
        isSuperUser = true;
        break;
    }
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.AddNew)))
        {
            <button class="btn btn-primary" onclick="window.location.href = '@Url.Action("AddNew")' ">Add New</button>
        }
        <button class="btn btn-primary" data-toggle="modal" data-target="#UnlockModal">Unlock</button>
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Delete)))
        {
            <button class="btn btn-primary" id="btnSetInactive" type="button" onclick="SetIsActive('Delete')">Delete</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
        {
            <button class="btn btn-primary" id="ExportBtn" onclick="exportToExcelDefault()">Export</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
        {
            <button class="btn btn-primary" data-toggle="modal" data-target="#customReportModal" id="customReportButton">Custom Report</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Recovery)) && isSuperUser)
        {
            <button class="btn btn-primary" id="btnSetActive" type="button" onclick="SetIsActive('Recovery')">Recovery</button>
        }
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel">

            <div class="col-md-6">
                <div class="form-group">
                    <label>Status</label>
                    <select class="form-control" id="DDStatus"></select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Date Range</label>
                    <div class="row">
                        <div class="col-md-5">
                            <input type="text" class="form-control datepicker" id="DateFrom">
                        </div>
                        <div class="col-md-2 to-bi">
                            <label>to</label>
                        </div>
                        <div class="col-md-5">
                            <input type="text" class="form-control datepicker" id="DateTo">
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Warehouse Name</label>
                    <select class="select2" multiple="multiple" id="DDWarehouse"></select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Warehouse Staff</label>
                    <select class="select2" multiple="multiple" id="DDStaff"></select>
                </div>
            </div>
         
            <div class="col-md-3">
                <div class="form-group">
                    <label>Location/Area</label>
                    <select class="select2" multiple="multiple" id="DDLocation"></select>
                </div>
            </div>
            @if (isSuperUser)
            {
                <div class="clearfix"></div>
                <div class="col-sm-4">
                    <div class="form-group">

                        <label for="input-type">Status</label>
                        <div id="input-type" class="row">
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" id="all" value="1" type="radio" />Active
                                </label>
                            </div>
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" id="deleted" value="0" type="radio" /> Deleted
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="col-md-12">
                <button class="btn btn-primary" id="BtnSearch" onclick="GenerateTable('search')">Search</button>
                <button class="btn btn-purple" onclick="ResetData()">Reset</button>
            </div>
        </div>
    </div>
</div>

