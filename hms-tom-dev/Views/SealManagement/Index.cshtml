    // BEGIN : SET INACTIVE OR ACTIVE RELATED TO CHECKBOX FUNCTION
    var tempid = [];
    var tempdate = [];
    var tempstatus = [];
    var filter = new Object();
    var stat = false;
    function SetIsActive(param) {
        if (tempid.length > 0) {
            bootbox.confirm({
                title: "DFIS Notification Center",
                message: "Are you sure to " + param + " this data?",
                buttons: {
                    confirm: {
                        label: 'Yes',
                        className: 'btn btn-primary'
                    },
                    cancel: {
                        label: 'Cancel',
                        className: 'btn btn-purple'
                    }
                },
                callback: function (result) {
                    if (result) {
                        if (AllowDelete() == true) {
                            
                        }
                    }
                }
            });
            stat = (param == "Delete") ? false : true;
        } else if (tempid.length == 0) {
            alertPleaseSelect();
        }
    }

    function AllowDelete() {
        filter = new Object();
        filter.ListIsActiveIdString = tempid;
        filter.ListDate = tempdate;
        filter.ListStatus = tempstatus;
        filter.Isactive = stat;
        filter.Page = "SealManagement";
        $.ajax({
            url: "SealManagement/CheckAllowDeleted",
            method: 'post',
            dataType: 'json',
            data: filter,
            cache: false,
            success: function (response) {
                if (response == "Success") {
                    ChangeIsActive();
                    return true;
                } else if (response == "UnlockedIsAvailable") {
                    bootbox.alert({
                        title: "DFIS Notification Center",
                        message: "<img src='assets/images/cancel.png' alt=''>Locked Data cannot be delete, because Unlocked Data is exists.",
                        callback: function () {
                            $('.bootbox.modal').modal('hide');
                        }
                    }); 
                    return false;
                } else if (response == "PartialLocked") {
                    bootbox.alert({
                        title: "DFIS Notification Center",
                        message: "<img src='assets/images/cancel.png' alt=''>Your data is partial and cannot be Deleted, Delete the locked data first!",
                        callback: function () {
                            $('.bootbox.modal').modal('hide');
                        }
                    });
                    return false;
                }
            }
        });
    }

    function ChangeIsActive() {
        $.ajax({
            url: "SealManagement/SetStatusResult",
            method: 'post',
            dataType: 'json',
            data: filter,
            cache: false,
            success: function (response) {
                var param = jQuery("input[name='param']").val(),
                    msg = stat ? "Recovered" : "Deleted";
                if (response == "Success") {
                    bootbox.alert({
                        title: "DFIS Notification Center",
                        message: "<img src='assets/images/checked.png' alt=''> Data has been successfully " + msg + " from the database.",
                        callback: function () {
                            GenerateTable(param);
                            filter.ListIsActiveIdString = null;
                            filter.ListDate = null;
                            filter.ListStatus = null;
                            tempid = [];
                            tempdate = [];
                        }
                    });
                } else {
                    bootbox.alert({
                        title: "DFIS Notification Center",
                        message: "<img src='assets/images/cancel.png' alt=''>Error your data cannot be " + msg + " !",
                        callback: function () {
                            GenerateTable(param);
                            filter.ListIsActiveIdString = null;
                            filter.ListDate = null;
                            filter.ListStatus = null;
                            tempid = [];
                            tempdate = [];
                        }
                    });
                }
            },
            error: function (data, textStatus, jqXHR) {
                var param = jQuery("input[name='param']").val();
                GenerateTable(param);
                filter.ListIsActiveIdString = null;
                filter.ListDate = null;
                filter.ListStatus = null;
                tempid = [];
                tempdate = [];
            }
        });
    }
    // END : SET INACTIVE OR ACTIVE RELATED TO CHECKBOX FUNCTION

    //CHECK BOX DAN CHECK BOX ALL
    function InsertTempArray(e) {        
        tempid = [];
        tempdate = [];
        tempstatus = [];
        //if ($(e).prop('checked')) {
        //    $(e).prop('checked', false);
        //    return;
        //}
        var table = $('#dtFilter').DataTable();
        $('#dtFilter tbody').one('change', 'tr', function () {
            var data = table.row(this).data();
            var id = data["IDLocation"]  ;
            var datestatus = data["strStatusDateTime"];
            var statuslock = data["Status"];
            var result = $.grep(tempid, function (e) { return e == id; });
            if (result.length == 0) {
                tempid.push(id);
                tempdate.push(datestatus);
                tempstatus.push(statuslock);
            } else if (result.length == 1) {
                tempid = tempid.filter(function (obj) {
                    return obj !== id;
                });

                tempdate = tempdate.filter(function (obj) {
                    return obj !== id;
                });

                tempstatus = tempstatus.filter(function (obj) {
                    return obj !== id;
                });
            }
        });
    }

    $("#checkall").change(function () {
        $(".chkList").prop('checked', $("#checkall").prop('checked'));
        if ($("#checkall").prop('checked')) {
            var table = $('#dtFilter').DataTable();
            table.column(1).nodes().each(function (cell, i) {
                tempid.push(table.cell(i, 1).data());
            });
            tempid = tempid.filter(onlyUnique);
        } else {
            tempid = [];
        }
    });

    //filter supaya array javascript hanya ada unique value
    function onlyUnique(value, index, self) {
        return self.indexOf(value) === index;
    }
