                        //$("#DDWarehouse").val(response[i].IDLocation).trigger('change');
                        //$("#DDStaff1L").val(response[i].WarehouseStaff1).trigger('change');
                        //$("#DDStaff2L").val(response[i].WarehouseStaff2).trigger('change');
                        //$("#SealDateL").val(moment(response[i].StatusDateTime, 'YYYY-MM-DD HH.mm').format("DD/MM/YYYY HH:mm"));
                        //$("#RemarksL").val(response[i].Remarks);
                        //$("#lastsync").html("Last updated by " + response[i].UpdatedBy + "  " + moment(response[i].UpdatedDate).format("DD/MM/YYYY HH:mm"));


                    }
                    GetUnlockExisiting();
