    function UnlockSet(id, location, idequipment) {
        $.ajax({
            type: 'POST',
            data: {
                id: id,
                location: location,
                WarehouseStaff1: $('#DDStaff1').val(),
                WarehouseStaff2: $('#DDStaff2').val(),
                WarehouseStaff3: $('#DDStaff3').val(),
                DateStatus: ($("#SealDate").val()) ? moment($("#SealDate").val(), "DD/MM/YYYY HH:mm").format("YYYY-MM-DD HH:mm:ss") : "",
                remarks: $('#Remarks').val(),
                idequipment: idequipment
            },
            url: '@Url.Action("UnlockSeal")',
            success: function (response) {
                alert(response);
                document.getElementById("Txt" + id).disabled = true;
                document.getElementById("Btn" + id).disabled = true;
            }
        });
    };

