                if (response > 0) {
                    alert("Gaisok Bro")
                } else {
                    //  document.getElementById("btnSaved").disabled = false;
                    document.getElementById("DDStaff1L").disabled = false;
                    document.getElementById("DDStaff2L").disabled = false;
