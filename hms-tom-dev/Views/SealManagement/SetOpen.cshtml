    function Correction(id)
    {
        var status;
        for (j = 0; j < equipmentLength; j++) {
            if (document.getElementById("Txt" + id).value != document.getElementById("SealNumber" + j).value) {
                status = 1;
                continue;
            } else if ((document.getElementById("Txt" + id).value == document.getElementById("SealNumber" + j).value)) {
                status = 0;
                if (id != j) {
                    document.getElementById("Txt" + j).value = document.getElementById("Txt" + id).value;
                    document.getElementById("Txt" + id).value = null;
                } else {

                    document.getElementById("Txt" + j).value = document.getElementById("Txt" + id).value;
                }

                document.getElementById("SealNumber" + j).type = "text";
                break;

            } else {

                //alert("gaonok boss");
            }
        }

        if (status == 1) {

            $('#ErrMsg').html('<img src="../assets/images/danger.png" alt=""><span>Seal number not found</span>');
            $('#modalwarning').modal('show');
        }
    }

    function GetUnlockExisiting() {
        $.ajax({
            type: 'POST',
            data: {
                id: getUrlParameter('id'),
                location: getUrlParameter('location')
            },
            url: '@Url.Action("getexistingunlock")',
            success: function (response) {
                // equipmentLength = response.length;
                if (response.length != 0) {
                    // $("#DynamicLocation").html("");
                    document.getElementById("DDStaff1").disabled = true;
                    document.getElementById("DDStaff2").disabled = true;
                    document.getElementById("SealDate").disabled = true;
                    document.getElementById("Remarks").disabled = true;
                    document.getElementById("DDStaff3").disabled = true;
                    document.getElementById("Attachment").disabled = true;
                    document.getElementById("btnSubmit").disabled = true;
                    //GenerateDropDownStatus();

                    for (h = 0; h < equipmentLength; h++) {

                        document.getElementById("Txt" + h).disabled = true;

                    }
                    for (i = 0; i < response.length; i++) {
                        for (j = 0; j < equipmentLength; j++) {
                            if (response[i].IDEquipmentType == document.getElementById("IDEquipmentType" + j).value) {
                                document.getElementById("Txt" + j).value = response[i].SealNumber;
                                document.getElementById("IDEquipmentType" + j).visible = false;
                            }
                            if (response[i].WarehouseStaff1 != null) {
                                $("#DDStaff1").val(response[i].WarehouseStaff1.toLowerCase()).trigger('change');
                            }
                            if(response[i].WarehouseStaff2 != null){
                                $("#DDStaff2").val(response[i].WarehouseStaff2.toLowerCase()).trigger('change');
                            }
                            $("#DDStaff3").val(response[i].WarehouseStaff3);

                            $("#SealDate").val(moment(response[i].StatusDateTime).format("DD/MM/YYYY HH:mm"));
                            $("#Remarks").val(response[i].Remarks);
                            $("#lastsyncUnlock").html("*<i>Last updated by " + response[i].UpdatedBy + "  " + moment(response[i].UpdatedDate).format("DD-MMM-YYYY HH:mm") + "</i>");

                        }
                        // options = options + '<option value="' + response[i].FieldValue + '">' + response[i].FieldValue + '</option>';
                    }
                }
            }
        });
    }

