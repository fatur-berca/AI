    function SaveUnlock() {
        var error = "";
        if ($('#DDStaff1').val() == '') {
            error = "Please choose Warehouse Staff - 1";
        }
        if ($("#SealDate").val() == "" || $("#SealDate").val() == null || $("#SealDate").val() == undefined) {
            if (error != "") {
                error += "<br/>";
            }
            error += "Please fill Date Time field";
        }
        if (moment($("#SealDate").val(), "DD/MM/YYYY HH:mm") <= moment($("#SealDateL").val(), "DD/MM/YYYY HH:mm")){
            if (error != "") {
                error += "<br/>";
            }
            error += "Unlock Date must be greater than Lock Date";
        }
        var emptyseal = true;
        for (j = 0; j < equipmentLength; j++) {
            if (emptyseal) {
                if (document.getElementById("Txt" + j).value != "") {
                    emptyseal = false;
                }
            }
        }

        if (emptyseal) {
            if (error != "") {
                error += "<br/>";
            }
            error += "Please fill seal number to be unlocked";
        }
        if (error != "") {
            $('#ErrMsg').html(error);
            $('#modalwarning').modal('show');
            return;
        }
        //var data = $('#newData').serialize();
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        var listdata = [];
        var IDLocation = $("#DDWarehouse").val();
        var SealDate = moment($('#SealDate').val(), 'DD-MM-YYYY HH:mm').format('YYYY-MM-DD HH:mm');

        for (j = 0; j < equipmentLength; j++) {
            listdata[j] = {
                //"IDSealManagement":0,
                "IDLocation": $("#DDWarehouse").val(),
                "StatusDateTime": ($("#SealDate").val()) ? moment($("#SealDate").val(), "DD/MM/YYYY HH:mm").format("YYYY-MM-DD HH:mm:ss") : "",
                "WarehouseStaff1": $('#DDStaff1').val(),
                "WarehouseStaff2": $('#DDStaff2').val(),
                "WarehouseStaff3": $('#DDStaff3').val(),
                "Remarks": $("#Remarks").val(),
                "Status": "Unlocked",
                "IsUnlock" : true,
