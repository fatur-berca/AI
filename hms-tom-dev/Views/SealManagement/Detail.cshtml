<script>
    var dialog = null;
    $(function () {
        $(window).keydown(function (event) {
            if(event.keyCode == 27)
            {
                $('.bootbox.modal').remove();
                $('.modal-backdrop').remove();
            }
        });

        $(document).ajaxStart(function () {
            if (dialog == null)
            {
                dialog = bootbox.dialog({
                    message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                    closeButton: false
                });
            }
        });

        $(document).ajaxStop(function () {
            if (dialog !== null) {
                dialog.modal('hide');
                dialog = null;
            }
        });

        $(document).on('click', '#btnEdit', function () {
            $(this).prop('disabled', true);
            var fields = ['#btnSaved', '#DDStaff1L', '#DDStaff2L', '#DDStaff3L', '#AttachmentL', '#RemarksL', '#DynamicLocation input[id^=SealNumber]'];
            $(fields.join(",")).prop('disabled', false);
        });

        $(document).on('click', '#btnEditUnlocked', function () {
            $(this).prop('disabled', true);
            var fields = ['#btnSubmit', '#DDStaff1', '#DDStaff2', '#DDStaff3', '#DynamicLocationUnlock input[type=text]', '#Attachment', '#Remarks'];
            $(fields.join(",")).prop('disabled', false);
        });
        
        $(document).on('click', '#btnEditAttachL', function () {
            $(this).prop('disabled', true);
            $('#btnSaveAttachL, #AttachmentL').prop('disabled', false);
        });

        $(document).on('click', '#btnEditAttachU', function () {
            $(this).prop('disabled', true);
            $('#btnSaveAttachU, #Attachment').prop('disabled', false);
        });

        $(document).on('click', '#btnSaveAttachU', function () {            
            var fileData = new FormData();
            var fileUpload = $('#Attachment').get(0).files;
            if (fileUpload.length) {
                fileData.append('Status', 'Unlocked');
                fileData.append('IDLocation', $('#DDWarehouse').val());
                fileData.append('SealDate', moment($('#SealDate').val(), 'DD-MM-YYYY HH:mm').format('YYYY-MM-DD HH:mm'));
                fileData.append('File', fileUpload[0]);

                IsEditAttachment = true;
                $.when(UploadAttachment(fileData, fileUpload)).done(function (a1) {
                    $('#btnSaveAttachU').prop("disabled", true);
                    $('#btnEditAttachU').prop("disabled", false);
                    $('#Attachment').next().find('input, span label').css('border-color', '#ccc');
                });
            } else {
                alertPleaseFill();
                $('#Attachment').next().find('input').css('border-color', 'orange');
                $('#Attachment').next().find('span label').css('border-color', 'orange #ccc orange orange');
            }
        });

        $(document).on('click', '#btnSaveAttachL', function () {            
            var fileData = new FormData();
            var fileUpload = $('#AttachmentL').get(0).files;
            if (fileUpload.length) {
                fileData.append('Status', 'Locked');
                fileData.append('IDLocation', $('#DDWarehouseL').val());
                fileData.append('SealDate', moment($('#SealDateL').val(), 'DD-MM-YYYY HH:mm').format('YYYY-MM-DD HH:mm'));
                fileData.append('File', fileUpload[0]);

                IsEditAttachment = true;
                $.when(UploadAttachment(fileData, fileUpload)).done(function (a1) {
                    $('#btnSaveAttachL').prop("disabled", true);
                    $('#btnEditAttachL').prop("disabled", false);
                    $('#AttachmentL').next().find('input, span label').css('border-color', '#ccc');
                });
            } else {
                alertPleaseFill();
                $('#AttachmentL').next().find('input').css('border-color', 'orange');
                $('#AttachmentL').next().find('span label').css('border-color', 'orange #ccc orange orange');
            }
        });
    });

    var IsEditAttachment = false;

    function UploadAttachment(fileData, fileUpload)
    {
        if (fileUpload.length > 0) {
            //fileData.append('IDLocation', $('#DDWarehouse').val());
            //fileData.append('SealDate', moment($('#SealDate').val(), 'DD-MM-YYYY HH:mm').format('YYYY-MM-DD HH:mm'));
            //fileData.append('File', fileUpload[0]);

            //var dialog = bootbox.dialog({
            //    message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            //    closeButton: false
            //});
            return $.ajax({
                url: '@Url.Action("../SealManagement/UploadAttachment")',
                //complete : function() { dialog.modal('hide'); },
                type: 'POST',
                dataType: 'JSON',
                data: fileData,
                cache: false,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (IsEditAttachment) {
                        var message = res.status != 'Success' ? (res.status + '<br>' + res.message) : 'Data has been successfully saved to the database';
                        $('#ErrMsg').html(message);
                        $('#modalwarning').modal('show');
                    }
                    IsEditAttachment = false;
                },
                error: function () {

                }
            });
        }
    }

    var getUrlParameter = function getUrlParameter(sParam) {
        var sPageURL = decodeURIComponent(window.location.search.substring(1)),
            sURLVariables = sPageURL.split('&'),
            sParameterName,
            i;

        for (i = 0; i < sURLVariables.length; i++) {
            sParameterName = sURLVariables[i].split('=');

            if (sParameterName[0] === sParam) {
                return sParameterName[1] === undefined ? true : sParameterName[1];
            }
        }
    };
    var equipmentLength;
    function GenerateDropDownStatus() {
        
        $.ajax({
            type: 'POST',
            
            data: {
                //StatusDate: moment(getUrlParameter('p3')).format("YYYY-MM-DD HH:mm:ss"),
                StatusDate: getUrlParameter('p3'),
                Status: getUrlParameter('p2'),
                location: getUrlParameter('id')
            },

            @*//url: '@Url.Action("getSealLockDetail")',*@
            url: '@Url.Action("GetUnlocksDetail")',
            success: function (response) {
                equipmentLength = response.length;
                if (response.length != 0) {
                    $("#DynamicLocation").html("");
                    for (i = 0; i < response.length; i++) {

                        // options = options + '<option value="' + response[i].FieldValue + '">' + response[i].FieldValue + '</option>';

                        $("#DynamicLocation").append('<tr><td>' + response[i].LocationName + '</td><td><input type ="text" class="form-control" id="SealNumber' + i + '" value="' + response[i].SealNumber + '" disabled="disabled"></td><td hidden><input type ="text" class="form-control" id="IDEquipmentType' + i + '" value="' + response[i].IDEquipmentType + '" disabled="disabled"></td></tr>');
                        $("#DDWarehouse").val(response[i].IDLocation).trigger('change');
                        $("#DDWarehouseL").val(response[i].IDLocation).trigger('change');
                        if (response[i].WarehouseStaff1 != null) {
                            $("#DDStaff1L").val(response[i].WarehouseStaff1.toLowerCase()).trigger('change');
                        }
                        if (response[i].WarehouseStaff2 != null) {
                            $("#DDStaff2L").val(response[i].WarehouseStaff2.toLowerCase()).trigger('change');
                        }
                        $("#DDStaff2L").val(response[i].WarehouseStaff3);
                        $("#SealDateL").val(moment(response[i].StatusDateTime, 'YYYY-MM-DD HH.mm').format("DD/MM/YYYY HH:mm"));
                        $("#RemarksL").val(response[i].Remarks);
                        $("#lastsync").html("*<i>Last updated by " + response[i].UpdatedBy + "  " + moment(response[i].UpdatedDate).format("DD-MMM-YYYY HH:mm") +"</i>");

                    }

                    CheckEditLock();
                }

                //GenerateUnlock();

            }
        });
    }
    function gup(name) {
        name = name.replace(/[\[]/, "\\\[").replace(/[\]]/, "\\\]");
        var regexS = "[\\?&]" + name + "=([^&]*)";
        var regex = new RegExp(regexS);
        var results = regex.exec(window.location.href);
        if (results == null)
            return "";
        else {
            for (i = 0; i < results[1].length; i++) {
                results[1] = results[1].replace("%20", " ");
                results[1] = results[1].replace("%27", "'");
            }
            return results[1];
        }
    }
    $('#PirntDoc').on('click', function (e) {
        var id = (gup('id') != "") ? gup('id') : prevIdLoc,
            status = "Unlocked",//(gup('p2') != "") ? gup('p2') : prevStatus, //status = jQuery("#DDStatus :selected").val(),
            //statusDate = (gup('p3') != "") ? moment(gup('p3')).format("YYYY-MM-DD").replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1") : prevDate.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"), //statusDate = jQuery("#SealDate").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
            statusDate = ($("#SealDate").val()) ? moment($("#SealDate").val(), "DD/MM/YYYY HH:mm").format("YYYY-MM-DD HH:mm:ss") : "",
            getUrl = location.origin;

        // window.location.href = '../SealManagement/GetDocument?strUrl=' + getUrl + '&id=' + $("#DDWarehouse option:selected").val();

        window.location.href = '@Url.Action("GetDocument")' + '?strUrl=' + '' + '&id=' + id + '&status=' + status + '&statusDate=' + statusDate;
        //window.location.href = '../SealManagement/GetDocument?strUrl=' + getUrl + '/&id=' + id + '&status=' + status + '&statusDate=' + statusDate;
    });
    $('#PirntDocL').on('click', function (e) {
        var id = (gup('id') != "") ? gup('id') : prevIdLoc,
            status = "Locked",//(gup('p2') != "") ? gup('p2') : prevStatus, //status = jQuery("#DDStatus :selected").val(),
           // statusDate = (gup('p3') != "") ? moment(gup('p3')).format("YYYY-MM-DD").replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1") : prevDate.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"), //statusDate = jQuery("#SealDate").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1"),
                    statusDate = ($("#SealDateL").val()) ? moment($("#SealDateL").val(), "DD/MM/YYYY HH:mm").format("YYYY-MM-DD HH:mm:ss") : "",
            getUrl = location.origin;

        // window.location.href = '../SealManagement/GetDocument?strUrl=' + getUrl + '&id=' + $("#DDWarehouse option:selected").val();

        window.location.href = '@Url.Action("GetDocument")' + '?strUrl=' + '' + '&id=' + id + '&status=' + status + '&statusDate=' + statusDate;
        //window.location.href = '../SealManagement/GetDocument?strUrl=' + getUrl + '/&id=' + id + '&status=' + status + '&statusDate=' + statusDate;
    });
    generateDetailDropDown();
    function generateDetailDropDown() {
        if (getUrlParameter('p2') == "Unlocked") {
            GenerateUnlock();
            GenerateDropDownStatus();
        } else {
            
            $.ajax({
                type: 'POST',
                
                data: {
                    //StatusDate: moment(getUrlParameter('p3')).format("YYYY-MM-DD HH:mm:ss"),
                    StatusDate: getUrlParameter('p3'),
                    Status: getUrlParameter('p2'),
                    location: getUrlParameter('id')
                },

                url: '@Url.Action("getSealLockDetail")',
                @*url: '@Url.Action("GetUnlocksDetail")',*@
                success: function (response) {
                    equipmentLength = response.length;
                    if (response.length != 0) {
                        $("#DynamicLocation").html("");
                        var ws1;
                        for (i = 0; i < response.length; i++) {

                            // options = options + '<option value="' + response[i].FieldValue + '">' + response[i].FieldValue + '</option>';

                            $("#DynamicLocation").append('<tr><td>' + response[i].LocationName + '</td><td><input type ="text" class="form-control" id="SealNumber' + i + '" value="' + response[i].SealNumber + '" disabled="disabled"></td><td hidden><input type ="text" class="form-control" id="IDEquipmentType' + i + '" value="' + response[i].IDEquipmentType + '" disabled="disabled"></td></tr>');
                            $("#DDWarehouse").val(response[i].IDLocation).trigger('change');
                            $("#DDWarehouseL").val(response[i].IDLocation).trigger('change');
                            $("#SealDateL").val(moment(response[i].StatusDateTime, 'YYYY-MM-DD HH.mm').format("DD/MM/YYYY HH:mm"));
                            $("#RemarksL").val(response[i].Remarks);
                            $("#lastsync").html("*<i>Last updated by " + response[i].UpdatedBy + "  " + moment(response[i].UpdatedDate).format("DD-MMM-YYYY HH:mm") +"</i>");
                            ws1 = response[i].WarehouseStaff1;
                            if (response[i].WarehouseStaff1 != null) {
                                $("#DDStaff1L").val(response[i].WarehouseStaff1.toLowerCase()).trigger('change');
                            }
                            if (response[i].WarehouseStaff2 != null) {
