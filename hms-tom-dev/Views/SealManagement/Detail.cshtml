                    status = 1;
                    continue;
                } else if ((document.getElementById("Txt" + id).value == document.getElementById("SealNumber" + j).value)) {
                    status = 0;
                    if(id != j ){
                        document.getElementById("Txt" + j).value = document.getElementById("Txt" + id).value;
