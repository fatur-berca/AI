                    for (i = 0; i < response.length; i++) {
                        for (j = 0; j < equipmentLength; j++) {
                            if (response[i].IDEquipmentType == document.getElementById("IDEquipmentType" + j).value) {
                                document.getElementById("Txt" + j).value = response[i].SealNumber;
                                document.getElementById("IDEquipmentType" + j).visible = false;
                            }
                            if (response[i].WarehouseStaff1 != null) {
                                $("#DDStaff1").val(response[i].WarehouseStaff1.toLowerCase()).trigger('change');

                            }
                            if (response[i].WarehouseStaff2 != null) {
                                $("#DDStaff2").val(response[i].WarehouseStaff2.toLowerCase()).trigger('change');
                            }
                            $("#DDStaff3").val(response[i].WarehouseStaff3);


                            $("#SealDate").val(moment(response[i].StatusDateTime, 'YYYY-MM-DD HH.mm').format("DD/MM/YYYY HH:mm"));
                            $("#Remarks").val(response[i].Remarks);
                            $("#lastsyncUnlock").html("*<i>Last updated by " + response[i].UpdatedBy + "  " + moment(response[i].UpdatedDate).format("DD-MMM-YYYY HH:mm") + "</i>");

                        }
                        // options = options + '<option value="' + response[i].FieldValue + '">' + response[i].FieldValue + '</option>';



                    }
                    CheckEditUnlocked();

                }

            }
        });

    }

    $('#DDStaff2').on("change", function (e) {

        if ($('#DDStaff2').val() == $('#DDStaff1').val()) {
            $('#ErrMsg').html('<img src="../assets/images/danger.png" alt=""><span>Warehouse staff 1 cannot be same with warehouse staff 2</span>');
            $('#modalwarning').modal('show');

        }
    });

    $('#DDStaff1').on("change", function (e) {

        if ($('#DDStaff2').val() == $('#DDStaff1').val()) {
            $('#ErrMsg').html('<img src="../assets/images/danger.png" alt=""><span>Warehouse staff 1 cannot be same with warehouse staff 2</span>');
            $('#modalwarning').modal('show');

        }
    });

</script>

