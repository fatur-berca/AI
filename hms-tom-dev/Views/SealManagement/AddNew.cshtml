    function CheckSealNumber(i, evt) {
        //var camparingVal = 0;
        var currVal = evt.target.value * 1;//document.getElementById("SealNumber[" + i + "]").value;
        var locName = document.getElementById("SealName[" + i + "]").innerHTML;
        if (evt.keyCode == 13) { // if hit enter
            for (var j = 0; j < maxSealStockLength; j++) {
                if (((currVal) >= (prevSealStockList[j].SealNumberFrom * 1)) && ((currVal) <= (prevSealStockList[j].SealNumberTo * 1))) {
                    validate[j] = true;

                } else {
                    validate[j] = false;
                }
            }

            for (var v = 0; v < equipmentLength; v++) {
                if (document.getElementById("SealNumber[" + v + "]").value != "") {
                    sealNum[v] = document.getElementById("SealNumber[" + v + "]").value;
                }
            }

            var sorted_arr = sealNum.slice().sort();

            for (var z = 0; z < sorted_arr.length - 1; z++) {
                if (sorted_arr[z + 1] == sorted_arr[z]) {
                    resultsSeal.push(sorted_arr[z]);
                }
