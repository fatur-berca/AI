    function ValidateSealNumber(SealNumber, Obj)
    {
        $('#SaveButton').prop("disabled", true);
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        $.ajax({
            complete: function () { dialog.modal('hide'); },
            url:"@Url.Action("CheckSealNumberExistence")",
            data:{
                "idLocation":$('#DDWarehouse').val(),
                "sealNumber":SealNumber
            },
            cache: false,
            success: function(response){
                if(response.Status){
                    bootbox.alert({
                        title: "DFIS Notification Center",
                        message: response.Reason,
                        size: 'small'
                    });
                    Obj.val('');
                } else{
                    if (Object.keys(prevSealStockList).length > 0)
                    {
                        var IsFound = false;
                        for (var idx in prevSealStockList)
                        {
                            if (((SealNumber * 1) >= (prevSealStockList[idx].SealNumberFrom * 1)) && ((SealNumber * 1) <= (prevSealStockList[idx].SealNumberTo * 1))) {
                                IsFound = true;
                                $('#SaveButton').prop("disabled", false);
                                break;
                            }
                        }

                        if (!IsFound)
                        {
                            //$('#SaveButton').prop("disabled", true);
                            bootbox.alert({
                                title: "DFIS Notification Center",
                                message: 'Seal number ' + "'" + SealNumber + "'" + '  not found. Please input seal number based on seal stock data',
                                size: 'small'
                            });

                            Obj.val('');
                        }
                    }
                    else
                    {
                        bootbox.alert({
                            title: "DFIS Notification Center",
                            message: 'Seal stock not found, please input seal stock to continue',
                            size: 'small'
                        });
                    }
