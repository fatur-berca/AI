    var sealNumber = [];
    function generateUpdateData(param) {
        var statusIsUnlocked = false;
        if (param != "") {
            $.ajax({
                url: '@Url.Action("GetDataUpdate")',
                method: 'get',
                cache : false,
                dataType: 'json',
                cache:false,
                data: {
                    "IDLocation": gup('id'),
                    "Type": "firstload",
                    "Status" : gup('p2'),
                    "statusDate" : moment(gup('p3')).format("YYYY-MM-DD")
                },
                success: function (json) {
                    if (json.length == 0) {
                        dialogloading.modal("hide");

                        bootbox.alert({
                            title: "DFIS Notification Center",
                            message: '<img src="../assets/images/danger.png" alt=""><span>Warning : Please return to Seal Management list, unable to load data because of changed <b>Status</b> or <b>Date</b></span>'
                        });
                    }
                    if (json != "") {
                        var username1 = [],
                            username2 = [];

                        for (var i = 0; i < json.length; i++) {
                            username1 = json[i].WarehouseStaff1.split('\\');
                            if (username1.length > 1) {
                                json[i].WarehouseStaff1 = username1[0].toLowerCase() + "\\" + username1[1];
                            }
                            username2 = json[i].WarehouseStaff2.split('\\');
                            if (username2.length > 1) {
                                json[i].WarehouseStaff2 = username2[0].toLowerCase() + "\\" + username2[1];
                            }

                            $('#SealDate').val(moment(Number(json[i].StatusDateTime.match(/\d+/)[0])).format('DD/MM/YYYY HH:mm'));
                            $("#DDWarehouse").select2('data', { id: json[i].IDLocation, text: json[i].IDLocation + ' - ' + json[i].MasterLocation.LocationName });
                            $("#DDStatus option[value=" + json[i].Status + "]").prop("selected", true);
                            $('#DDStaff1').select2('val', json[i].WarehouseStaff1);
                            $('#DDStaff2').select2('val', json[i].WarehouseStaff2);
                            $('#DDStaff3').val(json[i].WarehouseStaff3);
                            $('#Remarks').val(json[i].Remarks);

                            indexPrev[i] = {
                                "IDLocation": json[i].IDLocation,
                                "Status": json[i].Status,
                                "StatusDateTime": moment(json[i].StatusDateTime).format("YYYY-MM-DD"),
                                "WarehouseStaff1": json[i].WarehouseStaff1,
                                "WarehouseStaff2": json[i].WarehouseStaff2,
                                "Remarks": json[i].Remarks,
                                "IDEquipmentType": json[i].IDEquipmentType,
                                "SealNumber": json[i].SealNumber
                            };
                            sealNumber[i] = json[i].SealNumber;
                            // jika salah satu sealnumber ada yg sdah unlocked maka disable semua kolom
                            if (json[i].IsUnlock) {
                                statusIsUnlocked = json[i].IsUnlock;
                                continue;
                            }

                            var createdDate = moment(Number(json[i].CreatedDate.match(/\d+/)[0])).format('DD/MM/YYYY');
                            setBtnEdit(createdDate, json[i].IDLocation);

                            dialogloading.modal("hide");
                        }
                        if (statusIsUnlocked) {
                            $("#EditButton").prop("disabled", true);
                            bootbox.alert({
                                title: "DFIS Notification Center",
                                message: '<img src="../assets/images/danger.png" alt=""><span>Warning : View mode only, one of several seal number is already <b>Unlocked</b></span>'
                            });
                        }
                        GetLocationDataFromWarehouse(sealNumber,'edit');
                    }
                }
            });
        }
    }


