                                className: 'btn btn-primary'
                            }
                        },
                        callback: function (result) {
                            //if (result) {
                            btnClose(i);
                            resultsSeal = [];
                            //}
                        }
                    });
                    return false;
                }

                // Get all focusable elements on the page
                var $canfocus = $(':focusable');
                var index = $canfocus.index(document.activeElement) + 1;
                if (index >= $canfocus.length) index = 0;
                $canfocus.eq(index).focus();
                $('#SaveButton').prop("disabled", false);
                return true;
            } else {
                bootbox.confirm({
                    title: "DFIS Notification Center",
                    //message: '<img src="../assets/images/danger.png" alt=""><span>Seal Number Should be greater than <b>' + prevSealStock[0].SealNumberFrom + '</b> and less than <b>' + prevSealStock[0].SealNumberTo + '</b> for Location / Area <b>' + locName + '</b></span>',
