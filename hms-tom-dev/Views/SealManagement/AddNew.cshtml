            if (validate.indexOf(true) > -1) {

                if (resultsSeal.length > 0) {
                    bootbox.confirm({
                        title: "DFIS Notification Center",
                        message: '<img src="../assets/images/danger.png" alt=""><span>Seal Number already used on other location area</span>',
