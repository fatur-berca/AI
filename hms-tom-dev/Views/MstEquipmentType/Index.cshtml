<div id="Loading" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">DFIS Notification Center</h4>
            </div>
            <div class="modal-body"><img src="assets/images/loading.gif" alt=""><span> Please wait...</span></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var stringIdLoc = "";//digunakan untuk generated name
    var stringType = "";//digunakan untuk generated name
    //var stringJumlah = "";//digunakan untuk generated name
    $(document).ready(function () {
        // BEGIN : GENERAL Logic
   
    });

    $('#addNew').click(function () {
        resetData();
        $('#InsertOrUpdate').val("INSERT");       
        generateDropDownLocation();
        generateDropDownType();
        ////ENABLE INPUT
        //$('#IdLocation').removeAttr('disabled');
        //$('#Type').removeAttr('disabled');
        ////ENABLE INPUT
        //stringIdLoc = "";
        //stringType = "";
        //stringJumlah = "";
        stringIdLoc = "";
        stringType = "";
    });

    $('#inputModal').on('hidden.bs.modal', function () {
        $('#IdLocation').select2("close");
    });

    $("#IdLocation").on('click', function () {
        stringIdLoc = $('#IdLocation :selected').val();
        stringType = $('#Type :selected').val();
        generateList(stringIdLoc, stringType);
        //$('#Name').val(stringIdLoc + '-' + stringType + '-' + stringJumlah);
    });

    //$('#inputModal').modal('hide', function () {
    //    resetData();
    //});

  
    $("#Type").on('click', function () {
        stringIdLoc = $('#IdLocation :selected').val();
        stringType = $('#Type :selected').val();
        generateList(stringIdLoc, stringType);
        //$('#Name').val(stringIdLoc + '-' + stringType + '-' + stringJumlah);
    });
    
    $('#btnSaveYes').click(function () {
        save(false);
        $('#setinactive').modal('hide');
        $('#inputModal').modal('hide');
    });

    $('#btnSaveNew').click(function () {
        if ($('#InsertOrUpdate').val() == "UPDATE") {
            $('#setinactive').modal('show');
        } else {
            save(true);
        }
    });

    function resetData() {
        //generateDropDownLocation();
        //generateDropDownType();
        $('#ExistingList').html('');
        $('#Name').val("");
        $('#Status').val("1");       
        $('#Type').val("");
        $('#IdLocation').select2('val', "");       
        //$('#ExistingList li').remove();
        //$('#IdLocation :selected').val("");
        //$('#Type :selected').val("");
        //$('#ExistingList').html('');
    }
    // END : GENERAL Logic

    //CHECK COUNT UNTUK GENERATED NAME START
    function generateList(idloc, type) {
        var list = $('#ExistingList');
        var active;
        //idloc = $('#IdLocation :selected').val();
        //type = $('#Type :selected').val();
        $.ajax({
            type: 'GET',           
            url: 'MstEquipmentType/GetMasterEquipmentTypeListByIdLocType',
            cache: false,
            data: {idloc:idloc,type:type},
            success: function (data) {
                list.html('');
                $.each(data, function (key, val) {  
                    if (val.IsActive == true) {
                        active = "Active";
                    } else {
                        active = "Inactive";
                    }
                    // list.append('<li value="' + val.Name + '" class="list-group-item"> &#9745; ' + val.Name + ' - '+ active +'</li>');
                    list.append('<li value="' + val.Name + '" >' + val.Name + ' - ' + active + '</li>');

                });
            },
            error: function () {
                list.html('<li value="NULL">none available</li>');
            }
        });
    }

    //CHECK COUNT UNTUK GENERATED NAME END

    // BEGIN : JQUERY SELECT TO DataTable
    generateTable();
    //generate table
    function generateTable() {
        $.ajax({
            url: 'MstEquipmentType/GetMasterEquipmentType',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (json) {
                var table = $('#dtFilterMaster').DataTable({
                    'destroy': true,
                    data: json,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "iDisplayLength": 25,
                    aaSorting: [[5, 'desc']],
                    columns: [  
                        {
                            "data": "IsActive", "class": "text-center", "render": function (data) {
                                if (data == true)
                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                else
                                    return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>';
                            }
                        },
                        {
                            'data': 'MasterLocation.IDLocation', "render": function (data, type, row, meta) {
                                return row['MasterLocation']['IDLocation'] + ' - ' + row['MasterLocation']['LocationName'];
                            } 
                        },
                        { 'data': 'Type', 'searchable': true },
                        { 'data': 'Name', 'searchable': true },
                        {
                            render: function (data, type, row) {
                                var jamtanggal = moment(row['UpdatedDate']).format("DD-MMM-YYYY HH:mm");
                                return 'by ' + row['UpdatedBy'] + ' on ' + jamtanggal;
                            }
                        },
                        { 'data': 'UpdatedDate', 'class': 'hidden' },
                        {
                            "data": "IDEquipmentType", "class": "text-center", "render": function (data) {
                                return '<div ><a href="#" id="editForm" onclick="editTable(' + data + ')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a></div>';
                            }
                        }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 1) && (index < 5)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });
                //searching with column on datatable
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible').search(this.value).draw();
                    });
                });
            }
        });
    }
    // END : JQUERY SELECT TO DataTable

    // BEGIN :JQUERY INSERT DROPDOWN TYPE
    function generateDropDownType(selectedValue) {
        var select1 = $('#Type');
        $.ajax({
            //url: 'MstEquipmentType/GetDropDownType',
            //method: 'get',
            //dataType: 'json',
            //cache: false,
            //success: function (data) {
            //    var select = document.getElementById('Type');
            //    var len = document.getElementById('Type').length;
            //    var option;
            //    if (len > 0)
            //        $('#Type').empty().append('');
            //    for (var i = 0; i < data.length; i++) {
            //        option = document.createElement('option');
            //        option.value = data[i]["FieldValue"];
            //        option.text = data[i]["FieldValue"];
            //        if (option.value == selectedValue)
            //            option.setAttribute("selected", "selected");
            //        select.add(option);
            //    }
            //}

            url: 'MstEquipmentType/GetDropDownType',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                select1.html('');
                select1.html('<option value="NULL"></option>').trigger('change');
                $.each(data,
                    function (kunci, tampung) {
                        if (tampung.FieldValue == selectedValue)
                            select1.append('<option value="' + tampung.FieldValue + '" selected>' + tampung.FieldValue + '</option>');
                        else
                            select1.append('<option value="' + tampung.FieldValue + '">' + tampung.FieldValue + '</option>');
                    });
            },
            error: function () {
                select.html('<option value="NULL">none available</option>');
            }
        });
    }
    // END :JQUERY INSERT DROPDOWN TYPE

    // BEGIN :JQUERY INSERT DROPDOWN Location
    function generateDropDownLocation(selectedValue) {
        var select = $('#IdLocation');
        $.ajax({
            url: 'MstEquipmentType/GetDropDownLocation',
            method: 'get',
            cache : false,
            dataType: 'json',
            success: function (data) {

                //var select = document.getElementById('IdLocation');
                //var len = document.getElementById('IdLocation').length;
                //var option;

                //if (len > 0) {
                //    $('#IdLocation').empty().append('');
                //}
                //for (var i = 0; i < data.length; i++) {
                //    option = document.createElement('option');
                //    option.value = data[i]["IDLocation"];
                //    option.text = data[i]["IDLocation"] + ' - ' + data[i]["LocationName"];
                //    if(option.value == selectedValue)
                //        option.setAttribute("selected", "selected");
                //    select.add(option);
                //}
                select.html('');
                //iterate over the data and append a select option
                select.html('<option value="NULL"></option>').trigger('change');
                $.each(data,
                    function(key, val) {
                        select.append('<option value="' + val.IDLocation + '">' + val.LocationName + ' - ' + val.IDLocation + '</option>');
                    });
                $('#IdLocation').select2('val', selectedValue);
            },
            error:function(){
                //if there is an error append a 'none available' option
                select.html('<option value="NULL">none available</option>');
            }
        });
    }
    // END :JQUERY INSERT DROPDOWN Location

    // BEGIN : Insert New Data
    function save(statusSave) {

        $('#Loading').modal('show');
        var ideqtype = $('#IDEquipmentType').val();
        var idlocation = $('#IdLocation :selected').val();
        var type = $('#Type :selected').val();
        var name = $('#Name').val();
        var status = $('#Status :selected').val() == 1 ? true : false;
        var createddate = $('#CreatedDate').val();
        var createdby = $('#CreatedBy').val();
        var data;
        if (statusSave) {
            data = {
                "new": [{ "IDLocation": idlocation, "Type": type, "Name": name, "IsActive": status }],
                "edit": [{}]
            };
        } else {
            data = {
                "new": [{}],
                "edit": [{ "IDEquipmentType": ideqtype, "IDLocation": idlocation, "Type": type, "Name": name, "IsActive": status, "CreatedDate": createddate, "CreatedBy": createdby }]
            };
        }
        $.ajax({
            type: 'POST',
            url: 'MstEquipmentType/InsertList',
            data: data,
            success: function (result) {
                if (result == "Success"){
                    resetData();
                    //$('#inputModal').modal('hide');
                    $('#Name').val("");
                    generateDropDownLocation();
                    generateDropDownType();
                    //generateList(stringIdLoc, stringType);
                    generateTable();
                    $('#modalsuccess').modal('show');

                    $('#Loading').modal('hide');
                }
                else 
                    $('#modalerror').modal('show');
                $('#Loading').modal('hide');
            }
        });
    }
    // END : Insert New Data
      
    //BEGIN : Edit Data
    function editTable(id) {
        //resetData();
        $('#InsertOrUpdate').val("UPDATE");
     
        ////DISABLED FIELD
        //$('#IdLocation').attr('disabled', 'disabled');
        //$('#Type').attr('disabled', 'disabled');
        ////DISABLED FIELD
        //generateDropDownLocation();
        var table = $('#dtFilterMaster').DataTable();
        $('#dtFilterMaster tbody').one('click', 'tr', function () {
            var data = table.row(this).data();
            $('#IDEquipmentType').val(data["IDEquipmentType"]);
            generateDropDownLocation(data["IDLocation"]);
            generateDropDownType(data["Type"]);
            $('#Name').val(data["Name"]);
            if (data["IsActive"])
                $('#Status').val("1");
            else
                $('#Status').val("0");
            $('#CreatedDate').val(ToJavaScriptDate(data["CreatedDate"]));
            $('#CreatedBy').val(data["CreatedBy"]);
            //stringIdLoc = $('#IdLocation :selected').val();
            //stringType = $('#Type :selected').val();
            generateList(data["IDLocation"], data["Type"]);
        });
       
        $('#inputModal').modal('show');
    }
    // END : Edit Data
    function ToJavaScriptDate(value) {
        var pattern = /Date\(([^)]+)\)/;
        var results = pattern.exec(value);
        var dt = new Date(parseFloat(results[1])).toISOString();
        return dt;
    }
</script>