
@{
    ViewBag.Title = " Master Data > Master Facility > Equipment Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#inputModal">Add New</button>
    </div>
</div>

<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr>            
            <th width=5% nowrap class="text-center">Active</th>
            <th>ID Location</th>
            <th>Type</th>
            <th>Name</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center">Action</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">           
            <th width=5% nowrap class="text-center">Filter</th>
            <th>ID Location</th>
            <th>Type</th>
            <th>Name</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center"></th>
        </tr>
    </thead>
</table>
<!-- Modal -->

<div class="modal fade" id="inputModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Equipment Type</h4>
            </div>
            <div class="modal-body">
                <div id="fieldChooser" tabindex="1" class="field-chooser">
                    <form id="newData">
                        <div class="col-md-6"> 
                            <div class="col-md-12" hidden>
                                <div class="form-group">
                                    <label>CreatedDate</label>
                                    <input type="text" id="CreatedDate" class="form-control datepicker">
                                </div>
                            </div>
                            <div class="col-md-12" hidden>
                                <div class="form-group">
                                    <label>CreatedBy</label>
                                    <input type="text" id="CreatedBy" class="form-control">
                                </div>
                            </div>
                            <div class="col-md-12" hidden>
                                <div class="form-group">
                                    <label>InsertOrUpdate</label>
                                    <input type="text" id="InsertOrUpdate" class="form-control">
                                </div>
                            </div>
                            <div class="col-md-12" hidden>
                                <div class="form-group">
                                    <label>IDEquipmentType</label>
                                    <input type="text" id="IDEquipmentType" class="form-control">
                                </div>
                            </div>
                            <div class="form-group">
                                <label>ID Location</label>
                                <select class="select2" id="IdLocation"></select>
                            </div>
                            <div class="form-group">
                                <label>Type</label>
                                <select class="form-control" id="Type"></select>
                            </div>
                            <div class="form-group">
                                <label>Name</label>
                                <input type="text" class="form-control" id="Name"/>
                            </div>  
                            <div class="form-group">
                                <label>Active</label>
                                <select class="form-control" id="Status">
                                    <option value="1">YES</option>
                                    <option value="0">NO</option>
                                </select>
                            </div>                 
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Existing Value</label>
                                @*<ul id="ExistingList" class="list-group-item" style=" height: 273px;"></ul>*@
                                <ul id="ExistingList" class="list-group-item" style=" height: 272px; overflow-y: scroll"></ul>
                            </div>
                        </div>
                    </form>
