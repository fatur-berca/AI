		var IsSuperUser = session.Role.Where(f => f.RoleName.Equals(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin))).FirstOrDefault() != null;
		var IsContracted = session.Email.Contains("contracted") && !IsSuperUser;

		var isNewRole = false;
		try
		{
			isNewRole = session.Role[0].RoleName.Contains("ADMIN VENDOR TRANSPORT");
		}
		catch
		{

			string baseUrl = Request.Url.GetLeftPart(UriPartial.Authority);
			string redirectUrl = string.Format("{0}/Error/UserNotRegistered", baseUrl);
			Response.Redirect(redirectUrl);

			//string appPath = HttpRuntime.AppDomainAppVirtualPath.Trim('/');
			//Response.Redirect("/" + appPath + "/Error/UserNotRegistered");

