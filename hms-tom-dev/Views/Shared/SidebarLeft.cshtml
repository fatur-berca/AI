<script type="text/javascript">
	$(document).ready(function () {
		var pathArray = window.location.pathname.split('/');
		var lastlevelurl = pathArray[2];

		$('.child collapse').filter(function () {
			return $(this).attr('href') == lastlevelurl
		}).parent().parent().addClass('in');

		$("#BestPracticeToolbox").click(function (event) {
			event.preventDefault();
			callMeBaby();
		});
	});

   

	function callMeBaby() {
		$.ajax({
			type: "get",
			url: '@Url.Action("GetUrl","Home")',
			dataType: 'json',
			success: function (result) {
				window.open(result, '_blank');
			}
		});
	}
</script>
