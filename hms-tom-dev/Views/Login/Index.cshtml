@using hms_tom_dev.Helper
@model hms_tom_dev.Models.Account.UserModel
@{
    ViewBag.Title = "TOM | Login Page";
    Layout = null;
}
<!DOCTYPE html>


<html lang="en">
<head>
    <title>TOM - Login</title>
    <link rel="shortcut icon" href="/Contents/images/favicon/ms-icon-144x144.png" type="image/x-icon" />
    <meta charset="utf-8">
    <meta name="description" content="">
    <meta name="author" content="VTI Indonesia">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-touch-fullscreen" content="yes">
    <!-- Load Style -->
    <link rel="stylesheet" href="@Url.Content("~/assets/css/select2.min.css")" media="screen">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/jquery.dataTables.min.css")" media="screen">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/bootstrap-datetimepicker.min.css")" media="screen">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/jquery-ui.css")" media="screen">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/jquery-filestyle.min.css")" media="screen">
    <link rel="stylesheet" href="@Url.Content("~/assets/css/app.css")" media="screen">
    <!-- Load Scripts -->
    <script type="text/javascript" src="@Url.Content("~/assets/js/jquery-1.12.4.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/jquery-ui.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/main.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/select2.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/jquery.dataTables.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/moment.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/bootstrap-datetimepicker.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/image-editor/jquery-mousewheel.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/image-editor/hammer.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/image-editor/jquery-hammerjs.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/image-editor/imgViewer.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/image-editor/imgNotes.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/jquery.matchHeight-min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/jquery-filestyle.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/assets/js/scripts.js")"></script>
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
        <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>
<body class="login">
    <div class="box text-center">
        <img src="assets/images/logo.png" alt="" style="max-width:100%">
        @using (Html.BeginForm("Index", "Login", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            <div class="form-group">
                @Html.EditorFor(model => model.UserAD, new { htmlAttributes = new { @class = "form-control" }  })
                @*<input type="text" class="form-control">*@
            </div>
            <div class="form-group">
                <input type="submit" class="btn btn-primary" value="Submit" />&nbsp;<b>@ViewBag.Error</b>
            </div>
        }
</div>
</body>
</html>


