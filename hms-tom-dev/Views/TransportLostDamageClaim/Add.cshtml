            form.SJNumber.value = $("#SJNumberHidden").val();
            form.GPNumber.value = $("#GPNumberHidden").val();
        } else {
            form.SJNumber.value = $("#SJNumber").val();
            form.GPNumber.value = $("#GPNumber").val();
        }

        if ($(form).valid()) {
            bootbox.confirm({
                title: "TOM Notification Center",
                size: "small",
                message: "Are you sure want to save the data?",
                buttons: {
                    confirm: {
                        label: 'Save',
                        className: 'btn-primary'
                    },
                    cancel: {
                        label: 'Cancel',
                        className: 'btn-primary'
                    }
                },
                callback: function (result) {
                    if (result) {
                        var dialog = bootbox.dialog({
                            title: "TOM Notification Center",
                            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Saving...</div>',
                            closeButton: false
                        });
                        $.ajax({
                            type: "POST",
                            enctype: "multipart/form-data",
                            url: form.action,
                            cache: false,
                            async: false,
                            data: $(form).serialize(),
                            success: function (data) {
                                if (data.success) {
                                    bootbox.alert({
                                        title: "TOM Notification Center",
                                        message: '<i class="fa fa-check-circle fa-2x" style="color:green"></i><font class="text-success">' + '  ' + data.message + '</font>',
                                        size: 'small',
                                        callback: function () {
                                            $('#saveVerification').prop('disabled', true);
                                            $('#initiation *').prop('disabled', true);
                                            $('#verification *').prop('disabled', true);
                                            $('#progress-Verification').addClass('complete').removeClass('active').removeClass('disabled');
