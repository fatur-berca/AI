@model hms_tom_dev.Models.Transport.TransportLostClaimDamageViewModel

<!-- Modal -->
<div class="modal fade" id="EdituploadFinalResult2" tabindex="-1" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Upload Final Result</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-8">
                        <canvas id="canvasEditFinalResult2" width="500" height="500"></canvas>
                    </div>
                    <div class="col-md-4">
                        <div class="box interactive">
                            <h5>Picture Upload</h5>
                            <input id="fileInputFinalResult2" type="file" class="filestyle" name="" accept="image/*">
                            <hr>
                            <h5>Add/Clear Arrow</h5>
                            <button class="btn btn-primary" id="addMarkerEditFinalResult2">Add</button>
                            <button class="btn btn-purple" id="clearMarkerEditFinalResult2">Clear</button>
                            <hr>
                            <h5>Description</h5>
                            <textarea class="form-control" rows="2" id="descUploadFinalResult2">@Model.RemarkUploadFinalResult2</textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal" id="btnUploadinalResultEdit2">Upload</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal" id="btnClose">Back</button>
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">

    var canvasEditFinalResult2 = new fabric.Canvas('canvasEditFinalResult2');
    @if (!String.IsNullOrEmpty(Model.JsonCanvasFinalResult2))
    {
        <text>
    canvasEditFinalResult2.loadFromDatalessJSON('@Html.Raw(Model.JsonCanvasFinalResult2)');
        </text>
    }else{
        <text>
    if ($("#fileInputFinalResult2").val() == '') {
                $("#btnUploadinalResultEdit2").prop("disabled", true);
                $("#addMarkerEditFinalResult2").prop("disabled", true);
                $("#clearMarkerEditFinalResult2").prop("disabled", true);
                $("#descUploadFinalResult2").prop("disabled", true);
            } else {
                $("#btnUploadinalResultEdit2").prop("disabled", false);
                $("#addMarkerEditFinalResult2").prop("disabled", false);
                $("#clearMarkerEditFinalResult2").prop("disabled", false);
                $("#descUploadFinalResult2").prop("disabled", false);
            }
        </text>
    }

    $('#addMarkerEditFinalResult2').click(function (e) {
        var posX = canvasEditFinalResult2.width / 2;
        var posY = canvasEditFinalResult2.height / 2;

        fabric.Image.fromURL('../assets/images/cursor.png', function (oImg) {
            oImg.set({
                left: posX,
                top: posY
            });
            canvasEditFinalResult2.add(oImg).setActiveObject(oImg);
            canvasEditFinalResult2.renderAll();
        });
    });

    $('#clearMarkerEditFinalResult2').click(function (e) {
        var canvasObjects = canvasEditFinalResult2.getObjects();
        while (canvasObjects.length != 0) {
            canvasEditFinalResult2.remove(canvasObjects[0]);
            canvasEditFinalResult2.discardActiveGroup();
        }
    });

    $("#fileInputFinalResult2").on("change", function (e) {
        var file = e.target.files[0];
        var reader = new FileReader();
        reader.onload = function (f) {
            var data = f.target.result;
            fabric.Image.fromURL(data, function (img) {
                canvasEditFinalResult2.setBackgroundImage(img, canvasEditFinalResult2.renderAll.bind(canvasEditFinalResult2), {
                    width: canvasEditFinalResult2.getWidth(),
                    height: canvasEditFinalResult2.getHeight()
                });
            });
        };
        reader.readAsDataURL(file);
        $("#btnUploadinalResultEdit2").prop("disabled", false);
        $("#addMarkerEditFinalResult2").prop("disabled", false);
        $("#clearMarkerEditFinalResult2").prop("disabled", false);
        $("#descUploadFinalResult2").prop("disabled", false);
    });

    $('#btnUploadinalResultEdit2').click(function (e) {
        var canvas = document.getElementById("canvasEditFinalResult2");
        $("#frontImgFinalResult2").css("background-image", "url('" + canvasEditFinalResult2.toDataURL("image/jpeg") + "')");
    });

</script>



