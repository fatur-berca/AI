                    });

                    $.ajax({
                        type: "POST",
                        enctype: "multipart/form-data",
                        url: '@Url.Action("TestEmptyAction", "TransportLostDamageClaim")',
                        cache: false,
                        async: false,
                        success: function (data) {
                            dialog.modal('hide');
