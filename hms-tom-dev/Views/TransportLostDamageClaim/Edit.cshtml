                            @Html.EditorFor(model => model.Witness, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Witness, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="clearfix"></div>
                    
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Supervisor Name</label>
                            @Html.EditorFor(model => model.Supervisor, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Supervisor, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div id="attachmentDiv" class="form-group">
                            <label class="label-upload">Attachments</label>
                            <a id="removeAttachmentEdit" href="#" class="remove-link" style="display: none;"><i class="fa fa-trash"></i></a>
                            <a id="downloadAttachmentEdit" href="#" class="download-link" style="display: none;"><i class="fa fa-download"></i></a>
                            <input id="Attachment" type="file" name="file" accept="application/pdf"/>
                        </div>
                    </div>
                    <div class="col-md-4">
                        @*<div class="form-group">
                            <label>DN to Reverse Logistics</label>
                            @Html.EditorFor(model => model.DNtoReverseLogistics, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.DNtoReverseLogistics, "", new { @class = "text-danger" })
                        </div>*@
                    </div>

                    <div class="col-md-12">
                        <hr />
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>upload position on truck</label>
                            <ul class="image-point inner">
                                @if (!String.IsNullOrEmpty(Model.ImageUploadPositionTruckPath1))
                                {
                                    <li><a id="frontImgBoxOnTruckEdit1" href="#" data-toggle="modal" data-target="#EdituploadPositionOnTruck1" class="thumbnail" style="background-image: url('@Url.Content(Model.ImageUploadPositionTruckPath1)');"></a></li>
                                }
                                else
                                {
                                    <li><a id="frontImgBoxOnTruckEdit1" href="#" data-toggle="modal" data-target="#EdituploadPositionOnTruck1" class="thumbnail" style="background-image: url('@Url.Content("~/assets/images/no-image.jpg")');"></a></li>
                                }
