                            @Html.HiddenFor(model => model.GPNumberHidden)
                        </div>
                    </div>

                    <div class="clearfix"></div>

                    @*<div class="col-md-4">
                            <div class="form-group">
                                <label>Shipment Date</label>
                                @Html.TextBoxFor(model => model.SJDate, new { @Value = Model.SJDate, @class = "form-control", @disabled = "disabled", @Name = "SJDate" })
                                @Html.HiddenFor(model => model.SJDateHidden)
                            </div>
                        </div>*@
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Transportation Date</label>
                            @Html.TextBoxFor(model => model.DateOfDelivery, new { @Value = Model.DateOfDelivery, @class = "form-control", @disabled = "disabled" })
                            @Html.HiddenFor(model => model.DateOfDeliveryHidden)
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>date of Incident</label>
