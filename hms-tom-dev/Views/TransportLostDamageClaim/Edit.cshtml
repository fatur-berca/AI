                                <button type="button" class="btn btn-primary" id="btnEditInitiation">Edit</button>
                                <button id="printDocEdit" type="button" class="btn btn-primary" disabled="disabled">Print Document</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
