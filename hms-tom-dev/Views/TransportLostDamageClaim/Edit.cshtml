                                }
                                else
                                {
                                    <li><a id="frontImgBoxEdit2" href="#" data-toggle="modal" data-target="#EdituploadBoxCondition2" class="thumbnail" style="background-image: url('@Url.Content("~/assets/images/no-image.jpg")');"></a></li>
                                }
                                
                                @if (!String.IsNullOrEmpty(Model.ImageUploadConditionBoxPath3))
                                {
                                    <li><a id="frontImgBoxEdit3" href="#" data-toggle="modal" data-target="#EdituploadBoxCondition3" class="thumbnail" style="background-image: url('@Url.Content(Model.ImageUploadConditionBoxPath3)');"></a></li>
                                }
                                else
                                {
                                    <li><a id="frontImgBoxEdit3" href="#" data-toggle="modal" data-target="#EdituploadBoxCondition3" class="thumbnail" style="background-image: url('@Url.Content("~/assets/images/no-image.jpg")');"></a></li>
                                }
