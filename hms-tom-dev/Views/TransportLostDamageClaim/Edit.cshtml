@model hms_tom_dev.Models.Transport.TransportLostClaimDamageViewModel

@using EnumHelper = DFIS.Utils.EnumHelper

@using hms_tom_dev.Helper

@{
    ViewBag.Title = "Transport Lost & Damage Claim";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var role = ViewBag.ListCurrRoles;
    
}

<style>
    .input-validation-error {
        border: 1px solid #d9534f !important;
    }

    a.disabled {
        pointer-events: none;
        cursor: default;
    }
</style>

<div class="title-deck wborder">
    <h4 class="title-page pull-left">Edit New Lost & Damage</h4>
</div>

<div class="row">
    <div class="col-md-12">
        <!-- PROGRESS BAR STEP -->
        <div class="row bs-wizard">
            <div id="progress-initiation" class="col-xs-2 bs-wizard-step active">
                <div class="progress"><div class="progress-bar"></div></div>
                <a href="#step-initiation" type="button" class="bs-wizard-dot"></a>
                <div class="text-center bs-wizard-stepnum">Initiation</div>
            </div>

            <div id="progress-Verification" class="col-xs-2 bs-wizard-step disabled">
                <div class="progress"><div class="progress-bar"></div></div>
                <a href="#" class="bs-wizard-dot"></a>
                <div class="text-center bs-wizard-stepnum">Verification</div>
            </div>

            <div id="progress-process" class="col-xs-2 bs-wizard-step disabled">
                <div class="progress"><div class="progress-bar"></div></div>
                <a href="#" class="bs-wizard-dot"></a>
                <div class="text-center bs-wizard-stepnum">Process</div>
            </div>

            <div id="processInvoicing" class="col-xs-2 bs-wizard-step disabled">
                <div class="progress"><div class="progress-bar"></div></div>
                <a href="#" class="bs-wizard-dot"></a>
                <div class="text-center bs-wizard-stepnum">Invoicing</div>
            </div>

            <div id="processDispose" class="col-xs-2 bs-wizard-step disabled">
                <div class="progress"><div class="progress-bar"></div></div>
                <a href="#" class="bs-wizard-dot"></a>
                <div class="text-center bs-wizard-stepnum">Dispose</div>
            </div>

            <div id="processCompleted" class="col-xs-2 bs-wizard-step disabled">
                <div class="progress"><div class="progress-bar"></div></div>
                <a href="#" class="bs-wizard-dot"></a>
                <div class="text-center bs-wizard-stepnum">Completed</div>
            </div>
        </div>
        <!-- Initiation -->
        <a role="button" class="toggle-collapse in-box collapsed" data-toggle="collapse" href="#initiation" aria-expanded="false" aria-controls="initiation">
            Initiation
            <i class="fa fa-angle-up pull-right"></i>
        </a>
        <div id="initiation" class="collapse in" role="tabpanel" aria-labelledby="initiation">
