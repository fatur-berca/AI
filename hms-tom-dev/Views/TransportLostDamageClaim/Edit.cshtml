                    <div class="col-md-8" id="divFACodeBtn">
                        <button type="button" class="btn btn-primary wmb" id="addNewBrand">Add New Brand</button>
                        <button type="button" class="btn btn-danger wmb" id="removeBrand" style="display:none">Remove Brand</button>
                    </div>
                    <div id="divBrand" class="col-md-8">
                        @for (var i = 0; i < Model.ListFACode.Count(); i++)
                        {
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Material Code</label>
                                        @Html.EditorFor(model => model.ListFACode[i].FACode, new { htmlAttributes = new { @class = "form-control inputfacode", @style = "text-transform:uppercase", @onkeypress = "CheckSealNumber(" + i + ", event)" } })
                                        @Html.ValidationMessageFor(model => model.ListFACode[i].FACode, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Material Description</label>
                                        @Html.EditorFor(model => model.ListFACode[i].SpeakingCode, new { htmlAttributes = new { @class = "form-control inputspeakingcode", @style = "text-transform:uppercase" } })
                                        @Html.ValidationMessageFor(model => model.ListFACode[i].SpeakingCode, "", new { @class = "text-danger" })
