                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Order Number/STO</label>
                            @Html.EditorFor(model => model.SJNumber, new { htmlAttributes = new { @class = "form-control", @style = "text-transform:uppercase" } })
                            @Html.ValidationMessageFor(model => model.SJNumber, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.SJNumberHidden)
                        </div>
                    </div>
                    <div class="col-md-4">
