            $('#invoicing *').prop('disabled', true);
            $('#dispose *').prop('disabled', true);

            $('#revokeProcess').prop('disabled', true);
            $('#revokeVerification').prop('disabled', false);

            $('#initiation').collapse('hide');
            $('#verification').collapse('hide');
            $('#process').collapse('show');
            $('#invoicing').collapse('hide');
            $('#dispose').collapse('hide');

            $('#editVerificationBtn').prop('disabled', false);
            $('#editProcessBtn').prop('disabled', true);
            $('#editInvoicingBtn').prop('disabled', true);
            $('#editDisposeBtn').prop('disabled', true);

            $("#removeAttachmentEdit").addClass("disabled");
            //$("#removeMemoFileEdit").addClass("disabled");
        }
        else if ('@(Model.Status)' == "PROCESS")
        {
            setCurrentProcess();

            $('#initiation *').prop('disabled', true);
            $('#verification *').prop('disabled', true);
            $('#process *').prop('disabled', true);

            $('#dispose *').prop('disabled', true);
            $('#invoicing *').prop('disabled', true);
            $('#revokeInvoicing').prop('disabled', true);
            $('#revokeProcess').prop('disabled', false);

            $('#initiation').collapse('hide');
            $('#verification').collapse('hide');

            $('#invoicing').collapse('hide');
            if ($('#HMSMemoNumber').val())
            {
                $('#process').collapse('hide');
                $('#invoicing').collapse('show');
                $('#invoicing *').prop('disabled', false);
            }
            else
            {
                $('#process').collapse('show');
            }
            $('#dispose').collapse('hide');

            $('#editVerificationBtn').prop('disabled', true);
            $('#editProcessBtn').prop('disabled', false);
            $('#editInvoicingBtn').prop('disabled', true);
            $('#editDisposeBtn').prop('disabled', true);

            $("#removeAttachmentEdit").addClass("disabled");
            $("#removeMemoFileEdit").addClass("disabled");
            //$("#removePaymentProofEdit").addClass("disabled");
