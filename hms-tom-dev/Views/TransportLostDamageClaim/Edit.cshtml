        if(claimSelected == "Misshandling" || claimSelected == "Other" || claimSelected == "Product Damage"){
            var options =   '<option value="Wet" label="Wet">Wet</option>' +
                            '<option value="Dented" label="Dented">Dented</option>' +
                            '<option value="Contaminated" label="Contaminated">Contaminated</option>';
            $('.LostOrDamage').html(options);
        } else {
            var options = '<option value="Lost" text="Lost">Lost</option>';
            $('.LostOrDamage').html(options);
        }
        setClaimTypeToForm();
    });

    // auto complete
    var options = {

        url: function (phrase) {
            return "@Url.Action("GetSJNumberAutoComplete", "TransportLostDamageClaim")";
        },

        getValue: function (element) {
            return element;
        },

        ajaxSettings: {
            dataType: "json",
            method: "POST",
            cache: false,
            data: {
                dataType: "json"
            }
        },

        requestDelay: 300,

        preparePostData: function (data) {
            data.phrase = $("#SJNumber").val();
            return data;
        },

        list: {
            maxNumberOfElements: 300,
            match: {
                enabled: true
            },
            onClickEvent: function () {
                var selectedSJNumber = $("#SJNumber").getSelectedItemData();

                $.ajax({
                    url: '@Url.Action("GetAddNewDetail", "TransportLostDamageClaim")',
                    method: 'post',
                    dataType: 'json',
                    cache: false,
                    data: { id: selectedSJNumber.split('/').join(newchar) },
                    success: function (data) {
                        if (data.Success) {
                            $("#GPNumber").val(data.GPNumber); $("#GPNumberHidden").val(data.GPNumber);
                            $("#SJDate").val(data.SJDate); $("#SJDateHidden").val(data.SJDate);
                            $("#OriginWarehouse").val(data.OriginWarehouse); $("#OriginWarehouseHidden").val(data.OriginWarehouse);
                            $("#DestinationWarehouse").val(data.DestinationWarehouse); $("#DestinationWarehouseHidden").val(data.DestinationWarehouse);
                            $("#STONumber").val(data.STONumber); $("#STONumberHidden").val(data.STONumber);
                            $("#DateOfDelivery").val(data.DateOfDelivery); $("#DateOfDeliveryHidden").val(data.DateOfDelivery);
                            $("#TransportationVendor").val(data.TransportationVendorName);//$("#TransportationVendor").val(data.TransportationVendor + " - " + data.TransportationVendorName);
                            $("#TransportationVendorHidden").val(data.TransportationVendor);
                            $("#PoliceRegNumber").val(data.PoliceRegNumber); $("#PoliceRegNumberHidden").val(data.PoliceRegNumber);
                        }
                        else {
                            bootbox.alert({
                                title: "TOM Notification Center",
                                message: '<i class="fa fa-times-circle-o fa-2x" style="color:red"></i><font class="text-danger">' + '  ' + 'Failed ' + data.message + '</font>',
                                size: 'small'
                            });
                            $("#GPNumber").val(""); $("#GPNumberHidden").val("");
                            $("#SJDate").val(""); $("#SJDateHidden").val("");
                            $("#OriginWarehouse").val(""); $("#OriginWarehouseHidden").val("");
                            $("#DestinationWarehouse").val(""); $("#DestinationWarehouseHidden").val("");
                            $("#STONumber").val(""); $("#STONumberHidden").val("");
                            $("#DateOfDelivery").val(""); $("#DateOfDeliveryHidden").val("");
                            $("#TransportationVendor").val("");
                            $("#TransportationVendorHidden").val("");
                            $("#PoliceRegNumber").val(""); $("#PoliceRegNumberHidden").val("");
                        }
                    }
                });
            }
        }
    };

    $("#SJNumber").easyAutocomplete(options);

    $('#SJNumber').bind('change', function () {
        var GPNumber = $("#GPNumber").val();
        var SJNumber = $("#SJNumber").val();
        $.ajax({
            url: '@Url.Action("GetAddNewDetail", "TransportLostDamageClaim")',
            method: 'post',
            dataType: 'json',
            data: { id: SJNumber.split('/').join(newchar) },
            success: function (data) {
                console.log(data);
                if (data.Success) {
                    $("#GPNumber").val(data.GPNumber); $("#GPNumberHidden").val(data.GPNumber);
                    $("#SJDate").val(data.SJDate); $("#SJDateHidden").val(data.SJDate);
                    $("#OriginWarehouse").val(data.OriginWarehouse); $("#OriginWarehouseHidden").val(data.OriginWarehouse);
                    $("#DestinationWarehouse").val(data.DestinationWarehouse); $("#DestinationWarehouseHidden").val(data.DestinationWarehouse);
                    $("#STONumber").val(data.STONumber); $("#STONumberHidden").val(data.STONumber);
                    $("#DateOfDelivery").val(data.DateOfDelivery); $("#DateOfDeliveryHidden").val(data.DateOfDelivery);
                    $("#TransportationVendor").val(data.TransportationVendorName);//$("#TransportationVendor").val(data.TransportationVendor + " - " + data.TransportationVendorName);
                    $("#TransportationVendorHidden").val(data.TransportationVendor);
                    $("#PoliceRegNumber").val(data.PoliceRegNumber); $("#PoliceRegNumberHidden").val(data.PoliceRegNumber);
                }
                else {
                    bootbox.alert({
                        title: "TOM Notification Center",
                        message: '<i class="fa fa-times-circle-o fa-2x" style="color:red"></i><font class="text-danger">' + '  ' + 'Failed ' + data.message + '</font>',
                        size: 'small'
                    });
                    $("#GPNumber").val(""); $("#GPNumberHidden").val("");
                    $("#SJDate").val(""); $("#SJDateHidden").val("");
                    $("#OriginWarehouse").val(""); $("#OriginWarehouseHidden").val("");
                    $("#DestinationWarehouse").val(""); $("#DestinationWarehouseHidden").val("");
                    $("#STONumber").val(""); $("#STONumberHidden").val("");
                    $("#DateOfDelivery").val(""); $("#DateOfDeliveryHidden").val("");
                    $("#TransportationVendor").val("");
                    $("#TransportationVendorHidden").val("");
                    $("#PoliceRegNumber").val(""); $("#PoliceRegNumberHidden").val("");

                    $('#SJNumber').addClass('input-validation-error');
                    $('#SJNumber').removeClass('valid');
                }
            }
        });
    });

    $("#editVerificationBtn").on("click", function () {
        bootbox.confirm({
