                                }
                                else
                                {
                                    <li><a id="frontImgFinalResult1" href="#" data-toggle="modal" data-target="#EdituploadFinalResult1" class="thumbnail" style="background-image: url('@Url.Content("~/assets/images/no-image.jpg")');"></a></li>
                                }

                                @if (!String.IsNullOrEmpty(Model.ImageUploadFinalResultPath2))
                                {
