        //                    '<option value="Contaminated" label="Contaminated">Contaminated</option>';
        //    $('.LostOrDamage').html(options);
        //}

        $("#printDocEdit").on("click", function () {

            var url = '';
            var getUrl = '@(ViewBag.BaseUrl)'; //location.origin;
            if ($("#ClaimType").val() == "Misshandling") {
                var GPNumber = $("#GPNumberHidden").val();
                var SJNumber = $("#SJNumberHidden").val();
                @*url = '@Url.Action("PrintDocument", "TransportLostDamageClaim")?id=' + GPNumber.split('/').join(newchar) + '-' + SJNumber.split('/').join(newchar);*@
                url = '@Url.Action("GetDocument", "TransportLostDamageClaim")?strUrl=' + getUrl + "&id=" + GPNumber.split('/').join(newchar) + '-' + SJNumber.split('/').join(newchar);

            }
            else if ($("#ClaimType").val() == "Other") {
                var GPNumber = $("#GPNumberHidden").val();
                var SJNumber = $("#SJNumberHidden").val();
                @*url = '@Url.Action("PrintDocument", "TransportLostDamageClaim")?id=' + GPNumber.split('/').join(newchar) + '-' + SJNumber.split('/').join(newchar);*@
                url = '@Url.Action("GetDocument", "TransportLostDamageClaim")?strUrl=' + getUrl + "&id=" + GPNumber.split('/').join(newchar) + '-' + SJNumber.split('/').join(newchar);

            }
            else {
                var GPNumber = $("#GPNumber").val();
                var SJNumber = $("#SJNumber").val();
                @*url = '@Url.Action("PrintDocument", "TransportLostDamageClaim")?id=' + GPNumber.split('/').join(newchar) + '-' + SJNumber.split('/').join(newchar);*@
                url = '@Url.Action("GetDocument", "TransportLostDamageClaim")?strUrl=' + getUrl + "&id=" + GPNumber.split('/').join(newchar) + '-' + SJNumber.split('/').join(newchar);
            }

            location.href = url;
        });

        // Check status progress
        if ('@(Model.Status)' == "INITIATION")
        {
            setCurrentInitiation();
            $('#initiation *:not(#btnSaveInitiation)').prop('disabled', false);
            @if (!string.IsNullOrEmpty(Model.Attachment))
            {
                <text>
                //$('#verification *').prop('disabled', true);
                //$("#ClaimExpense").prop('disabled', false);
                //$("#ClaimCategory").prop('disabled', false);
                //$("#saveVerification").prop('disabled', false);
                $('#initiation').collapse('hide');
                $('#verification').collapse('show');
                </text>
            }
            else
            {
                <text>
                $('#verification *').prop('disabled', true);
                $('#initiation').collapse('show');
                $('#verification').collapse('hide');
                </text>
            }

            $('#process *').prop('disabled', true);
            $('#invoicing *').prop('disabled', true);
            $('#dispose *').prop('disabled', true);
            $('#revokeVerification').prop('disabled', true);

            $('#process').collapse('hide');
            $('#invoicing').collapse('hide');
            $('#dispose').collapse('hide');

