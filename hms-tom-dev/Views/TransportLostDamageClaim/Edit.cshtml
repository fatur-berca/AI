                                //$("#InitClaimedAmount").prop('disabled', true);
                                //$('#TotalClaimInPack').prop('disabled', true);
                                //$('#TotalClaimInStick').prop('disabled', true);

                                $("#saveVerification").prop('disabled', false);
                                $("#ClaimExpense").prop('disabled', false);
                                $("#ClaimExpense *").prop('disabled', false);
                                $("#ClaimCategory").prop('disabled', false);
                                $('#editVerificationBtn').prop('disabled', true);
                                $('#revokeVerification').prop('disabled', true);
                            }
                        }
                    });
                }
                $("#TransportationMode").prop('disabled', true);
            }
        });
    });

