        <div id="verification" class="collapse" role="tabpanel" aria-labelledby="verification">
            <div class="col-panel">
                @using (Html.BeginForm("SaveVerification", "TransportLostDamageClaim", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return EditVerification(this)" }))
                {
                   @Html.AntiForgeryToken()  
