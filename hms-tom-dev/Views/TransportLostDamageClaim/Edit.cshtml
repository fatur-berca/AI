                                                        $('#process *').prop('disabled', true);
                                                        $('#dispose *').prop('disabled', true);

                                                        $('#dispose').collapse('hide');

                                                        $('#dispose *').prop('disabled', true);

                                                        $('#revokeDispose').prop('disabled', false);
                                                        $('#editDisposeBtn').prop('disabled', false);

                                                        $('#dispose').collapse('hide');
                                                        $('#process').collapse('hide');
                                                        $('#verification').collapse('hide');
                                                        $('#invoicing').collapse('hide');

                                                        $("#downloadReportFileEdit").css("display", "");
                                                        $("#removeReportFileEdit").css("display", "");
                                                        $("#removeReportFileEdit").css("display", "");
                                                        $("#removeReportFileEdit").addClass("disabled");
