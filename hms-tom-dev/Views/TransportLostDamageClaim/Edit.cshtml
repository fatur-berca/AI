                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Co - Driver</label>
                            @Html.EditorFor(model => model.CoDriver, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.CoDriver, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4">
