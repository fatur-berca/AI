@model hms_tom_dev.Models.Transport.TransportLostClaimDamageViewModel

<!-- Modal -->
<div class="modal fade" id="EdituploadBoxCondition2" tabindex="-1" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Upload Box Condition</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-8">
                        <canvas id="canvasEditBoxCondition2" width="500" height="500"></canvas>
                    </div>
                    <div class="col-md-4">
                        <div class="box interactive">
                            <h5>Picture Upload</h5>
                            <input id="fileInputBoxCondition2" type="file" class="filestyle" name="" accept="image/*">
                            <hr>
                            <h5>Add/Clear Arrow</h5>
                            <button class="btn btn-primary" id="addMarkerEdit2">Add</button>
                            <button class="btn btn-purple" id="clearMarkerEdit2">Clear</button>
                            <hr>
                            <h5>Description</h5>
                            <textarea class="form-control" rows="2" id="descUploadBoxCond2">@Model.RemarkUploadConditionBox2</textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal" id="btnUploadCondBoxEdit2">Upload</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal" id="btnClose">Back</button>
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">

    var canvasEdit2 = new fabric.Canvas('canvasEditBoxCondition2');
    @if (!String.IsNullOrEmpty(Model.JsonCanvasUploadBox2))
    {
        <text>
        canvasEdit2.loadFromDatalessJSON('@Html.Raw(Model.JsonCanvasUploadBox2)');
        </text>
    }else{
        <text>
    if ($("#fileInputBoxCondition2").val() == '') {
                $("#btnUploadCondBoxEdit2").prop("disabled", true);
                $("#addMarkerEdit2").prop("disabled", true);
                $("#clearMarkerEdit2").prop("disabled", true);
                $("#descUploadBoxCond2").prop("disabled", true);
            } else {
                $("#btnUploadCondBoxEdit2").prop("disabled", false);
                $("#addMarkerEdit2").prop("disabled", false);
                $("#clearMarkerEdit2").prop("disabled", false);
                $("#descUploadBoxCond2").prop("disabled", false);
            }
        </text>
    }

    $('#addMarkerEdit2').click(function (e) {
        var posX = canvasEdit2.width / 2;
        var posY = canvasEdit2.height / 2;

        fabric.Image.fromURL('../assets/images/cursor.png', function (oImg) {
            oImg.set({
                left: posX,
                top: posY
            });
            canvasEdit2.add(oImg).setActiveObject(oImg);
            canvasEdit2.renderAll();
        });
    });

    $('#clearMarkerEdit2').click(function (e) {
        var canvasObjects = canvasEdit2.getObjects();
        while (canvasObjects.length != 0) {
            canvasEdit2.remove(canvasObjects[0]);
            canvasEdit2.discardActiveGroup();
        }
    });

    $("#fileInputBoxCondition2").on("change", function (e) {
        var file = e.target.files[0];
        var reader = new FileReader();
        reader.onload = function (f) {
            var data = f.target.result;
            fabric.Image.fromURL(data, function (img) {
                canvasEdit2.setBackgroundImage(img, canvasEdit2.renderAll.bind(canvasEdit2), {
                    width: canvasEdit2.getWidth(),
                    height: canvasEdit2.getHeight()
                });
            });
        };
        reader.readAsDataURL(file);
        $("#btnUploadCondBoxEdit2").prop("disabled", false);
        $("#addMarkerEdit2").prop("disabled", false);
        $("#clearMarkerEdit2").prop("disabled", false);
        $("#descUploadBoxCond2").prop("disabled", false);
    });

    $('#btnUploadCondBoxEdit2').click(function (e) {
        var canvas = document.getElementById("canvasEditBoxCondition2");
        $("#frontImgBoxEdit2").css("background-image", "url('" + canvasEdit2.toDataURL("image/jpeg") + "')");
    });

</script>
