@model hms_tom_dev.Models.Transport.TransportLostClaimDamageViewModel

<!-- Modal -->
<div class="modal fade" id="EdituploadPositionOnTruck3" tabindex="-1" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Upload Position On Truck</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-8">
                        <canvas id="canvasEditPositionOnTruck3" width="500" height="500"></canvas>
                    </div>
                    <div class="col-md-4">
                        <div class="box interactive">
                            <h5>Picture Upload</h5>
                            <input id="fileInputPositionOnTruck3" type="file" class="filestyle" name="" accept="image/*">
                            <hr>
                            <h5>Add/Clear Arrow</h5>
                            <button class="btn btn-primary" id="addMarkerEditPositionOnTruck3">Add</button>
                            <button class="btn btn-purple" id="clearMarkerEditPositionOnTruck3">Clear</button>
                            <hr>
                            <h5>Description</h5>
                            <textarea class="form-control" rows="3" id="descEditUploadPositionOnTruck3">@Model.RemarkUploadPositionTruck3</textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal" id="btnUploadPositionOnTruckEdit3">Upload</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal" id="btnClose">Back</button>
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">

    var canvasEditPositionOnTruck3 = new fabric.Canvas('canvasEditPositionOnTruck3');
    @if (!String.IsNullOrEmpty(Model.JsonCanvasPositionTruck3))
    {
        <text>
     canvasEditPositionOnTruck3.loadFromDatalessJSON('@Html.Raw(Model.JsonCanvasPositionTruck3)');
        </text>
    }else{
        <text>
    if ($("#fileInputPositionOnTruck3").val() == '') {
        $("#btnUploadPositionOnTruckEdit3").prop("disabled", true);
        $("#addMarkerEditPositionOnTruck3").prop("disabled", true);
        $("#clearMarkerEditPositionOnTruck3").prop("disabled", true);
        $("#descEditUploadPositionOnTruck3").prop("disabled", true);
    } else {
        $("#btnUploadPositionOnTruckEdit3").prop("disabled", false);
        $("#addMarkerEditPositionOnTruck3").prop("disabled", false);
        $("#clearMarkerEditPositionOnTruck3").prop("disabled", false);
        $("#descEditUploadPositionOnTruck3").prop("disabled", false);
    }
    </text>
    }

    $('#addMarkerEditPositionOnTruck3').click(function (e) {
        var posX = canvasEditPositionOnTruck3.width / 2;
        var posY = canvasEditPositionOnTruck3.height / 2;

        fabric.Image.fromURL('../assets/images/cursor.png', function (oImg) {
            oImg.set({
                left: posX,
                top: posY
            });
            canvasEditPositionOnTruck3.add(oImg).setActiveObject(oImg);
            canvasEditPositionOnTruck3.renderAll();
        });
    });

    $('#clearMarkerEditPositionOnTruck3').click(function (e) {
        var canvasObjects = canvasEditPositionOnTruck3.getObjects();
        while (canvasObjects.length != 0) {
            canvasEditPositionOnTruck3.remove(canvasObjects[0]);
            canvasEditPositionOnTruck3.discardActiveGroup();
        }
    });

    $("#fileInputPositionOnTruck3").on("change", function (e) {
        var file = e.target.files[0];
        var reader = new FileReader();
        reader.onload = function (f) {
            var data = f.target.result;
            fabric.Image.fromURL(data, function (img) {
                canvasEditPositionOnTruck3.setBackgroundImage(img, canvasEditPositionOnTruck3.renderAll.bind(canvasEditPositionOnTruck3), {
                    width: canvasEditPositionOnTruck3.getWidth(),
                    height: canvasEditPositionOnTruck3.getHeight()
                });
            });
        };
        reader.readAsDataURL(file);
        $("#btnUploadPositionOnTruckEdit3").prop("disabled", false);
        $("#addMarkerEditPositionOnTruck3").prop("disabled", false);
        $("#clearMarkerEditPositionOnTruck3").prop("disabled", false);
        $("#descEditUploadPositionOnTruck3").prop("disabled", false);
    });

    $('#btnUploadPositionOnTruckEdit3').click(function (e) {
        var canvas = document.getElementById("canvasEditPositionOnTruck3");
        $("#frontImgBoxOnTruckEdit3").css("background-image", "url('" + canvasEditPositionOnTruck3.toDataURL("image/jpeg") + "')");
    });

</script>


