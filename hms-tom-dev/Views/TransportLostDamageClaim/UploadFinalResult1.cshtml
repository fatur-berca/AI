@model hms_tom_dev.Models.Transport.TransportLostClaimDamageViewModel

<!-- Modal -->
<div class="modal fade" id="uploadFinalResult1" tabindex="-1" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Upload Final Result</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-7">
                        <canvas id="canvasFinalResult1" width="500" height="500"></canvas>
                    </div>
                    <div class="col-md-5">
                        <div class="box interactive">
                            <h5>Picture Upload</h5>
                            <input id="fileInputFinalResult1" type="file" class="filestyle" name="" accept=".jpg">
                            <hr>
                            <h5>Add/Clear Arrow</h5>
                            <button class="btn btn-primary" id="addMarkerFinalResult1">Add</button>
                            <button class="btn btn-purple" id="clearMarkerFinalResult1">Clear All</button>
                            <hr>
                            <h5>Description</h5>
                            <textarea class="form-control" rows="2" id="descFinalResult1"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal" id="btnUploadFinalResult1">Upload</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal" id="btnClose">Back</button>
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">

    if ($("#fileInputFinalResult1").val() == '') {
        $("#btnUploadFinalResult1").prop("disabled", true);
        $("#addMarkerFinalResult1").prop("disabled", true);
        $("#clearMarkerFinalResult1").prop("disabled", true);
        $("#descFinalResult1").prop("disabled", true);
    } else {
        $("#btnUploadFinalResult1").prop("disabled", false);
        $("#addMarkerFinalResult1").prop("disabled", false);
        $("#clearMarkerFinalResult1").prop("disabled", false);
        $("#descFinalResult1").prop("disabled", false);
    }

    var canvasFinalResult1 = new fabric.Canvas('canvasFinalResult1');
    //canvas.setBackgroundImage('../assets/images/no-image.jpg', canvas.renderAll.bind(canvas), {
    //    width: canvas.width,
    //    height: canvas.height,
    //    originX: 'left',
    //    originY: 'top'
    //});

    $('#addMarkerFinalResult1').click(function (e) {
        var posX = canvasFinalResult1.width / 2; //* Math.random();
        var posY = canvasFinalResult1.height / 2; //* Math.random();

        fabric.Image.fromURL('../assets/images/cursor.png', function (oImg) {
            oImg.set({
                left: posX,
                top: posY
            });
            canvasFinalResult1.add(oImg).setActiveObject(oImg);
            canvasFinalResult1.renderAll();
        });
    });

    $('#clearMarkerFinalResult1').click(function (e) {
        var canvasObjects = canvasFinalResult1.getObjects();
        while (canvasObjects.length != 0) {
            canvasFinalResult1.remove(canvasObjects[0]);
            canvasFinalResult1.discardActiveGroup();
        }
    });

    $("#fileInputFinalResult1").on("change", function (e) {
        var file = e.target.files[0];
        var reader = new FileReader();
        reader.onload = function (f) {
            var data = f.target.result;
            fabric.Image.fromURL(data, function (img) {
                canvasFinalResult1.setBackgroundImage(img, canvasFinalResult1.renderAll.bind(canvasFinalResult1), {
                    width: canvasFinalResult1.getWidth(),
                    height: canvasFinalResult1.getHeight()
                });
            });
        };
        reader.readAsDataURL(file);
        $("#btnUploadFinalResult1").prop("disabled", false);
        $("#addMarkerFinalResult1").prop("disabled", false);
        $("#clearMarkerFinalResult1").prop("disabled", false);
        $("#descFinalResult1").prop("disabled", false);
    });

    $('#btnUploadFinalResult1').click(function (e) {
        var canvas = document.getElementById("canvasFinalResult1");
        $("#frontFinalResult1").css("background-image", "url('" + canvas.toDataURL("image/jpeg") + "')");
    });

</script>