@using hms_tom_dev.Helper
@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "Transport Lost & Damage Claim";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
    bool isSuperUser = false;
}

@foreach (var x in listUserRole)
{
    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
    {
        isSuperUser = true;
        break;
    }
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.AddNew)) && ViewBag.PageAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.PageName.TransportLostDamageClaim)))
        {
            <button class="btn btn-primary" onclick="location.href='@Url.Action("Add", "TransportLostDamageClaim")'">Add New</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Upload)) && ViewBag.PageAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.PageName.TransportLostDamageClaim)))
        {
            <button class="btn btn-primary" data-toggle="modal" data-target="#inputModal">Upload</button>
        }
        @*<button id="btnUpload" class="btn btn-primary" data-toggle="modal" data-target="#inputModal">Upload</button>*@

        <button class="btn btn-primary" id="btnSetInactive" type="button" onclick="SetIsActive('Delete')">Delete</button>
        <button class="btn btn-primary" id="btnExportExcel">Export</button>
        <button class="btn btn-primary" data-toggle="modal" data-target="#customReportModal" id="customReportButton">Custom Report</button>
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Recovery)))
        { 
            <button class="btn btn-primary" id="btnSetActive" type="button" onclick="SetIsActive('Recovery')">Recovery</button>
        }
        
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="inputModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Upload Lost & Claim Damage (Process/Invoice/Dispose)</h4>
            </div>
            <div class="col-md-12">
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Upload Template</label>
                            <input type="file" id="Upload" class="filestyle" accept=".xls, .xlsx">
                            <a href="#" id="DownloadTemplateProcess">Download Template Process</a> <br />
                            <a href="#" id="DownloadTemplateInvoicing">Download Template Invoicing</a> <br />
                            <a href="#" id="DownloadTemplateDispose">Download Template Dispose</a> <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnSaveNew">Upload</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Custom Report Modal Dialog -->
