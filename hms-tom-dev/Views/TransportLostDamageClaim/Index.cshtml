            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        window.location.assign("Assets/Download/TemplateExcel/TranspostLostClaimDamageTemplateDispose.xlsx");
        dialog.modal('hide');
    });

    //$("#btnUpload").click(function () {
    //    $("Upload").val('');
    //});

    $("#btnSaveNew").click(function () {
        var dialog = bootbox.dialog({
            title: "TOM Notification Center",
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        if ($("#Upload").val() == '') {
            dialog.modal('hide');
            $('#ErrMsg').html("Please Upload File First !");
            $('#modalerror').modal('show');

        } else if ($("#Upload").val() == null)
        {
            dialog.modal('hide');
            $('#ErrMsg').html("Please Upload File First !");
            $('#modalerror').modal('show');
        } else {
            if (window.FormData !== undefined) {

                var fileData = new FormData();
                var fileUpload = document.getElementById('Upload').files;

                if(fileUpload.length > 0){
                    fileUpload = fileUpload[0];
                    fileData.append('FileUpload', fileUpload);
                } else{
                    $('#textModalWarning').html('No file to be uploaded');
                    $('#warningModal').modal('show');
                    return;
                }

                $.ajax({
                    type        : 'POST',
                    url         : 'TransportLostDamageClaim/UploadTransport',
                    dataType    : 'JSON',
                    data        : fileData,
                    cache       : false,
                    contentType : false,
                    processData : false,
                    success     : function (res) {
                        if(res == "No Access"){
                            dialog.modal('hide');
                            $('#notificationModal').modal('show');
                            $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span> User is not Authorized!</span>');
                            $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                        }
                        else if(res.split("-")[0] == "Data error in rows "){
                            dialog.modal('hide');
                            $('#notificationModal').modal('show');
                            $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span>'+res+'</span>');
                            $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                        }
                        else if (res == "No Update") {
                            $('#notificationModal').modal('show');
                            $('#notificationModal .modal-body').html('<img src="assets/images/checked.png" alt=""><span> No data updated!</span>');
                            $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                            dialog.modal('hide');
                        }
                        else if(res == "No Sheet"){
                            dialog.modal('hide');
                            $('#notificationModal').modal('show');
                            $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span> Wrong File!</span>');
                            $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                        }
                        else if(res == "Empty" || res == "Kosong"){
                            dialog.modal('hide');
                            $('#notificationModal').modal('show');
                            $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span> No Data!</span>');
                            $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                        }
                        else{
                            dialog.modal('hide');
                            $('#notificationModal').modal('show');
                            $('#notificationModal .modal-body').html('<img src="assets/images/checked.png" alt=""><span> '+res+' data have been succesfully updated! </span>');
                            $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                        }

                        $("#Upload").val('');
                        //generateGridLostClaimDefault();
                        generateGridLostClaim();
                    },
                    error: function () {
                        $('#notificationModal').modal('show');
                        $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span> Failed!</span>');
                        $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                        dialog.modal('hide');
                    }
                });

            } else {
                alert("FormData is not supported.");
            }
        }
    });

