    function ExportExcel(){

        var dateReceiptFrom = $("#dateReceiptFrom").val();
        var dateReceiptTo = $("#dateReceiptTo").val();
        var origWH = $("#DropDownOriginWarehouse").val() == null ? $("#DropDownOriginWarehouse").val() : $("#DropDownOriginWarehouse").val().toString();
