        var delvNote = $("#DropDownDeliveryNoteNumber").val() == null ? $("#DropDownDeliveryNoteNumber").val() : $("#DropDownDeliveryNoteNumber").val().toString();
        var polReg = $("#DropDownPoliceRegNumber").val()  == null ? $("#DropDownPoliceRegNumber").val() : $("#DropDownPoliceRegNumber").val().toString();
        var vendor = $('#DropDownVendor').find(":selected").text();

        $.ajax({
            url: 'TransportLostDamageClaim/ExportToExcel',
            method: 'post',
            dataType: 'json',
            data: {
                "DateReceiptFrom": dateReceiptFrom,
                "DateReceiptTo": dateReceiptTo,
                "OriginWarehouse": origWH,
                "DestinationWarehouse": desWH,
                "STONumber": sto,
                "DeliveryNoteNumber": delvNote,
