                        <div data-field="GrossLossAmount">Gross Loss Amount</div>
                        <div data-field="NetClaim">Net Claim (IDR)</div>
                        <div data-field="InsurancePaymentProof">Insurance Payment Proof</div>
                        <div data-field="EDPSNumber">eDPS Number</div>
                        <div data-field="EDPSDate">eDPS Date</div>
