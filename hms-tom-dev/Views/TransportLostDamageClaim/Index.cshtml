                        <div data-field="MaterialDescription">Material Description</div>
                        <div data-field="Category">Category</div>
                        <div data-field="Pack">Pack</div>
                        <div data-field="Remark">Remark</div>
                        <div data-field="GoodsCategory">Goods Category</div>
                        <div data-field="InitClaimedAmount">Initial Claimed Amount (IDR)</div>
                        <div data-field="ClaimCategory">Claim Category</div>
                        <div data-field="TotalClaimInPack">Total Claim In Pack</div>
                        <div data-field="TotalClaimInStick">Total Claim In Stick</div>
                        <div data-field="BSWarehouseReceiveDate">BS Warehouse Receive Date</div>
