<script type="text/javascript">
    function resetSearch() {
        var d = new Date();;
        d.setDate(d.getDate()-7);
        var dm = d.getMonth() + 1;
        $("#DropDownOriginWarehouse").select2("val", "");
        $("#DropDownDestinationWarehouse").select2("val", "");
        $("#DropDownSTONumber").val("");
        // $("#stoNumberInput").val("");
        $("#DropDownDeliveryNoteNumber").select2("val", "");
        $("#DropDownPoliceRegNumber").select2("val", "");
        $("#DropDownVendor").select2("val", "");
        $("#all").prop('checked',true);
        $("#dateReceiptFrom").val('');
        $("#dateReceiptTo").val('');
        //$("#dateReceiptFrom").val(new Date().getDate() - 7  + "/" + ((new Date().getMonth() + 1) < 10 ? '0' : '') + (new Date().getMonth() +1) + "/" + new Date().getFullYear());
        $("#dateReceiptFrom").val(d.getDate()  + "/" + ("0" + dm).slice(-2) + "/" + new Date().getFullYear());
        $("#dateReceiptTo").val(new Date().getDate()  + "/" + ((new Date().getMonth() + 1) < 10 ? '0' : '') + (new Date().getMonth() +1) + "/" + new Date().getFullYear());
        generateGridLostClaim();
        //generateGridLostClaimDefault();
    }

    // $( "#dateReceiptFrom" ).datepicker({ defaultDate: -7 });
    // $( "#dateReceiptTo" ).datepicker({ defaultDate: new Date() });

    var d = new Date();;
    d.setDate(d.getDate()-7);
    var dm = d.getMonth() + 1;
    //$("#dateReceiptFrom").val(d.getDate());
    //$("#dateReceiptFrom").val(new Date().getDate() - 7  + "/" + ((new Date().getMonth() + 1) < 10 ? '0' : '') + (new Date().getMonth() +1) + "/" + new Date().getFullYear());
    $("#dateReceiptFrom").val(d.getDate()  + "/" + ("0" + dm).slice(-2) + "/" + new Date().getFullYear());
    $("#dateReceiptTo").val(new Date().getDate()  + "/" + ((new Date().getMonth() + 1) < 10 ? '0' : '') + (new Date().getMonth() +1) + "/" + new Date().getFullYear());

    $(document).ready(function() {
        $("#all").prop('checked',true);
        $("#fieldChooser").fieldChooser($("#sourceFields"), $("#destinationFields"));

        $(document).on('click', '#saveLayoutButton', function(e) {
            saveLayout();
            e.preventDefault();
        })

        //$(document).on('click', '#exportbutton', function(e) {
        //    exporttoexceldefault();
        //    e.preventdefault();
        //});

        $('#inputModal').on('hidden.bs.modal', function () {
            $('#Warehouse').select2("close");
            $('#Warehouse').select2("val", "null");

        });

        $(document).on('click', '#left', function(e) {
            moveItems('#destinationFields', '#sourceFields');
            e.preventDefault();
        });

        $(document).on('click', '#right', function(e) {
            moveItems('#sourceFields', '#destinationFields');
            e.preventDefault();
        });

        $(document).on('click', '#leftall', function(e) {
            moveAllItems('#destinationFields', '#sourceFields');
            e.preventDefault();
        });

        $(document).on('click', '#rightall', function(e) {
            moveAllItems('#sourceFields', '#destinationFields');
            e.preventDefault();
        });

        $(document).on('click', '#customReportButton', function (e) {
            $('#chkGlobalCustomReport').prop('checked', false);
            $("#layoutName").val('');
            generateLayoutSelect();
            e.preventDefault();
        });

        $('#layoutSelect').on('change', function() {
            for (var j = 1; j < layoutIsGlobal.length; j++) {
                if ($('#layoutSelect option:selected').text() == layoutIsGlobal[j].LayoutName) {
                    $('#chkGlobalCustomReport').prop('checked', layoutIsGlobal[j].isGlobal);
                    //console.log(layoutIsGlobal[j].isGlobal);
                }
            }
            var sourceFieldNames = [
                //{ 'field': 'SJDate', 'label': 'Date of Receipt' },
                { 'field': 'OriginWarehouse', 'label': 'Origin' },
                { 'field': 'DestinationWarehouse', 'label': 'Destination' },
                { 'field': 'STONumber', 'label': 'Order Number/STO' },
                { 'field': 'DeliveryNumberNote', 'label': 'DN Number' },
                { 'field': 'PoliceRegNumber', 'label': 'Police Reg. Number' },
                { 'field': 'TransportationVendor', 'label': 'Vendor Name' },
                { 'field': 'GPNumber', 'label': 'Transportation Number' },
                //{ 'field': 'SJNumber', 'label': 'SJNumber' },
                { 'field': 'Status', 'label': 'Status' },
                { 'field': 'ClaimType', 'label': 'Claim Type' },
                { 'field': 'DateOfDelivery', 'label': 'Delivery Date' },
                { 'field': 'DateOfIncident', 'label': 'Incident Date' },
                { 'field': 'Driver1', 'label': 'Driver 1' },
                { 'field': 'Driver2', 'label': 'Driver 2' },
                { 'field': 'CoDriver', 'label': 'CoDriver' },
                { 'field': 'Receiver', 'label': 'Receiver' },
                { 'field': 'Witness', 'label': 'Witness' },
                { 'field': 'ClaimExpense', 'label': 'Claim Expense' },
                { 'field': 'Supervisor', 'label': 'Supervisor' },
                { 'field': 'TransportationMode', 'label': 'Transportation Mode' },
                { 'field': 'Attachment', 'label': 'Attachment' },
                { 'field': 'MaterialCode', 'label': 'Material Code' },
                { 'field': 'MaterialDescription', 'label': 'Material Description' },
                { 'field': 'Category', 'label': 'Category' },
                { 'field': 'Pack', 'label': 'Pack' },
                { 'field': 'Remark', 'label': 'Remark' },
                { 'field': 'GoodsCategory', 'label': 'Goods Category' },
                { 'field': 'InitClaimedAmount', 'label': 'Initial Claimed Amount (IDR)' },
                { 'field': 'ClaimCategory', 'label': 'Claim Category' },
                { 'field': 'TotalClaimInPack', 'label': 'Total Claim In Pack' },
                { 'field': 'TotalClaimInStick', 'label': 'Total Claim In Stick' },
                { 'field': 'BSWarehouseReceiveDate', 'label': 'BS Warehouse Receive Date' },
                { 'field': 'HMSMemoNumber', 'label': 'HMS Memo Number' },
                { 'field': 'HMSMemoDate', 'label': 'HMS Memo Date' },
                { 'field': 'HMSMemoFile', 'label': 'HMS Memo File' },
                { 'field': 'InvoiceNumber', 'label': 'Invoice Number' },
                { 'field': 'InvoiceDate', 'label': 'Invoice Date' },
                { 'field': 'InvoiceAmount', 'label': 'Invoice Amount' },
                { 'field': 'VendorPaymentDate', 'label': 'Vendor Payment Date' },
                { 'field': 'GrossLossAmount', 'label': 'Gross Loss Amount' },
                { 'field': 'NetClaim', 'label': 'Net Claim (IDR)' },
                { 'field': 'InsurancePaymentProof', 'label': 'Insurance Payment Proof' },
                { 'field': 'EDPSNumber', 'label': 'eDPS Number' },
                { 'field': 'EDPSDate', 'label': 'eDPS Date' },
                { 'field': 'IncinerationReportDate', 'label': 'Incineration Report Date' },
                { 'field': 'IncinerationReportFile', 'label': 'Incineration Report File' },
                { 'field': 'Remarks', 'label': 'Remarks' }
            ],
                sourceFields = '',
                destinationFieldNames = this.value.split(','),
                destinationFields = '',
                destinationfieldLabels = [];
            var i;
            for (i = 0; i < sourceFieldNames.length; ++i) {
                if (jQuery.inArray(sourceFieldNames[i]['field'], destinationFieldNames) == -1) {
                    // the element is not in the array
                    sourceFields = sourceFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + sourceFieldNames[i]['field'] + "'>" + sourceFieldNames[i]['label'] + "</div>";
                } else {
                    destinationfieldLabels[sourceFieldNames[i]['field']] = sourceFieldNames[i]['label'];
                }
            }
            $("#fieldChooser #sourceFields").html(sourceFields);

            for (i = 0; i < destinationFieldNames.length; ++i) {
                destinationFields = destinationFields + "<div class='fc-field ui-sortable-handle' tabindex='1' data-field='" + destinationFieldNames[i] + "'>" + destinationfieldLabels[destinationFieldNames[i]] + "</div>";
            }
            $("#fieldChooser #destinationFields").html(destinationFields);
        });
