        var dialog = bootbox.dialog({
            title: "TOM Notification Center",
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        window.location.assign("Assets/Download/TemplateExcel/TranspostLostClaimDamageTemplateProcess.xlsx");
        dialog.modal('hide');
    });
    $("#DownloadTemplateInvoicing").click(function () {
        var dialog = bootbox.dialog({
            title: "TOM Notification Center",
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        window.location.assign("Assets/Download/TemplateExcel/TranspostLostClaimDamageTemplateInvoicing.xlsx");
