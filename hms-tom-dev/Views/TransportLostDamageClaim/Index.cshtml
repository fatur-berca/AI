</div>

<div class="filter-deck nmb">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel wmb wbt">
            <div class="col-md-6">
                <div class="form-group">
                        <label>Date of Incident</label>
                    <div class="row">
                        <div class="col-md-5">
                            <input id="dateReceiptFrom" type="text" name="" class="form-control datepicker">
                        </div>
                        <div class="col-md-2 to-bi">
                            <label>To</label>
                        </div>
                        <div class="col-md-5">
                            <input id="dateReceiptTo" type="text" name="" class="form-control datepicker">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DropDownOriginWarehouse">Sender</label>
                    <select id="DropDownOriginWarehouse" class="select2" multiple="multiple">
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DropDownDestinationWarehouse">Receiver</label>
                    <select id="DropDownDestinationWarehouse" class="select2" multiple="multiple"></select>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DropDownSTONumber">Order Number / STO</label>
                    <input type="hidden" style="width:250px" id="DropDownSTONumber" />
                        @* <select id="DropDownSTONumber" class="select2" multiple="multiple"></select> *@
                        @* <input id="stoNumberInput" type="text" class="form-control" data-role="tagsinput" /> *@
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DropDownDeliveryNoteNumber">Delivery Note Number</label>
                    <select id="DropDownDeliveryNoteNumber" class="select2" multiple="multiple"></select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DropDownPoliceRegNumber">Police Reg. Number</label>
                    <select id="DropDownPoliceRegNumber" class="select2" multiple="multiple"></select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DropDownVendor">Vendor</label>
                    <select id="DropDownVendor" class="select2" multiple="multiple"></select>
                </div>
            </div>
            @*<div class="clearfix"></div>
            <div class="col-md-3">
                <div class="form-group">
                    <div class="checkbox-deck">
                        <input type="checkbox" id="chkInactive">
                        <label for="chkInactive"></label>
                    </div>
                    <span class="checkbox-deck-span">Include deleted data</span>
                </div>
            </div>*@
            @if (isSuperUser)
            {
                <div class="clearfix"></div>
                <div class="col-sm-4">
                    <div class="form-group">

                        <label for="input-type">Active</label>
                        <div id="input-type" class="row">
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" id="all" value="1" type="radio" checked/>All
                                </label>
                            </div>
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" id="deleted" value="0" type="radio" /> Deleted
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="col-md-12">
                <button class="btn btn-primary" id="btnSearch">Search</button>
                <button class="btn btn-purple" onclick="resetSearch()">Reset</button>
            </div>
        </div>
    </div>
</div>

