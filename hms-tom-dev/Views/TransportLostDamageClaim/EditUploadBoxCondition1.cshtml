@model hms_tom_dev.Models.Transport.TransportLostClaimDamageViewModel

<!-- Modal -->
<div class="modal fade" id="EdituploadBoxCondition1" tabindex="-1" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Upload Box Condition</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-8">
                        <canvas id="canvasEditBoxCondition1" width="500" height="500"></canvas>
                    </div>
                    <div class="col-md-4">
                        <div class="box interactive">
                            <h5>Picture Upload</h5>
                            <input id="fileInputBoxCondition1" type="file" class="filestyle" name="" accept="image/*">
                            <hr>
                            <h5>Add/Clear Arrow</h5>
                            <button class="btn btn-primary" id="addMarkerEdit1">Add</button>
                            <button class="btn btn-purple" id="clearMarkerEdit1">Clear</button>
                            <hr>
                            <h5>Description</h5>
                            <textarea class="form-control" rows="2" id="descUploadBoxCond1">@Model.RemarkUploadConditionBox1</textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal" id="btnUploadCondBoxEdit1">Upload</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal" id="btnClose">Back</button>
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">

    var canvasEdit1 = new fabric.Canvas('canvasEditBoxCondition1');
    @if (!String.IsNullOrEmpty(Model.JsonCanvasUploadBox1))
    {
        <text>
        canvasEdit1.loadFromDatalessJSON('@Html.Raw(Model.JsonCanvasUploadBox1)');
        </text>
    }else{
        <text>
    if ($("#fileInputBoxCondition1").val() == '') {
                $("#btnUploadCondBoxEdit1").prop("disabled", true);
                $("#addMarkerEdit1").prop("disabled", true);
                $("#clearMarkerEdit1").prop("disabled", true);
                $("#descUploadBoxCond1").prop("disabled", true);
            } else {
                $("#btnUploadCondBoxEdit1").prop("disabled", false);
                $("#addMarkerEdit1").prop("disabled", false);
                $("#clearMarkerEdit1").prop("disabled", false);
                $("#descUploadBoxCond1").prop("disabled", false);
            }
        </text>
    }

    $('#addMarkerEdit1').click(function (e) {
        var posX = canvasEdit1.width / 2;
        var posY = canvasEdit1.height / 2;

        fabric.Image.fromURL('../assets/images/cursor.png', function (oImg) {
            oImg.set({
                left: posX,
                top: posY
            });
            canvasEdit1.add(oImg).setActiveObject(oImg);
            canvasEdit1.renderAll();
        });
    });

    $('#clearMarkerEdit1').click(function (e) {
        var canvasObjects = canvasEdit1.getObjects();
        while (canvasObjects.length != 0) {
            canvasEdit1.remove(canvasObjects[0]);
            canvasEdit1.discardActiveGroup();
        }
    });

    $("#fileInputBoxCondition1").on("change", function (e) {
        var file = e.target.files[0];
        var reader = new FileReader();
        reader.onload = function (f) {
            var data = f.target.result;
            fabric.Image.fromURL(data, function (img) {
                canvasEdit1.setBackgroundImage(img, canvasEdit1.renderAll.bind(canvasEdit1), {
                    width: canvasEdit1.getWidth(),
                    height: canvasEdit1.getHeight()
                });
            });
        };
        reader.readAsDataURL(file);
        $("#btnUploadCondBoxEdit1").prop("disabled", false);
        $("#addMarkerEdit1").prop("disabled", false);
        $("#clearMarkerEdit1").prop("disabled", false);
        $("#descUploadBoxCond1").prop("disabled", false);
    });

    $('#btnUploadCondBoxEdit1').click(function (e) {
        var canvas = document.getElementById("canvasEditBoxCondition1");
        $("#frontImgBoxEdit1").css("background-image", "url('" + canvasEdit1.toDataURL("image/jpeg") + "')");
    });

</script>
