﻿@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.Transport.TransportExecutionViewModel
@{
    ViewBag.Title = "Transport > Transportation Execution > List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
}

<style>

    .fc-selected {
        background-color: #f39814 !important;
    }
    /*SORTABLE STYLE*/
    body.dragging, body.dragging * {
        cursor: move !important;
    }

    .dragged {
        position: absolute;
        opacity: 0.5;
        z-index: 2000;
    }

    .select2-selection.required {
       background-color: yellow !important;
    }

    .dataTables_processing {
        top: 64px !important;
        z-index: 11000 !important;
    }

    ul {
        list-style-type: none;
    }

        ul.RouteMainSortable li.placeholder, ul.RouteAdditionalSortable li.placeholder, ul.RouteStartLocation li.placeholder, ul.RouteSortable li.placeholder, ul.RouteFinishLocation li.placeholder {
            position: relative;
            /** More li styles **/
        }

            ul.RouteMainSortable li.placeholder:before, ul.RouteAdditionalSortable li.placeholder:before, ul.RouteStartLocation li.placeholder:before, ul.RouteSortable li.placeholder:before, ul.RouteFinishLocation li.placeholder:before {
                position: absolute;
                /** Define arrowhead **/
            }

    .RouteMainSortable, .RouteMainSortable ul, .RouteMainSortable li, .RouteAdditionalSortable, .RouteAdditionalSortable ul, .RouteAdditionalSortable li {
        display: inline;
    }
    /*SORTABLE STYLE*/
</style>

<div class="filter-deck">
    <div class="title-deck wmb" hidden>
        <div class="col-panel" style="padding-bottom: 0px;">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Total Trip</label>
                        <h4 class="sub-text" id="totalTrip"><i class="fa fa-spin fa-refresh"></i></h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="title-deck wmb">
        <div class="button-wrap pull-left">
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.AddNew)))
            {
                <button class="btn btn-primary" type="button" id="btnAdd" onclick="window.location.href = '@Url.Action("AddNew", "TransportationExecution")'">New TN</button>
            }
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Delete)))
            {
                <button class="btn btn-primary" type="button" id="btnDelete">Delete</button>
            }
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
            {
                <button class="btn btn-primary" type="button" id="btnExportReport">Export</button>
            }
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
            {
                <button class="btn btn-primary" type="button" id="btnCustomReport" data-toggle="modal" data-target="#customReport">Custom Report</button>
            }
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.PrintDocument)))
            {
                <button class="btn btn-primary" type="button" id="btnPrint" data-toggle="modal" data-target="">Print Transportation Document</button>
            }
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Upload)))
            {
                <button class="btn btn-primary" type="button" id="btnPopUpUpload" data-toggle="modal" data-target="#modalUploadTransportExecution">Upload</button>
            }
            @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.ShippingInstruction)))
            {
                <button class="btn btn-primary" type="button" id="btnShipping">Shipping Instruction</button>
            }
        </div>
        <a href="#filter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter" id="advSearch"><b>Advanced Search</b> <i class="fa fa-angle-down"></i></a>
    </div>
    <div class="filter-deck nmb">
        <div id="filter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
            <div class="col-panel">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Transportation Number</label>
                            @*<select class="select2" multiple="multiple" id="FilterTransportNumber"></select>*@
                            <input type="hidden" style="width:100%" id="FilterTransportNumber" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Order Number/STO</label>
                            @*<select class="select2" multiple="multiple" id="FilterOrderNumber"></select>*@
                            <input type="hidden" style="width:100%" id="FilterOrderNumber" />
                        </div>
                    </div>
                    <div class="col-md-3" hidden>
                        <div class="form-group">
                            <label>Order Category</label>
                            @*<select class="select2" multiple="multiple" id="FilterOrderCategory"></select>*@
                            @Html.DropDownListFor(model => Model.orderCategoryList, Model.orderCategoryList, new { @multiple = "multiple", @id = "FilterOrderCategory" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Transportation Mode</label>
                            @Html.DropDownListFor(model => Model.transportModeList, Model.transportModeList, new { @multiple = "multiple", @id = "FilterTransportMode" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>SI Status</label>
                            @*<select class="select2" multiple="multiple" id="FilterSIStatus"></select>*@
                            @Html.DropDownListFor(model => Model.siStatusList, Model.siStatusList, new { @multiple = "multiple", @id = "FilterSIStatus" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Order Type</label>
                            @*<select class="select2" multiple="multiple" id="FilterOrderType"></select>*@
                            @Html.DropDownListFor(model => Model.orderTypeList, Model.orderTypeList, new { @multiple = "multiple", @id = "FilterOrderType" })
                        </div>
                    </div>
                    <div class="col-md-3" hidden>
                        <div class="form-group">
                            <label>Zone</label>
                            @*<select class="select2" multiple="multiple" id="FilterZone"></select>*@
                            @Html.DropDownListFor(model => Model.zoneList, Model.zoneList, new { @multiple = "multiple", @id = "FilterZone" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Material Type</label>
                            @*<select class="select2" multiple="multiple" id="FilterMaterialType"></select>*@
                            @Html.DropDownListFor(model => Model.materialTypeList, Model.materialTypeList, new { @multiple = "multiple", @id = "FilterMaterialType" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Sender</label>
                            @*<select class="select2" multiple="multiple" id="FilterSender"></select>*@
                            @Html.DropDownListFor(model => Model.locationList, Model.locationList, new { @multiple = "multiple", @id = "FilterSender" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Receiver</label>
                            @*<select class="select2" multiple="multiple" id="FilterReceiver"></select>*@
                            @Html.DropDownListFor(model => Model.locationList, Model.locationList, new { @multiple = "multiple", @id = "FilterReceiver" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>Transportation Date</label>
                                    <!--
                                        <input type="text" id="FilterFromDate" class="form-control datepicker" data-date-format="DD/MM/YYYY" value="@* var a = (DateTime.Now - new TimeSpan(7, 0, 0, 0)).ToString("dd/MM/yyyy"); *@a}">
                                    -->
                                    <input type="text" id="FilterFromDate" class="form-control datepicker" data-date-format="DD/MM/YYYY" value="@{var a = DateTime.Now.ToString("dd/MM/yyyy"); @a}">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>&nbsp;</label>
                                    <label class="text-center">TO</label>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>&nbsp;</label>
                                    <input type="text" id="FilterToDate" class="form-control datepicker" data-date-format="DD/MM/YYYY" value="@DateTime.Now.ToString("dd/MM/yyyy")">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Start Location</label>
                            @*<select class="select2" multiple="multiple" id="FilterStartLocation"></select>*@
                            @Html.DropDownListFor(model => Model.locationList, Model.locationList, new { @multiple = "multiple", @id = "FilterStartLocation" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Transportation Status</label>
                            @Html.DropDownListFor(model => Model.transportStatusList, Model.transportStatusList, new { @multiple = "multiple", @id = "FilterTransportStatus" })
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12">
                    <button type="button" class="btn btn-primary" id="btnSearch">Search</button>
                    <button type="button" class="btn btn-purple" id="btnReset">Reset</button>
                </div>
            </div>
        </div>
    </div>
</div>

<table id="dtFilterMaster" class="display table dataTable">
