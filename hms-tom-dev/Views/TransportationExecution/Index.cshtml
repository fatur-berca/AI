    function getTransportNumber() {
        $("#ShippingTransportNumber").select2({
            ajax: {
                url: '@Url.Action("GetTNCreatorShipping", "TransportationExecution")',
                dataType: 'json',
                data: function (params) {
                    return {
                        term: params
                    };
                },
                results: function (data) {
                    var myResults = [];
                    $.each(data, function (index, item) {
                        myResults.push({
                            'id': item.IDUser,
                            'text': item.FullName
                        });
                    });
                    return {
                        results: myResults
                    };
                },
                cache: true
            },
            placeholder: 'Type TN Creator',
            delay: 250,
            multiple: true,
            minimumInputLength: 2,
            containerCssClass: function(e) {
                return $(e).attr('required') ? 'required' : '';
            }
        });
    }

    function getWeekShipping(thn) {
        var sel;
        var mgu = $('#ShippingWeek').val();

        $.ajax({
            url: '@Url.Action("GetWeekShip", "TransportationExecution")',
            dataType: 'json',
            cache: false,
            data: { year: thn },
            success: function (result) {
                $('#ShippingWeek').html('');
                if (result.def >= 0)
                    mgu = result.def;
                $.each(result.week, function (key, val) {
                    if (val.Week == mgu) { sel = 'selected'; } else { sel = ''; }
                    $('#ShippingWeek').append('<option ' + sel + ' value="' + val.Week + '">' + val.Week + '</option>');
                });
            }
        });
    }

