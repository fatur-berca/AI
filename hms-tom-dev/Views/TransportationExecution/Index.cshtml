<div class="modal fade" id="customReport" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Custom Report</h4>
            </div>
            <div class="modal-body custom-report">
                <div class="row label-top">
                    <div class="col-md-6">
                        <label>Column Set</label>
                    </div>
                    <div class="col-md-6">
                        <label class="dis">Displayed Columns</label>
                        <select id="layoutSelect" class="form-control">
                            <option value="">Loading...</option>
                        </select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div id="fieldChooser" tabindex="1" class="field-chooser form-group">
                    <ul id="sourceFields" class="source">
                        @{
                            var fields = new string[] { "Transportation Number", "Transportation Status", "Transportation Date",
                                "Transportation Category", "Actual Vehicle Type", "Transportation Mode", "Vessel Name",
                                "ETD1", "ETA1", "Container Number", "Container Seal", "Vendor", "SI Type", "SI Status", "SI Week",
                                "Target of Arrival", "Actual Arrive", "Start Location", "Finish Location", "Service PO Number",
                                "Service GR Number", "Actual Cost Center", "Order Number", "Material Type", "Material Description",
                                "Quantity", "UoM", "Sender", "Receiver", "Route", "KM", "Order Category", "Ordered Vehicle Type",
                                "Ordered Cost Center", "Police Reg Number", "Driver 1", "Driver 2", "Co-Driver", "Total KM",
                                "Total Box", "Additional Cost", "Via", "Month", "Year", "Created By", "Created Date",
                                "Updated By", "Updated Date", "Is Active", "Delivery Qty", "Total KM Rail", "Total KM Based",
                                "Total KM Sea", //"CFP Liter", "CFPTKM  KGCO2",  "Average Load Factor",
                                "Remarks",
                                // "Cost"  , "Discount Cost",  "Total Cost", "Cost Center"
                            };
                            foreach (var f in fields)
                            {
                                <li><div class="custom-report-field" onclick="setHighlightCustomReport(this)" data-field="@f">@f</div></li>
                            }
                        }
                    </ul>
                    <div class="button-column">
                        <div>
                            <input class="btn btn-info mini" type="button" id="left" value="<">
                            <input class="btn btn-info mini" type="button" id="right" value=">">
                        </div>
                    </div>
                    <ul id="destinationFields" class="destination"></ul>
                </div>
                <div class="opt-bot">
                    <div class="row">
                        <div class="col-md-6">
                            <input class="btn btn-info amr" type="button" id="rightall" value=">>">
                            <input class="btn btn-info" type="button" id="leftall" value="<<">
                        </div>
                        <div class="col-md-6">
                            <input class="btn btn-info" type="button" id="btnSaveLayout" value="Save Layout">
                            <input type="text" class="form-control" id="layoutName">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @foreach (var x in listUserRole)
                {
                    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
                    {
                        <div class="form-group pull-left">
                            <div class="checkbox-deck">
                                <input type="checkbox" id="chkGlobalCustomReport">
                                <label for="chkGlobalCustomReport"></label>
                            </div>
                            <span class="checkbox-deck-span">Global Custom Report</span>
                        </div>
                    }
                }
                <button class="btn btn-primary" id="btnExportCustomReport">Export</button>
                <button class="btn btn-purple" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

