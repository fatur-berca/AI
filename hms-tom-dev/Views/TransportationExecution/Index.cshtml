    $("#btnUploadTransportExecution").click(function () {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...Uploading Data</div>',
            closeButton: false
        });
        var data = new FormData();
        var fileUpload = $("#uploadTransportExecution").get(0).files;
        if (fileUpload.length > 0) {
            data.append('fileUpload', fileUpload[0]);
        }
        $("#btnUploadTransportExecution").prop("disabled", true);
        $.ajax({
            type: "POST",
            url: 'TransportationExecution/UploadExecution',
            contentType: false,
            processData: false,
            cache: false,
            data: data,
            success: function (data) {
                $("#modalUploadTransportExecution").modal('hide');
                if (data.IsSuccess)
                {
                    dialog.modal('hide');
                    ez.Modals.notification('Your data has been successfully saved');
                    loadDataTable();
                }
                else
                {
                    dialog.modal('hide');
                    $('#notificationModal').modal('show');
                    $('#notificationModal .modal-body').html('<img src="assets/images/cancel.png" alt="">');
                    $('#notificationModal .modal-body').append('Upload Failed <br>' + data.ErrorMessage);
                    $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                }
                ResetPopUpUpload();
            },
            error: function () {
                dialog.modal('hide');
                $('#notificationModal').modal('show');
                $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span> Failed!</span>');
                $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
            }
        });
    });

