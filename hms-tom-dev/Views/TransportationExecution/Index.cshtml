    function exportemailShipping() {
        $('#modalloading').modal('show');

        var chk;
        if ($("#radExport").prop('checked') == true) { chk = 'xls'; }
        else if ($("#radEmailSI").prop('checked') == true) { chk = 'mail'; }

        var fvn = $('#ShippingVendor').val(),
            fwk = $('#ShippingWeek').val(),
            fyr = $('#ShippingYear').val();
        //startloc = $('#StartLocationSI').val();
        var tncreator = $("#ShippingTransportNumber").val();

        $.ajax({
            url: '@Url.Action("ExportSI", "TransportationExecution")',
            method: 'POST',
            dataType: 'json',
            cache: false,
            data: { option: chk, fltrvn: fvn, fltrwk: fwk, fltryr: fyr, tncreator: tncreator.split(",") },
            success: function (result) {
                //console.log(result);
                $('#modalloading').modal('hide');
                if(result == false){
                    $('#notificationModal').modal('show');
                    $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span> Send email failed. Please check master vendor!</span>');
                    $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                } else {
                    if (chk == 'xls') {
                        window.location.assign('@Url.Content("~/Assets/Download/")' + result);
                    }
                    else {
                        $('#modalsuccess').modal('show');
                    }
                }
            }
        });
    }

