    $("#FilterOrderNumber").val("");
    var filter = new Object();
    var tempIDTE = [];
    var tempIDTO = [];
    var tempIdTOD = [];
    var layoutIsGlobal = [];
    var tempListTN = [];
    //$("#fieldChooser .ui-draggable").prop("draggable", true);
