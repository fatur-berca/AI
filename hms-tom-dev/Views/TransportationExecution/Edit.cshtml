    function GetVehicleData(IDVendor,policeRegNumber)
    {
        $('#PoliceRegNumber').html('');
        $.ajax({
            type: "get",
            method: "post",
            url: '@Url.Action("GetVehicleByCriteriaActive", "TransportationExecution")',
            data: { IDVendor: IDVendor },
            dataType: 'json',
            cache: false,
            success: function (result) {
               // console.log(result);
                $('#PoliceRegNumber').append('<option value="-"></option>');

                for (var i = 0; i < result.length; i++)
                {
                    $('#PoliceRegNumber').append('<option value=' + result[i].IDPoliceRegNumber + '>' + result[i].IDPoliceRegNumber + '</option>');
                }
            },
            complete: function () {
                var exists = false;
                $("#PoliceRegNumber option").each(function () {
                    if ($(this).val() == policeRegNumber) {
                        exists = true;
                        return false;
                    }
                });
                if (exists)
                    $("#PoliceRegNumber").select2('val', policeRegNumber);
                else if (exists == false && policeRegNumber != null) {
                    $('#PoliceRegNumber').append('<option value=' + policeRegNumber + '>' + policeRegNumber + '</option>');
                    $("#PoliceRegNumber").select2('val', policeRegNumber);
                }
            }
        });
    }

    function GetDriverData(IDVendor,iddriver1,driver1,iddriver2,driver2,idcodriver,codriver) {
        $('#Driver1').html('');
        $('#Driver2').html('');
        $('#CoDriver').html('');
        $.ajax({
            type: "get",
            method: "post",
            url: '@Url.Action("GetDriverByCriteriaActive", "TransportationExecution")',
            data: { IDVendor: IDVendor },
            dataType: 'json',
            cache: false,
            success: function (result) {
                $('#Driver1').append('<option value="-"></option>');
                for (var i = 0; i < result.driver.length; i++) {
                    $('#Driver1').append('<option value=' + result.driver[i].ID + '>' + result.driver[i].Name + '</option>');
                }
                $('#Driver2').html($('#Driver1').html());
                $('#CoDriver').append('<option value="-"></option>');
                for (var i = 0; i < result.codriver.length; i++) {
                    $('#CoDriver').append('<option value=' + result.codriver[i].ID + '>' + result.codriver[i].Name + '</option>');
                }
                //$('#CoDriver').html($('#Driver1').html());
            },
            complete: function () {
                var existsDriver1 = false;
                var existsDriver2 = false;
                var existsCoDriver = false;

                $("#Driver1 option").each(function () {
                    if ($(this).val() == iddriver1) {
                        existsDriver1 = true;
                    }
                    if ($(this).val() == iddriver2) {
                        existsDriver2 = true;
                    }
                });
                $("#CoDriver option").each(function () {
                    if ($(this).val() == idcodriver) {
                        existsCoDriver = true;
                        return false;
                    }
                });
                if (existsDriver1)
                    $("#Driver1").select2('val', iddriver1);
                else if (existsDriver1 == false && iddriver1 != null && driver1 != null) {
                    $('#Driver1').append('<option value=' + iddriver1 + '>' + driver1.Name + '</option>');
                    $("#Driver1").select2('val', iddriver1);
                }
                if (existsDriver2)
                    $("#Driver2").select2('val', iddriver2);
                else if (existsDriver2 == false && iddriver2 != null && driver2 != null){
                    $('#Driver2').append('<option value=' + iddriver2 + '>' + driver2.Name + '</option>');
                    $("#Driver2").select2('val', iddriver2);
                }
                if (existsCoDriver)
                    $("#CoDriver").select2('val', idcodriver);
                else if (existsCoDriver == false && codriver != null && codriver != null){
                    $('#CoDriver').append('<option value=' + idcodriver + '>' + codriver.Name + '</option>');
                    $("#CoDriver").select2('val', idcodriver);
                }
            }
        });
    }

