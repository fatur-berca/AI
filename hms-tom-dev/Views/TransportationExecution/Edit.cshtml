        function CheckObjectOnList(list, idloc, locname, ismain, isnonkmbased) {
            var loc1 = new Object();
            var result1 = $.grep(list, function (e) { return e.IDLocation == idloc; });
            if (result1.length == 0) {
                loc1.IDLocation = idloc;
                loc1.LocationName = locname;
                loc1.IsMain = ismain;
                loc1.IsNonKMBased = isnonkmbased;
                return loc1;
            }
            return 'undefined';
        }

        function RemoveObjectOnList(list, object) {
            return $.grep(list, function (e) {
                return e.IDLocation != object.IDLocation;
            });
        }

        function RemoveDuplicateObjectOnList(unfilterList, filterList) {
            return unfilterList.filter(function (el) {
                var index = $.map(filterList,
                    function (obj, index) {
                        if (obj.IDLocation == el.IDLocation) {
                            return index;
                        }
                    });
                if (index.length == 0) {
                    if (filterList.length > 0) {
                        return filterList.indexOf(index);
                    }
                }
            });
        }

        function FindDuplicateObjectOnList(unfilterList, filterList) {
            //console.log('unfilter list');
            //console.log(unfilterList);
            //console.log('filter list');
            //console.log(filterList);
            return unfilterList.filter(function (el) {
                var index = $.map(filterList, function (obj, index) {
                    //console.log('unfilter');
                    //console.log(el);
                    //console.log('filter');
                    //console.log(obj);
                        if (obj.IDLocation == el.IDLocation) {
                            return index;
                        }
                });
                //console.log(index);
                if (index.length != 0) {
                        return filterList.indexOf(index);
                }
            });
        }

