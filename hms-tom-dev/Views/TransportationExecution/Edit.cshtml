    function checkGategory(TOList) {
        var OrderDetail = [];
        var category = [];
        for (var i in TOList) {
            OrderDetail = OrderDetail.concat(TOList[i].TransportOrderDetails)
        }
        var groupBy = Object.keys(_.groupBy(OrderDetail, "MaterialType"));
        // DIM
        // Cutfiller
        // Cigarette

        for (var g in groupBy) {
            var TypeOrder = groupBy[g];
            if (TypeOrder == "DIM" || TypeOrder == "Cutfiller") {
                category.push("A")
            } else if (TypeOrder == "Cigarette") {
                category.push("B")
            }
        }

        if (Object.keys(_.groupBy(category)).length > 1) {
            return 'Synergy'
        } else {
            return 'Regular'
        }
    }

    function saveExecution(transCategory) {
        saveTransExecution.TransportCategory = transCategory
        // $("#TransportCategory").val(TransportCategory)
        // $('#notificationModal').modal('hide');
        // var dialog = bootbox.dialog({
        //     message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
        //     closeButton: false
        // });
        $.ajax({
            type: "POST",
            url: '@Url.Action("SaveData", "TransportationExecution")',
            data: { saveTransExe: saveTransExecution, saveTransRoute: saveTransRouteList, saveTransOrder: TOList, saveTransVessel: saveTransVessel, saveVendorLog: saveVendorLog },
            cache: false,
            async: false,
            success: function (data) {
                dialog.modal('hide');
                if (data.length > 0) {
                    var errorString = "";
                    var driverUsed = false;
                    var modified = false;
                    var invalid = false;
                    for (var i = 0; i < data.length; i++) {
                        var errorSplit = data[i].split('-');
                        if (errorSplit[0] == "STNKInvalid") {
                            errorString = errorString + errorSplit[1] + '-' + errorSplit[2] + " STNK have Expired<br/>";
                            invalid = true;
                        }
                        if (errorSplit[0] == "SIM1Invalid") {
                            errorString = errorString + errorSplit[1] + " driving license have expired<br/>";
                            invalid = true;
                        }
                        if (errorSplit[0] == "SIM2Invalid") {
                            errorString = errorString + errorSplit[1] + " driving license have expired<br/>";
                            invalid = true;
                        }
                        if (errorSplit[0] == "SIM3Invalid") {
                            errorString = errorString + errorSplit[1] + " driving license have expired<br/>";
                            invalid = true;
                        }
                        if (errorSplit[0] == "Driver1Used") {
                            if (errorSplit[2] != "E")
                                errorString = errorString + "Driver 1 <b>" + errorSplit[1] + "</b> has been used in <b>" + errorSplit[2] + "</b><br/>";
                            else
                                errorString = errorString + "Driver 1 <b>" + errorSplit[1] + "</b> has been used in <b>" + errorSplit[2] + "-" + errorSplit[3] + "</b><br/>";
                            driverUsed = true;
                        }
                        if (errorSplit[0] == "Driver2Used") {
                            if (errorSplit[2] != "E")
                                errorString = errorString + "Driver 2 <b>" + errorSplit[1] + "</b> has been used in <b>" + errorSplit[2] + "</b><br/>";
                            else
                                errorString = errorString + "Driver 2 <b>" + errorSplit[1] + "</b> has been used in <b>" + errorSplit[2] + "-" + errorSplit[3] + "</b><br/>";
                            driverUsed = true;
                        }
                        if (errorSplit[0] == "Driver3Used") {
                            if (errorSplit[2] != "E")
                                errorString = errorString + "Co-Driver <b>" + errorSplit[1] + "</b> has been used in <b>" + errorSplit[2] + "</b><br/>";
                            else
                                errorString = errorString + "Co-Driver <b>" + errorSplit[1] + "</b> has been used in <b>" + errorSplit[2] + "-" + errorSplit[3] + "</b><br/>";
                            driverUsed = true;
                        }
                        if (errorSplit[0] == "Modified") {
                            errorString = errorString + "This Transaction have been modified by other user Click OK to refresh<br/>";
                            modified = true;
                        }
                    }
                    //memunculkan warning route tidak ada di master distance
                    if (warningRoute != "") {
                        if (driverUsed)//ada warning drive, maka tambahkan spasi di atasnya
                            errorString = errorString + "<br/>" + warningRoute;
                        else
                            errorString = errorString + warningRoute;
                        driverUsed = true;
                    }
                    $('#notificationModal').modal('show');
                    if (driverUsed) {
                        $('#notificationModal .modal-body').html(errorString + "Still want to save the data ?");
                        $('#notificationModal .modal-footer')
                            .html(
                                '<button type="button" id="btnConfirmSave" onclick="ConfirmSave()" class="btn btn-primary">Save</button><button type="button" class="btn btn-primary" data-dismiss="modal">Cancel</button>');
                    }
                    if (modified) {
                        $('#notificationModal .modal-body').html(errorString);
                        $('#notificationModal .modal-footer')
                            .html(
                                '<button type="button" onclick="window.location.reload()" class="btn btn-primary">OK</button>');
                    }
                    if (invalid) {
                        $('#notificationModal .modal-body').html(errorString);
                        $('#notificationModal .modal-footer').html('');
                    }
                } else {
                    $('#modalsuccess').modal('show');
                    //location.reload();
                }
            }
        });
    }

