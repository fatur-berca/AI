@using System.Web.Mvc.Html
@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.Transport.TransportExecutionViewModel
@{
    ViewBag.Title = "Transport > Transportation Execution > Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .orderDetail {
        padding-right: 0px;
        width: 145px;
    }

    .orderDetail--small {
        width: 90px;
    }

    .orderDetail--last {
        padding-right: 15px;
    }

    .orderDetail--element {
        padding: 6px 12px !important;
    }

    .orderDetail--element--normal {
        width: 135px;
    }

    .orderDetail--element--small {
        width: 80px;
    }

    .orderDetail--elemen--close {
        background-color: Transparent;
        background-repeat: no-repeat;
        border: none;
        overflow: hidden;
        outline: none;
        cursor: pointer;
        font-weight: bold;
        font-size: 20px;
        content: "\00D7";
        position: relative;
        left: 15px;
        top: 24px;
    }

    .row-order-detail {
        position: relative;
        display: inline-block;
        width: 100%;
    }

    .disabled--textbox
    {
        background-color: #e0e0e0 !important;
        cursor: not-allowed;
        color: #555 !important;
    }

    .hidden {
        display: none;
    }

    .routeDetail--checkbox {
        margin-top: 0 !important;
        margin-right: 9px !important;
    }

    .routeDetail--button {
        margin-right: 20px !important;
        margin-bottom: 10px !important;
    }
    /*SORTABLE STYLE*/
    body.dragging, body.dragging * {
        cursor: move !important;
    }

    .dragged {
        position: absolute;
        opacity: 0.5;
        z-index: 2000;
    }

    ul
    {
        list-style-type: none;
    }

    ul.RouteMainSortable li.placeholder, ul.RouteAdditionalSortable li.placeholder, ul.RouteStartLocation li.placeholder, ul.RouteSortable li.placeholder , ul.RouteFinishLocation li.placeholder {
        position: relative;
        /** More li styles **/
    }
    ul.RouteMainSortable li.placeholder:before, ul.RouteAdditionalSortable li.placeholder:before, ul.RouteStartLocation li.placeholder:before, ul.RouteSortable li.placeholder:before, ul.RouteFinishLocation li.placeholder:before {
        position: absolute;
        /** Define arrowhead **/
    }

    .RouteMainSortable, .RouteMainSortable ul, .RouteMainSortable li, .RouteAdditionalSortable, .RouteAdditionalSortable ul, .RouteAdditionalSortable li { display: inline; }
    /*SORTABLE STYLE*/

    .txt-invalid {
        border: 1px solid red !important;
    }

    .datetimepicker {
        padding-left: 30px !important;
        background-image: url("../assets/images/date.png");
        background-repeat: no-repeat;
        background-position: center left 10px;
    }

    .barShipTrain {
        margin-top: 5px;
        margin-bottom: 5px;
    }

    .sectionShipTrain {
        margin-top: 5px;
    }
    .dtl-order {
        width: 12%;
        display: inline-block;
        margin-right: 5px;
    }
    .remove-order {
        width: 5%;
        display: inline-block;
        margin-right: 5px;
    }
    .km-order {
        width: 8%;
        display: inline-block;
        margin-right: 5px;
    }
    .category-order {
        width: 16%;
        display: inline-block;
        margin-right: 5px;
    }
    .orderDetail--elemen--close{
        top : 0px !important;
    }
</style>

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button class="btn btn-purple" onclick="window.location.href = '@Url.Action("Index", "TransportationExecution")'">Back</button>
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Save)))
        {
            <button type="button" class="btn btn-primary" id="btnSave" disabled>Save</button>
        }
        <button type="button" class="btn btn-primary" id="btnEdit">Edit</button>
    </div>
</div>
<br/>
<br/>
<br/>

<div>
<!--START: BAGIAN COLLAPSE MAIN--> 
<a role="button" class="toggle-collapse" data-toggle="collapse" href="#collapseMain" aria-expanded="true" aria-controls="collapseMain">
    Main
    <i class="fa fa-angle-up pull-right"></i>
</a>
<div id="collapseMain" class=" in">
    <div class="col-panel">
        <div class="row">
            @Html.DropDownListFor(model => Model.orderCategoryList, Model.orderCategoryList, new { @class = "form-control hidden", @id = "OrderCategoryCopy" })
            <div class="col-md-3">
                <div class="form-group">
                    <label>Transportation Number</label>
                    <input type="text" class="form-control" id="TransportNo" disabled>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>Transportation Date</label>
                    <input type="text" id="TransportDate" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Transportation Category</label>
                    <!--<input type="text" id="TransportCategory" class="form-control">-->
                    @Html.DropDownListFor(model => Model.transportCategoryList, Model.transportCategoryList, new { @class = "form-control", @id = "TransportCategory", @disabled = "disabled" })
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>Actual Vehicle Type</label>
                    @*<select class="form-control" id="VehicleType"></select>*@
                    @Html.DropDownListFor(model => Model.vehicleTypeList, Model.vehicleTypeList, new {@class = "form-control", @id = "VehicleType"})
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>Transportation Mode</label>
                    @*<select class="form-control" id="TransportMode"></select>*@
                    @Html.DropDownListFor(model => Model.transportationModeList, Model.transportationModeList, new {@class = "form-control", @id = "TransportMode"})
                </div>
            </div>
        </div>
        <!--START: BAGIAN SHIP AND TRAIN--> 
        <div class="row sectionShipTrain" id="sectionShipTrain" style="display: none;">
            <div class="col-md-12">
                <div id="ShipTrain" class="form-group">
                    <label>Ship and Train</label>
                    <hr class="barShipTrain" />
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <input type="hidden" class="form-control" id="IDTransVessel" disabled>
                                <label>Vessel Name</label>
                                @*<select class="form-control" id="VesselName"></select>*@
                                @Html.DropDownListFor(model => Model.vesselNameList, Model.vesselNameList, new { @class = "select2", @id = "VesselName" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>ETD 1</label>
                                <input type="text" id="ETD1" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>ETA 1</label>
                                <input type="text" id="ETA1" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>Container Number</label>
                                <input type="text" class="form-control" id="ContainerNumber">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>Container Seal</label>
                                <input type="text" class="form-control" id="ContainerSeal">
                            </div>
                        </div>
                    </div>
                    <hr />
                </div>
            </div>
        </div>
        <!--END: BAGIAN SHIP AND TRAIN--> 
            
        <!--START: BAGIAN VENDOR BEFORE-->
        <div class="row" id="sectionVendorBefore">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Vendor</label>
                            @Html.DropDownListFor(model => Model.vendorList, Model.vendorList, new { @class = "select2", @id = "VendorNameBefore", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>SI Type</label>
                            @*<select class="form-control" id="SIType"></select>*@
                            @Html.DropDownListFor(model => Model.siTypeList, Model.siTypeList, new { @class = "form-control", @id = "SITypeBefore" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>SI Status</label>
                            @*<select class="form-control" id="SIStatus"></select>*@
                            @Html.DropDownListFor(model => Model.siStatusList, Model.siStatusList, new { @class = "form-control", @id = "SIStatusBefore" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Target of Arrival</label>
                            <input type="text" class="form-control datetimepicker" id="TargetArrivalBefore" data-date-format="DD/MM/YYYY HH:mm">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Actual Arrive</label>
                            <input type="text" class="form-control datetimepicker" id="ActualArriveBefore" data-date-format="DD/MM/YYYY HH:mm">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--START: BAGIAN VENDOR BEFORE-->
            
        <!--START: BAGIAN VENDOR NOW--> 
        <div class="row" id="sectionVendor" style="display: none;">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Vendor</label>
                            @*<input type="text" class="form-control" id="VendorName">*@
                            @Html.DropDownListFor(model => Model.vendorList, Model.vendorList, new { @class = "select2", @id = "VendorName" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>SI Type</label>
                            @*<select class="form-control" id="SIType"></select>*@
                            @Html.DropDownListFor(model => Model.siTypeList, Model.siTypeList, new { @class = "form-control", @id = "SIType" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>SI Status</label>
                            @*<select class="form-control" id="SIStatus"></select>*@
                            @Html.DropDownListFor(model => Model.siStatusList, Model.siStatusList, new { @class = "form-control", @id = "SIStatus" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Target of Arrival</label>
                            <input type="text" class="form-control datetimepicker" id="TargetArrival" data-date-format="DD/MM/YYYY HH:mm">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Actual Arrive</label>
                            <input type="text" class="form-control datetimepicker" id="ActualArrive" data-date-format="DD/MM/YYYY HH:mm">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--END: BAGIAN VENDOR NOW--> 
                
        <!--START: BAGIAN START LOCATION--> 
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>Start Location</label>
                    @*<select class="form-control" id="StartLocation"></select>*@
                    @Html.DropDownListFor(model => Model.locationList, Model.locationList, new { @class = "select2", @id = "StartLocation" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Finish Location</label>
                    @*<select class="form-control" id="FinishLocation"></select>*@
                    @Html.DropDownListFor(model => Model.locationList, Model.locationList, new { @class = "select2", @id = "FinishLocation" })
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>Service PO Number</label>
                    <input type="text" class="form-control" id="ServicePONumber">
                </div>
            </div> 
            <div class="col-md-2">
                <div class="form-group">
                    <label>Service GR Number</label>
                    <input type="text" class="form-control" id="ServiceGRNumber">           
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>Actual Cost Center</label>
                    <select class="form-control" id="ActualCostCenter"></select>
                    @*@Html.DropDownListFor(model => Model.costCenterList, Model.costCenterList, new { @class = "form-control", @id = "ActualCostCenter" })*@
                </div>
            </div>
        </div>
        <!--END: BAGIAN START LOCATION--> 
    </div>
</div>
<!--END: BAGIAN COLLAPSE MAIN--> 
    
<!--START: BAGIAN COLLAPSE ORDER DETAIL--> 
<a role="button" class="toggle-collapse collapsed" data-toggle="collapse" href="#collapseOrderDetail" aria-expanded="false" aria-controls="collapseOrderDetail">
    Order Detail
    <i class="fa fa-angle-up pull-right"></i>
</a>
<div id="collapseOrderDetail" class="">
