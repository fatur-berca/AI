<!--START: BAGIAN COLLAPSE ROUTE DETAIL--> 
<a role="button" class="toggle-collapse"  data-toggle="collapse" href="#collapseRouteDetail" aria-expanded="true" aria-controls="collapseRouteDetail">
    Route Detail
    <i class="fa fa-angle-up pull-right"></i>
</a>
<div id="collapseRouteDetail" class="in">
    <div class="col-panel">
        <h4><b><label id="lblVendorCategory"></label></b></h4>
        <hr />
        <div class="row">
            <div class="col-md-1">
                <h4><b><label>Main</label></b></h4>
            </div>
            <div class="col-md-11">
                <div class="form-group">
                    <div>
                        <ul id="RouteMainSortable" class="RouteMainSortable"></ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-1">
                <h4><b><label>Additional</label></b></h4>
            </div>
            <div class="col-md-11">
                <div class="form-group">
                    <div>
                        <ul id="RouteAdditionalSortable" class="RouteAdditionalSortable"></ul>
                    </div>
                </div>
            </div>
        </div>
        <br/>
        <div class="row">
            <div class="col-md-6">
                <h4><b><label>Route</label></b></h4>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <div id="route">
                                <ul id="RouteStartLocation" class="RouteStartLocation"></ul>
                                <ul id="RouteSortable" class="RouteSortable"></ul>
                                <ul id="RouteFinishLocation" class="RouteFinishLocation"></ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Additional Cost</label>
                            <input type="text" class="form-control" id="AddCost">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Remarks</label>
                            <input type="text" class="form-control" id="Remarks">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <div id="ViaSection">
                                <label>Via</label>
                                @*<select class="form-control" id="Via"></select>*@
                                @Html.DropDownListFor(model => Model.viaList, Model.viaList, new { @class = "form-control", @id = "Via" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnCalculate">Calculate</button>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Total KM Based</label>
                            <input type="text" class="form-control" id="DisplayTotalKM" disabled>
                            <input type="hidden" class="form-control" id="TotalKM" disabled>
                            <input type="hidden" class="form-control" id="KMTruck" disabled>
                            <input type="hidden" class="form-control" id="KMRail" disabled>
                            <input type="hidden" class="form-control" id="KMSea" disabled>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <div id="TotalBoxSection">
                                <label>Grand Total Box</label>
                                <input type="text" class="form-control" id="TotalBox" disabled>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
