        function assignValueToDetail(i, addNew, to) {
            $('#OrderNumberDetail' + i + '').val(to.STONo);

            if (to.MasterLocation2 != null)
                $('#SenderDetail' + i + '').val(to.MasterLocation2.LocationName);
            else
                $('#SenderDetail' + i + '').val("");

            if (to.MasterLocation3 != null)
                $('#ReceiverDetail' + i + '').val(to.MasterLocation3.LocationName);
            else
                $('#ReceiverDetail' + i + '').val("");

            $('#KMDetail' + i + '').val(Math.round(to.KM));
            $('#hiddenOrderType' + i + '').val(to.FGRMT);
            $('#hiddenTotalBox' + i + '').val(Math.round(to.TotalBox));

            if (addNew)
                $('#OrderCategoryDetail' + i + '').val("Additional Order");
            else
                $('#OrderCategoryDetail' + i + '').val(to.OrderCategory);

            $('#VehicleTypeDetail' + i + '').val(to.VehicleType);

            if(to.MasterCostCenter != null)
                $('#CostCenterDetail' + i + '').val(to.MasterCostCenter.CostCenter);

            if (to.DisplayCostCenter != ""){
                var option = new Option(to.DisplayCostCenter, to.IDCostCenter);
                $(option).html(to.DisplayCostCenter);
                $("#ActualCostCenter").append(option);
            }
        }

