<script type="text/javascript">
    var stringOrderCategory = "";
    var TO = 0;
    var addedTOList = [];
    var saveTOList = [];
    var dialog;
    var TransportationModeDefaultLoad = "";
    var VesselMonitoringDefaultLoad = new Object();
    var TransportCategoryLoad = "";//dipakai untuk mengset nilai default transport category data, kalau dari db sudah ada nilainya, maka pakai variabel ini
    var ActualVehicleTypeLoad = "";//dipakai untuk mengset nilai default actual vehicle type data, kalau dari db sudah ada nilainya, maka pakai variabel ini
    var ActualCostCenterLoad = "";//dipakai untuk mengset nilai default actual cost center data, kalau dari db sudah ada nilainya, maka pakai variabel ini
    var RouteMainList = [];//digunakan di bagian route, pada saat ngeload data order number atau add/remove to
    var RouteAdditionalList = [];//digunakan di bagian route, pada saat ngeload data order number atau add/remove to
    var TOList = [];//digunakan sebagai list to yang ada
    //var TransportRouteDefaultLoadList = [];//tempat tampung data yang sudah tersave
    var route = 0;//digunakan untuk checkbox route id, digunakan hanya untuk membedakan karena start location dan finish location bisa sama

    var DisplayRouteMainList = [];//digunakan untuk tampilan route detail bagian main route
