    function getRandomColor(listGeneratedColor) {
        var letters = '0123456789ABCDEF';
        var color = '';
        //console.log(listGeneratedColor);
        do {
            color = '#';
            for (var i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            if (listGeneratedColor.length == 0)
                listGeneratedColor.push(color);
        }
        while (listGeneratedColor.indexOf(color) > -1 || listGeneratedColor.length == 0)
        listGeneratedColor.push(color);
        return color;
    }

    function searchDuplicate(arr) {
        var result = [];
        var obj = {};
        for (var c = 0; c < arr.length; c++) {
            if (!obj[arr[c]])
                obj[arr[c]] = 0;
            obj[arr[c]] += 1;
        }
        Object.keys(obj).forEach(function (key, index) {
            if (obj[key] >= 2)
                result.push(key);
        });
        return result;
    }
