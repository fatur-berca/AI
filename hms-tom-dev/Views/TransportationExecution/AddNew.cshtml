</div>

<script src="@Url.Content("~/Scripts/ez.js")"></script>

<script type="text/javascript">
    var filter = new Object();
    var dialog;
    var idCheckBox = 0;
    var prevID = 0;
    var executionType = "";//digunakan untuk data tabel, mennyembunyikan atau menampilkan data yang ada
    var orderNumber = "";//digunakan untuk data tabel, mennyembunyikan atau menampilkan data yang ada
    var orderType = "";//digunakan untuk data tabel, mennyembunyikan atau menampilkan data yang ada
    var sender = "";//digunakan untuk data tabel, mennyembunyikan atau menampilkan data yang ada
    var receiver = "";//digunakan untuk data tabel, mennyembunyikan atau menampilkan data yang ada
    var vehicleType = "";//digunakan untuk data tabel, mennyembunyikan atau menampilkan data yang ada
    var shipmentDate = "";//digunakan untuk data tabel, mennyembunyikan atau menampilkan data yang ada
    var remark = "";//digunakan untuk data tabel, mennyembunyikan atau menampilkan data yang ada
    var seqNo = 0;//digunakan untuk data tabel, mennyembunyikan atau menampilkan data yang ada
    var transNumber = "";
    var idVendor = "";

    var tempIDGenerateTN = [];//digunakan untuk generate TN
    var tempCheckIDGenerateTN = [];//digunakan untuk pengecekan pada saat generate TN
    var duplicateTO = [];//digunakan untuk menandakan to mana saja yang duplicate
    var listColor = [];//supaya tidak ada warna yang sama
    var IsAdminWarehouse = '@ViewBag.IsAdminWarehouse' == 'True';

    $(function () {
        if (IsAdminWarehouse) $('#FilterZone').val("Area");
        //$("#FilterOrderType").val($("#FilterOrderType option:last").val());
        $("#FilterOrderType").val("Finished Good");
        $("#FilterOrderType").select2({ width: '100%' });
        $("#FilterSender").select2({ width: '100%' });

        $(".vSuggest").select2({});
        var id = $("a.executiontype.disabled").attr("id");
        loadDataTable(id, 0, 0);
        resetParam();
        $('.horizontal-execution-type').find('a.disabled').find('.tabTransportationExecutionList').css('border-bottom', '2px solid grey');
    });
    $('#modalGenerateTN').on('hidden.bs.modal', function () {
        $('#StartLocationGenerateTN').select2("close");
    });
    $("#btnSearch").click(function () {
        var FilterOrderType = $("#FilterOrderType").val();
        if(FilterOrderType == null){
            $("#textModalError").html("");
            $("#textModalError").append("Please select Order Type");
            $('#modalerror').modal('show');
        } else {
            var id = $("a.executiontype.disabled").attr("id");
            loadDataTable(id, 0, 0);
            resetParam();
        }
    });
    $(".executiontype").click(function () {
        //reinit temp var
        tempIDGenerateTN = [];
        tempCheckIDGenerateTN = [];

        //unchecked checkbox select all
        $('#SelectAllChk').prop('checked', false);

        $(".executiontype").each(function () {
            $(this).removeClass('disabled');
        });
        $(this).addClass('disabled');
        $('.tabTransportationExecutionList').css('border-bottom', '');
        $(this).find('.tabTransportationExecutionList').css('border-bottom', '2px solid grey');
        var id = $(this).attr('id');
        loadDataTable(id, 0, 0);
        resetParam();
    });

    /*function setTabList(param) {
        loadDataTable();
        resetParam();
    }*/
    var vendorSuggestion = [];
    function resetParam() {
        idCheckBox = 0;
        prevID = 0;
        executionType = "";
        orderNumber = "";
        orderType = "";
        sender = "";
        receiver = "";
        vehicleType = "";
        shipmentDate = "";
        remark = "";
        seqNo = 0;
        transNumber = "";
        idVendor = "";
        vendorSuggestion = [];
    }

    function loadDataTable(param, idCheckBox, prevID) {
        //console.log(param);
        dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...Loading Data</div>',
            closeButton: false
        });
        if (param == "With TN") {
            $("#btnPopUpGenerateTN").prop("disabled", true);
            $("#btnSave").prop("disabled", false);
        } else {
            $("#btnPopUpGenerateTN").prop("disabled", false);
            $("#btnSave").prop("disabled", true);
        }

        var FilterZone = "ALL";
        if ($("#FilterZone").val() != "") {
            FilterZone = $("#FilterZone").val();
        }
        var FilterOrderType = "";
        if ($("#FilterOrderType").val() != "") {
            FilterOrderType = $("#FilterOrderType").val();
        }
        var FilterWeek = $("#FilterWeek").val();
        var FilterYear = $("#FilterYear").val();
        var FilterSender = "";
        if ($("#FilterSender").val() != "") {
            FilterSender = $("#FilterSender").val();
        }
        var FilterVehicleType = "ALL";
        if ($("#FilterVehicleType").val() != "") {
            FilterVehicleType = $("#FilterVehicleType").val();
        }
        //executionType = param;
        filter.executionTypeFilter = param;
        filter.zoneFilter = FilterZone;
        filter.orderTypeListFilter = FilterOrderType;
        filter.weekFilter = FilterWeek;
        filter.yearFilter = FilterYear;
        filter.senderListFilter = FilterSender;
        filter.vehicleTypeFilterA = FilterVehicleType;
        //console.log(filter);
        if (param == "With TN") {
            $(".map-deck").attr("hidden", false);
            loadTotalVendor();
        } else {
            $(".map-deck").attr("hidden", true);
        }
        //idCheckBox = 0;
        //prevID = 0;
        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetTransportExecutionAddNewList", "TransportationExecution")',
            cache: false,
            data: { input: filter },
            async: true,
            success: function (json) {
                //var concat = "5-20-43";
                vendorSuggestion = [];
                var table = $('#dtFilterMaster').DataTable({
                    'destroy': true,
                    data: json,
                    'paging': false,
                    'sort': false,
                    'searching': true,
                    "iDisplayLength": 25,
                    //aaSorting: [[1, 'asc']],
                    columns: [
                        {
                            'data': 'IDCheck', "class": "text-center", "render": function (data, type, row) {
                                if (idCheckBox != row["IDCheck"]) {
                                    idCheckBox = row["IDCheck"];
                                    if ((!row["TransportationNumber"] && param != "With TN") || (param == "With TN" && !row["IDVendor"])) {
                                        return '<td><div class="checkbox-deck"><input type="checkbox" id="' + row["IDCheck"] + '" data-to="' + row["ConcatIDTransportOrder"] + '" class="chkList"><label for="' + row["IDCheck"] + '"></label></div></td>';
                                    }
                                    else {
                                        return '';
                                    }
                                } else {
                                    return '';
                                }
                            }
                        },
                        {
                            'data': 'OrderNumber', 'searchable': true, "render": function (data, type, row) {
                                if (param == "Next Day" || param == "ALL" || param == "With TN" || param == "Without TN") {
                                    if (orderNumber != row["OrderNumber"] || prevID != row["IDTransportOrder"]) {
                                        orderNumber = row["OrderNumber"];
                                        return row["OrderNumber"];
                                    } else
                                        return '';
                                }
                                return row["OrderNumber"];
                            }
                        },
                        {
                            'data': 'TransportationNumber', 'searchable': true, 'visible': false, "render": function (data, type, row) {
                                //if (param == "ALL" || param == "With TN") {
                                    if (transNumber != row["TransportationNumber"] || prevID != row["IDTransportOrder"] || transNumber == "") {
                                        transNumber = row["TransportationNumber"];
                                        return row["TransportationNumber"];
                                    } else
                                        return '';
                                //}
                                return '';
                            }
                        },
                        {
                            'data': 'TNCreator', 'searchable': true, 'visible': false, "render": function (data, type, row) {
                                if (prevID != row["IDTransportOrder"]) {
                                    return row["TNCreator"];
                                } else
                                    return '';
                                return '';
                            }
                        },
                        {
                            'data': 'IDVendor', 'searchable': true, 'visible': false, "render": function (data, type, row) {
                                if (param == "With TN" && !row["IsHeader"]) {
                                    if (row["IsTNHeader"])
                                        return row["VendorName"];
                                    else
                                        return '';
                                }
                                if (param == "With TN" && !row["IDVendor"]) {
                                    var selectedx = row["IDVendorSuggestion"];
                                    //console.log(selectedx);
                                    var ListVendorSuggest = getVendor(row["IDCheck"]);
                                    var listVendor = '<select class="select2 vSuggest" id="Vendor' + row["IDCheck"] + '">';
                                    if (ListVendorSuggest.length > 0) {
                                        for (var j = 0; j < ListVendorSuggest[0].length; j++) {
                                            if (ListVendorSuggest[0][j].IDVendor == selectedx)
                                                listVendor += '<option value="' + ListVendorSuggest[0][j].IDVendor + '" selected>' + ListVendorSuggest[0][j].VendorName + '</option>';
                                            else
                                                listVendor += '<option value="' + ListVendorSuggest[0][j].IDVendor + '">' + ListVendorSuggest[0][j].VendorName + '</option>';
                                        }
                                    }
                                    listVendor += '</select>';
                                    return listVendor;
                                } else {
                                    return row["VendorName"];
                                }
                            }
                        },
                        {
                            'data': 'ShipmentDate', 'searchable': true, "render": function (data, type, row) {
                                if (param == "Next Day" || param == "ALL" || param == "With TN" || param == "Without TN") {
                                    if (shipmentDate != row["ShipmentDate"] || prevID != row["IDTransportOrder"] || orderNumber != row["OrderNumber"]) {
                                        shipmentDate = row["ShipmentDate"];
                                        return moment(row["ShipmentDate"]).format("DD-MMM-YYYY");
                                    } else
                                        return '';
                                }
                                return moment(row["ShipmentDate"]).format("DD-MMM-YYYY");
                            }
                        },
                        {
                            'data': 'Sequence', 'searchable': true, "render": function (data, type, row) {
                                if (param == "Next Day" || param == "ALL" || param == "With TN" || param == "Without TN") {
                                    if (seqNo != row["Sequence"] || prevID != row["IDTransportOrder"] || orderNumber != row["OrderNumber"]) {
                                        seqNo = row["Sequence"];
                                        return row["Sequence"];
                                    } else
                                        return '';
                                }
                                return row["Sequence"];
                            }
                        },
                        {
                            'data': 'OrderType', 'searchable': true, "render": function (data, type, row) {
                                if (param == "Next Day" || param == "ALL" || param == "With TN" || param == "Without TN") {
                                    if (orderType != row["OrderType"] || prevID != row["IDTransportOrder"] || orderNumber != row["OrderNumber"]) {
                                        orderType = row["OrderType"];
                                        return row["OrderType"];
                                    } else
                                        return '';
                                }
                                return row["OrderType"];
                            }
                        },
                        {
                            'data': 'Sender', 'searchable': true, "render": function (data, type, row) {
                                if (param == "Next Day" || param == "ALL" || param == "With TN" || param == "Without TN") {
                                    if (sender != row["Sender"] || prevID != row["IDTransportOrder"] || orderNumber != row["OrderNumber"]) {
                                        sender = row["Sender"];
                                        return row["Sender"];
                                    } else
                                        return '';
                                }
                                return row["Sender"];
                            }
                        },
                        {
                            'data': 'Receiver', 'searchable': true, "render": function (data, type, row) {
                                if (param == "Next Day" || param == "ALL" || param == "With TN" || param == "Without TN") {
                                    if (receiver != row["Receiver"] || prevID != row["IDTransportOrder"] || orderNumber != row["OrderNumber"]) {
                                        receiver = row["Receiver"];
                                        return row["Receiver"];
                                    } else
                                        return '';
                                }
                                return row["Receiver"];
                            }
                        },
                        {
                            'data': 'OrderedVehicleType', 'searchable': true, "render": function (data, type, row) {
                                if (param == "Next Day" || param == "ALL" || param == "With TN" || param == "Without TN") {
                                    if (vehicleType != row["OrderedVehicleType"] || prevID != row["IDTransportOrder"] || orderNumber != row["OrderNumber"]) {
                                        vehicleType = row["OrderedVehicleType"];
                                        return row["OrderedVehicleType"];
                                    } else
                                        return '';
                                }
                                return row["OrderedVehicleType"];
                            }
                        },
                        { 'data': 'MaterialType', 'searchable': true },
                        { 'data': 'Description', 'searchable': true },
                        { 'data': 'Qty', 'searchable': true },
                        { 'data': 'UoM', 'searchable': true },
                        {
                            'data': 'OrderRemarks', 'searchable': true, "render": function (data, type, row) {
                                if (prevID != row["IDTransportOrder"]){
                                    return row["OrderRemarks"];
                                }
                                return '';
                            }
                        },
                        { 'data': 'OrderCreator', 'searchable': true },
                        { 'data': 'UpdatedDate', "render": function (data, type, row) {
                            if (prevID != row["IDTransportOrder"])
                                prevID = row["IDTransportOrder"];
                            return moment(row["UpdatedDate"]).format("DD-MMM-YYYY HH:mm");
                            }
                        }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true,
                    "createdRow": function(row, data, index) {
                        $('td', row).addClass('color-' + data["IDCheck"] + "-" + data["IDTransportOrder"]);
                        $('td', row).addClass('error-generateTN');
                    }
                });
                $('.dataTables_filter input').attr("placeholder", "Search Here");
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if (param == "With TN") {
                        if ((index >= 1) && (index < 18)) {
                            var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                            $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                        }
                        if (index > 14) {
                            $('#dtFilterMaster thead.filters th:eq(' + index + ')').show();
                        }
                    } else {
                        if ((index >= 1) && (index < 15)) {
                            var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                            $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                        }
                        if(index > 14){
                            $('#dtFilterMaster thead.filters th:eq('+ index +')').hide();
                        }
                    }
                });
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible').search(this.value).draw(false);
                    });
                });
                if (param == "With TN") {
                    table.columns([2, 3, 4]).visible(true, true);
                    table.columns.adjust().draw(true);
                }
                $(".vSuggest").select2();
                /*for (var i = 0 ; i < 14 ; i++) {
                    $('#dtFilterMaster thead.filters th:eq(' + i + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible').search(this.value).draw(false);
                    });
