@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.Transport.TransportExecutionViewModel
@{
    ViewBag.Title = "Transport > Transportation Execution > New TN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .tabTransportationExecutionList {
        font-size: 20px;
        cursor: pointer;
        margin-right: 50px;
    }

    a.disabled {
        color: gray;
        pointer-events: none;
        cursor: default;
    }

    .horizontal-execution-type {
        white-space: nowrap;
        overflow: auto;
    }

    .hidden {
        display: none;
    }

    #dtFilterMaster {
        border-collapse: collapse;
        border-spacing: 0;
    }

        #dtFilterMaster > td + td {
            border-left: 0;
        }

    .padding-filter {
        padding-right: 0;
    }

    .checkbox-deck label {
        width: 17px !important;
        height: 17px;
    }
</style>
<div class="filter-deck">
    <div class="button-wrap pull-left">
        <button class="btn btn-purple" onclick="window.location.href = '@Url.Action("Index", "TransportationExecution")'">Back</button>
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.GenerateTN)))
        {
            <button class="btn btn-primary" type="button" id="btnPopUpGenerateTN" data-toggle="modal">Generate TN</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Save)))
        {
            <button type="button" class="btn btn-primary" id="btnSave">Save</button>
        }
    </div>
</div>

<div class="filter-deck nmb">
    <div id="filter" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel">
            <div class="row">
                @Html.DropDownListFor(model => Model.vendorList, Model.vendorList, new { @class = "form-control hidden", @id = "VendorListHidden" })
                <div class="col-md-2 padding-filter">
                    <div class="form-group">
                        <label>Zone</label>
                        @*<select class="form-control" id="FilterZone"></select>*@
                        @Html.DropDownListFor(model => Model.zoneList, Model.zoneList, new { @class = "form-control", @id = "FilterZone" })
                    </div>
                </div>
                <div class="col-md-2 padding-filter">
                    <div class="form-group">
                        <label>Order Type</label>
                        @*<select class="select2" multiple="multiple" id="FilterSTONumber"></select>*@
                        @Html.DropDownListFor(model => Model.orderTypeList, Model.orderTypeList, new { @multiple = "multiple", @id = "FilterOrderType" })
                    </div>
                </div>
                <div class="col-md-1 padding-filter">
                    <div class="form-group">
                        <label>Week</label>
                        @*<select class="form-control" id="FilterWeek"></select>*@
                        @Html.DropDownListFor(model => Model.weekNow,
         new SelectList(Enumerable.Range(1, 53).Select(r => new { Text = r.ToString(), Value = r }), "Value", "Text", Model.ListWeeks), new { @class = "form-control", id = "FilterWeek" })
                    </div>
                </div>
                <div class="col-md-1 padding-filter">
                    <div class="form-group">
                        <label>Year</label>
                        @*<select class="form-control" id="FilterYear"></select>*@
                        @Html.DropDownListFor(model => Model.yearNow,
         new SelectList(Enumerable.Range(-1, 3).Select(r => new { Text = (DateTime.Now.Year + r).ToString(), Value = DateTime.Now.Year + r }), "Value", "Text", Model.ListYears), new { @class = "form-control", id = "FilterYear" })
                    </div>
                </div>
                <div class="col-md-2 padding-filter">
                    <div class="form-group">
                        <label>Sender</label>
                        @*<select class="form-control" id="FilterSender"></select>*@
                        @Html.DropDownListFor(model => Model.locationList, Model.locationList, new { @multiple = "multiple", @id = "FilterSender" })
                    </div>
                </div>
                <div class="col-md-2 padding-filter">
                    <div class="form-group">
                        <label>Ordered Vehicle Type</label>
                        @*<select class="form-control" id="FilterVehicleType"></select>*@
                        @Html.DropDownListFor(model => Model.vehicleTypeList, Model.vehicleTypeList, new { @multiple = "multiple", @class = "select2", @id = "FilterVehicleType" })
                    </div>
                </div>
                <div class="col-md-1 padding-filter">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <button type="button" class="btn btn-primary" id="btnSearch">Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="title-deck wmb">
</div>

<div class="title-deck wmb horizontal-execution-type">
    @foreach (var x in Model.executionTypeList)
    {
        if (x.Value == "ALL")
        {
            <a id="@x.Value" class="executiontype disabled"><label class="tabTransportationExecutionList">@x.Value</label></a>
        }
        else
        {
            <a id="@x.Value" class="executiontype"><label class="tabTransportationExecutionList">@x.Value</label></a>
        }
    }
</div>
<table id="dtFilterMaster" class="display table dataTable">
    <thead>
        <tr>
            <th width="5%" class="text-center">
                <div class="checkbox-deck">
                    <input type="checkbox" id="SelectAllChk">
                    <label for="SelectAllChk"></label>
                </div>
            </th>
            <th>Order Number</th>
            <th>Transportation Number</th>
            <th>TN Creator</th>
            <th>Vendor</th>
            <th>Shipment Date</th>
            <th>Sequence</th>
            <th>Order Type</th>
            <th>Sender</th>
            <th>Receiver</th>
            <th>Ordered Vehicle Type</th>
            <th>Material Type</th>
            <th>Description</th>
            <th>Qty</th>
            <th>UoM</th>
            <th>Order Remarks</th>
            <th>Order Creator</th>
            <th>Submitted</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th width="5%" nowrap class="text-center">Filter</th>
            <th>Order Number</th>
            <th>Transportation Number</th>
            <th>TN Creator</th>
            <th>Vendor</th>
            <th>Shipment Date</th>
            <th>Sequence</th>
            <th>Order Type</th>
            <th>Sender</th>
            <th>Receiver</th>
            <th>Ordered Vehicle Type</th>
            <th>Material Type</th>
            <th>Description</th>
            <th>Qty</th>
            <th>UoM</th>
            <th>Order Remarks</th>
            <th>Order Creator</th>
            <th>Submitted</th>
        </tr>
    </thead>
</table>

<div class="modal fade" id="modalGenerateTN" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <form id="frmExportPickingList">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group">
                                <label>Start Location</label>
                                @*<select class="form-control" id="StartLocationGenerateTN"></select>*@
                                @Html.DropDownListFor(model => Model.locationList, Model.locationList, new { @id = "StartLocationGenerateTN" })
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label>Transportation Mode</label>
                                @*<select class="form-control" id="TransportationModeGenerateTN"></select>*@
                                @Html.DropDownListFor(model => Model.transportationModeList, Model.transportationModeList, new { @class = "form-control", @id = "TransportationModeGenerateTN" })
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button id="btnGenerateTN" class="btn btn-primary">Generate</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="../assets/images/checked.png" alt="">
                <span id="textModalSucess"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnConfirmation" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="../assets/images/cancel.png" alt="">
                <span id="textModalError"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Notification Modal -->
<div id="notificationModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
