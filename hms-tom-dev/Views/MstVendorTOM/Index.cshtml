
@{
    ViewBag.Title = "Master Data > Master Vendor TOM";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#inputModal">Add New</button>
    </div>
</div>
<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr>
            <th width=5% nowrap class="text-center">Active</th>
            <th>Parent</th>
            <th>Name</th>
            <th>Region</th>
            <th>Address</th>
            <th hidden>CC</th>
            <th hidden>Email</th>
            <th>Vendor Category</th>
            <th>Transportation Mode</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center">Action</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th width=5% nowrap class="text-center">Filter</th>
            <th>Parent</th>
            <th>Name</th>
            <th>Region</th>
            <th>Address</th>
            <th hidden>CC</th>
            <th hidden>Email</th>
            <th>Vendor Category</th>
            <th>Transportation Mode</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center"></th>
        </tr>
    </thead>
</table>

<!-- Modal -->
<div class="modal fade" id="inputModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Vendor</h4>
            </div>
            <div class="modal-body">
                <div id="fieldChooser" tabindex="1" class="field-chooser">
                    <div class="col-md-12">
                        <div class="box sameHeight">
                            <form id="newData">
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>InsertOrUpdate</label>
                                            <input type="text" id="InsertOrUpdate" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>IDVendor</label>
                                            <input type="text" id="IDVendor" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Parent</label>
                                            <select class="form-control" id="ParentId"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Name</label>
                                            <input type="text" id="Name" class="form-control input">
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Region</label>
                                            <select class="form-control input" id="Region">
                                                <option value=""></option>
                                                <option value="EAST">EAST</option>
                                                <option value="WEST">WEST</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Address</label>
                                            <textarea id="Address" class="form-control" maxlength="100"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Province</label>
                                            <select type="text" id="Province" class="form-control input"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>City</label>
                                            <select type="text" id="City" class="form-control input"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Vendor Category</label>
                                            <select class="form-control input" id="Category"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Transportation Mode</label>
                                            <select class="form-control input" id="TransMode"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Active</label>
                                            <select class="form-control input" id="Status">
                                                <option value="1">YES</option>
                                                <option value="0">NO</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>Vendor Email</label>
                                            <input type="text" id="EmailVendor" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>Sampoerna PIC Email</label>
                                            <input type="text" id="EmailPIC" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>IDVendor</label>
                                            <input type="text" id="IDVendor" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>CreatedDate</label>
                                            <input type="text" id="CreatedDate" class="form-control datepicker">
                                        </div>
                                    </div>
                                </div>
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>CreatedBy</label>
                                            <input type="text" id="CreatedBy" class="form-control">
                                            <input type="hidden" id="IDVendor" />
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveNew">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="setinactive" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Edit Data Confirmation</h4>
            </div>
            <div class="modal-body">
                Are you sure want to Edit Data?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" id="btnSaveYes">Yes</button>

            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">TOM Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/cancel.png" alt="">
                <span id="textModalError"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div id="Loading" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">TOM Notification Center</h4>
            </div>
            <div class="modal-body"><img src="assets/images/loading.gif" alt=""><span> Please wait...</span></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/Scripts/ez.js")"></script>
<script type="text/javascript">
    var mandatoryFields = [$("#Name"), $("#Region"), $('#City'), $('#Category'), $('#TransMode'), $('#Status')];
    //var mandatoryFields = $("input");
    var parentIDList;
    var regionList = ["East", "West"];

    ez.Form.AddField(
        "Name:req>#VendorName",
        "Region:doe>#VendorRegion",
        "City:>#VendorCity",
        "Category:req doe>#VendorCategory",
        "TransMode:req doe>Transportation Mode#TransportationMode",
        "Province:>#VendorProvince",
        "Status:req bool>Active#IsActive",
        "EmailVendor:mlist>Vendor Email#VendorEmail",
        "EmailPIC:mlist>Sampoerna PIC Email#CC",
        "ParentId:doe>#ParentVendor",
        "Address:>#VendorAddress"
    );

    $(document).ready(function () {
        ez.debugMode = true;
        ez.Form.RegisterDropDown("Category", "@Url.Action("GetDropDownVendorCategory")", "FieldValue", "FieldValue");
        ez.Form.RegisterDropDown("TransMode", "@Url.Action("GetDropDownTransportationMode")", "FieldValue", "FieldValue");
        ez.Form.RegisterDropDown("ParentId", "@Url.Action("GetParentVendorTOM")", "IDVendor", "VendorName");
        ez.Form.RegisterDropDown("City", "@Url.Action("GetCities")", "MapTo", "MapTo");
        ez.Form.RegisterDropDown("Province", "@Url.Action("GetProvinces")", "FieldValue", "FieldValue");
        ez.Form.RegisterDropDown("Region", regionList);

        $('#addNew').click(function () {
            $('#InsertOrUpdate').val("INSERT");
            resetData();

            ez.Form.RefreshDropDown("Category");
            ez.Form.RefreshDropDown("TransMode");
            ez.Form.RefreshDropDown("ParentId");
            ez.Form.RefreshDropDown("Region");
            ez.Form.RefreshDropDown("City");
            ez.Form.RefreshDropDown("Province");
            ez.Form.Enable("doe");
        });
    });

    function resetData(){
        $('#newData')[0].reset();
        ez.Form.Clear();
    }

    var notriggerProvince = false;
    $("#Province").on("change", function () {
        $("#City").html('');
        var prov = $(this).val();
        if (prov != '' && prov != null && prov != 'ez:null' && !notriggerProvince)
        {
            ez.Form.SetDropDownDataSource("City", '@Url.Action("GetCities")?prov=' + prov);
            ez.Form.RefreshDropDown("City", null);
        }
    });

    // BEGIN : JQUERY SELECT TO DataTable
    generateTable();

    function generateTable() {
        $.ajax({
            url: 'MstVendorTOM/GetMasterVendorTOM',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (json) {
                parentIDList = json;
                var table = $('#dtFilterMaster').DataTable({
                    'destroy': true,
                    data: json,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "iDisplayLength": 25,
                    aaSorting: [[5, 'desc']],
                    columns: [
                        {
                            "data": "IsActive", "class": "text-center", 'sortable': false, "render": function (data) {
                                if (data == true) {
                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }
                            }
                        },
                        {
                            'data': function (row, type, set) {
                                var prtName = '-';
                                if (row.ParentVendor)
                                {
                                    $.each(parentIDList, function (key, val) {
                                        if (val.IDVendor == row.ParentVendor)
                                            prtName = val.VendorName;
                                    });
                                }
                                return prtName;
                            }
                        },
                        { 'data': 'VendorName', 'searchable': true },
                        { 'data': 'VendorRegion', 'searchable': true },
                        { 'data': 'VendorAddress', 'searchable': true },
                        { 'data': 'CC', 'class': 'hidden'},
                        { 'data': 'VendorEmail', 'class': 'hidden' },
                        { 'data': 'VendorCategory', 'searchable': true },
                        { 'data': 'TransportationMode', 'searchable': true },
                        {
                            render: function (data, type, row) {
                                var jamtanggal = moment(row['UpdatedDate']).format("DD-MMM-YYYY HH:mm");
                                return '<label hidden>' + row['UpdatedDate'] + '</label>by ' + row['UpdatedBy'] + ' on ' + jamtanggal;
                            }
                        },
                        { 'data': 'UpdatedDate', 'class': 'hidden' },
                        {
                            "data": "IDVendor", 'sortable': false, "class": "text-center", "render": function (data) {
                                return '<div ><a href="#" id="editForm" onclick="editTable(' + data + ')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a></div>';
                            }
                        },
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 1) && (index < 10)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });
            }
        });
    }
    // END : JQUERY SELECT TO DataTable

    // BEGIN :JQUERY INSERT DROPDOWN
    function generateDropDown(selectedValueCategory, selectedValueTransmode, selectedValueParent, selCity, selProvince) {
        // here for backward compatibility
        ez.Form.RefreshDropDown("Category", selectedValueCategory);
        ez.Form.RefreshDropDown("TransMode", selectedValueTransmode);
        ez.Form.RefreshDropDown("City", selCity);
        ez.Form.RefreshDropDown("Province", selProvince);
        generateDropDownParentId(selectedValueParent);
    }
    // END :JQUERY INSERT DROPDOWN

    // BEGIN :JQUERY INSERT DROPDOWN Parent ID
    function generateDropDownParentId(selectedValue) {
        // here for backward compatibility
        ez.Form.RefreshDropDown("ParentId", selectedValue);
    }
    // END :JQUERY INSERT DROPDOWN Parent ID

    // BEGIN : Insert New Data
    $('#btnSaveYes').click(function () {
        save(false);
    });

    function Validate()
    {
        if (ez.Form.Validate())
        {
            return true;
        }
        $("#textModalError").html("");
        $("#textModalError").append(ez.Form.error);
        $('#modalerror').modal('show');
        return false;
    }

    $('#btnSaveNew').click(function () {
        if ($('#InsertOrUpdate').val() == "UPDATE") {
            if (Validate())
                $('#setinactive').modal('show');
        } else {
            save(true);
        }
    });

    // BEGIN : Save Data
    function save(statusSave) {
        $('#setinactive').modal('hide');
        var pull_data = [ez.Form.GetData()];
        if (Validate()) {
            if (!statusSave) {
                pull_data[0]["CreatedBy"] = $("#CreatedBy").val();
                pull_data[0]["CreatedDate"] = $('#CreatedDate').val();
                pull_data[0]["IDVendor"] = $('#IDVendor').val();
            }
            var data = {
                "new": statusSave ? pull_data : [{}],
                "edit": !statusSave ? pull_data : [{}]
            }
            console.log(data);
            $.ajax({
                type: 'POST',
                url: 'MstVendorTOM/InsertList',
                data: data,
                dataType: "json",
                success: function (returnVal) {
                    console.log(returnVal);
                    if (returnVal.IsSuccess) {
                        generateTable();
                        $('#modalsuccess').modal('show');
                        resetData();
                        $('#inputModal').modal('hide');
                    }
                    else
                    {
                        $("#textModalError").html("");
                        $("#textModalError").append('<strong style="font- size:larger">Failed to save data!</strong><br/>' + returnVal.ErrorMessage);
                        $('#modalerror').modal('show');
                    }
                },
                error: function (msg) {
                    $("#textModalError").html("");
                    $("#textModalError").append("Failed to save data.");
                    $('#modalerror').modal('show');
                }
            });
        }
    }
    // END : Save Data

    //BEGIN : Edit Data
    function editTable() {
        DisabledField();
        $('#newData')[0].reset();
        $('#InsertOrUpdate').val("UPDATE");
        var table = $('#dtFilterMaster').DataTable();
        $('#dtFilterMaster tbody').one('click', 'tr', function () {
            var data = table.row(this).data();
            if (ez.debugMode)
            console.log("Edit data: ", data);
            ez.Form.SetData(data);
            $('#CreatedDate').val(ToJavaScriptDate(data["CreatedDate"]));
            $('#CreatedBy').val(data["CreatedBy"]);
            $('#IDVendor').val(data["IDVendor"]);
            if (data["IsActive"])
                $('#Status').val("1");
            else
                $('#Status').val("0");

            notriggerProvince = true;
            ez.Form.RefreshDropDown("Province", data["VendorProvince"], function () {
                ez.Form.SetDropDownDataSource("City", '@Url.Action("GetCities")?prov=' + data["VendorProvince"]);
                ez.Form.RefreshDropDown("City", data["VendorCity"]);
                notriggerProvince = false;
            });
            ez.Form.RefreshDropDown("Category", data["VendorCategory"]);
            ez.Form.RefreshDropDown("TransMode", data["TransportationMode"]);
            ez.Form.RefreshDropDown("ParentId", data["ParentVendor"], function (data, dv) {
                if (!$("#ParentId").val())
                {
                    $(parentIDList).each(function (key, val) {
                        if (val["IDVendor"] == dv && !val["IsActive"])
                        {
                            $("#ParentId").append('<option value="' + val["IDVendor"] + '">' + val["VendorName"] + '</option>');
                            $("#ParentId").val(dv).trigger("change");
                        }
                    });
                }
            });
            ez.Form.RefreshDropDown("Region", data["VendorRegion"]);
        });
        $('#inputModal').modal('show');
    }
    // END : Edit Data

    function ToJavaScriptDate(value) {
        var pattern = /Date\(([^)]+)\)/;
        var results = pattern.exec(value);
        var dt = new Date(parseFloat(results[1])).toISOString();
        return dt;
    }

    function DisabledField() {
        ez.Form.Disable("doe");
    }

    function EnabledField() {
        ez.Form.Enable("doe");
    }
</script>