﻿@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "General > Building & Facility > Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .txt-invalid {
        border: 1px solid red !important;
    }

    .form-group {
        overflow: visible !important;
    }
</style>
<div class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="title-deck wmb">
                <button class="btn btn-purple" onclick="window.location.href = 'InteractiveMap?b=' + gup('b')">Back</button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="row">
                    <div class="col-md-8">
                        <div class="canvas-container">
                            <canvas id="c" width="700" height="500"></canvas>

                            <ul class="btn-wrap">
                                <li><a href="#" id="btnZoomIn"><i class="fa fa-search-plus"></i></a></li>
                                <li><a href="#" id="btnZoomOut"><i class="fa fa-search-minus"></i></a></li>
                                <li><a href="#" id="btnResetZoom"><i class="fa fa-refresh"></i></a></li>
                                <li><a href="#" id="btnPanModeByMouse"><i class="fa fa-hand-paper-o"></i></a></li>
                                <span id="zoomByMouseStatus" style="border: 1px solid blue; color: blue; background-color: yellow; display: none;">No-Zoom</span>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Floor</label>
                                        <select class="form-control" id="ddfloor"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Upload Map</label>
                                <input type="file" name="" class="filestyle" onchange="setBackground(event)">
                            </div>

                            <div class="row">
                                <div class="col-md-5">
                                    <div class="form-group">
                                        <label>Shape Type</label>
                                        <select class="form-control big-padding" id="sharp">
                                            <option>Rectangle</option>
                                            <option>Circle</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Color</label>
                                        <input type="color" value="#F67300" class="form-control" id="sharpColor" onchange="changeSharpColor()">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Label</label>
                                        <input type="text" class="form-control big-padding" placeholder="Hms Office" id="labels" onchange="changeLabel()">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-5">
                                    <div class="form-group">
                                        <label>Font Size</label>
                                        <input type="number" class="form-control big-padding" placeholder="18px" id="fontSize" onchange="changeLabelSize()">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Color</label>
                                        <input type="color" value="#333333" class="form-control" id="fontColor" onchange="changeTextColor()">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>&nbsp;</label>
                                        <button class="btn btn-primary" id="create" onclick="AddSharp()"><i class="fa fa-plus"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Equipment</label>
                                        <select class="form-control" id="equipment"></select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Total</label>
                                        <div class="form-group">
                                            <input type="number" class="form-control" id="length">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <div class="form-group">
                                        <label>&nbsp;</label>
                                        <div class="form-group">
                                            <button class="btn btn-primary" id="buttonAdd"><i class="fa fa-plus"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <button class="btn btn-primary" onclick="save()">Save</button>
                            <input type="button" class="btn btn-red" onclick="remove()" value="Delete" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12" style="display: none;">
            <table id="dtFilter" class="display table dataTable">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Object</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>CCTV</td>
                        <td><span id="cctvVal">0</span></td>
                        <td><button class="btn btn-primary">Open Apps</button></td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Fire Extinguisher</td>
                        <td><span id="fireVal">0</span></td>
                        <td><button class="btn btn-primary">Open Apps</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="Loading" class="modal fade" role="dialog">
