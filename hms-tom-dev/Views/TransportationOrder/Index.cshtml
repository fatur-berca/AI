    $("#btnUpload").on("click", function () {
        $("#mdlUpload").modal("show");
        $("#fileInput").jfilestyle('clear');
    });

    $("#btnUploadFile").on("click", function () {
        ez.Modals.BeginLoading();
        if ($("#fileInput").val() == '' || $("#fileInput").val() == null) {
            ez.Modals.EndLoading();
            ez.Modals.Error.show("Please select file first!");
            return;
        }
        if (window.FormData) {
            var fileData = new FormData();
            var fileUpload = document.getElementById('fileInput').files;
            if (fileUpload.length > 0) {
                fileUpload = fileUpload[0];
                fileData.append('FileUpload', fileUpload);
            } else {
                ez.Modals.EndLoading();
                ez.Modals.Error.show("No file to be uploaded!");
                return;
            }
            $.ajax(
                {
                    type: 'POST',
                    url: '@Url.Action("UploadTO")',
                    data: fileData,
                    cache: false,
                    contentType: false,
                    processData: false,
                    success: function (res) {
                        console.log("Upload Response:", res);
                        ez.Modals.EndLoading();
                        if (res.IsSuccess === undefined || res.IsSuccess === true) {
                            $("#fileInput").jfilestyle('clear');
                            $("#mdlUpload").modal("hide");

                            ez.Modals.Notif.show("Upload success!");
                            loadDataTable();
                        }
                        else if (res.IsSuccess === false) {
                            ez.Modals.Error.show("<b style=\"font-size:larger\">Upload Failed!</b><br />" + res.ErrorMessage);
                        }
                        else {
                            ez.Modals.Error.show("Failed to upload file!");
                        }
                    },
                    error: function (err) {
                        ez.Modals.EndLoading();
                        ez.Modals.Error.show("Failed to upload file!");
                    }
                }
            );
        }
        setTimeout(function () { $("#mdlUpload").modal("hide"); }, 1000);
    });
</script>