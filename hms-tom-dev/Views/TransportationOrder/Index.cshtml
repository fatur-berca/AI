    function loadDataTable() {
        dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        var filter = {};
        filter.zoneListFilter = $("#FilterZone").val();
        filter.stoNoListFilter = $("#FilterSTONumber").val().split(',');
        filter.senderIdLocListFilter = $("#FilterSender").val();
        filter.receiverIdLocListFilter = $("#FilterReceiver").val();
        filter.dateToFilter = moment($('#FilterToDate').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.dateFromFilter = moment($('#FilterFromDate').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.orderVehicleTypeListFiter = $("#FilterVehicleType").val();
        filter.materialTypeListFilter = $("#FilterMaterialType").val();
        filter.orderStatusListFilter = $("#FilterOrderStatus").val();
        filter.orderTypeListFilter = $("#FilterOrderType").val();

        console.log("filter", filter);

        var table = $('#dtFilterMaster').DataTable({
            "paging": true,
            "ordering": false,
            "filter": true,
            "destroy": true,
            "orderMulti": false,
            "serverSide": true,
            "processing": true,
            "pageLength": 10,
            "ajax": {
                dataType: 'JSON',
                type: 'POST',
                url: '@Url.Action("GetTransportOrderTableList", "TransportationOrder")',
                data: function (data) {
                    data.filter = filter;
                    return data;
                },
                "complete": function (res) {
                    console.log("result", res);
                    dialog.modal('hide');
                },
                "error": function (res) {
                    console.log("error", res);
                    dialog.modal('hide');
                }
            },
            "columns": [
                 {
                    'data': 'IDRequest', "class": "text-center", "render": function (data, type, row, meta) {
                        if (row["IsActive"] == false && row["TotalVehicle"] > 0)
                            return '<input type="checkbox" data-reqno="' + row["RequestNo"] + '" class="chkList">';
                        else
                            return '<td></td>';
                    }
                 },
                {
                    "data": "IsActive", "class": "text-center", "render": function (data) {
                        if (data == true || data == 1) {
                            return '<div><img src="@Url.Content("~/assets/images/circlegreen.png")" alt=""height="15" width="15"></div>';
                        } else { return '<div><img src="@Url.Content("~/assets/images/circlered.png")" alt=""height="15" width="15"></div>'; }
                    }
                 },
                 {
                    'data': 'RequestNo', "render": function (data, type, row, meta) {
                        return '<td><div ><a href="@Url.Action("Edit")?reqno=' + row["RequestNo"] + '" target="_self">' + row["RequestNo"] + '</a></div></td>';
                    }
                 },
                 {
                     'data': 'ShipmentDate', "render": function (data, type, row, meta) {
                         return moment(row["ShipmentDate"]).format("DD-MMM-YYYY");
                    }
                 },
                { 'data': 'TotalVehicle', 'searchable': false },
                { 'data': 'CreatedName', 'searchable': true }
            ],
            orderCellsTop: true
        });
        $('.dataTables_filter input').attr("placeholder", "Search Here");
        $('#dtFilterMaster thead.filters th').each(function (index) {
            if (index > 1) {
                var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
            }
        });

        table.columns().every(function (index) {
            if (index > 0) {
                $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                    table.settings()[0].jqXHR.abort();
                    table.column($(this).parent().index() + ':visible')
                        .search(this.value)
                        .draw();
                });
            }
        });
    }

