<script src="@Url.Content("~/Scripts/ez.js")"></script>
<script type="text/javascript">
    var chk_escape = false;
    function WriteChecks(val)
    {
        $(".chkList").prop("checked", val);
    }
    function ReadChecks()
    {
        var allCheck = true;
        $(".chkList").each(function (idx, ele) {
            if (!$(ele).prop("checked"))
                allCheck = false;
        });
        chk_escape = true;
        $("#SelectAllChk").prop("checked", allCheck);
        chk_escape = false;
    }
    $("#SelectAllChk").on("change", function () {
        if (chk_escape) return;
        WriteChecks($("#SelectAllChk").prop("checked"));
    });


    $("#FilterSTONumber").val("");
    var dialog;
    var filter = new Object();
    var tempIDTO = [];

    $(function () {
        $('#FilterFromDate').val(moment(new Date()).format("DD/MM/YYYY"));
        $('#FilterToDate').val(moment(new Date()).format("DD/MM/YYYY"));
        $("#FilterZone").select2({ width: '100%' });
        $("#FilterOrderType").select2({ width: '100%' });
        $("#FilterVehicleType").select2({ width: '100%' });
        $("#FilterMaterialType").select2({ width: '100%' });
        $("#FilterOrderStatus").select2({ width: '100%' });
        $("#FilterSender").select2({ width: '100%' });
        $("#FilterReceiver").select2({ width: '100%' });
        resetFilterField();
        loadDataTable();
    });

    $("#advsrc").click(function () {
        resetFilterField();
    });

    $("#btnSearch").click(function () {
        advancedSearch();
    });

    $("#btnReset").click(function () {
        resetFilterField();
        advancedSearch();
    });

    /** CUSTOM REPORT - BEGIN **/
    var $dataLayout = {};

    /** FIELD CHOOSER - BEGIN **/
    $("#fieldChooser .ui-draggable").attr("draggable", "true");
    $("#fieldChooser").fieldChooser($("#sourceFields"), $("#destinationFields"));

    $("#layoutSelect").on("change", function () {
        var sel = $("#layoutSelect").val();
        if (sel) {
            linq($dataLayout).do(function (d) {
                if (d.LayoutName == sel) {
                    $("#sourceFields").find(".fc-selected").removeClass("fc-selected");
                    moveAllItems('#destinationFields', '#sourceFields');

                    linq(d.FieldName).do(function (fname) {
                        $("#sourceFields").find("div").each(function (idx, ele) {
                            var fi = $(ele).attr("data-field");
                            if (fname == fi)
                                $(ele).addClass("fc-selected");
                            moveItems('#sourceFields', '#destinationFields');
                        });
                    });

                    $("#destinationFields").find(".fc-selected").removeClass("fc-selected");
                }
            });
        }
        else {
            $("#sourceFields").find(".fc-selected").removeClass("fc-selected");
            moveAllItems('#destinationFields', '#sourceFields');
        }
    });

    $(document).on('click', '#left', function (e) {
        moveItems('#destinationFields', '#sourceFields');
        e.preventDefault();
    });

    $(document).on('click', '#right', function (e) {
        moveItems('#sourceFields', '#destinationFields');
        e.preventDefault();
    });

    $(document).on('click', '#leftall', function (e) {
        moveAllItems('#destinationFields', '#sourceFields');
        e.preventDefault();
    });

    $(document).on('click', '#rightall', function (e) {
        moveAllItems('#sourceFields', '#destinationFields');
        e.preventDefault();
    });

    function moveItems(origin, dest) {
        jQuery(origin).find('.fc-selected').appendTo(dest);
    }

    function moveAllItems(origin, dest) {
        jQuery(origin).children().appendTo(dest);
    }

    $("#fieldChooser .ui-draggable").on("dragstart", function (ev) {
        $(this).addClass("fc-selected");
        ev.originalEvent.dataTransfer.setData("text", "COPY");
    });
    $("#sourceFields,#destinationFields").on("dragover", function (ev) {
        ev.originalEvent.preventDefault();
    });
    $("#sourceFields,#destinationFields").on("drop", function (ev) {
        var data = ev.originalEvent.dataTransfer.getData("text");
        if (data == "COPY")
            moveItems("#" + $(ev.originalEvent.srcElement).parent().attr("id"), "#" + $(this).attr("id"));
        $("#fieldChooser .ui-draggable").removeClass("fc-selected");
    });
    // */

    /** FIELD CHOOSER - END **/

    function LoadCustomReport(loadDefault, notclear) {
        // load custom
        if (!notclear)
            moveAllItems('#destinationFields', '#sourceFields');
        $("#sourceFields").find(".fc-selected").removeClass("fc-selected");
        var lastSelected = $("#layoutSelect").val();
        $("#layoutSelect").html('<option value="" selected>Loading...</option>');
        $.ajax({
            url: "@Url.Action("LoadCustomReport")",
            success: function (data) {
                if (data)
                {
                    $("#layoutSelect").html('');
                    $("#layoutSelect").append('<option selected>&nbsp;</option>');
                    linq(data).do(function (d) {
                        $("#layoutSelect").append('<option>' + d.LayoutName + '</option>');
                    });
                    $dataLayout = data;
                    if (loadDefault)
                    {
                        // load default
                        linq($dataLayout).do(function (d) {
                            if (d.IsActive)
                            {
                                $("#layoutSelect").val(d.LayoutName);
                            }
                        });
                    }
                    else
                        $("#layoutSelect").val(lastSelected);
                }
            }
        });
    }

    $("#btnCustomExport").on("click", function () {
        $("#customReport").modal("show");
        LoadCustomReport(true);
    });

    $("#btnSaveLayout").on("click", function () {
        var lname = $("#layoutName").val();
        if (lname == "" || lname == null)
        {
            ez.Modals.error("Please enter a name!");
            return;
        };
        var hdr = CompileCustomReportHeaders();
        if (hdr.length == 0) {
            ez.Modals.error("Please select at least one field to export!");
            return;
        };
        
        $.ajax({
            url: "@Url.Action("SaveCustomReport")",
            method: "POST",
            data: {
                name: lname,
                layout: hdr
            },
            success: function (data) {
                if (data) {
                    console.log(data);
                    ez.Modals.notification("Custom export saved!");
                    LoadCustomReport(undefined, true);
                }
                else
                    ez.Modals.error("Failed to save custom report!");
            }
        });
    });

    function CompileCustomReportHeaders() {
        var hdr = [];
        $("#destinationFields div").each(function (idx, ele) {
            hdr.push($(ele).attr("data-field"));
        });
        return hdr;
    }

    $("#btnExportCustomReport").on("click", function () {
        var hdr = CompileCustomReportHeaders();
        if (hdr.length == 0)
        {
            ez.Modals.error("Please select at least one field to export!");
            return;
        }
        Export(hdr);
    });
    $("#btnExport").on("click", function () {
        Export();
    });

    function Export(hdr)
    {
        var filter = {};
        filter.weekFilter = $("#FilterWeek").val();
        filter.yearFilter = $("#FilteYear").val();
        filter.zoneListFilter = $("#FilterZone").val();
        filter.stoNoListFilter = $("#FilterSTONumber").val();
        filter.senderIdLocListFilter = $("#FilterSender").val();
        filter.receiverIdLocListFilter = $("#FilterReceiver").val();
        filter.dateToFilter = moment($('#FilterToDate').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.dateFromFilter = moment($('#FilterFromDate').val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        filter.orderVehicleTypeListFiter = $("#FilterVehicleType").val();
        filter.materialTypeListFilter = $("#FilterMaterialType").val();
        filter.orderStatusListFilter = $("#FilterOrderStatus").val();

        ez.Modals.BeginLoading();
        $.ajax({
            url: hdr ? "@Url.Action("CustomExportTO")" : "@Url.Action("ExportTO")",
            method: "POST",
            data: {
                cols: hdr,
                filter: filter
            },
            success: function (res) {
                ez.Modals.EndLoading();

                if (res.IsSuccess !== undefined) {
                    ez.Modals.error("Failed to export data");
                }
                else {
                    window.location.assign('@Url.Content("~/Assets/Download/")' + res);
                }
            },
            error: function() {
                ez.Modals.EndLoading();
                ez.Modals.error("Failed to export data");
            }
        });
    }

