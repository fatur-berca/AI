    $("#btnDelete").click(function () {
        tempIDTO = [];
        $(".chkList").each(function (idx, ele) {
            if ($(ele).prop("checked"))
            {
                tempIDTO.push($(ele).attr("data-reqno"));
            }
        });
        if (tempIDTO.length > 0) {
            //$("#textModalWarningYesNo").html("");
            $("#textModalWarningYesNo").html("Are you sure to delete this data?");
            $('#warningModalYesNo').modal('show');
        } else if (tempIDTO.length == 0) {
            $('#notificationModal').modal('show');
            $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span> Please select your data!</span>');
            $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
        }
    });

    $("#confirmationSave").click(function () {
        dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        $.ajax({
            url: '@Url.Action("DeleteRequest", "TransportationOrder")',
            method: 'POST',
            dataType: 'json',
            data: { requestNo: tempIDTO },
            cache: false,
            success: function (res) {
                dialog.modal('hide');
                tempIDTO = [];
                if (res.IsSuccess) {
                    ez.Modals.notification("Your data has been successfully deleted");
                    loadDataTable();
                }
                else
                    ez.Modals.notification("Failed to delete data!");
            }
        });
    });

    //CHECK BOX DAN CHECK BOX ALL
    function InsertTempArray() {
        var table = $('#dtFilterMaster').DataTable();
        $('#dtFilterMaster tbody').one('change', 'tr', function () {
            var data = table.row(this).data();
            var idreq = data["IDRequest"];
            var result = $.grep(tempIDTO, function (e) { return e == idreq; });
            if (result.length == 0) {
                tempIDTO.push(idreq);
            } else if (result.length == 1) {
                tempIDTO = tempIDTO.filter(function (obj) {
                    return obj !== idreq;
                });
            }
        });
    }

