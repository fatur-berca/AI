<script>
    
    $("#btnDownloadTemplate").on("click", function () {
        ez.Modals.BeginLoading();
        $.ajax({
            url: "@Url.Action("DownloadTemplateTO")",
            method: "POST",
        success: function (res) {
            ez.Modals.EndLoading();

            if (!res) {
                ez.Modals.error("Failed to download template");
            }
            else {
                window.location.assign('@Url.Content("~/Assets/Download/")' + res);
            }
        },
        error: function() {
            ez.Modals.EndLoading();
            ez.Modals.error("Failed to download template");
        }
    });
    });
</script>

