        /**** clone route & update index number route by unit ****/
        newElem.find(".routeUnit").each(function () {
            var routeId = $(this).find(".collapse").attr("id").split("-");
            var currentRouteId = $(this).attr("id");
            //console.log("currentRouteId:" + currentRouteId);
            $(this).find(".collapse").attr("id", "route" + unitId+"-"+routeId[1]);
            $(this).find("a[data-toggle='collapse']").attr("data-target", "#route" + unitId+"-"+routeId[1]);
            $(this).find("input:checkbox").attr("rel", unitId);
            $(this).find("input:checkbox").attr("toid", "");
            $(this).find("input:checkbox").attr("reqid", "");
            /*$(this).find("input:checkbox").removeAttr("toid");
            $(this).find("input:checkbox").removeAttr("reqid");*/
            $(this).find(".OrderNumber").val("");
            $(this).find(".ParentOrderNumber").val("");
            $(this).find(".OrderStatus").val("");
            var selectedSender = $("#" + clonedId).find("#" + currentRouteId).find(".Sender option:selected").val();
            //console.log("sender:"+selectedSender);
            var selectedReceiver = $("#" + clonedId).find("#" + currentRouteId).find(".Receiver").val();
            $(this).find(".Sender option[value = '" + selectedSender + "']").attr("selected", "selected");
            $(this).find(".Receiver option[value = '" + selectedReceiver + "']").attr("selected", "selected");
            $("#" + clonedId).find("#" + currentRouteId).find(".clonedDetail").each(function () {
                var currentDetailId = $(this).attr("id");
                var selectedMaterial = $("#" + clonedId).find("#" + currentRouteId).find("#" + currentDetailId).find(".MaterialType option:selected").val();
                var selectedUom = $("#" + clonedId).find("#" + currentRouteId).find("#" + currentDetailId).find(".UoM option:selected").val();
                /*console.log("selectedMaterial:" + selectedMaterial);
                console.log("selectedUom:" + selectedUom);
                //console.log($(this).find(".MaterialType").html());
                console.log("clonedId:" + clonedId);
                console.log("currentRouteId:" + currentRouteId);
                console.log("currentDetailId:" + currentDetailId);*/

                newElem.find("#" + currentRouteId).find("#" + currentDetailId).find(".MaterialType").val(selectedMaterial);
                newElem.find("#" + currentRouteId).find("#" + currentDetailId).find(".UoM").val(selectedUom);
            });
        });

        /**** add label tab ****/
        var templateLabel = '<li id="labelUnit' + indexnya + '"><a data-toggle="pill" href="#clonedUnit' + indexnya + '">Unit-' + indexLabel + '</a></li>';
        $(".nav-pills").append(templateLabel);
        setTotalUnit();
        indexnya++;
        cloneIndex++;
