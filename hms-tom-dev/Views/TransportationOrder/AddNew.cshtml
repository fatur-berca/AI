@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "Transport > Transportation Order > Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
    bool isTransport = false;
}
@foreach (var x in listUserRole)
{
    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.RoleUserList.AWT)) || x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.RoleUserList.APT)) || x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.RoleUserList.AOT)) || x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.RoleUserList.SA)))
    {
        isTransport = true;
        break;
    }
}
<style>
    .form-group.required .control-label:before {
        /*content: "* ";*/
        color: red;
    }

    .control-label {
        text-transform: capitalize !important;
        font-size: 10px !important;
    }

    .spc .form-group label {
        font-size: 14px !important;
        font-weight: bold;
    }

    a.cloneUnit {
        text-decoration: none;
    }

    tr.control-label td {
        padding-bottom: 0px;
        margin-bottom: 0px;
    }

    .labelContainer .form-group {
        margin-bottom: 0px;
        margin-left: 10px;
        margin-left: 0px;
    }

    .addDetailRoute, .removeDetailRoute, .copyDetailRoute, .deleteUnit, .cloneUnit {
        background: none;
        border: none;
    }

    .clonedDetail {
        padding-left: 0px !important;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="title-deck wmb">
            <div class="button-wrap pull-left">
                <button class="btn btn-purple" onclick="window.location.href = '@Url.Action("Index", "TransportationOrder")'">Back</button>
                <button type="button" class="btn btn-primary" id="btnAddNewUnit">Add New Unit</button>
                <button type="button" class="btn btn-primary" id="btnSaveDraft" value="Draft">Save As Draft</button>
                <button type="button" class="btn btn-primary" id="btnSubmit" value="Submit">Submit</button>
                <button type="button" class="btn btn-primary" id="btnDelete">Delete</button>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="row spc">
            <div class="col-md-3">
                <div class="form-group">
                    <label>TOTAL ORDERED UNIT</label>
                    <h4 class="sub-text totalUnit" id="total-order-unit"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>TOTAL IN PROCESS</label>
                    <h4 class="sub-text" id="total-in-process"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>TOTAL ON DELIVERY</label>
                    <h4 class="sub-text" id="tolal-on-delivery"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>TOTAL COMPLETE</label>
                    <h4 class="sub-text" id="total-complete"><i class="fa fa-spin fa-refresh"></i></h4>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2">
                    <label style="font-size: 14px; font-weight: bold; padding-top: 9px;">Request Number</label>
            </div>
            <div class="col-md-4">
                <input type="text" id="RequestNumber" class="form-control" style="max-width: 200px; font-size: 14px;" disabled>
            </div>
        </div>            
    </div>
    <div class="clearfix" style="height:110px;"></div>
    <div class="col-md-12" style="margin-top: 10px;">
        <ul class="nav nav-pills">
            <li class="active" id="labelUnit1"><a data-toggle="pill" href="#clonedUnit1">Unit-1</a></li>
        </ul>
        <div class="tab-content" id="tab-content" rel="labelUnit1">
            <div id="clonedUnit1" class="tab-pane fade in active clonedUnit" rel="labelUnit1" seqid="1">
                <div class="col-panel">
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group required">
                                <label class="control-label">Vehicle Type</label>
                                <select class="form-control VehicleType" id="VehicleType[]"></select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group required">
                                <label class="control-label">Shipment Date</label>
                                <input type="text" name="" id="ShipmentDate[]" class="form-control datepicker ShipmentDate">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label">Zone</label>
                                <select class="form-control Zone" id="Zone[]"></select>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <span style="font-weight:bold">
                                <u>Maximum Capacity:</u><br />
                                CBU = 16 Pallet / 72 Box C48 / 220 Sack<br />
                                Standard = 12 Pallet / 54 Box C48 / 171 Sack
                            </span>
                        </div>
                        <div class="col-md-1">
                            <button class="btn-default btn-s cloneUnit"><i class="fa fa-copy"></i></button>
                            <button class="btn-default btn-s deleteUnit"><i class="fa fa-close"></i></button>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="route" id="route">
                                <div id="routeUnit1" class="routeUnit">
                                    <a role="button" class="toggle-collapse collapsed" data-toggle="collapse" data-target="#routeclonedUnit1-1">
                                        Route 1 <i class="fa fa-angle-up pull-right"></i>
                                    </a>
                                    <div class="collapse" id="routeclonedUnit1-1">
                                        <div class="panel panel-primary">
                                            <div class="panel-body">
                                                <table width="93%" border="0">
                                                    <tr>
                                                        <td width="5%">&nbsp;</td>
                                                        <td width="95%" colspan="8">
                                                            <button type="button" class="btn btn-primary btnUpload" id="btnUpload">Upload</button>
                                                            @if (isTransport)
                                                            {
                                                                <button type="button" class="btn btn-primary btnUpdateStatus" id="btnUpdateStatus" style="display:none;">Update Status</button>
                                                            }
                                                        </td>
                                                    </tr>
                                                    <tr class="control-label">
                                                        <td width="5%"><input type="checkbox" class="removeRoute" name="routeUnit1" rel="clonedUnit1"></td>
                                                        <td width="14%">Order Number/STO</td>
                                                        <td width="14%">Parent Order Number/STO</td>
                                                        <td width="14%">Order Type</td>
                                                        <td width="14%">Sender</td>
                                                        <td width="14%">Receiver</td>
                                                        <td width="14%">Cost Center</td>
                                                        <td width="*">Order Status</td>
                                                    </tr>
                                                    <tr>
                                                        <td>&nbsp;</td>
                                                        <td style="padding-right:10px;">
                                                            <input type="text" id="OrderNumber[]" class="form-control OrderNumber" disabled>
                                                        </td>
                                                        <td style="padding-right:10px;">
                                                            <input type="text" class="form-control ParentOrderNumber" id="ParentOrderNumber[]">
                                                        </td>
                                                        <td style="padding-right:10px;">
                                                            <input type="text" id="OrderType[]" class="form-control OrderType" disabled>
                                                        </td>
                                                        <td style="padding-right:10px;">
                                                            <select class="Sender form-group" id="Sender[]"></select>
                                                        </td>
                                                        <td style="padding-right:10px;">
                                                            <select class="Receiver form-group" id="Receiver[]"></select>
                                                        </td>
                                                        <td style="padding-right:10px;">
                                                            <input type="text" id="CostCenter[]" class="form-control CostCenter" disabled>
                                                        </td>
                                                        <td>
                                                            @if (isTransport)
                                                            {
                                                                <select class="form-control OrderStatus" id="OrderStatus[]"></select>
                                                            }
                                                            else
                                                            {
                                                                <select class="form-control OrderStatus" id="OrderStatus[]" disabled></select>
                                                            }
                                                        </td>
                                                    </tr>
                                                </table>
                                                <div class="clearfix"></div>
                                                <div class="col-md-1" style="width:3%"></div>
                                                <div class="col-md-11">
                                                    <div class="form-group">
                                                        <label class="control-label">Order Remark</label>
                                                        <input type="text" id="OrderRemark[]" class="form-control OrderRemark" maxlength="1000">
                                                    </div>
                                                </div>
                                                <div class="clearfix"></div>
                                                <div class="labelContainer">
                                                    <div class="col-md-1" style="width:3%"></div>
                                                    <div class="col-md-2">
                                                        <div class="form-group required">
                                                            <label class="control-label">Material Type</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <div class="form-group required">
                                                            <label class="control-label">Code</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <div class="form-group required">
                                                            <label class="control-label">Description</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <div class="form-group required">
                                                            <label class="control-label">Quantity</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <div class="form-group required">
                                                            <label class="control-label">UoM</label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="clearfix"></div>
                                                <div class="detailRoute" id="detailRoute">
                                                    <div class="col-md-12 clonedDetail" id="clonedDetail1">
                                                        <div class="col-md-1" style="width:3%"></div>
                                                        <div class="col-md-2">
                                                            <div class="form-group required">
                                                                <select class="form-control MaterialType" id="MaterialType[]"></select>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="form-group required">
                                                                <input type="text" id="Code[]" class="form-control Code" maxlength="15">
                                                            </div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="form-group required">
                                                                <input type="text" id="Description[]" class="form-control Description" maxlength="15">
                                                            </div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="form-group required">
                                                                <input type="number" id="Quantity[]" class="form-control Quantity" step="0.01" min="0" max="99999999.99">
                                                            </div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="form-group required">
                                                                <select class="form-control UoM" id="UoM[]"></select>
                                                            </div>
                                                        </div>
                                                        <button class="btn-default btn-s copyDetailRoute"><i class="fa fa-copy"></i></button>
                                                        <button class="btn-default btn-s addDetailRoute"><i class="fa fa-plus"></i></button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="clearfix" style="height:20px;"></div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <button type="button" class="btn btn-primary btnAddNew" id="btnAddNew">Add New</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




