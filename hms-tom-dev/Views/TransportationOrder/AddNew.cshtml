        var selectMaterial = $('.MaterialType');
        selectMaterial.html('');
        selectMaterial.append('<option value=""></option>');
        var selectZone = $('.Zone');
        selectZone.html('');
        selectZone.append('<option value=""></option>');
        var selectOrderStatus = $('.OrderStatus');
        selectOrderStatus.html('');
        selectOrderStatus.append('<option value=""></option>');
        $.ajax({
            url: '@Url.Action("GetList", "TransportationOrder")',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (data) {
                $.each(data, function (key, val) {
                    if (val["FieldName"] == "VehicleType")
                        selectVechType.append('<option value="' + val["FieldValue"] + '">' + val["FieldValue"] + '</option>');
                    if (val["FieldName"] == "MaterialType")
                        selectMaterial.append('<option value="' + val["FieldValue"] + '">' + val["FieldValue"] + '</option>');
                    if (val["FieldName"] == "Zone")
                        selectZone.append('<option value="' + val["FieldValue"] + '">' + val["FieldValue"] + '</option>');
                    if (val["FieldName"] == "TransportationStatus")
                        selectOrderStatus.append('<option value="' + val["FieldValue"] + '">' + val["FieldValue"] + '</option>');
                });
                //$('.VehicleType').val(valueVechicle);
                //$('.MaterialType').val(valueMaterial);
                //$('.Zone').val(valueZone);
            }
        });
    }
    function generateDropDownLocation() {
        var selectSender = $('.Sender');
        selectSender.html('<option value=" ">&nbsp;</option>');
        var selectReceiver = $('.Receiver');
