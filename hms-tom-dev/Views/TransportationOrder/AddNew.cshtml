            dialog.modal('hide');
            $("#textModalError").html("");
            $("#textModalError").append("Material Type, Code, Description, Quantity and UoM must be filled.<br><span style='padding-left:45px;'></span>If Material type CIgarette Order number must be filled");
            $('#modalerror').modal('show');
            return false;
        }
        isStatus = $(this).val();
        listSave = new Array();
        var selectedRoute = new Object();
        $("input:checkbox:checked").each(function () {
            var idUnit = $(this).attr("rel");
            var idRoute = $(this).attr("name");
            var reqid = $(this).attr("reqid");
            var seqid = $("#" + idUnit).attr("seqid");
            var toid = $(this).attr("toid");
            $("#" + idUnit).find("#" + idRoute).find(".OrderStatus").val(isStatus);
            $("#" + idUnit).find("#" + idRoute).find(".clonedDetail").each(function () {
                //console.log($(this).find(".MaterialType").val());
                var selectedRoute = new Object();
                selectedRoute.VehicleType = $("#" + idUnit).find(".VehicleType").val();
                var ShipDate = $("#" + idUnit).find(".ShipmentDate").val();
                selectedRoute.ShipmentDate = ShipDate.replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
                selectedRoute.Zone = $("#" + idUnit).find(".Zone").val();
                selectedRoute.OrderNumber = $("#" + idUnit).find("#" + idRoute).find(".OrderNumber").val();
                //selectedRoute.ParentOrderNumber = $("#" + idUnit).find("#" + idRoute).find(".ParentOrderNumber").val();
                selectedRoute.OrderType = $("#" + idUnit).find("#" + idRoute).find(".OrderType").val();
                //selectedRoute.ActualSenderIDLocation = $("#" + idUnit).find("#" + idRoute).find(".Sender").val();
                selectedRoute.SenderIDLocation = $("#" + idUnit).find("#" + idRoute).find(".Sender").select2('val');
                selectedRoute.ReceiverIDLocation = $("#" + idUnit).find("#" + idRoute).find(".Receiver").select2('val');
                selectedRoute.CostCenter = $("#" + idUnit).find("#" + idRoute).find(".CostCenter").val();
                selectedRoute.OrderStatus = $("#" + idUnit).find("#" + idRoute).find(".OrderStatus").val();
                selectedRoute.Remarks = $("#" + idUnit).find("#" + idRoute).find(".OrderRemark").val();
                selectedRoute.MaterialType = $(this).find(".MaterialType").val();
                selectedRoute.Code = $(this).find(".Code").val();
                selectedRoute.Description = $(this).find(".Description").val();
                selectedRoute.Qty = $(this).find(".Quantity").val();
                selectedRoute.UoM = $(this).find(".UoM").val();
                selectedRoute.IDRequest = reqid;
                selectedRoute.IDTransportOrder = toid;
                selectedRoute.RequestNo = $("#RequestNumber").val();
                selectedRoute.UnitID = idUnit;
                selectedRoute.SeqID = seqid;
                listSave.push(selectedRoute);
            });
        });
        console.log(listSave);
        $.ajax({
            url: '@Url.Action("SubmitDraftRequestUnit", "TransportationOrder")',
            method: 'post',
            dataType: 'json',
            cache: false,
            data: { saveData: listSave, isStatus: isStatus },
            success: function (data) {
                console.log(data);
                dialog.modal("hide");
                var i = 0;
                $("input:checkbox:checked").each(function () {
                    var idUnit = $(this).attr("rel");
                    var idRoute = $(this).attr("name");
                    var seqid = $("#" + idUnit).attr("seqid");
                    //console.log(data[i]);
                    //console.log(idUnit + "-" + idRoute);
                    //$(this).attr("reqid", data[i].IDRequest);
                    //$(this).attr("toid", data[i].IDTransportOrder);
                    $("#" + idUnit).find("#" + idRoute).find("input:checkbox").attr("reqid", data[i].IDRequest);
                    $("#" + idUnit).find("#" + idRoute).find("input:checkbox").attr("toid", data[i].IDTransportOrder);
                    $("#" + idUnit).find("#" + idRoute).find(".OrderNumber").val(data[i].STONo);
                    if (data[i].DefaultSeqNo == "") {
                        $("#" + idUnit).attr("seqid", seqid);
                    } else {
                        $("#" + idUnit).attr("seqid", data[i].DefaultSeqNo);
                    }
                    if (isStatus == 'Submit') {
                        $("#" + idUnit).find("#" + idRoute).find(".OrderNumber").attr("disabled", true);
                        $("#" + idUnit).find("#" + idRoute).find(".btnUpdateStatus").show();
                    }
                    if($("#" + idUnit).attr("seqid").includes("TO")){
                        $("#" + idUnit).find(".ShipmentDate").attr("disabled", true);
                    }
                    i++;
                });
                var splitRQ = data[0].RequestNo;
                $("#RequestNumber").val(splitRQ);
                dialog.modal('hide');
                $("#textModalSucess").html("");
                $("#textModalSucess").html("Your data has been successfully saved");
                $('#modalsuccess').modal('show');
            },
            error: function ()
            {
                dialog.modal("hide");
                $("#textModalError").html("Failed to save data");
                $('#modalerror').modal('show');
            }
        });
    });
    function validateSelectedRoute() {
        var valid = true;
        var lengthUnit = $("input:checkbox:checked").length;
        if (lengthUnit == 0) {
            valid = false;
            return false;
        }
        return valid;
    }
    function validateFormTORequest() {
        var valid = true;
        $("input:checkbox:checked").each(function () {
            var idUnit = $(this).attr("rel");
            var idRoute = $(this).attr("name");
            var VehicleType = $("#" + idUnit).find(".VehicleType").val();
            var ShipmentDate = $("#" + idUnit).find(".ShipmentDate").val();
            if (VehicleType == '' || ShipmentDate == '') {
                valid = false;
                return false;
            }
        });
        return valid;
    }
    function validateFormTO() {
        var valid = true;
        $("input:checkbox:checked").each(function () {
            var idUnit = $(this).attr("rel");
            var idRoute = $(this).attr("name");
            var Sender = $("#" + idUnit).find("#" + idRoute).find(".Sender").select2('val').trim();
            var Receiver = $("#" + idUnit).find("#" + idRoute).find(".Receiver").select2('val').trim();
            //console.log($("#" + idUnit).find("#" + idRoute).find(".Sender"), $("#" + idUnit).find("#" + idRoute).find(".Receiver"));
            if (Sender == '' || Receiver == '') {
                valid = false;
                return false;
            }
        });
        return valid;
    }
    function validateFormTOD() {
        var valid = true;
        $("input:checkbox:checked").each(function () {
            var idUnit = $(this).attr("rel");
            var idRoute = $(this).attr("name");
            var OrderNumber = $("#" + idUnit).find("#" + idRoute).find(".OrderNumber").val();
            var OrderType = $("#" + idUnit).find("#" + idRoute).find(".OrderType").val();
            if (OrderType == 'Finished Good' && OrderNumber == '') {
                valid = false;
                return false;
            }
            $("#" + idUnit).find("#" + idRoute).find(".clonedDetail").each(function () {
                var MaterialType = $(this).find(".MaterialType").val();
                var Code = $(this).find(".Code").val();
                var Description = $(this).find(".Description").val();
                var Qty = $(this).find(".Quantity").val();
                var UoM = $(this).find(".UoM").val();
                if (MaterialType == '' || Code == '' || Description == '' || Qty == '' || UoM == '') {
                    valid = false;
                    return false;
                }
            });
        });
        return valid;
    }
    function validateDeleteRoute() {
        var valid = true;
        $("input:checkbox:checked").each(function () {
            var idUnit = $(this).attr("rel");
            var idRoute = $(this).attr("name");
            var OrderStatus = $("#" + idUnit).find("#" + idRoute).find(".OrderStatus").val();
            if (OrderStatus == 'Submit') {
                valid = false;
                return false;
            }
        });
        return valid;
    }

    $(document).on("click", "button.btnUpdateStatus", function() {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...Uploading Data</div>',
            closeButton: false
        });
        var idRoute = $(this).parents().eq(7).attr("id");
        var idUnit = $(this).parents().eq(12).attr("id");
        var changeStatus = $("#" + idUnit).find("#" + idRoute).find(".OrderStatus").val();
        var idTO = $("#" + idUnit).find("#" + idRoute).find("input:checkbox").attr("toid");
        /*console.log("idUnit" + idUnit);
        console.log("idRoute" + idRoute);
        console.log("status" + changeStatus);
        console.log("idTO" + idTO);*/
        $.ajax({
            url: '@Url.Action("UpdateOrderStatus", "TransportationOrder")',
            method: 'post',
            dataType: 'json',
            cache: false,
            data: { IDTransportOrder: idTO, OrderStatus:changeStatus },
            success: function (data) {
                console.log(data);
                if (data == true) {
                    dialog.modal('hide');
                    $("#textModalSucess").html("");
                    $("#textModalSucess").html("Your data has been successfully saved");
                    $('#modalsuccess').modal("show");
                }
            }
        });
    });
</script>