<!--===========================  UNIT CLASS CONTROL BEGIN  ===========================-->
<script>
    function TOUnitCollection() {
        this.initialize.apply(this, arguments);
    }

    ez_TabCtl.prototype.closeBtn = function (cb) {
        var id = $(cb).first().attr("data-id");
        for (var i = 0; i < this.count(); i++) {
            var cid = this.Contents[i].attr("id");
            if (cid == id) {
                this.TOColl.confirmDelete(i);
            };
        }
    }

    TOUnitCollection.prototype.initialize = function (id, style) {
        this.Units = [];
        this.tabCtl = new ez_TabCtl(id, style);
        this.tabCtl.TOColl = this;
        this.EditMode = false;
        this.AllowEdit = true;
        this.MaxUnit = 10;

        this.tabCtl.unitColl = this;
        this._on = {};
        this.tabCtl.on("changed", this.refreshNumbering.bind(this));
        this.tabCtl.on("content-created", function (ele) {
            $(ele.Content).find(".ShipmentDate").datetimepicker({
                format: 'DD/MM/YYYY'
            });
            $(ele.Content).parent(".route-list").attr("data-count", 1);

            ez.CollapseNext($(ele.Content).find(".collapse-next"));
        });
        this.tabCtl.on("content-deleted", function (index) {
            var unit = this.unitColl.Units[index];
            if (unit) unit.delete();
        });

        this.tabCtl.ContentConstructor = function () {
            var cln = $("#tabTemplate").clone();
            $(cln).removeAttr("id");
            return cln;
        };

        this.clear();
    }

    TOUnitCollection.prototype.editMode = function (flag, editable)
    {
        this.EditMode = flag;
        this.AllowEdit = editable;
        this.refresh();
    }

    TOUnitCollection.prototype.confirmDelete = function (index)
    {
        this._deleteContext = index;
        var unit = this.Units[index];
        if (unit) {
            var allDraftOrNew = true;
            linq(unit.Routes).do(function (r) {
                var ordStat = r.field("OrderStatus").val();
                if (!(ordStat == "Draft" || ordStat == null || ordStat === undefined || ordStat == "")) {
                    allDraftOrNew = false;
                }
            });
            if (!allDraftOrNew)
            {
                // error
                if (ez && ez.Modals) {
                    ez.Modals.Error.show("Cannot delete this unit because it contains non-draft route(s)!");
                }
                return;
            }
            if (ez && ez.Modals) {
                ez.Modals.Confirm.on("yes-clicked", (function () {
                    var f = function () {
                        this.tabCtl.close(this._deleteContext);
                    };
                    this.trigger("unit-deleted", [this.Units[this._deleteContext], f.bind(this)]);
                }).bind(this));
                ez.Modals.Confirm.show("Are you sure to delete Vehicle-" + (this._deleteContext + 1) +"?");
            }
        }
    }

    TOUnitCollection.prototype.on = function (event, callback) {
        this._on[event] = callback;
    }

    TOUnitCollection.prototype.trigger = function (event, args) {
        if (this._on[event]) this._on[event].apply(this, args);
    }

    TOUnitCollection.prototype.clear = function () {
        this.tabCtl.clear();
        this.refreshNumbering();
        this.Units = [];
    }

    TOUnitCollection.prototype.refreshNumbering = function () {
        var cnt = 1;
        $(this.tabCtl.Pages).each(function (key, ele) {
            $(ele).find(".tab-button-name").html("Vehicle-" + cnt);
            cnt++;
        });

        $('.ez-btn-closetab').attr('title', 'Delete Vehicle');
        this.trigger("refresh", [cnt - 1]);
    }

    TOUnitCollection.prototype.newUnit = function () {
        if (this.Units.length >= this.MaxUnit)
        {
            ez.Modals.error("Maximum vehicle limit is " + this.MaxUnit + "!");
            return;
        }
        var tab = this.tabCtl.createPage("New Unit");
        var o = new TOUnit(tab, this);
        this.refreshNumbering();
        this.Units.push(o);
        this.trigger("unit-created", [o]);
        return o;
    }

    TOUnitCollection.prototype.val = function (setval) {
        if (setval) {
            for (var i = 0; i < setval.length; i++) {
                if (i < this.Units.length) {
                    this.Units[i].val(setval[i]);
                }
                else {
                    var unt = this.newUnit();
                    unt.val(setval[i]);
                }
            }
            while (this.Units.length > setval.length) {
                this.Units[setval.length].delete();
            }
        }
        else {
            var data = [];
            for (var i = 0; i < this.Units.length; i++) {
                data.push(this.Units[i].val());
            }
            return data;
        }
    }

    TOUnitCollection.prototype.validate = function ()
    {
        // Count checked route(s)
        var total = 0;
        linq(this.Units).do(function (unit) {
            linq(unit.Routes).do(function (route) {
                if (route.Checked())
                    total++;
            });
        });
        if (total <= 0) {
            ez.Modals.Error.show("<span style=\"font-size: larger;\">There is no selected route!</span>");
            return false;
        }

        var valid = true;
        var err = "";
        this._stoCheck = [];
        for (var i = 0; i < this.Units.length; i++) {
            var unit = this.Units[i];
            var val = unit.validate(i + 1);
            if (val !== true) {
                valid = false;
                err += "<b>Vehicle-" + (i + 1) + " errors:</b><br>" + val;
            }
        }
        if (!valid)
            ez.Modals.Error.show("<b style=\"font-size: larger;\">Invalid inputs:</b><br>" + err);
        return valid;
    }

    TOUnitCollection.prototype.refresh = function ()
    {
        for (var i = 0; i < this.Units.length; i++) {
            this.Units[i].refresh();
        }

        $("#btnAddNewUnit").prop("disabled", !this.AllowEdit);
        $("#btnSaveDraft").prop("disabled", !this.AllowEdit);
        $("#btnSubmit").prop("disabled", !this.AllowEdit);
        $("#btnDelete").prop("disabled", !this.AllowEdit);

        this.trigger("refresh", [this]);
    }

    function TOUnit() {
        this.initialize.apply(this, arguments);
    }

    TOUnit.prototype.initialize = function (tab, parent) {
        this._tab = tab.Content;
        this._cb = tab.Button;
        this._parent = parent;
        this.Collection = this._parent;
        this.Routes = [];

        var func = this.newRoute.bind(this);
        $(tab.Content).find(".btnAddNewRoute").on("click", func);

        func = this.clone.bind(this);
        $(tab.Content).find(".cloneUnit").on("click", func);

        this._tab.find(".routeUnit").remove();
        this.newRoute();
        var func = this.deleteSelectedRoute.bind(this);
        $(tab.Content).find(".btnDeleteRoute").on("click", func);

        func = this.checkAll.bind(this);
        this._tab.find(".checkAll").on("change", func);

        $(this._tab).find(".tooltip-trigger").tooltip();
    }

    TOUnit.prototype.checkAll = function () {
        if (this._skipCheck) return;
        var val = $(this._tab).find(".checkAll").first().prop("checked");
        linq(this.Routes).do(function (route) {
            if ((route.field("OrderStatus").val() == "Draft" || route.field("OrderStatus").val() == "Submit" || !route.field("OrderStatus").val())
                && route.field("OrderStatus").val() != "Cancel")
                route.Checked(val);
        });
    };
    TOUnit.prototype.refreshCheckAll = function () {
        var allChecked = this.Routes.length > 0;
        linq(this.Routes).do(function (route) {
            if (route.Checked() == false && (route.field("OrderStatus").val() == "Draft" || route.field("OrderStatus").val() == "Submit" || !route.field("OrderStatus").val())
                && route.field("OrderStatus").val() != "Cancel")
                allChecked = false;
        });
        this._skipCheck = true;
        $(this._tab).find(".checkAll").first().prop("checked", allChecked);
        this._skipCheck = false;
    };

    TOUnit.prototype.validate = function (num) {
        var val = this.val();
        var err = "";
        if (!val.VehicleType) err += "&bull; Vehicle Type is required<br>";
        if (!val.ShipmentDate) err += "&bull; Shipment Date is required<br>";
        if (!val.Zone) err += "&bull; Zone is required<br>";
        if (val.Routes.length == 0) err += "&bull; No route in vehicle<br>";
        for (var i = 0; i < this.Routes.length; i++) {
            var route = this.Routes[i];
            if (!route.Checked())
                continue;
            var valMsg = route.validate(num, i+1);
            if (valMsg !== true) {
                valid = false;
                err += "<b>Vehicle-" + (num) + " &bull; Route-" + (i + 1) + " errors:</b><br>" + valMsg;
            }
        }
        if (err == "") return true;
        return err;
    }

    TOUnit.prototype.clear = function () {
        this._tab.find(".routeUnit").remove();
        this.Routes = [];
    }

    TOUnit.prototype.delete = function () {
        this._parent.tabCtl.closeBtn(this._cb);
        var idx = this._parent.Units.indexOf(this);
        if (idx >= 0)
            this._parent.Units.splice(idx, 1);
        this._parent.refreshNumbering();
    }

    TOUnit.prototype.newRoute = function () {
        var cont = $(this._tab).find(".route-container");
        var cln = $("#tabTemplate").find(".routeUnit").clone();
        cont.append(cln);
        ez.CollapseNext($(cln).find(".collapse-next"));
        this.refreshNumbering(cont);

        var o = new TORoute(cln, this);
        this.Routes.push(o);

        this._parent.trigger("route-created", [o]);

        this._skipCheck = true;
        $(this._tab).find(".checkAll").first().prop("checked", false);
        this._skipCheck = false;
        
        var cust = @ViewBag.CanSetParentSTO.ToString().ToLower();
        console.log(cust);
        if (!cust)
            $(o._ele).find(".btnSetParent").hide();

        var func = function () {
            $(this._ele).find(".tdParentSTO").show();
            $(this._ele).find(".btnSetParent").hide();
        };
        $(o._ele).find(".btnSetParent").on("click", func.bind(o));

        return o;
    }

    TOUnit.prototype.deleteSelectedRoute = function () {
        for (var i = this.Routes.length - 1; i >= 0; i--) {
            if (this.Routes[i].deleteChecked())
                this.Routes[i].delete();
        }
    }

    TOUnit.prototype.refreshNumbering = function () {
        var cnt = 0;
        $(this._tab).find(".routeUnit").each(function (x, ele) {
            cnt++;
            $(ele).find(".route-title").html("Route " + cnt);
        });
    }

    TOUnit.prototype.val = function (setval) {
        if (setval) {
            this.field("VehicleType").val(setval.VehicleType);
            this.field("ShipmentDate").val(dateParse(setval.ShipmentDate, "DD/MM/YYYY", "DD/MM/YYYY"));
            this.field("Zone").val(setval.Zone);
            this.ID = setval.IDRequest;
            while (setval.Routes.length < this.Routes.length) this.Routes[setval.Routes.length].delete();
            for (var i = 0; i < setval.Routes.length; i++) {
                var mat = this.Routes[i] || this.newRoute();
                mat.val(setval.Routes[i]);
            }
        }
        else {
            var data = [];
            for (var i = 0; i < this.Routes.length; i++) {
                var rtVal = this.Routes[i].val();
                data.push(rtVal);
            }
            return {
                VehicleType: this.field("VehicleType").val(),
                ShipmentDate: this.field("ShipmentDate").val(),
                Zone: this.field("Zone").val(),
                Routes: data,
                IDRequest: this.ID
            }
        }
    }
    TOUnit.prototype.clone = function () {
        var unt = this._parent.newUnit();
        if (!unt) return;
        var curval = this.val();

        curval.ID = 0;
        curval.IDRequest = 0;
        
        for (var i = 0; i < curval.Routes.length; i++) {
            curval.Routes[i].OrderNumber = null;
            curval.Routes[i].OrderStatus = null;
            curval.Routes[i].ParentOrderNumber = null;
            curval.Routes[i].ID = 0;
            curval.Routes[i].IDTransportOrder = 0;
            curval.Routes[i].SeqNo = null;
            delete curval.Routes[i].Saved;
            linq(curval.Routes[i].Materials).do(function (mat) { mat.ID = 0; mat.IDTransportOrderDetail = 0; });
        }

        unt.val(curval);

        console.log("Cloned value:", curval);
        console.log("Cloned Unit:", unt);
    }

    TOUnit.prototype.IsDraft = function () {
        var isDraft = true;
        linq(this.Routes).do(function (route) {
            if (!route.IsDraft()) isDraft = false;
        });
        return isDraft;
    }

    TOUnit.prototype.refresh = function () {
        var hasSubmit = false;
        var canEditShipment = true;
        for (var i = 0; i < this.Routes.length; i++) {
            if (this.Routes[i]) {
                if (!this.Routes[i].IsDraft()) {
                    hasSubmit = true;
                    canEditShipment = false;
                }
                this.Routes[i].refresh();
            }
            var sto = this.Routes[i].field("OrderNumber").val();
            if (sto != "" && sto != null)
                canEditShipment = false;
        }

        $(this._tab).find(".ShipmentDate").prop("disabled", !this.Collection.AllowEdit || !canEditShipment);

        var isDraft = this.IsDraft();
        $(this._tab).find(".VehicleType").prop("disabled", !isDraft);
        $(this._tab).find(".Zone").prop("disabled", !isDraft);
        $(this._tab).find(".btnAddNewRoute").prop("disabled", !this.Collection.AllowEdit);
        $(this._tab).find(".cloneUnit").prop("disabled", !this.Collection.AllowEdit);
    }

    TOUnit.prototype.field = function (key, val) {
        return $(this._tab).find("." + key).first();
    }

    TOUnit.prototype.refreshCostCenter = function () {
        var sender = $(this._tab).find(".Sender").first().select2("val");
        var receiver = $(this._tab).find(".Receiver").first().select2("val");
        var material = $(this._tab).find(".MaterialType").first().val();
        var date = moment($(this._tab).find(".ShipmentDate").val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        var local = this;
        if (sender && receiver && material && date !== "Invalid date") {
            $.ajax(
                {
                    url: "@Url.Action("GetCostCenter")",
                    data: {
                        sender: sender,
                        receiver: receiver,
                        materialType: material,
                        date: date
                    },
                    success: function (data) {
                        if (data)
                            $(local._tab).find(".CostCenter").val(data);
                        else
                            $(local._tab).find(".CostCenter").val("");
                    },
                    error: function() {
                        $(local._tab).find(".CostCenter").val("");
                    }
                }
            );
        }
    }

    function TORoute() {
        this.initialize.apply(this, arguments);
    }

    TORoute.prototype.initialize = function (ele, prt) {
        this._ele = ele;
        this._parent = prt;
        this.Unit = prt;
        this.Collection = this.Unit._parent;
        this.Materials = [];
        this.Saved = false;
        //this.IsSpecialMaterial = false;
        this.IsSpecialMaterial = false;
        this._events = {};
        this.clear();

        var func = this.Unit.refreshCheckAll.bind(this.Unit);
        this._ele.find(".checkDelete").on("change", func);
        this.Unit.refreshCheckAll();
    }

    TORoute.prototype.getFirstMaterialType = function () {
        if (this.Materials.length <= 0)
            return null;
        return $(this.Materials[0]._ele).find(".MaterialType").first().val();
    }

    TORoute.prototype.refreshCostCenter = function () {
        var sender = $(this._ele).find(".Sender").first().select2("val");
        var receiver = $(this._ele).find(".Receiver").first().select2("val");
        var material = $(this._ele).find(".MaterialType").first().val();
        //console.log($(this._ele).parent().parent().parent().parent().find(".ShipmentDate").val());
        var date = moment($(this._ele).parent().parent().parent().parent().find(".ShipmentDate").val(), "DD/MM/YYYY").format("YYYY-MM-DD");
        var local = this;
        console.log(date);
        if (sender && receiver && material && date !== "Invalid date") {
            $.ajax(
                {
                    url: "@Url.Action("GetCostCenter")",
                    data: {
                        sender: sender,
                        receiver: receiver,
                        materialType: material,
                        date: date
                    },
                    success: function (data) {
                        if (data)
                            $(local._ele).find(".CostCenter").val(data);
                        else
                            $(local._ele).find(".CostCenter").val("");
                    },
                    error: function() {
                        $(local._ele).find(".CostCenter").val("");
                    }
                }
            );
        }
    }

    TORoute.prototype.on = function (event, func) {
        this._events[event] = this._events[event] || [];
        this._events[event].push(func);
    };

    TORoute.prototype.trigger = function (event, args) {
        this._events[event] = this._events[event] || [];
        var pool = this._events[event];
        for (var i = 0; i < pool.length; i++)
        {
            pool[i].apply(this, args);
        }
    };

    TORoute.prototype.clear = function () {
        this.Materials = [];
        $(this._ele).find(".material-row-template").remove();
        this.createMaterial();
    }

    TORoute.prototype.validate = function (unt, rot) {
        var val = this.val();
        var err = "";
        if (this.IsSpecialMaterial && !val.OrderNumber) err += "&bull; Order Number is required<br>";
        else if (this.IsSpecialMaterial) {
            var enabled = !$(this._ele).find(".OrderNumber").first().prop("disabled");
            if (enabled) {
                const regex = /^([a-zA-Z0-9])+$/;
                if (!val.OrderNumber.match(regex))
                    err += "&bull; Order Number contains invalid characters<br>";
            }
        }
        if (!val.OrderType) err += "&bull; Order Type is required<br>";
        if (!val.Sender) err += "&bull; Sender is required<br>";
        if (!val.Receiver) err += "&bull; Receiver is required<br>";
        //if (!val.OrderStatus) err += "&bull; Order Status is required<br>";

        if (val.OrderNumber && this.Collection._stoCheck.includes(val.OrderNumber))
            err += "&bull; Duplicate STO detected: " + val.OrderNumber + "<br>";
        else if (val.OrderNumber)
            this.Collection._stoCheck.push(val.OrderNumber);

        for (var i = 0; i < this.Materials.length; i++) {
            var mat = this.Materials[i];
            var valMsg = mat.validate(unt, rot, i+1);
            if (valMsg !== true) {
                valid = false;
                err += "<b>Vehicle-" + unt + " &bull; Route-" + rot + " &bull; Material #" + (i + 1) + " errors:</b><br>" + valMsg;
            }
        }

        if (err == "") return true;
        return err;
    }

    TORoute.prototype.deleteChecked = function () {
        return $(this._ele).find(".checkDelete").prop("checked");
    }

    TORoute.prototype.delete = function () {
        $(this._ele).remove();
        var idx = this._parent.Routes.indexOf(this);
        if (idx >= 0)
            this._parent.Routes.splice(idx, 1);
        this._parent.refreshNumbering();
    }

    TORoute.prototype.deleteNonCig = function () {
        $(this.Materials).each(function (ths, idx, ele) {
            var v = ele.val();
            if (v.MaterialType != "Cigarette")
                ele.delete();
        });
    }

    TORoute.prototype.createMaterial = function () {
        var cont = $(this._ele).find(".material-container");
        var cln = $("#tabTemplate").find(".material-row-template").clone();
        cont.append(cln);

        if (this.Materials.length == 0)
        {
            $(cln).find(".btnDeleteMat").remove();
            $(cln).find(".control-buttons").attr("style", null);
        }
        else
            $(cln).find(".control-label").remove();

        var func = this.createMaterial.bind(this);
        $(cln).find(".btnAddMat").on("click", func);

        var o = new TOMaterial(cln, this);
        this.Materials.push(o);

        this._parent._parent.trigger("material-created", [o]);

        if (this.IsSpecialMaterial) {
            $(cln).find(".MaterialType").val(this.getFirstMaterialType());
            $(cln).find(".MaterialType").trigger("change");
            $(cln).find(".MaterialType").prop("disabled", true);
        }

        return o;
    }

    TORoute.prototype.val = function (setval) {
        if (setval) {
            $(this._ele).find('.LabelOrderStatus').html(setval.OrderStatus);
            $(this._ele).find(".OrderNumber").val(setval.OrderNumber);
            $(this._ele).find(".ParentOrderNumber").val(setval.ParentOrderNumber);
            if (setval.ParentOrderNumber)
                $(this._ele).find(".ParentOrderNumber").show();
            $(this._ele).find(".OrderType").val(setval.OrderType);
            $(this._ele).find(".IDCostCenter").val(setval.IDCostCenter);
            $(this._ele).find(".SeqNo").val(setval.SeqNo);
            $(this._ele).find(".Sender").val(setval.Sender);
            $(this._ele).find(".Sender").trigger("change");
            $(this._ele).find(".Receiver").val(setval.Receiver);
            $(this._ele).find(".Receiver").trigger("change");
            $(this._ele).find(".CostCenter").val(setval.CostCenter);
            $(this._ele).find(".OrderStatus").val(setval.OrderStatus);
            $(this._ele).find(".OrderRemark").val(setval.OrderRemark);
            $(this._ele).find(".checkDelete").prop("checked", setval.Checked);
            
            this.ID = setval.IDTransportOrder;
            this.Saved = setval.Saved !== undefined ? setval.Saved : this.Saved;
            if (setval.Expanded) {
                $(this._ele).find(".route-content").collapse('show');
            }
            while (setval.Materials.length < this.Materials.length) this.Materials[setval.Materials.length].delete();
            for (var i = 0; i < setval.Materials.length; i++) {
                var mat = this.Materials[i] || this.createMaterial();
                mat.val(setval.Materials[i]);
            }
        }
        else {
            var data = [];
            for (var i = 0; i < this.Materials.length; i++) {
                data.push(this.Materials[i].val());
            }
            return {
                OrderNumber: $(this._ele).find(".OrderNumber").first().val(),
                ParentOrderNumber: $(this._ele).find(".ParentOrderNumber").first().val(),
                OrderType: $(this._ele).find(".OrderType").first().val(),
                Sender: $(this._ele).find(".Sender").first().select2("val"),
                Receiver: $(this._ele).find(".Receiver").first().select2("val"),
                CostCenter: $(this._ele).find(".CostCenter").first().val(),
                OrderStatus: $(this._ele).find(".OrderStatus").first().val(),
                OrderRemark: $(this._ele).find(".OrderRemark").first().val(),
                IDCostCenter: $(this._ele).find(".IDCostCenter").first().val(),
                SeqNo: $(this._ele).find(".SeqNo").first().val(),
                Checked: this.Checked(),
                Saved: this.Saved,
                IDTransportOrder: this.ID || this.IDTransportOrder,
                IsSpecialMaterial: this.IsSpecialMaterial,
                Expanded: $(this._ele).find(".route-content").attr("aria-expanded") == "true",
                Materials : data
            }
        }
    }

    TORoute.prototype.Checked = function (val) {
        if (val !== undefined)
            $(this._ele).find(".checkDelete").prop("checked", val === true);
        else
            return $(this._ele).find(".checkDelete").first().prop("checked");
    }

    TORoute.prototype.IsCancel = function () {
        return this.field("OrderStatus").val() == "Cancel";
    }
    TORoute.prototype.IsDraft = function () {
        return this.field("OrderStatus").val() == "Draft" || !this.Saved;
    }
    TORoute.prototype.IsSubmit = function () {
        return this.field("OrderStatus").val() == "Submit";
    }
    TORoute.prototype.IsNew = function () {
        return !this.Saved;
    }
    TORoute.prototype.HasSTO = function () {
        var val = this.field("OrderNumber").val();
        return val !== "" && val !== undefined && val !== null;
    }

    TORoute.prototype.refresh = function () {
        for (var i = 0; i < this.Materials.length; i++) {
            this.Materials[i].refresh();
        }
        this.field("ParentOrderNumber").prop("disabled", !this.Collection.AllowEdit || this.Saved || this.IsCancel());
        this.field("checkDelete").prop("hidden", !this.Collection.AllowEdit || !(this.IsDraft() || this.IsNew() || this.IsSubmit()) || this.IsCancel());
        this.field("Sender").select2(!this.Collection.AllowEdit || !(this.IsDraft() || this.IsNew()) || this.IsCancel() ? "disable" : "enable");
        this.field("Receiver").select2(!this.Collection.AllowEdit || !(this.IsDraft() || this.IsNew()) || this.IsCancel() ? "disable" : "enable");
        this.field("OrderStatus").prop("disabled", true);
        this.field("OrderRemark").prop("disabled", !this.Collection.AllowEdit || !(this.IsDraft() || this.IsNew()) || this.IsCancel());
        this.field("btnUpload").prop("disabled", !this.Collection.AllowEdit || !(this.IsDraft() || this.IsNew()) || this.IsCancel());
        this.field("btnSetParent").prop("disabled", !this.Collection.AllowEdit || !(this.IsDraft() || this.IsNew()) || this.IsCancel());
        // clear
        this.field("OrderNumber").prop("disabled", !this.Collection.AllowEdit ||
            !((this.IsDraft() || this.IsNew()) && this.IsSpecialMaterial)
            || this.IsCancel()
        );

        if (!(this.IsDraft() || this.IsNew() || this.IsSubmit()))
            this.field("btn-delete-route").hide();

        this.trigger("refresh", [this]);
    }

    TORoute.prototype.field = function (key, val) {
        return $(this._ele).find("." + key).first();
    }

    function TOMaterial() {
        this.initialize.apply(this, arguments);
    }

    TOMaterial.prototype.initialize = function (ele, prt) {
        this._ele = ele;
        this._parent = prt;
        this.Route = prt;
        this.Unit = prt._parent;
        this.Collection = this.Unit._parent;

        var func = this.delete.bind(this);
        $(ele).find(".btnDeleteMat").on("click", func);

        func = this.clone.bind(this);
        $(ele).find(".btnCloneMat").on("click", func);

        $(this._ele).find(".MaterialType").on("change", this._typeChanged.bind(this));
        $(this._ele).find(".Code").on("change", this._codeChanged.bind(this));

        this.clear();
    }

    TOMaterial.prototype._codeChanged = function () {
        if (!this.Route.IsSpecialMaterial && this.Route.getFirstMaterialType() == "Cigarette") return;
        var val = $(this._ele).find(".Code").first().val();
        var local = this;
        if (val)
            $.ajax({
                url: '@Url.Action("GetSpeakingCode")',
                data: { code: val },
                success: function (data) {
                    if (data != null && data != "")
                        $(local._ele).find(".Description").val(data);
                }
            });
    }

    TOMaterial.prototype.description = function (val) {
        if (val === undefined)
            $(this._ele).find(".Description").first().val(val);
        else
            return $(this._ele).find(".Description").first().val();
    }

    TOMaterial.prototype._typeChanged = function () {
        var uom = $(this._ele).find(".UoM");
        var mate = $(this._ele).find(".MaterialType").val();
        uom.html('');
        if ($data.UoMs[mate]) {
            filldd(uom, $data.UoMs[mate]);
        }

        var mcat = $data.MaterialCats[mate] || "Other";

        if (mate != "" && mate != null)
        {
            var fstmat = $(this.Route.Materials[0]._ele).find(".MaterialType").val();
            var fstcat = $data.MaterialCats[fstmat] || "Other";
            $(this.Route._ele).find(".OrderType").val(fstcat);

            if (!$data.MaterialTypeNonSpc.includes(mate)) {
                // changed to cig
                if (!this.Route.IsSpecialMaterial) {
                    // clear
                    this.Route.IsSpecialMaterial = true;

                    if (this.Route.Materials.length >= 1) {
                        $(this.Route.Materials[0]._ele).find(".MaterialType").val(mate);
                        $(this.Route.Materials[0]._ele).find(".MaterialType").trigger("change");
                    }

                    if (this.Route.Saved)
                        this.Route._prevNumber = $(this.Route._ele).find(".OrderNumber").val();
                }

                var btype = $(this.Route.Materials[0]._ele).find(".MaterialType").val();
                for (var ix = 1; ix < this.Route.Materials.length; ix++) {
                    var ctype = $(this.Route.Materials[ix]._ele).find(".MaterialType").val();
                    if (btype != ctype)
                    {
                        this.Route.Materials[ix].delete();
                        ix--;
                    }
                }

                if (!$(this.Route._ele).find(".OrderNumber").val())
                    $(this.Route._ele).find(".OrderNumber").val("");
                $(this.Route._ele).find(".OrderNumber").prop("disabled", false);
            }
            else {
                // changed to non-cig
                if (this.Route.IsSpecialMaterial) {
                    // clear
                    while (this.Route.Materials.length > 1) {
                        this.Route.Materials[1].delete();
                    }
                }

                for (var ix = 1; ix < this.Route.Materials.length; ix++) {
                    var ctype = $(this.Route.Materials[ix]._ele).find(".MaterialType").val();
                    if (!$data.MaterialTypeNonSpc.includes(ctype))
                        this.Route.Materials[ix].delete();
                }

                if (!this.Route.Saved)
                    $(this.Route._ele).find(".OrderNumber").val("");
                else if (this.Route._prevNumber)
                    $(this.Route._ele).find(".OrderNumber").val(this.Route._prevNumber);

                $(this.Route._ele).find(".OrderNumber").prop("disabled", true);
                this.Route.IsSpecialMaterial = false;
            }
        }
    }

    TOMaterial.prototype.delete = function () {
        $(this._ele).remove();
        var idx = this._parent.Materials.indexOf(this);
        if (idx >= 0)
            this._parent.Materials.splice(idx, 1);
    }

    TOMaterial.prototype.clone = function () {
        var mat = this._parent.createMaterial();
        var curval = this.val();
        mat.val(curval);
        mat.ID = 0;
        mat.IDTransportOrderDetail = 0;
    }

    TOMaterial.prototype.clear = function () {

    }

    TOMaterial.prototype.validate = function (unt, rot, mat) {
        var val = this.val();
        var err = "";
        if (!val.MaterialType) err += "&bull; Material Type is required<br>";
        if (!val.Code || val.Code.trim() == "") err += "&bull; Code is required<br>";
        if (!val.Quantity) err += "&bull; Quantity is required<br>";
        if (!val.UoM) err += "&bull; UoM is required<br>";

        if (err == "") return true;
        return err;
    }

    TOMaterial.prototype.val = function (setval) {
        if (setval)
        {
            $(this._ele).find(".MaterialType").val(setval.MaterialType);
            $(this._ele).find(".MaterialType").trigger("change");
            $(this._ele).find(".Code").val(setval.Code);
            $(this._ele).find(".Description").val(setval.Description);
            $(this._ele).find(".Quantity").val(setval.Quantity);
            $(this._ele).find(".UoM").val(setval.UoM);
            this.ID = setval.IDTransportOrderDetail;
        }
        else {
            var q = $(this._ele).find(".Quantity").first().val();
            if (q) q = q.replace(",", ".");
            return {
                MaterialType: $(this._ele).find(".MaterialType").first().val(),
                Code: $(this._ele).find(".Code").first().val(),
                Description: $(this._ele).find(".Description").first().val(),
                Quantity: Number(q) || 0,
                UoM: $(this._ele).find(".UoM").first().val(),
                IDTransportOrderDetail : this.ID
            };
        }
    }

    TOMaterial.prototype.refresh = function () {
        this.field("MaterialType").prop("disabled", !this.Collection.AllowEdit || !(this.Route.IsDraft() || this.Route.IsNew()));
        this.field("Code").prop("disabled", !this.Collection.AllowEdit || !(this.Route.IsDraft() || this.Route.IsNew()));
        this.field("Description").prop("disabled", !this.Collection.AllowEdit || !(this.Route.IsDraft() || this.Route.IsNew()));
        this.field("Quantity").prop("disabled", !this.Collection.AllowEdit || !(this.Route.IsDraft() || this.Route.IsNew()));
        this.field("UoM").prop("disabled", !this.Collection.AllowEdit || !(this.Route.IsDraft() || this.Route.IsNew()));
        this.field("btnCloneMat").prop("disabled", !this.Collection.AllowEdit || !(this.Route.IsDraft() || this.Route.IsNew()));
        this.field("btnAddMat").prop("disabled", !this.Collection.AllowEdit || !(this.Route.IsDraft() || this.Route.IsNew()));
        this.field("btnDeleteMat").prop("disabled", !this.Collection.AllowEdit || !(this.Route.IsDraft() || this.Route.IsNew()));
    }

    TOMaterial.prototype.field = function (key, val) {
        return $(this._ele).find("." + key).first();
    }
</script>
