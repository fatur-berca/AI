<!--===========================  UI CONTROL SCRIPT BEGIN  ===========================-->
<script>
    // Global Data
    var $data = {};
    var toDataID = null;
    var editMode = false;
    var units = new TOUnitCollection("tabber", "pill");

    // add action to add new unit
    $("#btnAddNewUnit").on('click', function () {
        units.newUnit();
    });

    // DELETE FUNCTION
    function Delete(ids, emptyRoutes)
    {
        ez.Modals.BeginLoading();
        console.log("Data to delete:", ids);
        $.ajax({
            url: '@Url.Action("DeleteRouteUnit")',
            data: { deleteData: ids },
            method: 'post',
            success: function (res) {
                ez.Modals.EndLoading();
                if (res)
                {
                    linq(units.Units).do(function (unit) {
                        linq(unit.Routes).do(function (rout) {
                            if (ids.includes(rout.ID)) {
                                if (rout.field("OrderStatus").val() == "Submit") {
                                    rout.field("OrderStatus").val("Cancel");
                                    rout.field("LabelOrderStatus").html("Cancel");
                                    rout.field("checkDelete").hide();
                                    rout.field("checkDelete").prop("checked", false);
                                }
                                else
                                    rout.delete();
                            }
                        });
                    });
                    if (emptyRoutes)
                        linq(emptyRoutes).do(function (r) {
                            r.delete();
                        });
                    ez.Modals.Notif.show("Your data has been successfully deleted");
                    units.refresh();
                    console.log("Unit Count:", units.Units.length);
                    if (units.Units.length == 0)
                        units.newUnit();
                }
                else
                    ez.Modals.Error.show("Data delete failed");
            }
        });
    }

    // DELETE BUTTON
    $("#btnDelete").on("click", function () {
        var routeCount = linq(units.Units).select(
            function (unit) {
                return linq(unit.Routes).where(function (r) { return r.Checked(); });
            }
        ).flatten().count();
        if (routeCount <= 0) {
            ez.Modals.error("Please select route that you want to delete!");
            return;
        }
        ez.Modals.Confirm.show("Are you sure to delete selected Routes?", null, {
            yes: function () {
                /** DELETE LOGIC **/
                var ids = [];
                var eroutes = [];
                linq(units.Units).do(function (unit) {
                    linq(unit.Routes).do(function (rout) {
                        if (rout.Checked())
                            if (rout.ID !== undefined)
                                ids.push(rout.ID);
                            else
                                eroutes.push(rout);
                    });
                }).flatten().getContext();
                Delete(ids, eroutes);
            }
        })
    });

    // SAVE FUNCTION
    function Save(data, status)
    {
        /** SUBMIT and DRAFT LOGIC **/
        var dic = [];
        var iv = 0;
        var ir = 0;
        if (status !== undefined) {
            linq(data).do(function (unit) {
                unit.ShipmentDate = moment(unit.ShipmentDate, "DD/MM/YYYY").format("YYYY-MM-DD");
                iv++;
                linq(unit.Routes).do(function (rout) {
                    if (rout.Checked)
                        rout.OrderStatus = status;
                    ir++;

                    var odic = {};
                    console.log("RT:",rout);
                    odic.Tag = "Vehicle-" + iv + " &bull; Route-" + ir;
                    odic.STONo = rout.OrderNumber;
                    odic.IDTransportOrder = rout.IDTransportOrder;
                    dic.push(odic);

                    linq(rout.Materials).do(function (mate) {
                        mate.QtyString = mate.Quantity * 100;
                    });
                });
                ir = 0;
            });
        }
        ez.Modals.BeginLoading();
        var exec_save = function () {
            console.log("Data to save:", data);
            $.ajax({
                url: '@Url.Action("Save")',
                data: {
                    data: { Units: data, RequestNo: $("#RequestNumber").val() }
                },
                method: 'post',
                success: function (res) {
                    ez.Modals.EndLoading();
                    if (res) {
                        console.log("Return Value", res);

                        if (res.ReqNo) {
                            $("#RequestNumber").val(res.ReqNo);
                            units.val(res.Data);
                            units.EditMode = true;
                            units.refresh();
                            RefreshInfo();
                            console.log(res.Data[0].OrderStatus);
                            if (res.Data[0].Routes[0].OrderStatus == "Submit" || res.Data[0].Routes[0].OrderStatus == "submit")
                            {
                                ez.Modals.Notif.show("Your data has been successfully submitted");
                            } else {
                                ez.Modals.Notif.show("Your data has been successfully saved")
                            }
                        }
                        else if (res.ValidationFailed === true)
                        {
                            if (res.Error == "STONotUnique") {
                                var errmsg = "<b>The following STO numbers is not unique:</b><br />";
                                linq(res.Data).do(function (v) {
                                    errmsg += "&bull; " + v + "<br />"
                                });
                                ez.Modals.Error.show(errmsg);
                            }
                            if (res.Error == "StatusInconsistent")
                            {
                                var stos = "";
                                for (var i = 0; i < res.Data.length; i++)
                                {
                                    stos += "<br />&bull;" + res.Data[i];
                                }
                                ez.Modals.Error.show("The following route data had been changed by another process:" + stos + "<br />Please uncheck them to save your changes.");
                            }
                        }
                        else if(res.innerexception.innerexception.message)
                        {
                            Save(data, status);
                        }
                        else {
                            ez.Modals.Error.show("Data submit failed, please try again in a few seconds");
                        }
                    }
                    else
                        ez.Modals.Error.show("Data submit failed, please try again in a few seconds");
                },
                error: function () {
                    ez.Modals.EndLoading();
                    ez.Modals.Error.show("Data save failed, please try again in a few seconds");
                }
            });
        };

        exec_save();
        return;

        console.log(dic);
        $.ajax({
            url: '@Url.Action("CheckSTO")',
            data: {
                stodic: dic
            },
            method: 'post',
            success: function (res) {
                if (res.IsSuccess) {
                    exec_save();
                }
                else {
                    ez.Modals.EndLoading();
                    var errmsg = "<b>The following STO numbers is not unique:</b><br />";
                    linq(res.Errors).do(function (v) {
                        errmsg += "&bull; " + v + "<br />"
                    });
                    ez.Modals.Error.show(errmsg);
                }
            },
            error: function () {
                ez.Modals.Error.show("STO validation failed");
            }
        });
    }

    // EDIT MODE FUNCTION
    function Edit(id)
    {
        ez.Modals.BeginLoading();
        editMode = true;
        units.clear();
        $.ajax({
            url: '@Url.Action("Load")',
            data: { reqno: id },
            method: 'get',
            success: function (res) {
                ez.Modals.EndLoading();
                console.log("Data to edit:", res);
                units.clear();
                units.val(res.Units);
                units.editMode(true, res.AllowEdit);
                $("#RequestNumber").val(id);
                if (units.Units.length == 0)
                    units.newUnit();
                RefreshInfo();
            },
            error: function () {
                ez.Modals.EndLoading();
                ez.Modals.error("You are not allowed to access this data!");
                window.locaction.href = "@Url.Action()";
            }
        });
    }

    // SUBMIT BUTTON
    $("#btnSubmit").on("click", function () {
        if (units.validate()) {
            var data = units.val();
            Save(data, "Submit");
        }
    });
    $("#btnSaveDraft").on("click", function () {
        if (units.validate()) {
            /** DRAFT LOGIC **/
            var data = units.val();
            Save(data, "Draft");
        }
    });

    // Fill DropDown
    function filldd(dd, data) {
        dd.html('');

        var opt = '<option>&nbsp;</option>';
        dd.append(opt);

        $(data).each(function (key, val) {
            if (typeof (val) == "object") {
                opt = '<option value="' + val.Key + '">' + val.Value + '</option>';
                dd.append(opt);
            }
            else {
                opt = '<option value="' + val + '">' + val + '</option>';
                dd.append(opt);
            }
        });
    }

    function RefreshInfo(){
        var cnt_inproc = 0;
        var cnt_ondeli = 0;
        var cnt_comple = 0;
        var cnt_submit = 0;
        var cnt = 0;
        linq(units.Units).do(function (unit) {
            linq(unit.Routes).do(function (route) {
                var ord = route.field("OrderStatus").val() || "";
                ord = ord.toLowerCase();
                console.log(ord);
                if (ord == "in process") cnt_inproc++;
                if (ord == "on delivery") cnt_ondeli++;
                if (ord == "complete") cnt_comple++;
                if (ord == "submit") cnt_submit++;
            });
            cnt++;
        });
        $("#total-order-unit").html(cnt);
        $("#total-submit").html(cnt_submit);
        $("#total-in-process").html(cnt_inproc);
        $("#total-on-delivery").html(cnt_ondeli);
        $("#total-complete").html(cnt_comple);
    }

    // Total Ordered Unit
    units.on("refresh", function (cnt) {
        linq(units.Units).do(function (unit) {
            if (unit.Routes.length == 0)
                unit.newRoute();
        });
        RefreshInfo();
    });

    // Setup new unit
    units.on("unit-created", function (unit) {
        filldd($(unit._tab).find(".VehicleType"), $data.VehicleType);
        filldd($(unit._tab).find(".Zone"), $data.Zone);
        $(unit._tab).find(".ShipmentDate").on("dp.change", function () {
            unit.refreshCostCenter();
        });
        $("#total-order-unit").html(units.Units.length);
    });

    // Setup new route
    units.on("route-created", function (route) {
        filldd($(route._ele).find(".Sender"), $data.Location);
        $(route._ele).find(".Sender").select2();
        $(route._ele).find(".Sender").on("change", function () {
            route.refreshCostCenter();
        });
        filldd($(route._ele).find(".Receiver"), $data.Location);
        $(route._ele).find(".Receiver").select2();
        $(route._ele).find(".Receiver").on("change", function () {
            route.refreshCostCenter();
        });
        filldd($(route._ele).find(".OrderStatus"), ["Draft", "Submit"]);
        $(route._ele).find(".btnUpload").on("click", (function () {
                SpawnUploadBox(this);
            }).bind(route)
        );

        var func = function () {
            var rout = this;
            ez.Modals.Confirm.show("Are you sure to delete this Route?", null, {
                yes: function () {
                    /** DELETE LOGIC **/
                    var ids = [];
                    var er = [];
                    if (rout.ID)
                        ids = [rout.ID];
                    else
                        er = [rout];
                    Delete(ids, er);
                }
            });
        };
        $(route._ele).find(".btn-delete-route").on("click", func.bind(route));

        RefreshInfo();
    });

    // Setup new material
    units.on("material-created", function (mat) {
        ez.Form.NumberOnly($(mat._ele).find(".Quantity"));
        var mty = mat.Route.getFirstMaterialType();
        if (mat.Route.Materials.length > 1) {
            if (mat.Route.IsSpecialMaterial)
                filldd($(mat._ele).find(".MaterialType"), [mty]);
            else
                filldd($(mat._ele).find(".MaterialType"), $data.MaterialTypeNonSpc);
        }
        else {
            filldd($(mat._ele).find(".MaterialType"), $data.MaterialType);
            $(mat._ele).find(".MaterialType").first().on("change", function () {
                mat.Route.refreshCostCenter();
            });
        }
        RefreshInfo();
    });

    // Send delete signal
    units.on("unit-deleted", function (unit, callback) {
        if (unit)
        {
            var val = unit.val();
            if (val && val.IDRequest > 0)
            {
                // delete it
                ez.Modals.BeginLoading();
                $.ajax(
                    {
                        url: "@Url.Action("DeleteUnit")",
                        data: { requestID: val.IDRequest },
                        method: "POST",
                        success: function (res) {
                            ez.Modals.EndLoading();
                            if (res.IsSuccess) {
                                callback();
                                if (units.Units.length == 0)
                                    units.newUnit();
                            }
                            else {
                                ez.Modals.error(res.ErrorMessage);
                            }
                        },
                        error: function () {
                            ez.Modals.EndLoading();
                            ez.Modals.error("Failed to delete unit!");
                        }
                    }
                );
            }
            else
                callback();

            if (units.Units.length == 0)
                units.newUnit();
        }
    });

    // Upload
    var uploadContext = null;
    function SpawnUploadBox(context)
    {
        uploadContext = context;
        $("#fileInput").jfilestyle('clear');
        $("#mdlUpload").modal("show");
    }
    $("#btnUpload").on('click', function () {
        ez.Modals.BeginLoading();
        if ($("#fileInput").val() == '' || $("#fileInput").val() == null) {
            ez.Modals.EndLoading();
            ez.Modals.Error.show("Please select file first!");
            return;
        }
        if (window.FormData) {
            var fileData = new FormData();
            var fileUpload = document.getElementById('fileInput').files;
            if (fileUpload.length > 0) {
                fileUpload = fileUpload[0];
                fileData.append('FileUpload', fileUpload);
            } else {
                ez.Modals.EndLoading();
                ez.Modals.Error.show("No file to be uploaded!");
                return;
            }
            $.ajax(
                {
                    type: 'POST',
                    url: '@Url.Action("UploadMaterial")',
                    data: fileData,
                    cache: false,
                    contentType: false,
                    processData: false,
                    success: function (res)
                    {
                        ez.Modals.EndLoading();
                        if (res.IsSuccess) {
                            $("#fileInput").jfilestyle('clear');
                            $("#mdlUpload").modal("hide");
                            var err = "";
                            var ctr = 2;
                            linq(res.Data).do(function (val) {
                                var mty = uploadContext.getFirstMaterialType();
                                if (uploadContext.IsSpecialMaterial && val.MaterialType != mty) {
                                    err += "&bull; Row #" + ctr + " - Material Type must be " + mty + "<br />";
                                }
                                if (!$data.MaterialType.includes(val.MaterialType))
                                    err += "&bull; Row #" + ctr + " - Material Type is not valid<br />";
                                ctr++;
                            });
                            if (err != "") {
                                ez.Modals.Error.show("<b style=\"font-size:larger\">Upload Failed!</b><br />" + err);
                            }
                            else {
                                linq(res.Data).do(function (val) {
                                    // find the first empty slot that is followed only by empty slots
                                    var mat = null;
                                    var prev_mat = null;
                                    for (var i = uploadContext.Materials.length - 1; i >= -1; i--)
                                    {
                                        if (i < 0)
                                        {
                                            mat = prev_mat;
                                            break;
                                        }
                                        var m = uploadContext.Materials[i];
                                        //console.log(m.field("MaterialType").val());
                                        if (m.field("MaterialType").val())
                                        {
                                            mat = prev_mat;
                                            break;
                                        }
                                        prev_mat = m;
                                    }

                                    if (mat === null)
                                        mat = uploadContext.createMaterial();
                                    mat.val(val);
                                });
                                ez.Modals.Notif.show("Upload success!");
                            }
                        }
                        else {
                            ez.Modals.Error.show("<b style=\"font-size:larger\">Upload Failed!</b><br />" + res.ErrorMessage);
                        }
                    },
                    error: function (err) {
                        ez.Modals.EndLoading();
                        ez.Modals.Error.show("Failed to upload file!");
                    }
                }
            );
        }
        setTimeout(function () { $("#mdlUpload").modal("hide"); }, 1000);
    });
    $("#btnDownloadTemplate").on("click", function () {
        ez.Modals.BeginLoading();
        $.ajax({
            url: "@Url.Action("DownloadTemplateMaterial")",
            method: "POST",
            success: function (res) {
                ez.Modals.EndLoading();

                if (!res) {
                    ez.Modals.error("Failed to download template");
                }
                else {
                    window.location.assign('@Url.Content("~/Assets/Download/")' + res);
                }
            },
            error: function() {
                ez.Modals.EndLoading();
                ez.Modals.error("Failed to download template");
            }
        });
    });


    // Load $data from server
    ez.Modals.BeginLoading();
    $.ajax(
        {
            url : '@Url.Action("GetData")',
            success: function (json) {
                ez.Modals.EndLoading();

                $data = json;
                $data.MaterialTypeNonSpc = [];
                $($data.MaterialType).each(function (idx, ele) {
                    var typ = $data.MaterialCats[ele] || "Other";
                    if (typ != "Finished Good" && typ != "Bad Stock")
                        $data.MaterialTypeNonSpc.push(ele);
                });

                console.log($data);

                // create a default unit or edit existing unit
                $(function () {
                    @{
                    if (ViewBag.RequestID != null)
                    {
                        @Html.Raw("Edit('" + ViewBag.RequestID + "');");
                    }
                    else
                    {
                        @Html.Raw("units.newUnit();");
                    }
                }
                });

                if (toDataID) LoadTOData(toDataID);
            },
            error: function () { ez.Modals.EndLoading(); }
        }
    );


    /*-- Easter Egg --*/
    var eggOn = true;
    var eggKey = "lumosmaxima";
    var eggInput = "";
    $(window).on("load", function() {
        $(window).on("keypress", function(k) {
            if (!eggOn) return;
            eggInput += k.key;
            while (eggInput.length > eggKey.length)
                eggInput = eggInput.substr(1);
            if (eggInput == eggKey)
            {
                $(".OrderType").parent().parent().removeAttr("hidden");
                $(".SeqNo").parent().parent().removeAttr("hidden");
                $(".IDCostCenter").parent().parent().removeAttr("hidden");
                ez.Modals.notification("Unlocked: Super vision!");
                //eggOn = false;
                eggInput = "";
            }
        });
    });
</script>
<!--===========================  UI CONTROL SCRIPT END  ===========================-->