            <th data-orderable="false" class="text-center">
                <div class="checkbox-deck">
                    <input type="checkbox" name="" id="checkall">
                    <label for="checkall"></label>
                </div>
            </th>
            <th>Date of Receipt</th>
            <th>Origin</th>
            <th>Destination</th>
            <th>STO Number</th>
            <th>DN Number</th>
            <th>Police Reg. Number</th>
            <th>Vendor</th>
        </tr>

    </thead>
    <thead class="filters">
