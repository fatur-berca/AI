<div class="modal fade" id="modalUpload" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="titleModalUpload">Upload</h4>
            </div>
            <div class="modal-body">
                <form id="frmUpload">
                    <div class="row">
                        <div class="col-md-9">
                            <div class="form-group">
                                <label>Upload File</label>
                                <input id="uploadMasterCostKM" type="file" name="" class="filestyle" accept=".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel">
                                <a href="Assets/Download/TemplateExcel/MasterCostKMBased.xlsx">Download Template Master Cost KM Based</a><br />
                                <a href="Assets/Download/TemplateExcel/MasterCostTripBased.xlsx">Download Template Master Cost Trip Based</a><br />
                                <a href="Assets/Download/TemplateExcel/MasterCostBoxBased.xlsx">Download Template Master Cost Box Based</a><br />
                                <a href="Assets/Download/TemplateExcel/MasterCostSPSI.xlsx">Download Template Master Cost SPSI</a><br />
                                <a href="Assets/Download/TemplateExcel/MasterCostASDP.xlsx">Download Template Master Cost ASDP</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button id="btnUpload" class="btn btn-primary" disabled>Upload</button>
                <button class="btn btn-purple" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

