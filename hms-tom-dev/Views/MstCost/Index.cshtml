<script type="text/javascript" src="@Url.Content("~/Scripts/ez.js")"></script>
<script type="text/javascript">

    var ezctl = ez;
    //ezctl.FormSet.AddField(
    //    "costType:req>Data Type",
    //    "VendorName:req>Vendor",
    //    "BasedPrice:n+ req>Based Price",
    //    "effecStartDate:date req>Effective Date (Start)",
    //    "effecEndDate:date req>Effective Date (End)"
    //);

    function RefreshEndDate() {
        var oval = $("#effecEndDate").val();
        var sval = $("#effecStartDate").val().split("/");
        if (oval == "" || oval === null || oval === undefined)
            //$("#effecEndDate").val(moment('2999/' + sval[1] + "/" + sval[0]).format("DD/MM/YYYY"));
            $("#effecEndDate").val(moment('2999/12/31').format("DD/MM/YYYY"));
    }

    //$("#effecEndDate").blur(function () {
    //    if ($("#effecEndDate").val() === "") {
    //        $("#effecEndDate").val("31/12/2999");
    //    }
    //});

    function SetFieldRow(id, row) {
        $("#" + id).detach().appendTo("#row" + row);
    }

    $(document).ready(function () {
        generateDropDownVendorName();
        generateDropDownLocation();
        generateAdvSrcLoc(function () { generateTable(); });
        //generateDropDownReceiver();
        generateDropDownType();
        generateDropDownList();
        $("#effecStartDate").on("dp.change", RefreshEndDate);
        $("#effecEndDate").on('dp.change', RefreshEndDate);
    });
    $("#addNew").click(function () {
        resetData();
        $("#costType").val("KM Based");
        $("#costType").trigger("change");
        displayCostKM();
        $('#InsertOrUpdate').val("INSERT");
        EnabledField();
        $("#btnSaveNew").html("Save");
        //generateDropDownVendorName('');
    });

    $("#costType").change(function () {
        if ($("#costType :selected").val() == "KM Based")
            displayCostKM();
        else if ($("#costType :selected").val() == "Box Based")
            displayCostBox();
        else if ($("#costType :selected").val() == "Trip Based")
            displayCostTrip();
        else if ($("#costType :selected").val() == "SPSI")
            displayCostSPSI();
        else if ($("#costType :selected").val() == "ASDP")
            displayCostASDP();
        else
            displayNone();
        resetData();

        generateDropDownVendorName('');
        $("#effecStartDate").val(moment(new Date()).format('DD/MM/YYYY'));
        var sval = $("#effecStartDate").val().split("/");
        $("#effecEndDate").val(moment('2999/12/31').format("DD/MM/YYYY"));
        //$("#effecEndDate").val(moment('2999/' + sval[1] + "/" + sval[0]).format("DD/MM/YYYY"));
    });

    function displayNone() {
        $("#disVN").prop('hidden', true);
        $("#disR").prop('hidden', true);
        $("#disMK").prop('hidden', true);
        $("#disMB").prop('hidden', true);
        $("#disBP").prop('hidden', true);
        $("#disD").prop('hidden', true);
        $("#disAUP").prop('hidden', true);
        $("#disS").prop('hidden', true);
        $("#disT").prop('hidden', true);
        $("#disV").prop('hidden', true);
        $("#disOT").prop('hidden', true);
        $("#disTM").prop('hidden', true);
        $("#disVT").prop('hidden', true);
        $("#disESD").prop('hidden', true);
        $("#disEED").prop('hidden', true);
        $("#disTO").prop('hidden', true);        
    }

    function displayCostKM() {
        $("#disVN").prop('hidden', false);
        $("#disR").prop('hidden', true);
        $("#disMK").prop('hidden', false);
        $("#disMB").prop('hidden', true);
        $("#disBP").prop('hidden', false);
        $("#disD").prop('hidden', false);
        $("#disAUP").prop('hidden', true);
        $("#disESD").prop('hidden', false);
        $("#disTO").prop('hidden', false);
        $("#disEED").prop('hidden', false);
        $("#disS").prop('hidden', true);
        $("#disT").prop('hidden', true);
        $("#disV").prop('hidden', true);
        $("#disOT").prop('hidden', true);
        $("#disTM").prop('hidden', true);
        $("#disVT").prop('hidden', true);

        SetFieldRow("disVN", 0);
        SetFieldRow("disMK", 1);
        SetFieldRow("disBP", 1);
        SetFieldRow("disD", 2);

        ez.FormSet._fields = [];
        ezctl = ez;
        if ($('#InsertOrUpdate').val() == "UPDATE") {
            ezctl.FormSet.AddField(
                "costType:req>Data Type",
                "BasedPrice:n+ req>Based Price",
                "MinKM:num req>Minimum KM",
                "effecStartDate:date req>Effective Date (Start)",
                "effecEndDate:date req>Effective Date (End)"
            );
        }
        else {
            ezctl.FormSet.AddField(
                "costType:req>Data Type",
                "VendorName:req>Vendor",
                "BasedPrice:n+ req>Based Price",
                "MinKM:num req>Minimum KM",
                "effecStartDate:date req>Effective Date (Start)",
                "effecEndDate:date req>Effective Date (End)"
            );
        }
    }

    function displayCostBox() {
        $("#disVN").prop('hidden', false);
        $("#disR").prop('hidden', false);
        $("#disMK").prop('hidden', true);
        $("#disMB").prop('hidden', false);
        $("#disBP").prop('hidden', false);
        $("#disD").prop('hidden', true);
        $("#disAUP").prop('hidden', true);
        $("#disESD").prop('hidden', false);
        $("#disEED").prop('hidden', false);
        $("#disTO").prop('hidden', false);
        $("#disS").prop('hidden', false);
        $("#disT").prop('hidden', false);
        $("#disV").prop('hidden', true);
        $("#disOT").prop('hidden', true);
        $("#disTM").prop('hidden', true);
        $("#disVT").prop('hidden', true);

        SetFieldRow("disS", 1);
        SetFieldRow("disR", 1);
        SetFieldRow("disT", 2);
        SetFieldRow("disVN", 2);
        SetFieldRow("disMB", 2);
        SetFieldRow("disBP", 2);

        ez.FormSet._fields = [];
        ezctl = ez;
        if ($('#InsertOrUpdate').val() == "UPDATE") {
            ezctl.FormSet.AddField(
                "costType:req>Data Type",
                "BasedPrice:n+ req>Based Price",
                "MinBox:num req>Minimum Box",
                "effecStartDate:date req>Effective Date (Start)",
                "effecEndDate:date req>Effective Date (End)"
            );
        }
        else {
            ezctl.FormSet.AddField(
                "costType:req>Data Type",
                "VendorName:req>Vendor",
                "BasedPrice:n+ req>Based Price",
                "MinBox:num req>Minimum Box",
                "Sender:req>Sender",
                "Receiver:req>Receiver",
                "effecStartDate:date req>Effective Date (Start)",
                "effecEndDate:date req>Effective Date (End)"
            );
        }
    }

    function displayCostSPSI() {
        $("#disVN").prop('hidden', false);
        $("#disR").prop('hidden', false);
        $("#disMK").prop('hidden', true);
        $("#disMB").prop('hidden', true);
        $("#disBP").prop('hidden', false);
        $("#disD").prop('hidden', true);
        $("#disAUP").prop('hidden', false);
        $("#disESD").prop('hidden', false);
        $("#disEED").prop('hidden', false);
        $("#disTO").prop('hidden', false);
        $("#disS").prop('hidden', true);
        $("#disT").prop('hidden', true);
        $("#disV").prop('hidden', true);
        $("#disOT").prop('hidden', true);
        $("#disTM").prop('hidden', true);
        $("#disVT").prop('hidden', true);

        SetFieldRow("disR", 1);
        SetFieldRow("disVN", 1);
        SetFieldRow("disBP", 2);
        SetFieldRow("disAUP", 2);

        generateDropDownReceiver();

        ez.FormSet._fields = [];
        ezctl = ez;
