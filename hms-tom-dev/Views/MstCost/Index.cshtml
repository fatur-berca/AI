            }
        });
    });

    function Comma(input) {
        var num = input["value"];
        num += '';
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        var x = num.split('.');
        var x1 = x[0];
        var x2 = x.length > 1 ? '.' + x[1] : '';
        var rgx = /(\d+)(\d{3})/;
        while (rgx.test(x1))
            x1 = x1.replace(rgx, '$1' + ',' + '$2');
        $('#' + input["id"] + '').val(x1 + x2);
    }
    $(".search-filter").on("click", function (e) {
        generateTable();
        e.preventDefault();
    });
    $(".reset-search-filter").on("click", function (e) {
        $("#FilterFrom").val(moment(new Date()).format("DD/MM/YYYY"));
        generateTable();
        e.preventDefault();
    });
    function generateDropDownType() {
        var select2 = $('#costType');
        $.ajax({
            url: '@Url.Action("GetDropDownType", "MstCost")',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (data) {
                select2.html('');
                select2.append('<option></option>');
                $.each(data, function (key, val) {
                    select2.append('<option value="' + val.FieldValue + '">' + val.FieldValue + '</option>');
                });
            },
            error: function () {
                select2.html('<option>none available</option>');
            }
        });
    }
</script>