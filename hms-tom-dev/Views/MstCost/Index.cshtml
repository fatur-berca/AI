                <select class="form-control" id="TransMode"></select>
            </div>
        </!--div-->
                            <div id="disD" class="col-md-6" hidden>
                                <div class="form-group">
                                    <label>Discount Price</label>
                                    <input type="text" id="Discount" maxlength="14" class="form-control" placeholder="" onkeypress="return event.charCode >= 48 && event.charCode <= 57" onkeyup="Comma(this);">
