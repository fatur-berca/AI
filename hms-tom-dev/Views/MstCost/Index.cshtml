    function save(statusSave) {
        var idcost = $('#IDCost').val();
        var costType = $("#costType :selected").val();
        
        if (costType == "" || costType === null) {

            $("#textModalError").html("Please choose data type!");
            $('#modalerror').modal('show');
            return;
        };
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });


        var vendorName = $('#VendorName :selected').val();
        var sender = $('#Sender').val();
        var receiver = $('#Receiver').val();
        var through = $('#Through').val();
        var via = $('#Via :selected').val();
        var minimumKM = parseInt($('#MinKM').val().replace(/,/g, ""));
        var minimumBox = parseInt($('#MinBox').val().replace(/,/g, ""));

        var orderType = $('#OrderType :selected').val();
        var transMode = $('#TransMode :selected').val();
        var vehicleType = $('#VechType :selected').val();
        var basedPrice = parseInt($('#BasedPrice').val().replace(/,/g, ""));
        var discount = parseInt($('#Discount').val().replace(/,/g, ""));
        var additionalUnitPrice = parseInt($('#AddUnitPrice').val().replace(/,/g, ""));

        var splitStartDate = $('#effecStartDate').val().split("/");
        var strStartDate = splitStartDate[2] + "-" + splitStartDate[1] + "-" + splitStartDate[0];
        var dStart = moment(strStartDate.toString());
        var effectiveStartDate = dStart.toISOString();
        var effectiveEndDate;
        if ($('#effecEndDate').val() != "") {
            var splitEndDate = $('#effecEndDate').val().split("/");
            var strEndDate = splitEndDate[2] + "-" + splitEndDate[1] + "-" + splitEndDate[0];
            var dEnd = moment(strEndDate.toString());
            effectiveEndDate = dEnd.toISOString();
        }


        if (dStart > dEnd) {

            $("#textModalError").html("Start Date cannot be Greater than End Date");
            $('#modalerror').modal('show');
            dialog.modal('hide');
            return;
        };

        var createddate = $('#CreatedDate').val();
        var createdby = $('#CreatedBy').val();

        var form_data = [{ "CostType": costType, "IDVendor": vendorName, "SenderIDLocation": sender, "ReceiverIDLocation": receiver, "ThroughIDLocation": through, "Via": via, "MinimumKM": minimumKM, "MinimumBox": minimumBox, "OrderType": orderType, "VehicleType": vehicleType, "BasedPrice": basedPrice, "DiscountPrice": discount, "AdditionalUnitPrice": additionalUnitPrice, "EffectiveStartDate": effectiveStartDate, "EffectiveEndDate": effectiveEndDate, "IsActive": true }];
        var data;
        if (statusSave) {
            data = {
                "new": form_data,
                "edit": [{}]
            };
        } else {
            form_data[0]["CreatedDate"] = createddate;
            form_data[0]["CreatedBy"] = createdby;
            form_data[0]["IDCost"] = idcost;
            data = {
                "new": [{}],
                "edit": form_data
                //"edit": [{"CostType": costType, "IDVendor": vendorName, "IDCost": idcost, "EffectiveStartDate": effectiveStartDate, "EffectiveEndDate": effectiveEndDate, "IsActive": true, "CreatedDate": createddate, "CreatedBy": createdby }]
            };
        }
        $.ajax({
            type: 'POST',
            url: '@Url.Action("InsertList", "MstCost")',
            data: data,
            success: function (result) {
                dialog.modal('hide');
                if (result.IsSuccess) {
                    generateTable();
                    $('#labelsuccess').html('Your data has been successfully saved');
                    $('#modalsuccess').modal('show');
                    $('#inputModal').modal('hide');
                    $('#addnew').modal('hide');
                }
                else {
                    $("#textModalError").html('<strong style="font- size:larger">Failed to save data!</strong><br/>' + result.ErrorMessage);
                    $('#modalerror').modal('show');
                }

            },
            error: function () {
                dialog.modal('hide');
                $("#textModalError").html("");
                $("#textModalError").append("Save data Error");
                $('#modalerror').modal('show');
            }
        });
    }

    function editTable() {
        DisabledField();
        $('#newData')[0].reset();
        $('#InsertOrUpdate').val("UPDATE");
        var table = $('#dtFilterMaster').DataTable();
        $('#dtFilterMaster tbody').one('click', 'tr', function () {
            var data = table.row(this).data();
            $('#IDCost').val(data["IDCost"]);
            $('#costType').val(data["CostType"]);
            $('#select2-chosen-1').html("");
            $('#VendorName').html('<option value="' + data['MasterTransportVendor']['IDVendor'] + '">' + data['MasterTransportVendor']['VendorName'] + '</option>');
            $('#VendorName').select2('val', data['MasterTransportVendor']['IDVendor']);

            //console.log(data);
            $('#MinKM').val(data["MinimumKM"]);
            Comma($('#MinKM')[0]);
            $('#MinBox').val(data["MinimumBox"]);
            Comma($('#MinKM')[0]);
            $('#BasedPrice').val(data["BasedPrice"]);
            Comma($('#BasedPrice')[0]);
            $('#Discount').val(data["DiscountPrice"]);
            Comma($('#Discount')[0]);
            $('#AddUnitPrice').val(data["AdditionalUnitPrice"]);
            Comma($('#AddUnitPrice')[0]);

            $('#effecStartDate').val(moment(data["EffectiveStartDate"]).format("DD/MM/YYYY"));
            if (data["EffectiveEndDate"] != null) {
                $('#effecEndDate').val(moment(data["EffectiveEndDate"]).format("DD/MM/YYYY"));
            }

            $('#CreatedDate').val(ToJavaScriptDate(data["CreatedDate"]));
            $('#CreatedBy').val(data["CreatedBy"]);
            if (data["CostType"] == "KM Based")
                displayCostKM();
            else if (data["CostType"] == "Box Based")
                displayCostBox();
            else if (data["CostType"] == "Trip Based")
                displayCostTrip();
            else if (data["CostType"] == "SPSI")
                displayCostSPSI();
            else if (data["CostType"] == "ASDP")
                displayCostASDP();
            else {
                displayNone();
            }
            generateDropDownLocation(data["SenderIDLocation"], data["ThroughIDLocation"], data["ReceiverIDLocation"]);
            generateDropDownList(data["Via"], data["OrderType"], null, data["VehicleType"]);
            generateDropDownVendorName(data["IDVendor"]);
            generateTable();
        });
        $('#inputModal').modal('show');
        $('#btnSave').html('Save Changes');
    }

    function ToJavaScriptDate(value) {
        var pattern = /Date\(([^)]+)\)/;
        var results = pattern.exec(value);
        var dt = new Date(parseFloat(results[1])).toISOString();
        return dt;
    }

