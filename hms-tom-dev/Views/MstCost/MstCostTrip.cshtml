    function ResetPopUpUpload() {
        $("#btnUpload").prop("disabled", true);
        $("#uploadMasterCostTrip").val("");
        $("#uploadMasterCostTrip").jfilestyle('clear');
        fileUpload = "";
    }

    var fileUpload;
    $("#btnPopUpUpload").click(function () {
        ResetPopUpUpload();
    });

    $('#uploadMasterCostTrip').on('change', function (e) {
        $("#btnUpload").prop("disabled", false);
        fileUpload = e.target.files;
    });

    $("#btnUpload").click(function () {
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...Uploading Data</div>',
            closeButton: false
        });
        var data = new FormData();
        for (var x = 0; x < fileUpload.length; x++) {
            data.append("fileUpload", fileUpload[x]);
        }
        $("#btnUpload").prop("disabled", true);
        $.ajax({
            type: "POST",
            url: 'UploadFile',
            contentType: false,
            processData: false,
            cache: false,
            async: false,
            data: data,
            success: function (data) {
                dialog.modal('hide');
                if (data.length == 0) {
                    $("#textModalSucess").html("");
                    $("#textModalSucess").html("Your data has been successfully saved");
                    $('#modalsuccess').modal('show');
                    generateTable();
                }
                else {
                    $("#loadingModal").modal('hide');
                    var txtError = "";
                    for (var i = 0; i < data.length; i++) {
                        var split = data[i].toString().split("-");
                        if (split[0] == "Type") {
                            txtError = txtError + "There is no Cost Type " + split[1] + " in master cost<br/>";
                        }
                        if (split[0] == "Header") {
                            txtError = txtError + "There is no column " + split[3] + ", column number " + split[2] + " in master cost " + split[1] + "<br/>";
                        }
                        if (split[0] == "DataEmpty") {
                            txtError = txtError + "There is no data in row " + split[1] + " column " + split[2] + "<br/>";
                        }
                        if (split[0] == "Parse") {
                            txtError = txtError + "Data in row " + split[1] + " column " + split[2] + " must be " + split[3] + "<br/>";
                        }
                        if (split[0] == "Location") {
                            txtError = txtError + "There is no location " + split[2] + " row " + split[1] + " column " + split[3] + " in master location<br/>";
                        }
                    }
                    $("#textModalError").html("");
                    $("#textModalError").append(txtError);
                    $('#modalerror').modal('show');
                }
                ResetPopUpUpload();
            },
            error: function (xhr, status, p3, p4) {
                dialog.modal('hide');
                var err = "Error " + " " + status + " " + p3 + " " + p4;
                if (xhr.responseText && xhr.responseText[0] == "{")
                    err = JSON.parse(xhr.responseText).Message;
            }
        });
    });

    function Comma(input) {
        var num = input["value"];
        num += '';
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        num = num.replace(',', '');
        var x = num.split('.');
        var x1 = x[0];
        var x2 = x.length > 1 ? '.' + x[1] : '';
        var rgx = /(\d+)(\d{3})/;
        while (rgx.test(x1))
            x1 = x1.replace(rgx, '$1' + ',' + '$2');
        $('#' + input["id"] + '').val(x1 + x2);
    }
</script>