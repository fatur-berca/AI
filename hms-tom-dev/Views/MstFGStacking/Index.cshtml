@{
    ViewBag.Title = "Master Data > Master Finished Good > Stacking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#addnew">Add New</button>
    </div>
</div>

<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr> 
            <th width=5% nowrap class="text-center">Active</th>                      
            <th>Brand</th>
            <th>Location</th>
            <th>Double Stacking</th>
            <th>Max Stacking</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center">Action</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">   
            <th width=5% nowrap class="text-center">Filter</th>         
            <th>Brand</th>
            <th>Location</th>
            <th>Double Stacking</th>
            <th>Max Stacking</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>           
            <th width=5% nowrap class="text-center"></th>
        </tr>
    </thead>
</table>

<!-- Modal -->
<div class="modal fade" id="addnew" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">FG Stacking</h4>
            </div>
            <div class="modal-body">
                <div class="col-md-24">
                    <form id="newData">
                        <div class="row" hidden>
                            <div class="col-md-24">
                                <div class="form-group">
                                    <label>InsertOrUpdate</label>
                                    <input type="text" id="InsertOrUpdate" class="form-control">
                                </div>
                            </div>
                        </div>

                        <div class="row" hidden>
                            <div class="col-md-24">
                                <div class="form-group">
                                    <label>IDFGStacking</label>
                                    <input type="text" id="IDFGStacking" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Brand</label>
                                <select class="form-control" id="Brand"></select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Location</label>
                                <select class="select2" id="Location">                                  
                                </select>
                            </div>
                        </div>                       
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Double Stacking</label>
                                <select class="form-control" id="DoubleStacking">
                                    <option value="1">YES</option>
                                    <option value="0">NO</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Max Stacking</label>
                                <input type="number" id="MaxStacking" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' />
                            </div>
                        </div>   
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Active</label>
                                <select class="form-control" id="Status">
                                    <option value="1">YES</option>
                                    <option value="0">NO</option>
                                </select>
                            </div>
                        </div>                 
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveNew">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="setinactive" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Edit Data Confirmation</h4>
            </div>
            <div class="modal-body">
                Are you sure want to Edit Data?

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" id="btnSaveYes">Yes</button>

            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-warning" id="modalwarning" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/danger.png" alt="">
                <span>Must input brand or location</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/cancel.png" alt="">
                <span>Sorry, the inputted data exists, error or your connection is lost</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div id="Loading" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">DFIS Notification Center</h4>
            </div>
            <div class="modal-body"><img src="assets/images/loading.gif" alt=""><span> Please wait...</span></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>
<!-- END : MODAL INSERTORUPDATE-->
<script type="text/javascript">
    // page   : MasterList
    // author : hakim
    // ticket :
    // date   : 2017-08-11

    $(document).ready(function () {
        // BEGIN : GENERAL Logic
        // clear field when click add new btn
        $('#addNew').click(function () {
            resetData();
          
            generateDropDownBrand();
            $("#Location").select2('data', { id: '', text: '' });
            $('#InsertOrUpdate').val("INSERT");
        });
        $('#btnSaveYes').click(function () {
            edit();
            $('#setinactive').modal('hide');
            $('#addnew').modal('hide');
        });

        $('#btnSaveNew').click(function () {
            //console.log($("#MinStacking").val());
            //console.log($("#MaxStacking").val());
            //console.log($("#MinStacking").val() > $("#MaxStacking").val());
            if ($('#Location :selected').val() == "" || $('#Brand :selected').val() == "")
                $('#modalwarning').modal('show');
            else
            {
                if ($('#newData').find('input[id="InsertOrUpdate"]').val() == "UPDATE")
                    $('#setinactive').modal('show');
                else
                    save();
            }
        });
      
    });

    $('#addnew').on('hidden.bs.modal', function () {
        $('#Location').select2("close");
    });

    function resetData() {
        $('#newData')[0].reset();
        $("#Location").select2('val', "");
        $("#DoubleStacking").val(0);
        document.getElementById("Brand").disabled = false;
        document.getElementById("Location").disabled = false;
    }
    // END : GENERAL Logic

    // BEGIN : JQUERY SELECT TO DataTable
    //call generate table
    generateTable();
    generateDropDownLocation();
   
    //generateDropDownBrand();

    function generateDropDownBrand() {
        //get a reference to the select element
        $select1 = $('#Brand');
        //request the JSON data and parse into the select element
        $.ajax({
            url: 'MstFGStacking/GetListAvailableSpeakingCode',
            dataType: 'JSON',
            success: function (data) {
                //clear the current content of the select
                $select1.html('');
                $select1.html('<option value="NULL"></option>').trigger('change');
                //iterate over the data and append a select option
                $.each(data, function (kunci, tampung) {
                    $select1.append('<option value="' + tampung + '">' + tampung + '</option>');
                });
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select1.html('<option value="NULL">none available</option>');
            }
        });
    }

    function generateDropDownLocation() {
        //get a reference to the select element
        $drpLocation = $('#Location');
        //request the JSON data and parse into the select element
        $drpLocation.append('<option></option>');

        $.ajax({
            url: 'MstFGStacking/GetMasterLocation',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                //clear the current content of the select
               
                //iterate over the data and append a select option
              
                $.each(data, function (kunci, val) {
                    $drpLocation.append('<option value="' + val.IDLocation + '">' + val.LocationName + '</option>');
                    
                })
            },
            error: function () {
                //if there is an error append a 'none available' option
                $drpLocation.html('<option></option');
            }
        });
    }

    //generate table
    function generateTable() {
        $.ajax({
            url: 'MstFGStacking/GetMasterFGStacking',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (data) {
                var table = $('#dtFilterMaster').DataTable({
                    "destroy": true,
                    data: data,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "iDisplayLength": 25,
                    aaSorting: [[6, 'desc']],
                    columns: [
                           {
                               "data": "IsActive", "class": "text-center", "render": function (data) {

                                   if (data == true) {

                                       return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                   } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }

                               }
                           },
                        { 'data': 'Brand', 'searchable': true },
                        { 'data': 'LocationName', 'searchable': true },
                        //{ 'data': 'MinStacking', 'searchable': true },
                         {
                             "data": "DoubleStacking", "class": "text-center", "render": function (data) {

                                 if (data == true) {

                                     return 'Yes';
                                 } else { return 'No'; }

                             }
                         },
                        { 'data': 'MaxStacking', 'searchable': true },
                          {
                              render: function (data, type, row) {
                                  // var tes = { data: 'UpdatedDate', } + { data: 'UpdatedBy' };  
                                  var date = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                  var formatted = date.getFullYear() + "-" +
                                        ("0" + (date.getMonth() + 1)).slice(-2) + "-" +
                                        ("0" + date.getDate()).slice(-2) + " " + date.getHours() + ":" +
                                        date.getMinutes();
                                  //var dt = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                  //var dtStr = dt.toString();
                                  //var date = dtStr.substr(8, 2) + " " + (dtStr.substr(4, 3)) + " " + dtStr.substr(11, 4) + " " + dt.getHours() + ":" +
                                  //      dt.getMinutes();
                                  var jamtanggal = moment(row['UpdatedDate']).format("DD-MMM-YYYY HH:mm");
                                  return '<label hidden>' + row['UpdatedDate'] + '</label>by ' + row['UpdatedBy'] + ' on ' + jamtanggal;
                              }
                          },
                          { 'data': 'UpdatedDate', 'class': 'hidden' },
                     
                           {
                               "data": "IDFGStacking", "class": "text-center", "render": function (data) {
                                   return '<div ><a href="#" id="editForm" onclick="return editTable(' + data + ')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a></div>';
                               }
                           }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 1) && (index < 6)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                //searching with column on datatable
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });
            }
        });
    }
    // END : JQUERY SELECT TO DataTable

    // BEGIN : Insert New Data

    function save() {
        //var data = $('#newData').serialize();
        $('#Loading').modal('show');
        var brand = $('#Brand :selected').val();
        var location = $('#Location :selected').val();
        var maxstacking = $('#newData').find('input[id="MaxStacking"]').val();
        var doublestacking = $('#DoubleStacking :selected').val() == 1 ? true : false;
        var status = $('#Status :selected').val() == 1 ? true : false;

        var data = {
            "new": [{ "Brand": brand, "MaxStacking": maxstacking, "DoubleStacking": doublestacking, "IsActive": status, "IDLocation": location }],
            "edit": [{}]
        };
        $.ajax({
            type: 'POST',
            url: 'MstFGStacking/InsertFGStacking',
            data: data,
            success: function (data) {
              
                if (data.New) {
                    $.each(data.New, function (k, value) {
                        if (value.ResponseType == "Success") {
                            //DFIS.Helper.ResponseNotification(k.ResponseNotification, "Insert Master List", value.FieldName + " - " + value.FieldValue);
                            //alert(value.ResponseType);
                            //generateTable();
                            generateTable();
                            $('#modalsuccess').modal('show');
                            resetData();
                            generateDropDownBrand();
                            generateDropDownLocation();

                            $('#Loading').modal('hide');
                        } else {
                            $('#modalerror').modal('show');
                            $('#Loading').modal('hide');
                        }
                    });

                }
            }
        });
    }
    // END : Insert New Data

    // BEGIN : Edit Data
    // get edit data and assign to modal
    function editTable(id) {
        $('#newData')[0].reset();
        $('#InsertOrUpdate').val("UPDATE");
        generateDropDownBrand();
        document.getElementById("Brand").disabled = true;
        document.getElementById("Location").disabled = true;
        $.ajax({
            url: 'MstFGStacking/GetDataById',
            typr: "GET",
            contentType: "application/json;charset=UTF-8",
            dataType: "json",
            cache: false,
            data: { "IDFGStacking": id },
            success: function (json) {
                console.log(json);
                $('#IDFGStacking').val(json[0]['IDFGStacking']);
                $('#Brand').val(json[0]['Brand']);
                $('#MaxStacking').val(json[0]['MaxStacking']);
                //$('#DoubleStacking').val(json[0]['DoubleS']);
                $("#Location").select2('data', { id: json[0]['IDLocation'], text: json[0]['LocationName']});
                if (json[0]['IsActive']) {
                    $('#Status').val("1");
                } else {
                    $('#Status').val("0");
                }

                if (json[0]['DoubleStacking']) {
                    $('#DoubleStacking').val("1");
                } else {
                    $('#DoubleStacking').val("0");
                }

                ////close modal
                $('#addnew').modal('show');

            }
        });
    }

    //update edited data
    function edit() {
        //var data = $('#newData').serialize();
        $('#Loading').modal('show');

        var id = $('#newData').find('input[id="IDFGStacking"]').val();
        var brand = $('#Brand :selected').val();
        var location = $('#Location :selected').val();
        var maxstacking = $('#newData').find('input[id="MaxStacking"]').val();
        var doublestacking = $('#DoubleStacking :selected').val() == 1 ? true : false;
        var status = $('#Status :selected').val() == 1 ? true : false;

        var data = {
            "new": [{}],
            "edit": [{ "IDFGStacking": id, "Brand": brand, "MaxStacking": maxstacking, "DoubleStacking": doublestacking, "IsActive": status, "IDLocation": location }]
        };
        console.log(data);
        $.ajax({
            type: 'POST',
            url: 'MstFGStacking/InsertFGStacking',
            data: data,
            success: function (data) {
               

                if (data.Edit) {
                    $.each(data.Edit, function (k, value) {
                        if (value.ResponseType == "Success") {
                            //DFIS.Helper.ResponseNotification(k.ResponseNotification, "Insert Master List", value.FieldName + " - " + value.FieldValue);
                            //alert(value.ResponseType);
                            //generateTable();
                            generateTable();
                            $('#modalsuccess').modal('show');
                            resetData();
                            generateDropDownBrand();
                            $('#Loading').modal('hide');

                        } else {
                            $('#modalerror').modal('show');
                            $('#Loading').modal('hide');
                        }
                    });

                }
               
            }
        });
    }
</script>