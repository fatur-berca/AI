@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.General.RecognitionHistoryViewModel
@{
    ViewBag.Title = "General > Recognition History > List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
    bool isSuperUser = false;
    var listbtn = ViewBag.ButtonAccess;
}

@foreach (var x in listUserRole)
{
    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
    {
        isSuperUser = true;
        break;
    }
}

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.AddNew)))
        {
            <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#inputModal">Add New</button>
        }
        <button class="btn btn-primary" id="btnSetInactive" type="button">Delete</button>
        <button class="btn btn-primary" id="btnExportReport">Export</button>
        <button class="btn btn-primary" type="button" id="customReportButton" data-toggle="modal" data-target="#customReportModal">Custom Report</button>
      
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Recovery)))
        {
         <button class="btn btn-primary" id="btnSetActive" type="button">Recovery</button>
        }
    </div>
    <a href="#searchfilter" id="advSearch" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b><i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck nmb">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel wmb wbt">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Certificate Date</label>
                    <div class="row">
                        <div class="col-md-4">
                            <input type="text" id="dtFilterFrom" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                        </div>
                        <div class="col-md-2 to-bi">
                            <label>To</label>
                        </div>
                        <div class="col-md-4">
                            <input type="text" id="dtFilterTo" class="form-control datepicker" data-date-format="DD/MM/YYYY">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Recognition Category</label>
                    <select class="form-control" id="FilterCategory"></select>
                </div>
            </div>

            @if (isSuperUser)
            {
                <div class="col-sm-4">
                    <div class="form-group">

                        <label for="input-type">Status</label>
                        <div id="input-type" class="row">
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" class="isIncludeActive" value="1" type="radio" checked />All
                                </label>
                            </div>
                            <div class="col-sm-2">
                                <label class="radio-inline">
                                    <input name="isIncludeActive" class="isIncludeActive" value="0" type="radio" /> Deleted
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="col-md-12">
                <button id="btnSearch" class="btn btn-primary">Search</button>
                <button id="btnReset" class="btn btn-purple">Reset</button>
            </div>
        </div>
    </div>
</div>

<table id="dtFilterMaster" class="display table dataTable">
    <thead>
    <tr>
        <th data-orderable="false" class="text-center">
            <div class="checkbox-deck">
                <input type="checkbox" id="checkall">
                <label for="checkall"></label>
            </div>
        </th>
        <th class="text-center">Status</th>
        <th>Certificate Date</th>
        <th>Employee Name</th>
        <th>Regional</th>
        <th>Category</th>
        <th>Description</th>
        <th class="text-center">Action</th>
    </tr>
    </thead>
    <thead class="filters">
    <tr class="filter-row">
        <th class="text-center">Filter</th>
        <th class="text-center"></th>
        <th>Certificate Date</th>
        <th>Employee Name</th>
        <th>Regional</th>
        <th>Category</th>
        <th>Description</th>
        <th class="text-center"></th>
    </tr>
    </thead>
</table>

<div class="modal fade" id="inputModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="popUpRecogLabel">Add New Recognition History</h4>
            </div>
            <div class="modal-body">
                <form id="newData">
                    <div class="row" hidden>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>InsertOrUpdate</label>
                                <input type="text" id="InsertOrUpdate" class="form-control">
                            </div>
                        </div>
                    </div>
                    <div class="row" hidden>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>IDFunction</label>
                                <input type="text" id="IDRecognitionHistoryInput" class="form-control">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Certificate Date</label>
                            <input type="text" class="form-control datepicker" name="dtCertificate" id="dtCertificate">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Recognition Category</label>
                            <select class="form-control" id="RecognitionCategory"></select>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Employee Name</label>
                            <select class="select2" id="EmployeeNameInput"></select>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Employee Region</label>
                            <!--<select class="form-control" id="EmployeeRegion"></select>-->
                            <input type="text" class="form-control" id="EmployeeRegionInput">
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Description</label>
                            <textarea id="Description" class="form-control"></textarea>
                            <h6><i>*please input award description and date of event/project</i></h6>
                        </div>
                    </div>
                    <div class="row" hidden>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>CreatedDate</label>
                                <input type="text" id="CreatedDate" class="form-control datepicker">
                            </div>
                        </div>
                    </div>
                    <div class="row" hidden>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>CreatedBy</label>
                                <input type="text" id="CreatedBy" class="form-control">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.SaveChanges)))
                {
                    <button type="button" class="btn btn-primary" id="btnSaveNew">Save Changes</button>
                }
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/checked.png" alt="">
                <span id="labelModalSuccess">Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-warning" id="warningModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="warningUpload">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/danger.png" alt="">
                <span id="textModalWarning"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-warning" id="warningModalYesNo" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabelWarning">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/danger.png" alt="">
                <span id="textModalWarningYesNo"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal" id="confirmationSave">OK</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal" id="ConfirmationCancel">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Notification Modal -->
<div id="notificationModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">DFIS Notification Center</h4>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer"></div>
