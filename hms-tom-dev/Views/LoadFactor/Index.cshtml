    /**
     * JavaScript endsWith is not working in IEv10?
     * https://stackoverflow.com/questions/37544376/javascript-endswith-is-not-working-in-iev10/37545037?utm_medium=organic&utm_source=google_rich_qa&utm_campaign=google_rich_qa
     */
    if (!String.prototype.endsWith) {
        String.prototype.endsWith = function (searchString, position) {
            var subjectString = this.toString();
            if (typeof position !== 'number' || !isFinite(position)
                || Math.floor(position) !== position || position > subjectString.length) {
                position = subjectString.length;
            }
            position -= searchString.length;
            var lastIndex = subjectString.indexOf(searchString, position);
            return lastIndex !== -1 && lastIndex === position;
        };
    }
    
    function exportToExcel(param) {
        //untuk implode dan explode
        var vehicleType = "";
        $("#s2id_ddVehicleType .select2-choices li div").each(function () {
            vehicleType += $(this).text() + ",";
        });
        if (vehicleType != "" || vehicleType != null) {
            if (vehicleType.endsWith(",")) {
                vehicleType = vehicleType.slice(",", vehicleType.length - 1);
            }   
        }

        var Area = "";
        $("#s2id_ddArea .select2-choices li div").each(function () {
            Area += $(this).text() + ",";
        });
        if (Area != "" || Area != null) {
            if (Area.endsWith(",")) {
                Area = Area.slice(",", Area.length - 1);
            }
        }
        
        filter.DateFrom = $("#DateFrom").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
        filter.DateTo = $("#DateTo").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
        filter.Area = Area;
        filter.IDLoadFactorCFP = $("#ddLoadFactor").val();
        filter.VehicleTypes = vehicleType;

        jQuery.ajax({
            url: '@Url.Action("ExportToExcel")',
            method: 'post',
            dataType: 'json',
            data: filter,
            success: function (response) {
                window.location.assign("Assets/Download/" + response);
            }
        });
    }
