            <form id="filter">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>GP Date</label>
                        <div class="row">
                            <div class="col-md-5">
                                <input type="text" id="DateFrom" class="form-control datepicker" value="@DateTime.Now.AddDays(-30).ToString("dd-MM-yyyy")">
                            </div>
                            <div class="col-md-2 to-bi">
                                <label>To</label>
                            </div>
                            <div class="col-md-5">
