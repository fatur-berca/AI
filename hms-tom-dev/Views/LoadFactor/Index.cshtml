                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Area</label>
                        <select class="select2" multiple="multiple" id="ddArea"></select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Load Factor</label>
                        <select class="select2" multiple="multiple" id="ddLoadFactor"></select>
                    </div>
                </div>
                <div class="col-md-6">
