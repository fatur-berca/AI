                        <label>Vehicle Type</label>
                        <select class="select2" multiple="multiple" id="ddVehicleType"></select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12">
                    <button class="btn btn-primary" id="btnSearch">Search</button>
                    <button class="btn btn-purple" onclick="resetSearch()">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

