<script type="text/javascript">
    //var dateFrom = moment(new Date()).add(-1, 'months').format('DD/MM/YYYY');
    //var dateTo = moment(new Date()).format('DD/MM/YYYY');
    jQuery(function($) {
        //$("#DateFrom").val("");
        //$("#DateTo").val("");
        $("#ddYear").val((new Date()).getFullYear());

        generateVehicleType();
        generateTable('firstload');
        generateTable2('firstload');

        $(document).on('click', '#btnSearch', function(e) {
            generateTable("search");
            e.preventDefault();
        });

        $(document).on('click', '#btnSearch2', function(e) {
            generateTable2("search");
            e.preventDefault();
        });

        $(document).on('click', '#exportButton', function(e) {
            exportToExcel('firstload');
            e.preventDefault();
        });
    });

    function resetSearch() {
        $("#ddArea").select2("val", "");
        $("#ddLoadFactor").select2("val", "");
        $("#ddVehicleType").select2("val", "");
        $("#DateFrom").val();
        $("#DateTo").val();
        generateTable();
    }

    function resetSearch() {
        $("#ddYear").val((new Date()).getFullYear());
        generateTable2();
    }

    function generateVehicleType() {
        $.ajax({
            type: 'POST',
            data: {
                FieldName: "vehicletype"
            },
            url: '@Url.Action("GetMasterList")',
            success: function (response) {
                var options = '<option value=""></option>';
                if (response.length) {
                    for (i = 0; i < response.length; i++) {
                        options = options + '<option value="' + response[i].FieldValue + '">' + response[i].FieldValue + '</option>';
                    }
                }
                $('#ddVehicleType').html(options);
                generateLoadFactor();
            }
        });
    }

    function generateLoadFactor() {
        $.ajax({
            type: 'POST',
            data: {
                FieldName: "loadfactorpercentage"
            },
            url: '@Url.Action("GetMasterList")',
            success: function (response) {
                var options = '<option value=""></option>';
                if (response.length) {
                    for (i = 0; i < response.length; i++) {
                        options = options + '<option value="' + response[i].FieldValue + '">' + response[i].FieldValue + '</option>';
                    }
                }
                $('#ddLoadFactor').html(options);
                generateArea();
            }
        });
    }
    
    function generateArea() {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetMasterTransportRegion")',
            success: function (response) {
                var options = '<option value=""></option>';
                if (response.length) {
                    for (i = 0; i < response.length; i++) {
                        options = options + '<option value="GP/' + response[i].GPNumber + '">GP/' + response[i].GPNumber + '</option>';
                    }
                }
                $('#ddArea').html(options);
            }
        });
    }
    
    var filter = new Object();
    function generateTable(param) {
        if (param != "firstload") {
            dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });
        }
        
        filter.DateFrom = (param == "firstload") ? moment($('#DateFrom').val(), 'DD-MM-YYYY').format('YYYY-MM-DD') : $("#DateFrom").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
        filter.DateTo = (param == "firstload") ? moment($('#DateTo').val(), 'DD-MM-YYYY').format('YYYY-MM-DD') : $("#DateTo").val().replace(/(\d\d)\/(\d\d)\/(\d{4})/, "$3-$2-$1");
        filter.Area = (param == "firstload") ? $("#ddArea").val() : ($("#ddArea").val() == null ? $("#ddArea").val() : $("#ddArea").val().toString());
        filter.IDLoadFactorCFP = (param == "firstload") ? $("#ddLoadFactor").val() : ($("#ddLoadFactor").val() == null ? $("#ddLoadFactor").val() : $("#ddLoadFactor").val().toString());
        filter.VehicleTypes = (param == "firstload") ? $("#ddVehicleType").val() : ($("#ddVehicleType").val() == null ? $("#ddVehicleType").val() : $("#ddVehicleType").val().toString());
        $.ajax({
            url: '@Url.Action("GetData")',
            method: 'get',
            dataType: 'json',
            cache: false,
            data: filter,
            success: function (json) {
                if (json.length == 0)
                    alertSearchNoResult();
                var rowsSelected = [];
                var table = $('#dtFilter').DataTable({
                    data: json,
                    "destroy": true,
                    'paging': true,
                    'sort': true,
                    "iDisplayLength": 25,
                    aaSorting: [[4, 'desc']],
                    'searching': true,
                    columns: [
                        {
                            "data": "GPNumber", "class": "text-center", "render": function (data, type, row, meta) {

                                return '<td><div class="checkbox-deck"><input type="checkbox" id="check[' + row["IDCardNumber"] + ']" class="chkList" onchange="InsertTempArray()"><label for="check[' + row["IDCardNumber"] + ']"></label></div></td>';
                            }
                        },
                        { 'data': 'GPNumber', 'searchable': true },
                        {
                            'data': 'Date', 'searchable': true, "render": function (datum) {
                                return moment(datum).format("DD-MMM-YYYY");
                            }
                        },
                        { 'data': 'Week', 'searchable': true },
                        {
                            'data': 'Month', 'searchable': true, "render": function (datum) {
                                var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                                return months[(parseInt(datum) - 1)];
                            }
                        },
                        { 'data': 'Origin', 'searchable': true },
                        { 'data': 'Destination', 'searchable': true },
                        { 'data': 'Transport', 'searchable': true },
                        { 'data': 'Mode', 'searchable': true },
                        { 'data': 'VehicleType', 'searchable': true },
                        { 'data': 'Brand', 'searchable': true },
                        { 'data': 'OriginQty', 'searchable': true },
                        { 'data': 'UOM', 'searchable': true },
                        { 'data': 'DelivertyQty', 'searchable': true },
                        {
                            'data': 'UOM', 'searchable': true, "render": function () {
                                return '<td>Stick</td>'; // delivery uom hardcode stick
                            }
                        },
                        { 'data': 'avgLoadFactor', 'searchable': true }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true,
                    'rowCallback': function (row, data, dataIndex) {
                        // Get row ID
                        var rowId = data.IDCardNumber;
                        //console.log(data.IDCardNumber);
                        // If row ID is in the list of selected row IDs
                        if ($.inArray(rowId, rowsSelected) !== -1) {
                            $(row).find('input[type="checkbox"]').prop('checked', true);
                            $(row).addClass('selected');
                        }
                    }
                });

                //start : handle column search

                $('.dataTables_filter input').attr("placeholder", "Search Here");

                $('#dtFilter thead.filters th').each(function (index) {
                    if ((index >= 1) && (index <= 17)) {
                        var title = $('#dtFilter thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                table.columns().every(function (index) {
                    $('#dtFilter thead.filters th:eq(' + index + ') input').on('keyup change', function () {
                        table.column($(this).parent().index() + ':visible').search(this.value).draw();
                    });
                });

                if (param != "firstload") {
                    dialog.modal('hide');
                }
                // end : handle column search
            }
        });
    }

