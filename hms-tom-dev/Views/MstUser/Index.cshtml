<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#inputModal">Add New</button>
    </div>
</div>

<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr>
            <th width=5% nowrap class="text-center">Active</th>
            <th>User ID</th>
            <th>User Name</th>
            <th>Email</th>
            <th>Address</th>
            <th>Phone</th>
            <th></th>
                        
            <!--<th width=5% nowrap class="text-center">Action</th>-->
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th width=5% nowrap class="text-center">Filter</th>
            <th>User ID</th>
            <th>User Name</th>
            <th>Email</th>
            <th>Address</th>
            <th>Phone</th>
            <th></th>                        
            <!--<th width=5% nowrap class="text-center"></th>-->
        </tr>
    </thead>
</table>

<!-- Modal -->
<div class="modal fade" id="inputModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Master User </h4>
            </div>
            <div class="modal-body">
                <div id="fieldChooser" tabindex="1" class="field-chooser">
                    <div class="col-md-24">
                        <div class="box sameHeight">
                            <form id="newData">
                                <div class="row" hidden>
                                    <div class="col-md-24">
                                        <div class="form-group">
                                            <label>InsertOrUpdate</label>
                                            <input type="text" id="InsertOrUpdate" class="form-control">
                                        </div>
                                    </div>
                                </div>                              
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>User ID</label>
                                        <input type="text" id="IDUser" class="form-control">
                                    </div>
                                </div>                              
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>User Name</label>
                                        <input type="text" id="FullName" class="form-control">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Email</label>
                                        <input type="text" id="Email" class="form-control">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Phone</label>
                                        <input type="text" id="Phone" class="form-control">
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Address</label>
                                        <textarea id="Address" class="form-control"></textarea>
                                    </div>
                                </div>
                              
                                <div class="col-md-6">
                                    <label>Active</label>
                                    <select class="form-control" id="Status">
                                        <option value="1">YES</option>
                                        <option value="0">NO</option>
                                    </select>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveNew">Save changes</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL List Location-->

<div class="modal fade" id="setinactive" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Edit Data Confirmation</h4>
            </div>
            <div class="modal-body">
                Are you sure want to Edit Data?

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" id="btnSaveYes">Yes</button>

            </div>
        </div>
    </div>
</div> 

<div id="Loading" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">DFIS Notification Center</h4>
            </div>
            <div class="modal-body"><img src="./assets/images/loading.gif" alt=""><span> Please wait...</span></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/cancel.png" alt="">
                <span>Sorry, the inputted data exists or your connection is lost</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerroremptyinput" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/cancel.png" alt="">
                <span>Sorry, you must input the <b>UserID</b> and <b>UserName</b></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("#selectLocation").select2({
            dropdownParent: $("#inputModal")
        });
    });
    //javascript menutup dropdown pada saat modal di tutup(ada bug drop down tetap muncul pada saat modal ditutup)
    $('#inputModal').on('hidden.bs.modal', function () {
            $('#selectLocation').select2("close");
        });
</script>

<script type="text/javascript">
    var tempArrayFunction = [];
    var defaultIsActive = true;
    // page   : MasterList
    // author : hakim
    // ticket :
    // date   : 2017-08-11

    $(document).ready(function () {
        generateTable();
    });
    function resetData() {
        $('#newData')[0].reset();
        document.getElementById('IDUser').disabled = false;
    }

    $('#addNew').click(function () {
        resetData();
        $('#InsertOrUpdate').val("INSERT");
    });


    $('#btnSaveNew').click(function () {
        if ($('#newData').find('input[id="InsertOrUpdate"]').val() == "UPDATE")
            $('#setinactive').modal('show');
        else
            save();
    });

    $('#btnSaveYes').click(function () {
        //edit();
        edit();
        $('#setinactive').modal('hide');
        //$('#addnew').modal('hide');
    });

    function editTable(id) {
        resetData();
        $('#InsertOrUpdate').val("UPDATE");
        $.ajax({
            url: 'MstUser/getDataByID',
            type: "GET",
            contentType: "application/json;charset=UTF-8",
            dataType: "json",
            cache: false,
            data: { "IDUser": id },
            success: function (json) {

                $('#IDUser').val(json[0].IDUser);
                $('#FullName').val(json[0].FullName);
                $('#Email').val(json[0].Email);
                $('#Phone').val(json[0].Phone);
                $('#Address').val(json[0].Address);
                if (json[0].IsActive) {
                    $('#Status').val("1");
                } else {
                    $('#Status').val("0");
                }

                $('#inputModal').modal('show');
                document.getElementById('IDUser').disabled = true;

            }
        });
    }


    function generateTable() {
        $.ajax({
            url: 'MstUser/getMasterUserViews',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (data) {
                var table = $('#dtFilterMaster').DataTable({
                    "destroy": true,
                    data: data,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "iDisplayLength": 25,
                    columns: [
                        {
                            "data": "IsActive", "class": "text-center", "render": function (data) {
                                if (data == true) {
                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }
                            }
                        },
                        { 'data': 'IDUser', 'searchable': true },
                        { 'data': 'FullName', 'searchable': true },
                        { 'data': 'Email', 'searchable': true },
                        { 'data': 'Address', 'searchable': true },
                        { 'data': 'Phone', 'searchable': true },

                        {
                            "data": "IDUser", "class": "text-center", "render": function (data) {

                                return '<div ><a href="#" id="editForm" onclick="editTable(' + "'" + data.replace(new RegExp(/\\/g),"-") + "'" + ')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a><td>';
                            }
                        }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 1) && (index < 6)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });
            }
        });
    }
    // END : JQUERY SELECT TO DataTable

    function save() {
        //var data = $('#newData').serialize();
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });


        //$('#Loading').modal('show');

        var IDUser = $('#IDUser').val();
        var FullName = $('#FullName').val();

        if ((IDUser == null || IDUser == '') ||
            (FullName == null || FullName == '')) {
            dialog.modal('hide');
            $('#modalerroremptyinput').modal('show');
        }
        var Email = $('#Email').val();
        if (Email == null || Email == '') {
            Email = ' ';
        }
        var Phone = $('#Phone').val();
        if (Phone == null || Phone == '' ) {
            Phone = ' ';
        }
        var Address = $('#Address').val();
        if (Address == null || Address == '') {
            Address = ' ';
        }

        var status = $('#Status :selected').val() == 1 ? true : false;

        var data = {
            "new": [{ "IDUser": IDUser, "FullName": FullName, "Email": Email, "IsActive": status, "Address": Address, "Phone": Phone }],
            "edit": [{}]
        };
        if ((IDUser != null && IDUser != '') && (FullName != null && FullName != ''))
        {
            $.ajax({
                type: 'POST',
                /* url: 'MstUser/InsertUser',*/
                url: '@Url.Action("InsertUser")',
                data: data,
                success: function (data) {

                    if (data.New) {
                        $.each(data.New, function (k, value) {
                            if (value.ResponseType == "Success") {

                                dialog.modal('hide');
                                generateTable();
                                $('#modalsuccess').modal('show');
                                resetData();


                            } else {
                                $('#modalerror').modal('show');
                                //$('#Loading').modal('hide');
                                dialog.modal('hide');
                            }
                        });

                    }
                }
            });
        }
    }


    function edit() {
        //var data = $('#newData').serialize();
        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });


        //$('#Loading').modal('show');

        var IDUser = $('#IDUser').val();;
        var FullName = $('#FullName').val();
        if ((IDUser == null || IDUser == '') ||
            (FullName == null || FullName == ''))
        {
            dialog.modal('hide');
            $('#modalerroremptyinput').modal('show');
        }
        var Email = $('#Email').val();
        if (Email == null || Email == '') {
            Email = ' ';
        }
        var Phone = $('#Phone').val();
        if (Phone == null || Phone == '') {
            Phone = ' ';
        }
        var Address = $('#Address').val();
        if (Address == null || Address == '') {
            Address = ' ';
        }

        var status = $('#Status :selected').val() == 1 ? true : false;

        var data = {
            "new": [{}],
            "edit": [{ "IDUser": IDUser, "FullName": FullName, "Email": Email, "IsActive": status, "Address": Address, "Phone": Phone }]
        };
        if ((IDUser != null && IDUser != '') && (FullName != null && FullName != ''))
        {
            $.ajax({
                type: 'POST',
                url: 'MstUser/InsertUser',
                data: data,
                success: function (data) {

                    if (data.Edit) {
                        $.each(data.Edit, function (k, value) {
                            if (value.ResponseType == "Success") {

                                dialog.modal('hide');
                                generateTable();
                                $('#modalsuccess').modal('show');
                                $('#inputModal').modal('hide');
                                resetData();

                            } else {
                                $('#modalerror').modal('show');
                                //$('#Loading').modal('hide');
                                dialog.modal('hide');
                            }
                        });

                    }
                }
            });
        }
    }

</script>



