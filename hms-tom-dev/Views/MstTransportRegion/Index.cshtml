
@{
    ViewBag.Title = " Master Data > Master Trans > Trans Region";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        <button id="addNew" class="btn btn-primary" type="button" data-toggle="modal" data-target="#addnew">Add New</button>
    </div>
</div>

<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr>
            <th width=5% nowrap class="text-center">Active</th>                        
            <th>GP Number</th>
            <th>Transport Region</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center">Action</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th width=5% nowrap class="text-center">Filter</th>                        
            <th>GP Number</th>
            <th>Transport Region</th>
            <th>Last Update</th>
            <th hidden>Last Update</th>
            <th width=5% nowrap class="text-center"></th>
        </tr>
    </thead> 
</table>

<!-- Modal -->
<div class="modal fade" id="addnew" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Transport Region</h4>
            </div>
            <div class="modal-body">
                <div class="col-md-24">
                    <form id="newData">
                        <div class="row" hidden>
                            <div class="col-md-24">
                                <div class="form-group">
                                    <label>InsertOrUpdate</label>
                                    <input type="text" id="InsertOrUpdate" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="row" hidden>
                            <div class="col-md-24">
                                <div class="form-group">
                                    <label>IDTransportRegion</label>
                                    <input type="text" id="IDTransportRegion" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>GP Number </label>
                                <input type="text" id="GPNumber" class="form-control" style="text-transform: uppercase" placeholder="e.g. KAR, SUR, PAN" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Transport Region</label>
                                <input type="text" id="TransportRegion" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Active</label>
                                <select class="form-control" id="Status">
                                    <option value="1">YES</option>
                                    <option value="0">NO</option>
                                </select>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveNew">Save Changes</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="setinactive" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Edit Data Confirmation</h4>
            </div>
            <div class="modal-body">
                Are you sure want to Edit Data?

            </div>
            <div class="modal-footer">               
                <button type="button" class="btn btn-purple" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" id="btnSaveYes">Yes</button>

            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/cancel.png" alt="">
                <span>Sorry, the inputted data exists or your connection is lost</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade ml-warning" id="modalwarning" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/danger.png" alt="">
                <span>Please fill the empty field(s) before saving </span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<div id="Loading" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">DFIS Notification Center</h4>
            </div>
            <div class="modal-body"><img src="assets/images/loading.gif" alt=""><span> Please wait...</span></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>
<script type="text/javascript">
    // page   : MasterList
    // author : hakim
    // ticket :
    // date   : 2017-08-11

    $(document).ready(function () {
        // BEGIN : GENERAL Logic
        // clear field when click add new btn
        $('#addNew').click(function () {
            resetData();
            $('#InsertOrUpdate').val("INSERT");
            document.getElementById("GPNumber").disabled = false;
        });

    });

    function resetData() {
        $('#newData')[0].reset();
    }
    // END : GENERAL Logic

    // BEGIN : JQUERY SELECT TO DataTable
    //call generate table
    generateTable();
  
    //generate table
    function generateTable() {
        $.ajax({
            url: 'MstTransportRegion/GetMasterTransportRegion',
            method: 'get',
            dataType: 'json',
            cache:false,
            success: function (data) {
                var table = $('#dtFilterMaster').DataTable({
                    "destroy": true,
                    data: data,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "iDisplayLength": 25,
                    aaSorting: [[4, 'desc']],
                    columns: [
                       {
                           "data": "IsActive", "class": "text-center", "render": function (data) {

                               if (data == true) {

                                   return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                               } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }

                           }
                       },
                        { 'data': 'GPNumber', 'searchable': true },
                        { 'data': 'TransportRegion', 'searchable': true },
                         {
                             render: function (data, type, row) {
                                 // var tes = { data: 'UpdatedDate', } + { data: 'UpdatedBy' };  
                                 var date = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                 var formatted = date.getFullYear() + "-" +
                                       ("0" + (date.getMonth() + 1)).slice(-2) + "-" +
                                       ("0" + date.getDate()).slice(-2) + " " + date.getHours() + ":" +
                                       date.getMinutes();
                                 //var dt = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                 //var dtStr = dt.toString();
                                 //var date = dtStr.substr(8, 2) + " " + (dtStr.substr(4, 3)) + " " + dtStr.substr(11, 4) + " " + dt.getHours() + ":" +
                                 //      dt.getMinutes();
                                 var jamtanggal = moment(row['UpdatedDate']).format("DD-MMM-YYYY HH:mm");
                                 return '<label hidden>' + row['UpdatedDate'] + '</label>by ' + row['UpdatedBy'] + ' on ' + jamtanggal;
                             }
                         },
                          { 'data': 'UpdatedDate', 'class': 'hidden' },
                            {
                                "data": "IDTransportRegion", "render": function (data) {
                                    return '<div align="center"><a href="#" id="editForm" onclick="return editTable(' + data + ')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a></div>';
                                }
                            }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 1) && (index < 4)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                //searching with column on datatable
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });
            }
        });
    }
    // END : JQUERY SELECT TO DataTable

    // BEGIN : Insert New Data
    $('#btnSaveYes').click(function () {
        edit();
        $('#setinactive').modal('hide');
        $('#addnew').modal('hide');
    });

    $('#btnSaveNew').click(function () {
        //alert($('#newData').find('input[id="InsertOrUpdate"]').val());
        if ($('#newData').find('input[id="GPNumber"]').val() == "" || $('#newData').find('input[id="TransportRegion"]').val() == "") {
            $('#modalwarning').modal('show');
        } else {
            if ($('#newData').find('input[id="InsertOrUpdate"]').val() == "UPDATE") {

                $('#setinactive').modal('show');

            } else {
                save();

            }
        }
        
    });


    function save() {
        //var data = $('#newData').serialize();       
        $('#Loading').modal('show');
        var gpnumber = $('#newData').find('input[id="GPNumber"]').val();   
        var transportregion = $('#newData').find('input[id="TransportRegion"]').val();       
        var status = $('#Status :selected').val() == 1 ? true : false;

        var data = {
            "new": [{ "GPNumber": gpnumber, "TransportRegion": transportregion, "IsActive": status }],
            "edit": [{}]
        };
        console.log(data);
        $.ajax({
            type: 'POST',
            url: 'MstTransportRegion/InsertTransportRegion',
            data: data,
            success: function (data) {

                if (data.New) {
                    $.each(data.New, function (k, value) {
                        if (value.ResponseType == "Success") {
                            //DFIS.Helper.ResponseNotification(k.ResponseNotification, "Insert Master List", value.FieldName + " - " + value.FieldValue);
                            //alert(value.ResponseType);
                            //generateTable();
                            generateTable();
                            $('#modalsuccess').modal('show');
                            $('#Loading').modal('hide');
                            resetData();
                        } else {
                            $('#modalerror').modal('show');
                            $('#Loading').modal('hide');

                        }

                    });
                } 

                //close modal
              
            }
        });
    }
    // END : Insert New Data

    // BEGIN : Edit Data
    // get edit data and assign to modal
    function editTable(id) {
        $('#newData')[0].reset();
        $('#InsertOrUpdate').val("UPDATE");
        document.getElementById("GPNumber").disabled = true;
        $.ajax({
            url: 'MstTransportRegion/GetDataById',
            type: "GET",
            contentType: "application/json;charset=UTF-8",
            dataType: "json",
            cache: false,
            data: { "IDTransportRegion": id },
            success: function (json) {
                $('#IDTransportRegion').val(json.IDTransportRegion);
                $('#GPNumber').val(json.GPNumber);
                $('#TransportRegion').val(json.TransportRegion);              

                if (json.IsActive) {
                    $('#Status').val("1");
                } else {
                    $('#Status').val("0");
                }

                ////close modal
                $('#addnew').modal('show');

            }
        });
    }

    //update edited data
    function edit() {
        //var data = $('#newData').serialize();
        $('#Loading').modal('show');
        var id = $('#newData').find('input[id="IDTransportRegion"]').val();
        var gpnumber = $('#newData').find('input[id="GPNumber"]').val();
        var transportregion = $('#newData').find('input[id="TransportRegion"]').val();
        var status = $('#Status :selected').val() == 1 ? true : false;

        var data = {
            "new": [{}],
            "edit": [{ "IDTransportRegion": id, "GPNumber": gpnumber, "TransportRegion": transportregion, "IsActive": status }],

        };

        $.ajax({
            type: 'POST',
            url: 'MstTransportRegion/InsertTransportRegion',
            data: data,
            success: function (data) {
                //if (data.New) {
                //    $.each(data.New, function (k, value) {
                //        console.log(value);
                //        if (value.responseType == "Success") {
                //            //DFIS.Helper.ResponseNotification(value, "Insert Master List", value.FieldName + " - " + value.FieldValue);
                //            generateTable();
                //        }

                //    });
                //}
                //generateTable();
           

                if (data.Edit) {
                    $.each(data.Edit, function (k, value) {
                        if (value.ResponseType == "Success") {
                            //DFIS.Helper.ResponseNotification(k.ResponseNotification, "Insert Master List", value.FieldName + " - " + value.FieldValue);
                            //alert(value.ResponseType);
                            //generateTable();
                            generateTable();

                            $('#modalsuccess').modal('show');
                            resetData();
                            $('#Loading').modal('hide');
                        } else {
                            $('#modalerror').modal('show');
                            $('#Loading').modal('hide');

                        }

                    });
                }

            }
        });
    }

</script>


