    // BEGIN : JQUERY SELECT TO DataTable
    //call generate table

    function generateMaterialType(selectedData) {
        //get a reference to the select element
        $select1 = $('#ListMaterialType');
        //request the JSON data and parse into the select element
        $.ajax({
            url: 'MstUom/GetMasterListType',
            method: 'get',
            dataType: 'JSON',
            data: { "FieldName": "MaterialType" },
            success: function (data1) {
                
                //clear the current content of the select
                $select1.html('');
                //iterate over the data and append a select option
                $select1.html('<option value=""></option>').trigger('change');

                $.each(data1, function (key, val) {
                    $select1.append('<option value="' + val.FieldValue + '">' + val.FieldValue + '</option>');
                });
                $select1.select2('val', selectedData);
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select1.html('<option value="">none available</option>');
            }
        });
    }

    function generateMaterialUom(selectedData) {
        //get a reference to the select element
        $select2 = $('#ListUom');
        //request the JSON data and parse into the select element
        $.ajax({
            url: 'MstUom/GetMasterListUom',
            method: 'get',
            dataType: 'JSON',
            data: { "FieldName": "UoM" },
            success: function (data2) {
                
                //clear the current content of the select
                $select2.html('');
                //iterate over the data and append a select option
                $select2.html('<option value=""></option>').trigger('change');

                $.each(data2, function (key, val2) {
                    $select2.append('<option value="' + val2.FieldValue + '">' + val2.FieldValue + '</option>');
                });
                $select2.select2('val', selectedData);
            },
            error: function () {
                //if there is an error append a 'none available' option
                $select2.html('<option value="">none available</option>');
            }
        });
    }

    //generate table
    function generateTable() {
        $.ajax({
            url: 'MstUom/GetMasterUom',
            method: 'get',
            dataType: 'json',
            cache: false,
            success: function (json) {
                var table = $('#dtFilterMaster').DataTable({
                    data: json,
                    "destroy": true,
                    'paging': true,
                    'sort': true,
                    "iDisplayLength": 25,
                    aaSorting: [[4, 'desc']],
                    'searching': true,
                    columns: [
                        {
                            "data": "IsActive", "class": "text-center", 'sortable': false, "render": function (data) {
                                if (data == true) {
                                    return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                                } else { return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>'; }
                            }
                        },
                        { 'data': 'MaterialType', 'searchable': true },
                        { 'data': 'UoM', 'searchable': true },
                        {
                            render: function (data, type, row) {
                                var date = new Date(parseInt(row['UpdatedDate'].substr(6)));
                                var formatted = date.getFullYear() + "-" +
                                      ("0" + (date.getMonth() + 1)).slice(-2) + "-" +
                                      ("0" + date.getDate()).slice(-2) + " " + date.getHours() + ":" +
                                      date.getMinutes();
                                var jamtanggal = moment(row['UpdatedDate']).format("DD-MMM-YYYY HH:mm");
                                return '<label hidden>' + row['UpdatedDate'] + '</label>by ' + row['UpdatedBy'] + ' on ' + jamtanggal;
                            }
                        },
                       { 'data': 'UpdatedDate', 'class': 'hidden' },
                         {
                             "data": "IDUoM", 'sortable': false, "class": "text-center", "render": function (data) {
                                 return '<div ><a href="#" id="editForm" onclick="return editTable(' + data + ')"><i data-toggle="modal" class="fa fa-pencil-square-o" ></i></a></div>';
                             }
                         }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    if ((index >= 1) && (index < 5)) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });

                //searching with column on datatable
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });


            }

        });

    }
    // END : JQUERY SELECT TO DataTable

    // BEGIN : Insert New Data
    $('#btnSaveYes').click(function () {
        save(true);
        return;
        edit();
        $('#setinactive').modal('hide');
        $('#inputModal').modal('hide');
    });

    $('#btnSaveNew').click(function () {
        if ($('#InsertOrUpdate').val() == "UPDATE") {
            if (Validate())
                $('#setinactive').modal('show');
        } else {
            save();
        }
        return;
        //alert($('#newData').find('input[id="InsertOrUpdate"]').val());
        if ($('#newData').find('input[id="InsertOrUpdate"]').val() == "UPDATE") {
            $('#setinactive').modal('show');
        } else {
            save();
        }
    });

    function Validate() {
        if (ez.Form.Validate()) {
            return true;
        }
        //  $("#textModalError").html("");
        $("#textModalError").html(ez.Form.error);
        $('#modalerror').modal('show');
        return false;
    }

    function save(editMode) {
        editMode = editMode === undefined ? false : true;
        $('#setinactive').modal('hide');
        var pull_data = [ez.Form.GetData()];

        if (Validate()) {
            if (editMode) {
                pull_data[0]["IdUom"] = $("#IdUom").val();
            }
            var data = {
                "new": !editMode ? pull_data : [{}],
                "edit": editMode ? pull_data : [{}]
            };

            $.ajax({
                type: 'POST',
                url: 'MstUom/InsertList',
                data: data,
                success: function (returnVal) {
                    if (returnVal.IsSuccess) {
                        generateTable();
                        $('#modalsuccess').modal('show');
                        resetData();
                        $('#inputModal').modal('hide');
                    }
                    else {
                        $("#textModalError").html("");
                        $("#textModalError").append('<strong style="font- size:larger">Failed to save data!</strong><br/>' + returnVal.ErrorMessage);
                        $('#modalerror').modal('show');
                    }
                },
                error: function (msg) {
                    $("#textModalError").html("");
                    $("#textModalError").append("Failed to save data.");
                    $('#modalerror').modal('show');
                }
            });
        }
        else
        {
            $("#textModalError").html("");
            $("#textModalError").append(ez.Form.error);
            $('#modalerror').modal('show');
        }
    }
    // END : Insert New Data

