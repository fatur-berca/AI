    function editTable(id) {
        DisabledField();
        //resetData();
        $('#InsertOrUpdate').val("UPDATE");
        $("#btnSaveNew").html("Save Changes");
        
        var table = $('#dtFilterMaster').DataTable();
        $('#dtFilterMaster tbody').one('click', 'tr', function () {
            var data = table.row(this).data();
            generateMaterialType(data["MaterialType"]);
            generateMaterialUom(data["UoM"]);
            if (data["IsActive"])
                $('#Status').val("1");
            else
                $('#Status').val("0");
            $('#IdUom').val(data["IDUoM"]);
            $("#crBy").val(data["CreatedBy"]);
        });

        $('#inputModal').modal('show');
    }

