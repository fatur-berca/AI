        $('#confirmationSave').on('click', function () {
            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
                closeButton: false
            });

            $.ajax({
                complete: function () { dialog.modal('hide'); },
                url: '@Url.Action("../StockCount/DeleteTransaction")',
                cache: false,
                data: {
                    IDStockCount: $('#ReferId').val()
                },
                method: 'POST',
                dataType: 'json',
                success: function (res) {
                    dtFilter.row(SelectedRow).remove().draw();
                    SelectedRow = null;
                    $('#textModalWarning').html('Data has been successfully deleted');
                    $('#warningModal').modal('show');
                }
            })
        });

        $(document).on('click', '.btnDelete', function () {
            var TransId = $(this).attr('TransId');
            SelectedRow = $(this).closest('tr');
            //dtFilter.draw(false);
            $('#ReferId').val(TransId);
            $('#textModalWarningYesNo').html('Are you sure want to delete this transaction?');
            $('#warningModalYesNo').modal('show');
        });

        $(document).on('click', '.btnDownloadAttachment', function () {
            var html = $(this).siblings('.attachment_content').html();
            $('#attachmentDialogText').html(html);
            $('#attachmentDialog').modal('show');
        });

        $('#btnSearch').on('click', function () {
            loadData();
        });

        $('#warehouse').on('change', function () {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("../StockCount/GetUserByLocations")',
                cache: false,
                data: { IDLocations: $('#warehouse').val() },
                success: function (response) {
                    var options = '<option value="">None</option>';
                    if (response.length) {
                        for (i = 0; i < response.length; i++) {
                            options = options + '<option value="' + response[i].IDUser + '">' + response[i].MasterUser.FullName + '</option>';
                        }
                    }
                    $('#staff').html(options);
                }
            });
        });

        $('#btnReset').on('click', function () {
            $('#frmFilter :input').each(function () {
                if ($(this).is('select')) {
                    $(this).select2('val', '');
                } else {
                    $(this).val('');
                }
            });
        })
    })

    function numberWithCommas(x) {
        return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    function showDialog(message) {
        if (message == '' || message === undefined) message = 'Please Wait...'
        return bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> ' + message + '</div>',
            closeButton: false
        });
    }

    $('#btnPrintBerita').on('click', function (){

