                jabatanStock1: $('#jabatanStockTeam1').val(),
                namaStock2: $('#namaStockTeam2').val(),
                jabatanStock2: $('#jabatanStockTeam2').val(),
                namaStock3: $('#namaStockTeam3').val(),
                jabatanStock3: $('#jabatanStockTeam3').val()
            },
            success: function (res) {
