<script type="text/javascript">
    var tempProNumber = [];//array untuk menyimpan productivity number ketika checkbox bagian kiri di klik(dipakai untuk query)
    var filter = new Object();//object filter input
    //var ShiftList = JSON.parse('@(jsonShift)');

    function generateWareHouseName() {
        var select = $('#warehouse');
        $.ajax({
            url: '@Url.Action("../StockCount/GetLocationData")',
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                select.html('');
                select.html('<option></option>');
                $.each(data,
                    function (key, val) {
                        select.append('<option value="' + val.IDLocation + '">' + val.LocationName + '</option>');
                    });

                @if (!String.IsNullOrEmpty(ParamIDLocation))
                {
                    <text>
                $('#warehouse').select2('val', '@ParamIDLocation');
                </text>
                }

                loadData();
            },
            error: function () {
                select.html('<option>none available</option>');
            }
        });
    }
    /*
    function loadData()
    {
        var table = $('#dtFilter').DataTable({
            'destroy': true,
            'empty': true,
            //data: json,
            'searching': true,
            'autoWidth': false,
            "iDisplayLength": 25,
            columns: [
            ],
            "dom": 'lf<"table-overflow"t>ip',
            orderCellsTop: true
        });
    }
    */

    var dtFilter = null;

    function loadData() {
        if (dtFilter != null) {
            dtFilter.clear().draw();
        }

        var targetColumns = [];

        for (var i = 7; i <= 31; i++) {
            targetColumns.push(i);
        }

        var filterType = $('#type').val() == 1 ? true : false;
        filterType = $('#type').val() == "" ? null : filterType;

        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });
        //dialog.modal('hide');
        $.ajax({
            //beforeSend: function () { $("#textModalLoading").html(" Please Wait"); $("#loadingModal").modal('show'); },
            complete: function () { dialog.modal('hide'); },
            criteria: {
                SortExpression: "Year",
                SortOrder: "ASC",
            },
            url: '@Url.Action("../StockCount/GetData")',
            cache: false,
            data: {
                "filterStartDate": moment($('#startDate').val(), 'DD-MM-YYYY').format('YYYY-MM-DD'), //$('#startDate').val(),
                "filterEndDate": moment($('#endDate').val(), 'DD-MM-YYYY').format('YYYY-MM-DD'),//$('#endDate').val(),
                "IDLocations": $('#warehouse').val(),
                "Shift": $('#shift').val(),
                "WarehouseStaff1": $('#staff').val(),
                'Type': filterType,
                'InvAcc': $('#invAcc').val(),
                'InvUtil': $('#invUtil').val(),
            },
            method: 'POST',
            dataType: 'json',
            success: function (res) {
                dtFilter = $('#dtFilter').DataTable({
                    //"order": [[ -1, "" ]],
                    "order": [],
                    //"bSort": true,
                    "destroy": true,
                    'paging': true,
                    //'sort': true,
                    'searching': true,
                    'autowidth': false,
                    "iDisplayLength": 25,
                    "dom": '<"table-overflow"t>ip',
                    'orderCellsTop': true,
                    "columnDefs": [
                                    {
                                        className: "dt-body-right", "targets": targetColumns
                                    },
                                    {
                                        className: "dt-body-center", "targets": [0, 1, 3, 33]
                                    },
                                    {
                                        className: "dt-body-center", "targets": 32
                                    },
                    ],
                    //scrollY: "300px",
                    //scrollX: true,
                    //scrollCollapse: true,
                    //paging: false,
                    /*
                    fixedColumns: {
                        leftColumns: 6,
                    }
                    */
                });
                var listShift = res.listShift;

                //console.log(listShift);
                for (i in res.data) {
                    var AttachNo = 1;
                    var r = res.data[i];

                    if (r.Shift == 0) continue;
                    //console.log(r);
                    var urlAttachment = '<div class="attachment_content" style="display:none">';
                    r.TransDate = moment(r.TransDate).format("DD-MMM-YYYY")

                    var AttachmentUrlName = 'AttachmentWarehouseStockCount_' + r.TransDate + '_' + r.IDLocation + '_' + r.Shift;
                    if (r.Attachment != null) {
                        urlAttachment += '<a class="space_attachment" target="_blank" href="@Url.Content(@System.Configuration.ConfigurationManager.AppSettings["LocationFileWarehouseStockCount"])' + r.Attachment + '"><i class="fa fa-download"> Attachment - ' + (AttachNo++) + '</i></a><div style="height: 10px;"></div>';
                    }

                    if (r.Attachment2 != null) {
                        urlAttachment += '<a class="space_attachment" target="_blank" href="@Url.Content(@System.Configuration.ConfigurationManager.AppSettings["LocationFileWarehouseStockCount"])' + r.Attachment2 + '"><i class="fa fa-download"> Attachment - ' + (AttachNo++) + '</i></a><div style="height: 10px;"></div>';
                    }

                    if (r.Attachment3 != null) {
                        urlAttachment += '<a class="space_attachment" target="_blank" href="@Url.Content(@System.Configuration.ConfigurationManager.AppSettings["LocationFileWarehouseStockCount"])' + r.Attachment3 + '"><i class="fa fa-download"> Attachment - ' + (AttachNo++) + '</i></a><div style="height: 10px;"></div>';
                    }

                    if (r.Attachment4 != null) {
                        urlAttachment += '<a class="space_attachment" target="_blank" href="@Url.Content(@System.Configuration.ConfigurationManager.AppSettings["LocationFileWarehouseStockCount"])' + r.Attachment4 + '"><i class="fa fa-download"> Attachment - ' + (AttachNo++) + '</i></a><div style="height: 10px;"></div>';
                    }

                    if (r.Attachment5 != null) {
                        urlAttachment += '<a class="space_attachment" target="_blank" href="@Url.Content(@System.Configuration.ConfigurationManager.AppSettings["LocationFileWarehouseStockCount"])' + r.Attachment5 + '"><i class="fa fa-download"> Attachment - ' + (AttachNo++) + '</i></a><div style="height: 10px;"></div>';
                    }

                    if (r.Attachment6 != null) {
                        urlAttachment += '<a class="space_attachment" target="_blank" href="@Url.Content(@System.Configuration.ConfigurationManager.AppSettings["LocationFileWarehouseStockCount"])' + r.Attachment6 + '"><i class="fa fa-download"> Attachment - ' + (AttachNo++) + '</i></a>';
                    }

                    urlAttachment += '</div>';

                    dtFilter.row.add([
                        urlAttachment + '<button class="btn btn-primary btnDownloadAttachment"><i class="fa fa-download"></i></button>',
                        r.Status == null || r.Status == '' ? 'None' : r.Status,
                        '<a href="@Url.Action("ViewDetail", "StockCount")?id=' + r.IDStockCount + '" target="_blank">' + r.TransDate + '</a>',
                        listShift[r.Shift], r.IsReportWeekly ? 'Weekly' : 'Daily', r.WarehouseName, r.WarehouseStaff1Name,
                        numberWithCommas(r.TotalSAP1000Box), numberWithCommas(r.TotalSAP1000Pack), numberWithCommas(r.TotalMan1000Box), numberWithCommas(r.TotalMan1000Pack),
                        numberWithCommas(r.TotalSAP1040Box), numberWithCommas(r.TotalSAP1040Pack), numberWithCommas(r.TotalMan1040Box), numberWithCommas(r.TotalMan1040Pack),
                        numberWithCommas(r.TotalSAP1041Box), numberWithCommas(r.TotalSAP1041Pack), numberWithCommas(r.TotalMan1041Box), numberWithCommas(r.TotalMan1041Pack),
                        numberWithCommas(r.TotalSAP1042Box), numberWithCommas(r.TotalSAP1042Pack), numberWithCommas(r.TotalMan1042Box), numberWithCommas(r.TotalMan1042Pack),
                        numberWithCommas(r.TotalSAP1043Box), numberWithCommas(r.TotalSAP1043Pack), numberWithCommas(r.TotalMan1043Box), numberWithCommas(r.TotalMan1043Pack),
                        numberWithCommas(r.TotalSAP1046Box), numberWithCommas(r.TotalSAP1046Pack), numberWithCommas(r.TotalMan1046Box), numberWithCommas(r.TotalMan1046Pack),
                        r.InvAcc, r.InvUtil,
                        '<button class="btn btn-primary btnDelete" TransId="' + r.IDStockCount + '"><i class="fa fa-trash"></i></button>'
                        //r.Remarks,
                        //'<a href="@Url.Action("ViewDetail", "StockCount")?id=' + r.IDStockCount + '" target="_blank"><i class="fa fa-eye"></i> View</a>'
                    ]).draw();
                }
                /*
                $('#dtFilter thead.filters th').each(function (index) {
                    if (index >= 1 && index < columnLength - 3) {
                        var title = $('#dtFilter thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });
                */
                /*
                dtFilter.columns().every(function (index) {
                    if (index >= 1) {
                        $('#dtFilter thead.filters th:eq(' + index + ') input').on('input', function () {
                            dtFilter.column($(this).parent().index() + ':visible').search(this.value).draw();
                        });
                    }
                });
                */
                var columnLength = $('#dtFilter thead.filters th').length;

                dtFilter.columns().every(function (index) {
                    if (index > 0) {
                        $('#dtFilter thead.filters th:eq(' + index + ') input').on('keyup change', function () {
                            dtFilter.column($(this).parent().index() + ':visible').search(this.value).draw();
                        });
                    }
                });

                //clear search textbox on 1st col
                $('#dtFilter .filter-row th:first').html('');
                $('#dtFilter .filter-row th:last').html('');
                //$($('.form-control.mini')[0]).remove();
                //$($('.filter-row th')[0]).html('');
                //$($('.filter-row th')[columnLength - 1]).html('');

            }
        });
    }

    var SelectedRow = null;
    jQuery(function ($) {
        generateWareHouseName();
        /*
        var oTable = $('#dtFilter').DataTable({
            'destroy': true,
            'empty': true,
            //data: json,
            'searching': true,
