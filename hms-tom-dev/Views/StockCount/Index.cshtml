                //content += '<li style="padding-bottom:10px;"><a href="' + encodeURI(downloadUrl) + '" onclick="">' + extractUrl[1] + ' Download <i class="fa fa-download"></i></a></li>';
                content += '<li style="padding-bottom:10px;"><a href="' + encodeURI(downloadUrl) + '" onclick="$(this).parent().remove()"> Download berita acara <i class="fa fa-download"></i></a></li>';
                content += "</ul>";
                
                $('#contentDownloadModal').html(content);
                $('#downloadModal').modal('show');
