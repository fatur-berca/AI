@using System.Web.Mvc.Html
@using Newtonsoft.Json
@using EnumHelper = DFIS.Utils.EnumHelper
@model hms_tom_dev.Models.WarehouseStockCountViewModel
@{
    ViewBag.Title = "Warehouse > Stock Count > List ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ParamIDLocation = String.IsNullOrEmpty(Request.Params["IDLocation"]) ? "" : Request.Params["IDLocation"];
    int ParamMonth = String.IsNullOrEmpty(Request.Params["Month"]) ? 0 : int.Parse(Request.Params["Month"]);
    int ParamYear = String.IsNullOrEmpty(Request.Params["Year"]) ? 0 : int.Parse(Request.Params["Year"]);
    var FilterStartDate = ParamMonth > 0 && ParamYear > 0 ? new DateTime(ParamYear, ParamMonth, 1) : DateTime.Now.AddDays(-7);
    var FilterEndDate = ParamMonth > 0 && ParamYear > 0 ? FilterStartDate.AddMonths(1).AddDays(-1) : DateTime.Now;
    /*
    if (ParamMonth == 0 || ParamMonth == 0)
    {
        ParamStartDate = DateTime.Now;
        ParamEndDate = ParamStartDate.AddMonths(1).AddDays(-1);
    }
    */

    //var jsonSerializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    //string jsonShiftList = JsonConvert.SerializeObject(Model.GetListStockCountShift);//jsonSerializer.Serialize(Model.GetListStockCountShift);
    string jsonShift = "";
}

<style>
    table th
    {
        text-align: center;
    }

    .space_attachment
    {
        padding-right:5px;
    }

    .dataTables_wrapper .table-overflow .table thead tr th:first-child
    {
        min-width:90px;
    }
</style>

<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.AddNew)))
        {
            <button class="btn btn-primary" onclick="$('#modalStockType').modal('show')">Add New</button>
        }
        <button class="btn btn-primary" onclick="window.location.href = '@Url.Action("Index", "MstFGStacking")'">Master Finished Good Stacking</button>
        <button class="btn btn-primary" id="btnDefaultReport" onclick="exportToExcel(false)">Export</button>
        <button class="btn btn-primary" type="button" id="btnCustomReport" data-toggle="modal" data-target="#customReportModal">Custom Report</button>
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter"><b>Advanced Search</b><i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck nmb">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel wmb wbt">
            <form id="frmFilter">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Date Range</label>
                        <div class="row">
                            <div class="col-md-5">
                                <input type="text" class="form-control datepicker" id="startDate" value="@FilterStartDate.ToString("dd-MM-yyyy")">
                            </div>
                            <div class="col-md-2 to-bi">
                                <label>To</label>
                            </div>
                            <div class="col-md-5">
                                <input type="text" class="form-control datepicker" id="endDate" value="@FilterEndDate.ToString("dd-MM-yyyy")">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Shift</label>
                        <select id="shift" class="select2">
                            <option value="">All</option>
                            @foreach (var obj in Model.GetListStockCountShift)
                            {
                            <option value="@obj.Key">@obj.Value</option>
                            }
                            @*@for (int i = 1; i <= 3; i++)
                                {
                                    <option value="@i">@i</option>
                                }*@
                            <!--<option value="0">Surprise Visit</option>-->
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Type</label>
                        <select id="type" class="select2">
                            <option value="">All</option>
                            <option value="0">Distribution Center</option>
                            <option value="1">Warehouse</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Inventory Accuracy</label>
                        <select id="invAcc" class="select2">
                            <option value="">None</option>
                            <option value="100">100%</option>
                            <option value="<100">Below 100%</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Warehouse Utilization</label>
                        <select id="invUtil" class="select2">
                            <option value="">None</option>
                            <option value="10-50">10-50%</option>
                            <option value="51-70">51-70%</option>
                            <option value="71-90">71-90%</option>
                            <option value="91-100">91-100%</option>
                            <option value="100">100%</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Warehouse Name</label>
                        <select id="warehouse" class="select2" multiple></select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>Warehouse Staff</label>
                        <select id="staff" class="select2"></select>
                    </div>
                </div>

                <div class="col-md-12">
                    <button id="btnSearch" type="button" class="btn btn-primary">Search</button>
                    <button id="btnReset" type="reset" class="btn btn-purple">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

