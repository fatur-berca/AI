                            sapdata[tabId].push( {input: newRow[3].find('.sapqtypack'), value: r.SAP1042Pack} );
                            newRow[3].find('.unrestr').val(r.Unrestr1042);
                            newRow[3].find('.qualityinsp').val(r.QualityInsp1042);
                            $('#table_weekly_1042 tbody').append(newRow[3]);

                            //1043
