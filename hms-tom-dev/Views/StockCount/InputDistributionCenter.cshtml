            <div class="col-md-6">
                <table class="table tableinfo">
                    <tr>
                        <td>Total Qty SAP</td>
                        <td style="text-align:right; width:100px;" id="totalqtysapbox">@TotalSAPBox</td>
                        <td>Boxes</td>
