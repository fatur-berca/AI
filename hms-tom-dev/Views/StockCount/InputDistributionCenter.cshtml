    function GetDataNamaBeritaAcara(IDLocation) {
        var dialog = showDialog();

        $.ajax({
            url: '@Url.Action("../StockCount/GetDataNamaBeritaAcara")',
            complete: function () { dialog.modal('hide'); },
            dataType: 'JSON',
            method: 'GET',
            cache: false,
            data: {"IDLocation" : IDLocation},
            success: function (res) {
                $('.namaOwnerVal').select2("destroy");
                $('.namaStockVal').select2("destroy");

                var optionsNama = '<option value="">-- select name --</option>';

                $.each(res, function (key, val) {
                    optionsNama += '<option value="' + val.FullName + '">' + val.IdUser + " - " + val.FullName + '</option>';
                });
                $('.namaOwnerVal').html(optionsNama).select2();
                $('.namaStockVal').html(optionsNama).select2();
                //debugger;
                GetDataJabatanBeritaAcara();
