                    content += '<li style="padding-bottom:10px;"><a href="' + encodeURI(downloadUrl) + '" onclick="$(this).parent().remove()"> Download official report <i class="fa fa-download"></i></a></li>';
                    content += "</ul>";

                    $('#contentDownloadModal').html(content);
