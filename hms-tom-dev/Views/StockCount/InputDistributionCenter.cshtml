                    console.log(res);
                    //debugger;
                    if (res.FileName == undefined) {
                        //$('#textModalWarning').html('Failed to create reconcile. Please try again.');
                        //$('#warningModal').modal('show');
                    }
                    //var filenames = res.FileName.split('###');

                    var filenames = res.FileName;

                    //var content = "<h3>Download Berita Acara</h3>";
                    var content = "<h2>Official Report</h2>";
                    content += "<ul style='margin-left:-20px;'>";
                    var downloadUrl = '@Url.Action("DownloadFile")' + "?FileName=" + res.FileName + "&UId=" + res.Uid;
                    var extractUrl = downloadUrl.split('-');
                    //content += '<li style="padding-bottom:10px;"><a href="' + encodeURI(downloadUrl) + '" onclick="$(this).parent().remove()">' + extractUrl[1] + ' Download <i class="fa fa-download"></i></a></li>';
