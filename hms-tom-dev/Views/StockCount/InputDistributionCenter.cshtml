    function CollectFile(id)
    {
        var fileData = FormData();
        //var tmpData = FormData();
        var TotalFilePrevData = $('#listUpload tr.prevData').length;
        fileData.append('id', id);
        var idx = 0;
        $('#listUpload tr.prevData').each(function() {
            fileData.append('attachment' + idx, $(this).attr('filename'));
            idx++;
        });

        fileData.append('lastindex', TotalFilePrevData);

        for (var idxfile = 1; idxfile < FileAttach.length; idxfile++) {
            if (FileAttach[idxfile] === undefined) continue;
            fileData.append(id + '|' + idxfile, FileAttach[idxfile].file); //param 1 : idstockcount | counter, data di back end di split
        }

        return fileData;
    }

