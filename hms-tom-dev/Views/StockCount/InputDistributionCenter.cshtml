<div class="col-md-12">
    <div class="title-deck wmb">
        <div class="button-wrap pull-left">
            <button class="btn btn-purple" onclick="window.location.href = '@Url.Action("Index", "StockCount")'">Back</button>
            @if (Model.IDStockCount != 0)
            {
                <!--<button type="button" class="btn btn-primary btnImportSAP" id="btnImportSAP"> Import SAP</button>
                <button type="button" class="btn btn-primary" id="btnSync">Sync</button>-->
            }
            <button type="button" class="btn btn-primary" id="btnManualForm">Print Manual Form</button>
            @if (Model.IDStockCount != 0)
            {
                <button type="button" class="btn btn-primary" id="btnReconcile" onclick="$('#customReport').modal('show')">Print Reconcile</button>
            }
            @if (Model.IDStockCount != 0)
            {
                <button type="button" class="btn btn-primary" id="btnPrintBeritaModal" onclick="$('#PrintBeritaModal').modal('show')">Print Official Report</button>
            }
            
            <!--<button type="button" class="btn btn-primary" id="btnExport" onclick="$('#customReport').modal('show')">Export</button>-->
            @if (Model.IDStockCount != 0)
            {
                if (isCanEdit)
                {
                    <button type="button" class="btn btn-primary btnEdit isHeader" id="">Edit Header</button>                    
                }
                else
                {
                    <button type="button" class="btn btn-primary" id="btnEditAttachment" onclick="$('#btnViewOrUploadAttachment').removeAttr('disabled')">Edit Attachment</button>
                    <button type="button" class="btn btn-primary" id="btnSaveAttachment">Save Attachment</button>
                }
            }

            @if (Model.IDStockCount == 0 || isCanEdit)
            {
                <button type="button" class="btn btn-primary btnSaveNew isHeader" id="">Save</button>
            }
        </div>
    </div>
</div>

