    function GetDataJabatanBeritaAcara() {
        var dialog = showDialog();
        var IDStockCount = $('#transID').val();
        $.ajax({
            url: '@Url.Action("GetDataJabatanBeritaAcara","StockCount")',
            complete: function () { dialog.modal('hide'); },
            dataType: 'JSON',
            method: 'GET',
            cache: false,
            success: function (res) {
                $('.jabatanOwnerVal').select2("destroy");
                $('.jabatanStockVal').select2("destroy");

                var optionsJabatan = '<option value="-">-- select title --</option>';

                $.each(res, function (key, val) {
                    optionsJabatan += '<option value="' + val.FieldValue + '">' + val.FieldValue + '</option>';
                });

                $('.jabatanOwnerVal').html(optionsJabatan).select2();
                $('.jabatanStockVal').html(optionsJabatan).select2();
                //debugger;
                CheckDataOR(IDStockCount);
            }
        });
