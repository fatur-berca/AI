                    "NamaOwner": NamaOwner,
                    "JabatanOwner": JabatanOwner,
                    "NamaStock": NamaStock,
                    "JabatanStock": JabatanStock,
                    "LenOwner": LenOwner,
                    "LenStock": LenStock
                },
