                            sapdata[tabId].push( {input: newRow[5].find('.sapqtypack'), value: r.SAP1046Pack} );
                            newRow[5].find('.unrestr').val(r.Unrestr1046);
                            newRow[5].find('.qualityinsp').val(r.QualityInsp1046);
                            $('#table_weekly_1046 tbody').append(newRow[5]);
