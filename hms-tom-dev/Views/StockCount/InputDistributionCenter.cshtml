    function showDialog(message)
    {
        if (message == '' || message === undefined) message = 'Please Wait...'
        return bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> ' + message + '</div>',
            closeButton: false
        });
    }

    function fillOptionWarehouse(options) {
        var select = $('.warehouse');
        select.select2('destroy');
        $.each(select, function (e) {
            $(this).append(options);
        });

        $('.warehouse').select2({
            dropdownAutoWidth: true,
            width: '100%'
        })
    }

    function generateWareHouseName() {
        var id = $('#transID').val();
        var dialog = showDialog();
        $.ajax({
            url: '@Url.Action("../StockCount/GetLocationData")',
            complete : function() { dialog.modal('hide'); },
            type: 'POST',
            dataType: 'JSON',
            data: { Type: false },
            cache: false,
            success: function (data) {
                var options = '<option></option>';
                options = id != 0 ? options : '';

                $.each(data,
                    function (key, val) {
                        options += '<option value="' + val.IDLocation + '">' + val.LocationName + '</option>';
                    });
                fillOptionWarehouse(options);

                if ($('#transID').val() == 0) {
                    loadDataStaff();
                }
            },
            error: function () {
                fillOptionWarehouse('<option>none available</option>');
            }
        });
    }

    function getCurrentShift() {
        var id = $('#transID').val();

        if (id == 0) {
            $.ajax({
                url: '@Url.Action("../StockCount/GetCurrentShift")',
                dataType: 'JSON',
                cache: false,
                success: function (res) {
                    $('#shift').val(res);
                },
                error: function () {
                    fillOptionWarehouse('<option>none available</option>');
                }
            });
        }
    }

    function getCurrentActiveTable() {
        return $('.tab-pane').filter('.active').find('#dataTable #tableBody');
    }

    function uploadFile(fileData) {
        $.ajax({
            url: '@Url.Action("../StockCount/UploadFile")',
            type: 'POST',
            dataType: 'JSON',
            data: fileData,
            cache: false,
            contentType: false,
            processData: false,
            success: function (res) {
                var message = res.status != 'Success' ? (res.status + '<br>' + res.message) : 'Data has been successfully saved to the database';
                //$('#textModalWarning').html(message);
                //$('#warningModal').modal('show');

                if ($('#btnSaveAttachment').length == 1) {
                    message = 'Data has been successfully saved to the database';
                }

                $('#textModalWarning').html(message);
                $('#warningModal').modal('show');

                if ($('#btnSaveAttachment').length == 1) {
                    setTimeout(function () { location.reload() }, 1500);
                }
            },
            error: function () {
            }
        });
    }

    function calculateTotal() {
        var tbody = getCurrentActiveTable();
        var SLoc = tbody.attr('SLoc');
        var objtotal = totalqty[$('.tab-pane').filter('.active').attr('id')];
        objtotal.man_pack = 0;

        tbody.find('tr .inputqty').each(function () {
            objtotal.man_pack += parseFloat($(this).val()) || 0;
        });

        $('#totalqtysappack').html(objtotal.sap_pack);
        $('#totalqtymanpack').html(objtotal.man_pack);
    }

    function loadDataStaff()
    {
        //$("#warehouseStaff1").empty();
        var obj = $('#warehouse');
        var selectStaff1 = $('#warehouseStaff1');
        var selectStaff2 = $('#warehouseStaff2');
        var nextShift = $('#nextShift');

        selectStaff1.empty();
        selectStaff2.empty();
        nextShift.empty();

        $('#warehouseStaff1').select2('val', '');
        $('#warehouseStaff2').select2('val', '');
        $('#nextShift').select2('val', '');

        selectStaff1.append($('<option>', { value: '-', text: '' }));
        selectStaff2.append($('<option>', { value: '-', text: '' }));
        nextShift.append($('<option>', { value: '-', text: '' }));

        var dialog = showDialog();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("../StockCount/GetUserByLocations")',
            cache: false,
            complete : function() { dialog.modal('hide'); },
            dataType: 'JSON',
            data: { IDLocations: [obj.val()] },
            //complete: function() { dialog.modal('hide') },
            success: function (res) {
                for (idx in res) {
                    //r.MasterUser.FullName;
                    var r = res[idx];
                    selectStaff1.append($('<option>', { value: r.IDUser, text: r.MasterUser.FullName }));
                    selectStaff2.append($('<option>', { value: r.IDUser, text: r.MasterUser.FullName }));
                    nextShift.append($('<option>', { value: r.IDUser, text: r.MasterUser.FullName }));
                }
                $('#warehouseStaff1').val('');
                $('#warehouseStaff2').val('');
                $('#nextShift').val('');
            }
        });
    }

    function replaceAll(str, find, replace) {
        return str.replace(new RegExp(find, 'g'), replace);
    }

    function CompareData() {
        var tabId = $('.tab-pane').filter('.active').attr('id');
        var tbody = getCurrentActiveTable();
        var SLoc = $('.navtype.active').attr('SLoc');//tbody.attr('SLoc');

        sapdata[tabId].forEach(function (e) {
            if (e !== undefined) {
                var tr = $(e.input).closest('tr');
                e.input.val(numberWithCommas(e.value));
                //trigger event keyup
                //tr.find('.inputqty')[0].trigger('keyup');
                tr.find('.manqtybox').trigger('keyup');
            }
        });

        $('.navtype').css('background-color', '');

        var classNameSAPBox = '.sapqtybox';
        var classNameSAPPack= '.sapqtypack';
        var classNameManBox = '.manqtybox';
        var classNameManPack = '.manqtypack';
        var classNameInterfaceBox = '.interfaceqtybox';
        var classNameInterfacePack = '.interfaceqtypack';
        var classNameReceivingBox = '.receivingqtybox';
        var classNameReceivingPack = '.receivingqtypack';
        var isNotBalance = false;

        CalculateTotalQty();
        if (SLoc != 'weekly')
        {
            //tbody = getCurrentActiveTable();
            var CounterDailyHasRow = 0;
            $('.body_daily').each(function () {
                //console.log($(this).attr('sapdata'));
                if ($(this).find('tr').length > 0) {
                    CounterDailyHasRow++;
                    /*
                    if (sapdata[$(this).attr('tabid')].length > 0 && tabname == '') {
                        tabname = $(this).attr('tabname');
                    }
                    */
                }
            });

            if (CounterDailyHasRow == 2) {
                tbody = $('.body_daily');
            }

            var slocs = [];
            tbody.find('tr').each(function(e){
                var inputsapbox = $(this).find(classNameSAPBox);
                var inputmanbox = $(this).find(classNameManBox);
                var inputsappack = $(this).find(classNameSAPPack);
                var inputmanpack = $(this).find(classNameManPack);
                var inputinterfacebox = $(this).find(classNameInterfaceBox);
                var inputinterfacepack = $(this).find(classNameInterfacePack);
                var inputreceivingbox = $(this).find(classNameReceivingBox);
                var inputreceivingpack = $(this).find(classNameReceivingPack);

                $(inputsapbox).parent().css('background-color', '');
                $(inputmanbox).parent().css('background-color', '');
                $(inputsappack).parent().css('background-color', '');
                $(inputmanpack).parent().css('background-color', '');
                $(inputinterfacebox).parent().css('background-color', '');
                $(inputinterfacepack).parent().css('background-color', '');
                $(inputreceivingbox).parent().css('background-color', '');
                $(inputreceivingpack).parent().css('background-color', '');

                var totalqtybox = (parseFloat(inputmanbox.val()) || 0) + (parseFloat(inputinterfacebox.val()) || 0) - (parseFloat(inputreceivingbox.val()) || 0);
                //console.log(totalqtybox + ' ' + replaceAll(inputsapbox.val(), ",", ""));
                if (replaceAll(inputsapbox.val(), ",", "") != totalqtybox)
                {
                    $(inputsapbox).parent().css('background-color', 'red');
                    $(inputmanbox).parent().css('background-color', 'red');
                    $(inputinterfacebox).parent().css('background-color', 'red');
                    $(inputreceivingbox).parent().css('background-color', 'red');
                    isNotBalance = true;
                    slocs['sloc_' + $(this).parent().attr('sloc')] = $(this).parent().attr('sloc');
                }
                var totalqtypack = (parseFloat(inputmanpack.val()) || 0) + (parseFloat(inputinterfacepack.val()) || 0) - (parseFloat(inputreceivingpack.val()) || 0);
                //console.log(totalqtypack + ' ' + replaceAll(inputsappack.val(), ",", ""));
                if (replaceAll(inputsappack.val(), ",", "") != totalqtypack)
                {
                    $(inputsappack).parent().css('background-color', 'red');
                    $(inputmanpack).parent().css('background-color', 'red');
                    $(inputinterfacepack).parent().css('background-color', 'red');
                    $(inputreceivingpack).parent().css('background-color', 'red');
                    isNotBalance = true;
                    slocs['sloc_' + $(this).parent().attr('sloc')] = $(this).parent().attr('sloc');
                }

                if (isNotBalance)
                {
                    //slocs['sloc_' + $(this).parent().attr('sloc')] = $(this).parent().attr('sloc');
                    //slocs.push($(this).parent().attr('sloc'));
                }
            });
            //console.log(slocs);
            if (isNotBalance)
            {
                if (CounterDailyHasRow == 2)
                {
                    for (var skey in slocs)
                    {
                        $(".navtype[sloc='" + slocs[skey] + "']").css('background-color', '#ed5a61');
                    }
                }
                else
                {

                    $('.navtype.active').css('background-color', '#ed5a61');
                }
            }
        }
        else
        {
            $('#weekly_error').hide();
            $('.table_weekly tbody').each(function(e){
                isNotBalance = false;
                var CurrentSLoc = $(this).attr('sloc');
                var error_div = $('#error_weekly_' + CurrentSLoc);
                error_div.html('&nbsp');
                $(this).find('tr').each(function(e){
                    //$(this).css('background-color', '');

                    var inputsapbox = $(this).find(classNameSAPBox);
                    var inputmanbox = $(this).find(classNameManBox);
                    var inputsappack = $(this).find(classNameSAPPack);
                    var inputmanpack = $(this).find(classNameManPack);
                    var inputinterfacebox = $(this).find(classNameInterfaceBox);
                    var inputinterfacepack = $(this).find(classNameInterfacePack);
                    var inputreceivingbox = $(this).find(classNameReceivingBox);
                    var inputreceivingpack = $(this).find(classNameReceivingPack);

                    $(inputsapbox).parent().css('background-color', '');
                    $(inputmanbox).parent().css('background-color', '');
                    $(inputsappack).parent().css('background-color', '');
                    $(inputmanpack).parent().css('background-color', '');
                    $(inputinterfacebox).parent().css('background-color', '');
                    $(inputinterfacepack).parent().css('background-color', '');
                    $(inputreceivingbox).parent().css('background-color', '');
                    $(inputreceivingpack).parent().css('background-color', '');

                    var totalqtybox = (parseFloat(inputmanbox.val()) || 0) + (parseFloat(inputinterfacebox.val()) || 0) - (parseFloat(inputreceivingbox.val()) || 0);
                    if (replaceAll(inputsapbox.val(), ",", "") != totalqtybox)
                    {
                        //$(this).css('background-color', 'red');
                        $(inputsapbox).parent().css('background-color', 'red');
                        $(inputmanbox).parent().css('background-color', 'red');
                        $(inputinterfacebox).parent().css('background-color', 'red');
                        $(inputreceivingbox).parent().css('background-color', 'red');
                        isNotBalance = true;
                    }

                    var totalqtypack = (parseFloat(inputmanpack.val()) || 0) + (parseFloat(inputinterfacepack.val()) || 0) - (parseFloat(inputreceivingpack.val()) || 0);
                    if (replaceAll(inputsappack.val(), ",", "") != totalqtypack)
                    {
                        $(inputsappack).parent().css('background-color', 'red');
                        $(inputmanpack).parent().css('background-color', 'red');
                        $(inputinterfacepack).parent().css('background-color', 'red');
                        $(inputreceivingpack).parent().css('background-color', 'red');
                        isNotBalance = true;
                    }
                });

                if (isNotBalance) {
                    $('#weekly_error').show();
                    error_div.html('Not Balance');
                    $('.navtype.active').css('background-color', 'red');
                }
            });
        }

        IsUserEditQty = false;
    }

    function GetDetail(row)
    {
        var detailData = {
            'FACode': row.find('.facode').val(),
            'Brand': row.find('.brand').val(),
            'BrandDescription': row.find('.brand').val(),
            'Batch': row.find('.batch').val(),
            'SLoc': $(this).parent('tbody').attr('SLoc'),
            'IDLocation': $('#warehouse').val(),
            'Unrestr': row.find('.unrestr').val().replace(".", ","),
            'QualityInsp': row.find('.qualityinsp').val().replace(".", ","),
            'SAPQtyBox': replaceAll(row.find('.sapqtybox').val(), ",", "").replace(".", ","),
            'SAPQtyPack': replaceAll(row.find('.sapqtypack').val(), ",", "").replace(".", ","),
            'ManQtyBox': row.find('.manqtybox').val().replace(".", ","),
            'ManQtyPack': row.find('.manqtypack').val().replace(".", ","),
            'InterfaceQtyBox': row.find('.interfaceqtybox').val().replace(".", ","),
            'InterfaceQtyPack': row.find('.interfaceqtypack').val().replace(".", ","),
            'ReceivingQtyBox': row.find('.receivingqtybox').val().replace(".", ","),
            'ReceivingQtyPack': row.find('.receivingqtypack').val().replace(".", ","),
            'Remarks': row.find('.remarks').val(),
            };

        return detailData;
    }

