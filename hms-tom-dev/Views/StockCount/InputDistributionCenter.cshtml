    var IsUserEditQty = false;
    var InputClasses = ['manqtybox', 'interfaceqtybox', 'receivingqtybox', 'manqtypack', 'interfaceqtypack', 'receivingqtypack'];
    var FileAttach = [];
    //var DeletedAttach = [];
    var NamaOwner = [];
    var JabatanOwner = [];
    var NamaStock = [];
    var JabatanStock = [];
    var LenOwner = 0;
