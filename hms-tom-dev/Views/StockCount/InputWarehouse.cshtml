    function GetNamaJabatanFromForm() {
        LenOwner = 0;
        LenStock = 0;
        var b = false;
        var c = false;
        $(".select2.namaOwnerVal.select2-offscreen").each(function () {
            if($(this).val() != ""){
                NamaOwner.push($(this).val());
                LenOwner++;
                b = true;
            }
        });
        $(".select2.jabatanOwnerVal.select2-offscreen").each(function () {
            if(b){
                JabatanOwner.push($(this).val());
            }
        });
        $(".select2.namaStockVal.select2-offscreen").each(function () {
            if($(this).val() != ""){
                NamaStock.push($(this).val());
                LenStock++;
                c = true;
            }
        });
        $(".select2.jabatanStockVal.select2-offscreen").each(function () {
            if(c){
                JabatanStock.push($(this).val());
            }
        });
    }
</script>
