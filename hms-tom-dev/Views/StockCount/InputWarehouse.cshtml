                                        newRow.find('.warehouseqty5').val(rowqty.qty5);
                                        newRow.find('.totalqtypack').val(rowqty.total);
                                    }
                                }
                            }

                            if (SLoc == '1000') {
                                //newRow.find('.sapqtypack').val(r.SAP1000Pack);
                                sapdata[tabId].push( {input: newRow.find('.sapqtypack'), value: r.SAP1000Pack} );
