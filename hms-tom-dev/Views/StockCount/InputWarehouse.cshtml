                                    //console.log(rowqty);
                                    if (rowqty !== undefined)
                                    {
                                        newRow.find('.warehouseqty1').val(rowqty.qty1);
                                        newRow.find('.warehouseqty2').val(rowqty.qty2);
                                        newRow.find('.warehouseqty3').val(rowqty.qty3);
                                        newRow.find('.warehouseqty4').val(rowqty.qty4);
                                        newRow.find('.warehouseqty5').val(rowqty.qty5);
                                        newRow.find('.totalqtypack').val(rowqty.total);
                                    }
                                }
                                $('#table_weekly_' + key + ' tbody').append(newRow);

                                //sapdata[tabId].push( {input: newRow.find('.sapqtybox'), value: r.SAPQtyBox} );
                                sapdata[tabId].push( {input: newRow.find('.sapqtypack'), value: r.SAPQtyPack} );
                            }
                        }
                    }
                    else
                    {
                        for (idx in res) {
                            var r = res[idx];
                            var newRow = [];

                            if (SLoc != 'weekly')
                            {
                                newRow = $($('#templateRowSAP').html());
                                newRow.find('.facode').val(r.Material);
                                newRow.find('.speakingcode').val(r.SpeakingCode);
                                newRow.find('.brand').val(r.Description);
                                newRow.find('.batch').val(r.Batch);
                                newRow.find('.unrestr').val(r.Unrestr);
                                newRow.find('.qualityinsp').val(r.QualityInsp);
                                newRow.find('.inputqty').val(0);
                                newRow.find('.totalqtypack').val(0);

                                if (transId != 0)
                                {
                                    var rowqty = dtSAPQty[r.Material + r.Description];
                                    //console.log(qtyrow);
                                    if (rowqty !== undefined) {
                                        newRow.find('.warehouseqty1').val(rowqty.qty1);
