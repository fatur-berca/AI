                {
                    <button type = "button" class="btn btn-primary" id="btnEditAttachment" onclick="$('#btnViewOrUploadAttachment').removeAttr('disabled')">Edit Attachment</button>
                    <button type = "button" class="btn btn-primary" id="btnSaveAttachment">Save Attachment</button>
