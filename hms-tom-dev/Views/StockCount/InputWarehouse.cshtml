    function CheckDataOR(IDStockCount) {
        var dialog = showDialog();

        $.ajax({
            url: '@Url.Action("CheckDataOR","StockCount")',
            complete: function () { dialog.modal('hide'); },
            cache: false,
            method: 'GET',
            dataType: 'JSON',
            data: {
                "IDStockCount" : IDStockCount
            },
            success: function (res) {
                console.log(res);
                if (res != null) {
                    var no = 1;
                    var jo = 1;
                    var ns = 1;
                    var js = 1;
                    for (var i = 0; i < res.length;i++){
                        if (res[i].Type == 0) {
                            $('#namaOwner' + (no) + '').select2('val', res[i].Name);
                            $('#jabatanOwner' + (jo) + '').select2('val', res[i].Title);
                            no++;
                            jo++;
                        }
                        else if (res[i].Type == 1) {
                            $('#namaStock' + (ns) + '').select2('val', res[i].Name);
                            $('#jabatanStock' + (js) + '').select2('val', res[i].Title);
                            ns++;
                            js++;
                        }
                    }
                }
                //debugger;
            }
        });
    }

