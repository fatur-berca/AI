    sapdata['dailybs'] = [];
    sapdata['weekly'] = [];

    totalqty['dailyfg'] = { sap_box: 'N/A', sap_pack: 'N/A', man_box: 'N/A', man_pack: 'N/A' };
    totalqty['dailybs'] = { sap_box: 'N/A', sap_pack: 'N/A', man_box: 'N/A', man_pack: 'N/A' };
    totalqty['weekly'] = { sap_box: 'N/A', sap_pack: 'N/A', man_box: 'N/A', man_pack: 'N/A' };
    totalinv = {inv_acc: 'N/A', inv_util: 'N/A'};

    function showDialog(message)
    {
        if (message == '' || message === undefined) message = 'Please Wait...'
        return bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> ' + message + '</div>',
            closeButton: false
        });
    }

    function fillOptionWarehouse(options)
    {
        var select = $('.warehouse');
        select.select2('destroy');
        $.each(select, function (e) {
             $(this).append(options);
        });

        $('.warehouse').select2({
            dropdownAutoWidth: true,
            width: '100%'
        })
    }

    function CompareData()
    {
        var tabId = $('.tab-pane').filter('.active').attr('id');
        var tbody = getCurrentActiveTable();
        var SLoc = $('.navtype.active').attr('SLoc');//tbody.attr('SLoc');

        sapdata[tabId].forEach(function (e) {
            if (e !== undefined) {
                var tr = $(e).parent();
                e.input.val(numberWithCommas(e.value));
                tr.find('.warehouseqty1').trigger('keyup');
            }
        });

        $('.navtype').css('background-color', '');

        var classNameSAPPack= '.sapqtypack';
        var classNameManPack= '.manqtypack';
        var isNotBalance = false;

        CalculateTotalQty();
        if (SLoc != 'weekly')
        {
            var CounterDailyHasRow = 0;

            $('.body_daily').each(function () {
                //console.log($(this).attr('sapdata'));
                if ($(this).find('tr').length > 0) {
                    CounterDailyHasRow++;
                }
            });

            if (CounterDailyHasRow == 2) {
                tbody = $('.body_daily');
            }

            var slocs = [];
            //tbody = getCurrentActiveTable();
            tbody.find('tr').each(function(e){
                $(this).css('background-color', '');

                var inputtotalqtypack = $(this).find('.totalqtypack');
                var inputsapqtypack = $(this).find(classNameSAPPack);

                $(inputtotalqtypack).parent().css('background-color', '');
                $(inputsapqtypack).parent().css('background-color', '');
                if (replaceAll(inputtotalqtypack.val(), ",", "") != replaceAll(inputsapqtypack.val(), ",", ""))
                {
                    $(inputtotalqtypack).parent().css('background-color', 'red');
                    $(inputsapqtypack).parent().css('background-color', 'red');
                    isNotBalance = true;
                    slocs['sloc_' + $(this).parent().attr('sloc')] = $(this).parent().attr('sloc');
                }

                if (isNotBalance) {
                }
            });

            if (isNotBalance) {
                if (CounterDailyHasRow == 2) {
                    for (var skey in slocs) {
                        $(".navtype[sloc='" + slocs[skey] + "']").css('background-color', '#ed5a61');
                    }
                }
                else {

                    $('.navtype.active').css('background-color', '#ed5a61');
                }
            }
            //if (isNotBalance) $('.navtype.active').css('background-color', '#ed5a61');
        }
        else
        {
            $('#weekly_error').hide();
            $('.table_weekly tbody').each(function(e){
                isNotBalance = false;
                var CurrentSLoc = $(this).attr('sloc');
                var error_div = $('#error_weekly_' + CurrentSLoc);
                //console.log(error_div);
                error_div.html('&nbsp');
                $(this).find('tr').each(function(e){
                    $(this).css('background-color', '');

                    var inputtotalqtypack = $(this).find('.totalqtypack');
                    var inputsapqtypack = $(this).find(classNameSAPPack);

                    $(inputtotalqtypack).parent().css('background-color', '');
                    $(inputsapqtypack).parent().css('background-color', '');
                    if (replaceAll(inputtotalqtypack.val(), ",", "") != replaceAll(inputsapqtypack.val(), ",", "")) {
                        $(inputtotalqtypack).parent().css('background-color', 'red');
                        $(inputsapqtypack).parent().css('background-color', 'red');
                        isNotBalance = true;
                    }
                });

                if (isNotBalance)
                {
                    $('#weekly_error').show();
                    error_div.html('Not Balance');
                    $('.navtype.active').css('background-color', 'red');
                }
            });
        }

        IsUserEditQty = false;
    }

    function generateWareHouseName() {
        var id = $('#transID').val();
        var dialog = showDialog();
        $.ajax({
            url: '@Url.Action("../StockCount/GetLocationData")',
            complete : function() { dialog.modal('hide'); },
            type: 'POST',
            dataType: 'JSON',
            data: { Type: true },
            cache: false,
            success: function (data) {
               var options = '<option></option>';
               options = id != 0 ? options : '';

                $.each(data,
                    function (key, val) {
                        options += '<option value="' + val.IDLocation + '">' + val.LocationName + '</option>';
                    });
                fillOptionWarehouse(options);

                if ($('#transID').val() == 0) {
                    loadDataStaff();
                }
            },
            error: function () {
                fillOptionWarehouse('<option>none available</option>');
            }
        });
    }

    function getCurrentShift() {
        var id = $('#transID').val();

        if (id == 0) {
            $.ajax({
                url: '@Url.Action("../StockCount/GetCurrentShift")',
                dataType: 'JSON',
                cache: false,
                success: function (res) {
                    $('#shift').val(res);
                },
                error: function () {
                    fillOptionWarehouse('<option>none available</option>');
                }
            });
        }
    }

    function getCurrentActiveTable()
    {
        return $('.tab-pane').filter('.active').find('#dataTable #tableBody');
    }

    function uploadFile(fileData)
    {
        $.ajax({
            url: '@Url.Action("../StockCount/UploadFile")',
            type: 'POST',
            dataType: 'JSON',
            data: fileData,
            cache: false,
            contentType: false,
            processData: false,
            success: function (res) {
                var message = res.status != 'Success' ? (res.status + '<br>' + res.message) : 'Data has been successfully saved to the database';
                $('#textModalWarning').html(message);
                $('#warningModal').modal('show');

                if ($('#btnSaveAttachment').length == 1)
                {
                    $('#textModalWarning').html('Data has been successfully saved to the database');
                    $('#warningModal').modal('show');
                    setTimeout(function () { location.reload() }, 1500);
                }
            },
            error: function () {

            }
        });
    }

    function calculateTotal()
    {
        var tbody = getCurrentActiveTable();
        var SLoc = tbody.attr('SLoc');
        var objtotal = totalqty[$('.tab-pane').filter('.active').attr('id')];
        objtotal.man_pack = 0;
        //objtotal.sap_pack = 0;

        if (SLoc != 'weekly')
        {
            tbody.find('tr').each(function() {
                objtotal.sap_pack += parseFloat($(this).find('.sapqtypack').val()) || 0;
                objtotal.man_pack += parseFloat($(this).find('.totalqtypack').val()) || 0;
            });
        }
        else
        {
            tbody.find('tr .inputqty').each(function () {
                objtotal.man_pack += parseFloat($(this).val()) || 0;
            });
        }

        $('#totalqtysappack').html(objtotal.sap_pack);
        $('#totalqtymanpack').html(objtotal.man_pack);
    }

    function loadDataStaff()
    {
        //$("#warehouseStaff1").empty();
        var obj = $('#warehouse');
        var selectStaff1 = $('#warehouseStaff1');
        var selectStaff2 = $('#warehouseStaff2');
        var nextShift = $('#nextShift');

        selectStaff1.empty();
        selectStaff2.empty();
        nextShift.empty();

        $('#warehouseStaff1').select2('val', '');
        $('#warehouseStaff2').select2('val', '');
        $('#nextShift').select2('val', '');

        selectStaff1.append($('<option>', { value: '-', text: '' }));
        selectStaff2.append($('<option>', { value: '-', text: '' }));
        nextShift.append($('<option>', { value: '-', text: '' }));

        var dialog = showDialog();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("../StockCount/GetUserByLocations")',
            cache: false,
            complete : function() { dialog.modal('hide'); },
            dataType: 'JSON',
            data: { IDLocations: [obj.val()] },
            success: function (res) {
                for (idx in res) {
                    //r.MasterUser.FullName;
                    var r = res[idx];
                    selectStaff1.append($('<option>', { value: r.IDUser, text: r.MasterUser.FullName }));
                    selectStaff2.append($('<option>', { value: r.IDUser, text: r.MasterUser.FullName }));
                    nextShift.append($('<option>', { value: r.IDUser, text: r.MasterUser.FullName }));
                }
                $('#warehouseStaff1').val('');
                $('#warehouseStaff2').val('');
                $('#nextShift').val('');
            }
        });
    }

    function replaceAll(str, find, replace) {
        return str.replace(new RegExp(find, 'g'), replace);
    }

    function GetDetail(row) {
        var detailData = {
            'FACode': row.find('.facode').val(),
            'SLoc': $(this).parent('tbody').attr('SLoc'),
            'Batch': row.find('.batch').val(),
            'BrandDescription': row.find('.brand').val(),
            'IDLocation': $('#warehouse').val(),
            'Unrestr': row.find('.unrestr').val().replace(".", ","),
            'QualityInsp': row.find('.qualityinsp').val().replace(".", ","),
            'SAPQtyPack': replaceAll(row.find('.sapqtypack').val(), ",", ""),
            'ManQtyPack': replaceAll(row.find('.totalqtypack').val(), ",", ""),
            'WarehouseQty1': row.find('.warehouseqty1').val().replace(".", ","),
            'WarehouseQty2': row.find('.warehouseqty2').val().replace(".", ","),
            'WarehouseQty3': row.find('.warehouseqty3').val().replace(".", ","),
            'WarehouseQty4': row.find('.warehouseqty4').val().replace(".", ","),
            'WarehouseQty5': row.find('.warehouseqty5').val().replace(".", ","),
            'Remarks': row.find('.remarks').val(),
        };

        return detailData;
    }

    function SaveData(objBtnSave, isCompareData)
    {
        isFromCompareData = false;
        var tbody = getCurrentActiveTable();
        var SLoc = $('.navtype.active').attr('SLoc'); //tbody.attr('SLoc');
        var tabId = $('.tab-pane').filter('.active').attr('id');
        var transID = $('#transID').val();

        var postData =  {
            'new':
                [{
                    TransDate: moment($('#transDate').val(), 'DD-MM-YYYY').format('YYYY-MM-DD'), IDLocation: $('#warehouse').val(), Shift: $('#shift').val(),
                    WarehouseStaff1: $('#warehouseStaff1').val() == '-' ? '' : $('#warehouseStaff1').val(), WarehouseStaff2: $('#warehouseStaff2').val() == '-' ? '' : $('#warehouseStaff2').val(),
                    NextShift: $('#nextShift').val() == '-' ? '' : $('#nextShift').val(), Status: $('#status').val(), SyncedTime: moment($('#SyncedTime').val(), 'DD-MM-YYYY HH:mm').format('YYYY-MM-DD HH:mm'),
                    Remarks: $('#remarks').val(), Remarks1040: $('#remarks1040').val(), Remarks1041: $('#remarks1041').val(), Remarks1042: $('#remarks1042').val(),
                    Remarks1043: $('#remarks1043').val(), Remarks1046: $('#remarks1046').val(),
                    SLoc: SLoc, Type: true, IDStockCount: $('#transID').val(),
                    IsCompareData: isCompareData,
                    WarehouseStockCountDetails: []
                }],
        };

        var isFACodeEmpty = false;

        if (SLoc != 'weekly') {
            tbody = tbody;
            var CounterDailyHasRow = 0;
            var tabname = '';

            //if (transID == 0)
            //{
            $('.body_daily').each(function () {
                //console.log($(this).attr('sapdata'));
                if ($(this).find('tr').length > 0) {
                    CounterDailyHasRow++;
                    if (sapdata[$(this).attr('tabid')].length > 0 && tabname == '') {
                        tabname = $(this).attr('tabname');
                    }
                }
            });

            if (CounterDailyHasRow == 2) {
                if (tabname != '') {
                    $('#textModalWarning').html('Please compare data to continue (' + tabname + ')');
                    $('#warningModal').modal('show');
                    return;
                }
                else {
                    tbody = $('.body_daily');
                }
            }
            //}

            tbody.find('tr').each(function () {
                var row = $(this);
                var facode = row.find('.facode').val();
                if ($.trim(facode) == '' && !isFACodeEmpty)
                {
                    isFACodeEmpty = true;;
                }

                var detailData = GetDetail(row);
                detailData.SLoc = $(this).parent('tbody').attr('SLoc');
                /*
                var detailData = {
                    'FACode': facode,
                    'SLoc': $(this).parent('tbody').attr('SLoc'),
                    'Batch': row.find('.batch').val(),
                    'BrandDescription': row.find('.brand').val(),
                    'IDLocation': $('#warehouse').val(),
                    'Unrestr': row.find('.unrestr').val().replace(".", ","),
                    'QualityInsp': row.find('.qualityinsp').val().replace(".", ","),
                    'SAPQtyPack': replaceAll(row.find('.sapqtypack').val(), ",", ""),
                    'ManQtyPack': replaceAll(row.find('.totalqtypack').val(), ",", ""),
                    'WarehouseQty1': row.find('.warehouseqty1').val().replace(".", ","),
                    'WarehouseQty2': row.find('.warehouseqty2').val().replace(".", ","),
                    'WarehouseQty3': row.find('.warehouseqty3').val().replace(".", ","),
                    'WarehouseQty4': row.find('.warehouseqty4').val().replace(".", ","),
                    'Remarks': row.find('.remarks').val(),
                };
                */
                postData.new[0].WarehouseStockCountDetails.push(detailData);
            });
        } else
        {
            for (var i = 0; i < slocweekly.length; i++) {
                $('#table_weekly_' + slocweekly[i] + ' tbody tr').each(function(){
                    var row = $(this);
                    var facode = row.find('.facode').val();
                    if ($.trim(facode) == '' && !isFACodeEmpty) {
                        isFACodeEmpty = true;;
                    }

                    var detailData = GetDetail(row);
                    detailData.SLoc = slocweekly[i];

                    /*
                    var detailData = {
                        'FACode': facode,
                        'SpeakingCode': row.find('.speakingcode').val(),
                        'IDLocation': $('#warehouse').val(),
                        'Batch': row.find('.batch').val(),
                        'BrandDescription': row.find('.brand').val(),
                        'SLoc': slocweekly[i],
                        'Unrestr': row.find('.unrestr').val().replace(".", ","),
                        'QualityInsp': row.find('.qualityinsp').val().replace(".", ","),
                        //'SAPQtyBox': row.find('.sapqtybox').val().replace(".", ","),
                        'SAPQtyPack': replaceAll(row.find('.sapqtypack').val(), ",", ""),
                        //'ManQtyBox': row.find('.manqtybox').val().replace(".", ","),
                        'ManQtyPack': row.find('.manqtypack').val().replace(".", ","),
                        'InterfaceQtyPack': null,
                        'Remarks': row.find('.remarks').val(),
                    };

                    if (slocweekly[i] == '1040')
                    {
                        var interfaceqtyvalue = row.find('.interfaceqtypack').val().replace(".", ",");;
                        detailData.InterfaceQtyPack = interfaceqtyvalue;
                    }
                    */
                    postData.new[0].WarehouseStockCountDetails.push(detailData);
                });
            };
        }

        if (isFACodeEmpty)
        {
            $('#textModalWarning').html('FACode can`t be empty');
            $('#warningModal').modal('show');
            return;
        }

        if (sapdata[tabId].length > 0 || IsUserEditQty)
        {
            $('#textModalWarning').html('Please compare data to continue');
            $('#warningModal').modal('show');
            return;
        }

        if ($('#status').val() == '-' && !isCompareData) {
            $('#textModalWarning').html('Status must be selected');
            $('#warningModal').modal('show');
            return;
        }

        if (($('#warehouseStaff1').val() == '-' || $('#warehouseStaff1').val() == null) && !isCompareData) {
            $('#textModalWarning').html('Warehouse Staff-1 must be selected');
            $('#warningModal').modal('show');
            return;
        }

        //call func compare data
        if (!isCompareData) CompareData();

        if ((($('.navtype.active').css('background-color') == 'rgb(255, 0, 0)' || IsUserEditQty || TotalInvAcc < 100) && $('#status').val() == 'Balance') && !isCompareData)
        {
            $('#textModalWarning').html('Status can`t be balance (Accuracy below 100%)');
            $('#warningModal').modal('show');
            return;
        }

        var dialog = bootbox.dialog({
            message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
            closeButton: false
        });

        $.ajax({
            url: '@Url.Action("../StockCount/AddNew")',
            //beforeSend : function() { $("#textModalLoading").html(" Please Wait"); $("#loadingModal").modal('show'); },
            complete : function() { dialog.modal('hide'); },
            type: 'POST',
            dataType: 'JSON',
            data: postData,
            cache: false,
            success: function (res) {
                var message = res.status != 'Success' ? (res.status + '<br>' + res.message) : 'Data has been successfully saved to the database';
                if (!isCompareData)
                {
                    if (res.status == 'Success') {
                        $('.navtype').not('.active').css('display', 'none');
                        if (res.id != 0) {
                            var fileData = CollectFile(res.id);
                            uploadFile(fileData);
                            /*
                            var fileData = new FormData();
