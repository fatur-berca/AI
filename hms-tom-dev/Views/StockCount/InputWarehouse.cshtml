@using System.Web.Mvc.Html
@model hms_tom_dev.Models.WarehouseStockCountViewModel
@{
    ViewBag.Title = "Warehouse > Stock Count > Warehouse";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string transDate = Model.IDStockCount == 0 ? DateTime.Now.ToString("dd-MM-yyyy") : Model.TransDate.ToString("dd-MM-yyyy");
    string location = Model.IDStockCount == 0 ? "" : Model.IDLocation;
    string staff1 = Model.IDStockCount == 0 ? "" : Model.WarehouseStaff1;
    string staff2 = Model.IDStockCount == 0 ? "" : Model.WarehouseStaff2;
    string shift = Model.IDStockCount == 0 ? "" : Model.Shift.ToString();
    string remarks = Model.IDStockCount == 0 ? "" : Model.Remarks;

    string TotalSAPBox = Model.IDStockCount == 0 ? "N/A" : Model.addSeparator(Model.TotalSAP1000Box + Model.TotalSAP1042Box + Model.TotalSAP1040Box + Model.TotalSAP1041Box + Model.TotalSAP1043Box + Model.TotalSAP1046Box);
    string TotalSAPPack = Model.IDStockCount == 0 ? "N/A" : Model.addSeparator(Model.TotalSAP1000Pack + Model.TotalSAP1042Pack + Model.TotalSAP1040Pack + Model.TotalSAP1041Pack + Model.TotalSAP1043Pack + Model.TotalSAP1046Pack);
    string TotalManBox = Model.IDStockCount == 0 ? "N/A" : Model.addSeparator(Model.TotalMan1000Box + Model.TotalMan1042Box + Model.TotalMan1040Box + Model.TotalMan1041Box + Model.TotalMan1043Box + Model.TotalMan1046Box);
    string TotalManPack = Model.IDStockCount == 0 ? "N/A" : Model.addSeparator(Model.TotalMan1000Pack + Model.TotalMan1042Pack + Model.TotalMan1040Pack + Model.TotalMan1041Pack + Model.TotalMan1043Pack + Model.TotalMan1046Pack);

    string TotalInvAcc = Model.IDStockCount == 0 ? "N/A" : Model.InvAcc.ToString().Replace(",", ".") + '%';
    string TotalWarehouseUtil = Model.IDStockCount == 0 ? "N/A" : Model.InvUtil.ToString().Replace(",", ".") + '%';

    //string col_number_style = "padding-left: 30px; padding-right: 30px;";

    string info_last_sync = Model.IDStockCount != 0 && !String.IsNullOrEmpty(Model.SyncedTime.ToString()) ? "*SAP data were taken from SAP on " + Convert.ToDateTime(Model.SyncedTime).ToString("dd-MMM-yy HH:mm") + " WIB" : "";
    string AttachmentUrlName = Model.IDStockCount != 0 ? "AttachmentWarehouseStockCount_" + Model.TransDate.ToString("dd-MMM-yyyy") + "_" + Model.IDLocation.ToString() + "_" + Model.Shift.ToString() : "";
    string def_style = "display:block";
    string disabled_button = Model.IDStockCount != 0 ? "disabled" : "";
    string def_button = "btn-success";

    string SyncedTime = Model.IDStockCount != 0 ? Convert.ToDateTime(Model.SyncedTime).ToString("dd-MM-yyyy HH:mm") : "";

    bool isCanEdit = ViewBag.IsSuperUser ? true : DateTime.Now.Subtract(Model.CreatedDate).TotalDays <= 1;
    bool? isWeekly = Model.isWeekly();
}

<script src="@Url.Content("~/scripts/stockcount.js")"></script>
