    function CalculateTotalQty() {
        isFromCompareData = false;
        var tbody = getCurrentActiveTable();
        var SLoc = $('.navtype.active').attr('SLoc');
        var tabId = $('.tab-pane').filter('.active').attr('id');

        var postData = [];

        var isFACodeEmpty = false;
        var selected_button_weekly = null;

        var TotalSAPQtyBox = 0, TotalSAPQtyPack = 0;
        var TotalManQtyBox = 0, TotalManQtyPack = 0;
        var TotalLoadingQtyBox = 0, TotalLoadingQtyPack = 0;
        var TotalReceivingQtyBox = 0, TotalReceivingQtyPack = 0;
        //console.log(SLoc);
        if (SLoc != 'weekly') {
            tbody.find('tr').each(function () {
                var row = $(this);
                var facode = row.find('.facode').val();
                var detailData = GetDetail(row);

                TotalSAPQtyPack += parseFloat(detailData.SAPQtyPack) || 0;
                TotalManQtyPack += parseFloat(detailData.WarehouseQty1) || 0;
                TotalReceivingQtyPack += parseFloat(detailData.WarehouseQty2) || 0;
                TotalLoadingQtyPack += (parseFloat(detailData.WarehouseQty3) || 0) + (parseFloat(detailData.WarehouseQty4) || 0) + (parseFloat(detailData.WarehouseQty5) || 0);
            });
        } else {
            selected_button_weekly = $('.btnWeekly.btn-success');
            //for (var i = 0; i < slocweekly.length; i++) {
            $('#table_weekly_' + selected_button_weekly.html() + ' tbody tr').each(function () {
                var row = $(this);
                var facode = row.find('.facode').val();
                var detailData = GetDetail(row);
                //postData.new[0].WarehouseStockCountDetails.push(detailData);

                TotalSAPQtyPack += parseFloat(detailData.SAPQtyPack) || 0;
                TotalManQtyPack += parseFloat(detailData.WarehouseQty1) || 0;
                TotalReceivingQtyPack += parseFloat(detailData.WarehouseQty2) || 0;
                TotalLoadingQtyPack += (parseFloat(detailData.WarehouseQty3) || 0) + (parseFloat(detailData.WarehouseQty4) || 0) + (parseFloat(detailData.WarehouseQty5) || 0);
            });
            //};
        }

        $('#' + SLoc + '_total_qty_sap').html(numberWithCommas(TotalSAPQtyPack) + " Pack");
        $('#' + SLoc + '_total_qty_man').html(numberWithCommas(TotalManQtyPack) + " Pack");
        $('#' + SLoc + '_total_qty_loading').html(numberWithCommas(TotalLoadingQtyPack) + " Pack");
        $('#' + SLoc + '_total_qty_receiving').html(numberWithCommas(TotalReceivingQtyPack) + " Pack");

        if (selected_button_weekly !== null) {
            selected_button_weekly.attr('total_qty_sap', $('#' + SLoc + '_total_qty_sap').html());
            selected_button_weekly.attr('total_qty_man', $('#' + SLoc + '_total_qty_man').html());
            selected_button_weekly.attr('total_qty_loading', $('#' + SLoc + '_total_qty_loading').html());
            selected_button_weekly.attr('total_qty_receiving', $('#' + SLoc + '_total_qty_receiving').html());
        }
    }

    function CollectFile(id) {
        var fileData = FormData();
        //var tmpData = FormData();
        var TotalFilePrevData = $('#listUpload tr.prevData').length;
        fileData.append('id', id);
        var idx = 0;
        $('#listUpload tr.prevData').each(function () {
            fileData.append('attachment' + idx, $(this).attr('filename'));
            idx++;
        });

        fileData.append('lastindex', TotalFilePrevData);

        for (var idxfile = 1; idxfile < FileAttach.length; idxfile++) {
            if (FileAttach[idxfile] === undefined) continue;
            fileData.append(id + '|' + idxfile, FileAttach[idxfile].file); //param 1 : idstockcount | counter, data di back end di split
        }

        return fileData;
    }

