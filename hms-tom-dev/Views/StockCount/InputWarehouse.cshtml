<div class="col-md-12">
    <div class="box">
        <form id="frm-input">
            <div class="row" hidden>
                <div class="col-md-12">
                    <div class="form-group">
                        <label>InsertOrUpdate</label>
                        <input type="hidden" id="transID" class="form-control" value="@Model.IDStockCount">
                        <input type="hidden" id="SyncedTime" class="form-control" value="@SyncedTime">
                        <input type="hidden" id="IsWeeklyReport" class="form-control" value="@(isWeekly == true ? 1 : 0)">
                        <input type="text" id="InsertOrUpdate" class="form-control">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Date</label>
                        <input type="text" class="form-control datepicker form-editable" id="transDate" value="@transDate">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Warehouse</label>
                        <select class="select2 warehouse form-editable" id="warehouse"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Shift</label>
                        <select id="shift" class="select2 form-editable">
                            @foreach (var obj in Model.GetListStockCountShift)
                            {
                                <option value="@obj.Key" @(Model.Shift.ToString().Equals(obj.Key) ? "selected" : "")>@obj.Value</option>
                            }
                            @*@for (int i = 1; i <= 3; i++)
                            {
                                <option value="@i" @(Model.Shift == i ? "selected" : "")>@i</option>
                            }*@                            
                            <!--<option value="0" @(Model.Shift == 0 ? "selected" : "")>Surprise Visit</option>-->
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Warehouse Staff-1</label>
                        <select class="select2 form-editable" id="warehouseStaff1">
                            @if (Model.IDStockCount != 0)
                            {
                                <option value="-"></option>
                                foreach (var obj in Model.listStaff)
                                {
                                    <option value="@obj.IDUser" @(obj.IDUser == Model.WarehouseStaff1 ? "selected" : "")>@obj.MasterUser.FullName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Warehouse Staff-2</label>
                        <select class="select2 form-editable" id="warehouseStaff2">
                            @if (Model.IDStockCount != 0)
                            {
                                <option value="-"></option>
                                foreach (var obj in Model.listStaff)
                                {
                                    <option value="@obj.IDUser" @(obj.IDUser == Model.WarehouseStaff2 ? "selected" : "")>@obj.MasterUser.FullName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Warehouse Staff On Next Shift</label>
                        <select class="select2 form-editable" id="nextShift">
                            @if (Model.IDStockCount != 0)
                            {
                                <option value="-"></option>
                                foreach (var obj in Model.listStaff)
                                {
                                    <option value="@obj.IDUser" @(obj.IDUser == Model.NextShift ? "selected" : "")>@obj.MasterUser.FullName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-8">
                    <label>Remarks</label>
                    <ul class="nav nav-pills title" id="">
                        <li class="nav_remarks active" tabid="" SLoc="1000"><a data-toggle="pill" href="#remarks">1000</a></li>
                        @if (Model.IDStockCount == 0 || Model.isWeekly() == true)
                        {
                        <li class="nav_remarks" tabid="" SLoc="1040"><a data-toggle="pill" href="#remarks1040">1040</a></li>                         
                        <li class="nav_remarks" tabid="" SLoc="1041"><a data-toggle="pill" href="#remarks1041">1041</a></li>
                         }
                        <li class="nav_remarks" tabid="" SLoc="1042"><a data-toggle="pill" href="#remarks1042">1042</a></li>
                        @if (Model.IDStockCount == 0 || Model.isWeekly() == true)
                        {
                        <li class="nav_remarks" tabid="" SLoc="1043"><a data-toggle="pill" href="#remarks1043">1043</a></li>
                        <li class="nav_remarks" tabid="" SLoc="1046"><a data-toggle="pill" href="#remarks1046">1046</a></li>
                        }
                    </ul>

                    <div class="tab-content">
                        <textarea id="remarks"     class="form-control form-editable remarks_header fade in active" style="height:133px">@Model.Remarks</textarea>
                        <textarea id="remarks1040" class="form-control form-editable remarks_header fade in" style="height:133px;display:none;">@Model.Remarks1040</textarea>
                        <textarea id="remarks1041" class="form-control form-editable remarks_header fade in" style="height:133px;display:none;">@Model.Remarks1041</textarea>
                        <textarea id="remarks1042" class="form-control form-editable remarks_header fade in" style="height:133px;display:none;">@Model.Remarks1042</textarea>
                        <textarea id="remarks1043" class="form-control form-editable remarks_header fade in" style="height:133px;display:none;">@Model.Remarks1043</textarea>
                        <textarea id="remarks1046" class="form-control form-editable remarks_header fade in" style="height:133px;display:none;">@Model.Remarks1046</textarea>
                    </div>
                    <!--
                    <div id="dailyfg" class="tab-pane fade in active">
                    </div>
                    
                    <div class="form-group">
                        <label>Remarks</label>
                        <textarea id="remarks" class="form-control form-editable" style="height:133px"></textarea>
                    </div>
                    -->
                </div>                                       
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Status</label>
                        <select class="select2 form-editable" id="status">
                            <option value="-"></option>
                            <option value="Balance" @(Model.Status == "Balance" ? "selected" : "")>Balance</option>
                            @foreach (var value in Model.ListStockCountStatus())
                            {
                                <option value="@value" @(value == Model.Status ? "selected" : "")>@value</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <!--<label>Upload</label>-->
                        <button id="btnViewOrUploadAttachment" type="button" class="btn btn-success form-editable" onclick="$('#modalAttachment').modal('show');">View/Upload Attachments</button>
                    </div>
                    <!--
                    <div class="form-group">
                        <label>Upload Attachment</label>
                        <div id="removeAttachment"><a style="float:left" href="#!" class="remove-link">remove</a></div>
                        @if (!String.IsNullOrEmpty(Model.Attachment))
                        {
                            <a href="@Url.Content(@System.Configuration.ConfigurationManager.AppSettings["LocationFileWarehouseStockCount"] + Model.Attachment)" download="@AttachmentUrlName" style="float:right; margin-right:10px;">
                                <i class="fa fa-download"> Download</i>
                            </a>
                        }
                        <input id="uploadFile" type="file" class="filestyle input_file form-editable" data-buttonname="btn-primary" data-icon="false" data-buttontext="Browse" accept="">
                    </div>
                    -->
                </div>
            </div>
            @if (Model.IDStockCount != 0)
            { 
                <div class="row">
                    <div class="form-group" style="float:right; text-align:right; font-style: italic;;">
                        <label style="font-size:10px">
                            Created By @Model.CreatedBy on @Model.CreatedDate.ToString("dd-MM-yyyy HH:mm")
                            <br />
                            Last Updated By @Model.UpdatedBy on @Model.UpdatedDate.ToString("dd-MM-yyyy HH:mm")
                        </label>
                    </div>
                </div>
            }
        </form>
    </div>
    <div class="box" style="background-color:#F1F4F7;padding-top:0px;padding-bottom:0px;margin-bottom:0px;">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group" style="margin-bottom:0px; text-align:center;">
                    <label style="font-size:14px;"><b> Inventory Accuracy (%) </b></label>
                </div>
                <div class="form-group" style="text-align:center;">
                    <label><b style="font-size:20px;" id="inv_acc">@TotalInvAcc</b></label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group" style="margin-bottom:0px; text-align:center;">
                    <label style="font-size:14px;"><b> Warehouse Utilization (%) </b></label>
                </div>
                <div class="form-group" style="text-align:center;">
                    <label><b style="font-size:20px;" id="inv_util">@TotalWarehouseUtil</b></label>
                </div>
            </div>
            <div class="col-md-1">

            </div>
