<script type="text/javascript">
    var filestockforecast;
    var urlWarehouseDetail = 'StockOnHand/GetWarehouseStockDetail';
    var detail = "forecast";//digunakan untuk mengganti detail forecast/salesplan
    var today = new Date();
    var yearNow = today.getFullYear();
    var weekNow = moment(today).isoWeek();
    //var weekDisplay = weekNow;
    //START : FILTER SUMMARY
    var filterWeekSummaryForecast;
    var filterYearSummaryForecast;
    var filterWeekSummarySales;
    var filterYearSummarySales;
    //START : FILTER SUMMARY
    var filter = new Object();
    filter.IsFilter = false;
    var filterSummaryFore = new Object();
    var filterSummarySales = new Object();

    var ListWeekFilter;//digunakan untuk menampung list week di bagian filter yang sudah diload
    //var ListWeekUpload;//digunakan untuk menampung list week di bagian upload
    var ListRegionFilter;//digunakan untuk menampung list region di bagian filter yang sudah diload
    var loadTabSales = false;//pertama kali load tab sales
    var loadFilterDetail = false;
    var dialog;//untuk popup loading
    var jumlahFilterDetail = 0;//parameter, filter di detail minimal harus ada 2 filter yang dipilih
    var checkFilterWeek = false;
    var checkFilterLocation = false;
    var checkFilterWarehouse = false;
    var checkFilterBrand = false;
    //generateTabelWarehouseStockDetail();

    //$("#lblDetail").text("Based on Sales Forecast Week " + (weekDisplay));
    //$("#btnChangeDetail").text("Switch to Sales Plan Week "(weekDisplay));

    $("#lblDetail").text("Based on Sales Forecast");
    $("#btnChangeDetail").text("Switch to Sales Plan");

    //START : BAGIAN SET FILTER
    //GetGenWeekFilter();
    
    //FILTER DETAIL
    //GetLocationList();
    //GetWarehouseList();
    //GetBrandList();
    //END : BAGIAN SET FILTER

    //START : DEFAULT TAMPILAN DETAIL
    //filter.filterWeek = weekNow + '-' + yearNow;
    //filter.IDLocation = "ALL";
    //filter.filterWarehouse = "ALL";
    //filter.BrandCode = "ALL";
    //filter.IsFilter = true;
    //generateTabelWarehouseStockDetail();
    //END : DEFAULT TAMPILAN DETAIL

    var dialog = bootbox.dialog({
        message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...</div>',
        closeButton: false
    });

    //START : BAGIAN UPLOAD FORECAST
    $("#btnPopUpUploadForecast").click(function () {
        $("#btnUploadForecast").prop("disabled", true);
        $("#uploadForecast").val("");
        $("#uploadForecast").jfilestyle('clear');
        //if (ListWeekUpload == undefined)
            GetGenWeek(weekNow, yearNow);
        $("#StartingWeek").val(weekNow + '-' + yearNow);
        $("#EndingWeek").val(weekNow + '-' + yearNow);
        filestockforecast = "";
        getInfoLastestStockForecast();
        $("#btnUploadForecast").removeAttr('disabled');
        $("#btnUploadForecast").html("Execute");
    });

    $('#uploadForecast').on('change', function (e) {
        $("#btnUploadForecast").prop("disabled", false);
        filestockforecast = e.target.files;
    });

    $("#btnUploadForecast").click(function () {
        var weekUpload = $('#StartingWeek').val();
        var weekUploadEnd = $('#EndingWeek').val();
        //var weekUpload = "4-2018";
        //var weekUploadEnd = "4-2018";
        var splitStart = weekUpload.split('-');
        var splitEnd = weekUploadEnd.split('-');
        var statusError = false;
        if (parseInt(splitEnd[1]) <= parseInt(splitStart[1])) {
            if (parseInt(splitEnd[1]) == parseInt(splitStart[1])) {
                if (parseInt(splitEnd[0]) < parseInt(splitStart[0])) {
                    $("#textModalError").html("");
                    $("#textModalError").append("Ending week must be greater than starting week");
                    $('#modalerror').modal('show');
                    statusError = true;
                }
            } else {
                $("#textModalError").html("");
                $("#textModalError").append("Ending week must be greater than starting week");
                $('#modalerror').modal('show');
                statusError = true;
            }
        }
        if (!statusError){
            var dialog = bootbox.dialog({
                message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Please Wait...Uploading Data</div>',
                closeButton: false
            });
            var data = new FormData();
            data.append("Startingweek", weekUpload);
            data.append("Endingweek", weekUploadEnd);
            for (var x = 0; x < filestockforecast.length; x++) {
                data.append("filestockforecast", filestockforecast[x]);
            }
            $("#btnUploadForecast").attr('disabled', 'disabled');
            $("#btnUploadForecast").html("Uploading");
            $.ajax({
                type: "POST",
                url: 'StockOnHand/UploadFileStockForecast',
                contentType: false,
                processData: false,
                cache: false,
                async: false,
                data: data,
                success: function (data) {
                    dialog.modal('hide');
                    if (data.length == 0) {
                        $("#loadingModal").modal('hide');
                        $("#textModalSucess").html("");
                        $("#textModalSucess").html("Your data has been successfully saved, Please wait 30 minutes recalculate is running");
                        $('#modalsuccess').modal('show');
                        calculateForecast();
                    }
                    else {
                        $("#loadingModal").modal('hide');
                        var txtError = "";
                        for (var i = 0; i < data.length; i++) {
                            var split = data[i].toString().split("-");
                            if (split[0] == "LOCATION") {
                                txtError = txtError + "There is no Location " + split[1] + " row " + split[2] + " in table master location<br/>";
                            }
                            if (split[0] == "BRAND") {
                                txtError = txtError + "There is no Brand " + split[1] + " in table master brand<br/>";
                            }
                            if (split[0] == "WEEK") {
                                txtError = txtError + "Expected week " + split[1] + " in column " + split[2] + "<br/>";
                            }
                            if (split[0] == "WEEKNF") {
                                txtError = txtError + "Starting week not found in excel<br/>";
                            }
                        }
                        $("#textModalError").html("");
                        $("#textModalError").append(txtError);
                        $('#modalerror').modal('show');
                    }
                    $("#btnUploadForecast").removeAttr('disabled');
                    $("#btnUploadForecast").html("Execute");
                    $("#lblLatestForecast").html("<h6><i>*loading...</i></h6>");
                    getInfoLastestStockForecast();
                },
                error: function (xhr, status, p3, p4) {
                    dialog.modal('hide');
                    var err = "Error " + " " + status + " " + p3 + " " + p4;
                    if (xhr.responseText && xhr.responseText[0] == "{")
                        err = JSON.parse(xhr.responseText).Message;
                }
            });
        }
    });

    $("#AdvSearchForecast").click(function () {
        if (ListWeekFilter == undefined) {
            GetGenWeekFilter(weekNow, yearNow);
        }
        if (ListRegionFilter == undefined) {
            GetLocationList();
        }
        $("#FilterWeekForecast").val(weekNow + '-' + yearNow);
    });

    $("#AdvSearchSales").click(function () {
        if (ListWeekFilter == undefined) {
            GetGenWeekFilter(weekNow, yearNow);
        }
        if (ListRegionFilter == undefined) {
            GetLocationList();
        }
        $("#FilterWeekSales").val(weekNow + '-' + yearNow);
    });

