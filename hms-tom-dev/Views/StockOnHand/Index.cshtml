                $.each(data, function (key, val) {
                    if(status == 'detail'){
                        select.append('<option value="' + val.IDLocation + '">' + val.LocationName + '</option>');
                    }
                    else if (status == 'salesfore') {
                        selectsalesfore.append('<option value="' + val.IDLocation + '">' + val.LocationName + '</option>');
                    }
                });
            },
            error: function () {
                if(status == 'detail'){
                    select.html('<option value="NULL">none available</option>');
                }
                else if (status == 'salesfore') {
                    selectsalesfore.html('<option value="NULL">none available</option>');
