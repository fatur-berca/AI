    var kolom = new Array();
    var listBrand = new Array();
    var firstData = true;
    generateTable(weekNow, yearNow ,"ALL");
    function generateTable(week, year, listRegion) {
        $('#dtWarehouseStockSummary').treetable('destroy');
        //var split = $("#FilterWeekForecast").val().split('-');
        //var paramWeekSummary = split[0];
        //var paramYearSummary = split[1];
        //filterWeekSummaryForecast = split[0];
        //filterYearSummaryForecast = split[1];
        $("#lblWeekForecast").html('');
        $("#lblWeekForecast").html('Week ' + week + ' - ' + year);
        $.ajax({
            url: 'StockOnHand/GetBrandList',
            method: 'get',
            dataType: 'json',
            cache: false,
            data: { week: week + '-' + year, type: 'forecast' },
            success: function (data) {
                //if (kolom.length == 0) {
                if (firstData == false) {
                    kolom = new Array();
                    listBrand = new Array();
                    $('#dtWarehouseStockSummary').DataTable().destroy();
                    $("#dtWarehouseStockSummary").html('');
                }
                var htmlStringHeader = "<thead><tr>";
                //var htmlStringFilter = "<thead class='filters'><tr class='filter-row'>";
                kolom.push({ data: "LocationName" });
                htmlStringHeader = htmlStringHeader + "<th style='padding-right: 40px;'>Location</th>";
                //htmlStringFilter = htmlStringFilter + "<th></th>";

                for (var i = 0; i < data.length; i++) {
                    htmlStringHeader = htmlStringHeader + "<th>" + data[i] + "</th>";
                    //htmlStringFilter = htmlStringFilter + "<th>" + data[i] + "</th>";
                    kolom.push({ data: data[i] });
                    listBrand.push(data[i]);
                }
                htmlStringHeader = htmlStringHeader + "</tr></thead>";
                //htmlStringFilter = htmlStringFilter + "</tr></thead>";
                $("#dtWarehouseStockSummary").append(htmlStringHeader);
                //}
            },
            complete: function () {
                $.ajax({
                    url: 'StockOnHand/GetWarehouseSummary',
                    method: 'POST',
                    data: { week: week, year: year, listRegion: listRegion },
                    cache: false,
                    success: function (json) {
                        firstData = false;
                        var summaryObjectList = [];
                        json.forEach(function (summary, index) {
                            var summaryObject = new Object();
                            summary.forEach(function (value, index) {
                                summaryObject[value.Key] = value.Value;
                            });
                                summaryObjectList.push(summaryObject);
                        });
                        var table = $('#dtWarehouseStockSummary').on('draw.dt', function () {
                            $(this).treetable({ expandable: true });
                        }).DataTable({
                            'destroy': true,
                            data: summaryObjectList,
                            'paging': false,
                            'info': false,
                            'sort': false,
                            'searching': true,
                            'autoWidth': false,
                            columns: kolom.map(function (a) {
                                return a;
                            }),
                            "dom": 'lf<"table-overflow"t>ip',
                            orderCellsTop: true,
                            "createdRow": function (row, data, index) {
                                $(row).attr('data-tt-id', data["IDLocation"]);
