        for (var x = 0; x < filestocksalesplan.length; x++) {
            data.append("filestocksalesplan", filestocksalesplan[x]);
        }
        $("#btnUploadSalesPlan").attr('disabled', 'disabled');
        $("#btnUploadSalesPlan").html("Uploading");
        $.ajax({
            type: "POST",
            url: 'StockOnHand/UploadFileStockSalesPlan',
            contentType: false,
            processData: false,
            cache: false,
            data: data,
            ajaxSend: function () {
                $("#textModalLoading").html("");
                $("#textModalLoading").html("Please wait, upload in progress.");
                $("#loadingModal").modal('show');
            },
            success: function (data) {
                dialog.modal('hide');
                if (data.length == 0) {
                    $("#loadingModal").modal('hide');
                    $("#textModalSucess").html("");
                    $("#textModalSucess").html("Your data has been successfully saved, Please wait 30 minutes recalculate is running");
                    $('#modalsuccess').modal('show');
                    calculateSalesPlan();
                }
                else {
                    var txtError = "";
                    for (var i = 0; i < data.length; i++) {
                        var split = data[i].toString().split("-");
                        if (split[0] == "LOCATION") {
                            txtError = txtError + "There is no Location " + split[1] + " in table master location<br/>";
                        }
                        if (split[0] == "BRAND") {
                            txtError = txtError + "There is no Brand " + split[1] + " in table master brand<br/>";
                        }
                    }
                    $("#textModalError").html("");
                    $("#textModalError").append(txtError);
                    $('#modalerror').modal('show');
                }
                $("#btnUploadSalesPlan").removeAttr('disabled');
                $("#btnUploadSalesPlan").html("Execute");
            },
            error: function (xhr, status, p3, p4) {
                dialog.modal('hide');
                var err = "Error " + " " + status + " " + p3 + " " + p4;
                if (xhr.responseText && xhr.responseText[0] == "{")
                    err = JSON.parse(xhr.responseText).Message;
            }
        });
    });

