                    "iDisplayLength": 25,
                    //aaSorting: [[2, 'desc']],
                    columns: [
                        {
                            'data': 'IDLocation', "render": function (data, type, row) {
                                if (row['LocationType'] == "Warehouse")
                                    return row['IDLocation'] + ' - ' + row['LocationName'];
                                else
                                    return row['IDLocation'];
                            }
                        },
                        { 'data': 'BrandCode', 'searchable': true },
                        {
                            'data': 'IDLocation', "render": function (data, type, row) {
                                return row['Week'] + ' - ' + row['Year'];
                            }
                        },
                        { 'data': 'Opening', 'searchable': true },
                        { 'data': 'ETASenin', 'searchable': true },
                        { 'data': 'ETASelasa', 'searchable': true },
                        { 'data': 'ETARabu', 'searchable': true },
                        { 'data': 'ETAKamis', 'searchable': true },
                        { 'data': 'ETAJumat', 'searchable': true },
                        { 'data': 'ETASabtu', 'searchable': true },
                        { 'data': 'ETAMinggu', 'searchable': true },
                        { 'data': 'TotalStock', 'searchable': true },
                        {
                            'data': 'Rate', "render": function (data, type, row) {
                                if (row['Rate'] >= 0)
                                    return row['Rate'];
                                else if (row['Rate'] == -1)
                                    return 'R';
                                else if (row['Rate'] == -2)
                                    return 'FN';
                                else if (row['Rate'] == -3)
                                    return 'FN';
                                else if (row['Rate'] == -4)
                                    return 'FN';
                            }
                        },
                        { 'data': 'PercentageSales', 'searchable': true }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true ,
                    "initComplete": function (settings, json) {
                        dialog.modal('hide');
                    }
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
