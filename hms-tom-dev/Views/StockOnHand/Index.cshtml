    function GetGenWeek(week, year) {
        var select = $('#StartingWeek');
        var selectEnding = $('#EndingWeek');
        //var selectSales = $("#WeekUploadSalesPlan");
        $.ajax({
            type: "GET",
            url: 'StockOnHand/GetGenWeek',
            cache: false,
            success: function (data) {
                //ListWeekUpload = data;
                select.html('');
                selectEnding.html('');
                //selectSales.html('');
                $.each(data, function(key, val) {
                    select.append('<option value="' + val.Week + '-' + val.Year + '">' + val.Week + ' - ' + val.Year + '</option>');
                    selectEnding.append('<option value="' + val.Week + '-' + val.Year + '">' + val.Week + ' - ' + val.Year + '</option>');
                    //selectSales.append('<option value="' + val.Week + '-' + val.Year + '">' + val.Week + ' - ' + val.Year + '</option>');
                });
                $('#StartingWeek').val(week + '-' + year);
                $('#EndingWeek').val(week + '-' + year);
                //$('#WeekUploadSalesPlan').val(week + '-' + year);
            },
            error: function () {
                select.html('<option value="NULL">none available</option>');
            }
        });
    }
