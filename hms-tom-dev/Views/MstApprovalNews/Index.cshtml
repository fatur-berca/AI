<div class="title-deck wmb">
    <div class="row">
        <div class="col-md-2 button-wrap pull-right">
            <select id="filterStatus" class="form-control" style="/ width: 120px; /">
                <option value="-1">All News</option>
                <option value="2">Approved</option>
                <option value="1">Waiting</option>
                <option value="0">Rejected</option>
            </select>
        </div>
        <div class="col-md-2 button-wrap pull-right text-right">
            <label>Search : </label>
        </div>
    </div>
</div>
   
<table id="dtFilterMaster" class="display table dataTable table-condensed">
    <thead>
        <tr>
            <th width=3% nowrap class="text-center">Status</th>
            <th>Image</th>
            <th>Title</th>
            <th>Submitted by</th>
            <th hidden="">Publish Date</th>
            <th>Remark</th>
            <th>File</th>
            <th hidden="">StatusHidden</th>
            <th width=12% nowrap class="text-center">Action</th>
        </tr>
    </thead>
    <thead class="filters">
        <tr class="filter-row">
            <th>Filter</th>
            <th></th>
            <th></th>
            <th></th>
            <th hidden=""></th>
            <th></th>
            <th hidden=""></th>
            <th></th>
            <th></th>
        </tr>
    </thead>
</table>

<div class="modal fade ml-warning" id="warningModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Approval News</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/danger.png" alt="">
                <span>Are you sure to publish this news?</span>
            </div>
            <div class="modal-footer">
                <button id="btnSave" type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
                <button type="button" class="btn btn-purple" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-sucess" id="modalsuccess" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/checked.png" alt="">
                <span>Your data has been successfully saved</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalerror" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">DFIS Notification Center</h4>
            </div>
            <div class="modal-body">
                <img src="assets/images/cancel.png" alt="">
                <span>Sorry, the inputted data exists or your connection is lost</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ml-error" id="modalimage" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Image Preview</h4>
            </div>
            <div class="modal-body">
                <img alt="" id="srcimage" height="300px">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div id="Loading" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">DFIS Notification Center</h4>
            </div>
            <div class="modal-body"><img src="assets/images/loading.gif" alt=""><span> Please wait...</span></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var tempArrayTable = [];
    // BEGIN : JQUERY SELECT TO DataTable
    generateTable(-1);

    function previmage(imgsrc) {
       // alert(imgsrc);
        // document.getElementById("srcimage").src = imgscr;
        document.getElementById("srcimage").src = imgsrc;
        $('#modalimage').modal('show');

    }
    //generate table
    function generateTable(status) {
        $.ajax({
            url: 'MstApprovalNews/GetMasterApprovalNews',
            method: 'get',
            data:{status:status},
            dataType: 'json',
            cache: false,
            success: function (json) {
                var table = $('#dtFilterMaster').DataTable({
                    'destroy': true,
                    data: json,
                    'paging': true,
                    'sort': true,
                    'searching': true,
                    "iDisplayLength": 25,
                    columnDefs: [{ orderable: false, targets: [0, 1, 2, 3, 4, 5, 7, 8] }],
                    order: [[7, 'desc']],
                    columns: [
                           {
                               'data': 'Status', "class": "text-center", "render": function (data, type, row, meta) {
                                   if (row["Status"] == 0)
                                       return '<div><img src="assets/images/circlered.png" alt=""height="15" width="15"></div>';
                                   else if (row["Status"] == 1)
                                       return '<div><img src="assets/images/circleyellow.png" alt=""height="15" width="15"></div>';
                                   else if (row["Status"] == 2)
                                       return '<div><img src="assets/images/circlegreen.png" alt=""height="15" width="15"></div>';
                               }
                           },
                             {
                                 'data': 'Image', "render": function (data, type, row, meta) {
                                     if (row["NamaImage"] != "") {
                                       
                                        // return '<div><a data-toggle="modal"  href="#modalimage" ><img src="' + row["LinkImage"] + '" alt=""height="60" ></a></div>';
                                        // return '<div ><input type="image" src="' + row["LinkImage"] + '" data-toggle="modal"  href="#" onclick="editTable(' + row["LinkImage"] + ')></div>';
                                         return '<input type="image" src="' + row["LinkImage"] + '" alt=""height="60"  onclick="previmage(\'' + row["LinkImage"] + '\',2)" value="V">';
                                     }
                                     else
                                         return '<div ></div>';
                                 }
                             },
                        { 'data': 'Title', 'searchable': true },


                        {
                            'data': 'CreatedDate', "render": function (data, type, row, meta) {
                                var jamtanggal = moment(row['CreatedDate']).format("DD-MMM-YYYY HH:mm");
                                return row['CreatedBy'] + ' on ' + jamtanggal;
                            }
                        },
                        {
                            'data': 'UpdatedDate', "visible": false, "render": function (data, type, row, meta) {
                                if (row["CreatedDate"] == row["UpdatedDate"])
                                    return '<div></div>';
                                else
                                    return '<div >' + moment(row["UpdatedDate"]).format("DD-MMM-YYYY HH:mm") + '</div>';
                            }
                        },
                        { 'data': 'Remarks', 'searchable': true },
                         {
                             'data': 'FileUpload', "render": function (data, type, row, meta) {
                                 if (row["NamaFile"] != "")
                                     return '<div ><a href="' + row["LinkFile"] + '" target="_blank">[Preview]</a></div>';
                                 else
                                     return '<div ></div>';
                             }
                         },
                        { 'data': 'Status', "visible": false, 'searchable': true },

                        {
                            'data': 'IDNewsHighlight', "class": "text-center", "render": function (data, type, row, meta) {
                                //return '<td ><input type="image" src="assets/images/approve.png" alt=""height="15" width="15" onclick="Save(\'' + row["IDNewsHighlight"] + '\',2)" value="V"><input type="button"  style="background: url(assets/images/approve.png)" onclick="Save(\'' + row["IDNewsHighlight"] + '\',2)" value="V"><input type="button" onclick="Save(\'' + row["IDNewsHighlight"] + '\',0)" value="X"><input type="button" onclick="Save(\'' + row["IDNewsHighlight"] + '\',1)" value="O"></td>';
                                return '<td ><input type="image" src="assets/images/approve.png" alt=""height="20" width="20" onclick="Save(\'' + row["IDNewsHighlight"] + '\',2)" value="V">' + ' ' + '<input type="image" src="assets/images/waiting.png" alt=""height="20" width="20" onclick="Save(\'' + row["IDNewsHighlight"] + '\',1)" value="O">' + ' ' + '<input type="image" src="assets/images/reject.png" alt=""height="20" width="20" onclick="Save(\'' + row["IDNewsHighlight"] + '\',0)" value="X"></td>';
                            }
                        }
                    ],
                    "dom": 'lf<"table-overflow"t>ip',
                    orderCellsTop: true
                });

                $('.dataTables_filter input').attr("placeholder", "Search Here");
                // Setup - add a text input to each footer cell
                $('#dtFilterMaster thead.filters th').each(function (index) {
                    //if (index < 6 && index != 2 && index != 3){
                    //    var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                    //    $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    //}

                    if (index == 2) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                    if (index == 3) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                    if (index == 5) {
                        var title = $('#dtFilterMaster thead.filters th').eq($(this).index()).text();
                        $(this).html('<input type="search" class="form-control mini" placeholder="Search ' + title + '" />');
                    }
                });
                //searching with column on datatable
                table.columns().every(function (index) {
                    $('#dtFilterMaster thead.filters th:eq(' + index + ') input').on('input', function () {
                        table.column($(this).parent().index() + ':visible')
                            .search(this.value)
                            .draw();
                    });
                });
            }
        });
    }
    // END : JQUERY SELECT TO DataTable

    $("#filterStatus").on('change', function () {
        var status = $("#filterStatus").val();
        generateTable(status);
    });

    function Save(id, status) {
        $('#Loading').modal('show');
        $.ajax({
            type: 'POST',
            url: 'MstApprovalNews/InsertList',
            data: { id: id, status: status },
            success: function (result) {
                if (result == "Success") {
                    var filterstatus = $("#filterStatus").val();
                    generateTable(filterstatus);
                   // generateTable(status);

                    $('#modalsuccess').modal('show');
                }
                else
                    $('#modalerror').modal('show');
                $('#Loading').modal('hide');
            }
        });
    }

