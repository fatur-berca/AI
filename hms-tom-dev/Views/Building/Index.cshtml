@using EnumHelper = DFIS.Utils.EnumHelper
@{
    ViewBag.Title = "General > Building & Facility > List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listUserRole = ViewBag.ListUserRole;
    bool isSuperUser = false;
}

@foreach (var x in listUserRole)
{
    if (x.RoleName.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.UserRole.SuperAdmin)))
    {
        isSuperUser = true;
        break;
    }
}
<div class="title-deck wmb">
    <div class="button-wrap pull-left">
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.AddNew)))
        {
            <button class="btn btn-primary" onclick=" window.location.href = 'buildingDetail' ">Add New</button>
        }
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Delete)))
        {
            <button class="btn btn-primary" id="btnSetInactive" type="button" onclick=" SetIsActive('Delete') ">Delete</button>
        }
        
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Export)))
        {
            <button class="btn btn-primary" id="exportButton">Export</button>
        }
        
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.CustomReport)))
        {
            <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#customReportModal" id="customReportButton">Custom Report</button>
        }
        
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.Recovery)))
        {
            <button class="btn btn-primary" id="btnSetActive" type="button" onclick="SetIsActive('Recovery')">Recovery</button>
        }
        
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.PrintProfile)))
        {
            <button class="btn btn-primary" id="btnPrintDoc">Print Profile</button>
        }
        
        @if (ViewBag.ButtonAccess.Contains(EnumHelper.GetDescription(DFIS.Utils.Enums.ButtonName.RegionalMapView)))
        {
            <button class="btn btn-primary button-collapse" data-toggle="collapse" href="#mapwrap" aria-expanded="true" aria-controls="mapwrap">Regional Map View</button>
        }
        
    </div>
    <a href="#searchfilter" class="search-collapse pull-right" data-toggle="collapse" aria-expanded="true" aria-controls="searchfilter" id="advSrc"><b>Advanced Search </b><i class="fa fa-angle-down"></i></a>
</div>

<div class="filter-deck nmb">
    <div id="searchfilter" class="collapse" role="tabpanel" aria-labelledby="searchfilter">
        <div class="col-panel wmb wbt">
            <form>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Warehouse Name</label>
                        <select id="warehouseSearch" class="select2" multiple="multiple"></select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Address</label>
                        <input id="addressSearch" type="text" name="" class="form-control">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Warehouse Status</label>
                        <select class="form-control" id="status">
                            <option value=""></option>
                            <option value="Owned">Owned</option>
                            <option value="Rent">Rent</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Regional</label>
                        <select id="regionalSearch" class="select2" multiple="multiple"></select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-4">
                    <div class="form-group">
                        <div class="checkbox-deck">
                            <input type="checkbox" name="" id="expiration">
                            <label for="expiration"></label>
                        </div>
                        <span class="checkbox-deck-span">Close to expiration (&#60; 12 months)</span>
                    </div>
                </div>
                @*<div class="col-md-4">
                    <div class="form-group">
                        <div class="checkbox-deck">
                            <input type="checkbox" name="" id="chkInactive">
                            <label for="chkInactive"></label>
                        </div>
                        <span class="checkbox-deck-span">Include deleted data</span>
                    </div>
                </div>*@
                @if (isSuperUser)
                {
                    <div class="clearfix"></div>
                    <div class="col-sm-4">
                        <div class="form-group">

                            <label for="input-type">Status</label>
                            <div id="input-type" class="row">
                                <div class="col-sm-2">
                                    <label class="radio-inline">
                                        <input name="isIncludeActive" id="all" value="1" type="radio" />All
                                    </label>
                                </div>
                                <div class="col-sm-2">
                                    <label class="radio-inline">
                                        <input name="isIncludeActive" id="deleted" value="0" type="radio" /> Deleted
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <div class="col-md-12">
                    <input type="button" class="btn btn-primary" onclick="search()" value="Search" />
                    <input type="button" class="btn btn-purple" onclick="refresh()" value="Reset" />
                </div>
            </form>
        </div>
    </div>
</div>

<!-- map deck -->
