                    $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" id="btnOK">OK</button>');
                } else {
                    $('#notificationModal').modal('show');
                    $('#notificationModal .modal-body').html('<img src="assets/images/danger.png" alt=""><span> Error your data cannot be ' + msg + ' !</span>');
                    $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" id="btnOK">OK</button>');
                }
                $("#btnOK").click(function () {
                    getData();
                    filter.ListIsActiveId = null;
                    tempIDBuilding = [];
                });

            }
        });
    }
