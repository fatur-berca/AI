    function checkAllChange() {
        //console.log('temp id building before');
        //console.log(tempIDBuilding);
        $("#checkall").change(function () {
            $(".chkList").prop('checked', $("#checkall").prop('checked'));

            $("input[name='check']").each(function () {
                //values.push($(this).val());
                //console.log('data '+$(this).attr("data"));
                InsertTempArray($(this).attr("data"));
            });
            if ($("#checkall").prop('checked')) {
                var table = $('#dtTable').DataTable();
                table.column(1).nodes().each(function (cell, i) {
                    var split = table.cell(i, 0).data().split('"');
                    var str = split[3];
                    var value = str.substring(6, (str.length - 1));
                    if (value != "k")
                        tempIDBuilding.push(value);
                });
                tempIDBuilding = tempIDBuilding.filter(onlyUnique);
            } else {
                tempIDBuilding = [];
            }
        });
    }

    //filter supaya array javascript hanya ada unique value
    function onlyUnique(value, index, self) {
        return self.indexOf(value) === index;
    }
