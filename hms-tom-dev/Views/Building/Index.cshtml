    function random() {
        min = Math.ceil(0);
        max = Math.floor(icon.length);
        var index = Math.floor(Math.random() * (max - min)) + min;
        return index;
    }

    function generateDropDownRegional() {
        //get a reference to the select element
        $drpLocation = $('#regionalSearch');
        //request the JSON data and parse into the select element
        $drpLocation.append('<option></option>');

        $.ajax({
            url: "Building/GetMasterLocation",
            dataType: 'JSON',
            cache: false,
            success: function (data) {
                //clear the current content of the select

                //iterate over the data and append a select option

                $.each(data, function (kunci, val) {
                    $drpLocation.append('<option value="' + val.IDLocation + '">' + val.LocationName + '</option>');

                })
            },
            error: function () {
                //if there is an error append a 'none available' option
                $drpLocation.html('<option></option');
            }
        });
    }

