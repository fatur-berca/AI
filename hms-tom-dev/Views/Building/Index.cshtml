    function initMap() {
        // Create a map object and specify the DOM element for display.
        map = new google.maps.Map(document.getElementById('map'), {
            center: { lat: -0.789275, lng: 113.921327 },
            scrollwheel: false,
            zoom: 5
        });

        map.addListener('zoom_changed', function () {
            if (map.getZoom() == 5) {
