        for (var i = 0; i < markerWh.length; i++) {
            markerWh[i].setMap(null);
        }
    }

    function hideMarker() {
        for (var i = 0; i < markers.length; i++) {
            markers[i].setVisible(false);
        }
    }

    function showMarker() {
        for (var i = 0; i < markers.length; i++) {
            markers[i].setVisible(true);
        }
    }

    function setMarker() {
        deleteMarkers();
        for (var a = 0; a < region.length; a++) {
            if (positions[region[a].position].lat * 1 != null && positions[region[a].position].lat * 1 != null && positions[region[a].position].lat * 1 != 0 || positions[region[a].position].lat * 1 != 0) {
                var markerPos = { lat: positions[region[a].position].lat * 1, lng: positions[region[a].position].long * 1 };
                var marker = new google.maps.Marker({
                    map: map,
                    position: markerPos,
                    title: positions[region[a].position].region,
                    region: positions[region[a].position].region,
                    icon: iconBase + icon[a]
                });

                marker.addListener('click', function (event) {
                    addMarkerGroup(this.region);
                });

                markers.push(marker);
            }
        }

    }

    function addMarkerGroup(region) {
        hideMarker();
