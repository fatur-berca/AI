    function saveLayout() {
        var nonvalid = false;
        if ($("#layoutName").val() == "") { //layout name
            $("#layoutName").css('border-color', 'orange');
            nonvalid = true;
        } else {
            $("#layoutName").css('border-color', '#ccc');
        }

        if (nonvalid == true) {
            bootbox.alert({
                size: "small",
                title: "DFIS Notification Center",
                message: "<img src='assets/images/danger.png' alt=''>Please fill yellow field",
                callback: function () { /* your callback code */
                }
            });
            return false;
        } else {
            //var fieldNames = '',
            //    layoutName = $("input[name=layoutName]").val();

            var fieldNames = '',
                layoutName = $("#layoutName").val();
            var isGlobal;
            if ($("#chkGlobalCustomReport").prop('checked'))
                isGlobal = true;
            else
                isGlobal = false;

            $('#destinationFields .fc-field').each(function () {
                fieldNames = fieldNames + $(this).data('field') + ',';
            });
            fieldNames = fieldNames.slice(0, -1);

            $('#notificationModal .modal-body').html('<img src="assets/images/loading.gif" alt=""><span> Please wait, saving in progress.</span>');
            $('#notificationModal').modal('show');
            
            jQuery.ajax({
                url: '@Url.Action("../CustomReportState/InsertRecords")',
                method: 'post',
                dataType: 'json',
                data: { "layoutName": layoutName, "fieldNames": fieldNames, "pageName": "BuildingFacility", "isGlobal": isGlobal },
                success: function (response) {
                    if (response == "Success") {
                        if (isGlobal) {
                            //SaveChangesButton();
                            $('#notificationModal .modal-body').html('<img src="assets/images/checked.png" alt=""><span> Your changes has been successfully saved.</span>');
                            $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                            $("#chkGlobalCustomReport").prop('checked', true);
                        } else {
                            $('#notificationModal .modal-body').html('<img src="assets/images/checked.png" alt=""><span> Your changes has been successfully saved.</span>');
                            $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal" >OK</button>');
                            $("#chkGlobalCustomReport").prop('checked', false);
                        }
                    } else if (response == "NoLayoutName") {
                        $('#notificationModal .modal-body').html('<img src="assets/images/checked.png" alt=""><span> Please fill layout name.</span>');
                        $('#notificationModal .modal-footer').html('<button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>');
                    }
                    if ($("#layoutName").val() != $("#layoutSelect option:selected").text()) {
                        $("#layoutSelect").append('<option value="' + fieldNames + '">' + layoutName + '</option>').val(fieldNames);
                    }
                }
            });
            return true;
        }
    }

