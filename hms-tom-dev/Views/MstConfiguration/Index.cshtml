            </div>
            <div class="modal-body">
                <div id="fieldChooser" tabindex="1" class="field-chooser">
                    <div class="col-md-12">                        
                            <form id="newData">
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>InsertOrUpdate</label>
                                            <input type="text" id="InsertOrUpdate" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <div class="row" hidden>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>IDConfiguration</label>
                                            <input type="text" id="IDConfiguration" class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">                                  
                                        <div class="form-group">
                                            <label>Page Name</label>
                                            <select class="select2" id="PageName"></select>
                                        </div>                                   
                                </div>
                                <div class="col-md-6">                                   
                                        <div class="form-group">
                                            <label>Value</label>
                                            <input id="Value" type="text" class="form-control">
                                        </div>                                   
                                </div>
                                <div class="col-md-6">                                   
                                        <div class="form-group">
                                            <label>Description</label>
                                            <textarea id="Description" class="form-control"></textarea>
                                        </div>                                    
                                </div>
                                <div class="col-md-6">
                                  
                                        <div class="form-group">
                                            <label>Active</label>
                                            <select class="form-control" id="Status">
                                                <option value="1">YES</option>
                                                <option value="0">NO</option>
                                            </select>
                                        </div>                                
                                </div>                                                   
                                    <div class="row" hidden>
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label>CreatedDate</label>
                                                <input type="text" id="CreatedDate" class="form-control datepicker">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" hidden>
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label>CreatedBy</label>
                                                <input type="text" id="CreatedBy" class="form-control">
                                            </div>
                                        </div>
                                    </div>
                            </form>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveNew">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="setinactive" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
