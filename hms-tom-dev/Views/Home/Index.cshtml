<script>
    var IsSplashScreen = '@IsSplashScreen' == 'True';
    $(document).ready(function () {
        if (IsSplashScreen) {
            setTimeout(function () {
                //$('.splashscreen').fadeOut();
                window.location.assign('@Request.Url.GetLeftPart(UriPartial.Path)');
            }, 7000);
        }
    });

    var listNotif = [];
    var listRead = [];
    var totalNotif = 0;
    loadNotification(false);
    timerNotification();
    //TIMER Notif 10 menit
    function timerNotification() {
        setInterval(function () {
            loadNotification(true);
            }, 600000);
        //}, 6000);
    }

    function loadNotification(reload) {
        $.ajax({
            type: "post",
            url: '@Url.Action("LoadNotification","Home")',
            data: { idnotif: listNotif, reload: reload },
            dataType: 'json',
            cache: false,
            success: function (result) {
                var newsBaru = false;
                if (result.length > 0) {
                    if (!reload) {
                        document.getElementById("totalNotif").innerHTML = result[0]["Description"];
                        for (var i = 1; i < result.length; i++) {
                            if (listNotif.indexOf(result[i]["IDNotification"]) < 0)
                                listNotif.push(result[i]["IDNotification"]);
                            if (result[i]["IsRead"] == 0) {
                                if (newsBaru == false) {
                                    addSpanBubble();
                                    newsBaru = true;
                                }

                                $("#notificationBody").append('<a href="' + result[i]["Description"] + '" id="' + result[i]["IDNotification"] + '" class="notification-list unread" onClick="openNotification(' + result[i]["IDNotification"] + ')">' + result[i]["PageName"] + '</a>');
                            }
                            else {
                                $("#notificationBody").append('<a href="' + result[i]["Description"] + '" id="' + result[i]["IDNotification"] + '" class="notification-list" onClick="openNotification(' + result[i]["IDNotification"] + ')">' + result[i]["PageName"] + '</a>');
                            }
                            totalNotif++;
                        }
                        $("#notification").append('<div class="notificationFooter"><a href="#" class="btn btn-outline-primary" type="button" class="text-center" data-toggle="modal" data-target="#AllNotificationModal" onClick="generateTableNotification()">View All</a></div>');
                    } else {
                        var stringNotif = "";
                        for (var i = 0; i < result.length; i++) {
                            if (newsBaru == false) {
                                addSpanBubble();
                                newsBaru = true;
                            }
                            listNotif.push(result[i]["IDNotification"]);
                            $("#notificationsBody").prepend('<a href="' + result[i]["Description"] + '" id="' + result[i]["IDNotification"] + '" class="notification-list unread" onClick="openNotification(' + result[i]["IDNotification"] + ')">' + result[i]["PageName"] + '</a>');
                            totalNotif++;
                            if (totalNotif > 1)
                                stringNotif = "notifications";
                            else
                                stringNotif = "notification";
                            $("#totalNotif").html('');
                            $("#totalNotif").html('You have ' + totalNotif + ' ' + stringNotif);
                        }
                    }
                }
            }
        });
    }

    function readNotification() {
        $.ajax({
            type: "post",
            url: '@Url.Action("UpdateNotificationIsRead", "Home")',
            data: { idnotif: listNotif },
            dataType: 'json',
            cache: false,
            success: function (result) {
            }
        });
    }

    function openNotification(idnotification) {
        $.ajax({
            type: "post",
            url: '@Url.Action("UpdateNotificationIsOpen", "Home")',
            data: { idnotif: idnotification },
            dataType: 'json',
            cache: false,
            success: function (result) {
                $("#" + idnotification).remove();
                var stringNotif = "";
                totalNotif--;
                if (totalNotif > 1)
                    stringNotif = "notifications";
                else
                    stringNotif = "notification";
                $("#totalNotif").html('');
                $("#totalNotif").html('You have ' + totalNotif + ' ' + stringNotif);
            }
        });
    }

    $("#belNotif").click(function () {
        setTimeout(
            function () {
                listRead = [];
                $(".unread").each(function (key, val) {
                    //console.log($(this).attr('id'));
                    listRead.push($(this).attr('id'));
                });
                readNotification(listRead);
                removeSpanBubble();
                $("#notificationsBody a.unread").removeClass("unread");
            }, 2000);
    });

    function addSpanBubble() {
        $("#belNotif").append('<span class="red-notif"></span>');
    }

    function removeSpanBubble() {
        $("span.red-notif").remove();
    }
</script>

