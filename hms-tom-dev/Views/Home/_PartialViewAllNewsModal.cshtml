<!-- modal all news -->
<div class="modal fade" id="allNewsModal" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">All News</h4>
            </div>
            <div class="modal-body">
                <table id="dtFilter" class="display table dataTable" width="100%">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Submitted by</th>
                            <th hidden="">Created Date</th>
                        </tr>
                    </thead>
                    <thead class="filters">
                        <tr class="filter-row">
                            <th>Image</th>
                            <th>Title</th>
                            <th>Submitted by</th>
                            <th hidden="">Created Date</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-purple" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

