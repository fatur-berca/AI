# Salin ke .env lalu isi. File .env tidak ikut ter-commit.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Opsional, hanya jika claude.enabled: true di config.yaml
ANTHROPIC_API_KEY=

# Interval polling dalam detik (default 300)
SYNC_INTERVAL=300

# Opsional: GitLab self-hosted dengan sertifikat internal (mount ca.crt di docker-compose.yml)
# REQUESTS_CA_BUNDLE=/secrets/ca.crt
